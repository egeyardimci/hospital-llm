CREATE (sec_154)-[:HAS_AMENDMENT {order: 2}]->(amend_165);
CREATE (amend_166:Amendment {content: '(Ek: RG- 11/10/2017- 30207/ 1 md. Yürürlük: 25/08/2017)'});
CREATE (sec_154)-[:HAS_AMENDMENT {order: 3}]->(amend_166);
CREATE (amend_167:Amendment {content: '(Değişik: RG- 09/04/2020-31094/1 md. Yürürlük: 09/04/2020)'});
CREATE (sec_154)-[:HAS_AMENDMENT {order: 4}]->(amend_167);
CREATE (amend_168:Amendment {content: '(Değişik:RG-25/09/2024-32673/ 1 \nmd. Yürürlük:03/10/2024)'});
CREATE (sec_154)-[:HAS_AMENDMENT {order: 5}]->(amend_168);
CREATE (amend_169:Amendment {content: '(Değişik: RG- 25/08/2016- 29812/ 2md. Yürürlük: 05/09/2016)'});
CREATE (sec_154)-[:HAS_AMENDMENT {order: 6}]->(amend_169);
CREATE (amend_170:Amendment {content: '(Değişik:RG-12/12/2024-32750/1 md. Yürürlük:20/12/2024)'});
CREATE (sec_154)-[:HAS_AMENDMENT {order: 7}]->(amend_170);
CREATE (sec_171:Subsection {id: '1.7.1', title: 'Yurt dışı sigortalı müracaatları'});
CREATE (sec_154)-[:HAS_SUBSECTION {order: 0}]->(sec_171);
CREATE (para_172:Paragraph {id: '1', content: 'Yabancı ülkelerle yapılan sosyal güvenlik sözleşmeleri kapsamında Kurum sağlık yardımlarından yararlandırılan kişilerin sağlık hizmetleri, MEDULA sistemi üzerinden provizyon alınarak gerçekleştirilecektir. (Ek: RG- 18/03/2014- 28945/ 2-b md. Yürürlük: 01/04/2014)'});
CREATE (sec_171)-[:HAS_PARAGRAPH {order: 0}]->(para_172);
CREATE (para_173:Paragraph {id: '2', content: 'Yabancı ülkelerle yapılan sosyal güvenlik sözleşmesi kapsamında yabancı ülke sigorta kurumlarınca talep edilen sözleşmelere göre belirlenmiş ”Tıbbi raporlar” manuel olarak düzenlenerek, onaylanacak ve raporu isteyen sosyal güvenlik il müdürlüğü/sosyal güvenlik merkezine gönderilecektir.'});
CREATE (sec_171)-[:HAS_PARAGRAPH {order: 1}]->(para_173);
CREATE (para_172)-[:NEXT_PARAGRAPH]->(para_173);
CREATE (para_174:Paragraph {id: '3', content: 'Yabancı ülkelerle yapılan sosyal güvenlik sözleşmesi kapsamında iş kazası ve meslek hastalığı sigortaları ve tedavi edilmek üzere ülkemize gönderilme kapsamında sağlık yardımlarından yararlanacak sigortalılara YUPASS provizyon sisteminde “açıklamalar” bölümünde belirtilen hastalıklar dışındaki tedavi masrafları Kurumca karşılanmayacaktır. 11'});
CREATE (sec_171)-[:HAS_PARAGRAPH {order: 2}]->(para_174);
CREATE (para_173)-[:NEXT_PARAGRAPH]->(para_174);
CREATE (para_175:Paragraph {id: '4', content: 'Yabancı ülkelerle yapılan sosyal güvenlik sözleşmesi kapsamında geçici olarak Türkiye’de bulundukları sürede Kurum Sağlık yardımlarından yararlandırılan kişilere acil haller dışında sağlanacak ortez, protez, tıbbi araç ve gereç ile kişi kullanımına mahsus tıbbi cihaz için YUPASS provizyon sisteminde “açıklamalar” bölümünde belirtilen uyarı doğrultusunda önceden Kurumun ilgili biriminden onay alınacaktır.'});
CREATE (sec_171)-[:HAS_PARAGRAPH {order: 3}]->(para_175);
CREATE (para_174)-[:NEXT_PARAGRAPH]->(para_175);
CREATE (amend_176:Amendment {content: '(Değişik: RG- 01/06/2022- 31853/ 1 md. Yürürlük: 01/03/2022)'});
CREATE (sec_171)-[:HAS_AMENDMENT {order: 0}]->(amend_176);
CREATE (sec_177:Subsection {id: '1.7.2', title: 'MEDULA sisteminden kaynaklanan nedenlerle provizyon alınamaması'});
CREATE (sec_154)-[:HAS_SUBSECTION {order: 1}]->(sec_177);
CREATE (para_178:Paragraph {id: '1', content: 'Kurum Hizmet Sunumu Genel Müdürlüğü yetkililerince imzalanacak bir tutanak ile tevsik edilmesi kaydıyla MEDULA sisteminden kaynaklanan arıza nedeniyle hasta takip numarasının alınamadığı süre zarfında Kurum sağlık yardımlarından yararlanma hakkının olduğunu yazılı olarak beyan etmek veya belgelemek suretiyle müracaat eden kişilerin sağlık hizmetleri Kurumca karşılanır. Daha sonra yapılan sorgulama sonucu bu kişilerin müstahak olmadığının tespit edilmesi halinde, tedaviye ait fatura bedeli ilgili sağlık  hizmeti sunucusuna ödenerek gerekli yasal işlemler Kurumca yürütülür. - (Mülga: RG- 25/07/2014- 29071/ 1 md. Yürürlük: 25/07/2014 )'});
CREATE (sec_177)-[:HAS_PARAGRAPH {order: 0}]->(para_178);
CREATE (amend_179:Amendment {content: '(Değişik: RG- 25/08/2022- 31934/ 5 md. Yürürlük: 03/09/2022)'});
CREATE (sec_177)-[:HAS_AMENDMENT {order: 0}]->(amend_179);
CREATE (sec_171)-[:NEXT_SUBSECTION]->(sec_177);
CREATE (sec_145)-[:NEXT_SECTION]->(sec_154);
CREATE (sec_180:Section {id: '1.8', title: 'Katılım payı'});
CREATE (doc_1)-[:HAS_SECTION {order: 7}]->(sec_180);
CREATE (para_181:Paragraph {id: '1', content: 'Katılım payı; sağlık hizmetlerinden yararlanabilmek için genel sağlık sigortalısı veya bakmakla yükümlü olduğu kişiler tarafından ödenecek tutarı ifade eder.'});
CREATE (sec_180)-[:HAS_PARAGRAPH {order: 0}]->(para_181);
CREATE (para_182:Paragraph {id: '2', content: 'Katılım payı uygulanacak sağlık hizmetleri aşağıda belirtilmiştir:'});
CREATE (sec_180)-[:HAS_PARAGRAPH {order: 1}]->(para_182);
CREATE (item_183:Item {id: 'a', content: 'Sağlık Bakanlığı tarafından sözleşme imzalanmış, görevlendirilmiş veya yetkilendirilmiş aile hekimleri hariç olmak üzere ayakta tedavide hekim ve diş hekimi muayenesi katılım payı,'});
CREATE (para_182)-[:HAS_ITEM {order: 0}]->(item_183);
CREATE (item_184:Item {id: 'b', content: 'Ayakta tedavide sağlanan ilaçlar,'});
CREATE (para_182)-[:HAS_ITEM {order: 1}]->(item_184);
CREATE (item_183)-[:NEXT_ITEM]->(item_184);
CREATE (item_185:Item {id: 'c', content: 'Vücut dışı protez ve ortezler,'});
CREATE (para_182)-[:HAS_ITEM {order: 2}]->(item_185);
CREATE (item_184)-[:NEXT_ITEM]->(item_185);
CREATE (item_186:Item {id: 'ç', content: 'Yardımcı üreme yöntemi tedavileri.'});
CREATE (para_182)-[:HAS_ITEM {order: 3}]->(item_186);
CREATE (item_185)-[:NEXT_ITEM]->(item_186);
CREATE (para_181)-[:NEXT_PARAGRAPH]->(para_182);
CREATE (para_187:Paragraph {id: '3', content: 'Katılım paylarının tahsil şekli ilgili maddelerde açıklanmıştır. Ancak, Kurumdan aldıkları gelir ve aylık tutarı 100 (yüz) TL’nin altında olan kişiler ve bakmakla yükümlü olduğu kişilerin;'});
CREATE (sec_180)-[:HAS_PARAGRAPH {order: 2}]->(para_187);
CREATE (item_188:Item {id: 'a', content: 'SUT’un 1.8.1 ve 1.8.2 maddelerinde tanımlanan katılım payları Kurumla sözleşmeli eczanelerce,'});
CREATE (para_187)-[:HAS_ITEM {order: 0}]->(item_188);
CREATE (item_189:Item {id: 'b', content: 'SUT’un 1.8.3.(1)a bendinde tanımlanan katılım payı Kurumla sözleşmeli optisyenlik müessesesi tarafından,'});
CREATE (para_187)-[:HAS_ITEM {order: 1}]->(item_189);
CREATE (item_188)-[:NEXT_ITEM]->(item_189);
CREATE (item_190:Item {id: 'c', content: 'SUT’un 1.8.3.(1)c bendinde tanımlanan katılım payı Kurumla sözleşmeli merkezler/eczaneler tarafından, kişilerden tahsil edilir.'});
CREATE (para_187)-[:HAS_ITEM {order: 2}]->(item_190);
CREATE (item_189)-[:NEXT_ITEM]->(item_190);
CREATE (para_182)-[:NEXT_PARAGRAPH]->(para_187);
CREATE (para_191:Paragraph {id: '4', content: '5510 sayılı Kanunun 60 ıncı maddesinin birinci fıkrasının (c) bendinin (1), (2) ve (3) numaralı alt bentleri gereği genel sağlık sigortalısı sayılanlar ile bunların bakmakla yükümlü olduğu kişilerin ödemiş oldukları katılım payları talepleri halinde, 3294 sayılı Sosyal Yardımlaşma ve Dayanışmayı Teşvik Kanunu hükümlerine göre sosyal yardımlaşma ve dayanışma vakıflarınca kendilerine geri ödenir.'});
CREATE (sec_180)-[:HAS_PARAGRAPH {order: 3}]->(para_191);
CREATE (para_187)-[:NEXT_PARAGRAPH]->(para_191);
CREATE (amend_192:Amendment {content: '(Ek:RG- 28/12/2018-30639/ 1 md. Yürürlük: 15/01/2019)'});
CREATE (sec_180)-[:HAS_AMENDMENT {order: 0}]->(amend_192);
CREATE (sec_193:Subsection {id: '1.8.1', title: 'Ayakta tedavide hekim ve diş hekimi muayenesi katılım payı', content: '(Değişik: RG- 25/08/2022- 31934/ 6-a md. Yürürlük: 03/09/2022) (Değişik: RG-25 /01/2025-32793/1 md. Yürürlük: 15/01/2025) .'});
CREATE (sec_180)-[:HAS_SUBSECTION {order: 0}]->(sec_193);
CREATE (para_194:Paragraph {id: '1', content: 'Birinci basamak sağlık hizmeti sunucularında yapılan hekim ve diş hekimi muayenesinden katılım payı alınmayacaktır. Diğer sağlık hizmeti sunucularında yapılan hekim ve diş hekimi muayenesi nedeniyle uygulanacak katılım payı tutarları aşağıda belirtilmiştir.'});
CREATE (sec_193)-[:HAS_PARAGRAPH {order: 0}]->(para_194);
CREATE (item_195:Item {id: 'a', content: 'İkinci basamak resmi sağlık hizmeti sunucularında .………………………………………………………......20 TL'});
CREATE (para_194)-[:HAS_ITEM {order: 0}]->(item_195);
CREATE (item_196:Item {id: 'b', content: 'Sağlık Bakanlığına bağlı eğitim ve araştırma hastaneleri ile bu hastanelere bağlı semt polikliniklerinde .…..45 TL'});
CREATE (para_194)-[:HAS_ITEM {order: 1}]->(item_196);
CREATE (item_195)-[:NEXT_ITEM]->(item_196);

// Batch 6
CREATE (item_197:Item {id: 'c', content: 'Sağlık Bakanlığınca üçüncü basamak hastane olarak basamaklandırılan Sağlık Bakanlığına bağlı hastanelerde .………………………………………………………………………………………………………….…….….45 TL'});
CREATE (para_194)-[:HAS_ITEM {order: 2}]->(item_197);
CREATE (item_196)-[:NEXT_ITEM]->(item_197);
CREATE (item_198:Item {id: 'ç', content: 'Diş hekimliği fakülteleri bulunan Devlet/vakıf üniversite hastaneleri ……………………………..………….45 TL'});
CREATE (para_194)-[:HAS_ITEM {order: 3}]->(item_198);
CREATE (item_197)-[:NEXT_ITEM]->(item_198);
CREATE (item_199:Item {id: 'd', content: 'Tıp fakülteleri bulunan Devlet üniversiteleri sağlık uygulama ve araştırma merkezlerinde .………….……...45 TL'});
CREATE (para_194)-[:HAS_ITEM {order: 4}]->(item_199);
CREATE (item_198)-[:NEXT_ITEM]->(item_199);
CREATE (item_200:Item {id: 'e', content: 'Tıp fakülteleri bulunan vakıf üniversiteleri sağlık uygulama ve araştırma merkezlerinde .……………..…….45 TL'});
CREATE (para_194)-[:HAS_ITEM {order: 5}]->(item_200);
CREATE (item_199)-[:NEXT_ITEM]->(item_200);
CREATE (item_201:Item {id: 'f', content: 'İkinci ve üçüncü basamak özel sağlık hizmeti sunucularında .……………………………………….………...50 TL Sağlık Bakanlığı tarafından sözleşme imzalanmış, görevlendirilmiş veya yetkilendirilmiş aile hekimlerinden, sağlık hizmeti sunucularına sevk edilerek yapılan hekim ve diş hekimi muayenesi nedeniyle uygulanacak katılım payı %50 oranında azaltılarak tahsil edilir.'});
CREATE (para_194)-[:HAS_ITEM {order: 6}]->(item_201);
CREATE (item_200)-[:NEXT_ITEM]->(item_201);
CREATE (para_202:Paragraph {id: '2', content: 'İkinci ve üçüncü basamak resmi sağlık hizmeti sunucularında yapılan muayeneler için öngörülen katılım payı;'});
CREATE (sec_193)-[:HAS_PARAGRAPH {order: 1}]->(para_202);
CREATE (item_203:Item {id: 'a', content: 'Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü oldukları kişiler için gelir ve aylıklarından,'});
CREATE (para_202)-[:HAS_ITEM {order: 0}]->(item_203);
CREATE (item_204:Item {id: 'b', content: ', Diğer kişiler için eczanelerce kişilerden, Kurumumuzla Kuzey Kıbrıs Türk Cumhuriyeti’nde eczanelerle sözleşme yapılıncaya kadar Kurumumuzla (Mülga: RG- 25/08/2022- 31934/ 6-b md. Yürürlük: 03/09/2022) sözleşmeli sağlık hizmeti sunucularınca kişilerden, tahsil edilir. (Değişik: RG- 25/08/2022- 31934/ 6-c md. Yürürlük: 03/09/2022)'});
CREATE (para_202)-[:HAS_ITEM {order: 1}]->(item_204);
CREATE (item_203)-[:NEXT_ITEM]->(item_204);
CREATE (para_194)-[:NEXT_PARAGRAPH]->(para_202);
CREATE (para_205:Paragraph {id: '3', content: 'İkinci ve üçüncü basamak özel sağlık hizmeti sunucularınca (Mülga: RG- 16/03/2023-32134/2-b md. Yürürlük: 24/03/2023) yapılan muayeneler için öngörülen katılım payı;'});
CREATE (sec_193)-[:HAS_PARAGRAPH {order: 2}]->(para_205);
CREATE (item_206:Item {id: 'a', content: 'Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü oldukları kişiler için gelir ve aylıklarından,'});
CREATE (para_205)-[:HAS_ITEM {order: 0}]->(item_206);
CREATE (item_207:Item {id: 'b', content: 'Diğer kişiler için; ayakta hekim ve diş hekimi muayenesi katılım payı sağlık hizmeti sunucusunca kişilerden, “Yeşil alan muayenesi” sonucunda oluşan katılım payı ise eczanelerce kişilerden, tahsil edilir.'});
CREATE (para_205)-[:HAS_ITEM {order: 1}]->(item_207);
CREATE (item_206)-[:NEXT_ITEM]->(item_207);
CREATE (para_202)-[:NEXT_PARAGRAPH]->(para_205);
CREATE (para_208:Paragraph {id: '4', content: 'Sağlık hizmeti sunucularında yapılan muayene sonucunda oluşan ve eczanelerce kişilerden tahsil edileceği belirtilen ayakta tedavide hekim ve diş hekimi muayenesi katılım payları  , SUT’un 4.1.2 - Yatarak tedavilerde reçetelerin düzenlenmesi başlıklı maddesinde tanımlanan yatan hasta 12 reçeteleri  ile 5510 sayılı Kanunun 60 ıncı maddesinin on ikinci fıkrası kapsamında genel sağlık sigortalısı sayılanlara askerlik hizmeti süresince düzenlenen reçeteleri hariç olmak üzere, kişilerin reçete ile eczaneye ilk müracaatında kişilerden tahsil edilir. (Değişik: RG- 25/08/2022- 31934/ 6-ç md. Yürürlük: 03/09/2022)'});
CREATE (sec_193)-[:HAS_PARAGRAPH {order: 3}]->(para_208);
CREATE (para_205)-[:NEXT_PARAGRAPH]->(para_208);
CREATE (para_209:Paragraph {id: '5', content: 'SUT’un 1.7.1 maddesinde belirtilen durumlarda muayene katılım payı tahsil edilmesi gerekenler için; resmi sağlık hizmeti sunucuları, ikinci ve üçüncü basamak özel sağlık hizmeti sunucularındaki (Mülga: RG- 16/03/2023-32134/2-b md. Yürürlük: 24/03/2023) muayenelerine ilişkin katılım payı sağlık hizmeti sunucularınca kişilerden tahsil edilir.'});
CREATE (sec_193)-[:HAS_PARAGRAPH {order: 4}]->(para_209);
CREATE (para_208)-[:NEXT_PARAGRAPH]->(para_209);
CREATE (para_210:Paragraph {id: '6', content: 'Bu maddede yer alan genel hükümler saklı kalmak kaydıyla; birinci basamak sağlık kuruluşları muayeneleri, Kurumca belirlenen kronik hastalıklar , elektronik sevk formu ile sevk edilen hastalar ve acil haller hariç olmak üzere 10 gün içerisinde aynı uzmanlık dalında farklı sağlık hizmeti sunucusuna yapılan başvurularda bu maddede belirtilen ayakta tedavide hekim ve diş hekimi muayenesi katılım payı tutarları 5 (beş) TL artırılarak tahsil edilir. Artırılan 5 (beş) TL’lik tutar; Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü oldukları kişiler için gelir ve aylıklarından, diğer kişiler için ise eczanelerce kişilerden tahsil edilir.'});
CREATE (sec_193)-[:HAS_PARAGRAPH {order: 5}]->(para_210);
CREATE (para_209)-[:NEXT_PARAGRAPH]->(para_210);
CREATE (amend_211:Amendment {content: '(Değişik: RG- 21/04/2024- 32524/2 md. Yürürlük: 30/04/2024)'});
CREATE (sec_193)-[:HAS_AMENDMENT {order: 0}]->(amend_211);
CREATE (amend_212:Amendment {content: '(Değişik: RG- 18/03/2014- 28945/ 3 md. Yürürlük: 18/03/2014)'});
CREATE (sec_193)-[:HAS_AMENDMENT {order: 1}]->(amend_212);
CREATE (amend_213:Amendment {content: '(Ek: RG- 30/04/2016- 29699/ 2 md. Yürürlük: \n30/04/2016)'});
CREATE (sec_193)-[:HAS_AMENDMENT {order: 2}]->(amend_213);
CREATE (amend_214:Amendment {content: '(Ek: RG- 04/02/2018- 30322/ 3 md. Yürürlük: 15/02/2018)'});
CREATE (sec_193)-[:HAS_AMENDMENT {order: 3}]->(amend_214);
CREATE (amend_215:Amendment {content: '(Ek: RG- 21/03/2018- 30367/ 1md. Yürürlük: 21/04/2018)'});
CREATE (sec_193)-[:HAS_AMENDMENT {order: 4}]->(amend_215);
CREATE (sec_216:Subsection {id: '1.8.2', title: 'Ayakta tedavide sağlanan ilaçlar için katılım payı'});
CREATE (sec_180)-[:HAS_SUBSECTION {order: 1}]->(sec_216);
CREATE (para_217:Paragraph {id: '1', content: 'Kurumca bedeli karşılanan ilaçlar için Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü oldukları kişilerden %10, diğer kişilerden %20 oranında katılım payı alınır.'});
CREATE (sec_216)-[:HAS_PARAGRAPH {order: 0}]->(para_217);
CREATE (para_218:Paragraph {id: '2', content: 'Ayrıca her bir reçete için;'});
CREATE (sec_216)-[:HAS_PARAGRAPH {order: 1}]->(para_218);
CREATE (item_219:Item {id: 'a', content: '3 kutuya kadar (üç kutu dâhil) temin edilen ilaçlar için……….3 (üç) TL,'});
CREATE (para_218)-[:HAS_ITEM {order: 0}]->(item_219);
CREATE (item_220:Item {id: 'b', content: '3 kutuya ilave temin edilen her bir kutu ilaç için……….……..1 (bir) TL, olmak üzere katılım payı alınır.'});
CREATE (para_218)-[:HAS_ITEM {order: 1}]->(item_220);
CREATE (item_219)-[:NEXT_ITEM]->(item_220);
CREATE (item_221:Item {id: 'c', content: 'Enjektabl formlar ile serum, beslenme ürünleri ve majistraller için kutu sayısına bakılmaksızın her bir kalem 1 kutu olarak değerlendirilir.'});
CREATE (para_218)-[:HAS_ITEM {order: 2}]->(item_221);
CREATE (item_220)-[:NEXT_ITEM]->(item_221);
CREATE (para_217)-[:NEXT_PARAGRAPH]->(para_218);
CREATE (para_222:Paragraph {id: '3', content: 'Sağlık raporu ile belgelendirilmek koşuluyla Kurumun resmi internet sitesinde (www.sgk.gov.tr) yayınlanan “Hasta Katılım Payından Muaf İlaçlar Listesi” nde (EK-4/D) yer alan hastalıklarda, listede belirtilen ilaçlar için bu maddede belirtilen katılım payları uygulanmaz ve kutu/kalem hesabında dikkate alınmaz.'});
CREATE (sec_216)-[:HAS_PARAGRAPH {order: 2}]->(para_222);
CREATE (para_218)-[:NEXT_PARAGRAPH]->(para_222);
CREATE (para_223:Paragraph {id: '4', content: 'Bu maddede tanımlanan ilaçlar için katılım payları;'});
CREATE (sec_216)-[:HAS_PARAGRAPH {order: 3}]->(para_223);
CREATE (item_224:Item {id: 'a', content: 'Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü olduğu kişiler için gelir ve aylıklarından mahsup edilmek suretiyle,'});
CREATE (para_223)-[:HAS_ITEM {order: 0}]->(item_224);
CREATE (item_225:Item {id: 'b', content: 'Diğer kişiler için ise Kurumla sözleşmeli eczaneler tarafından kişilerden,'});
CREATE (para_223)-[:HAS_ITEM {order: 1}]->(item_225);
CREATE (item_224)-[:NEXT_ITEM]->(item_225);
CREATE (item_226:Item {id: 'c', content: 'Yurt dışından temin edilen ilaçlar için; ilaçları temin eden kuruluş tarafından kişilerden, şahıslar tarafından temin edilmesi halinde Kurum tarafından kişilerden, tahsil edilir.'});
CREATE (para_223)-[:HAS_ITEM {order: 2}]->(item_226);
CREATE (item_225)-[:NEXT_ITEM]->(item_226);
CREATE (para_222)-[:NEXT_PARAGRAPH]->(para_223);
CREATE (sec_193)-[:NEXT_SUBSECTION]->(sec_216);
CREATE (sec_227:Subsection {id: '1.8.3', title: 'Tıbbi malzeme katılım payı'});
CREATE (sec_180)-[:HAS_SUBSECTION {order: 2}]->(sec_227);
CREATE (para_228:Paragraph {id: '1', content: 'Vücut dışı protez ve ortezlerden,'});
CREATE (sec_227)-[:HAS_PARAGRAPH {order: 0}]->(para_228);
CREATE (item_229:Item {id: 'a', content: 'Görmeye yardımcı tıbbi malzemelerden,'});
CREATE (para_228)-[:HAS_ITEM {order: 0}]->(item_229);
CREATE (item_230:Item {id: 'b', content: 'Ağız protezlerinden (SUT eki “Diş Tedavileri Puan Listesi” nde (EK-2/Ç) yer alan 404.010, 404.020, 404.030, 404.040, 404.050, 404.170, 404.180, 404.181, 404.190, 404.200, 404.201, 404.210, 404.220, 404.230, 404.360, 404.370, 404.380, 404.390,  404.395, 404.400, 404.410, 404.420 kod numarasında sayılanlar),'});
CREATE (para_228)-[:HAS_ITEM {order: 1}]->(item_230);
CREATE (item_229)-[:NEXT_ITEM]->(item_230);
CREATE (item_231:Item {id: 'c', content: 'Sağlık raporunda hayati öneme haiz olduğu belirtilmeyen diğer protezler ve ortezlerden, katılım payı alınır.'});
CREATE (para_228)-[:HAS_ITEM {order: 2}]->(item_231);
CREATE (item_230)-[:NEXT_ITEM]->(item_231);
CREATE (para_232:Paragraph {id: '2', content: 'Vücut dışı protez ve ortezlerden, Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü oldukları kişiler için %10, diğer kişiler için %20 oranında katılım payı alınır. Ancak katılım payı tutarı vücut dışı protez veya ortezin alındığı tarihteki brüt asgarî ücretin %75’ini geçemez. %75’lik üst sınırın hesaplanmasında her bir protez ve ortez bağımsız olarak değerlendirilir.'});
CREATE (sec_227)-[:HAS_PARAGRAPH {order: 1}]->(para_232);
CREATE (para_228)-[:NEXT_PARAGRAPH]->(para_232);
CREATE (para_233:Paragraph {id: '3', content: 'Görmeye yardımcı tıbbi malzemeler ile ayakta tedavide kullanılan tıbbi malzemelerden sözleşmeler kapsamında temin edilen tıbbi malzemelere ilişkin katılım payı;'});
CREATE (sec_227)-[:HAS_PARAGRAPH {order: 2}]->(para_233);
CREATE (item_234:Item {id: 'a', content: 'Kurumdan gelir ve aylık alanlar ile bakmakla yükümlü olduğu kişiler için gelir ve aylıklarından mahsup edilmek suretiyle,'});
CREATE (para_233)-[:HAS_ITEM {order: 0}]->(item_234);
CREATE (item_235:Item {id: 'b', content: 'Diğer kişiler için ise Kurumla sözleşmeli optisyenlik müessesesi , merkezler/eczaneler tarafından kişilerden, tahsil edilir.'});

// Batch 7
CREATE (para_233)-[:HAS_ITEM {order: 1}]->(item_235);
CREATE (item_234)-[:NEXT_ITEM]->(item_235);
CREATE (para_232)-[:NEXT_PARAGRAPH]->(para_233);
CREATE (para_236:Paragraph {id: '4', content: 'Ağız protezlerine ilişkin katılım payı; (Değişik: RG- 25/08/2022- 31934/ 6-d md. Yürürlük: 03/09/2022)'});
CREATE (sec_227)-[:HAS_PARAGRAPH {order: 3}]->(para_236);
CREATE (item_237:Item {id: 'a', content: 'Kurumla sözleşmeli sağlık hizmeti sunucularınca yapılan ağız protezi katılım payları, sağlık hizmeti sunucularınca kişilerden,'});
CREATE (para_236)-[:HAS_ITEM {order: 0}]->(item_237);
CREATE (item_238:Item {id: 'b', content: 'Kurumla sözleşmesiz; serbest dişhekimlikleri ile sağlık kurum veya kuruluşlarında yaptırılan ağız protezi katılım payları, Kurumca ödeme aşamasında kişilerden, tahsil edilir.'});
CREATE (para_236)-[:HAS_ITEM {order: 1}]->(item_238);
CREATE (item_237)-[:NEXT_ITEM]->(item_238);
CREATE (para_233)-[:NEXT_PARAGRAPH]->(para_236);
CREATE (para_239:Paragraph {id: '5', content: 'Kişilerce temin edilen ve katılım payı tahsil edilmesi gereken vücut dışı protez ve ortezler için katılım payı, Kurumca ödeme aşamasında kişilerden tahsil edilir.'});
CREATE (sec_227)-[:HAS_PARAGRAPH {order: 4}]->(para_239);
CREATE (para_236)-[:NEXT_PARAGRAPH]->(para_239);
CREATE (para_240:Paragraph {id: '6', content: 'Sağlık kurumlarınca temin edilen ve SUT hükümleri gereği katılım payı tahsil edilmesi gereken tıbbi malzemelerin katılım payı tıbbi malzemeyi temin eden sağlık kurumlarınca kişilerden tahsil edilir.'});
CREATE (sec_227)-[:HAS_PARAGRAPH {order: 5}]->(para_240);
CREATE (para_239)-[:NEXT_PARAGRAPH]->(para_240);
CREATE (amend_241:Amendment {content: '(Ek: RG- 05/08/2015- 29436/ 1 md. Yürürlük: 05/08/2015)'});
CREATE (sec_227)-[:HAS_AMENDMENT {order: 0}]->(amend_241);
CREATE (amend_242:Amendment {content: '(Değişik: RG- 28/12/2018-30639/ 2 md. Yürürlük: 15/01/2019)'});
CREATE (sec_227)-[:HAS_AMENDMENT {order: 1}]->(amend_242);
CREATE (amend_243:Amendment {content: '(Ek:RG- 28/12/2018- 30639/ 2 md. Yürürlük: \n15/01/2019)'});
CREATE (sec_227)-[:HAS_AMENDMENT {order: 2}]->(amend_243);
CREATE (sec_216)-[:NEXT_SUBSECTION]->(sec_227);
CREATE (sec_244:Subsection {id: '1.8.4', title: 'Yardımcı üreme yöntemi katılım payları'});
CREATE (sec_180)-[:HAS_SUBSECTION {order: 3}]->(sec_244);
CREATE (para_245:Paragraph {id: '1', content: 'Bir hastalığın tedavisinin başka tıbbi bir yöntemle mümkün olmaması nedeniyle yapılacak yardımcı üreme yöntemi tedavisi dışındaki yardımcı üreme yöntemi 13 tedavilerinde birinci denemede %30, ikinci denemede %25 üçüncü denemede %20 oranında olmak üzere bu tedaviler için belirlenen bedeller üzerinden katılım payı alınır.'});
CREATE (sec_244)-[:HAS_PARAGRAPH {order: 0}]->(para_245);
CREATE (para_246:Paragraph {id: '2', content: 'Yardımcı üreme yöntemi katılım payları, tedavinin sağlandığı sağlık hizmeti sunucusunca kişilerden tahsil edilir.'});
CREATE (sec_244)-[:HAS_PARAGRAPH {order: 1}]->(para_246);
CREATE (para_245)-[:NEXT_PARAGRAPH]->(para_246);
CREATE (amend_247:Amendment {content: '(Değişik: RG- 26/11/2016- 29900/ 1 md. Yürürlük: 07/12/2016)'});
CREATE (sec_244)-[:HAS_AMENDMENT {order: 0}]->(amend_247);
CREATE (amend_248:Amendment {content: '(Ek: RG- 01/10/2014- 29136/ 1 md. Yürürlük: 01/10/2014)'});
CREATE (sec_244)-[:HAS_AMENDMENT {order: 1}]->(amend_248);
CREATE (sec_227)-[:NEXT_SUBSECTION]->(sec_244);
CREATE (sec_249:Subsection {id: '1.8.5', title: 'Katılım payı alınmayacak haller, sağlık hizmetleri ve kişiler'});
CREATE (sec_180)-[:HAS_SUBSECTION {order: 4}]->(sec_249);
CREATE (para_250:Paragraph {id: '1', content: 'İş kazasına uğrayan veya meslek hastalığına yakalanan sigortalılardan, bu durumları nedeniyle sağlanan sağlık hizmetleri için SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 0}]->(para_250);
CREATE (para_251:Paragraph {id: '2', content: 'Askerî tatbikat ve manevralarda sağlanan sağlık hizmetleri için SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 1}]->(para_251);
CREATE (para_250)-[:NEXT_PARAGRAPH]->(para_251);
CREATE (para_252:Paragraph {id: '3', content: '5510 sayılı Kanunun 75 inci maddesinde yer alan afet ve savaş hali nedeniyle sağlanan sağlık hizmetleri için SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 2}]->(para_252);
CREATE (para_251)-[:NEXT_PARAGRAPH]->(para_252);
CREATE (para_253:Paragraph {id: '4', content: '5510 sayılı Kanunun 94 üncü maddesinde tanımlanan kontrol muayenelerinden SUT’un 1.8.1 maddesinde tanımlanan katılım payı alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 3}]->(para_253);
CREATE (para_252)-[:NEXT_PARAGRAPH]->(para_253);
CREATE (para_254:Paragraph {id: '5', content: 'Acil servislerde verilen ve SUT eki “Hizmet Başı İşlem Puan Listesi” nde (EK-2/B) yer alan 520.021 kodlu “Yeşil alan muayenesi” adı altında Kuruma fatura edilebilen sağlık hizmetleri hariç olmak üzere acil servislerde verilen sağlık hizmetleri, bedeli Kurumca karşılanmayan ayakta tedavide hekim ve diş hekimi muayeneleri, Sağlık Bakanlığı tarafından sözleşme yapılmış, görevlendirilmiş veya yetkilendirilmiş aile hekimi muayeneleri ile (Değişik: RG- 25/08/2022- 31934/ 6-e md. Yürürlük: 03/09/2022) Diyaliz merkezleri ve Sağlık Bakanlığından ruhsatlı diğer özelleşmiş tedavi merkezleri, Halk Sağlığı Genel Müdürlüğü Mikrobiyoloji Referans laboratuvarları tarafından sunulan sağlık hizmetlerinde SUT’un 1.8.1 maddesinde tanımlanan katılım payı alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 4}]->(para_254);
CREATE (para_253)-[:NEXT_PARAGRAPH]->(para_254);
CREATE (para_255:Paragraph {id: '6', content: 'Kurumca finansmanı sağlanan kişiye yönelik koruyucu sağlık hizmetleri için SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 5}]->(para_255);
CREATE (para_254)-[:NEXT_PARAGRAPH]->(para_255);
CREATE (para_256:Paragraph {id: '7', content: 'Sağlık raporu ile belgelendirilmesi şartıyla; Kurumca belirlenen SUT Eki “Ayakta Tedavide Hekim ve Diş Hekimi Muayenesi Katılım Payı Alınmayacak Kronik Hastalıklar Listesi” nde (EK-1/A) yer alan kronik hastalıklarda, kişilerin bu hastalıkları ile ilgili uzmanlık dalındaki ayaktan muayenelerinde SUT’un 1.8.1 maddesinde tanımlanan katılım payı alınmaz. Ancak; aynı muayenede Kurumca belirlenen katılım payı alınmayacak kronik hastalıklar listesinde yer almayan başka bir tanının da tespit edilmesi ve/veya bu tanıya yönelik tedavinin düzenlenmesi halinde SUT’un 1.8.1 maddesinde tanımlanan katılım payı alınır.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 6}]->(para_256);
CREATE (para_255)-[:NEXT_PARAGRAPH]->(para_256);
CREATE (para_257:Paragraph {id: '8', content: 'Tetkik ve tahliller ile diğer tanı yöntemlerinde kullanılan ilaçlardan, yatarak tedavilerde kullanılan ilaçlardan, sağlık raporu ile belgelendirilmek şartıyla EK-4/D Listesinde yer alan ilaçlardan SUT’un 1.8.2 maddesinde tanımlanan katılım payı alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 7}]->(para_257);
CREATE (para_256)-[:NEXT_PARAGRAPH]->(para_257);
CREATE (para_258:Paragraph {id: '9', content: 'Tıbbi sarf malzemeleri ile SUT’un 1.8.3(1) fıkrasında yer almayan tıbbi malzemelerden katılım payı alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 8}]->(para_258);
CREATE (para_257)-[:NEXT_PARAGRAPH]->(para_258);
CREATE (para_259:Paragraph {id: '10', content: 'Sağlık raporu ile belgelendirilmek şartıyla; organ, doku ve kök hücre nakline ilişkin sağlık hizmetleri için SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 9}]->(para_259);
CREATE (para_258)-[:NEXT_PARAGRAPH]->(para_259);
CREATE (para_260:Paragraph {id: '11', content: '1005 sayılı İstiklal Madalyası Verilmiş Bulunanlara Vatani Hizmet Tertibinden Şeref Aylığı Bağlanması Hakkında Kanun hükümlerine göre şeref aylığı alan kişiler ile bunların eşlerinden, SUT’un 1.8.1, 1.8.2, 1.8.3 ve 1.8.4 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 10}]->(para_260);
CREATE (para_259)-[:NEXT_PARAGRAPH]->(para_260);
CREATE (para_261:Paragraph {id: '12', content: '3292 sayılı Vatani Hizmet Tertibi Aylıklarının Bağlanması Hakkında Kanun hükümlerine göre aylık alan kişilerden SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 11}]->(para_261);
CREATE (para_260)-[:NEXT_PARAGRAPH]->(para_261);
CREATE (para_262:Paragraph {id: '13', content: '2330 sayılı Nakdi Tazminat ve Aylık Bağlanması Hakkında Kanun hükümlerine göre aylık alan kişiler ile bunların bakmakla yükümlü olduğu kişilerden SUT’un 1.8.1, 1.8.2, 1.8.3 ve 1.8.4 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 12}]->(para_262);
CREATE (para_261)-[:NEXT_PARAGRAPH]->(para_262);
CREATE (para_263:Paragraph {id: '14', content: '2828 sayılı Kanunu hükümlerine göre korunma, bakım ve rehabilitasyon hizmetlerinden ücretsiz faydalanan kişilerden SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 13}]->(para_263);
CREATE (para_262)-[:NEXT_PARAGRAPH]->(para_263);
CREATE (para_264:Paragraph {id: '15', content: 'Harp malûllüğü aylığı alanlar ile 3713 sayılı Terörle Mücadele Kanunu kapsamında aylık alanlardan ve bunların bakmakla yükümlü olduğu kişilerden SUT’un 1.8.1, 1.8.2, 1.8.3 ve 1.8.4 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 14}]->(para_264);
CREATE (para_263)-[:NEXT_PARAGRAPH]->(para_264);
CREATE (para_265:Paragraph {id: '16', content: 'Vazife malûllerinden SUT’un 1.8.1, 1.8.2, 1.8.3 ve 1.8.4 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 15}]->(para_265);
CREATE (para_264)-[:NEXT_PARAGRAPH]->(para_265);
CREATE (para_266:Paragraph {id: '17', content: 'Kurumca iade alınan tıbbi malzemelerden katılım payı alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 16}]->(para_266);
CREATE (para_265)-[:NEXT_PARAGRAPH]->(para_266);
CREATE (para_267:Paragraph {id: '18', content: 'Polis akademisi ile fakülte ve yüksekokullarda, Emniyet Genel Müdürlüğü hesabına okuyan veya kendi hesabına okumakta iken Emniyet Genel Müdürlüğü hesabına okumaya devam eden öğrencilerden SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 17}]->(para_267);
CREATE (para_266)-[:NEXT_PARAGRAPH]->(para_267);
CREATE (para_268:Paragraph {id: '19', content: 'Harp okulları ile fakülte ve yüksekokullarda, Türk Silahlı Kuvvetleri hesabına okuyan veya kendi hesabına okumakta iken askerî öğrenci olanlar ile astsubay meslek yüksekokulları ve astsubay naspedilmek üzere temel askerlik eğitimine tâbi tutulan adaylardan SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 18}]->(para_268);
CREATE (para_267)-[:NEXT_PARAGRAPH]->(para_268);
CREATE (para_269:Paragraph {id: '20', content: '19.05.2011, 23.10.2011 ve 9.11.211 tarihlerinde meydana gelen depremler sonucunda yaralanan veya sakat kalanlara verilecek protez, ortez, araç ve gereç bedelleri için SUT’un 1.8.3 maddesinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 19}]->(para_269);
CREATE (para_268)-[:NEXT_PARAGRAPH]->(para_269);
CREATE (para_270:Paragraph {id: '21', content: '3713 sayılı Kanunun 21 inci maddesinde sayılan olaylara maruz kalmaları nedeniyle yaralananların tedavileri sonuçlanıncaya veya maluliyetleri kesinleşinceye kadar sağlanacak sağlık hizmetlerinde, bu kişilerden SUT’un 1.8.1, 1.8.2, 1.8.3 ve 1.8.4 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 20}]->(para_270);
CREATE (para_269)-[:NEXT_PARAGRAPH]->(para_270);

// Batch 8
CREATE (para_271:Paragraph {id: '22', content: '5510 sayılı Kanunun 60 ıncı maddesinin;'});
CREATE (sec_249)-[:HAS_PARAGRAPH {order: 21}]->(para_271);
CREATE (item_272:Item {id: 'a', content: 'Onikinci fıkrası kapsamında genel sağlık sigortalısı sayılanlardan SUT’un 1.8.1, 1.8.2 ve 1.8.3 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (para_271)-[:HAS_ITEM {order: 0}]->(item_272);
CREATE (item_273:Item {id: 'b', content: 'Onüçüncü ve ondördüncü fıkraları kapsamında genel sağlık sigortalısı sayılanlar ve bunların bakmakla yükümlü olduğu kişilerden, SUT’un 1.8.1, 1.8.2, 1.8.3 ve 1.8.4 maddelerinde tanımlanan katılım payları alınmaz.'});
CREATE (para_271)-[:HAS_ITEM {order: 1}]->(item_273);
CREATE (item_272)-[:NEXT_ITEM]->(item_273);
CREATE (para_270)-[:NEXT_PARAGRAPH]->(para_271);
CREATE (amend_274:Amendment {content: '(Ek: RG- 25/03/2017- 30018/ 2 md. Yürürlük: 01/03/2017)'});
CREATE (sec_249)-[:HAS_AMENDMENT {order: 0}]->(amend_274);
CREATE (sec_244)-[:NEXT_SUBSECTION]->(sec_249);
CREATE (sec_154)-[:NEXT_SECTION]->(sec_180);
CREATE (sec_275:Section {id: '1.9', title: 'İlave ücret'});
CREATE (doc_1)-[:HAS_SECTION {order: 8}]->(sec_275);
CREATE (sec_276:Subsection {id: '1.9.1', title: 'İlave ücret alınması', content: '(Değişik: RG- 04/05/2013- 28637/ 2 md. Yürürlük: 01/05 /2013) 14'});
CREATE (sec_275)-[:HAS_SUBSECTION {order: 0}]->(sec_276);
CREATE (para_277:Paragraph {id: '1', content: 'İlave ücret alınması uygulamasında;'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 0}]->(para_277);
CREATE (item_278:Item {id: 'a', content: 'Kurumla sözleşmeli; vakıf üniversiteleri, ikinci ve üçüncü basamak özel sağlık hizmeti sunucuları  tarafından; Kurumca belirlenen oranı geçmemek kaydıyla kişilerden ilave ücret alınabilir.'});
CREATE (para_277)-[:HAS_ITEM {order: 0}]->(item_278);
CREATE (item_279:Item {id: 'b', content: 'Yükseköğretim kurumlarına ait sağlık hizmeti sunucularında (vakıf üniversiteleri  hariç) öğretim üyeleri tarafından mesai saatleri dışında bizzat verilen sağlık hizmetleri için bir defada asgari ücretin iki katını geçmemek üzere, Kurumca belirlenmiş sağlık hizmetleri bedelinin poliklinik muayenelerinde en fazla iki katı, diğer hizmetlerde en fazla bir katı kadar ilave ücret alınabilir. Sağlık Bakanlığı ve bağlı kuruluşlarına ait sağlık tesisleri ve üniversitelere ait ilgili birimlerin birlikte kullanımına ilişkin protokolü bulunan sağlık hizmeti sunucularında öğretim üyeleri tarafından ilave ücret alınamaz.'});
CREATE (para_277)-[:HAS_ITEM {order: 1}]->(item_279);
CREATE (item_278)-[:NEXT_ITEM]->(item_279);
CREATE (item_280:Item {id: 'c', content: '(a) ve (b) bentlerinde belirtilen sağlık hizmeti sunucularınca SUT ve eklerinde yer alan sağlık hizmetleri işlem bedellerinin tamamı üzerinden Kuruma fatura edilebilen tutarlar esas alınarak kişilerden ilave ücret alınabilir. Ancak SUT eki EK-2/B, EK-2/C, EK-2/Ç listelerinde yer alan işlemlerin bedellerine ilave olarak Kuruma ayrıca faturalandırılabilen  tıbbi malzeme, ilaçlar ve kan bileşenleri ile SUT eki EK-2/A Listesindeki tutarlara dahil olan işlemler için ayrıca ilave ücret alınamaz.'});
CREATE (para_277)-[:HAS_ITEM {order: 2}]->(item_280);
CREATE (item_279)-[:NEXT_ITEM]->(item_280);
CREATE (para_281:Paragraph {id: '2', content: 'İlave ücretler, genel sağlık sigortalılarınca veya bakmakla yükümlü olunan kişilerce ve/veya sağlık hizmeti sunucularınca Kurumdan talep edilemez.'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 1}]->(para_281);
CREATE (para_277)-[:NEXT_PARAGRAPH]->(para_281);
CREATE (para_282:Paragraph {id: '3', content: 'Kurumla sözleşmeli eczaneler, eşdeğer ilaçların azami fiyatı ile kişinin talep ettiği eşdeğer ilacın fiyatı arasında oluşacak fark ücretini, Kurumla sözleşmeli optisyenlik müesseseleri de kişinin talep ettiği görmeye yardımcı malzemenin bedeli ile Kurumca ödenen görmeye yardımcı malzeme bedeli arasında oluşacak fark ücretini kişilerden talep edebileceklerdir. Bu fark ücreti ilave ücret olarak değerlendirilmez.'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 2}]->(para_282);
CREATE (para_281)-[:NEXT_PARAGRAPH]->(para_282);
CREATE (para_283:Paragraph {id: '4', content: 'Sağlık hizmeti sunucularınca, Kurumca finansmanı sağlanmayan sağlık hizmetleri için talep edilen ücretler, ilave ücret olarak değerlendirilmez.'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 3}]->(para_283);
CREATE (para_282)-[:NEXT_PARAGRAPH]->(para_283);
CREATE (para_284:Paragraph {id: '5', content: 'Sağlık hizmeti sunucusu, sunduğu sağlık hizmetleri öncesinde, alacağı ilave ücrete ilişkin olarak hasta veya hasta yakınının yazılı onayını alır. Bu yazılı onay alınmadan, işlemler sonrasında herhangi bir gerekçe ileri sürerek ilave ücret talebinde bulunamaz. (Değişik: RG- 04/02/2018- 30322/ 4-a md. Yürürlük: 15/02/2018)'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 4}]->(para_284);
CREATE (para_283)-[:NEXT_PARAGRAPH]->(para_284);
CREATE (para_285:Paragraph {id: '6', content: 'Hastanın acil servislerde 24 saat içinde stabilizasyonu esastır. Hastanın acil servise başvurusundan itibaren 24 saat içinde stabilize edilerek ilgili kliniğe yatışı ya da başka bir sağlık hizmeti sunucusunun yataklı kliniğine sevk edilmesiyle acil hal sona erer. Acil servislerden kabul edilerek doğrudan uygulanan acil girişimsel işlemler ile 24 saat içinde acil gözlem ünitelerinde uygulanan tüm sağlık hizmetleri için ilave ücret alınamaz. Hastadan ilave ücret alınabilmesi için hastaya/hasta yakınına acil halin sona erdiğine ve müteakip işlemlerin ilave ücrete tabi olduğuna ilişkin “Acil Halin Sona Ermesine İlişkin Bilgilendirme Formu” (EK-1/D) kullanılarak, yazılı bilginin imza karşılığı verilmesi zorunludur. (Değişik: RG- 04/02/2018- 30322/ 4-b md. Yürürlük: 15/02/2018)'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 5}]->(para_285);
CREATE (para_284)-[:NEXT_PARAGRAPH]->(para_285);
CREATE (para_286:Paragraph {id: '7', content: 'Kurumla sözleşmeli vakıf üniversiteleri,  ikinci ve üçüncü basamak özel sağlık hizmeti sunucuları, aynı başvuru numarası altında yatarak tedavilerde yapılan Kurumca karşılanan sağlık hizmeti bedellerinin toplamının 100 (yüz) TL’yi aşması halinde, bu hizmetleri ve varsa ilave ücret tutarını gösterir, SUT eki “Hastaya Sunulmuş Olan Hizmetleri ve İlave Ücreti Gösterir Belge (EK-1/B)” yi en geç hastanın taburcu olduğu tarihte hastaya vermek zorundadır. Söz konusu bilgiler aynı süreler içerisinde elektronik ortamda da verilebilir.'});
CREATE (sec_276)-[:HAS_PARAGRAPH {order: 6}]->(para_286);
CREATE (para_285)-[:NEXT_PARAGRAPH]->(para_286);
CREATE (amend_287:Amendment {content: '(Değişik: RG- 01/08/2013- 28725/ 1 md. Yürürlük: 01/08/2013)'});
CREATE (sec_276)-[:HAS_AMENDMENT {order: 0}]->(amend_287);
CREATE (amend_288:Amendment {content: '(Değişik: RG- 18/03/2014- 28945/ 4 md. Yürürlük: 17/01/2014)'});

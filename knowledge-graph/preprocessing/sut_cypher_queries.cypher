CREATE (sec_1601:Subsection {id: '3.3.32', title: 'İşitme cihazı ve kulak kalıbı', content: '63'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 31}]->(sec_1601);
CREATE (para_1602:Paragraph {id: '1', content: 'Dijital programlanabilir işitme cihazlarının bedelleri Kurumca karşılanır. Kurumca bedeli karşılanacak olan kulak arkası veya kulak içi/kanal içi dijital programlanabilir işitme cihazları asgari;'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 0}]->(para_1602);
CREATE (item_1603:Item {id: 'a', content: 'Otomatik veya manuel ses kontrol sistemi, maksimum çıkış kontrol sistemi, kazanç kontrol sistemi,'});
CREATE (para_1602)-[:HAS_ITEM {order: 0}]->(item_1603);
CREATE (item_1604:Item {id: 'b', content: 'En az dört kanal (Kanaldan bağımsız-channel free sinyal işleme özellikli cihazlarda bu özellik aranmaz.),'});
CREATE (para_1602)-[:HAS_ITEM {order: 1}]->(item_1604);
CREATE (item_1603)-[:NEXT_ITEM]->(item_1604);
CREATE (item_1605:Item {id: 'c', content: 'FM sistem uyumu (18 yaş üzeri hastalarda ve kulak içi/kanal içi cihazlarda bu şart aranmaz),'});
CREATE (para_1602)-[:HAS_ITEM {order: 2}]->(item_1605);
CREATE (item_1604)-[:NEXT_ITEM]->(item_1605);
CREATE (item_1606:Item {id: 'ç', content: 'Gürültü azaltıcı ve feedback yönetimi,'});
CREATE (para_1602)-[:HAS_ITEM {order: 3}]->(item_1606);
CREATE (item_1605)-[:NEXT_ITEM]->(item_1606);
CREATE (item_1607:Item {id: 'd', content: 'Çift mikrofon (kulak içi/kanal içi cihazda bu şart aranmaz), özelliklerine sahip olmalıdır. 13 (on üç) yaş altı hastalarda kulak içi/kanal içi cihaz kullanıldığı takdirde bedeli Kurumca karşılanmaz.'});
CREATE (para_1602)-[:HAS_ITEM {order: 4}]->(item_1607);
CREATE (item_1606)-[:NEXT_ITEM]->(item_1607);
CREATE (para_1608:Paragraph {id: '2', content: 'İşitme cihazı bedellerinin ödenebilmesi için SUT’un 5.3.2 numaralı maddesinde tanımlanan belgelere ilave olarak;'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 1}]->(para_1608);
CREATE (item_1609:Item {id: 'a', content: '0-4 yaş çocuklar için işitsel beyin sapı odyometrisi (ABR Testi) ve otoakustik emisyon ile birlikte davranım odyometri testi sonucunun kulak burun boğaz hastalıkları uzman hekimi veya odyolog tarafından imza ve kaşesinin bulunduğu onaylanmış aslı,'});
CREATE (para_1608)-[:HAS_ITEM {order: 0}]->(item_1609);
CREATE (item_1610:Item {id: 'b', content: '4 yaş üzeri saf ses odyometri testi yapılan hastalar için saf ses odyometri testinin, kulak burun boğaz hastalıkları uzman hekimi veya odyolog veya odyometrist tarafından onaylanmış aslı,'});
CREATE (para_1608)-[:HAS_ITEM {order: 1}]->(item_1610);
CREATE (item_1609)-[:NEXT_ITEM]->(item_1610);
CREATE (item_1611:Item {id: 'c', content: '4 yaş üzeri saf ses odyometri testi yapılamayan hastalar için işitsel beyin sapı odyometrisi (ABR Testi) ve otoakustik emisyon ile birlikte davranım odyometri testi sonucunun kulak burun boğaz hastalıkları uzman hekimi veya odyolog tarafından imza ve kaşesinin bulunduğu onaylanmış aslı, istenecektir. Belirtilen odyolojik testlerin tamamının sağlık kurulu raporunun düzenlendiği sağlık hizmeti sunucusunca yapılmış olması gerekmekte olup, odyolojik test sonuçları 6 (altı) ay süreyle geçerlidir.'});
CREATE (para_1608)-[:HAS_ITEM {order: 2}]->(item_1611);
CREATE (item_1610)-[:NEXT_ITEM]->(item_1611);
CREATE (para_1602)-[:NEXT_PARAGRAPH]->(para_1608);
CREATE (para_1612:Paragraph {id: '3', content: 'İşitme eşiği tayini ABR testi ile yapılması gerekenlerde, 500 veya 1000 Hz Tonal ABR eşikleri ve klik ABR de elde edilen eşikler test rapor kısmında dB nHL olarak belirtilmelidir.'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 2}]->(para_1612);
CREATE (para_1608)-[:NEXT_PARAGRAPH]->(para_1612);
CREATE (para_1613:Paragraph {id: '4', content: 'İşitme eşiği tayini saf ses odyometri testi ile yapılmışsa; test en az 500-1000-2000-4000 Hz frekanslarında hava yolu ve 500-1000-2000-4000 Hz frekanslarında kemik yolu işitme eşiklerini ve konuşmayı ayırt etme test sonuçlarını içermelidir. 8 (sekiz) yaş altı çocuklarda konuşmayı ayırt etme skoru şartı aranmaz. 8 (sekiz) yaş ve üzerinde konuşmayı ayırt etme testinin yapılamadığı durumlarda ise gerekçenin (hastanın Türkçe bilmemesi, serabral palsi, motor mental retardasyon, afazi gibi) sağlık kurulu raporunda belirtilmesi gereklidir.'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 3}]->(para_1613);
CREATE (para_1612)-[:NEXT_PARAGRAPH]->(para_1613);
CREATE (para_1614:Paragraph {id: '5', content: 'İşitme cihazı bedelinin Kurumca karşılanabilmesi için;'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 4}]->(para_1614);
CREATE (item_1615:Item {id: 'a', content: '0-18 yaş çocuklarda; işitme cihazı temini için sağlık kurulu raporlarının, en az 1 (bir) kulak burun boğaz hastalıkları uzman hekiminin yer aldığı, üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga:RG-16/03/2023-32134/17-u md. Yürürlük:24/03/2023) düzenlenmesi gerekmektedir.'});
CREATE (para_1614)-[:HAS_ITEM {order: 0}]->(item_1615);
CREATE (item_1616:Item {id: 'b', content: '18 (on sekiz) yaş üzeri hastalarda işitme cihazı temini için sağlık kurulu raporlarının en az 1 (bir) kulak burun boğaz hastalıkları uzman hekiminin yer aldığı, resmi sağlık hizmeti sunucularınca (Mülga:RG-16/03/2023-32134/17-u md. Yürürlük:24/03/2023) düzenlenmesi gerekmektedir.'});

// Batch 44
CREATE (para_1614)-[:HAS_ITEM {order: 1}]->(item_1616);
CREATE (item_1615)-[:NEXT_ITEM]->(item_1616);
CREATE (item_1617:Item {id: 'c', content: 'Sağlık kurulu raporlarında kalıcı işitme kaybı olduğu ve bu fıkranın (ç) bendinde belirtilen odyolojik kriterleri sağladığının belirtilmesi gerekmektedir.'});
CREATE (para_1614)-[:HAS_ITEM {order: 2}]->(item_1617);
CREATE (item_1616)-[:NEXT_ITEM]->(item_1617);
CREATE (item_1618:Item {id: 'ç', content: 'İşitme eşikleri saf ses odyometri testi veya davranım odyometri testi ile belirlenmiş ise ilgili kulakta 500-1000- 2000-4000 Hz frekanslarında hava yolu saf ses ortalamasının 26 dB ve üzerinde, ABR ile belirlenmiş ise Tonal ve Klik ABR’de elde edilen eşiklerin 30 dB ve üzerinde olması gerekmektedir.'});
CREATE (para_1614)-[:HAS_ITEM {order: 3}]->(item_1618);
CREATE (item_1617)-[:NEXT_ITEM]->(item_1618);
CREATE (para_1613)-[:NEXT_PARAGRAPH]->(para_1614);
CREATE (para_1619:Paragraph {id: '6', content: 'Resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-u md. Yürürlük:24/03/2023) görevli kulak burun boğaz hastalıkları uzman hekimi raporuna istinaden; 13 (on üç) yaş altı hastalarda 6 (altı) ayda 1 (bir) defa, 13 (on üç) yaş üzeri hastalarda ise yılda 1 (bir) defa işitme cihazı kulak kalıbı bedelleri Kurumca karşılanır. Ancak, işitme cihazlarının ilk kez alınması aşamasında kulak kalıbı bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 5}]->(para_1619);
CREATE (para_1614)-[:NEXT_PARAGRAPH]->(para_1619);
CREATE (para_1620:Paragraph {id: '7', content: '18 yaş altı çocuklar için belirlenmiş olan işitme cihazı tutarı; 0-4 yaş için %80, 5-12 yaş için %60 ve 13-18 yaş için %50 oranında artırılarak Kurumca bedeli karşılanır.'});
CREATE (sec_1601)-[:HAS_PARAGRAPH {order: 6}]->(para_1620);
CREATE (para_1619)-[:NEXT_PARAGRAPH]->(para_1620);
CREATE (sec_1600)-[:NEXT_SUBSECTION]->(sec_1601);
CREATE (sec_1621:Subsection {id: '3.3.33', title: 'İşitsel implantlar'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 32}]->(sec_1621);
CREATE (sec_1622:Subsection {id: '3.3.33.A', title: 'Genel hükümler'});
CREATE (sec_1621)-[:HAS_SUBSECTION {order: 0}]->(sec_1622);
CREATE (para_1623:Paragraph {id: '1', content: 'İşitsel implantların bedelleri sadece üçüncü basamak (Mülga:RG-16/03/2023-32134/17-ü md. Yürürlük: 24/03/2023) sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-ü md. Yürürlük:24/03/2023) uygulanması halinde Kurumca karşılanır. (Değişik: RG- 16/03/2023-32134/17-v md. Yürürlük: 24/03/2023)'});
CREATE (sec_1622)-[:HAS_PARAGRAPH {order: 0}]->(para_1623);
CREATE (sec_1624:Subsection {id: '3.3.33.B', title: 'Koklear implant', content: 'Koklear implant bedeli; Sağlık Bakanlığı İşitsel İmplantlar Bilimsel Danışma Komisyonu tarafından koklear implant yerleştirilmesi uygun görülen kişilerde uygulanması halinde veya aşağıdaki kriterlere uyan, bilateral ileri-çok ileri derecede sensörinöral işitme kaybı olan ve işitme cihazından yarar görmediği sağlık kurulu raporu ile belgelendirilen hastalarda Kurumca karşılanır.'});
CREATE (sec_1621)-[:HAS_SUBSECTION {order: 1}]->(sec_1624);
CREATE (para_1625:Paragraph {id: '1', content: 'En az 3 (üç) aylık süre ile binaural işitme cihazı kullanımından fayda görmediği sağlık kurulu raporunda belirtilmelidir.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 0}]->(para_1625);
CREATE (para_1626:Paragraph {id: '2', content: 'Aşağıdaki kriterlerden en az birisine haiz olduğu sağlık kurulu raporu ile belgelenen kişilerde Kurumca bedeli karşılanır:'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 1}]->(para_1626);
CREATE (item_1627:Item {id: 'a', content: 'Alıcı ve/veya ifade edici dil yaşı ile kronolojik yaş arasında 4 (dört) yıldan daha az fark olması veya alıcı ve/veya ifade edici dili 4 (dört) yaş ve üstü olması (4-18 yaş, kronolojik yaşa bakılmaksızın),'});
CREATE (para_1626)-[:HAS_ITEM {order: 0}]->(item_1627);
CREATE (item_1628:Item {id: 'b', content: 'Post-lingual işitme kaybı olması.'});
CREATE (para_1626)-[:HAS_ITEM {order: 1}]->(item_1628);
CREATE (item_1627)-[:NEXT_ITEM]->(item_1628);
CREATE (para_1625)-[:NEXT_PARAGRAPH]->(para_1626);
CREATE (para_1629:Paragraph {id: '3', content: 'Sağlık kurulu raporu, aynı sağlık hizmeti sunucusunda çalışan 3 (üç) kulak burun boğaz hastalıkları uzman hekimi tarafından düzenlenir. Rapor ekinde aynı sağlık hizmeti sunucusunda görevli 1 (bir) odyolog tarafından yapılan odyolojik 64 değerlendirme sonuç belgesi ve 1 (bir) psikolog veya 1 (bir) dil konuşma terapisti tarafından yapılan değerlendirme sonuç belgesi bulunmalıdır.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 2}]->(para_1629);
CREATE (para_1626)-[:NEXT_PARAGRAPH]->(para_1629);
CREATE (para_1630:Paragraph {id: '4', content: 'Elektrod yerleşimini sağlayacak kadar iç kulak gelişiminin olduğu ve koklear sinirin varlığı yüksek çözünürlükte bilgisayarlı tomografi ve/veya manyetik rezonans görüntüleme raporu ile gösterilmelidir.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 3}]->(para_1630);
CREATE (para_1629)-[:NEXT_PARAGRAPH]->(para_1630);
CREATE (para_1631:Paragraph {id: '5', content: 'Menenjit sonrası oluşan işitme kayıplarında, koklear implantasyon kriterlerine uygun olması şartıyla, 3 (üç) aylık süre ile binaural işitme cihazı kullanımından fayda görmeme kuralı aranmaksızın, sağlık kurulu raporu ile belgelendirilmesi halinde Kurumca bedeli karşılanır.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 4}]->(para_1631);
CREATE (para_1630)-[:NEXT_PARAGRAPH]->(para_1631);
CREATE (para_1632:Paragraph {id: '6', content: 'İşitsel nöropati tanısı alan olgularda; en az 6 (altı) ay süreyle işitme rehabilitasyonu ve eğitiminden fayda görmediğinin odyolojik değerlendirme ve sağlık kurulu raporu ile belgelendirilmesi halinde Kurumca bedeli karşılanır.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 5}]->(para_1632);
CREATE (para_1631)-[:NEXT_PARAGRAPH]->(para_1632);
CREATE (para_1633:Paragraph {id: '7', content: 'Eş zamanlı veya ardışık bilateral koklear implant uygulaması kriterleri sağlık kurulu raporunda belirtilmesi kaydıyla aşağıdaki gibidir.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 6}]->(para_1633);
CREATE (item_1634:Item {id: 'a', content: 'Koklear implantasyon kriterlerini karşılayan 12-48 ay arası çocuklar,'});
CREATE (para_1633)-[:HAS_ITEM {order: 0}]->(item_1634);
CREATE (item_1635:Item {id: 'b', content: 'Yaş sınırı aranmaksızın post-lingual dönemde gelişen menenjit sonrası odyolojik kriterlere haiz ileri derecede sensörinöral işitme kayıpları,'});
CREATE (para_1633)-[:HAS_ITEM {order: 1}]->(item_1635);
CREATE (item_1634)-[:NEXT_ITEM]->(item_1635);
CREATE (item_1636:Item {id: 'c', content: '48 (kırk sekiz) ayın üzerindeki hastalarda (48 aylık olanlar hariç) ileri derecede sensörinöral işitme kaybına eşlik eden bilateral körlük.'});
CREATE (para_1633)-[:HAS_ITEM {order: 2}]->(item_1636);
CREATE (item_1635)-[:NEXT_ITEM]->(item_1636);
CREATE (para_1632)-[:NEXT_PARAGRAPH]->(para_1633);
CREATE (para_1637:Paragraph {id: '8', content: 'Koklear implant uygulaması sonrası gelişen enfeksiyon, kolesteatom, tümör nedeniyle koklear implantın iç parçasının işlevselliğini yitirmesi durumunda, süre aranmaksızın bu durumun sağlık kurulu raporu ile belgelendirilmesi halinde sadece cerrahi olarak yerleştirilen iç parçanın bedeli Kurumca karşılanır.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 7}]->(para_1637);
CREATE (para_1633)-[:NEXT_PARAGRAPH]->(para_1637);
CREATE (para_1638:Paragraph {id: '9', content: 'Koklear implantın, 12 (on iki) ayın altındaki hastalara uygulanması halinde Kurumca bedeli karşılanmaz.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 8}]->(para_1638);
CREATE (para_1637)-[:NEXT_PARAGRAPH]->(para_1638);
CREATE (para_1639:Paragraph {id: '10', content: 'Odyolojik değerlendirme; odyometrik inceleme, timpanometri, stapes refleks eşiği testi, klinik otoakustik emisyon testi, ABR testleri ile yapılır. Koklear implantın uygulanmasında aşağıdaki odyolojik kriterler dikkate alınır.'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 9}]->(para_1639);
CREATE (item_1640:Item {id: 'a', content: '2 (iki) yaş üstü çocuklarda ve erişkinlerde bilateral 500, 1000, 2000 ve 4000 Hz’lerdeki işitme eşikleri ortalamasının 80 dB’den daha kötü olması veya bir kulakta 70 dB ve daha kötü, karşı kulakta 90 dB ve daha kötü, konuşmayı ayırt etme testi yapılabilen hastalarda konuşmayı ayırt etme skorunun %30’un altında olması gereklidir.'});
CREATE (para_1639)-[:HAS_ITEM {order: 0}]->(item_1640);
CREATE (item_1641:Item {id: 'b', content: '2 (iki) yaş ve altı çocuklarda, bilateral 90 dB HL’den daha fazla sensörinöral işitme kaybının olması gereklidir.'});
CREATE (para_1639)-[:HAS_ITEM {order: 1}]->(item_1641);
CREATE (item_1640)-[:NEXT_ITEM]->(item_1641);
CREATE (para_1638)-[:NEXT_PARAGRAPH]->(para_1639);
CREATE (para_1642:Paragraph {id: '11', content: 'Koklear implant asgari çanta içeriği; konuşma işlemcisi, transmitter, 12 (on iki) adet 675 p düğme pil, şarj edilebilir pil ünitesi, 3 adet şarj edilebilir pil ve şarj cihazı (şarj edilebilir pilleri standart üretiminde olmayanlar için 150 adet 675 p düğme pil ya da şarj edilebilir özel veya AAA pil (4 adet)), ara kablo, yedek ara kablo (3 adet), yedek mıknatıs, konuşma işlemcisi test cihazı, nem alma ve kurutma kiti, temizleme apereyi, dış parça taşıma çantası veya kutusu, günlük kullanım çantası, Türkçe kullanım kılavuzu, pil tutucu veya yuvası (2 adet) ile yedek pil yuvası kapağı (işlemci içinde olanlarda aranmaz), yedek kulak kancası (cihazda kullanımı gerekmiyorsa istenmez), yedek kulak kancası pini (cihazda kullanımı gerekmiyorsa istenmez), pin çıkarma aleti (pini olmayan cihazlarda istenmez), tornavida (cihazda kullanımı gerekmiyorsa istenmez), uzaktan kumanda (cihazın kullanımı için gerekli değil ise istenmez).'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 10}]->(para_1642);
CREATE (para_1639)-[:NEXT_PARAGRAPH]->(para_1642);
CREATE (para_1643:Paragraph {id: '12', content: 'Elektroakustik implant uygulaması:'});
CREATE (sec_1624)-[:HAS_PARAGRAPH {order: 11}]->(para_1643);
CREATE (item_1644:Item {id: 'a', content: '500 ve 1000 Hz frekanslarda işitme eşiklerinin 50 dB ve daha iyi, 2000, 3000, 4000 Hz frekanslarında 80 dB ve daha kötü olması ve konuşmayı ayırt etme skorunun %50’den kötü olması durumunda uygulanır.'});
CREATE (para_1643)-[:HAS_ITEM {order: 0}]->(item_1644);
CREATE (item_1645:Item {id: 'b', content: 'Elektroakustik implant uygulamasının Kurumca bedelinin ödenmesi için son 1 (bir) yıl işitme eşiklerinin stabil olduğu belirtilmelidir.'});
CREATE (para_1643)-[:HAS_ITEM {order: 1}]->(item_1645);
CREATE (item_1644)-[:NEXT_ITEM]->(item_1645);
CREATE (para_1642)-[:NEXT_PARAGRAPH]->(para_1643);
CREATE (sec_1622)-[:NEXT_SUBSECTION]->(sec_1624);
CREATE (sec_1646:Subsection {id: '3.3.33.C', title: 'Kemiğe monte işitme cihazı ve aksesuarları'});
CREATE (sec_1621)-[:HAS_SUBSECTION {order: 2}]->(sec_1646);
CREATE (para_1647:Paragraph {id: '1', content: '5 (beş) yaş ve üzerinde, bilateral işitme kaybı olan ve her 2 (iki) kulakta da konvansiyonel işitme cihazlarından fayda görmediği veya tıbbi gerekçesiyle kullanılamadığının belirtildiği aynı resmi sağlık hizmeti sunucusunda çalışan 3 (üç) kulak burun boğaz hastalıkları uzman hekiminin yer aldığı ve ekinde aynı resmi sağlık hizmeti sunucusunda görevli 1 (bir) odyolog tarafından yapılan odyolojik değerlendirme sonuç belgesi bulunan sağlık kurulu raporu ile aşağıdaki kriterlere uyan hastalarda veya Sağlık Bakanlığı İşitsel İmplantlar Bilimsel Danışma Komisyonu tarafından kemiğe monte işitme cihazı yerleştirilmesi uygun görülen kişilerde uygulanması halinde Kurumca bedeli karşılanır.'});
CREATE (sec_1646)-[:HAS_PARAGRAPH {order: 0}]->(para_1647);
CREATE (para_1648:Paragraph {id: '2', content: 'Kemik yolu işitme eşiği 500, 1000, 2000 ve 4000 Hz’ de 60 dB’i aşmayan, iletim veya mikst tip işitme kaybı olan ve konuşmayı ayırt etme skoru %60 ve üzerinde olan hastalarda aşağıdaki kriterlerden mevcut olanlarının saptandığının sağlık kurulu raporu ile belgelendirilmesi halinde ve aşağıda belirtilen kriterlerden en az birine uyması kaydıyla;'});
CREATE (sec_1646)-[:HAS_PARAGRAPH {order: 1}]->(para_1648);
CREATE (item_1649:Item {id: 'a', content: 'Bilateral aural atrezi olan,'});
CREATE (para_1648)-[:HAS_ITEM {order: 0}]->(item_1649);
CREATE (item_1650:Item {id: 'b', content: 'Tek taraflı aural atrezi varlığında diğer kulakta 18 yaş ve altı hastalarda 30 dB ve üzerinde, erişkin hastalarda 40 dB ve üzerinde kalıcı işitme kaybı olan,'});
CREATE (para_1648)-[:HAS_ITEM {order: 1}]->(item_1650);
CREATE (item_1649)-[:NEXT_ITEM]->(item_1650);
CREATE (item_1651:Item {id: 'c', content: 'Cerrahi ile düzeltilemeyen bilateral konjenital dış ve orta kulak anomalileri ve yaygın timpanoskleroz olgularında olan,'});
CREATE (para_1648)-[:HAS_ITEM {order: 2}]->(item_1651);
CREATE (item_1650)-[:NEXT_ITEM]->(item_1651);
CREATE (item_1652:Item {id: 'ç', content: 'Bilateral mastoidektomi kavitesi bulunan,'});
CREATE (para_1648)-[:HAS_ITEM {order: 3}]->(item_1652);
CREATE (item_1651)-[:NEXT_ITEM]->(item_1652);

// Batch 45
CREATE (item_1653:Item {id: 'd', content: 'Tedaviye dirençli kronik eksternal otit olan,'});
CREATE (para_1648)-[:HAS_ITEM {order: 4}]->(item_1653);
CREATE (item_1652)-[:NEXT_ITEM]->(item_1653);
CREATE (item_1654:Item {id: 'e', content: 'Bir kulakta total işitme kaybı olup diğer kulakta iletim tipi veya mikst tipi işitme kaybı olan, hastalarda uygulanması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1648)-[:HAS_ITEM {order: 5}]->(item_1654);
CREATE (item_1653)-[:NEXT_ITEM]->(item_1654);
CREATE (para_1647)-[:NEXT_PARAGRAPH]->(para_1648);
CREATE (para_1655:Paragraph {id: '3', content: '5 (beş) yaşından küçük hastalara uygulandığı takdirde bedeli Kurumca karşılanmaz. Ancak, 5 (beş) yaşından küçük hastalara ya da genel durumu cerrahi uygulamaya elverişli olmayan hastalara, kafa bandı ya da benzeri bir ataçmanla uygulanması halinde konuşma işlemcisinin bedeli Kurumca karşılanır.'});
CREATE (sec_1646)-[:HAS_PARAGRAPH {order: 2}]->(para_1655);
CREATE (para_1648)-[:NEXT_PARAGRAPH]->(para_1655);
CREATE (para_1656:Paragraph {id: '4', content: 'Kafa bandı uygulanan hastalarda, cerrahi operasyonun planlandığı tarihte iç parça ile dış parça arasında aktarıcı sistem ve bileşenleri ile cerrahi ile yerleştirilen iç parçanın bedeli Kurumca karşılanır.'});
CREATE (sec_1646)-[:HAS_PARAGRAPH {order: 3}]->(para_1656);
CREATE (para_1655)-[:NEXT_PARAGRAPH]->(para_1656);
CREATE (sec_1624)-[:NEXT_SUBSECTION]->(sec_1646);
CREATE (sec_1657:Subsection {id: '3.3.33.Ç', title: 'Orta kulak implantı'});
CREATE (sec_1621)-[:HAS_SUBSECTION {order: 3}]->(sec_1657);
CREATE (para_1658:Paragraph {id: '1', content: 'Bilateral işitme kaybı olan ve her iki kulakta da konvansiyonel işitme cihazlarından fayda görmediği aynı resmi sağlık hizmeti sunucusunda çalışan 3 (üç) kulak burun boğaz hastalıkları uzman hekiminin yer aldığı ve ekinde aynı resmi sağlık hizmeti sunucusunda görevli 1 (bir) odyolog tarafından yapılan odyolojik değerlendirme sonuç belgesi bulunan sağlık 65 kurulu raporu ile saptanan ve aşağıdaki kriterlere uyan hastalarda veya Sağlık Bakanlığı İşitsel İmplantlar Bilimsel Danışma Komisyonu tarafından orta kulak implantı yerleştirilmesi uygun görülen kişilerde uygulanması halinde Kurumca bedeli karşılanır. Kurumca bedelinin karşılanması için son 2 (iki) yıl işitme eşiklerinin stabil olduğu sağlık kurulu raporunda belirtilmelidir.'});
CREATE (sec_1657)-[:HAS_PARAGRAPH {order: 0}]->(para_1658);
CREATE (item_1659:Item {id: 'a', content: 'Sensörinöral işitme kayıpları: konuşmayı ayırt etme skorunun %50’den daha iyi olması durumunda uygulanır.'});
CREATE (para_1658)-[:HAS_ITEM {order: 0}]->(item_1659);
CREATE (subitem_1660:SubItem {id: '1', content: '500 Hz\'de 65 dB, 1000, 2000 Hz\'de 70 dB, 4000 Hz\'de 85 dB’i geçmeyen sensorinöral işitme kaybı olması ve'});
CREATE (item_1659)-[:HAS_SUBITEM {order: 0}]->(subitem_1660);
CREATE (subitem_1661:SubItem {id: '2', content: 'Retrokoklear patolojinin olmadığının sağlık kurulu raporunda belirtilmesi gereklidir.'});
CREATE (item_1659)-[:HAS_SUBITEM {order: 1}]->(subitem_1661);
CREATE (subitem_1660)-[:NEXT_SUBITEM]->(subitem_1661);
CREATE (item_1662:Item {id: 'b', content: 'İletim ve mikst tip işitme kayıpları: skorunun %50’den daha iyi olması durumunda uygulanır. kurulu raporunda belirtilmelidir.'});
CREATE (para_1658)-[:HAS_ITEM {order: 1}]->(item_1662);
CREATE (subitem_1663:SubItem {id: '1', content: 'Kemik yolu işitme eşikleri 60 dB’den kötü olmayan mikst veya iletim tipi işitme kaybı ve konuşmayı ayırt etme'});
CREATE (item_1662)-[:HAS_SUBITEM {order: 0}]->(subitem_1663);
CREATE (subitem_1664:SubItem {id: '2', content: 'Her iki kulağı da daha önce en az bir kez opere edilmiş hastanın işitme kaybının düzeltilememiş olduğu sağlık'});
CREATE (item_1662)-[:HAS_SUBITEM {order: 1}]->(subitem_1664);
CREATE (subitem_1663)-[:NEXT_SUBITEM]->(subitem_1664);
CREATE (item_1659)-[:NEXT_ITEM]->(item_1662);
CREATE (item_1665:Item {id: 'c', content: 'Bilateral işitme kaybı olup, konvansiyonel işitme cihazı ile düzeltilebilme şartı aranmadan orta kulak implantı yapılabilecek özellikli durumlar;'});
CREATE (para_1658)-[:HAS_ITEM {order: 2}]->(item_1665);
CREATE (subitem_1666:SubItem {id: '1', content: 'Geçirilmiş kulak cerrahisi sonucu bilateral radikal mastoidektomi kavitesi olan hastalarda,'});
CREATE (item_1665)-[:HAS_SUBITEM {order: 0}]->(subitem_1666);
CREATE (subitem_1667:SubItem {id: '2', content: 'Bilateral konjenital dış ve orta kulak anomalisi olan hastalarda,'});
CREATE (item_1665)-[:HAS_SUBITEM {order: 1}]->(subitem_1667);
CREATE (subitem_1666)-[:NEXT_SUBITEM]->(subitem_1667);
CREATE (subitem_1668:SubItem {id: '3', content: 'İşitme cihazı endikasyonu olup steteskop kullanması gereken sağlık çalışanlarında.'});
CREATE (item_1665)-[:HAS_SUBITEM {order: 2}]->(subitem_1668);
CREATE (subitem_1667)-[:NEXT_SUBITEM]->(subitem_1668);
CREATE (item_1662)-[:NEXT_ITEM]->(item_1665);
CREATE (sec_1646)-[:NEXT_SUBSECTION]->(sec_1657);
CREATE (sec_1669:Subsection {id: '3.3.33.D', title: 'Beyin sapı implantı'});
CREATE (sec_1621)-[:HAS_SUBSECTION {order: 4}]->(sec_1669);
CREATE (para_1670:Paragraph {id: '1', content: 'Rapor ekinde aynı resmi sağlık hizmeti sunucusunda çalışan 1 (bir) odyolog ve 1 (bir) psikolog veya 1 (bir) dil konuşma terapisti değerlendirme sonucu bulunan aynı resmi sağlık hizmeti sunucusunda çalışan 3 (üç) kulak burun boğaz hastalıkları uzman hekimi tarafından düzenlenen sağlık kurulu raporu ile tek taraflı uygulanması halinde Kurumca bedeli karşılanır.'});
CREATE (sec_1669)-[:HAS_PARAGRAPH {order: 0}]->(para_1670);
CREATE (para_1671:Paragraph {id: '2', content: 'Bilateral çok ileri derecede sensörinöral işitme kaybı olan hastalarda Kurumca bedeli karşılanır.'});
CREATE (sec_1669)-[:HAS_PARAGRAPH {order: 1}]->(para_1671);
CREATE (para_1670)-[:NEXT_PARAGRAPH]->(para_1671);
CREATE (para_1672:Paragraph {id: '3', content: 'Aşağıdaki kriterlerden en az birinin varlığında,'});
CREATE (sec_1669)-[:HAS_PARAGRAPH {order: 2}]->(para_1672);
CREATE (item_1673:Item {id: 'a', content: 'CT ve/veya MRI incelemeleri sonucu; koklea ve/veya akustik sinirin olmadığı veya tam gelişmediği veya hasar gördüğü tespit edilen hastalarda,'});
CREATE (para_1672)-[:HAS_ITEM {order: 0}]->(item_1673);
CREATE (item_1674:Item {id: 'b', content: 'Bilateral akustik tümörü olan nörofibramatozis Tip 2 olgularında tek taraflı tümör eksizyonu ile aynı seansta aynı tarafa beyin sapı implantı uygulanması halinde, Kurumca bedeli karşılanır.'});
CREATE (para_1672)-[:HAS_ITEM {order: 1}]->(item_1674);
CREATE (item_1673)-[:NEXT_ITEM]->(item_1674);
CREATE (para_1671)-[:NEXT_PARAGRAPH]->(para_1672);
CREATE (para_1675:Paragraph {id: '4', content: 'Beyin sapı implantının, 12 (oniki) ayın altındaki hastalara uygulanması halinde bedeli Kurumca karşılanmaz.'});
CREATE (sec_1669)-[:HAS_PARAGRAPH {order: 3}]->(para_1675);
CREATE (para_1672)-[:NEXT_PARAGRAPH]->(para_1675);
CREATE (para_1676:Paragraph {id: '5', content: 'Yukarıdaki kriterleri taşımayan hastalar için Sağlık Bakanlığı İşitsel İmplantlar Bilimsel Danışma Komisyonu tarafından beyin sapı implantı yerleştirilmesi uygun görülen kişilerde Kurumca bedeli karşılanır.'});
CREATE (sec_1669)-[:HAS_PARAGRAPH {order: 4}]->(para_1676);
CREATE (para_1675)-[:NEXT_PARAGRAPH]->(para_1676);
CREATE (sec_1657)-[:NEXT_SUBSECTION]->(sec_1669);
CREATE (sec_1601)-[:NEXT_SUBSECTION]->(sec_1621);
CREATE (sec_1677:Subsection {id: '3.3.34', title: 'Hasta alt bezi/külotlu hasta alt bezi'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 33}]->(sec_1677);
CREATE (para_1678:Paragraph {id: '1', content: 'Hasta alt bezi/külotlu hasta alt bezi kullanması gerekli görülen hastalar için (çocuklar için en az 2 (iki) yaşını tamamlamış olmak kaydı ile) ikinci veya üçüncü basamak resmi sağlık hizmeti (Değişik:RG-16/03/2023-32134/17-y md. Yürürlük:24/03/2023) sunucularınca düzenlenecek (en fazla 2 (iki) yıl süreli) uzman hekim raporunda;'});
CREATE (sec_1677)-[:HAS_PARAGRAPH {order: 0}]->(para_1678);
CREATE (item_1679:Item {id: 'a', content: 'Mesane veya rektum kontrolü olmadığının veya,'});
CREATE (para_1678)-[:HAS_ITEM {order: 0}]->(item_1679);
CREATE (item_1680:Item {id: 'b', content: 'Kolostomi/ileostomili hastalarda idrar inkontinansı olduğunun veya,'});
CREATE (para_1678)-[:HAS_ITEM {order: 1}]->(item_1680);
CREATE (item_1679)-[:NEXT_ITEM]->(item_1680);
CREATE (item_1681:Item {id: 'c', content: 'Ürostomili hastalarda gaita inkontinansı olduğunun, ve idrar/gaita inkontinansına neden olan primer tanının belirtilmesi kaydı ile günde 4 (dört) adedi geçmemek üzere sağlık raporunda öngörülen günlük kullanım adeti doğrultusunda 18 (on sekiz) yaş üstü hastalar için A10049 SUT kodlu “Hasta Alt Bezi/Külotlu Hasta Alt Bezi”, 3-18 yaş hastalar için A10118 SUT kodlu “Çocuk Hasta Alt Bezi/Çocuk Külotlu Hasta Alt Bezi” tıbbi malzeme fiyatı dikkate alınarak 1 (bir) aylık tutar  nakden ödenir.'});
CREATE (para_1678)-[:HAS_ITEM {order: 2}]->(item_1681);
CREATE (item_1680)-[:NEXT_ITEM]->(item_1681);
CREATE (para_1682:Paragraph {id: '2', content: '3-18 yaş hastaların boy, kilo ve/veya bel çevresi ölçülerinin çocuk hasta alt bezi/külotlu hasta alt bezine uyum sağlamadığının sağlık raporunda belirtilmesi kaydıyla 18 (on sekiz) yaş üstü hastalar için ödenen tutar üzerinden ödeme yapılır.'});
CREATE (sec_1677)-[:HAS_PARAGRAPH {order: 1}]->(para_1682);
CREATE (para_1678)-[:NEXT_PARAGRAPH]->(para_1682);
CREATE (para_1683:Paragraph {id: '3', content: 'İdrar inkontinansı ve gaita inkontinansı nedeniyle erişkin/çocuk hasta alt bezi/külotlu hasta alt bezi ödemesi alan hastalarda; SUT hükümleri doğrultusunda düzenlenen sağlık raporu ve reçeteye istinaden hidrofilik kendinden kayganlaştırıcılı sonda bedeli Kurumca karşılanır.'});
CREATE (sec_1677)-[:HAS_PARAGRAPH {order: 2}]->(para_1683);
CREATE (para_1682)-[:NEXT_PARAGRAPH]->(para_1683);
CREATE (para_1684:Paragraph {id: '4', content: 'Sadece idrar inkontinansı nedeniyle erişkin/çocuk hasta alt bezi/külotlu hasta alt bezi ödemesi alan hastalarda; hidrofilik kendinden kayganlaştırıcılı sonda bedeli Kurumca karşılanmaz.'});
CREATE (sec_1677)-[:HAS_PARAGRAPH {order: 3}]->(para_1684);
CREATE (para_1683)-[:NEXT_PARAGRAPH]->(para_1684);
CREATE (para_1685:Paragraph {id: '5', content: 'Bu madde kapsamında yapılacak ödemeye ilişkin izlenecek yöntem Kurum tarafından ayrıca duyurulur. DÖRDÜNCÜ BÖLÜM İlaç'});
CREATE (sec_1677)-[:HAS_PARAGRAPH {order: 4}]->(para_1685);
CREATE (para_1684)-[:NEXT_PARAGRAPH]->(para_1685);
CREATE (amend_1686:Amendment {content: '(Ek:RG-02/09/2024-32650/1 md. Yürürlük: 26/8/2024)'});
CREATE (sec_1677)-[:HAS_AMENDMENT {order: 0}]->(amend_1686);
CREATE (sec_1621)-[:NEXT_SUBSECTION]->(sec_1677);
CREATE (sec_1204)-[:NEXT_SECTION]->(sec_1221);
CREATE (sec_1687:Section {id: '4.1', title: 'Reçete ve sağlık raporu yazım ilkeleri'});
CREATE (doc_1)-[:HAS_SECTION {order: 20}]->(sec_1687);
CREATE (para_1688:Paragraph {id: '1', content: 'İlaç bedellerinin Kurum tarafından ödenebilmesi için, reçete yazımında ve rapor düzenlenmesinde aşağıda belirtilen hususlar uygulanacaktır. (Ek: RG- 25/08/2022- 31934/ 19-a md. Yürürlük: 03/09/2022)'});
CREATE (sec_1687)-[:HAS_PARAGRAPH {order: 0}]->(para_1688);

// Batch 46
CREATE (para_1689:Paragraph {id: '2', content: 'Tebliğde yer alan herhangi bir etkin maddenin kullanım koşulunda; başka bir etkin madde/maddelerin kullanılmış olması şartı belirtilen ilaçların, ilgili SUT hükmü kapsamında kullanıldığına yönelik MEDULA kaydının yer alması gerekmektedir. Bu ilaç/ilaçların kullanımının MEDULA sisteminde yer almaması halinde Kurumca bedeli karşılanmaz (Bu fıkranın yürürlük tarihi öncesi tedavisi başlamış ve belirtilen kapsamdaki ilacı kullanmış veya kullanmakta olan hastalar açısından bu koşul aranmaz). Sevkli olarak yurtdışı tedavi ve/veya ikili güvenlik sözleşmesi gibi istisnai durumlarda Genel 66 Sağlık Sigortası Genel Müdürlüğü onayı alınması halinde bu ilaçların kullanımı mümkün bulunmakta olup onay için yapılacak başvuruda ilacın temini ve kullanımına yönelik belge ibrazı şarttır.'});
CREATE (sec_1687)-[:HAS_PARAGRAPH {order: 1}]->(para_1689);
CREATE (para_1688)-[:NEXT_PARAGRAPH]->(para_1689);
CREATE (sec_1690:Subsection {id: '4.1.1', title: 'Ayakta tedavilerde reçetelerin düzenlenmesi', content: '(Değişik: RG- 04/09/2019- 30878/ 11-a md. Yürürlük: 12/09/2019)'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 0}]->(sec_1690);
CREATE (para_1691:Paragraph {id: '1', content: 'İlaçların reçetelendirilmesinde e-reçete veya SUT’ un 4.1.5 numaralı maddesinin dördüncü fıkrası kapsamına giren hallerde kırmızı, mor, turuncu ve yeşil reçeteler kullanılır. (Bu konuda Kurumca yayımlanan mevzuat hükümleri saklıdır.)'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 0}]->(para_1691);
CREATE (para_1692:Paragraph {id: '2', content: 'Reçetelerde teşhis bilgilerinin yer alması zorunludur. SUT eki “Teşhis Kısaltmaları Listesi” nde (EK-4/Ç) yer alan kısaltmalar hariç teşhislerde kısaltma yapılmayacaktır. Reçetede yazılı ilacın/ilaçların yan etkilerini önlemek ve/veya tedaviyi desteklemek amacıyla reçete edilen ilaçlar için ayrıca teşhis aranmayacaktır.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 1}]->(para_1692);
CREATE (para_1691)-[:NEXT_PARAGRAPH]->(para_1692);
CREATE (para_1693:Paragraph {id: '3', content: '. Reçetelerde hekimin adı soyadı, uzmanlık dalı veya yan uzmanlık dalı, asistanlar için ihtisas yaptığı uzmanlık dalı veya yan uzmanlık dalı, diploma numarası veya diploma tescil numarası bilgileri, ıslak imzası ile reçetenin düzenlendiği sağlık kurum veya kuruluşunun adı mutlaka yer alacaktır.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 2}]->(para_1693);
CREATE (para_1692)-[:NEXT_PARAGRAPH]->(para_1693);
CREATE (para_1694:Paragraph {id: '4', content: 'Reçetelerde hastanın adı soyadı, T.C. Kimlik Numarası veya reçete tanzim tarihi ile birlikte MEDULA takip numarası veya e-reçete numarası veya protokol numarası yer alacaktır.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 3}]->(para_1694);
CREATE (para_1693)-[:NEXT_PARAGRAPH]->(para_1694);
CREATE (para_1695:Paragraph {id: '5', content: 'Yabancı ülkelerle yapılan “Sosyal Güvenlik Sözleşmeleri” kapsamında Kurum tarafından sağlık hizmeti verilen kişiler için düzenlenecek reçetelere, sağlık yardım hakkını veren ülkenin adı ayrıca yazılacaktır.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 4}]->(para_1695);
CREATE (para_1694)-[:NEXT_PARAGRAPH]->(para_1695);
CREATE (para_1696:Paragraph {id: '6', content: 'Üniversite hastaneleri ile eğitim ve araştırma hastanelerinde ihtisas yapan asistanlar ile üst ihtisas yapmakta olan uzman hekimler, yalnızca ihtisas yapmakta oldukları branşın uzman hekiminin reçete etmesi gereken ilaçlar ile SUT ve eki listelerde uzman hekimlerce yazılabileceği belirtilen ilaçları reçete edebilirler.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 5}]->(para_1696);
CREATE (para_1695)-[:NEXT_PARAGRAPH]->(para_1696);
CREATE (para_1697:Paragraph {id: '7', content: 'SUT’ta belirli bir uzman hekim tarafından reçete edileceği/rapor düzenleneceği belirtilmiş ilaçlar, aynı uzmanlık eğitimi üzerine yan dal uzmanlığı yapmış olan hekimlerce de reçete edilebilir/rapor düzenlenebilir.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 6}]->(para_1697);
CREATE (para_1696)-[:NEXT_PARAGRAPH]->(para_1697);
CREATE (para_1698:Paragraph {id: '8', content: 'Sağlık Bakanlığınca aile hekimliği sözleşmesi yapılan veya yetkilendirilen hekimler, aile hekimliği uzman hekiminin yazabildiği tüm ilaçları reçete edebilirler.  SUT’un 4.2.13.1, 4.2.13.2, 4.2.15.B, 4.2.15.C, 4.2.15.Ç, 4.2.15.D-1, 4.2.15.D-2, 4.2.15.E, 4.2.15.F, 4.2.20 ve 4.2.38 maddelerinde yer alan ve sağlık raporuna istinaden iç hastalıkları veya çocuk hastalıkları uzman hekimlerince reçete edilebilen ilaçların, SUT’ta yer alan genel ve özel hükümler saklı kalmak kaydıyla sağlık raporuna istinaden Sağlık Bakanlığınca aile hekimliği sözleşmesi yapılan veya yetkilendirilen hekimlerce de reçete edilmesi halinde bedelleri Kurumca ödenir.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 7}]->(para_1698);
CREATE (para_1697)-[:NEXT_PARAGRAPH]->(para_1698);
CREATE (para_1699:Paragraph {id: '9', content: 'SUT’ta geçen uzmanlık dalları; aksine bir hüküm bulunmadıkça hem erişkin hem de çocuk yan dallarını ifade eder.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 8}]->(para_1699);
CREATE (para_1698)-[:NEXT_PARAGRAPH]->(para_1699);
CREATE (para_1700:Paragraph {id: '10', content: 'Sağlık raporuna istinaden reçete edilecek ilaçlar, SUT ve eki listelerde aksine bir hüküm olmadıkça, bu sağlık raporuna dayanılarak tüm hekimler tarafından reçete edilebilir.'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 9}]->(para_1700);
CREATE (para_1699)-[:NEXT_PARAGRAPH]->(para_1700);
CREATE (para_1701:Paragraph {id: '11', content: 'Diş hekimleri yalnızca doğrudan ağız ve diş sağlığı ile ilgili ilaçları reçete edebilir. (Mülga: RG- 04/09/2019- 30878/ 11-b md. Yürürlük: 12/09/2019)'});
CREATE (sec_1690)-[:HAS_PARAGRAPH {order: 10}]->(para_1701);
CREATE (para_1700)-[:NEXT_PARAGRAPH]->(para_1701);
CREATE (amend_1702:Amendment {content: '(Değişik: RG- 04/05/2013- 28637/ 9 md. Yürürlük: 11/05/2013)'});
CREATE (sec_1690)-[:HAS_AMENDMENT {order: 0}]->(amend_1702);
CREATE (amend_1703:Amendment {content: '(Ek: RG- 18/05/2024- 32550/ 1 md. Yürürlük: 29/05/2024)'});
CREATE (sec_1690)-[:HAS_AMENDMENT {order: 1}]->(amend_1703);
CREATE (amend_1704:Amendment {content: '(Ek: RG- 07/10/2016- 29850/ 12 md. Yürürlük: 15/10/2016)'});
CREATE (sec_1690)-[:HAS_AMENDMENT {order: 2}]->(amend_1704);
CREATE (sec_1705:Subsection {id: '4.1.2', title: 'Yatarak tedavilerde reçetelerin düzenlenmesi', content: '(Yürürlük: Sağlık Bakanlığına bağlı sağlık hizmet sunucuları için 1/7/2015 , diğer sağlık kurum ve kuruluşları için 01/12/2015 )'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 1}]->(sec_1705);
CREATE (para_1706:Paragraph {id: '1', content: 'Yatarak tedavilerde (yatan hasta ve günübirlik tedavi) kullanılacak ilaçların Kurumla sözleşmeli/protokollü sağlık kurum ve kuruluşları tarafından temini zorunludur. (Sağlık Bakanlığı tarafından hastanede kullanılmasına izin verilen yurtdışı ilaçların dışında kalan yurtdışı ilaçlar hariç)'});
CREATE (sec_1705)-[:HAS_PARAGRAPH {order: 0}]->(para_1706);
CREATE (para_1707:Paragraph {id: '2', content: 'Yatarak tedavilerde Kurumla sözleşmeli/protokollü sağlık kurum ve kuruluşları tarafından temin edilemeyen ilaçlar için düzenlenecek (Ek:RG-25/08/2022-31934/19-b md. Yürürlük:03/09/2022) manuel reçetelerde “(Mülga:RG- 04/09/2019-30878/12-a md. Yürürlük:12/09/2019) Yatan/ Günübirlik Hasta” ibaresi ve başhekimlik onayının bulunması zorunludur. Ancak yurtdışı ilaçlar için düzenlenecek reçetelerde söz konusu ibarenin ve başhekimlik onayının bulunması zorunlu değildir.'});
CREATE (sec_1705)-[:HAS_PARAGRAPH {order: 1}]->(para_1707);
CREATE (para_1706)-[:NEXT_PARAGRAPH]->(para_1707);
CREATE (para_1708:Paragraph {id: '3', content: 'Kurumla sözleşmeli/protokollü sağlık kurum ve kuruluşları tarafından temin edilemeyip sözleşmeli eczaneler tarafından karşılanan reçetelerde yer alan ilaç bedelleri, SUT hükümleri doğrultusunda 5 günlük dozu (ancak, sağlık kurum ve kuruluşlarında uzun süre yatarak tedavi gören tüberküloz hastalarına, kullanım dozu belgelenmek kaydıyla l aylık miktarda tüberküloz ilaçları , kür protokolü uygulanan ilaçlarda ise 1 küre yetecek miktarda kemoterapi ilaçları reçete edilebilir) (Yurtdışı İlaçlar ve ara ödemede olan ilaçlar hariç) aşmamak kaydıyla sözleşmeli eczaneye ödenir, ilgili sağlık kurum ve kuruluşlarının alacağından mahsup edilir ve mahsup edilen tutarlar iade edilmez.  Ancak Hastanelerce Temini Zorunlu Kemoterapi İlaçları Listesi (EK-4/H)’nde tanımlı ilaç/ilaçların yatarak tedavilerde, Kurumla protokollü üçüncü basamak resmi sağlık kurumu (Değişik: RG-03/03/2020- 31057 / 2 md. Yürürlük: 01/01/2019) ( “Sosyal Güvenlik Kurumu ile Sağlık Bakanlığı Arasında Götürü Bedel Üzerinden Sağlık Hizmeti Alım Sözleşmesi ve Usul Esasları” kapsamında bulunan sağlık hizmeti sunucuları hariç olmak üzere) tarafından temin edilemediğinin başhekimlik onayı ile belgelendirilmesi halinde mahsup edilen tutar, 15/6/2015 tarihli ve 2015/7752 sayılı Bakanlar Kurulu Kararı ile yürürlüğe konulan Beşeri Tıbbi Ürünlerin Fiyatlandırılmasına Dair Kararın ilgili maddesinde yer alan eczacı kârı düşülerek ilgili sağlık kurumuna iade edilir. Tedavinin devam ettiği durumlarda “doz” bitiminde yeniden reçete yazılması mümkündür.'});
CREATE (sec_1705)-[:HAS_PARAGRAPH {order: 2}]->(para_1708);
CREATE (para_1707)-[:NEXT_PARAGRAPH]->(para_1708);
CREATE (para_1709:Paragraph {id: '4', content: 'Taburcu olan hastalara reçetelendirilecek ilaçlar, ayakta tedavi kapsamında değerlendirilir. (Mülga: RG- 04/09/2019- 30878/ 12-b md. Yürürlük: 12/09/2019) 67'});
CREATE (sec_1705)-[:HAS_PARAGRAPH {order: 3}]->(para_1709);
CREATE (para_1708)-[:NEXT_PARAGRAPH]->(para_1709);
CREATE (amend_1710:Amendment {content: '(Değişik: RG- 05/08/2015- 29436/ 10 md. )'});
CREATE (sec_1705)-[:HAS_AMENDMENT {order: 0}]->(amend_1710);
CREATE (amend_1711:Amendment {content: '(Ek:RG-09/09/2017-30175/ 14 md. Yürürlük:23/09/2017)'});
CREATE (sec_1705)-[:HAS_AMENDMENT {order: 1}]->(amend_1711);
CREATE (amend_1712:Amendment {content: '(Ek: RG-18/01/2016-29597/9 md. Yürürlük:01/12/2015)'});
CREATE (sec_1705)-[:HAS_AMENDMENT {order: 2}]->(amend_1712);
CREATE (sec_1690)-[:NEXT_SUBSECTION]->(sec_1705);
CREATE (sec_1713:Subsection {id: '4.1.3', title: 'İlaç kullanımına esas sağlık raporlarının düzenlenmesi'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 2}]->(sec_1713);
CREATE (para_1714:Paragraph {id: '1', content: 'Sağlık raporu formatları ile bu raporların tasdik, mühür ve diğer uygulamalarında Sağlık Bakanlığı mevzuatı ve MEDULA sistemindeki düzenlemelere uyulacaktır.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 0}]->(para_1714);
CREATE (para_1715:Paragraph {id: '2', content: 'Sağlık raporlarının düzenlenmesinde, SUT’un 1.10 maddesi dikkate alınacaktır. Bu raporlar, SUT’ta yer alan istisnalar saklı kalmak kaydıyla SUT’un 1.10.1 maddesi doğrultusunda uzman hekim tarafından düzenlenecek olup, SUT’un 1.10.2 maddesine göre düzenlenen sağlık kurulu raporları da geçerli kabul edilecektir. (MEDULA hastane sistemini kullanan sağlık hizmeti sunucuları raporları elektronik ortamda düzenleyecek ve bu raporlar başhekimlik tarafından elektronik ortamda onaylanacaktır.)'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 1}]->(para_1715);
CREATE (para_1714)-[:NEXT_PARAGRAPH]->(para_1715);
CREATE (para_1716:Paragraph {id: '3', content: 'Sağlık raporlarında, SUT ve eki listelerde özel düzenleme yapılmış ilaçlar hariç olmak üzere, ilaç dozlarının belirtilmesi şart olmayıp, etken madde adının yazılması yeterli olacaktır. Sağlık raporuna etken madde adının yazılmasının yeterli olduğu ilaçlar için hastanın kullanacağı ilacın etken madde miktarı ve günlük kullanım dozu reçete ile düzenlenecektir. Ancak raporda ilacın etken madde miktarının ve günlük kullanım dozunun ayrıntılı olarak belirtilmiş olması halinde belirtilen doz miktarı aşılamaz.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 2}]->(para_1716);
CREATE (para_1715)-[:NEXT_PARAGRAPH]->(para_1716);
CREATE (para_1717:Paragraph {id: '4', content: 'Hasta katılım payı muafiyeti için düzenlenen sağlık raporlarında, teşhis ve ICD-10 kodu yer alacaktır. SUT eki EK-4/Ç Listesinde yer alan kısaltmalar hariç teşhislerde ve etken madde isminde kısaltma yapılmayacaktır.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 3}]->(para_1717);
CREATE (para_1716)-[:NEXT_PARAGRAPH]->(para_1717);
CREATE (para_1718:Paragraph {id: '5', content: 'Sağlık raporları, SUT’ta yer alan özel düzenlemeler hariç olmak üzere en fazla iki yıl süre ile geçerlidir.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 4}]->(para_1718);
CREATE (para_1717)-[:NEXT_PARAGRAPH]->(para_1718);
CREATE (para_1719:Paragraph {id: '6', content: '(Değişik: RG-25/08/2022-31934/19-c md. Yürürlük:03/09/2022) Yalnızca Kurumca iade edilmiş reçete/raporlar için geçerli olmak kaydıyla; hasta kimlik bilgileri veya ilaç adına ilişkin yazım hataları ile SUT hükümlerine göre eksikliği (ilacın kullanım dozu, teşhis, etken madde, kullanım süresi, ilgili hekim onayı veya tedavi şeması, ICD-10 kodu) bulunan sağlık raporları, aslına sadık kalmak kaydıyla; uzman hekim raporlarında raporun çıktığı hastanede raporu düzenleyen hekim tarafından (bu hekimin bulunmaması halinde aynı branştan hekim), sağlık kurulu raporlarında ise raporda yer alan hekimlerden biri tarafından gerekli düzeltmelerin yapılması, raporlar elektronik ortamda düzenlenmiş ise; bu düzeltmelerin başhekimlik tarafından elektronik ortamda onaylanması koşuluyla, düzeltmeye esas reçete tarihinden itibaren süresinin sonuna kadar geçerlidir. (Mülga: RG-25/08/2022- 31934/19-c md. Yürürlük:03/09/2022)'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 5}]->(para_1719);
CREATE (para_1718)-[:NEXT_PARAGRAPH]->(para_1719);
CREATE (para_1720:Paragraph {id: '7', content: 'Sağlık raporlarına dayanılarak reçete edilen ilaçlar için, hastalardan ve raporu düzenleyen sağlık kurum ve kuruluşlarından, SUT ve eki listelerde belirtilen özel durumlar haricinde ek bilgi ve belge talep edilmeyecektir.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 6}]->(para_1720);
CREATE (para_1719)-[:NEXT_PARAGRAPH]->(para_1720);
CREATE (para_1721:Paragraph {id: '8', content: 'Kullanımı sağlık raporuna bağlı veya katılım payından muaf ilaç/ilaçlar için düzenlenecek reçetelere ait rapor elektronik ortamda düzenlenmemiş ise aslı gibidir onayı yapılmış rapor fotokopisi, fatura ekinde Kuruma gönderilecektir. Aslı gibidir onayı raporu düzenleyen sağlık kurumu veya reçeteyi düzenleyen hekim veya reçeteyi karşılayan eczacı tarafından yapılacaktır. Raporlar elektronik ortamda düzenlenmiş ise rapor fotokopisi Kuruma gönderilmeyecektir.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 7}]->(para_1721);
CREATE (para_1720)-[:NEXT_PARAGRAPH]->(para_1721);
CREATE (para_1722:Paragraph {id: '9', content: 'Sağlık raporları, SUT değişikliği olması halinde yeni hükümlere uygun olması kaydıyla süresi sonuna kadar geçerlidir. Değişiklik sonrası SUT hükümlerine uygun olmayan raporlar, SUT’un 4.1.3(6) fıkrası kapsamında yeni hükümlere uygun hale getirilebildiği takdirde geçerli olacaktır. (Kurumca süresi sonuna kadar geçerli olacağı duyurulan raporlar hariç.)'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 8}]->(para_1722);
CREATE (para_1721)-[:NEXT_PARAGRAPH]->(para_1722);
CREATE (para_1723:Paragraph {id: '10', content: 'Elektronik rapor uygulamasında, SUT’ta geçen uzman hekim ve sağlık kurulu raporu ifadeleri “e-rapor”, ıslak imza ve başhekimlik mührü ifadeleri de “elektronik imza” veya elektronik imza çalışmaları tamamlanıncaya kadar “başhekimlik tarafından elektronik ortamda onaylama” olarak değerlendirilecektir.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 9}]->(para_1723);
CREATE (para_1722)-[:NEXT_PARAGRAPH]->(para_1723);
CREATE (para_1724:Paragraph {id: '11', content: 'SUT’un “İlaç” bölümü ve bu bölüm ile ilgili eklerde, bazı ilaçların kullanımı için düzenlenecek raporların ekinde ibrazı istenilen belgelerde aranan bilgiler, elektronik rapor uygulamasında rapor içinde belirtilecek olup ayrıca belge istenmeyecektir.'});
CREATE (sec_1713)-[:HAS_PARAGRAPH {order: 10}]->(para_1724);
CREATE (para_1723)-[:NEXT_PARAGRAPH]->(para_1724);
CREATE (sec_1705)-[:NEXT_SUBSECTION]->(sec_1713);
CREATE (sec_1725:Subsection {id: '4.1.4', title: 'Reçetelere yazılabilecek ilaç miktarı'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 3}]->(sec_1725);

// Batch 47
CREATE (para_1726:Paragraph {id: '1', content: '(Değişik: RG-25/08/2022-31934/19-ç md. Yürürlük:03/09/2022) Sağlık raporu olmaksızın ilaçların parenteral formları ile majistrallerin reçeteye yazılması durumunda en fazla 10 günlük tedavi bedeli ödenir. Reçetede mutlak surette günlük kullanım dozu belirtilir. Majistraller (Değişik: RG-21/03/2018-30367/ 15-a md. Yürürlük: 01/04/2018) sadece ilgili uzman hekimlerce reçete edilmesi halinde bedeli Kurumca karşılanır, tedavi süresi ve tedavi amaçlı olduğu hekim tarafından reçete üzerinde belirtilir.  Majistrallerin fiyatlandırmasında MEDULA sistemindeki tarife, fiyat ve miktarlar esas alınır, ödenecek bedel Kurumca belirlenecek tutarı geçemez.'});
CREATE (sec_1725)-[:HAS_PARAGRAPH {order: 0}]->(para_1726);
CREATE (para_1727:Paragraph {id: '2', content: 'Antiinflamatuar ve antiromatizmal grubu ilaçların solid-oral formlarında büyük ambalaj kapsamına giren ilaçlar, ayakta tedavide tek uzman hekim tarafından düzenlenen sağlık raporuna dayanılarak reçete edilir, en küçük ambalajlı formları ise rapor aranmaksızın reçete edilir.'});
CREATE (sec_1725)-[:HAS_PARAGRAPH {order: 1}]->(para_1727);
CREATE (para_1726)-[:NEXT_PARAGRAPH]->(para_1727);
CREATE (para_1728:Paragraph {id: '3', content: 'İlacın reçete edilmesindeki özel düzenlemeler saklı kalmak kaydıyla, SUT eki “Ayakta Tedavide Sağlık Raporu (Uzman Hekim Raporu/Sağlık Kurulu Raporu) ile Verilebilecek İlaçlar Listesi” (EK-4/F) ve Kurumun resmi internet sitesinde yayınlanan “Hasta Katılım Payından Muaf İlaçlar Listesi” nde (EK-4/D) yer almamakla birlikte, uzun süreli kullanımı sağlık raporu ile belgelendirilen ilaçlar, katılım payı alınmak koşuluyla en fazla üç aylık tedavi dozunda reçete edilebilir.'});
CREATE (sec_1725)-[:HAS_PARAGRAPH {order: 2}]->(para_1728);
CREATE (para_1727)-[:NEXT_PARAGRAPH]->(para_1728);
CREATE (para_1729:Paragraph {id: '4', content: 'Bir ilacın Ülkemizde onaylanmış endikasyonu ve Kısa Ürün Bilgisinde tanımlanan dozu dışındaki her türlü kullanımı, Sağlık Bakanlığınca verilen endikasyon dışı ilaç kullanım onayı ile mümkündür.'});
CREATE (sec_1725)-[:HAS_PARAGRAPH {order: 3}]->(para_1729);
CREATE (item_1730:Item {id: 'a', content: 'Bir ilacın ülkemizde onaylanmış endikasyonu dışındaki her türlü kullanımı için Sağlık Bakanlığı tarafından yayımlanan “Endikasyon Dışı İlaç Kullanımı Kılavuzu”nda belirtilen esaslara da uyulacak olup, kılavuzda tanımlanmamış durumlar için hasta bazında Sağlık Bakanlığı endikasyon dışı ilaç kullanımı onayı aranır.  Sağlık Bakanlığı Türkiye İlaç ve Tıbbi Cihaz Kurumu Ek Onay Alınmadan Kullanılabilecek Endikasyon Dışı İlaç Kullanımı Kılavuzunda yapılan düzenlemelerin Sağlık Uygulama Tebliği maddeleri ile çelişmesi durumunda Sağlık Uygulama Tebliği hükümleri geçerlidir. Endikasyon Dışı İlaç Kullanımı Kılavuzunda bulunan ilaçlar için reçeteler ve sağlık raporları, Kılavuzda yer aldığı uzmanlık dalında bulunan uzman hekim/hekimlerce düzenlenir.'});
CREATE (para_1729)-[:HAS_ITEM {order: 0}]->(item_1730);
CREATE (item_1731:Item {id: 'b', content: 'Kurum web sayfasında yayımlanan EK-4/D Listesinde yanında (*) yıldız işareti bulunmayan ilaçların, söz konusu listede ilişkilendirilen hastalıklarda kullanımı halinde Sağlık Bakanlığı endikasyon dışı ilaç kullanım onayı aranmaz. 68'});
CREATE (para_1729)-[:HAS_ITEM {order: 1}]->(item_1731);
CREATE (item_1730)-[:NEXT_ITEM]->(item_1731);
CREATE (item_1732:Item {id: 'c', content: 'Sağlık Bakanlığı tarafından verilen endikasyon dışı ilaç kullanım onaylarında, bu onay için süre belirtilmemiş ise rapor yenilenmesinde yeni onay aranmaz. (Ek: RG-25/08/2022-31934/19-ç md. Yürürlük:03/09/2022) Bu süre hiçbir şekilde 1 yılı geçemez.'});
CREATE (para_1729)-[:HAS_ITEM {order: 2}]->(item_1732);
CREATE (item_1731)-[:NEXT_ITEM]->(item_1732);
CREATE (item_1733:Item {id: 'ç', content: 'Endikasyon dışı ilaç kullanım onayı aranacak ilaçlar için reçeteler ve sağlık raporları (Değişik: RG- 25/08/2022- 31934/ 19-ç md. Yürürlük: 03/09/2022) izin talebinde bulunan ilgili uzmanlık branşında uzman hekim/hekimlerce düzenlenir.'});
CREATE (para_1729)-[:HAS_ITEM {order: 3}]->(item_1733);
CREATE (item_1732)-[:NEXT_ITEM]->(item_1733);
CREATE (item_1734:Item {id: 'd', content: 'Bir ilacın ülkemizde onaylanmış endikasyonunda tanımlı olmayıp, SUT’ta özel düzenleme olarak yer alan koşulu dışında kullanımı, Sağlık Bakanlığınca hasta bazında verilen endikasyon dışı ilaç kullanım onayı ile mümkündür. (Ek:RG- 25/08/2022-31934/19-ç md. Yürürlük:03/09/2022) Ancak, ilacın ödeme kapsamına alındığı tarihte ülkemizde onaylanmış endikasyonunda tanımlı olmasına rağmen SUT’ta koşulu olmayan endikasyonlarda kullanılması halinde bedeli Kurumca karşılanmaz. (Değişik: RG- 25/08/2022- 31934/ 19-ç md. Yürürlük: 03/09/2022)'});
CREATE (para_1729)-[:HAS_ITEM {order: 4}]->(item_1734);
CREATE (item_1733)-[:NEXT_ITEM]->(item_1734);
CREATE (item_1735:Item {id: 'e', content: 'EK-4/A Listesinde yer alan ve SUT ve eklerinde herhangi bir düzenlemesi olan ilaç/ilaç gruplarında bu düzenlemenin yürürlük tarihinden sonra Sağlık Bakanlığınca ilacın ülkemizdeki ruhsatlı endikasyonlarına yeni bir endikasyon eklendiğinde, yürürlükte olan Sosyal Güvenlik Kurumu “İlaç Geri Ödeme Yönetmeliği” ve “Alternatif Geri Ödeme Yönetmeliği” kapsamında yapılmış (Değişik:RG- 09/05/2024- 32541/2-a md. Yürürlük:17/05/2024) başvuru tarihinden itibaren başvuru değerlendirilip sonuçlandırılıncaya kadar ilacın Kısa Ürün Bilgisi (KÜB) endikasyonuna ilave edilen endikasyonda, Sağlık Bakanlığınca şahıs bazında endikasyon dışı kullanım onayı olması halinde bedeli Kurumca karşılanır.'});
CREATE (para_1729)-[:HAS_ITEM {order: 5}]->(item_1735);
CREATE (item_1734)-[:NEXT_ITEM]->(item_1735);
CREATE (item_1736:Item {id: 'f', content: 'Bir ilacın ülkemizde onaylanmış Kısa Ürün Bilgisinde tanımlı olup ilgili Komisyonlar tarafından geri ödeme kapsamına alınmayan endikasyonlarda kullanılması halinde ilacın bedeli Kurumca karşılanmaz.'});
CREATE (para_1729)-[:HAS_ITEM {order: 6}]->(item_1736);
CREATE (item_1735)-[:NEXT_ITEM]->(item_1736);
CREATE (item_1737:Item {id: 'g', content: 'Bu madde kapsamında Sağlık Bakanlığınca verilen endikasyon dışı ilaç kullanım onayına dayanılarak ödemesi yapılacak ilaçların rapor ve reçeteleme koşulları için Bakanlıkça verilmiş onay kabul edilir.'});
CREATE (para_1729)-[:HAS_ITEM {order: 7}]->(item_1737);
CREATE (item_1736)-[:NEXT_ITEM]->(item_1737);
CREATE (item_1738:Item {id: 'ğ', content: 'Bu maddenin yürürlük tarihi öncesinde düzenlenmiş endikasyon dışı ilaç kullanım onayları bu madde hükümleri kapsamında değerlendirilir. (Değişik: RG- 25/08/2022- 31934/ 19-ç md. Yürürlük: 03/09/2022)'});
CREATE (para_1729)-[:HAS_ITEM {order: 8}]->(item_1738);
CREATE (item_1737)-[:NEXT_ITEM]->(item_1738);
CREATE (para_1728)-[:NEXT_PARAGRAPH]->(para_1729);
CREATE (para_1739:Paragraph {id: '5', content: 'Hastanın tedavisinde;'});
CREATE (sec_1725)-[:HAS_PARAGRAPH {order: 4}]->(para_1739);
CREATE (item_1740:Item {id: 'a', content: 'İlk defa reçete edilecek ilaçlar raporlu olsa dahi kullanım dozuna göre, bir ayı geçmeyecek sürelerde ödenir. (Ek:RG- 09/05/2024- 32541/2-b md. Yürürlük: 17/05/2024) Reçeteye yazılan ilacın miktarı, ambalaj boyutu dikkate alınarak toplamda 4 haftalık doza yetecek miktarda ise bu dozlar da bir aylık doz olarak kabul edilir. Sonraki reçetelerde yazılacak ilaç miktarı için SUT’ta yer alan genel veya özel düzenlemeler esas alınır. Bu ilaçların devam reçetelerindeki farklı farmasötik dozları da ilk tedavi olarak kabul edilir. b) Kür protokolü uygulanan ilaçlarda her kullanımda 1 küre yetecek miktarda ilacın bedeli ödenir.'});
CREATE (para_1739)-[:HAS_ITEM {order: 0}]->(item_1740);
CREATE (item_1741:Item {id: 'c', content: 'Aynı farmasötik form ve aynı etkin maddeye sahip topikal antifungallerden toplamda 6 aylık dozda kullanılabilecek sayıda kutu olacak şekilde ve bir reçetede en fazla 2 kutu yazılabilir. Belirtilen kutu sayısının üzerinde kullanım söz konusu olduğunda veya tedavinin 6 aydan uzun sürmesi gereken hallerde: dermatoloji uzman hekimleri veya branşı ile ilgili endikasyonda kadın hastalıkları ve doğum uzman hekimleri tarafından reçete düzenlenmesi, dermatoloji veya kadın hastalıkları ve doğum uzman hekimince düzenlenen 6 ay süreli uzman hekim raporuna istinaden ise tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1739)-[:HAS_ITEM {order: 1}]->(item_1741);
CREATE (item_1740)-[:NEXT_ITEM]->(item_1741);
CREATE (para_1729)-[:NEXT_PARAGRAPH]->(para_1739);
CREATE (amend_1742:Amendment {content: '(Ek: RG- 18/03/2014- 28945/ 19 md. Yürürlük: 18/03/2014)'});
CREATE (sec_1725)-[:HAS_AMENDMENT {order: 0}]->(amend_1742);
CREATE (amend_1743:Amendment {content: '(Değişik: RG- 04/05/2013- 28637/ 10 md. Yürürlük: 04/05/2013)'});
CREATE (sec_1725)-[:HAS_AMENDMENT {order: 1}]->(amend_1743);
CREATE (amend_1744:Amendment {content: '(Değişik: RG- 30/04/2016- 29699/ 9 md. Yürürlük: 30/04/2016)'});
CREATE (sec_1725)-[:HAS_AMENDMENT {order: 2}]->(amend_1744);
CREATE (amend_1745:Amendment {content: '(Ek:RG-16/03/2023-32134/18 md. \nYürürlük:24/03/2023)'});
CREATE (sec_1725)-[:HAS_AMENDMENT {order: 3}]->(amend_1745);
CREATE (amend_1746:Amendment {content: '(Değişik: RG- 04/05/2013- 28637/ 10 md. Yürürlük: 04/05/2013)'});
CREATE (sec_1725)-[:HAS_AMENDMENT {order: 4}]->(amend_1746);
CREATE (sec_1713)-[:NEXT_SUBSECTION]->(sec_1725);
CREATE (sec_1747:Subsection {id: '4.1.5', title: 'Elektronik reçete uygulaması'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 4}]->(sec_1747);
CREATE (para_1748:Paragraph {id: '1', content: 'E-reçete uygulamasında, e-reçetelerin Kurum tarafından belirlenen yöntem ve standartlarla (elektronik imza, şifre) imzalanması şarttır.'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 0}]->(para_1748);
CREATE (para_1749:Paragraph {id: '2', content: 'Sağlık kurum/kuruluşları tarafından düzenlenecek reçeteler SGK Hekim Şifresi ile düzenlenecektir. Kurumca belirlenecek istisnalar haricinde manuel reçetelerin bedelleri karşılanmayacaktır. Kurum tarafından gerekli düzenlemelerin yapılması sonrasında ise reçeteler Kurum tarafından belirlenecek tarihten itibaren elektronik imza ile imzalanacaktır. Eczaneler tarafından manuel giriş yapılan reçetelerin bedelleri karşılanmayacaktır.'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 1}]->(para_1749);
CREATE (para_1748)-[:NEXT_PARAGRAPH]->(para_1749);
CREATE (para_1750:Paragraph {id: '3', content: 'Kurum tarafından gerekli düzenlenmeler tamamlanıncaya kadar manuel olarak düzenlenmeye devam edilecek olan reçeteler;'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 2}]->(para_1750);
CREATE (item_1751:Item {id: 'a', content: 'Yabancı ülkelerle yapılan “Sosyal Güvenlik Sözleşmeleri” kapsamında Kurum tarafından sağlık hizmeti verilen kişiler için düzenlenen reçeteler,'});
CREATE (para_1750)-[:HAS_ITEM {order: 0}]->(item_1751);
CREATE (item_1752:Item {id: 'b', content: 'Majistral ilaç içeren reçeteler, alerji aşıları reçeteleri,'});
CREATE (para_1750)-[:HAS_ITEM {order: 1}]->(item_1752);
CREATE (item_1751)-[:NEXT_ITEM]->(item_1752);
CREATE (item_1753:Item {id: 'c', content: 'İthal ilaç grubuna giren kişiye özel yurt dışından getirtilen ilaçlar için düzenlenen reçeteler,'});
CREATE (para_1750)-[:HAS_ITEM {order: 2}]->(item_1753);
CREATE (item_1752)-[:NEXT_ITEM]->(item_1753);
CREATE (item_1754:Item {id: 'ç', content: 'SUT’un 1.7(2) fıkrasının b ve c bentlerinde tanımlanan ve MEDULA hastane sisteminden provizyon alınamamasına rağmen sağlık hizmeti sunulması durumunda düzenlenen reçeteler,'});
CREATE (para_1750)-[:HAS_ITEM {order: 3}]->(item_1754);
CREATE (item_1753)-[:NEXT_ITEM]->(item_1754);
CREATE (item_1755:Item {id: 'd', content: 'Acilde düzenlenen reçeteler,'});
CREATE (para_1750)-[:HAS_ITEM {order: 4}]->(item_1755);
CREATE (item_1754)-[:NEXT_ITEM]->(item_1755);
CREATE (item_1756:Item {id: 'e', content: 'Aile hekimleri tarafından “gezici sağlık hizmeti” kapsamında düzenlenen reçeteler (bu reçetelerin gezici sağlık hizmeti kapsamında düzenlendiğini belirtir ifadenin bulunması ve hekim tarafından onaylanması gerekmektedir.),'});
CREATE (para_1750)-[:HAS_ITEM {order: 5}]->(item_1756);
CREATE (item_1755)-[:NEXT_ITEM]->(item_1756);
CREATE (item_1757:Item {id: 'f', content: 'Evde sağlık hizmeti kapsamında düzenlenen reçeteler,'});
CREATE (para_1750)-[:HAS_ITEM {order: 6}]->(item_1757);
CREATE (item_1756)-[:NEXT_ITEM]->(item_1757);
CREATE (item_1758:Item {id: 'g', content: 'Resmi ve özel sağlık kuruluşlarından; kamu idareleri bünyesindeki kurum hekimliklerinde, işyeri hekimliklerinde, belediyelere ait polikliniklerde, huzur evlerinde, aile hekimlikleri dışındaki birinci basamak resmi sağlık hizmeti sunucularında, üniversitelerin mediko-sosyal birimlerinde, Türk Silahlı Kuvvetlerinin birinci  basamak sağlık hizmet sunucularında düzenlenen reçeteler (resmi ve özel sağlık kuruluşlarının MEDULA hastane sistemini kullanmaya başlamaları veya teknik alt yapılarını oluşturmaları halinde e-reçete uygulamasına geçmeleri zorunludur.).'});
CREATE (para_1750)-[:HAS_ITEM {order: 7}]->(item_1758);
CREATE (item_1757)-[:NEXT_ITEM]->(item_1758);
CREATE (item_1759:Item {id: 'ğ', content: 'Evde Bakım Hizmetleri Sunumu Hakkında Yönetmelik” kapsamında hizmet veren merkez veya birimlerce düzenlenen reçeteler. (Değişik: RG- 04/09/2019- 30878/ 13-a md. Yürürlük: 12/09/2019) 69'});
CREATE (para_1750)-[:HAS_ITEM {order: 8}]->(item_1759);
CREATE (item_1758)-[:NEXT_ITEM]->(item_1759);
CREATE (para_1749)-[:NEXT_PARAGRAPH]->(para_1750);
CREATE (para_1760:Paragraph {id: '4', content: 'Kırmızı, mor, turuncu ve yeşil reçetelerin elektronik reçete olarak düzenlenmesi halinde bedelleri Kurumca karşılanır. Kırmızı, mor, turuncu ve yeşil matbu reçetelerin bedelleri; Kurumun resmi internet sitesinde, MEDULA sisteminden kaynaklanan nedenlerle (belirtilen sürelerde) elektronik reçetelerin düzenlenemediği duyurusuna istinaden Kurumca karşılanır.'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 3}]->(para_1760);
CREATE (para_1750)-[:NEXT_PARAGRAPH]->(para_1760);
CREATE (para_1761:Paragraph {id: '5', content: 'MEDULA sisteminin ve/veya sağlık hizmet sunucusuna ait sistemin çalışmaması nedeniyle e-reçetenin düzenlenememesi halinde manuel olarak düzenlenen reçete üzerinde e-reçete olarak düzenlenememesine ilişkin “Sistemlerin çalışmaması nedeniyle e-reçete düzenlenememiştir” ibaresi kaşe ya da el yazısı şeklinde belirtilmeli ve bu ibare  başhekim tarafından onaylanmalıdır. (Yukarıda tanımlanmış olan istisnai hallerde düzenlenen manuel reçetelerde bu ibare aranmayacaktır.)'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 4}]->(para_1761);
CREATE (para_1760)-[:NEXT_PARAGRAPH]->(para_1761);
CREATE (para_1762:Paragraph {id: '6', content: 'SUT’un “İlaç” bölümünün ve bu bölüm ile ilgili SUT eklerinde, bazı ilaçların kullanımı için düzenlenecek reçetelerin ekinde ibrazı istenilen belgelerde aranan bilgiler, e-reçete uygulamasında e-reçete içinde belirtilecek olup ayrıca belge istenmeyecektir. (Değişik: RG- 25/08/2022- 31934/ 19-d md. Yürürlük: 03/09/2022)'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 5}]->(para_1762);

// Batch 48
CREATE (para_1761)-[:NEXT_PARAGRAPH]->(para_1762);
CREATE (para_1763:Paragraph {id: '7', content: 'Sürekli görevle yurt dışına gönderilenlerin yurt dışı görevine dair resmi belgenin tarih ve sayısının e-reçetede belirtilmesi zorunludur.'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 6}]->(para_1763);
CREATE (para_1762)-[:NEXT_PARAGRAPH]->(para_1763);
CREATE (para_1764:Paragraph {id: '8', content: 'Yatan hastalara düzenlenen e-reçetelerde “(Mülga: RG- 04/09/2019- 30878/ 13-b md. Yürürlük: 12/09/2019) Yatan Hasta” ibaresi aranmaksızın sadece elektronik ortamda başhekimlik tarafından onaylanması yeterli olacaktır. (Ek: RG- 25/08/2022- 31934/ 19-d md. Yürürlük: 03/09/2022)'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 7}]->(para_1764);
CREATE (para_1763)-[:NEXT_PARAGRAPH]->(para_1764);
CREATE (para_1765:Paragraph {id: '10', content: 'İş kazası, meslek hastalığı, adli vaka ve trafik kazası durumlarında reçeteler sadece e-reçete olarak düzenlenir. E-reçete haricinde manuel reçetelerin bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1747)-[:HAS_PARAGRAPH {order: 8}]->(para_1765);
CREATE (para_1764)-[:NEXT_PARAGRAPH]->(para_1765);
CREATE (amend_1766:Amendment {content: '(Mülga: RG-07/10/2016- 29850/ 13 md. \nYürürlük: 18/10/2016)'});
CREATE (sec_1747)-[:HAS_AMENDMENT {order: 0}]->(amend_1766);
CREATE (amend_1767:Amendment {content: '(Ek: RG- 25/08/2016- 29812/ 14 md. Yürürlük: 05/09/2016)'});
CREATE (sec_1747)-[:HAS_AMENDMENT {order: 1}]->(amend_1767);
CREATE (amend_1768:Amendment {content: '(Değişik: RG- \n07/10/2016- 29850/ 14 md. Yürürlük: 15/10/2016)'});
CREATE (sec_1747)-[:HAS_AMENDMENT {order: 2}]->(amend_1768);
CREATE (amend_1769:Amendment {content: '(Mülga: RG- 30/08/2014- 29104/ 9 md. Yürürlük: 06/09/2014)'});
CREATE (sec_1747)-[:HAS_AMENDMENT {order: 3}]->(amend_1769);
CREATE (sec_1725)-[:NEXT_SUBSECTION]->(sec_1747);
CREATE (sec_1770:Subsection {id: '4.1.6', title: 'Hasta katılım payından muaf ilaçlar (EK-4/D)'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 5}]->(sec_1770);
CREATE (para_1771:Paragraph {id: '1', content: 'EK-4/D Listesinde yer alan hastalıklarda kullanılacak ilaçlar, SUT ve eki listelerde yer alan özel hükümler saklı kalmak kaydıyla, sağlık raporuna dayanılarak en fazla 3 aylık tedavi dozunda reçete edilmesi halinde bedelleri ödenir.  SUT’ta yer alan genel ve özel hükümler ve süreler saklı kalmak kaydıyla; EK-4/D Listesinde yer alan ilaçların SUT hükümlerine göre rapor düzenleyebilen uzmanlık dallarındaki branş hekimlerince en fazla 1 yıllık kullanım dozunda reçete edilmesi ve bu reçeteye istinaden söz konusu ilaçların reçete süresi boyunca en fazla üçer aylık dozda sözleşmeli eczanelerden temin edilmesi halinde Kurumca bedelleri ödenir. Bu uygulamadan; renkli reçeteli ilaçlar, endikasyon dışı kullanım onayı ile kullanılan ilaçlar, yurt dışından temin edilen ilaçlar ve 4.2.1, 4.2.10, 4.2.14 maddelerinde yer alan ilaçlar ile Kurumca belirlenecek ilaçlar hariç tutulur.'});
CREATE (sec_1770)-[:HAS_PARAGRAPH {order: 0}]->(para_1771);
CREATE (para_1772:Paragraph {id: '2', content: 'Bu listede yer alan etken maddeler için, ilgili başlıktaki tanılara uygun olacak şekilde sağlık raporu düzenlenmesi halinde bu sağlık raporuna istinaden reçete edilen ilaçlar katılım payından muaf tutulur.'});
CREATE (sec_1770)-[:HAS_PARAGRAPH {order: 1}]->(para_1772);
CREATE (para_1771)-[:NEXT_PARAGRAPH]->(para_1772);
CREATE (para_1773:Paragraph {id: '3', content: 'İlacın reçete edilmesi ile ilgili SUT ve eki listelerde belirtilen özel hükümler saklı kalmak kaydıyla; EK-4/D Listesinde yer alan ilaçlar, sağlık raporuna dayanılarak tüm hekimlerce de reçete edilebilir.'});
CREATE (sec_1770)-[:HAS_PARAGRAPH {order: 2}]->(para_1773);
CREATE (para_1772)-[:NEXT_PARAGRAPH]->(para_1773);
CREATE (para_1774:Paragraph {id: '4', content: 'Sürekli görevle yurt dışına gönderilenler ile bunların yurt dışında birlikte yaşadıkları eş ve bakmakla yükümlü olduğu kişilere, EK-4/D Listesinde yer alan hastalıklarda kullanılacak ilaçların; söz konusu hastalıklar için SUT ve eki listelerde yer alan özel hükümler saklı kalmak kaydıyla, hasta adına düzenlenmiş reçete ile sağlık raporu ve eki yurt dışı görevine dair resmi belge ibrazına dayanılarak en fazla bir yıllık tedavi dozunda reçete edilmesi halinde bedelleri ödenir. (SUT’ta belirlenen süresi 1 yıldan az olan raporlarda rapor süresi kadar ilaç verilir.)'});
CREATE (sec_1770)-[:HAS_PARAGRAPH {order: 3}]->(para_1774);
CREATE (para_1773)-[:NEXT_PARAGRAPH]->(para_1774);
CREATE (para_1775:Paragraph {id: '5', content: 'Kurumca katılım payından muaf tutulan hastalıklar, hastalıkları tanımlayan ICD-10 kodları ve bu hastalıklarda kullanılacak ilaçların yer aldığı EK-4/D Listesi, “Hasta Katılım Payından Muaf İlaçlar Listesi” (EK-4/D) olarak Kurumun resmi internet sitesinde yayımlanır.'});
CREATE (sec_1770)-[:HAS_PARAGRAPH {order: 4}]->(para_1775);
CREATE (para_1774)-[:NEXT_PARAGRAPH]->(para_1775);
CREATE (amend_1776:Amendment {content: '(Ek: \nRG- 18/05/2024- 32550/ 2 md. Yürürlük: 29/05/2024)'});
CREATE (sec_1770)-[:HAS_AMENDMENT {order: 0}]->(amend_1776);
CREATE (sec_1747)-[:NEXT_SUBSECTION]->(sec_1770);
CREATE (sec_1777:Subsection {id: '4.1.7', title: '-(Değişik: RG- 05/08/2015- 29436/ 11 md. Yürürlük: 13/08/2015) Sadece yatarak tedavilerde kullanımı', content: 'halinde bedelleri ödenecek ilaçlar (EK-4/G)'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 6}]->(sec_1777);
CREATE (para_1778:Paragraph {id: '1', content: 'SUT eki “Sadece Yatarak Tedavilerde Kullanımı Halinde Bedelleri Ödenecek İlaçlar Listesi” nde (EK-4/G) yer alan ilaçlar (anestezikler dâhil), sadece sağlık kurum ve kuruluşlarında yatarak tedavilerde kullanılır.'});
CREATE (sec_1777)-[:HAS_PARAGRAPH {order: 0}]->(para_1778);
CREATE (para_1779:Paragraph {id: '2', content: 'SUT eki EK-4/G Listesinde yer alan ilaçların reçete edilmesinde, SUT’un 4.1.2 maddesindeki esas ve usullere uyulur. SUT’ta bulunan özel hükümler saklı kalmak kaydıyla, ayakta tedavilerde reçete edilmesi halinde bu ilaçların bedeli ödenmez.'});
CREATE (sec_1777)-[:HAS_PARAGRAPH {order: 1}]->(para_1779);
CREATE (para_1778)-[:NEXT_PARAGRAPH]->(para_1779);
CREATE (amend_1780:Amendment {content: '(Değişik: RG- 05/08/2015- 29436/ 11 md. Yürürlük: 13/08/2015)'});
CREATE (sec_1777)-[:HAS_AMENDMENT {order: 0}]->(amend_1780);
CREATE (sec_1770)-[:NEXT_SUBSECTION]->(sec_1777);
CREATE (sec_1781:Subsection {id: '4.1.8', title: 'Ayakta tedavide sağlık raporu ile verilebilecek ilaçlar (EK-4/F)'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 7}]->(sec_1781);
CREATE (para_1782:Paragraph {id: '1', content: 'SUT eki “Ayakta Tedavide Sağlık Raporu (Uzman Hekim Raporu/Sağlık Kurulu Raporu) İle Verilebilecek İlaçlar Listesi” nde (EK-4/F) yer alan ilaçların ayakta tedavilerde kullanımı gerektiği durumlarda, SUT ve eki listelerde yer alan özel hükümler saklı kalmak kaydıyla, düzenlenen sağlık raporuna dayanılarak tüm hekimlerce reçete edilebilir. En fazla 3 aylık tedavi dozunda reçete edilmesi halinde bedelleri ödenir.'});
CREATE (sec_1781)-[:HAS_PARAGRAPH {order: 0}]->(para_1782);
CREATE (para_1783:Paragraph {id: '2', content: 'SUT eki EK-4/F Listesinde yer alan ilaçlar için raporda ayrıca ilaç/ilaçların kullanım dozu, uygulama planı ve süresi de belirtilir. Düzenlenen raporlar, tedavi süresi boyunca geçerlidir. Ancak, bu süre iki yılı geçemez.'});
CREATE (sec_1781)-[:HAS_PARAGRAPH {order: 1}]->(para_1783);
CREATE (para_1782)-[:NEXT_PARAGRAPH]->(para_1783);
CREATE (para_1784:Paragraph {id: '3', content: 'SUT eki EK-4/F Listesinde yer almakla birlikte, EK-4/D Listesinde yer almayan ilaçlardan hasta katılım payı alınır, EK-4/D Listesi kapsamında olanlardan ise katılım payı alınmaz.'});
CREATE (sec_1781)-[:HAS_PARAGRAPH {order: 2}]->(para_1784);
CREATE (para_1783)-[:NEXT_PARAGRAPH]->(para_1784);
CREATE (para_1785:Paragraph {id: '4', content: 'Periton diyalizi tedavisinde kullanılması zorunlu görülen diyaliz solüsyonu ve sarf malzemeleri, periton diyaliz tedavisi altındaki hastalara nefroloji  , iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimlerinden birinin düzenlediği uzman hekim raporuna dayanılarak bu hekimlerce veya diyaliz sertifikalı tüm hekimler tarafından ayakta tedavide de reçete edilebilir.'});
CREATE (sec_1781)-[:HAS_PARAGRAPH {order: 3}]->(para_1785);
CREATE (para_1784)-[:NEXT_PARAGRAPH]->(para_1785);
CREATE (amend_1786:Amendment {content: '(Değişik:RG-16/03/2023-32134/19 md. Yürürlük:24/03/2023)'});
CREATE (sec_1781)-[:HAS_AMENDMENT {order: 0}]->(amend_1786);
CREATE (sec_1777)-[:NEXT_SUBSECTION]->(sec_1781);
CREATE (sec_1787:Subsection {id: '4.1.9', title: 'Bedeli ödenecek ilaçlar (EK-4/A)'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 8}]->(sec_1787);
CREATE (para_1788:Paragraph {id: '1', content: 'Kurumca bedeli ödenecek olan ilaçlar Kurumun resmi internet sitesinde yayımlanan “Bedeli Ödenecek İlaçlar Listesi” nde (EK-4/A) belirtilmiştir. Bu listede ticari isimleri ve barkod/karekod numaraları yer almayan ilaçların bedelleri hiç bir koşulda Kurumca ödenmez. Yurt dışından temin edilen ilaçlar için özel düzenlemeler saklıdır. 70 (Ek: RG- 21/04/2015- 29333/ 9-c md. Yürürlük: 01/07/2015)'});
CREATE (sec_1787)-[:HAS_PARAGRAPH {order: 0}]->(para_1788);
CREATE (amend_1789:Amendment {content: '(Değişik: RG- 18/06/2016- 29746/ 9 md. Yürürlük: 25/06/2016)'});
CREATE (sec_1787)-[:HAS_AMENDMENT {order: 0}]->(amend_1789);
CREATE (amend_1790:Amendment {content: '(Mülga: RG- 04/09/2019- 30878/ 14 md. Yürürlük: 12/09/2019)'});
CREATE (sec_1787)-[:HAS_AMENDMENT {order: 1}]->(amend_1790);
CREATE (amend_1791:Amendment {content: '(Mülga:RG- 10/05/2018- 30417/ 6 md. Yürürlük:18/05/2018)'});
CREATE (sec_1787)-[:HAS_AMENDMENT {order: 2}]->(amend_1791);
CREATE (sec_1781)-[:NEXT_SUBSECTION]->(sec_1787);
CREATE (sec_1792:Subsection {id: '4.1.10', title: 'Mülga .................................................................................................................................................. 123'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 9}]->(sec_1792);
CREATE (sec_1787)-[:NEXT_SUBSECTION]->(sec_1792);
CREATE (sec_1793:Subsection {id: '4.1.11', title: 'Hastanelerce Temini Zorunlu Kemoterapi İlaçları Listesi (EK-4/H)'});
CREATE (sec_1687)-[:HAS_SUBSECTION {order: 10}]->(sec_1793);
CREATE (para_1794:Paragraph {id: '1', content: '“Bedeli Ödenecek İlaçlar Listesi” nde (EK-4/A) yer alan ilaçlardan hastanelerce temini zorunlu kemoterapi ilaçlarına ait ticari isimleri ve barkod/karekod numaralarının yer aldığı (EK-4/H) Listesi, “Hastanelerce Temini Zorunlu Kemoterapi İlaçları Listesi” (Ek-4/H) olarak Kurumun resmi internet sitesinde yayımlanır.'});
CREATE (sec_1793)-[:HAS_PARAGRAPH {order: 0}]->(para_1794);
CREATE (sec_1792)-[:NEXT_SUBSECTION]->(sec_1793);
CREATE (sec_1221)-[:NEXT_SECTION]->(sec_1687);
CREATE (sec_1795:Section {id: '4.2', title: 'Bazı özel hastalıklara ve ilaç kullanımına ilişkin düzenlemeler'});
CREATE (doc_1)-[:HAS_SECTION {order: 21}]->(sec_1795);
CREATE (para_1796:Paragraph {id: '1', content: 'Aşağıda belirtilen düzenlemeler, SUT’ta bulunan özel düzenlemeler saklı kalmak kaydıyla, ayakta ve yatarak tedaviler için geçerlidir. (Değişik: RG- 30/08/2014- 29104/ 10-a md. Yürürlük: 06/09/2014) (Değişik: RG- 25/07/2014- 29071/ 19-a md. Yürürlük: 07/08/2014) (Ek: RG- 18/06/2016- 29746/ 10-a md. Yürürlük: 25/06/2016) - (Değişik:RG-08/06/2017-30090/10-a md. Yürürlük:16/06/2017)'});
CREATE (sec_1795)-[:HAS_PARAGRAPH {order: 0}]->(para_1796);
CREATE (sec_1797:Subsection {id: '4.2.1', title: 'Leflunomid, altın preparatları, Anti-TNF ilaçlar, rituksimab (romatoid artritte), abatasept, ustekinumab,', content: 'tofacitinib, kanakinumab,  anakinra, tosilizumab (Ek:RG- 28/04/2021-31468/10-a md. Yürürlük:06/05/2021), sekukinumab, iksekizumab, barisitinib (Ek:RG-26/10/2021-31640/1- a md. Yürürlük:04/11/2021), guselkumab, risankizumab , upadasitinib, (Ek:RG-09/05/2024- 32541/3-a md. Yürürlük: 17/05/2024) abrositinib, apremilast , bimekizumab ve vedolizumab kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 0}]->(sec_1797);
CREATE (amend_1798:Amendment {content: '(Ek:RG-12/12/2024-32750/5 md. Yürürlük:20/12/2024)'});
CREATE (sec_1797)-[:HAS_AMENDMENT {order: 0}]->(amend_1798);
CREATE (amend_1799:Amendment {content: '(Ek:RG-19/10/2023-32344/1 md. Yürürlük:27/10/2023)'});
CREATE (sec_1797)-[:HAS_AMENDMENT {order: 1}]->(amend_1799);
CREATE (amend_1800:Amendment {content: '(Ek:RG-02/11/2024-\n32710/2 md. Yürürlük:09/11/2024)'});
CREATE (sec_1797)-[:HAS_AMENDMENT {order: 2}]->(amend_1800);
CREATE (sec_1801:Subsection {id: '4.2.1.A', title: 'Leflunomid'});
CREATE (sec_1797)-[:HAS_SUBSECTION {order: 0}]->(sec_1801);
CREATE (para_1802:Paragraph {id: '1', content: 'Romatoid artritli veya psoriatik artritli (bu endikasyonda sadece leflunomid 20-100 mg) hastaların tedavisinde; bu durumun belirtildiği iç hastalıkları,  romatoloji, çocuk sağlığı ve hastalıkları, fiziksel tıp ve rehabilitasyon uzman hekimlerinden biri tarafından düzenlenen bir yıl süreli uzman hekim raporuna dayanılarak bu uzman hekimlerce reçete edilir.'});
CREATE (sec_1801)-[:HAS_PARAGRAPH {order: 0}]->(para_1802);

// Batch 49
CREATE (amend_1803:Amendment {content: '(Mülga:RG-09/09/2017-30175/ 15md. Yürürlük:23/09/2017)'});
CREATE (sec_1801)-[:HAS_AMENDMENT {order: 0}]->(amend_1803);
CREATE (amend_1804:Amendment {content: '(Ek:RG-19/10/2023-\n32344/2 md. Yürürlük:27/10/2023)'});
CREATE (sec_1801)-[:HAS_AMENDMENT {order: 1}]->(amend_1804);
CREATE (sec_1805:Subsection {id: '4.2.1.B', title: 'Altın preparatları'});
CREATE (sec_1797)-[:HAS_SUBSECTION {order: 1}]->(sec_1805);
CREATE (para_1806:Paragraph {id: '1', content: 'Romatoid artritli hastalarda, hastalığın diğer hastalık modifiye edici ilaçlardan sulfasalazin veya methotrexat ile kontrol altına alınamadığı veya bu ilaçların kullanımının kontrendike olduğu veya yan etki nedeniyle kullanılamadığı durumlarda, bu durumun belirtildiği fiziksel tıp ve rehabilitasyon, klinik immunoloji ve romatoloji uzman hekimlerinden biri tarafından düzenlenen bir yıl süreli uzman hekim raporuna dayanılarak bu uzman hekimlerce reçete edilir. (Değişik: RG- 30/08/2014- 29104/ 10-b md. Yürürlük: 06/09/2014) (Değişik: RG- 25/07/2014- 29071/ 19-b md. Yürürlük: 07/08/2014 ) (Ek: RG- 18/06/2016- 29746/ 10-b md. Yürürlük: 25/06/2016) (Değişik:RG-08/06/2017-30090/10-b md. Yürürlük:16/06/2017)'});
CREATE (sec_1805)-[:HAS_PARAGRAPH {order: 0}]->(para_1806);
CREATE (amend_1807:Amendment {content: '(Değişik: RG-02/11/2024- 32710/3 md. Yürürlük: 09/11/2024)'});
CREATE (sec_1805)-[:HAS_AMENDMENT {order: 0}]->(amend_1807);
CREATE (amend_1808:Amendment {content: '(Değişik: RG-12/12/2024-32750/6 md. Yürürlük: 20/12/2024)'});
CREATE (sec_1805)-[:HAS_AMENDMENT {order: 1}]->(amend_1808);
CREATE (sec_1801)-[:NEXT_SUBSECTION]->(sec_1805);
CREATE (sec_1809:Subsection {id: '4.2.1.C', title: 'Biyolojik ajanlar (Anti-TNF ilaçlar, rituksimab, abatasept, ustekinumab, kanakinumab, anakinra,', content: 'tosilizumab, sekukinumab, iksekizumab, guselkumab, risankizumab, vedolizumab, bimekizumab), tofacitinib, barisitinib, upadasitinib, abrositinib ve apremilast kullanım ilkeleri'});
CREATE (sec_1797)-[:HAS_SUBSECTION {order: 2}]->(sec_1809);
CREATE (para_1810:Paragraph {id: '1', content: 'Tedaviye uzun süre ara veren (Rituksimab için 12 ay diğer etkin maddeler için 6 ay ve daha uzun süre) hastalarda özel düzenlemeler saklı kalmak kaydıyla yeniden başlangıç kriterleri aranır.'});
CREATE (sec_1809)-[:HAS_PARAGRAPH {order: 0}]->(para_1810);
CREATE (para_1811:Paragraph {id: '2', content: 'Ara vermeden; etkisizlik veya yan etki nedeniyle ilaç değişiminin yapılması halinde özel düzenlemeler saklı kalmak kaydıyla tedaviye başlangıç dozu ile başlanır.'});
CREATE (sec_1809)-[:HAS_PARAGRAPH {order: 1}]->(para_1811);
CREATE (para_1810)-[:NEXT_PARAGRAPH]->(para_1811);
CREATE (para_1812:Paragraph {id: '3', content: 'Aynı hasta için iki farklı tanı ile iki farklı anti-TNF veya anti-TNF dışındaki iki farklı biyolojik ajanın birlikte kullanılması halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1809)-[:HAS_PARAGRAPH {order: 2}]->(para_1812);
CREATE (para_1811)-[:NEXT_PARAGRAPH]->(para_1812);
CREATE (para_1813:Paragraph {id: '4', content: 'Tedavi basamaklarında değişiklik yapılması halinde tedavinin başlandığı tarihteki Sağlık Uygulama Tebliğinde yer alan başlangıç kriterleri geçerlidir.'});
CREATE (sec_1809)-[:HAS_PARAGRAPH {order: 3}]->(para_1813);
CREATE (para_1812)-[:NEXT_PARAGRAPH]->(para_1813);
CREATE (amend_1814:Amendment {content: '(Ek: RG-02/11/2024- 32710/3 md. Yürürlük: 09/11/2024)'});
CREATE (sec_1809)-[:HAS_AMENDMENT {order: 0}]->(amend_1814);
CREATE (sec_1815:Subsection {id: '4.2.1.C-1', title: 'Anti-TNF (tümor nekrözis faktör) ilaçlar'});
CREATE (sec_1809)-[:HAS_SUBSECTION {order: 0}]->(sec_1815);
CREATE (para_1816:Paragraph {id: '1', content: 'Erişkin ve Juvenil Romatoid Artrit;'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 0}]->(para_1816);
CREATE (item_1817:Item {id: 'a', content: '(Değişik: RG- 25/07/2014- 29071/ 19-c md. Yürürlük: 07/08/2014 ) Romatoid artritli erişkin hastalarda; (Ek: RG-21/04/2022- 31816/1-a md. Yürürlük:29/04/2022) anti-TNF ilaçlar, biri methotrexat olmak üzere en az 3 farklı hastalık modifiye edici antiromatizmal ilacı, en az üçer ay kullanmış olmasına rağmen hastalık aktivitesinin kontrol altına alınamadığı (Hastalık Aktivite Skoru (DAS) 28 > 5,1) hallerde, 3 ay süreli sağlık kurulu raporuna dayanılarak ilaca başlanır. İlaca başlandıktan 3 ay sonra yapılan değerlendirmede DAS 28 skorunda 0,6 (sertolizumab için 1,2) puandan fazla düşme olması halinde, bu durumun yeni düzenlenecek 3 ay (sertolizumab için 6 ay) süreli sağlık kurulu raporunda belirtilmesi koşulu ile 3 ay (sertolizumab için 6 ay) daha tedaviye devam edilir. Bu raporun süresi sonunda DAS 28 skorunda toplam 1,2 puandan fazla düşme olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. Tedavinin devamında DAS 28 kriterine 6 ayda bir bakılır, başlangıç ve yeni DAS 28 skorları her sağlık kurulu raporunda belirtilir. Tedaviye rağmen hastanın DAS 28 skorunda, başlangıç DAS 28 skoruna göre, 1,2 puandan fazla düşme olmaması halinde tedavi sonlandırılır. (Ek: RG- 21/04/2022- 31816/1-a md. Yürürlük: 29/04/2022) kullanmış ve cevap alınamamış hastalarda, bu durumun belirtildiği 3 ay süreli sağlık kurulu raporu ile başlanır. İlaca başlandıktan 3 ay sonra yapılan değerlendirmede DAS 28 skorunda 0,6 puandan fazla düşme olması halinde, bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile 3 ay daha tedaviye devam edilir. Bu rapor süresi 71 sonunda DAS 28 skorunda toplam 1,2 puandan fazla düşme olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. Tedavinin devamında DAS 28 kriterine 6 ayda bir bakılır, başlangıç ve yeni DAS 28 skorları her sağlık kurulu raporunda belirtilir. Tedaviye rağmen hastanın DAS 28 skorunda, başlangıç DAS 28 skoruna göre, 1,2 puandan fazla düşme olmaması halinde tedavi sonlandırılır. Bu hastaların ayrıca dirençli gastrointestinal tutulumunun veya Beden Kitle İndeksinin 35 ve üzerinde olduğunun raporda belirtilmesi halinde infliksimab kullanımı için daha önceden diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış olma kriteri aranmayacaktır. (Değişik: RG- 21/03/2018- 30367/ 16-a md. Yürürlük: 01/04/2018) b (Değişik: RG- 19/10/2023- 32344/ 3-b md. Yürürlük: 27/10/2023)'});
CREATE (para_1816)-[:HAS_ITEM {order: 0}]->(item_1817);
CREATE (subitem_1818:SubItem {id: '1', content: 'İnfliksimab etkin maddeli ilaca, yukarıda belirtilen koşullarda ve sürelerde diğer anti-TNF ilaçlardan en az birini'});
CREATE (item_1817)-[:HAS_SUBITEM {order: 0}]->(subitem_1818);
CREATE (item_1819:Item {id: 'b', content: 'Juvenil romatoid artritli (poliartiküler-idiyopatik-kronik) hastalarda; pediatrik 30 yanıtı alınamamış ise bu durumun belirtildiği 3 ay süreli sağlık kurulu raporuna dayanılarak Anti-TNF ilaçlarla tedaviye başlanabilir. Üveitin eşlik ettiği hastalarda adalimumab ilk seçenek Anti-TNF olarak başlanır. durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile tedaviye devam edilir. Bu raporun süresi sonunda hastanın ACR pediatrik cevap kriteri 50 ve üzerinde olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. Tedavinin devamında ACR pediatrik cevap kriterine 6 ayda bir bakılır, başlangıç ve ACR pediatrik cevap kriteri her sağlık kurulu raporunda belirtilir. Tedaviye rağmen ACR pediatrik cevap kriteri 50’ye ulaşmayan hastalarda anti-TNF tedavisine devam edilmez. hastalık aktivite ölçümü yapılması esastır. Ancak 18 yaşından küçük iken ACR pediatrik cevap kriterine göre yanıt alınmış hastalarda DAS 28 skoru koşulları aranmaksızın mevcut tedavilere devam edilebilir. 18 yaş ve üzerinde hastalığın alevlenmesi durumunda ise erişkin koşulları (DAS 28 skorlaması) geçerlidir.'});
CREATE (para_1816)-[:HAS_ITEM {order: 1}]->(item_1819);
CREATE (subitem_1820:SubItem {id: '1', content: 'NSAİ ve en az bir veya daha fazla hastalık modifiye edici anti-romatizmal ilacı en az 3 ay kullanmış ve ACR'});
CREATE (item_1819)-[:HAS_SUBITEM {order: 0}]->(subitem_1820);
CREATE (subitem_1821:SubItem {id: '2', content: 'Tedaviye başlandıktan 3 ay sonra yapılan değerlendirmede ACR pediatrik 30 yanıtının alınması halinde, bu'});
CREATE (item_1819)-[:HAS_SUBITEM {order: 1}]->(subitem_1821);
CREATE (subitem_1820)-[:NEXT_SUBITEM]->(subitem_1821);
CREATE (subitem_1822:SubItem {id: '3', content: '18 yaş ve üzerinde juvenil romatoid artritli (poliartiküler-idiyopatik-kronik) hastalarda DAS 28 skoruna göre'});
CREATE (item_1819)-[:HAS_SUBITEM {order: 2}]->(subitem_1822);
CREATE (subitem_1821)-[:NEXT_SUBITEM]->(subitem_1822);
CREATE (item_1817)-[:NEXT_ITEM]->(item_1819);
CREATE (para_1823:Paragraph {id: '2', content: 'Aksiyel tutulumlu ankilozan spondilitli  ve radyografik olarak ankilozan spondilit (AS) kanıtı olmayan aksiyel spondilartritli hastalarda; biri maksimum doz indometazin olmak üzere en az 3 nonsteroid antiinflamatuar ilacı maksimum dozunda kullanmasına rağmen yeterli cevap alınamayan (Bath Ankilozan Spondilit Hastalık Aktivite İndeksi (BASDAİ) >5), bununla birlikte eritrosit sedimetasyon hızı >28 mm/s veya normalin üst sınırını aşan CRP değeri veya MR/sintigrafi ile gösterilmiş aktif sakroilit/spondiliti olan durumlarda, bu durumun 3 ay süreli sağlık kurulu raporunda belirtilmesi koşuluyla ilaca başlanır. (Ek: RG-21/04/2022-31816/1-b md. Yürürlük: 29/04/2022) İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Yeterli cevap alınamamışsa (BASDAİ’de 2 birimden daha az düzelme olması), ilaca devam edilmesi durumunda ilaç bedeli ödenmez. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum 6 ay süreli yeni düzenlenecek sağlık kurulu raporunda belirtilir. (Ek: RG-21/04/2022-31816/1-b md. Yürürlük: 29/04/2022)'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 1}]->(para_1823);
CREATE (item_1824:Item {id: 'a', content: 'İnfliksimab etkin maddeli ilaca yukarıda belirtilen koşullarda ve sürelerde diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış hastalarda, bu durumun 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile başlanır. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Yeterli cevap alınamamışsa (BASDAİ’de 2 birimden daha az düzelme olması), ilaca devam edilmesi durumunda ilaç bedeli ödenmez. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum 6 ay süreli yeni düzenlenecek sağlık kurulu raporunda belirtilir. Bu hastaların ayrıca dirençli gastrointestinal tutulumunun veya Beden Kitle İndeksinin 35 ve üzerinde olduğunun raporda belirtilmesi halinde infliksimab kullanımı için daha önceden diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış olma kriteri aranmayacaktır.'});
CREATE (para_1823)-[:HAS_ITEM {order: 0}]->(item_1824);
CREATE (para_1816)-[:NEXT_PARAGRAPH]->(para_1823);
CREATE (para_1825:Paragraph {id: '3', content: 'Periferik eklem tutulumlu ankilozan spondilitli hastalarda; maksimum dozda NSAİ ile birlikte sulfasalazin veya methotrexattan birinin kullanılmasına rağmen yeterli cevap alınamayan (BASDAİ >5) ve bununla birlikte eritrosit sedimentasyon hızı >28 mm/s veya normalin üst sınırını aşan CRP değeri olan durumlarda, bu durumun 3 ay süreli sağlık kurulu raporunda belirtilmesi koşuluyla ilaca başlanır. (Ek: RG-21/04/2022-31816/1-b md. Yürürlük: 29/04/2022) İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Yeterli cevap alınamamışsa (BASDAİ’de 2 birimden daha az düzelme olması), ilaca devam edilmesi durumunda ilaç bedeli ödenmez. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum 6 ay süreli yeni düzenlenecek sağlık kurulu raporunda belirtilir. (Ek: RG-21/04/2022-31816/1-b md. Yürürlük: 29/04/2022)'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 2}]->(para_1825);
CREATE (item_1826:Item {id: 'a', content: 'İnfliksimab etkin maddeli ilaca yukarıda belirtilen koşullarda ve sürelerde diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış hastalarda, bu durumun 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile başlanır. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Yeterli cevap alınamamışsa (BASDAİ’de 2 birimden daha az düzelme olması), ilaca devam edilmesi durumunda ilaç bedeli ödenmez. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum 6 ay süreli yeni düzenlenecek sağlık kurulu raporunda belirtilir. Bu hastaların ayrıca dirençli gastrointestinal tutulumunun veya Beden Kitle İndeksinin 35 ve üzerinde olduğunun raporda belirtilmesi halinde infliksimab kullanımı için daha önceden diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış olma kriteri aranmayacaktır. (Mülga: RG- 21/04/2022- 31816/1-c md. Yürürlük: 29/04/2022)'});
CREATE (para_1825)-[:HAS_ITEM {order: 0}]->(item_1826);
CREATE (para_1823)-[:NEXT_PARAGRAPH]->(para_1825);
CREATE (para_1827:Paragraph {id: '5', content: 'Psöriyatik artritli hastalarda; en az 3 farklı hastalık modifiye edici antiromatizmal ilacı uygun dozunda en az üçer ay olmak üzere kullanmış olmasına rağmen hastalık aktivitesinin kontrol altına alınamadığı (bir ay arayla yapılmış iki ayrı muayenede en az üç hassas eklem ve en az üç şiş eklem olması) durumlarda, bu durumun sağlık kurulu raporunda belirtilmesi koşuluyla ilaca başlanır. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Yeterli cevap alınamamışsa (psöriyatik artrit yanıt kriterlerine (PSARC) göre yanıt alınamaması) ilaca devam edilmesi durumunda ilaç bedeli ödenmez. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum 6 ay süreli yeni düzenlenecek sağlık kurulu raporunda belirtilir. (Ek: RG- 21/04/2022- 31816/1-ç md. Yürürlük: 29/04/2022)'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 3}]->(para_1827);
CREATE (item_1828:Item {id: 'a', content: 'İnfliksimab etkin maddeli ilaca yukarıda belirtilen koşullarda ve sürelerde diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış hastalarda, bu durumun sağlık kurulu raporunda belirtilmesi koşulu ile başlanır. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Yeterli cevap alınamamış olması halinde (psöriyatik artrit yanıt kriterlerine 72 (PSARC) göre yanıt alınamaması) tedavi sonlandırılır. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum 6 ay süreli yeni düzenlenecek sağlık kurulu raporunda belirtilir. Bu hastaların ayrıca dirençli gastrointestinal tutulumunun veya Beden Kitle İndeksinin 35 ve üzerinde olduğunun raporda belirtilmesi halinde infliksimab kullanımı için daha önceden diğer anti-TNF ilaçlardan en az birini kullanmış ve cevap alınamamış olma kriteri aranmayacaktır.'});
CREATE (para_1827)-[:HAS_ITEM {order: 0}]->(item_1828);
CREATE (para_1825)-[:NEXT_PARAGRAPH]->(para_1827);
CREATE (para_1829:Paragraph {id: '6', content: 'Anti-TNF ilaçlar, tüm romatoloji uzman hekimleri veya üniversite hastaneleri ile eğitim ve araştırma hastanelerindeki klinik immunoloji veya fiziksel tıp ve rehabilitasyon uzman hekimlerinden birinin yer aldığı en fazla 6 ay süreli sağlık kurulu raporuna dayanılarak, bu uzman hekimlerden biri veya iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimleri tarafından reçete edilebilir. (Mülga:RG-02/11/2024-32710/4-a md. Yürürlük:09/11/2024)'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 4}]->(para_1829);
CREATE (para_1827)-[:NEXT_PARAGRAPH]->(para_1829);
CREATE (para_1830:Paragraph {id: '7', content: 'Bu ilaçların intravenöz formları, fiziksel tıp ve rehabilitasyon, iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekiminin bulunduğu sağlık kurumunda uygulanır. Subkütan formlarının ilk dozları fiziksel tıp ve rehabilitasyon, iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekiminin bulunduğu sağlık kurum/kuruluşlarında hekim gözetiminde yapılır. Uygun enjeksiyon tekniği konusunda hastaya veya hasta yakınına eğitim verildikten sonra ilgili uzman hekim uygun gördüğü ve sağlık kurulu raporunda “Mahallinde tedavisi sürdürülebilir” ibaresine yer verdiği taktirde hastane dışında uygulanmak üzere (Değişik:RG-16/03/2023-32134/20-a md. Yürürlük:24/03/2023) 12 (on iki) haftalık dozlar halinde reçete edilebilir.'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 5}]->(para_1830);
CREATE (para_1829)-[:NEXT_PARAGRAPH]->(para_1830);
CREATE (para_1831:Paragraph {id: '8', content: 'Anti-TNF ilaçlar diğer antiromatizmal ilaçlar ile kombine olarak da kullanılabilir.'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 6}]->(para_1831);
CREATE (para_1830)-[:NEXT_PARAGRAPH]->(para_1831);
CREATE (para_1832:Paragraph {id: '9', content: '(Değişik: RG- 25/07/2014- 29071/ 19-c md. Yürürlük: 07/08/2014 ) Psoriyazis vulgaris /plak tip psoriyazis /plak psoriyaziste anti-TNF ilaçlar; üniversite hastaneleri veya eğitim ve araştırma hastanelerinde dermatoloji uzman hekiminin yer aldığı, diğer hastalık modifiye edici ilaçlara dirençli olduğunu, kullanılacak ilacın günlük doz ve süresini belirten 6 ay süreli sağlık kurulu raporuna dayanılarak dermatoloji uzman hekimlerince reçete edilebilir. (Değişik: RG- 28/12/2018- 30639/ 12-a md. Yürürlük: 08/01/2019)'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 7}]->(para_1832);
CREATE (para_1831)-[:NEXT_PARAGRAPH]->(para_1832);
CREATE (para_1833:Paragraph {id: '10', content: 'Crohn hastalığı;'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 8}]->(para_1833);
CREATE (item_1834:Item {id: 'a', content: 'Yetişkinlerde; fistülize, şiddetli veya aktif luminal Crohn hastalığında adalimumab, sertolizumab ve infliksimab; sistemik kortikosteroidler ve/veya klasik immünsupresifler ile 12 haftalık tedaviye yeterli yanıt vermeyen veya tolere edemeyen hastalarda bu durumun ve söz konusu ilaçların günlük kullanım dozu ve kullanım süresini belirten 4 ay süreli sağlık kurulu raporuna dayanılarak tedaviye başlanır. Tedavinin 4 üncü ayında tedaviye cevap alınamaması (Crohn Hastalık Aktivite İndeksi’nde başlangıca göre en az 70 puanlık düşüşün olmaması) durumunda tedavi kesilir. Crohn Hastalık Aktivite İndeksi’nde başlangıca göre en az 70 puan ve üzerinde düşüş olması halinde, bu durum ile ilacın kullanılacak dozu ve süresinin belirtildiği 6 ay süreli sağlık kurulu raporuna dayanılarak tedaviye devam edilebilir. Düzenlenecek sağlık kurulu raporlarında en az bir gastroenteroloji veya genel cerrahi uzman hekiminin yer alması ve reçetelerin gastroenteroloji, iç hastalıkları veya genel cerrahi uzman hekimlerince düzenlenmesi halinde Kurumca bedelleri karşılanır. Crohn hastalığında adalimumabın flakon formunun kullanılması halinde bedelleri Kurumca karşılanmaz.'});
CREATE (para_1833)-[:HAS_ITEM {order: 0}]->(item_1834);
CREATE (item_1835:Item {id: 'b', content: 'Çocuklarda; fistülize, şiddetli veya aktif luminal Crohn hastalığında adalimumab ve infliksimab; sistemik kortikosteroidler ve/veya klasik immünsupresifler ile 12 haftalık tedaviye yeterli yanıt vermeyen veya tolere edemeyen hastalarda bu durumun ve söz konusu ilaçların günlük kullanım dozu ve kullanım süresini belirten 4 ay süreli sağlık kurulu raporuna dayanılarak tedaviye başlanır. Tedavinin 4 üncü ayında tedaviye cevap alınamaması (The Pediatric Crohn Disease Activity Index (PCDAI) skorunda başlangıca göre en az 15 puan düşüş olmaması) durumunda tedavi kesilir. PCDAI skorunda başlangıca göre en az 15 puan ve üzerinde düşüş olması halinde, bu durum ile ilacın kullanılacak dozu ve süresinin belirtildiği 6 ay süreli sağlık kurulu raporuna dayanılarak tedaviye devam edilebilir. Düzenlenecek sağlık kurulu raporlarında en az bir çocuk gastroenterolojisi veya çocuk cerrahisi uzman hekiminin yer alması ve reçetelerin çocuk gastroenterolojisi, çocuk sağlığı ve hastalıkları veya çocuk cerrahisi uzman hekimlerince düzenlenmesi halinde Kurumca bedelleri karşılanır.'});
CREATE (para_1833)-[:HAS_ITEM {order: 1}]->(item_1835);
CREATE (item_1834)-[:NEXT_ITEM]->(item_1835);
CREATE (para_1832)-[:NEXT_PARAGRAPH]->(para_1833);
CREATE (para_1836:Paragraph {id: '11', content: 'Ülseratif kolit hastalığında infliksimab veya adalimumab; kortikosteroidler ve 6-MP veya AZA ile uygun dozlarda ve en az 8 haftalık sürede yapılan konvansiyonel tedaviye yetersiz yanıt veren ya da tolere edemeyen veya bu terapiler için tıbbi kontrendikasyonları olan hastalarda; şiddetli aktif ülseratif kolit bulgularının devam etmesi halinde, üçüncü basamak sağlık (Değişik: RG-02/11/2024-32710/4-b md. Yürürlük:09/11/2024) hizmeti sunucularında bu durumun belirtildiği 4 ay süreli en az biri gastroenteroloji veya genel cerrahi uzmanı hekimi olmak üzere sağlık kurulu raporuna istinaden tedaviye başlanır. Yanıt alınması halinde bu durumun belirtildiği yine bu hekimlerce düzenlenecek 6 ay süreli sağlık kurulu raporuyla tedaviye devam edilir. Sağlık kurulu raporuna dayanılarak, bu uzman hekimler veya iç hastalıkları uzman hekimlerince reçete düzenlenmesi halinde bedelleri Kurumca karşılanır. (Ek:RG- 28/12/2018- 30639/ 12-b md. Yürürlük: 08/01/2019)'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 9}]->(para_1836);
CREATE (para_1833)-[:NEXT_PARAGRAPH]->(para_1836);
CREATE (para_1837:Paragraph {id: '12', content: 'Üveit hastalığı;'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 10}]->(para_1837);
CREATE (item_1838:Item {id: 'a', content: 'Yetişkinlerde, kortikosteroidlere yetersiz yanıt vermiş, kortikosteroid kullanımının azaltılması gereken veya kortikosteroid tedavisine uygun olmayan non-enfeksiyöz orta, arka veya panüveitte 3 ay süreli sağlık kurulu raporuna dayanılarak adalimumab tedavisine başlanabilir. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durumun belirtildiği 6 ay süreli sağlık kurulu raporuna dayanılarak tedaviye devam edilebilir. Sağlık kurulu raporlarının üçüncü basamak sağlık kurumlarında ve üç göz hastalıkları uzman hekimi tarafından düzenlenmesi ve göz hastalıkları uzman hekimince reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1837)-[:HAS_ITEM {order: 0}]->(item_1838);
CREATE (item_1839:Item {id: 'b', content: '2 yaşından itibaren çocuklarda, konvansiyonel tedavilere yetersiz yanıt vermiş, konvansiyonel tedavilere uygun olmayan/tolere edemeyen non-enfeksiyöz kronik anterior üveitte 3 ay süreli sağlık kurulu raporuna dayanılarak adalimumab tedavisine başlanabilir. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durumun belirtildiği 6 ay süreli sağlık kurulu raporuna dayanılarak tedaviye devam edilebilir. Sağlık kurulu raporlarının üçüncü basamak sağlık kurumlarında ve üç göz hastalıkları uzman hekimi tarafından düzenlenmesi ve göz hastalıkları uzman hekimince reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1837)-[:HAS_ITEM {order: 1}]->(item_1839);
CREATE (item_1838)-[:NEXT_ITEM]->(item_1839);
CREATE (para_1836)-[:NEXT_PARAGRAPH]->(para_1837);
CREATE (para_1840:Paragraph {id: '13', content: 'Orta veya şiddetli aktif Hidradenitis Suppurativa (HS) hastalığı olan yetişkinlerde 6 hafta süreyle sistemik antibiyotik tedavisine yeterli yanıt alınamaması durumunda en fazla 3 ay süreli sağlık kurulu raporuna dayanılarak adalimumab 73 tedavisine başlanır. İlaca başlandıktan 3 ay sonra, başlangıca göre apse ve inflamatuvar nodüllerde en az %50 azalma ve apse sayılarında artış olmaması ve akıntılı fistüllerin sayısında artış olmaması durumunda en fazla 6 ay süreli sağlık kurulu raporuna dayanılarak tedaviye devam edilebilir. Devam eden raporlarda başlangıç ve devam kriterleri aranmaz. Tedaviye 1 yıl ve daha uzun süre ara veren hastalarda yeniden başlangıç kriterleri aranır. Sağlık kurulu raporlarının üçüncü basamak sağlık kurumlarında ve üç dermatoloji uzman hekimi tarafından düzenlenmesi ve dermatoloji uzman hekimince reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_1815)-[:HAS_PARAGRAPH {order: 11}]->(para_1840);
CREATE (para_1837)-[:NEXT_PARAGRAPH]->(para_1840);
CREATE (amend_1841:Amendment {content: '(Ek: RG- 18/02/2015- 29271/ 11 md. Yürürlük: 28/02/2015)'});
CREATE (sec_1815)-[:HAS_AMENDMENT {order: 0}]->(amend_1841);
CREATE (amend_1842:Amendment {content: '(Değişik: RG- 07/10/2016- 29850/ 15 md. Yürürlük: 15/10/2016)'});
CREATE (sec_1815)-[:HAS_AMENDMENT {order: 1}]->(amend_1842);

// Batch 50
CREATE (amend_1843:Amendment {content: '(Değişik: RG- 26/09/2013- 28777/ 2 md. Yürürlük: 04/10/2013)'});
CREATE (sec_1815)-[:HAS_AMENDMENT {order: 2}]->(amend_1843);
CREATE (sec_1844:Subsection {id: '4.2.1.C-2', title: 'Rituksimab', content: '(Değişik: RG- 25/07/2014- 29071/ 19-ç md. Yürürlük: 07/08/2014 )'});
CREATE (sec_1809)-[:HAS_SUBSECTION {order: 1}]->(sec_1844);
CREATE (para_1845:Paragraph {id: '1', content: 'Romatoid artritli hastalarda;'});
CREATE (sec_1844)-[:HAS_PARAGRAPH {order: 0}]->(para_1845);
CREATE (item_1846:Item {id: 'a', content: 'Methotreksat ile kombinasyon halinde, aktif romatoid artriti bulunan ve bir veya daha fazla anti TNF tedavilerine rağmen hastalığı kontrol edilemeyen (DAS 28 SKORU >5.1 olan) veya TNF inhibitörü başlanması uygun olmayan/görülmeyen veya TNF inhibitörlerine karşı intoleransı olan erişkin hastalarda, bu durumun belirtildiği sağlık kurulu raporuna dayanılarak romatoloji veya klinik immunoloji veya fiziksel tıp ve rehabilitasyon uzman hekimleri tarafından reçetelenir.'});
CREATE (para_1845)-[:HAS_ITEM {order: 0}]->(item_1846);
CREATE (item_1847:Item {id: 'b', content: 'Sağlık kurulu raporları 6 aylık olarak düzenlenir. İlk raporun süresi sonunda DAS 28 skorunda toplam 1,2 puandan fazla düşme olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. Tedavinin devamında DAS 28 kriterine 6 ayda bir bakılır, başlangıç ve yeni DAS 28 skorları her sağlık kurulu raporunda belirtilir. Tedaviye rağmen hastanın DAS 28 skorunda, başlangıç DAS 28 skoruna göre 1,2 puandan fazla düşme olmaması halinde tedavi sonlandırılır.'});
CREATE (para_1845)-[:HAS_ITEM {order: 1}]->(item_1847);
CREATE (item_1846)-[:NEXT_ITEM]->(item_1847);
CREATE (item_1848:Item {id: 'c', content: 'Sağlık kurulu raporları aşağıdaki şekilde düzenlenir: bulunduğu sağlık kurulu raporu. veya fiziksel tıp ve rehabilitasyon uzman hekiminin bulunduğu sağlık kurulu raporu.'});
CREATE (para_1845)-[:HAS_ITEM {order: 2}]->(item_1848);
CREATE (subitem_1849:SubItem {id: '1', content: 'Romatoloji uzman hekiminin bulunduğu sağlık kurum/kuruluşlarında, en az bir romatoloji uzman hekiminin'});
CREATE (item_1848)-[:HAS_SUBITEM {order: 0}]->(subitem_1849);
CREATE (subitem_1850:SubItem {id: '2', content: 'Üniversite hastaneleri ile eğitim ve araştırma hastanelerinde ise en az bir romatoloji veya klinik immunoloji uzmanı'});
CREATE (item_1848)-[:HAS_SUBITEM {order: 1}]->(subitem_1850);
CREATE (subitem_1849)-[:NEXT_SUBITEM]->(subitem_1850);
CREATE (item_1847)-[:NEXT_ITEM]->(item_1848);
CREATE (para_1851:Paragraph {id: '2', content: 'Siklofosfamide dirençli veya siklofosfamid tedavisi verilemeyen ciddi, aktif granulamatoz polianjitis (GPA/ Wegener granülomatozu) ve mikroskobik polianjitis (MPA) hastalarının tedavisinde glukokortikoidlerle kombine olarak;'});
CREATE (sec_1844)-[:HAS_PARAGRAPH {order: 1}]->(para_1851);
CREATE (item_1852:Item {id: 'a', content: 'Romatoloji, klinik immunoloji veya nefroloji uzman hekimlerinden en az birinin bulunduğu 1 ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimler tarafından reçetelenir. 6 aydan önce tekrar kullanılamaz.'});
CREATE (para_1851)-[:HAS_ITEM {order: 0}]->(item_1852);
CREATE (item_1853:Item {id: 'b', content: 'Her 6 aydan sonraki kullanım için tedaviye gerekliliğinin belirtildiği yeni sağlık kurulu raporuna dayanılarak aynı koşullarda reçetelenebilir. (Ek: RG- 16/03/2023-32134/20-b md. Yürürlük: 24/03/2023)'});
CREATE (para_1851)-[:HAS_ITEM {order: 1}]->(item_1853);
CREATE (item_1852)-[:NEXT_ITEM]->(item_1853);
CREATE (para_1845)-[:NEXT_PARAGRAPH]->(para_1851);
CREATE (para_1854:Paragraph {id: '3', content: 'Orta ilâ şiddetli pemfigus vulgarisli hastalarda;'});
CREATE (sec_1844)-[:HAS_PARAGRAPH {order: 2}]->(para_1854);
CREATE (item_1855:Item {id: 'a', content: 'Pemfigus Hastalığı Alan İndeksi (PDAİ)>15 olan ve sistemik steoid ve/veya immunsupresan ile en az 1 aylık tedaviyi takiben yeni lezyon çıkışı varsa ya da iyileşme sağlanamıyorsa hastaya rituksimab tedavisi başlanabilir.'});
CREATE (para_1854)-[:HAS_ITEM {order: 0}]->(item_1855);
CREATE (item_1856:Item {id: 'b', content: 'Pemfigus vulgaris tedavisi için önerilen ilk rituksimab dozu 1000 mg\'dır, IV infüzyon olarak uygulanır, ardından iki hafta sonra glukokortikoidlerin azaltıcı seyri ile kombinasyon halinde ikinci bir 1000 mg IV infüzyonu yapılır. Tedaviyi takiben yapılan yanıt değerlendirmesinde hastada yeni lezyon çıkışı varsa ya da iyileşme sağlanamıyorsa rituksimab tedavisi sonlandırılır.'});
CREATE (para_1854)-[:HAS_ITEM {order: 1}]->(item_1856);
CREATE (item_1855)-[:NEXT_ITEM]->(item_1856);
CREATE (item_1857:Item {id: 'c', content: 'Yanıt alınan hastalarda, tedavinin devamında, 500 mg IV idame infüzyonu 12. ve 18. aylarda ve daha sonra gerekirse klinik değerlendirmeye göre yanıt alınan hastalarda 6 ayda bir uygulanabilir.'});
CREATE (para_1854)-[:HAS_ITEM {order: 2}]->(item_1857);
CREATE (item_1856)-[:NEXT_ITEM]->(item_1857);
CREATE (item_1858:Item {id: 'ç', content: 'Nüks gelişmesi durumunda hastalara 16 haftadan daha erken olmamak kaydıyla 1000 mg rituximab daha verilebilir.'});
CREATE (para_1854)-[:HAS_ITEM {order: 3}]->(item_1858);
CREATE (item_1857)-[:NEXT_ITEM]->(item_1858);
CREATE (item_1859:Item {id: 'd', content: 'İlacın üçüncü basamak sağlık kurumlarında, dermatoloji uzman hekiminin yer aldığı 6 ay süreli sağlık kurulu raporuna dayanılarak dermatoloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. Raporlarda hastanın PDAİ skorunun ve yanıt değerlendirmesi sonucu yeni lezyon çıkışının olmadığının ve mevcut lezyonlarda küçülme olduğunun belirtilmesi gerekmektedir.'});
CREATE (para_1854)-[:HAS_ITEM {order: 4}]->(item_1859);
CREATE (item_1858)-[:NEXT_ITEM]->(item_1859);
CREATE (para_1851)-[:NEXT_PARAGRAPH]->(para_1854);
CREATE (sec_1815)-[:NEXT_SUBSECTION]->(sec_1844);
CREATE (sec_1860:Subsection {id: '4.2.1.C-3', title: 'Abatasept'});
CREATE (sec_1809)-[:HAS_SUBSECTION {order: 2}]->(sec_1860);
CREATE (para_1861:Paragraph {id: '1', content: 'Romatoid artritli erişkin hastalarda; (Değişik: RG- 18/06/2016- 29746/ 10-c md. Yürürlük: 25/06/2016)'});
CREATE (sec_1860)-[:HAS_PARAGRAPH {order: 0}]->(para_1861);
CREATE (item_1862:Item {id: 'a', content: 'Aktif romatoid artriti bulunan, biri methotrexat olmak üzere en az 3 farklı hastalık modifiye edici antiromatizmal ilacı, en az üçer ay kullanmış olmasına veya en az bir anti TNF tedavisine rağmen hastalığı kontrol edilemeyen (DAS 28 SKORU >5.1 olan) erişkin hastalarda methotrexat ile birlikte, tüm romatoloji uzman hekimleri veya üniversite hastaneleri ile eğitim ve araştırma hastanelerinde klinik immunoloji veya fiziksel tıp ve rehabilitasyon uzman hekimlerinden birinin yer aldığı 3 ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimler tarafından reçetelenir.'});
CREATE (para_1861)-[:HAS_ITEM {order: 0}]->(item_1862);
CREATE (item_1863:Item {id: 'b', content: 'İlaca başlandıktan 3 ay sonra yapılan değerlendirmede DAS 28 skorunda 0,6 puandan fazla düşme olması halinde, bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile 3 ay daha tedaviye devam edilir.'});
CREATE (para_1861)-[:HAS_ITEM {order: 1}]->(item_1863);
CREATE (item_1862)-[:NEXT_ITEM]->(item_1863);
CREATE (item_1864:Item {id: 'c', content: 'Bu raporun süresi sonunda DAS 28 skorunda toplam 1,2 puandan fazla düşme olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir.'});
CREATE (para_1861)-[:HAS_ITEM {order: 2}]->(item_1864);
CREATE (item_1863)-[:NEXT_ITEM]->(item_1864);
CREATE (item_1865:Item {id: 'ç', content: 'Tedavinin devamında DAS 28 kriterine 6 ayda bir bakılır, başlangıç ve yeni DAS 28 skorları her 6 ay süreli sağlık kurulu raporunda belirtilir. Tedaviye rağmen hastanın DAS 28 skorunda, başlangıç DAS 28 skoruna göre, 1,2 puandan fazla düşme olmaması halinde tedavi sonlandırılır.'});
CREATE (para_1861)-[:HAS_ITEM {order: 3}]->(item_1865);
CREATE (item_1864)-[:NEXT_ITEM]->(item_1865);
CREATE (para_1866:Paragraph {id: '2', content: 'Juvenil romatoid artritli (poliartiküler-idiyopatik) hastalarda;'});
CREATE (sec_1860)-[:HAS_PARAGRAPH {order: 1}]->(para_1866);
CREATE (item_1867:Item {id: 'a', content: '3 aylık anti-TNF tedavisine rağmen ACR pediatrik 30 cevap kriterine ulaşamayan çocuk hastalarda methotrexat ile kombinasyon halinde, yalnızca üniversite veya eğitim ve araştırma hastanelerinde içinde en az bir çocuk romatoloji uzmanının bulunduğu  3 (üç) ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimler veya çocuk sağlığı ve hastalıkları uzman hekimleri tarafından reçete edilir. 74 .'});
CREATE (para_1866)-[:HAS_ITEM {order: 0}]->(item_1867);
CREATE (item_1868:Item {id: 'b', content: 'İlk 3 aylık abatasept kullanımı sonunda ACR pediatrik 30 cevabına ulaşmış hastalar için bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile tedaviye devam edilir. Bu raporun süresi sonunda hastanın ACR pediatrik cevap kriterinin 50 ve üzerinde olması halinde bu durumun 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. Tedavinin devamında 6 ayda bir ACR pediatrik cevap kriterine bakılır, başlangıç ve ACR cevap kriterleri her sağlık kurulu raporunda belirtilir. Tedaviye rağmen ACR pediatrik cevap kriteri 50’ye ulaşmayan hastalarda abatasept tedavisine devam edilmez. (Ek: RG- 25/07/2014- 29071/ 19-d md. Yürürlük: 07/08/2014 )'});
CREATE (para_1866)-[:HAS_ITEM {order: 1}]->(item_1868);
CREATE (item_1867)-[:NEXT_ITEM]->(item_1868);
CREATE (para_1861)-[:NEXT_PARAGRAPH]->(para_1866);
CREATE (amend_1869:Amendment {content: '(Değişik: RG- 18/02/2017- 29983/ 7 md. Yürürlük: 01/03/2017)'});
CREATE (sec_1860)-[:HAS_AMENDMENT {order: 0}]->(amend_1869);
CREATE (amend_1870:Amendment {content: '(Değişik: RG- 18/02/2017- 29983/ 7 md. Yürürlük: 01/03/2017)'});
CREATE (sec_1860)-[:HAS_AMENDMENT {order: 1}]->(amend_1870);
CREATE (sec_1844)-[:NEXT_SUBSECTION]->(sec_1860);
CREATE (sec_1871:Subsection {id: '4.2.1.C-4', title: 'Ustekinumab'});
CREATE (sec_1809)-[:HAS_SUBSECTION {order: 3}]->(sec_1871);
CREATE (para_1872:Paragraph {id: '1', content: 'Sistemik tedaviye yanıt vermeyen, kontrendike olan veya bu tedaviyi tolere edemeyen yetişkinlerde orta ile şiddetli plak tip psoriyazis tedavisinde;'});
CREATE (sec_1871)-[:HAS_PARAGRAPH {order: 0}]->(para_1872);
CREATE (item_1873:Item {id: 'a', content: 'Üniversite hastaneleri veya eğitim ve araştırma hastanelerinde dermatoloji uzman hekiminin yer aldığı, 1 yıl süreli sağlık kurulu raporuna dayanılarak dermatoloji uzman hekimlerince reçete edilebilir.'});
CREATE (para_1872)-[:HAS_ITEM {order: 0}]->(item_1873);
CREATE (item_1874:Item {id: 'b', content: 'Raporda, başlangıç psoriyazis Alan Şiddet İndeksi (PASI) değeri ve tedavi şeması belirtilir.'});
CREATE (para_1872)-[:HAS_ITEM {order: 1}]->(item_1874);
CREATE (item_1873)-[:NEXT_ITEM]->(item_1874);
CREATE (item_1875:Item {id: 'c', content: 'İlaca başlandıktan sonra 28. haftada yapılan değerlendirmede PASI değerine bakılır, başlangıç PASI değerine göre PASI 75 yanıtını sağlamayan (başlangıca göre en az %75 PASI iyileşmesi görülmeyen) hastalarda tedavi sonlandırılır. 28.haftada bakılan PASI değeri reçete/raporda belirtilir.'});
CREATE (para_1872)-[:HAS_ITEM {order: 2}]->(item_1875);
CREATE (item_1874)-[:NEXT_ITEM]->(item_1875);
CREATE (item_1876:Item {id: 'ç', content: '28. haftada yapılan değerlendirmede başlangıç PASI değerine göre PASI 75 yanıtının sağlanması halinde, bu durumun sağlık kurulu raporunda/reçetede belirtilmesi koşulu ile tedaviye devam edilir.'});
CREATE (para_1872)-[:HAS_ITEM {order: 3}]->(item_1876);
CREATE (item_1875)-[:NEXT_ITEM]->(item_1876);
CREATE (item_1877:Item {id: 'd', content: 'Tedaviye başlandıktan 1 yıl sonra yeni düzenlenecek raporda yukarıdaki kriterlerle, hastanın tedaviden fayda gördüğünün belirtilmesi koşulu ile tedaviye devam edilir. (Ek:RG-21/03/2018-30367/16-c md. Yürürlük: 01/04/2018)'});
CREATE (para_1872)-[:HAS_ITEM {order: 4}]->(item_1877);
CREATE (item_1876)-[:NEXT_ITEM]->(item_1877);
CREATE (para_1878:Paragraph {id: '2', content: 'En az 3 farklı hastalık modifiye edici antiromatizmal ilacı üçer ay süre ile uygun dozda kullanmış ve sonrasında en az bir anti-TNF ajanı 3 ay süreyle kullanmış olmasına rağmen hastalık aktivitesinin kontrol altına alınamadığı (bir ay arayla yapılmış iki ayrı muayenede en az üç hassas eklem ve en az üç şiş eklem olması) aktif psöriatik artritli yetişkin hastaların tedavisine en fazla 3 ay süreli sağlık kurulu raporuna dayanılarak tedaviye başlanır.'});
CREATE (sec_1871)-[:HAS_PARAGRAPH {order: 1}]->(para_1878);
CREATE (item_1879:Item {id: 'a', content: 'Tedaviye başlandıktan 3 ay sonra yapılan değerlendirmede yeterli cevap alınması halinde (psöriyatik artrit yanıt kriterlerine (PSARC) göre yanıt alınması), bu durumun belirtildiği 6 ay süreli yeni düzenlenecek sağlık kurulu raporu ile tedaviye devam edilir. Yanıt alınamaması halinde tedavi sonlandırılır.'});
CREATE (para_1878)-[:HAS_ITEM {order: 0}]->(item_1879);
CREATE (item_1880:Item {id: 'b', content: 'Bu durumların belirtildiği romatoloji (Ek:RG-16/03/2023-32134/20-c md. Yürürlük:24/03/2023) veya fizik tedavi ve rehabilitasyon uzman hekiminin yer aldığı en fazla 6 ay süreli sağlık kurulu raporuna dayanılarak, romatoloji (Ek:RG-16/03/2023-32134/20-c md. Yürürlük:24/03/2023) veya fizik tedavi ve rehabilitasyon uzman hekimleri tarafından reçete edilmesi halinde bedeli Kurumca karşılanır. (Ek:RG-26/10/2021-31640/1-c md. Yürürlük: 04/11/2021)'});
CREATE (para_1878)-[:HAS_ITEM {order: 1}]->(item_1880);
CREATE (item_1879)-[:NEXT_ITEM]->(item_1880);
CREATE (para_1872)-[:NEXT_PARAGRAPH]->(para_1878);
CREATE (para_1881:Paragraph {id: '3', content: 'Yetişkinlerde; fistülize, şiddetli veya aktif luminal Crohn hastalığında; en az bir anti-TNF ajanı 3 ay süreyle kullanmış olmasına rağmen hastalık aktivitesinin kontrol altına alınamadığı hastalarda bu durumun ve ilacın günlük kullanım dozu ve kullanım süresinin belirtildiği 4 ay süreli sağlık kurulu raporuna dayanılarak tedaviye başlanır. Tedavinin 4 üncü ayında tedaviye cevap alınamaması (Crohn Hastalık Aktivite İndeksi’nde başlangıca göre en az 70 puanlık düşüşün olmaması) durumunda tedavi kesilir. Crohn Hastalık Aktivite İndeksi’nde başlangıca göre en az 70 puan ve üzerinde düşüş olması halinde, bu durum ile ilacın kullanılacak dozu ve süresinin belirtildiği 6 ay süreli sağlık kurulu raporuna dayanılarak tedaviye devam edilebilir. Sağlık kurulu raporlarında en az bir gastroenteroloji veya genel cerrahi uzman hekiminin yer alması ve reçetelerin gastroenteroloji, iç hastalıkları veya genel cerrahi uzman hekimlerince düzenlenmesi halinde bedelleri Kurumca karşılanır.'});

// Batch 51
CREATE (sec_1871)-[:HAS_PARAGRAPH {order: 2}]->(para_1881);
CREATE (para_1878)-[:NEXT_PARAGRAPH]->(para_1881);
CREATE (para_1882:Paragraph {id: '4', content: 'Ülseratif kolit hastalığında; en az bir  biyolojik ajan tedavisine rağmen hastalığı kontrol edilemeyen hastalarda şiddetli aktif ülseratif kolit bulgularının devam etmesi halinde, üçüncü basamak sağlık  hizmeti sunucularında bu durumun belirtildiği 4 ay süreli en az biri gastroenteroloji veya genel cerrahi uzmanı hekimi olmak üzere sağlık kurulu raporuna istinaden tedaviye başlanır. Yanıt alınması halinde bu durumun belirtildiği yine bu hekimlerce düzenlenecek 6 ay süreli sağlık kurulu raporuyla tedaviye devam edilir. Sağlık kurulu raporuna dayanılarak, bu uzman hekimler ve iç hastalıkları uzman hekimlerince reçete düzenlenmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_1871)-[:HAS_PARAGRAPH {order: 3}]->(para_1882);
CREATE (para_1881)-[:NEXT_PARAGRAPH]->(para_1882);
CREATE (amend_1883:Amendment {content: '(Değişik: RG-02/11/2024-32710/5 md. Yürürlük:09/11/2024)'});
CREATE (sec_1871)-[:HAS_AMENDMENT {order: 0}]->(amend_1883);
CREATE (amend_1884:Amendment {content: '(Değişik: RG-02/11/2024-32710/5 md. Yürürlük: 09/11/2024)'});
CREATE (sec_1871)-[:HAS_AMENDMENT {order: 1}]->(amend_1884);

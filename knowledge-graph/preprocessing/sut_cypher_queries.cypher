CREATE (sec_1221)-[:HAS_SUBSECTION {order: 29}]->(sec_1596);
CREATE (para_1597:Paragraph {id: '1', content: 'Kendinden Sütursuz Transosseöz Sistemi, işlem başına en fazla 1 (bir) adet kullanıldığında bedeli Kurumca karşılanır.'});
CREATE (sec_1596)-[:HAS_PARAGRAPH {order: 0}]->(para_1597);
CREATE (para_1598:Paragraph {id: '2', content: 'Transosseöz Sistemi Sütür Taşıyıcı, işlem başına en fazla 1 (bir) adet kullanıldığında bedeli Kurumca karşılanır.'});
CREATE (sec_1596)-[:HAS_PARAGRAPH {order: 1}]->(para_1598);

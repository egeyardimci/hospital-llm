CREATE (sec_1989:Subsection {id: '4.2.1.C-9', title: 'Sekukinumab'});
CREATE (sec_1809)-[:HAS_SUBSECTION {order: 8}]->(sec_1989);
CREATE (para_1990:Paragraph {id: '1', content: 'Aktif ankilozan spondilitli erişkin hastalarda;'});
CREATE (sec_1989)-[:HAS_PARAGRAPH {order: 0}]->(para_1990);
CREATE (item_1991:Item {id: 'a', content: 'Biri maksimum doz indometazin olmak üzere en az 3 farklı nonsteroid antiinflamatuar ilacın maksimum dozunda kullanılmasına rağmen yeterli cevap alınamayan (Bath Ankilozan Spondilit Hastalık Aktivite İndeksi (BASDAİ) >5) ve bununla birlikte; bulgularından en az birinin olduğu hastalarda bu durumların sağlık kurulu raporunda belirtilerek tedaviye başlanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1990)-[:HAS_ITEM {order: 0}]->(item_1991);
CREATE (subitem_1992:SubItem {id: '1', content: 'Eritrosit sedimentasyon hızı >28 mm/s,'});
CREATE (item_1991)-[:HAS_SUBITEM {order: 0}]->(subitem_1992);
CREATE (subitem_1993:SubItem {id: '2', content: 'Normalin üst sınırını aşan CRP değeri,'});
CREATE (item_1991)-[:HAS_SUBITEM {order: 1}]->(subitem_1993);
CREATE (subitem_1992)-[:NEXT_SUBITEM]->(subitem_1993);

// Batch 54
CREATE (subitem_1994:SubItem {id: '3', content: 'MR/sintigrafi ile gösterilmiş aktif sakroileit/spondilit'});
CREATE (item_1991)-[:HAS_SUBITEM {order: 2}]->(subitem_1994);
CREATE (subitem_1993)-[:NEXT_SUBITEM]->(subitem_1994);
CREATE (item_1995:Item {id: 'b', content: '16 haftalık ilaç kullanım süresi sonunda BASDAİ’de en az 2 birim düzelme olduğunun yeni düzenlenecek reçete/raporda belirtilmesi halinde tedaviye devam edilir. BASDAİ’de 2 birimden daha az düzelme olması tedaviye yanıtsızlık olarak değerlendirilerek ilaç kullanımı sonlandırılır.'});
CREATE (para_1990)-[:HAS_ITEM {order: 1}]->(item_1995);
CREATE (item_1991)-[:NEXT_ITEM]->(item_1995);
CREATE (item_1996:Item {id: 'c', content: 'Tüm romatoloji uzman hekimleri veya üniversite hastaneleri ile eğitim ve araştırma hastanelerindeki klinik immunoloji veya fiziksel tıp ve rehabilitasyon uzman hekimlerinden birinin yer aldığı 6’şar ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimlerce veya iç hastalıkları uzman hekimleri tarafından reçete edilmesi halinde bedelleri Kurumca karşılanır. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum her yeni düzenlenecek raporda belirtilmelidir. Tedaviye 6 ay ve daha uzun süre ara veren hastalarda başlangıç kriterleri yeniden aranır.'});
CREATE (para_1990)-[:HAS_ITEM {order: 2}]->(item_1996);
CREATE (item_1995)-[:NEXT_ITEM]->(item_1996);
CREATE (para_1997:Paragraph {id: '2', content: 'Orta veya şiddetli plak psöriazisli erişkin hastalarda;'});
CREATE (sec_1989)-[:HAS_PARAGRAPH {order: 1}]->(para_1997);
CREATE (item_1998:Item {id: 'a', content: 'Siklosporin, methotreksat veya PUVA gibi geleneksel sistemik tedavilere yanıt vermeyen veya bu tedavileri tolere edemeyen ya da bu tür tedavilerin kontrendike olduğu hastalarda bu durumlar ile Psöriyazis Alan Şiddet İndeksi (PASI) değeri sağlık kurulu raporunda belirtilerek tedaviye başlanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1997)-[:HAS_ITEM {order: 0}]->(item_1998);
CREATE (item_1999:Item {id: 'b', content: '16 haftalık ilaç kullanım süresi sonunda başlangıç PASI değerine göre en az %75 iyileşme olduğunun yeni düzenlenecek reçete/raporda belirtilmesi halinde tedaviye devam edilir. Başlangıç PASI değerine göre %75 iyileşme sağlanamaması tedaviye yanıtsızlık olarak değerlendirilerek ilaç kullanımı sonlandırılır.'});
CREATE (para_1997)-[:HAS_ITEM {order: 1}]->(item_1999);
CREATE (item_1998)-[:NEXT_ITEM]->(item_1999);
CREATE (item_2000:Item {id: 'c', content: 'Üniversite hastaneleri veya eğitim ve araştırma hastanelerinde dermatoloji uzman hekiminin yer aldığı 6’şar ay süreli sağlık kurulu raporuna dayanılarak dermatoloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. Raporda PASI değeri belirtilir. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durum her yeni düzenlenecek raporda belirtilmelidir.'});
CREATE (para_1997)-[:HAS_ITEM {order: 2}]->(item_2000);
CREATE (item_1999)-[:NEXT_ITEM]->(item_2000);
CREATE (para_1990)-[:NEXT_PARAGRAPH]->(para_1997);
CREATE (para_2001:Paragraph {id: '3', content: 'Aktif psöriatik artritli erişkin hastalarda;'});
CREATE (sec_1989)-[:HAS_PARAGRAPH {order: 2}]->(para_2001);
CREATE (item_2002:Item {id: 'a', content: 'En az 3 farklı hastalık modifiye edici antiromatizmal ilacı 3’er ay süre ile uygun dozda kullanmış ve sonrasında en az bir anti-TNF ajanı 3 ay süreyle kullanmış olmasına rağmen hastalık aktivitesinin kontrol altına alınamadığı (bir ay arayla yapılmış iki ayrı muayenede en az üç hassas eklem ve en az üç şiş eklem olması) aktif psöriatik artritli hastalarda bu durumların sağlık kurulu raporunda belirtilerek tedaviye başlanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_2001)-[:HAS_ITEM {order: 0}]->(item_2002);
CREATE (item_2003:Item {id: 'b', content: '16 haftalık ilaç kullanım süresi sonunda yapılan değerlendirmede psöriatik artrit yanıt kriterlerine (PSARC) göre yeterli cevap alındığının yeni düzenlenecek reçete/raporda belirtilmesi halinde tedaviye devam edilir. Yanıt alınamaması halinde tedavi sonlandırılır.'});
CREATE (para_2001)-[:HAS_ITEM {order: 1}]->(item_2003);
CREATE (item_2002)-[:NEXT_ITEM]->(item_2003);
CREATE (item_2004:Item {id: 'c', content: 'Bu durumların belirtildiği romatoloji (Ek:RG-16/03/2023-32134/20-e md. Yürürlük:24/03/2023) veya fizik tedavi ve rehabilitasyon uzman hekiminin yer aldığı 6’şar ay süreli sağlık kurulu raporuna dayanılarak romatoloji (Ek:RG- 16/03/2023-32134/20-e md. Yürürlük:24/03/2023) veya fizik tedavi ve rehabilitasyon uzman hekimleri tarafından reçete edilmesi halinde bedelleri Kurumca karşılanır. (Ek: RG- 04/09/2019- 30878/ 15-c md. Yürürlük: 12/09/2019)'});
CREATE (para_2001)-[:HAS_ITEM {order: 2}]->(item_2004);
CREATE (item_2003)-[:NEXT_ITEM]->(item_2004);
CREATE (para_1997)-[:NEXT_PARAGRAPH]->(para_2001);

CREATE (sec_3402:Subsection {id: '4.2.39', title: 'Kseroderma Pigmentosum (Ek:RG-08/02/2022-31744/6-a md.Yürürlük:16/02/2022) ve Albinizm', content: '(okülokütanöz) tedavisinde güneşten koruyucu kremlerin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 38}]->(sec_3402);
CREATE (para_3403:Paragraph {id: '1', content: 'Kseroderma pigmentosum (Ek:RG-08/02/2022-31744/6-b md.Yürürlük:16/02/2022) ve albinizm (okülokütanöz) tedavisinde kullanılan güneşten koruyucu kremlerin bedelleri aylık  226,80 (iki yüz yirmi altı virgül seksen) TL’yi geçmemek kaydıyla sağlık kurulu raporu, reçete ve faturaya dayanılarak sağlık sosyal güvenlik merkezleri tarafından şahıs bazında ödenir.'});
CREATE (sec_3402)-[:HAS_PARAGRAPH {order: 0}]->(para_3403);
CREATE (para_3404:Paragraph {id: '2', content: 'Bu kremler, üçüncü basamak sağlık kurumlarında düzenlenen en az bir cilt hastalıkları uzman hekiminin bulunduğu sağlık kurulu raporuna dayanılarak, tüm sağlık kurum/kuruluşlarında cilt hastalıkları uzman hekimlerince en fazla üç aylık dozda reçete edilebilir.'});
CREATE (sec_3402)-[:HAS_PARAGRAPH {order: 1}]->(para_3404);
CREATE (para_3403)-[:NEXT_PARAGRAPH]->(para_3404);
CREATE (para_3405:Paragraph {id: '3', content: 'Bu kremler, UVA ve UVB ışınlarının her ikisini de etkin şekilde bloke eden, SPF en az 30 olan, fiziksel (çinko oksit veya titanyum dioksit içeren) ve/veya kombine filtre içeren özelliklerde olmalıdır.'});
CREATE (sec_3402)-[:HAS_PARAGRAPH {order: 2}]->(para_3405);
CREATE (para_3404)-[:NEXT_PARAGRAPH]->(para_3405);
CREATE (amend_3406:Amendment {content: '(Değişik: RG- 05/08/2024- 32623/8 md. \nYürürlük: 13/08/2024)'});
CREATE (sec_3402)-[:HAS_AMENDMENT {order: 0}]->(amend_3406);
CREATE (sec_3382)-[:NEXT_SUBSECTION]->(sec_3402);
CREATE (sec_3407:Subsection {id: '4.2.40', title: 'Huzursuz bacak sendromunda ilaç kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 39}]->(sec_3407);
CREATE (para_3408:Paragraph {id: '1', content: 'Pramipeksol hidroklorür ve ropinirol etken maddelerini içeren ilaçlar; nöroloji  , geriatri veya psikiyatri uzman hekimi tarafından veya bu uzman hekimin düzenlediği uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilir.'});
CREATE (sec_3407)-[:HAS_PARAGRAPH {order: 0}]->(para_3408);
CREATE (amend_3409:Amendment {content: '(Ek: RG- 07/10/2016-29850/ 40 \nmd. Yürürlük: 15/10/2016)'});
CREATE (sec_3407)-[:HAS_AMENDMENT {order: 0}]->(amend_3409);
CREATE (sec_3402)-[:NEXT_SUBSECTION]->(sec_3407);
CREATE (sec_3410:Subsection {id: '4.2.41', title: 'Parenteral demir preparatları kullanım ilkeleri:'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 40}]->(sec_3410);
CREATE (para_3411:Paragraph {id: '1', content: 'Parenteral demir preparatları aşağıda yer alan durumlarda görülen demir eksikliğinin tedavisinde bu durumların belirtildiği  6 ay süreli kardiyoloji, kadın hastalıkları ve doğum, genel cerrahi, iç hastalıkları, çocuk sağlığı ve hastalıkları uzmanlarınca düzenlenen rapora istinaden bu hekimler tarafından reçete edilir.'});
CREATE (sec_3410)-[:HAS_PARAGRAPH {order: 0}]->(para_3411);
CREATE (item_3412:Item {id: 'a', content: 'İntestinal malabsorbsiyon sendromları'});
CREATE (para_3411)-[:HAS_ITEM {order: 0}]->(item_3412);
CREATE (item_3413:Item {id: 'b', content: 'Kronik inflamatuvar bağırsak hastalıkları'});
CREATE (para_3411)-[:HAS_ITEM {order: 1}]->(item_3413);
CREATE (item_3412)-[:NEXT_ITEM]->(item_3413);
CREATE (item_3414:Item {id: 'c', content: 'Aktif GIS kanaması olan hastalar'});
CREATE (para_3411)-[:HAS_ITEM {order: 2}]->(item_3414);
CREATE (item_3413)-[:NEXT_ITEM]->(item_3414);
CREATE (item_3415:Item {id: 'ç', content: 'Hemodiyaliz hastaları'});
CREATE (para_3411)-[:HAS_ITEM {order: 3}]->(item_3415);
CREATE (item_3414)-[:NEXT_ITEM]->(item_3415);
CREATE (item_3416:Item {id: 'd', content: 'Total ve subtotal gastrektomili hastalar'});
CREATE (para_3411)-[:HAS_ITEM {order: 4}]->(item_3416);
CREATE (item_3415)-[:NEXT_ITEM]->(item_3416);
CREATE (item_3417:Item {id: 'e', content: 'Atrofik gastritli hastalar'});
CREATE (para_3411)-[:HAS_ITEM {order: 5}]->(item_3417);
CREATE (item_3416)-[:NEXT_ITEM]->(item_3417);
CREATE (item_3418:Item {id: 'f', content: 'Oral demir alımını tolere edemeyen hamileler'});
CREATE (para_3411)-[:HAS_ITEM {order: 6}]->(item_3418);

// Batch 92
CREATE (item_3417)-[:NEXT_ITEM]->(item_3418);
CREATE (item_3419:Item {id: 'g', content: 'Demir eksikliği anemisi bulunan (saturasyon <%20 ve/veya ferritin <100 mcg/l) evre III, IV, V kronik böbrek hastaları'});
CREATE (para_3411)-[:HAS_ITEM {order: 7}]->(item_3419);
CREATE (item_3418)-[:NEXT_ITEM]->(item_3419);
CREATE (item_3420:Item {id: 'ğ', content: 'Periton diyaliz hastalarının anemisi'});
CREATE (para_3411)-[:HAS_ITEM {order: 8}]->(item_3420);
CREATE (item_3419)-[:NEXT_ITEM]->(item_3420);
CREATE (item_3421:Item {id: 'h', content: 'Postpartum dönemde gözlenen anemi,'});
CREATE (para_3411)-[:HAS_ITEM {order: 9}]->(item_3421);
CREATE (item_3420)-[:NEXT_ITEM]->(item_3421);
CREATE (item_3422:Item {id: 'ı', content: 'Cerrahi öncesi ve sonrası gözlenen anemi,'});
CREATE (para_3411)-[:HAS_ITEM {order: 10}]->(item_3422);
CREATE (item_3421)-[:NEXT_ITEM]->(item_3422);
CREATE (item_3423:Item {id: 'i', content: 'Kansere bağlı anemi,'});
CREATE (para_3411)-[:HAS_ITEM {order: 11}]->(item_3423);
CREATE (item_3422)-[:NEXT_ITEM]->(item_3423);
CREATE (item_3424:Item {id: 'j', content: 'KKY hastalarının anemisi,'});
CREATE (para_3411)-[:HAS_ITEM {order: 12}]->(item_3424);
CREATE (item_3423)-[:NEXT_ITEM]->(item_3424);
CREATE (item_3425:Item {id: 'k', content: 'Prediyaliz [hemodiyaliz ve periton diyaliz öncesi son dönem (evre V) KBY hastaları] hastalarının anemisi.'});
CREATE (para_3411)-[:HAS_ITEM {order: 13}]->(item_3425);
CREATE (item_3424)-[:NEXT_ITEM]->(item_3425);
CREATE (amend_3426:Amendment {content: '(Ek:RG-02/11/2024-32710/23 \nmd.Yürürlük:09/11/2024)'});
CREATE (sec_3410)-[:HAS_AMENDMENT {order: 0}]->(amend_3426);
CREATE (amend_3427:Amendment {content: '(Değişik:RG- 09/05/2024- \n32541/18 md. Yürürlük:17/05/2024)'});
CREATE (sec_3410)-[:HAS_AMENDMENT {order: 1}]->(amend_3427);
CREATE (sec_3407)-[:NEXT_SUBSECTION]->(sec_3410);
CREATE (sec_3428:Subsection {id: '4.2.42', title: 'İnvitro fertilizasyon (IVF), ovulasyon indüksiyonu (OI) ve intrauterin inseminasyonu (IUI) işlemlerinde ilaç', content: 'kullanım ilkeleri:'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 41}]->(sec_3428);
CREATE (sec_3429:Subsection {id: '4.2.42.A', title: 'OI ve/veya IUI İşlemi'});
CREATE (sec_3428)-[:HAS_SUBSECTION {order: 0}]->(sec_3429);
CREATE (para_3430:Paragraph {id: '1', content: 'Evli olmakla birlikte evlat edinilmiş çocukları hariç çocuk sahibi olmayan genel sağlık sigortalısı kadın ise kendisine, erkek ise bakmakla yükümlü olduğu karısına uygulanan “OI ve/veya IUI” tedavilerine ilişkin giderlerin Kurumca ödenebilmesi için;'});
CREATE (sec_3429)-[:HAS_PARAGRAPH {order: 0}]->(para_3430);
CREATE (item_3431:Item {id: 'a', content: 'Kadın hastalıkları ve doğum uzman hekiminin yer aldığı sağlık kurulu raporu düzenlenmiş olması,'});
CREATE (para_3430)-[:HAS_ITEM {order: 0}]->(item_3431);
CREATE (item_3432:Item {id: 'b', content: 'Uygulamanın yapıldığı merkezin Kurum ile sözleşmeli olması, 138 şartlarının birlikte sağlanmış olması gerekmektedir.'});
CREATE (para_3430)-[:HAS_ITEM {order: 1}]->(item_3432);
CREATE (item_3431)-[:NEXT_ITEM]->(item_3432);
CREATE (para_3433:Paragraph {id: '2', content: 'Sağlık kurulu raporlarında, hasta yaşı, kimlik bilgileri, tanı, endikasyon, uygulanacak tedavi, kaçıncı deneme olduğu, kullanılacak ilaçların günlük ve maksimum dozları da belirtilecektir.'});
CREATE (sec_3429)-[:HAS_PARAGRAPH {order: 1}]->(para_3433);
CREATE (para_3430)-[:NEXT_PARAGRAPH]->(para_3433);
CREATE (para_3434:Paragraph {id: '3', content: 'Sağlık kurulu raporunun düzenlendiği tarihten itibaren 6 ay içinde tedaviye başlanmaması halinde yeniden sağlık kurulu raporu düzenlenmesi gereklidir.'});
CREATE (sec_3429)-[:HAS_PARAGRAPH {order: 2}]->(para_3434);
CREATE (para_3433)-[:NEXT_PARAGRAPH]->(para_3434);
CREATE (para_3435:Paragraph {id: '4', content: 'Birinci uygulamadan sonraki “OI ve/veya IUI” tedavisi için de yeniden sağlık kurulu raporu düzenlenmesi gereklidir.'});
CREATE (sec_3429)-[:HAS_PARAGRAPH {order: 3}]->(para_3435);
CREATE (para_3434)-[:NEXT_PARAGRAPH]->(para_3435);
CREATE (para_3436:Paragraph {id: '5', content: 'İlaçlar, düzenlenen rapora istinaden tedavinin yapıldığı sağlık hizmeti sunucusu kadın hastalıkları uzman hekimlerince reçete edilecektir.'});
CREATE (sec_3429)-[:HAS_PARAGRAPH {order: 4}]->(para_3436);
CREATE (para_3435)-[:NEXT_PARAGRAPH]->(para_3436);
CREATE (para_3437:Paragraph {id: '6', content: 'İlaçların kullanım dozları aşağıda belirtilmiştir.'});
CREATE (sec_3429)-[:HAS_PARAGRAPH {order: 5}]->(para_3437);
CREATE (item_3438:Item {id: 'a', content: 'Standart hasta grubunda (açıklanamayan infertilite veya erkek infertilitesi veya endometriyozis olgularında) uygulama (siklus) başına toplam 1000 IU, toplam 3 siklus (3000 IU) gonadotropin ödenir.'});
CREATE (para_3437)-[:HAS_ITEM {order: 0}]->(item_3438);
CREATE (item_3439:Item {id: 'b', content: 'Kadın infertilitesinde anovulasyonla birlikte seyreden aşağıdaki durumlar, OI ve/veya IUI işleminde istisnai haller olarak kabul edilir: sağlanamayan veya gebelik elde edilemeyen) hastalarda toplam 6 uygulama, toplam 10000 IU gonadotropin ödenir. IU gonadotropin (FSH + LH veya HMG) ödenir.'});
CREATE (para_3437)-[:HAS_ITEM {order: 1}]->(item_3439);
CREATE (subitem_3440:SubItem {id: '1', content: 'Polikistik Over Sendromu (PCOS); en az 3, en fazla 6 siklus klomifen sitrat tedavisine yanıt alınamayan (ovulasyon'});
CREATE (item_3439)-[:HAS_SUBITEM {order: 0}]->(subitem_3440);
CREATE (subitem_3441:SubItem {id: '2', content: 'Hipogonadotropik hipogonadizm; hastalarda OI ve/veya IUI işlemi için en az 3 en fazla 6 uygulama, toplam 10000'});
CREATE (item_3439)-[:HAS_SUBITEM {order: 1}]->(subitem_3441);
CREATE (subitem_3440)-[:NEXT_SUBITEM]->(subitem_3441);
CREATE (item_3438)-[:NEXT_ITEM]->(item_3439);
CREATE (para_3436)-[:NEXT_PARAGRAPH]->(para_3437);
CREATE (amend_3442:Amendment {content: '(Değişik: RG- 25/07/2014- 29071/ 39 md. Yürürlük: 25/07/2014)'});
CREATE (sec_3429)-[:HAS_AMENDMENT {order: 0}]->(amend_3442);
CREATE (amend_3443:Amendment {content: '(Değişik: RG- 25/08/2022- 31934/ 36 md. Yürürlük: 03/09/2022)'});
CREATE (sec_3429)-[:HAS_AMENDMENT {order: 1}]->(amend_3443);
CREATE (sec_3444:Subsection {id: '4.2.42.B', title: 'IVF İşlemi'});
CREATE (sec_3428)-[:HAS_SUBSECTION {order: 1}]->(sec_3444);
CREATE (para_3445:Paragraph {id: '1', content: 'IVF işleminde; SUT’un 2.4.4.İ.1 maddesine uygun olan hastalarda ilaç kullanım esasları aşağıda belirtilmiştir.'});
CREATE (sec_3444)-[:HAS_PARAGRAPH {order: 0}]->(para_3445);
CREATE (item_3446:Item {id: 'a', content: 'SUT’un 2.4.4.İ.1.2 maddesinde belirtilen IVF tedavisi kurallarına göre düzenlenmiş raporlarda ayrıca hastanın kullanacağı ilaç ile ilgili aşağıda belirtilen durumlar hakkındaki bilgiler de yer alacaktır: fazla 3 uygulama  siklus başı 3000 IU ye kadar , toplam 9000 IU gonadotropin ödenir. Bu grup hastalarda IVF tedavisi öncesi IUI işlemi yapılmış olması şartı aranır.  SUT’un “2.4.4.İ-1-2-IVF sağlık kurulu raporu” maddesinde IUI işlemi aranmayacak hastalar belirtilmiştir. grup hastalarda IVF tedavisi öncesi  OI+IUI işlemi yapılmış olması şartı aranmaz.'});
CREATE (para_3445)-[:HAS_ITEM {order: 0}]->(item_3446);
CREATE (subitem_3447:SubItem {id: '1', content: 'Normal ovaryan yanıtlı hasta grubunda  en'});
CREATE (item_3446)-[:HAS_SUBITEM {order: 0}]->(subitem_3447);
CREATE (subitem_3448:SubItem {id: '2', content: 'Kötü ovaryan yanıtlı veya düşük ovaryan rezervli hasta grubunda;  en fazla 3 uygulama, siklus başı 4500 IU ye kadar toplam 13500 IU gonadotropin ödenir. Ayrıca bu'});
CREATE (item_3446)-[:HAS_SUBITEM {order: 1}]->(subitem_3448);
CREATE (subitem_3447)-[:NEXT_SUBITEM]->(subitem_3448);
CREATE (item_3449:Item {id: 'b', content: 'IVF tedavisi için düzenlenen sağlık kurulu raporunda belirtilen ilaçlar, tedavinin yapıldığı üremeye yardımcı tedavi merkezi kadın hastalıkları ve doğum uzman hekimlerince reçete edilecektir.'});
CREATE (para_3445)-[:HAS_ITEM {order: 1}]->(item_3449);
CREATE (item_3446)-[:NEXT_ITEM]->(item_3449);
CREATE (amend_3450:Amendment {content: '(Değişik: RG- 01/10/2014- 29136/ 11 md. Yürürlük: 01/10/2014)'});
CREATE (sec_3444)-[:HAS_AMENDMENT {order: 0}]->(amend_3450);
CREATE (amend_3451:Amendment {content: '(Ek: RG- 18/06/2016- 29746/ 23 md. Yürürlük: 25/06/2016)'});
CREATE (sec_3444)-[:HAS_AMENDMENT {order: 1}]->(amend_3451);
CREATE (amend_3452:Amendment {content: '(Ek: RG- 25/07/2014- \n29071/ 40 md. Yürürlük: 07/08/2014)'});
CREATE (sec_3444)-[:HAS_AMENDMENT {order: 2}]->(amend_3452);
CREATE (amend_3453:Amendment {content: '(Değişik: RG- 01/10/2014- 29136/ 11 md. \nYürürlük: 01/10/2014)'});
CREATE (sec_3444)-[:HAS_AMENDMENT {order: 3}]->(amend_3453);
CREATE (amend_3454:Amendment {content: '(Değişik: RG-18/06/2016- 29746/ 23 md. Yürürlük: 25/06/2016)'});
CREATE (sec_3444)-[:HAS_AMENDMENT {order: 4}]->(amend_3454);
CREATE (sec_3429)-[:NEXT_SUBSECTION]->(sec_3444);
CREATE (sec_3455:Subsection {id: '4.2.42.C', title: 'Kök hücre vericisi kardeş doğmasına yönelik IVF tedavisinde kullanılacak ilaçlar'});
CREATE (sec_3428)-[:HAS_SUBSECTION {order: 2}]->(sec_3455);
CREATE (para_3456:Paragraph {id: '1', content: 'Kök hücre vericisi kardeş doğmasına yönelik IVF tedavisinde kullanılacak ilaçlar; SUT’un 2.4.4.İ.2 maddesi koşullarına uyan ve söz konusu maddede belirtilen sağlık kurulu raporuna istinaden IVF tedavisinin yapıldığı üremeye yardımcı tedavi merkezinde kadın hastalıkları ve doğum uzman hekimlerince reçeteye yazılabilecektir. Her bir IVF denemesine ilişkin olarak kullanılacak gonadotropin dozu en fazla 3000 IU olacak ve raporda belirtilecektir.'});
CREATE (sec_3455)-[:HAS_PARAGRAPH {order: 0}]->(para_3456);
CREATE (sec_3444)-[:NEXT_SUBSECTION]->(sec_3455);
CREATE (sec_3457:Subsection {id: '4.2.42.Ç', title: 'IVF, OI ve IUI İşlemleri'});
CREATE (sec_3428)-[:HAS_SUBSECTION {order: 3}]->(sec_3457);
CREATE (para_3458:Paragraph {id: '1', content: 'IVF, OI ve IUI işlemlerinde; ovülasyon tetiklemesi için kullanılan hCG (human korionik gonadotropin) maksimum dozun dışında olup 10000 üniteyi geçemez. IVF, OI ve IUI işlemlerinde kullanılan ilaçlar katılım payından muaf değildir. (Ek: RG- 11/08/2021- 31565 / 7 md. Yürürlük: 11/08/2021)'});

// Batch 93
CREATE (sec_3457)-[:HAS_PARAGRAPH {order: 0}]->(para_3458);
CREATE (sec_3455)-[:NEXT_SUBSECTION]->(sec_3457);
CREATE (sec_3459:Subsection {id: '4.2.42.D', title: 'Sağlam çocuk doğmasına yönelik Preimlantasyon Genetik Tanı (PGT) ile İnvitro Fertilizasyon (IVF)', content: 'tedavisinde kullanılacak ilaçlar'});
CREATE (sec_3428)-[:HAS_SUBSECTION {order: 4}]->(sec_3459);
CREATE (para_3460:Paragraph {id: '1', content: 'Sağlam çocuk doğmasına yönelik Preimlantasyon Genetik Tanı (PGT) ile İnvitro Fertilizasyon (IVF) tedavisinde kullanılacak ilaçlar; SUT’un 2.4.4.İ-3 maddesi koşullarına uyan ve söz konusu maddede belirtilen sağlık kurulu raporuna istinaden PGT ile İnvitro Fertilizasyon (IVF) tedavisinin yapıldığı üremeye yardımcı tedavi merkezinde kadın hastalıkları ve doğum uzman hekimlerince reçete edilebilecektir. Her bir IVF denemesine ilişkin olarak kullanılacak gonadotropin dozu en fazla 3000 IU olacak ve raporda belirtilecektir.'});
CREATE (sec_3459)-[:HAS_PARAGRAPH {order: 0}]->(para_3460);
CREATE (sec_3457)-[:NEXT_SUBSECTION]->(sec_3459);
CREATE (sec_3410)-[:NEXT_SUBSECTION]->(sec_3428);
CREATE (sec_3461:Subsection {id: '4.2.43', title: 'Dijital ülseri olan sistemik skleroz hastalarında ilaç kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 42}]->(sec_3461);
CREATE (para_3462:Paragraph {id: '1', content: 'İloprost (intravenöz formları), sistemik skleroz (dijital ülser dahil) endikasyonunda, romatoloji veya klinik immünoloji uzman hekimlerince düzenlenen uzman hekim raporuna istinaden bu uzman hekimlerce reçetelenir.'});
CREATE (sec_3461)-[:HAS_PARAGRAPH {order: 0}]->(para_3462);
CREATE (para_3463:Paragraph {id: '2', content: 'Bosentan, sistemik skleroza bağlı dijital ülserli hastalarda;'});
CREATE (sec_3461)-[:HAS_PARAGRAPH {order: 1}]->(para_3463);
CREATE (item_3464:Item {id: 'a', content: 'Kalsiyum kanal blokerleri ve intravenöz iloprost ile en az 3 ay süreyle tedavi görmüş ve yanıt alınamamış ve en az biri 2 mm’den fazla çapı ve görünebilir derinliği olan ağrılı kardinal ülser olmak üzere multiple (≥4 adet) dijital ülseri olan hastalarda tedaviye başlanır.'});
CREATE (para_3463)-[:HAS_ITEM {order: 0}]->(item_3464);
CREATE (item_3465:Item {id: 'b', content: 'Bu hususların belirtildiği, üçüncü basamak sağlık kurumlarında en az bir romatoloji uzman hekiminin bulunduğu 6 ay süreli sağlık kurulu raporuna dayanılarak yine bu sağlık kurumlarında romatoloji uzman hekimlerince reçetelenir.'});
CREATE (para_3463)-[:HAS_ITEM {order: 1}]->(item_3465);
CREATE (item_3464)-[:NEXT_ITEM]->(item_3465);
CREATE (para_3462)-[:NEXT_PARAGRAPH]->(para_3463);
CREATE (amend_3466:Amendment {content: '(Mülga: RG-16/06/2020-31157/21 md. Yürürlük: 24/06/2020)'});
CREATE (sec_3461)-[:HAS_AMENDMENT {order: 0}]->(amend_3466);
CREATE (amend_3467:Amendment {content: '(Mülga: RG-12/12/2024-32750/9 md. Yürürlük: 20/12/2024)'});
CREATE (sec_3461)-[:HAS_AMENDMENT {order: 1}]->(amend_3467);
CREATE (amend_3468:Amendment {content: '(Ek: RG- 18/02/2015- 29271/ 18 md. Yürürlük: 28/02/2015)'});
CREATE (sec_3461)-[:HAS_AMENDMENT {order: 2}]->(amend_3468);

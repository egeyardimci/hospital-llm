CREATE (para_3497)-[:HAS_ITEM {order: 0}]->(item_3498);
CREATE (item_3499:Item {id: 'b', content: 'Tedavinin devamı için düzenlenen raporlarda ilaç başlama kriterleri aranmaz. Tedavinin devamı için FVC değerinde bir önceki sağlık kurulu raporu değerine göre (ataklar dışında) ≥%10 düşme olmadığı her raporda belirtilmelidir.'});

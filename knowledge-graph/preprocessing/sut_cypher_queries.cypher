CREATE (para_3621:Paragraph {id: '3', content: 'Lizinurik protein intoleransı  ve/veya Non-ketotik hiperglisinemi (glisin metabolizması bozuklukları/glisin ensefalopatisi) endikasyonunda,'});
CREATE (sec_3606)-[:HAS_PARAGRAPH {order: 2}]->(para_3621);
CREATE (para_3614)-[:NEXT_PARAGRAPH]->(para_3621);
CREATE (para_3622:Paragraph {id: '4', content: 'Yukarıdaki durumlardan herhangi birinin belirtildiği, üçüncü basamak  resmi sağlık hizmet sunucularında çocuk metabolizma uzman hekimi veya çocuk endokrinolojisi ve metabolizma hastalıkları uzman hekimlerinden biri tarafından düzenlenen 6 ay süreli uzman hekim raporuna dayanılarak bu uzman hekimlerce veya çocuk sağlığı ve hastalıkları uzman hekimlerince reçete edilmesi halinde, bedelleri Kurumca karşılanır.'});
CREATE (sec_3606)-[:HAS_PARAGRAPH {order: 3}]->(para_3622);

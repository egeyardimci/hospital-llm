CREATE (sec_2161:Subsection {id: '4.2.8', title: 'Enteral ve parenteral beslenme ürünleri verilme ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 7}]->(sec_2161);
CREATE (amend_2162:Amendment {content: '(Değişik: RG- 25/08/2022- 31934/ 22 md. Yürürlük: 03/09/2022)'});
CREATE (sec_2161)-[:HAS_AMENDMENT {order: 0}]->(amend_2162);
CREATE (sec_2163:Subsection {id: '4.2.8.A', title: 'Enteral beslenme ürünleri'});
CREATE (sec_2161)-[:HAS_SUBSECTION {order: 0}]->(sec_2163);
CREATE (para_2164:Paragraph {id: '1', content: 'Çocukluk yaş grubunda;'});
CREATE (sec_2163)-[:HAS_PARAGRAPH {order: 0}]->(para_2164);
CREATE (item_2165:Item {id: 'a', content: 'Malnütrisyon gelişmesi halinde enteral beslenme ürünleri verilir. Malnütrisyon tanımı; (VKİ) (< -2SD), olmasıdır. Malnütrisyon gelişmiş hastalarda bu durumların belirtildiği çocuk hastalıkları  ve çocuk cerrahi uzman hekimleri tarafından düzenlenen en fazla 6 ay süreli uzman hekim raporuna dayanılarak başlanır. Bu sürenin sonunda; yukarıda belirtilen malnütrisyon koşullarının devam etmesi durumunda çocuk gastroenteroloji, çocuk nöroloji, çocuk metabolizma , çocuk cerrahisi veya çocuk endokrinoloji ve metabolizma uzman hekimlerince düzenlenen en fazla 6 ay süreli rapora dayanılarak tüm hekimlerce reçete edilmesi halinde Kurumca bedelleri ödenir.'});
CREATE (para_2164)-[:HAS_ITEM {order: 0}]->(item_2165);
CREATE (subitem_2166:SubItem {id: '1', content: '5 yaş altı  çocuklar için yaşa göre ağırlık (< -2SD),'});
CREATE (item_2165)-[:HAS_SUBITEM {order: 0}]->(subitem_2166);
CREATE (subitem_2167:SubItem {id: '2', content: '5 yaş ve üstü çocuklar için vücut kütle indeksi'});
CREATE (item_2165)-[:HAS_SUBITEM {order: 1}]->(subitem_2167);
CREATE (subitem_2166)-[:NEXT_SUBITEM]->(subitem_2167);
CREATE (item_2168:Item {id: 'b', content: 'Yatan hastalarda, doğuştan metabolik hastalığı olanlarda, kanser hastalarında, kistikfibroziste, crohn hastalarında, yanık hastalarında veya orogastrik sonda/nazogastrik sonda/nazoenterik sonda veya gastrostomi/jejunostomi ile beslenen hastalarda yukarıda belirtilen malnütrisyon koşulları aranmaz. Yatan hastalar dışında bu durumların belirtildiği uzman hekimler tarafından düzenlenen 6 ay süreli sağlık kurulu raporuna dayanılarak tüm hekimlerce reçete edilmesi halinde Kurumca bedelleri ödenir.'});
CREATE (para_2164)-[:HAS_ITEM {order: 1}]->(item_2168);
CREATE (item_2165)-[:NEXT_ITEM]->(item_2168);
CREATE (item_2169:Item {id: 'c', content: 'Raporlarda, beslenme ürününün adı, günlük kalori ihtiyacı, hastanın vücut ağırlığı, boyu ve yaşa göre ağırlık SD veya VKİ değerlerine göre belirlenen günlük kullanım miktarı açıkça belirtilerek en fazla 30 günlük dozda reçete edilmesi halinde Kurumca bedelleri ödenir.'});
CREATE (para_2164)-[:HAS_ITEM {order: 2}]->(item_2169);
CREATE (item_2168)-[:NEXT_ITEM]->(item_2169);
CREATE (para_2170:Paragraph {id: '2', content: 'Yetişkin hastalarda;'});
CREATE (sec_2163)-[:HAS_PARAGRAPH {order: 1}]->(para_2170);
CREATE (item_2171:Item {id: 'a', content: 'Malnütrisyon gelişmesi halinde enteral beslenme ürünleri verilir. Malnütrisyon tanımı; üzerinde 22’ nin altında, 70 yaş altında ise 20’ nin altında ve bir azalma veya besin sindirimini/emilimini bozan herhangi bir gastrointestinal sistem hastalığı) olmasıdır. Diyetetik tedaviler ve/veya obezite cerrahisi sonucu oluşan kilo kayıpları malnütrisyon olarak değerlendirilmez. Bu durumların belirtildiği 3 ay süreli sağlık kurulu raporuna dayanılarak tüm hekimlerce günlük en fazla 1200 kcal dozda reçete edilmesi halinde Kurumca bedelleri ödenir.'});
CREATE (para_2170)-[:HAS_ITEM {order: 0}]->(item_2171);
CREATE (subitem_2172:SubItem {id: '1', content: 'Son 6 ayda %5 ten fazla 6 aydan daha uzun sürede ise %10 dan fazla istemsiz kilo kaybı veya VKİ 70 yaş ve'});
CREATE (item_2171)-[:HAS_SUBITEM {order: 0}]->(subitem_2172);
CREATE (subitem_2173:SubItem {id: '2', content: 'Malnütrisyona neden olan eşlik eden hastalık veya travma ve'});
CREATE (item_2171)-[:HAS_SUBITEM {order: 1}]->(subitem_2173);
CREATE (subitem_2172)-[:NEXT_SUBITEM]->(subitem_2173);
CREATE (subitem_2174:SubItem {id: '3', content: 'Besin alımında azalma (1 hafta süreyle enerji ihtiyacının %50’sinden az alım veya 2 hafta süreyle alımda herhangi'});
CREATE (item_2171)-[:HAS_SUBITEM {order: 2}]->(subitem_2174);
CREATE (subitem_2173)-[:NEXT_SUBITEM]->(subitem_2174);
CREATE (item_2175:Item {id: 'b', content: 'Yatan hastalar, kanser hastaları veya tüp ile beslenen hastalarda (orogastrik sonda/nazogastrik sonda/nazoenterik sonda veya gastrostomi/jejunostomi/gastrojejunostomi) yukarıdaki malnütrisyon koşulları aranmaz. Yatan hastalar dışında bu durumların belirtildiği 6 ay süreli sağlık kurulu raporuna dayanılarak tüm hekimlerce reçete edilmesi halinde Kurumca bedeli ödenir.'});
CREATE (para_2170)-[:HAS_ITEM {order: 1}]->(item_2175);
CREATE (item_2171)-[:NEXT_ITEM]->(item_2175);
CREATE (item_2176:Item {id: 'c', content: 'Raporlarda, beslenme ürününün adı, günlük kalori ihtiyacı ve buna göre belirlenen günlük kullanım miktarı, hastanın vücut ağırlığı, boyu ve varsa eşlik eden hastalığın ICD-10 kodu açıkça belirtilerek en fazla 30 günlük dozda reçete edilmelidir. 86'});
CREATE (para_2170)-[:HAS_ITEM {order: 2}]->(item_2176);
CREATE (item_2175)-[:NEXT_ITEM]->(item_2176);
CREATE (para_2164)-[:NEXT_PARAGRAPH]->(para_2170);
CREATE (para_2177:Paragraph {id: '3', content: 'Yoğunlaştırıcı-kıvam artırıcı beslenme ürünleri;'});
CREATE (sec_2163)-[:HAS_PARAGRAPH {order: 2}]->(para_2177);
CREATE (item_2178:Item {id: 'a', content: '1 yaş üzeri yutma/yutkunma bozukluğu olan çocuklarda, bu durumun belirtildiği çocuk gastroenteroloji, çocuk metabolizma, çocuk endokrinolojisi ve metabolizma hastalıkları ve çocuk yoğun bakım uzmanlarının en az birinin bulunduğu sağlık kurulu raporuna dayanılarak bu hekimler ve çocuk sağlığı ve hastalıkları uzman hekimlerince reçete edilebilir. Raporda, ürünün adı, günlük kullanım miktarı açıkça belirtilerek en fazla iki kutu yazılır.'});
CREATE (para_2177)-[:HAS_ITEM {order: 0}]->(item_2178);
CREATE (item_2179:Item {id: 'b', content: 'İnme, kronik nörolojik bozukluklar ve baş boyun kanserleri ve cerrahi rezeksiyonda görülen yutma güçlüğü çeken yetişkin hastalarda; bu durumun belirtildiği nöroloji, kulak burun boğaz, genel cerrahi, beyin cerrahi, anestezi ve yoğun bakım, geriatri, tıbbi onkoloji, radyasyon onkolojisi uzmanlarından en az birinin bulunduğu sağlık kurulu raporuna istinaden tüm uzman hekimlerce reçete edilebilir. Raporda, ürünün adı, günlük kullanım miktarı açıkça belirtilerek aylık en fazla iki kutu yazılır.'});
CREATE (para_2177)-[:HAS_ITEM {order: 1}]->(item_2179);
CREATE (item_2178)-[:NEXT_ITEM]->(item_2179);
CREATE (para_2170)-[:NEXT_PARAGRAPH]->(para_2177);
CREATE (para_2180:Paragraph {id: '4', content: 'Dallı zincirli aminoasitlerden zengin enteral beslenme ürünleri: Karaciğer yetmezliği olan orta ve ağır (evre 2 ve üzeri) ensefalopati gelişmiş hastalarda kullanılabilir. Malnütrisyon kriterleri aranmaz. Gastroenteroloji veya iç hastalıkları uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilebilir.'});
CREATE (sec_2163)-[:HAS_PARAGRAPH {order: 3}]->(para_2180);
CREATE (para_2177)-[:NEXT_PARAGRAPH]->(para_2180);
CREATE (amend_2181:Amendment {content: '(Değişik:RG- 19/10/2023-32344/5 md. Yürürlük:27/10/2023)'});
CREATE (sec_2163)-[:HAS_AMENDMENT {order: 0}]->(amend_2181);
CREATE (amend_2182:Amendment {content: '(Değişik:RG- 19/10/2023-32344/5 md. \nYürürlük:27/10/2023)'});
CREATE (sec_2163)-[:HAS_AMENDMENT {order: 1}]->(amend_2182);
CREATE (amend_2183:Amendment {content: '(Değişik:RG- 19/10/2023-32344/5 md. Yürürlük:27/10/2023)'});
CREATE (sec_2163)-[:HAS_AMENDMENT {order: 2}]->(amend_2183);

// Batch 59
CREATE (amend_2184:Amendment {content: '(Ek:RG- 09/05/2024-\n32541/8 md. Yürürlük: 17/05/2024)'});
CREATE (sec_2163)-[:HAS_AMENDMENT {order: 3}]->(amend_2184);
CREATE (amend_2185:Amendment {content: '(Ek:RG-16/03/2023-32134/22 \nmd. \nYürürlük:24/03/2023)'});
CREATE (sec_2163)-[:HAS_AMENDMENT {order: 4}]->(amend_2185);
CREATE (sec_2186:Subsection {id: '4.2.8.B', title: 'Parenteral beslenme ürünleri'});
CREATE (sec_2161)-[:HAS_SUBSECTION {order: 1}]->(sec_2186);
CREATE (para_2187:Paragraph {id: '1', content: 'Yatan hastalar dışında, oral ve tüple beslenemeyen hastalara, bu durumun sağlık kurulu raporunda belirtilmesi kaydıyla uzman hekim tarafından en fazla 30 günlük dozda reçete edilmesi halinde parenteral beslenme ürünlerinin bedeli ödenir.'});
CREATE (sec_2186)-[:HAS_PARAGRAPH {order: 0}]->(para_2187);
CREATE (sec_2163)-[:NEXT_SUBSECTION]->(sec_2186);
CREATE (sec_2152)-[:NEXT_SUBSECTION]->(sec_2161);
CREATE (sec_2188:Subsection {id: '4.2.9', title: 'Eritropoietin, darbepoetin, (Ek:RG-19/10/2023-32344/6-a md.Yürürlük:27/10/2023) roksadustat, sevelamer,', content: 'parikalsitol, (Ek:RG-28/04/2021-31468/11-a md. Yürürlük: 06/05/2021) cinacalcet, etelkalsetid, oral esansiyel aminoasit preperatları ve keto analogları kullanım ilkeleri (Değişik: RG- 19/10/2023- 32344/6-b md. Yürürlük: 27/10/2023)'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 8}]->(sec_2188);
CREATE (sec_2189:Subsection {id: '4.2.9.A', title: 'Eritropoietin, darbepoietin ve roksadustat kullanım ilkeleri'});
CREATE (sec_2188)-[:HAS_SUBSECTION {order: 0}]->(sec_2189);
CREATE (para_2190:Paragraph {id: '1', content: 'Eritropoietin ve darbepoietin preparatları kronik böbrek yetmezliği ile ilişkili anemi ve myelodisplastik sendrom dışındaki endikasyonlarda, roksadustat preparatları ise kronik böbrek yetmezliği ile ilişkili anemi dışındaki endikasyonlarda Kurumca karşılanmaz.'});
CREATE (sec_2189)-[:HAS_PARAGRAPH {order: 0}]->(para_2190);
CREATE (para_2191:Paragraph {id: '2', content: 'Tetkik sonuç belgesinin tarihi ve sonucu reçete veya raporda belirtilir.'});
CREATE (sec_2189)-[:HAS_PARAGRAPH {order: 1}]->(para_2191);
CREATE (para_2190)-[:NEXT_PARAGRAPH]->(para_2191);
CREATE (para_2192:Paragraph {id: '3', content: 'Eritropoietin alfa-beta-zeta, metoksipolietilen glikol epoetin beta, darbepoetin ve roksadustat, endikasyon muadili olarak birbirlerinin yerine kullanılabilirler.'});
CREATE (sec_2189)-[:HAS_PARAGRAPH {order: 2}]->(para_2192);
CREATE (para_2191)-[:NEXT_PARAGRAPH]->(para_2192);
CREATE (para_2193:Paragraph {id: '4', content: 'Eritropoietin, darbepoetin ve roksadustatın ilgili uzman hekim raporlarında ilacın kullanım dozu ve süresi belirtilir. Bir defada en fazla 1 aylık ilaç verilir.'});
CREATE (sec_2189)-[:HAS_PARAGRAPH {order: 3}]->(para_2193);
CREATE (para_2192)-[:NEXT_PARAGRAPH]->(para_2193);
CREATE (sec_2194:Subsection {id: '4.2.9.A-1', title: 'Kronik böbrek yetmezliği ile ilişkili anemi endikasyonunda'});
CREATE (sec_2189)-[:HAS_SUBSECTION {order: 0}]->(sec_2194);
CREATE (para_2195:Paragraph {id: '1', content: 'Eritropoietin alfa-beta-zeta, metoksipolietilen glikol epoetin beta, darbepoetin ve roksadustat ile tedaviye başlamadan önce; hastanın ferritin ve/veya transferrin saturasyonu (TSAT) değerlerine bakılacaktır. Bu değerler TSAT < %20 ve/veya ferritin <100 µg/L ise hastaya öncelikle oral veya intravenöz demir tedavisine başlanacaktır. TSAT ≥ %20 ve/veya ferritin ≥ 100 µg/L olduğunda hemoglobin değeri 10 gr/dl altında ise tedaviye başlanır. Hedef hemoglobin değeri 11-12 gr/dl arasıdır. Hemoglobin değeri 11 gr/dl\'ye ulaşıncaya kadar başlangıç dozunda tedaviye devam edilir ve Hb seviyesini 11-12 gr/dl arasında tutabilmek için idame dozda tedaviye devam edilir. Hb seviyesi 12 gr/dl\'yi aşınca tedavi kesilir. Hasta Hb seviyesi için takibe alınır ve Hb seviyesi 11-12 gr/dl’nin arasına gelince hastaya idame dozda tedaviye tekrar başlanabilir. İdame tedavi sırasında ve/veya tedaviye yeniden başlandığında TSAT >%20 ve/veya ferritin >100 µg/L olmalıdır. Bu değerlere hemodiyaliz hastalarında 3 ayda bir, periton diyaliz hastalarında 4 ayda bir bakılır ve tetkik sonuç belgesinin tarihi ve sonucu reçete veya raporda belirtilir.'});
CREATE (sec_2194)-[:HAS_PARAGRAPH {order: 0}]->(para_2195);
CREATE (para_2196:Paragraph {id: '2', content: 'Eritropoietin alfa-beta-zeta, metoksipolietilen glikol epoetin beta, darbepoetin ve roksadustat nefroloji, iç hastalıkları, çocuk sağlığı ve hastalıkları uzman hekimleri veya diyaliz sertifikalı uzman hekimlerden biri tarafından düzenlenen uzman hekim raporuna dayanılarak reçete edilir. Reçeteler; prediyaliz ve periton diyaliz hastalarında nefroloji uzman hekimi tarafından, hemodiyaliz hastalarında nefroloji, iç hastalıkları, çocuk sağlığı ve hastalıkları uzman hekimlerince veya diyaliz merkezinde görevli diyaliz sertifikalı tüm hekimlerce reçete edilebilir.'});
CREATE (sec_2194)-[:HAS_PARAGRAPH {order: 1}]->(para_2196);
CREATE (para_2195)-[:NEXT_PARAGRAPH]->(para_2196);
CREATE (para_2197:Paragraph {id: '3', content: 'Tedaviye başlama ve idame dozu, sırasıyla; darbepoetin için 0.25-0.75 mcg/kg/hafta ve idame dozu 0.13-0.35 mcg/kg/hafta, eritropoietin alfa-beta-zeta için tedaviye başlangıç dozu 50-150 IU/kg/hafta ve idame dozu 25- 75 IU/kg/haftadır. Metoksipolietilen glikol epoetin beta için ise tedaviye başlama dozu iki haftada bir; 0,4-0,94 mcg/kg, idame dozu ise ayda bir 0,8-1,88 mcg/kg dır.'});
CREATE (sec_2194)-[:HAS_PARAGRAPH {order: 2}]->(para_2197);
CREATE (para_2196)-[:NEXT_PARAGRAPH]->(para_2197);
CREATE (para_2198:Paragraph {id: '4', content: 'Roksadustat için mevcut durumda eritropoez uyarıcı ajan (ESA) tedavisi almayan hastalarda başlangıç dozu en fazla, ağırlığı 100 kg\'dan az olan hastalarda haftada üç kez 70 mg ve ağırlığı 100 kg ve üzeri hastalarda haftada üç kez 100 mg\'dır.'});
CREATE (sec_2194)-[:HAS_PARAGRAPH {order: 3}]->(para_2198);
CREATE (para_2197)-[:NEXT_PARAGRAPH]->(para_2198);
CREATE (para_2199:Paragraph {id: '5', content: 'Mevcut durumda bir ESA tedavisi alırken durumu stabil olan diyaliz hastalarında, yalnızca geçerli bir klinik neden olması ve bu durumun raporda belirtilmesi halinde roksadustat tedavisine geçilebilir. Başlangıç roksadustat dozu, geçişten önceki 4 haftada reçete edilen ortalama ESA dozuna bağlı olup, ilacın Sağlık Bakanlığınca onaylı Kısa Ürün Bilgisinde belirtildiği şekilde yapılmalıdır.'});
CREATE (sec_2194)-[:HAS_PARAGRAPH {order: 4}]->(para_2199);
CREATE (para_2198)-[:NEXT_PARAGRAPH]->(para_2199);
CREATE (sec_2200:Subsection {id: '4.2.9.A-2', title: 'Myelodisplastik Sendrom endikasyonunda'});
CREATE (sec_2189)-[:HAS_SUBSECTION {order: 1}]->(sec_2200);
CREATE (para_2201:Paragraph {id: '1', content: 'Hemoglobin değeri 11 gr/dl\'nin, blast oranı %5’in ve serum eritropoietin düzeyi 500 mu/ml’nin altında olan hastalarda tedaviye başlanır. Hedef hemoglobin değeri 12 gr/dl’dir. Hb seviyesi 12 gr/dl’yi aşınca tedavi kesilir. Eritropoietin alfa-beta için maksimum doz haftada 900 IU/kg’ı (Mülga:RG-09/05/2024-32541/9 md. Yürürlük:17/05/2024 aşmamalıdır. Eritropoietin alfa-beta  , hematoloji uzman hekimi tarafından düzenlenen uzman hekim raporuna dayanılarak, hematoloji veya iç hastalıkları uzman hekimlerince reçete edilebilir. Hemogram sonuç belgesinin tarihi ve sonucu reçetede belirtilir. (Değişik: RG- 07/10/2016- 29850/ 18-a md. Yürürlük: 15/10/2016)'});
CREATE (sec_2200)-[:HAS_PARAGRAPH {order: 0}]->(para_2201);
CREATE (amend_2202:Amendment {content: '(Değişik: RG- 26/09/2013- 28777/ 3 md. Yürürlük: 04/10/2013)'});
CREATE (sec_2200)-[:HAS_AMENDMENT {order: 0}]->(amend_2202);
CREATE (amend_2203:Amendment {content: '(Mülga:RG- 09/05/2024-32541/9 md. Yürürlük:17/05/2024)'});
CREATE (sec_2200)-[:HAS_AMENDMENT {order: 1}]->(amend_2203);
CREATE (sec_2194)-[:NEXT_SUBSECTION]->(sec_2200);
CREATE (sec_2204:Subsection {id: '4.2.9.B', title: 'Sevelamer, lantanyum karbonat ve alüminyum klorür hidroksit kullanım ilkeleri', content: '87'});
CREATE (sec_2188)-[:HAS_SUBSECTION {order: 1}]->(sec_2204);
CREATE (para_2205:Paragraph {id: '1', content: 'Tedaviye başlamak için diğer fosfor düşürücü ilaçların en az 3 ay süreyle kullanılmış olması ve bu hususun raporda belirtilmiş olması gerekir. Bu süre sonunda:'});
CREATE (sec_2204)-[:HAS_PARAGRAPH {order: 0}]->(para_2205);
CREATE (item_2206:Item {id: 'a', content: 'Kalsiyum ve fosfor çarpımı 72 ve üzerinde olan veya'});
CREATE (para_2205)-[:HAS_ITEM {order: 0}]->(item_2206);
CREATE (item_2207:Item {id: 'b', content: 'PTH düzeyinin 100 pg/ml değerinin altında olan adinamik kemik hastalığı olguları veya'});
CREATE (para_2205)-[:HAS_ITEM {order: 1}]->(item_2207);
CREATE (item_2206)-[:NEXT_ITEM]->(item_2207);
CREATE (item_2208:Item {id: 'c', content: 'Kt/V değeri 1,4’ün üzerinde olmasına rağmen düzeltilmiş kalsiyum ve fosfor çarpımı 55’in üzerinde olan veya'});
CREATE (para_2205)-[:HAS_ITEM {order: 2}]->(item_2208);
CREATE (item_2207)-[:NEXT_ITEM]->(item_2208);
CREATE (item_2209:Item {id: 'ç', content: 'Kt/V değeri 1,4’ün üzerinde olan hastanın PTH değeri 300 pg/ml ve üzerinde olan, hastalarda tedaviye başlanır.'});
CREATE (para_2205)-[:HAS_ITEM {order: 3}]->(item_2209);
CREATE (item_2208)-[:NEXT_ITEM]->(item_2209);
CREATE (para_2210:Paragraph {id: '2', content: 'Hemodiyaliz veya periton diyaliz tedavisi altındaki hastalara nefroloji (Değişik:RG-16/03/2023-32134/23-a md. Yürürlük:24/03/2023) , iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimlerinden birinin düzenlediği ve yukarıdaki durumlardan sevelamer (Ek:RG-07/10/2016-29850/18-b md. Yürürlük: 15/10/2016) , lantanyum karbonat veya alüminyum klorür hidroksit kullanımını gerektiren durumun belirtildiği uzman hekim raporuna dayanılarak bu hekimlerce veya diyaliz sertifikalı tüm hekimler tarafından reçete edildiğinde bedeli ödenir.'});
CREATE (sec_2204)-[:HAS_PARAGRAPH {order: 1}]->(para_2210);
CREATE (para_2205)-[:NEXT_PARAGRAPH]->(para_2210);
CREATE (para_2211:Paragraph {id: '3', content: 'Her reçetede fosfor düzeyini gösterir son 1 ay içinde yapılmış tetkik sonuç belgesinin tarihi ve sonucu belirtilir. Bir defada en fazla (Değişik: RG- 25/07/2014- 29071/ 23 md. Yürürlük: 07/08/2014 ) bir aylık dozda ilaç verilir. Fosfor düzeyi 3,5 mg/dl\'nin altında olduğu durumlarda tedavi kesilir.'});
CREATE (sec_2204)-[:HAS_PARAGRAPH {order: 2}]->(para_2211);
CREATE (para_2210)-[:NEXT_PARAGRAPH]->(para_2211);
CREATE (para_2212:Paragraph {id: '4', content: 'Fosfor düzeyinin (Değişik: RG- 07/10/2016- 29850/ 18-c md. Yürürlük: 15/10/2016) 4 mg/dl\'nin üzerine çıkması durumunda tedaviye ilk başlama kriterleri aranarak tekrar başlanabilir. (Ek: RG- 07/10/2016- 29850/ 18-ç md. Yürürlük: 15/10/2016)'});
CREATE (sec_2204)-[:HAS_PARAGRAPH {order: 3}]->(para_2212);
CREATE (para_2211)-[:NEXT_PARAGRAPH]->(para_2212);
CREATE (para_2213:Paragraph {id: '5', content: 'Sevelamer ve lantanyum karbonat kombine olarak kullanılamaz. (Değişik: RG-28/04/2021-31468/ 11-b md. Yürürlük: 06/05/2021)'});
CREATE (sec_2204)-[:HAS_PARAGRAPH {order: 4}]->(para_2213);
CREATE (para_2212)-[:NEXT_PARAGRAPH]->(para_2213);
CREATE (sec_2189)-[:NEXT_SUBSECTION]->(sec_2204);
CREATE (sec_2214:Subsection {id: '4.2.9.C', title: 'Parikalsitol kullanım ilkeleri'});
CREATE (sec_2188)-[:HAS_SUBSECTION {order: 2}]->(sec_2214);
CREATE (para_2215:Paragraph {id: '1', content: 'Albumin ile düzeltilmiş serum kalsiyum düzeyi 10,2 mg/dl ve serum fosfor düzeyi 5,5 mg/dl’nin altında olmak koşuluyla; parathormon (PTH) düzeyi 600 pg/ml’nin üzerinde olan hastalarda veya PTH düzeyi 300 pg/ml’nin üzerinde olmak koşuluyla PTH düzeyinde bir önceki ölçüme göre %25’in üzerinde artış tespit edilen hastalarda parikalsitol tedavisi başlanabilir.'});
CREATE (sec_2214)-[:HAS_PARAGRAPH {order: 0}]->(para_2215);
CREATE (para_2216:Paragraph {id: '2', content: 'PTH düzeyinin 150 pg/ml’nin altına düşmesi, albümin ile düzeltilmiş serum kalsiyum düzeyinin 10,5 mg/dl’nin üzerine çıkması veya serum fosfor düzeyinin 6 mg/dl’nin üzerine çıkması durumunda parikalsitol tedavisi sonlandırılır. (Değişik: RG-19/10/2023-32344/6-c md. Yürürlük: 27/10/2023)'});
CREATE (sec_2214)-[:HAS_PARAGRAPH {order: 1}]->(para_2216);
CREATE (para_2215)-[:NEXT_PARAGRAPH]->(para_2216);
CREATE (para_2217:Paragraph {id: '3', content: 'Parikalsitolün parenteral formlarının yalnızca hemodiyaliz hastalarına yukarıda belirtilen koşullarda nefroloji, iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimleri veya diyaliz sertifikalı uzman hekimi tarafından düzenlenen en fazla 6 ay süreli sağlık raporuna istinaden yine bu hekimler tarafından en fazla 1 aylık dozda reçete edilmesi halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_2214)-[:HAS_PARAGRAPH {order: 2}]->(para_2217);
CREATE (para_2216)-[:NEXT_PARAGRAPH]->(para_2217);
CREATE (para_2218:Paragraph {id: '4', content: 'Parikalsitolün oral formlarının yukarıda belirtilen koşullarda periton diyalizi hastalarına nefroloji uzman hekimi tarafından düzenlenen en fazla 6 ay süreli sağlık raporuna istinaden nefroloji uzman hekimi tarafından en fazla 1 aylık dozda reçete edilmesi halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_2214)-[:HAS_PARAGRAPH {order: 3}]->(para_2218);
CREATE (para_2217)-[:NEXT_PARAGRAPH]->(para_2218);
CREATE (para_2219:Paragraph {id: '5', content: 'En fazla 3 ay öncesine ait albumin ile düzeltilmiş serum kalsiyum düzeyi, serum fosfor düzeyi ve PTH düzeyi sonuçları her reçetede veya raporda belirtilir.'});
CREATE (sec_2214)-[:HAS_PARAGRAPH {order: 4}]->(para_2219);
CREATE (para_2218)-[:NEXT_PARAGRAPH]->(para_2219);
CREATE (sec_2204)-[:NEXT_SUBSECTION]->(sec_2214);
CREATE (sec_2220:Subsection {id: '4.2.9.Ç', title: 'Cinacalcet kullanım ilkeleri'});
CREATE (sec_2188)-[:HAS_SUBSECTION {order: 3}]->(sec_2220);
CREATE (para_2221:Paragraph {id: '1', content: 'Hemodiyaliz ya da periton diyaliz tedavisi altında bulunan (Mülga: RG-21/03/2018-30367/18-a md. Yürürlük: 01/04/2018) albumin ile düzeltilmiş serum kalsiyum değeri (Değişik: RG- 21/03/2018-30367/ 18-a md. Yürürlük: 01/04/2018) ≥8,5 mg/dl, parathormon (PTH) düzeyi (Değişik: RG-28/04/2021-31468/11-c md. Yürürlük:06/05/2021) 600 pg/ml ve üzerinde olduğu belgelenen hastalarda cinacalcet tedavisi başlanabilir.'});
CREATE (sec_2220)-[:HAS_PARAGRAPH {order: 0}]->(para_2221);
CREATE (para_2222:Paragraph {id: '2', content: '(Değişik: RG-21/03/2018-30367/ 18-b md. Yürürlük: 01/04/2018) Hemodiyaliz veya periton diyaliz tedavisi altındaki hastalardan albumin ile düzeltilmiş serum kalsiyum değeri ≤8,4 mg/dl olanlarda cinacalcet tedavisi kesilir.'});

// Batch 60
CREATE (sec_2220)-[:HAS_PARAGRAPH {order: 1}]->(para_2222);
CREATE (para_2221)-[:NEXT_PARAGRAPH]->(para_2222);
CREATE (para_2223:Paragraph {id: '3', content: 'Yukarıdaki hasta gruplarında PTH düzeyi (Değişik: RG-28/04/2021-31468/11-c md. Yürürlük:06/05/2021) 300 pg/ml’nin altına düşen hastalarda cinacalcet tedavisi kesilir.'});
CREATE (sec_2220)-[:HAS_PARAGRAPH {order: 2}]->(para_2223);
CREATE (para_2222)-[:NEXT_PARAGRAPH]->(para_2223);
CREATE (para_2224:Paragraph {id: '4', content: 'Hemodiyaliz veya periton diyaliz tedavisi altındaki hastalarda, başlangıç değerleri nefroloji uzmanınca düzenlenen raporda belirtilmek kaydıyla, (Değişik: RG-19/10/2023-32344/6-ç md. Yürürlük:27/10/2023) nefroloji, iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimleri veya diyaliz sertifikalı uzman hekimler tarafından en fazla 3 ay öncesine ait kalsiyum ve PTH değerleri reçete veya rapor üzerinde belirtilir. Reçete tekrarında yeni tetkik sonuç belgesinin tarihi ve sonucu reçetede veya raporda belirtilir.'});
CREATE (sec_2220)-[:HAS_PARAGRAPH {order: 3}]->(para_2224);
CREATE (para_2223)-[:NEXT_PARAGRAPH]->(para_2224);
CREATE (para_2225:Paragraph {id: '5', content: 'Serum kalsiyum düzeyleri temelinde paratroidektomi endike olduğu halde (ilgili tedavi kılavuzlarında tanımlandığı şekilde) paratiroidektominin klinik açıdan uygun olmadığı veya kontrendike olduğu primer hiperparatiroidili hastalarda hiperkalseminin düşürülmesi endikasyonunda;'});
CREATE (sec_2220)-[:HAS_PARAGRAPH {order: 4}]->(para_2225);
CREATE (item_2226:Item {id: 'a', content: 'ASA-IV grubu hastalar veya'});
CREATE (para_2225)-[:HAS_ITEM {order: 0}]->(item_2226);
CREATE (item_2227:Item {id: 'b', content: 'Opere olmuş ancak nüks olan hastalardan; bifosfonatlar ile hiperkalsemisi kontrol altına alınamamış ve albümin ile düzeltilmiş serum kalsiyum değeri ≥10,5 mg/dl olan hastalar, için  bu durumların belirtildiği endokrinoloji, genel cerrahi ve anestezi uzman hekimlerinin bulunduğu 6 ay süreli sağlık kurulu raporuna istinaden endokrinoloji uzman hekimlerince reçetelenebilir: (Ek: RG-28/04/2021-31468/11-c md. Yürürlük:06/05/2021)'});
CREATE (para_2225)-[:HAS_ITEM {order: 1}]->(item_2227);
CREATE (item_2226)-[:NEXT_ITEM]->(item_2227);
CREATE (para_2224)-[:NEXT_PARAGRAPH]->(para_2225);
CREATE (para_2228:Paragraph {id: '6', content: 'Cinacalcet ve etelkalsetid etken maddeli ilaçların birlikte kullanılması halinde Kurumca bedelleri karşılanmaz.'});
CREATE (sec_2220)-[:HAS_PARAGRAPH {order: 5}]->(para_2228);
CREATE (para_2225)-[:NEXT_PARAGRAPH]->(para_2228);
CREATE (amend_2229:Amendment {content: '(Mülga:RG-25/08/2022-31934/23 md. Yürürlük:03/09/2022)'});
CREATE (sec_2220)-[:HAS_AMENDMENT {order: 0}]->(amend_2229);
CREATE (sec_2214)-[:NEXT_SUBSECTION]->(sec_2220);
CREATE (sec_2230:Subsection {id: '4.2.9.D', title: 'Oral esansiyel aminoasit preperatları ve keto analogları kullanım ilkeleri'});
CREATE (sec_2188)-[:HAS_SUBSECTION {order: 4}]->(sec_2230);
CREATE (para_2231:Paragraph {id: '1', content: 'Serum albumin düzeyi < 3,5 g/dL olan; Evre 4 KBH (glomerüler filtrasyon hızı <30 ml/dak) veya Evre 5 KBH (diyaliz hastaları dahil) hastalarında;'});
CREATE (sec_2230)-[:HAS_PARAGRAPH {order: 0}]->(para_2231);
CREATE (item_2232:Item {id: 'a', content: 'Son 3 ayda ağırlığında %10 ve daha fazla kilo kaybı olması veya'});
CREATE (para_2231)-[:HAS_ITEM {order: 0}]->(item_2232);
CREATE (item_2233:Item {id: 'b', content: 'Vücut Kitle İndeksi ( BMI = Body Mass Index ) 19’un altında olması, 88 halinde tedaviye başlanır.'});
CREATE (para_2231)-[:HAS_ITEM {order: 1}]->(item_2233);
CREATE (item_2232)-[:NEXT_ITEM]->(item_2233);
CREATE (para_2234:Paragraph {id: '2', content: 'İlaç tedavisini kesme kriterleri;'});
CREATE (sec_2230)-[:HAS_PARAGRAPH {order: 1}]->(para_2234);
CREATE (item_2235:Item {id: 'a', content: 'Tedavinin ilk 6 ayının sonunda başlangıç serum albümin düzeyinde %25’lik artış sağlanamayan hastalarda veya'});
CREATE (para_2234)-[:HAS_ITEM {order: 0}]->(item_2235);
CREATE (item_2236:Item {id: 'b', content: 'Tedavinin ilk 3 ayının sonunda ve/veya tedavinin devamında serum albümin düzeyi 4 g/dL’nin üzerine çıkan tüm hastalarda, ilaç kesilir.'});
CREATE (para_2234)-[:HAS_ITEM {order: 1}]->(item_2236);
CREATE (item_2235)-[:NEXT_ITEM]->(item_2236);
CREATE (item_2237:Item {id: 'c', content: 'Tedavisi kesilen hastalarda yeniden tedaviye başlarken tedavi başlangıç kriterleri aranır.'});
CREATE (para_2234)-[:HAS_ITEM {order: 2}]->(item_2237);
CREATE (item_2236)-[:NEXT_ITEM]->(item_2237);
CREATE (para_2231)-[:NEXT_PARAGRAPH]->(para_2234);
CREATE (para_2238:Paragraph {id: '3', content: 'Bu hastalarda, nefroloji (Değişik:RG-16/03/2023-32134/23-b md. Yürürlük:24/03/2023) , iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimlerinden birinin düzenlediği ve yukarıdaki hususların belirtildiği 1 yıl süreli sağlık raporuna istinaden 3 aylık dozda bu hekimlerce veya diyaliz sertifikalı tüm hekimler tarafından reçete edilebilir. Her reçetelemede serum albumin düzeyine ait yeni tetkik sonuç belgesinin tarihi ve sonucu reçete veya raporda belirtilir. Devam raporlarında ise hastanın tedaviye başlangıç albumin düzeyi yer almalıdır. (Ek: RG-28/04/2021-31468/11-ç md. Yürürlük:06/05/2021)'});
CREATE (sec_2230)-[:HAS_PARAGRAPH {order: 2}]->(para_2238);
CREATE (para_2234)-[:NEXT_PARAGRAPH]->(para_2238);
CREATE (sec_2220)-[:NEXT_SUBSECTION]->(sec_2230);
CREATE (sec_2239:Subsection {id: '4.2.9.E', title: 'Etelkalsetid kullanım ilkeleri'});
CREATE (sec_2188)-[:HAS_SUBSECTION {order: 5}]->(sec_2239);
CREATE (para_2240:Paragraph {id: '1', content: 'Hemodiyaliz tedavisi altında bulunan albumin ile düzeltilmiş serum kalsiyum değeri ≥8,5 mg/dl, parathormon (PTH) düzeyi 600 pg/ml ve üzerinde olduğu belgelenen hastalarda etelkalsetid tedavisi başlanabilir.'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 0}]->(para_2240);
CREATE (para_2241:Paragraph {id: '2', content: 'Hemodiyaliz tedavisi altındaki hastalardan albumin ile düzeltilmiş serum kalsiyum değerinin ≤8,4 mg/dl olması veya PTH düzeyinin 300 pg/ml’nin altına düşmesi halinde etelkalsetid tedavisi sonlandırılır. (Değişik: RG- 19/10/2023- 32344/ 6-d md. Yürürlük: 27/10/2023)'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 1}]->(para_2241);
CREATE (para_2240)-[:NEXT_PARAGRAPH]->(para_2241);
CREATE (para_2242:Paragraph {id: '3', content: 'Etelkalsetid yalnızca hemodiyaliz hastalarına yukarıda belirtilen koşullarda nefroloji, iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimleri veya diyaliz sertifikalı uzman hekimi tarafından düzenlenen en fazla 6 ay süreli sağlık raporuna istinaden yine bu hekimler tarafından en fazla 1 aylık dozda reçete edilmesi halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 2}]->(para_2242);
CREATE (para_2241)-[:NEXT_PARAGRAPH]->(para_2242);
CREATE (para_2243:Paragraph {id: '4', content: 'En fazla 3 ay öncesine ait albümin ile düzeltilmiş serum kalsiyum düzeyi ve PTH düzeyi sonuçları her reçetede veya raporda belirtilir.'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 3}]->(para_2243);
CREATE (para_2242)-[:NEXT_PARAGRAPH]->(para_2243);
CREATE (para_2244:Paragraph {id: '5', content: 'Etelkalsetid etken maddeli ilacın yalnızca; hemodiyaliz tedavisi alan kronik böbrek hastalığı olan yetişkin hastalardaki sekonder hiperparatiroidizmin tedavisinde kullanılması halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 4}]->(para_2244);
CREATE (para_2243)-[:NEXT_PARAGRAPH]->(para_2244);
CREATE (para_2245:Paragraph {id: '6', content: 'Etelkalsetid etken maddeli ilacın; paratiroid karsinomu ve primer hiperparatiroidizm endikasyonlarında ya da hemodiyaliz tedavisi görmeyen kronik böbrek hastalığı olan hastalarda kullanılması halinde Kurumca bedelleri karşılanmaz.'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 5}]->(para_2245);
CREATE (para_2244)-[:NEXT_PARAGRAPH]->(para_2245);
CREATE (para_2246:Paragraph {id: '7', content: 'Cinacalcet ve etelkalsetid etken maddeli ilaçların birlikte kullanılması halinde Kurumca bedelleri karşılanmaz.'});
CREATE (sec_2239)-[:HAS_PARAGRAPH {order: 6}]->(para_2246);
CREATE (para_2245)-[:NEXT_PARAGRAPH]->(para_2246);
CREATE (sec_2230)-[:NEXT_SUBSECTION]->(sec_2239);
CREATE (sec_2161)-[:NEXT_SUBSECTION]->(sec_2188);
CREATE (sec_2247:Subsection {id: '4.2.10', title: 'Lizozomal hastalıklar için tedavi ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 9}]->(sec_2247);
CREATE (sec_2248:Subsection {id: '4.2.10.A', title: 'Gaucher hastalığında tedavi esasları'});
CREATE (sec_2247)-[:HAS_SUBSECTION {order: 0}]->(sec_2248);
CREATE (para_2249:Paragraph {id: '1', content: 'Periferik kandan veya dokudan enzim (glucocerebrosidase) düzeyinin veya mutasyon analiz sonuçlarının hastalıkla uyumlu olmasına göre tanı konulmuş olmalıdır.'});
CREATE (sec_2248)-[:HAS_PARAGRAPH {order: 0}]->(para_2249);
CREATE (para_2250:Paragraph {id: '2', content: 'Tedavi endikasyonu olan hastalık tipleri; Tip I (Non Nöropatik Form) ve Tip III (Kronik Nöropatik Form)’tür. Tip II (Akut Nöropatik Form) için enzim tedavisi yapılmayacaktır.'});
CREATE (sec_2248)-[:HAS_PARAGRAPH {order: 1}]->(para_2250);
CREATE (para_2249)-[:NEXT_PARAGRAPH]->(para_2250);
CREATE (sec_2251:Subsection {id: '4.2.10.A-1', title: 'Tip I ve Tip III Gaucher hastalarında enzim tedavisine başlama ve sonlandırma kriterleri'});
CREATE (sec_2248)-[:HAS_SUBSECTION {order: 0}]->(sec_2251);
CREATE (para_2252:Paragraph {id: '1', content: 'Enzim tedavisi;'});
CREATE (sec_2251)-[:HAS_PARAGRAPH {order: 0}]->(para_2252);
CREATE (item_2253:Item {id: 'a', content: 'Hastanın hemoglobin değerinin erişkinler için 8 ile 10 g/dl arasında olması, çocuklar için yaşa göre normalin alt sınırının 2 g/dl altında olması,'});
CREATE (para_2252)-[:HAS_ITEM {order: 0}]->(item_2253);
CREATE (item_2254:Item {id: 'b', content: 'Kan trombosit sayısının 50.000 ile 100.000/mm3 olması,'});
CREATE (para_2252)-[:HAS_ITEM {order: 1}]->(item_2254);
CREATE (item_2253)-[:NEXT_ITEM]->(item_2254);
CREATE (item_2255:Item {id: 'c', content: 'Karaciğer hacminin herhangi bir görüntüleme yöntemi ile en az 1,25 kat artmış olduğunun tespit edilmesi,'});
CREATE (para_2252)-[:HAS_ITEM {order: 2}]->(item_2255);
CREATE (item_2254)-[:NEXT_ITEM]->(item_2255);
CREATE (item_2256:Item {id: 'ç', content: 'Dalak hacminin herhangi bir görüntüleme yöntemi ile en az 5 kat artmış olduğunun tespit edilmesi,'});
CREATE (para_2252)-[:HAS_ITEM {order: 3}]->(item_2256);
CREATE (item_2255)-[:NEXT_ITEM]->(item_2256);
CREATE (item_2257:Item {id: 'd', content: 'DEXA ile kemik mineral dansite Z skorunun hastanın yaş grubuna göre -1,5 ile -2,5 SD arasında olması,'});
CREATE (para_2252)-[:HAS_ITEM {order: 4}]->(item_2257);
CREATE (item_2256)-[:NEXT_ITEM]->(item_2257);
CREATE (item_2258:Item {id: 'e', content: 'Düz kemik grafisinde avasküler nekroz alanlarının olması, kriterlerinden en az birisinin varlığında hastaya 2 haftada bir gün en fazla 30 IU/kg dozunda uygulanacaktır;'});
CREATE (para_2252)-[:HAS_ITEM {order: 5}]->(item_2258);
CREATE (item_2257)-[:NEXT_ITEM]->(item_2258);

// Batch 61
CREATE (para_2259:Paragraph {id: '2', content: 'Birinci fıkrada sıralanan hükümler doğrultusunda ilk tedavi başlangıcından itibaren 6 ncı ayın sonunda tedaviye başlangıç kriter/kriterlerinde düzelme görülmez ise 1 yıl boyunca 2 haftada bir gün en fazla 60 IU/kg uygulanacaktır. Yapılacak bu tedavi sonrasında başlangıca göre düzelme göstermeyen hastalarda enzim tedavisi kesilir.'});
CREATE (sec_2251)-[:HAS_PARAGRAPH {order: 1}]->(para_2259);
CREATE (para_2252)-[:NEXT_PARAGRAPH]->(para_2259);
CREATE (para_2260:Paragraph {id: '3', content: 'Aşağıdaki kriterlerden en az birisinin varlığında ise hastaya doğrudan 2 haftada bir gün en fazla 60 IU/kg dozunda enzim tedavisi uygulanacaktır.'});
CREATE (sec_2251)-[:HAS_PARAGRAPH {order: 2}]->(para_2260);
CREATE (item_2261:Item {id: 'a', content: 'Hemoglobin değerinin erişkinler ve çocuklar için 8 g/dl nin altında olması,'});
CREATE (para_2260)-[:HAS_ITEM {order: 0}]->(item_2261);
CREATE (item_2262:Item {id: 'b', content: 'Kan trombosit sayısının 50.000 /mm3 altında olması,'});
CREATE (para_2260)-[:HAS_ITEM {order: 1}]->(item_2262);
CREATE (item_2261)-[:NEXT_ITEM]->(item_2262);
CREATE (item_2263:Item {id: 'c', content: 'Karaciğer hacminin herhangi bir görüntüleme yöntemi ile en az (Değişik: RG-16/06/2020-31157/4-a md. Yürürlük: 24/06/2020) 2,5 kat artmış olduğunun tespit edilmesi,'});
CREATE (para_2260)-[:HAS_ITEM {order: 2}]->(item_2263);
CREATE (item_2262)-[:NEXT_ITEM]->(item_2263);
CREATE (item_2264:Item {id: 'ç', content: 'Dalak hacminin herhangi bir görüntüleme yöntemi ile en az (Değişik: RG-16/06/2020-31157/4-a md. Yürürlük: 24/06/2020) 15 kat artmış olduğunun tespit edilmesi,'});
CREATE (para_2260)-[:HAS_ITEM {order: 3}]->(item_2264);
CREATE (item_2263)-[:NEXT_ITEM]->(item_2264);
CREATE (item_2265:Item {id: 'd', content: 'DEXA ile kemik mineral dansite Z skorunun erişkin hastanın yaş grubuna göre -2,5 SD altında olması, çocuklarda boy ve/veya kilo gelişiminin yaşa göre -2 SD altında olması,'});
CREATE (para_2260)-[:HAS_ITEM {order: 4}]->(item_2265);
CREATE (item_2264)-[:NEXT_ITEM]->(item_2265);
CREATE (item_2266:Item {id: 'e', content: 'Düz kemik grafisinde avasküler nekroz alanlarının ve patolojik kırıklarının olması,'});
CREATE (para_2260)-[:HAS_ITEM {order: 5}]->(item_2266);
CREATE (item_2265)-[:NEXT_ITEM]->(item_2266);
CREATE (item_2267:Item {id: 'f', content: 'Hastalığa bağlı olarak kronik kemik ağrılarının oluşması ve geçirilmiş eklem ameliyatının olması.'});
CREATE (para_2260)-[:HAS_ITEM {order: 6}]->(item_2267);
CREATE (item_2266)-[:NEXT_ITEM]->(item_2267);
CREATE (para_2259)-[:NEXT_PARAGRAPH]->(para_2260);
CREATE (para_2268:Paragraph {id: '4', content: 'Üçüncü fıkrada sıralanan hükümler doğrultusunda, 2 (iki) haftada bir gün 60 IU/kg dozunda enzim tedavisi uygulanan hastalarda birinci yılın sonunda yapılan değerlendirmede hastanın tedaviye başlamasına esas olan kriter/kriterlerde düzelme göstermeyen hastalarda enzim tedavisi kesilir.'});
CREATE (sec_2251)-[:HAS_PARAGRAPH {order: 3}]->(para_2268);
CREATE (para_2260)-[:NEXT_PARAGRAPH]->(para_2268);
CREATE (para_2269:Paragraph {id: '5', content: 'Daha önceki SUT hükümlerine göre tedaviye başlanan hastalarda tedavi, rapor süresi sonuna kadar devam eder. Bu sürenin sonunda düzenlenecek yeni raporda; yukarıda yer alan tedaviye başlangıç kriter/kriterlerinin herhangi birisinde 89 düzelme olduğunun belirtilmesi koşuluyla yukarıda belirtilen dozlara göre tedaviye devam edilir. (Ek: RG-16/06/2020- 31157/4-b md. Yürürlük: 24/06/2020) Aralıksız bir yıl süreyle tedaviye ara verilmesi durumunda ilaca tekrar başlamak için başlangıç kriterleri aranır. Bir yıldan kısa süreyle tedaviye ara verilmesi durumunda başlangıç kriterleri aranmaksızın tedaviye devam edilebilir.'});
CREATE (sec_2251)-[:HAS_PARAGRAPH {order: 4}]->(para_2269);
CREATE (para_2268)-[:NEXT_PARAGRAPH]->(para_2269);
CREATE (amend_2270:Amendment {content: '(Değişik: RG- 28/12/2018- 30639/ 14 md. Yürürlük: 08/01/2019)'});
CREATE (sec_2251)-[:HAS_AMENDMENT {order: 0}]->(amend_2270);
CREATE (amend_2271:Amendment {content: '(Değişik: RG- 28/12/2018- 30639/ 14 md. Yürürlük: 08/01/2019)'});
CREATE (sec_2251)-[:HAS_AMENDMENT {order: 1}]->(amend_2271);
CREATE (sec_2272:Subsection {id: '4.2.10.A-2', title: 'Substrat inhibisyon tedavi kriterleri'});
CREATE (sec_2248)-[:HAS_SUBSECTION {order: 1}]->(sec_2272);
CREATE (para_2273:Paragraph {id: '1', content: 'Gaucher hastalığında ilk tedavi seçeneği enzim replasman tedavisidir. Ancak;'});
CREATE (sec_2272)-[:HAS_PARAGRAPH {order: 0}]->(para_2273);
CREATE (item_2274:Item {id: 'a', content: 'Enzim tedavisine ağır alerjik reaksiyonlar veya hipersensitivite geliştirenlerde,'});
CREATE (para_2273)-[:HAS_ITEM {order: 0}]->(item_2274);
CREATE (item_2275:Item {id: 'b', content: 'Enzim tedavisi kriter/kriterleri kapsamında enzim tedavisi kesilmiş olan hastalarda, miglustat tedavisine geçilir.'});
CREATE (para_2273)-[:HAS_ITEM {order: 1}]->(item_2275);
CREATE (item_2274)-[:NEXT_ITEM]->(item_2275);
CREATE (para_2276:Paragraph {id: '2', content: 'Miglustat tedavisine yanıt, enzim tedavisinden miglustat tedavisine geçişe neden olan kriter/kriterler açısından takip edilir. Birinci yılın sonunda tedaviye başlanmasına esas olan bu kriter/kriterlerde düzelme göstermeyen hastalarda miglustat tedavisi kesilir. (Ek: RG- 21/04/2022- 31816/2-b md. Yürürlük: 29/04/2022)'});
CREATE (sec_2272)-[:HAS_PARAGRAPH {order: 1}]->(para_2276);
CREATE (para_2273)-[:NEXT_PARAGRAPH]->(para_2276);
CREATE (sec_2251)-[:NEXT_SUBSECTION]->(sec_2272);
CREATE (sec_2277:Subsection {id: '4.2.10.A-3', title: 'Tip I Gaucher olan yetişkin hastalarda Eliglustat tedavisine başlama ve sonlandırma kriterleri'});
CREATE (sec_2248)-[:HAS_SUBSECTION {order: 2}]->(sec_2277);
CREATE (para_2278:Paragraph {id: '1', content: 'Eliglustat tedavisi;'});
CREATE (sec_2277)-[:HAS_PARAGRAPH {order: 0}]->(para_2278);
CREATE (item_2279:Item {id: 'a', content: 'Hastanın hemoglobin değerinin erişkinler için 10 g/dl’nin altında olması,'});
CREATE (para_2278)-[:HAS_ITEM {order: 0}]->(item_2279);
CREATE (item_2280:Item {id: 'b', content: 'Kan trombosit sayısının 100.000/mm³’ün altında olması,'});
CREATE (para_2278)-[:HAS_ITEM {order: 1}]->(item_2280);
CREATE (item_2279)-[:NEXT_ITEM]->(item_2280);
CREATE (item_2281:Item {id: 'c', content: 'Karaciğer hacminin herhangi bir görüntüleme yöntemi ile en az 1,25 kat artmış olduğunun tespit edilmesi,'});
CREATE (para_2278)-[:HAS_ITEM {order: 2}]->(item_2281);
CREATE (item_2280)-[:NEXT_ITEM]->(item_2281);
CREATE (item_2282:Item {id: 'ç', content: 'Dalak hacminin herhangi bir görüntüleme yöntemi ile en az 5 kat artmış olduğunun tespit edilmesi,'});
CREATE (para_2278)-[:HAS_ITEM {order: 3}]->(item_2282);
CREATE (item_2281)-[:NEXT_ITEM]->(item_2282);
CREATE (item_2283:Item {id: 'd', content: 'DEXA ile kemik mineral dansite Z skorunun hastanın yaş grubuna göre -1,5’in altında olması,'});
CREATE (para_2278)-[:HAS_ITEM {order: 4}]->(item_2283);
CREATE (item_2282)-[:NEXT_ITEM]->(item_2283);
CREATE (item_2284:Item {id: 'e', content: 'Düz kemik grafisinde avasküler nekroz alanlarının olması, kriterlerinden en az birinin varlığında hastaya eliglustat başlanır.'});
CREATE (para_2278)-[:HAS_ITEM {order: 5}]->(item_2284);
CREATE (item_2283)-[:NEXT_ITEM]->(item_2284);
CREATE (para_2285:Paragraph {id: '2', content: 'Önerilen doz oral yolla verilmek üzere, CYP2D6’nın orta metabolizörleri (OM’ler) ve hızlı metabolizörleri (HM’ler) için günde iki kez 84 mg eliglustattır. CYP2D6’nın yavaş metabolizörleri (YM’ler) için tavsiye edilen doz günde bir kez 84 mg eliglustattır. Hastanın raporunda CYP2D6 değerinin belirtilmesi gerekmektedir.'});
CREATE (sec_2277)-[:HAS_PARAGRAPH {order: 1}]->(para_2285);
CREATE (para_2278)-[:NEXT_PARAGRAPH]->(para_2285);
CREATE (para_2286:Paragraph {id: '3', content: 'Yukarıda sıralanan hükümler doğrultusunda, eliglustat tedavisi uygulanan hastalarda birinci yılın sonunda yapılan değerlendirmede hastanın tedaviye başlamasına esas olan kriter/kriterlerde düzelme göstermeyen hastalarda tedavi kesilir.'});
CREATE (sec_2277)-[:HAS_PARAGRAPH {order: 2}]->(para_2286);
CREATE (para_2285)-[:NEXT_PARAGRAPH]->(para_2286);
CREATE (para_2287:Paragraph {id: '4', content: 'Tedavide düzelme sağlanan ve ilacın kullanımına devam edilmesine karar verilen hastalarda; düzenlenecek yeni raporlarda, yukarıda yer alan başlangıç kriter/kriterlerinin herhangi birinde düzelme olduğunun belirtilmesi koşuluyla tedaviye devam edilebilir. Tedaviye bir yıl veya daha uzun süreyle ara verilmesi durumunda ilaca tekrar başlamak için başlangıç kriterleri aranır. Bir yıldan kısa süreyle tedaviye ara verilmesi durumunda başlangıç kriterleri aranmaksızın tedaviye devam edilebilir. (Değişik: RG- 21/04/2022- 31816/2-a md. Yürürlük: 29/04/2022)'});
CREATE (sec_2277)-[:HAS_PARAGRAPH {order: 3}]->(para_2287);
CREATE (para_2286)-[:NEXT_PARAGRAPH]->(para_2287);
CREATE (sec_2272)-[:NEXT_SUBSECTION]->(sec_2277);
CREATE (sec_2288:Subsection {id: '4.2.10.A-4', title: 'Rapor ve reçeteleme koşulları'});
CREATE (sec_2248)-[:HAS_SUBSECTION {order: 3}]->(sec_2288);
CREATE (para_2289:Paragraph {id: '1', content: 'Hasta adına, (Ek:RG-09/09/2017-30175/19-a md.Yürürlük:23/09/2017) çocuk endokrinolojisi ve metabolizma hastalıkları veya çocuk metabolizma veya endokrinoloji ve metabolizma hastalıkları veya gastroenteroloji uzman hekimlerinden en az birinin yer aldığı sağlık kurulu raporu düzenlenir. Raporda; teşhis, başlangıç ve devam kriteri/kriterleri ile ilgili tüm bilgiler yer alır. Rapor süresi 6 aydır. Bu rapora dayanılarak yine bu hekimlerce, bu hekimlerin bulunmadığı yerlerde ise çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimlerince reçete düzenlenir.'});
CREATE (sec_2288)-[:HAS_PARAGRAPH {order: 0}]->(para_2289);
CREATE (para_2290:Paragraph {id: '2', content: 'Hastanın takip ve tedavi edildiği sağlık kurumlarında, hastalar adına dosyalar açılacak ve tüm bilgiler bu dosyada muhafaza edilecektir.'});
CREATE (sec_2288)-[:HAS_PARAGRAPH {order: 1}]->(para_2290);
CREATE (para_2289)-[:NEXT_PARAGRAPH]->(para_2290);
CREATE (sec_2277)-[:NEXT_SUBSECTION]->(sec_2288);
CREATE (sec_2291:Subsection {id: '4.2.10.B', title: 'Fabry Hastalığı tedavi esasları'});
CREATE (sec_2247)-[:HAS_SUBSECTION {order: 1}]->(sec_2291);
CREATE (para_2292:Paragraph {id: '1', content: 'Periferik kandan veya dokudan enzim (alfa galactosidase) düzeyinin veya mutasyon analiz sonuçlarının hastalıkla uyumlu olmasına göre tanı konulmuş olmalıdır. (Enzim düzeyi normal saptanan bayan hastalarda moleküler analiz sonuçlarının hastalıkla uyumlu olmasına göre tanı konulmuş olmalıdır.)'});
CREATE (sec_2291)-[:HAS_PARAGRAPH {order: 0}]->(para_2292);
CREATE (sec_2293:Subsection {id: '4.2.10.B-1', title: 'Enzim tedavisine başlama ve sonlandırma kriterleri'});
CREATE (sec_2291)-[:HAS_SUBSECTION {order: 0}]->(sec_2293);
CREATE (para_2294:Paragraph {id: '1', content: 'Aşağıdaki kriterlerden herhangi birisinin varlığında enzim replasman tedavisi uygulanır.'});
CREATE (sec_2293)-[:HAS_PARAGRAPH {order: 0}]->(para_2294);
CREATE (item_2295:Item {id: 'a', content: 'Böbrek fonksiyonlarında bozulma (aşağıdaki kriterlerden herhangi birisinin varlığı);'});
CREATE (para_2294)-[:HAS_ITEM {order: 0}]->(item_2295);
CREATE (subitem_2296:SubItem {id: '1', content: 'Yaşa göre ayarlanmış kreatinin klerensinin (glomerül filtrasyon hızı) 80 ml/dk altında olması,'});
CREATE (item_2295)-[:HAS_SUBITEM {order: 0}]->(subitem_2296);

// Batch 62
CREATE (subitem_2297:SubItem {id: '2', content: '24 saatte 300 mg üzerinde proteinüri olması,'});
CREATE (item_2295)-[:HAS_SUBITEM {order: 1}]->(subitem_2297);
CREATE (subitem_2296)-[:NEXT_SUBITEM]->(subitem_2297);
CREATE (subitem_2298:SubItem {id: '3', content: 'Böbrek biyopsisinde endoteliyal depolanmanın varlığı ile birlikte mikroalbüminürinin olması.'});
CREATE (item_2295)-[:HAS_SUBITEM {order: 2}]->(subitem_2298);
CREATE (subitem_2297)-[:NEXT_SUBITEM]->(subitem_2298);
CREATE (item_2299:Item {id: 'b', content: 'Kalp tutulumunun gösterilmesi (EKG veya ECHO veya anjiografi veya elektrofizyolojik çalışma ile),'});
CREATE (para_2294)-[:HAS_ITEM {order: 1}]->(item_2299);
CREATE (item_2295)-[:NEXT_ITEM]->(item_2299);
CREATE (item_2300:Item {id: 'c', content: 'Nörolojik tutulumun gösterilmesi,'});
CREATE (para_2294)-[:HAS_ITEM {order: 2}]->(item_2300);
CREATE (item_2299)-[:NEXT_ITEM]->(item_2300);
CREATE (item_2301:Item {id: 'ç', content: 'Gastro intestinal sistem bulgularının olması,'});
CREATE (para_2294)-[:HAS_ITEM {order: 3}]->(item_2301);
CREATE (item_2300)-[:NEXT_ITEM]->(item_2301);
CREATE (item_2302:Item {id: 'd', content: 'Vertigo ataklarının olması,'});
CREATE (para_2294)-[:HAS_ITEM {order: 4}]->(item_2302);
CREATE (item_2301)-[:NEXT_ITEM]->(item_2302);
CREATE (item_2303:Item {id: 'e', content: 'İşitme kaybının olması,'});
CREATE (para_2294)-[:HAS_ITEM {order: 5}]->(item_2303);
CREATE (item_2302)-[:NEXT_ITEM]->(item_2303);
CREATE (item_2304:Item {id: 'f', content: 'Diğer tedavilere yanıtsız nöropatik ağrının olması.'});
CREATE (para_2294)-[:HAS_ITEM {order: 6}]->(item_2304);
CREATE (item_2303)-[:NEXT_ITEM]->(item_2304);
CREATE (para_2305:Paragraph {id: '2', content: 'Enzim tedavisi uygulanan hastalarda birinci yılın sonunda yapılan değerlendirmede hastanın tedaviye başlamasına esas olan kriter/kriterlerde düzelme göstermeyen hastalarda enzim tedavisi kesilir.'});
CREATE (sec_2293)-[:HAS_PARAGRAPH {order: 1}]->(para_2305);
CREATE (para_2294)-[:NEXT_PARAGRAPH]->(para_2305);
CREATE (sec_2306:Subsection {id: '4.2.10.B-2', title: 'Rapor ve reçeteleme koşulları'});
CREATE (sec_2291)-[:HAS_SUBSECTION {order: 1}]->(sec_2306);
CREATE (para_2307:Paragraph {id: '1', content: 'Hasta adına, en az biri çocuk metabolizma veya  endokrinoloji ve metabolizma uzman hekimi olmak kaydıyla; gastroenteroloji veya nöroloji veya nefroloji uzman hekimlerince düzenlenen sağlık kurulu raporuna istinaden bu hekimlerce, bu hekimlerin bulunmadığı yerlerde ise çocuk sağlığı 90 ve hastalıkları veya iç hastalıkları uzman hekimlerince reçete edilmesi halinde bedeli Kurumca karşılanır. Raporda; teşhis, başlangıç ve devam kriter/kriterleri ile ilgili tüm bilgiler yer alır. Rapor süresi 6 aydır.'});
CREATE (sec_2306)-[:HAS_PARAGRAPH {order: 0}]->(para_2307);
CREATE (para_2308:Paragraph {id: '2', content: 'Hastanın takip ve tedavi edildiği sağlık kurumlarında, hastalar adına dosyalar açılacak ve tüm bilgiler bu dosyada muhafaza edilecektir. (Değişik: RG- 25/09/2024- 32673/ 7-a md. Yürürlük: 03/10/2024)'});
CREATE (sec_2306)-[:HAS_PARAGRAPH {order: 1}]->(para_2308);
CREATE (para_2307)-[:NEXT_PARAGRAPH]->(para_2308);
CREATE (amend_2309:Amendment {content: '(Değişik: RG- 21/03/2018- 30367/ 19 md. Yürürlük: 01/04/2018)'});
CREATE (sec_2306)-[:HAS_AMENDMENT {order: 0}]->(amend_2309);
CREATE (amend_2310:Amendment {content: '(Değişik: RG- 04/09/2019- 30878/ 18 md. Yürürlük: \n12/09/2019)'});
CREATE (sec_2306)-[:HAS_AMENDMENT {order: 1}]->(amend_2310);
CREATE (sec_2293)-[:NEXT_SUBSECTION]->(sec_2306);
CREATE (sec_2248)-[:NEXT_SUBSECTION]->(sec_2291);
CREATE (sec_2311:Subsection {id: '4.2.10.C', title: '2.3- Sonlandırma kriteri: Devam kriterlerini karşılayamayan hastaların tedavileri sonlandırılır.'});
CREATE (sec_2247)-[:HAS_SUBSECTION {order: 2}]->(sec_2311);
CREATE (sec_2312:Subsection {id: '4.2.10.C-1', title: 'Tanı kriterleri'});
CREATE (sec_2311)-[:HAS_SUBSECTION {order: 0}]->(sec_2312);
CREATE (para_2313:Paragraph {id: '1', content: 'Periferik kandan lökosit içi ya da dokudan enzim (Tip I için; L-İduronidase, Tip II için; İduronidate -2 sulfatase, Tip IVA için N-Acetyl galactoseamine-6-sulphatase, Tip VI için; N-Acetyl Galactoseamine-4-Sulfatase, Tip VII için betaglucronidase) düzeyleri;'});
CREATE (sec_2312)-[:HAS_PARAGRAPH {order: 0}]->(para_2313);
CREATE (para_2314:Paragraph {id: '2', content: 'İdrar glikozaminoglikan analizinde hastalık tipine özgü glikozaminoglikan analizi (Tip I ve Tip II için heparan ve dermatan sülfat, Tip IVA için keratan sülfat ve kondroidin sülfat, Tip VI için dermatan sülfat, Tip VII için kondroidin sülfat, heparan ve dermatan sülfat);'});
CREATE (sec_2312)-[:HAS_PARAGRAPH {order: 1}]->(para_2314);
CREATE (para_2313)-[:NEXT_PARAGRAPH]->(para_2314);
CREATE (para_2315:Paragraph {id: '3', content: 'Moleküler genetik analiz sonuçları (Tip I için IDUA geni, Tip II için IDS geni, Tip IVA için GALNS geni, Tip VI için ARSB geni, Tip VII için GUSB geni) yukarıda belirtilen analiz sonuçlarından en az ikisinin hastalıkla uyumlu olması ve ilaç raporunda sonuçların belirtilmesi gerekmektedir. Tip II, IVA ve VI hastalarında; multiple sülfataz eksikliği enzimatik ya da moleküler genetik analiz sonuçları ile dışlanmış olmalıdır.'});
CREATE (sec_2312)-[:HAS_PARAGRAPH {order: 2}]->(para_2315);
CREATE (para_2314)-[:NEXT_PARAGRAPH]->(para_2315);
CREATE (sec_2316:Subsection {id: '4.2.10.C-2', title: 'Enzim tedavisine başlama ve sonlandırma kriterleri'});
CREATE (sec_2311)-[:HAS_SUBSECTION {order: 1}]->(sec_2316);
CREATE (sec_2312)-[:NEXT_SUBSECTION]->(sec_2316);
CREATE (sec_2317:Subsection {id: '4.2.10.C-3', title: 'Rapor ve reçeteleme koşulları'});
CREATE (sec_2311)-[:HAS_SUBSECTION {order: 2}]->(sec_2317);
CREATE (para_2318:Paragraph {id: '1', content: 'Çocuk ve erişkin hastalar için; en az birisi çocuk metabolizma, çocuk endokrinolojisi ve metabolizma hastalıkları olmak üzere çocuk metabolizma, çocuk endokrinolojisi ve metabolizma, endokrinoloji ve metabolizma hastalıkları uzman hekimlerinin yer aldığı üçüncü basamak resmi sağlık hizmeti sunucularında 1 yıl süreli sağlık kurulu raporu düzenlenir. Raporda; teşhis, başlangıç ve devam kriter/kriterleri ile ilgili tüm bilgiler yer alır. Bu rapora dayanılarak çocuk metabolizma, çocuk endokrinolojisi ve metabolizma veya endokrinoloji ve metabolizma hastalıkları uzman hekimlerince, bu hekimlerin bulunmadığı yerlerde ise çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimlerince reçete düzenlenir.'});
CREATE (sec_2317)-[:HAS_PARAGRAPH {order: 0}]->(para_2318);
CREATE (para_2319:Paragraph {id: '2', content: 'Hastanın takip ve tedavi edildiği sağlık kurumlarında, hastalar adına dosyalar açılacak ve tüm bilgiler bu dosyada muhafaza edilecektir.'});
CREATE (sec_2317)-[:HAS_PARAGRAPH {order: 1}]->(para_2319);
CREATE (para_2318)-[:NEXT_PARAGRAPH]->(para_2319);
CREATE (sec_2316)-[:NEXT_SUBSECTION]->(sec_2317);
CREATE (sec_2291)-[:NEXT_SUBSECTION]->(sec_2311);
CREATE (sec_2320:Subsection {id: '4.2.10.Ç', title: 'Pompe Hastalığı tedavi esasları'});
CREATE (sec_2247)-[:HAS_SUBSECTION {order: 3}]->(sec_2320);
CREATE (para_2321:Paragraph {id: '1', content: 'Periferik kandan veya dokudan enzim (α-glucosidase) düzeyinin veya mutasyon analiz sonuçlarının hastalıkla uyumlu olmasına göre tanı konulmuş olmalıdır.'});
CREATE (sec_2320)-[:HAS_PARAGRAPH {order: 0}]->(para_2321);
CREATE (sec_2322:Subsection {id: '4.2.10.Ç-1', title: 'Enzim tedavi kriterleri'});
CREATE (sec_2320)-[:HAS_SUBSECTION {order: 0}]->(sec_2322);
CREATE (para_2323:Paragraph {id: '1', content: 'İki yaş ve altındaki tüm hastaların tedavisine doğrudan başlanır.'});
CREATE (sec_2322)-[:HAS_PARAGRAPH {order: 0}]->(para_2323);
CREATE (para_2324:Paragraph {id: '2', content: 'İki yaş üstündeki hastalarda ise yaşam kalitesini bozacak derecede kas veya solunum sistemi veya kalp tutulumunun olması durumunda enzim replasman tedavisi başlanır.'});
CREATE (sec_2322)-[:HAS_PARAGRAPH {order: 1}]->(para_2324);
CREATE (para_2323)-[:NEXT_PARAGRAPH]->(para_2324);
CREATE (sec_2325:Subsection {id: '4.2.10.Ç-2', title: 'Rapor ve reçeteleme koşulları'});
CREATE (sec_2320)-[:HAS_SUBSECTION {order: 1}]->(sec_2325);
CREATE (para_2326:Paragraph {id: '1', content: 'Hasta adına, gastroenteroloji, çocuk metabolizma (Ek:RG-09/09/2017-30175/19-ç md. Yürürlük: 23/09/2017), çocuk endokrinolojisi ve metabolizma hastalıkları veya nöroloji uzman hekimlerinden en az birinin yer aldığı sağlık kurulu raporu düzenlenir. Raporda; teşhis, başlangıç ve devam kriter/kriterleri ile ilgili tüm bilgiler yer alır. Rapor süresi 1 yıldır. Bu 91 rapora dayanılarak yine bu hekimlerce, bu hekimlerin bulunmadığı yerlerde ise çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimlerince reçete düzenlenir.'});
CREATE (sec_2325)-[:HAS_PARAGRAPH {order: 0}]->(para_2326);
CREATE (para_2327:Paragraph {id: '2', content: 'Hastanın takip ve tedavi edildiği sağlık kurumlarında, hastalar adına dosyalar açılacak ve tüm bilgiler bu dosyada muhafaza edilecektir.'});
CREATE (sec_2325)-[:HAS_PARAGRAPH {order: 1}]->(para_2327);
CREATE (para_2326)-[:NEXT_PARAGRAPH]->(para_2327);
CREATE (sec_2322)-[:NEXT_SUBSECTION]->(sec_2325);
CREATE (sec_2311)-[:NEXT_SUBSECTION]->(sec_2320);
CREATE (sec_2328:Subsection {id: '4.2.10.D', title: 'Niemann-Pick Tip C Hastalığı tedavi esasları'});
CREATE (sec_2247)-[:HAS_SUBSECTION {order: 4}]->(sec_2328);
CREATE (para_2329:Paragraph {id: '1', content: 'Filipin Boyası veya moleküler analiz veya fonksiyonel çalışma ile Niemann-Pick Tip C tanısı kesinleşmiş olmalıdır.'});
CREATE (sec_2328)-[:HAS_PARAGRAPH {order: 0}]->(para_2329);
CREATE (sec_2330:Subsection {id: '4.2.10.D-1', title: 'Tedavi kriterleri'});
CREATE (sec_2328)-[:HAS_SUBSECTION {order: 0}]->(sec_2330);
CREATE (para_2331:Paragraph {id: '1', content: 'Niemann-Pick Tip C tanısı kesinleştirilen ve nörolojik bulgusu saptanan her hastada tedaviye başlanır.'});
CREATE (sec_2330)-[:HAS_PARAGRAPH {order: 0}]->(para_2331);
CREATE (para_2332:Paragraph {id: '2', content: 'Tedavinin başlangıcından itibaren 6 ncı ayın sonunda nörolojik bulguları başlangıca göre stabil kalan veya düzelme görülen hastalarda tedaviye devam edilir.'});
CREATE (sec_2330)-[:HAS_PARAGRAPH {order: 1}]->(para_2332);
CREATE (para_2331)-[:NEXT_PARAGRAPH]->(para_2332);
CREATE (sec_2333:Subsection {id: '4.2.10.D-2', title: 'Rapor ve reçeteleme koşulları'});
CREATE (sec_2328)-[:HAS_SUBSECTION {order: 1}]->(sec_2333);
CREATE (para_2334:Paragraph {id: '1', content: 'Hasta adına, gastroenteroloji, çocuk metabolizma (Ek:RG-09/09/2017-30175/19-d md. Yürürlük: 23/09/2017), çocuk endokrinolojisi ve metabolizma hastalıkları veya nöroloji uzman hekimlerinden en az birinin yer aldığı sağlık kurulu raporu düzenlenir. Raporda; teşhis, başlangıç ve devam kriter/kriterleri ile ilgili tüm bilgiler yer alır. Rapor süresi 6 aydır. Bu rapora dayanılarak yine bu hekimlerce, bu hekimlerin bulunmadığı yerlerde ise çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimlerince reçete düzenlenir.'});
CREATE (sec_2333)-[:HAS_PARAGRAPH {order: 0}]->(para_2334);
CREATE (para_2335:Paragraph {id: '2', content: 'Hastanın takip ve tedavi edildiği sağlık kurumlarında, hastalar adına dosyalar açılacak ve tüm bilgiler bu dosyada muhafaza edilecektir. 4 (Mülga: RG- 25/09/2024-32673/ 7-b md. Yürürlük: 03/10/2024)'});

// Batch 63
CREATE (sec_2333)-[:HAS_PARAGRAPH {order: 1}]->(para_2335);

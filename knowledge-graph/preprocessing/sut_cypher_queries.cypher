CREATE (sec_1511:Subsection {id: '3.3.19', title: 'Damar kapama ve kesme probu ve ultrasonik cerrahi problar'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 18}]->(sec_1511);
CREATE (para_1512:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-m md. Yürürlük: 24/03/2023) kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_1511)-[:HAS_PARAGRAPH {order: 0}]->(para_1512);
CREATE (sec_1507)-[:NEXT_SUBSECTION]->(sec_1511);
CREATE (sec_1513:Subsection {id: '3.3.20', title: 'Burun protezi'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 19}]->(sec_1513);
CREATE (para_1514:Paragraph {id: '1', content: 'Total burun defektlerinin rekonstrüksiyonu veya epitezin yenilenmesine gerek duyulduğu hallerde üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-n md. Yürürlük:24/03/2023) sağlık kurulu raporuna istinaden bedeli Kurumca karşılanır.'});
CREATE (sec_1513)-[:HAS_PARAGRAPH {order: 0}]->(para_1514);
CREATE (sec_1511)-[:NEXT_SUBSECTION]->(sec_1513);
CREATE (sec_1515:Subsection {id: '3.3.21', title: 'Dura yapıştırıcı'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 20}]->(sec_1515);
CREATE (para_1516:Paragraph {id: '1', content: 'BOS fistülü olan vakalarda bedeli Kurumca karşılanır.'});
CREATE (sec_1515)-[:HAS_PARAGRAPH {order: 0}]->(para_1516);
CREATE (sec_1513)-[:NEXT_SUBSECTION]->(sec_1515);
CREATE (sec_1517:Subsection {id: '3.3.22', title: 'Sentetik menisküs implantları'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 21}]->(sec_1517);
CREATE (para_1518:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-o md. Yürürlük: 24/03/2023) uygulanması şartıyla, 45 (kırk beş) yaş altında, subtotal menisektomi sonrası en az 1 (bir) yıl geçmesine rağmen konvansiyonel tedavi yöntemleri ile ağrısı azalmayan vakalarda bedelleri Kurumca karşılanır.'});
CREATE (sec_1517)-[:HAS_PARAGRAPH {order: 0}]->(para_1518);
CREATE (sec_1515)-[:NEXT_SUBSECTION]->(sec_1517);
CREATE (sec_1519:Subsection {id: '3.3.23', title: 'Menisküs tamiri ürünleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 22}]->(sec_1519);
CREATE (para_1520:Paragraph {id: '1', content: '55 yaş altı vaka grubunda, eğitim verme yetkisi bulunan üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-ö md. Yürürlük:24/03/2023) 3 (üç) ortopedi ve travmatoloji uzmanı tarafından sağlık kurulu raporu düzenlenmesi şartıyla, “Nitinol/Tek Barlı/Çok İmplantlı” malzemeler en fazla 1 (bir) adet, “Çift Barlı” malzemeler en fazla 2 (iki) adet olmak üzere; Kıkırdak tamir teknikleri ile onarılabilir derecede kıkırdak lezyonu olan veya kıkırdak lezyonu olmadığı halde dejeneratif olmayan Zon-1 ve Zon-2 menisküs yırtığı olan vakalarda bedelleri Kurumca karşılanır.'});
CREATE (sec_1519)-[:HAS_PARAGRAPH {order: 0}]->(para_1520);
CREATE (sec_1517)-[:NEXT_SUBSECTION]->(sec_1519);
CREATE (sec_1521:Subsection {id: '3.3.24', title: 'Sinüs tarsi vidası'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 23}]->(sec_1521);
CREATE (para_1522:Paragraph {id: '1', content: 'Esnek, ağrılı, 8-14 yaş (8 ve 14 dahil) vaka grubunda eğitim verme yetkisi bulunan üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-p md. Yürürlük:24/03/2023) kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_1521)-[:HAS_PARAGRAPH {order: 0}]->(para_1522);
CREATE (sec_1519)-[:NEXT_SUBSECTION]->(sec_1521);
CREATE (sec_1523:Subsection {id: '3.3.25', title: 'Absorbe olabilir omuz balon spacer'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 24}]->(sec_1523);
CREATE (para_1524:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-r md. Yürürlük: 24/03/2023) uygulanması şartıyla, tamir edilemeyen tam kat Rotator cuff yırtıklarında kullanıldığının sağlık kurulu raporu ile belgelendirilmesi halinde ve cerrahi olarak yerleştirilen başka bir tıbbi malzeme kullanılmaması kaydıyla, işlem başına en fazla 1 (bir) adet kullanılması halinde bedeli Kurumca karşılanır.'});
CREATE (sec_1523)-[:HAS_PARAGRAPH {order: 0}]->(para_1524);
CREATE (sec_1521)-[:NEXT_SUBSECTION]->(sec_1523);
CREATE (sec_1525:Subsection {id: '3.3.26', title: 'Tümör protezleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 25}]->(sec_1525);
CREATE (para_1526:Paragraph {id: '1', content: 'EK-3/F-3 “Ortopedi ve Travmatoloji Branşı Tümör ve Rezeksiyon Alan Grubuna Ait Tıbbi Malzemeler Listesi” nde bulunan protezlerin, aşağıda yer alan geri ödeme kural ve/veya kriterlerine uygun olmak üzere, eğitim verme yetkisi bulunan üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-s md. Yürürlük:24/03/2023) kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_1525)-[:HAS_PARAGRAPH {order: 0}]->(para_1526);
CREATE (item_1527:Item {id: 'a', content: 'Saddle protezlerin aşağıdaki kriterlerin en az birinin varlığı halinde bedelleri Kurumca karşılanır:'});
CREATE (para_1526)-[:HAS_ITEM {order: 0}]->(item_1527);
CREATE (subitem_1528:SubItem {id: '1', content: 'Periasetabüler rezeksiyonlar (Tip 2, Tip 2/3) kemiğin primer tümörü ya da metastazları,'});
CREATE (item_1527)-[:HAS_SUBITEM {order: 0}]->(subitem_1528);
CREATE (subitem_1529:SubItem {id: '2', content: 'Travmaya sekonder periasetabüler kemik kayıpları,'});
CREATE (item_1527)-[:HAS_SUBITEM {order: 1}]->(subitem_1529);
CREATE (subitem_1528)-[:NEXT_SUBITEM]->(subitem_1529);
CREATE (subitem_1530:SubItem {id: '3', content: 'Kalça displazisine bağlı periasetabüler kemik kayıpları,'});
CREATE (item_1527)-[:HAS_SUBITEM {order: 2}]->(subitem_1530);
CREATE (subitem_1529)-[:NEXT_SUBITEM]->(subitem_1530);
CREATE (subitem_1531:SubItem {id: '4', content: 'Periasetabüler kemik kayıplarının olduğu multiple kalça revizyonları sonrası.'});
CREATE (item_1527)-[:HAS_SUBITEM {order: 3}]->(subitem_1531);
CREATE (subitem_1530)-[:NEXT_SUBITEM]->(subitem_1531);
CREATE (item_1532:Item {id: 'b', content: 'Proksimal femur rezeksiyon protezlerinin aşağıdaki kriterlerin en az birinin varlığı halinde bedelleri Kurumca karşılanır:'});
CREATE (para_1526)-[:HAS_ITEM {order: 1}]->(item_1532);
CREATE (subitem_1533:SubItem {id: '1', content: 'Kemiğin primer malign veya agresif benign (eklem bütünlüğü korunamayacak olgularda) tümörleri,'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 0}]->(subitem_1533);
CREATE (subitem_1534:SubItem {id: '2', content: 'Proksimal femur yüksek doz radyoterapi sonrası oluşan kırıklar,'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 1}]->(subitem_1534);
CREATE (subitem_1533)-[:NEXT_SUBITEM]->(subitem_1534);
CREATE (subitem_1535:SubItem {id: '3', content: 'Kemiğin sekonder malign tümörleri,'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 2}]->(subitem_1535);
CREATE (subitem_1534)-[:NEXT_SUBITEM]->(subitem_1535);
CREATE (subitem_1536:SubItem {id: '4', content: 'Kalça protezi multiple revizyonları (kemik kaybı olan),'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 3}]->(subitem_1536);
CREATE (subitem_1535)-[:NEXT_SUBITEM]->(subitem_1536);
CREATE (subitem_1537:SubItem {id: '5', content: 'Parçalı proksimal femur kırığı multiple girişimler (3 ve üzeri),'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 4}]->(subitem_1537);
CREATE (subitem_1536)-[:NEXT_SUBITEM]->(subitem_1537);
CREATE (subitem_1538:SubItem {id: '6', content: 'Yumuşak doku malign tümörlerinin kemiği tuttuğu olgular,'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 5}]->(subitem_1538);
CREATE (subitem_1537)-[:NEXT_SUBITEM]->(subitem_1538);
CREATE (subitem_1539:SubItem {id: '7', content: 'İyileşmiş kemik enfeksiyonları sonucu ileri kemik kayıpları,'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 6}]->(subitem_1539);
CREATE (subitem_1538)-[:NEXT_SUBITEM]->(subitem_1539);
CREATE (subitem_1540:SubItem {id: '8', content: 'Rezeksiyon artroplasti sonrası femur rekonstrüksiyonları.'});
CREATE (item_1532)-[:HAS_SUBITEM {order: 7}]->(subitem_1540);

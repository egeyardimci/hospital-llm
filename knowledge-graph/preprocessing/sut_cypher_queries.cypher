CREATE (sec_1433:Subsection {id: '3.3.9', title: 'Kronik venöz hastalıklar için bası giysileri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 8}]->(sec_1433);
CREATE (para_1434:Paragraph {id: '1', content: 'Genel cerrahi, dermatoloji, plastik, rekonstrüktif ve estetik cerrahi, kalp damar cerrahi, fizik tedavi ve rehabilitasyon uzman hekimlerden birinin bulunduğu sağlık kurulu raporlarına istinaden tüm hekimlerce reçete edilmesi halinde; tüm evrelerde bedelleri Kurumca karşılanır.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 0}]->(para_1434);
CREATE (para_1435:Paragraph {id: '2', content: 'Sağlık kurulu raporu ekinde; venöz sistem doppler ultrasonografi raporu ekte olmalıdır.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 1}]->(para_1435);
CREATE (para_1434)-[:NEXT_PARAGRAPH]->(para_1435);
CREATE (para_1436:Paragraph {id: '3', content: 'Standart bedenler üzerinden bedeli Kurumca karşılanır.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 2}]->(para_1436);
CREATE (para_1435)-[:NEXT_PARAGRAPH]->(para_1436);
CREATE (para_1437:Paragraph {id: '4', content: 'Rapor geçerlilik süresi 2 (iki) yıldır.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 3}]->(para_1437);
CREATE (para_1436)-[:NEXT_PARAGRAPH]->(para_1437);
CREATE (para_1438:Paragraph {id: '5', content: 'İlgili hekimce uygun görülmesi halinde 6 (altı) ay arayla olmak şartıyla yılda en fazla 2 (iki) kez reçete edilebilir.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 4}]->(para_1438);
CREATE (para_1437)-[:NEXT_PARAGRAPH]->(para_1438);
CREATE (para_1439:Paragraph {id: '6', content: 'Hastaya alerjik veya toksik etki göstermemelidir.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 5}]->(para_1439);
CREATE (para_1438)-[:NEXT_PARAGRAPH]->(para_1439);
CREATE (para_1440:Paragraph {id: '7', content: 'Hastalığın evresine göre ortalama 15 mmHg ve üzeri basınç uygulamalı, kullanım süresinin sonuna kadar bu basıncı en az yarısını sağlayabilmelidir.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 6}]->(para_1440);
CREATE (para_1439)-[:NEXT_PARAGRAPH]->(para_1440);
CREATE (para_1441:Paragraph {id: '8', content: 'İç yüzeyi hastada bası yaralarına yol açmayacak tarzda dikişsiz, pürüzsüz olmalıdır. Hava geçirgen özelliği olan kumaştan imal edilmelidir.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 7}]->(para_1441);
CREATE (para_1440)-[:NEXT_PARAGRAPH]->(para_1441);
CREATE (para_1442:Paragraph {id: '9', content: 'Alt ekstremite bası giysilerinde üst kısmının iç yüzeyinde kaymayı önleyecek silikon bant vb. olmalıdır.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 8}]->(para_1442);
CREATE (para_1441)-[:NEXT_PARAGRAPH]->(para_1442);
CREATE (para_1443:Paragraph {id: '10', content: 'Fermuar vb. aksesuarlar kullanılacaksa, hastaya zarar vermeyecek şekilde yerleştirilmeli ve kullanım süresi boyunca bozulmayacak yapıda olmalıdır.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 9}]->(para_1443);
CREATE (para_1442)-[:NEXT_PARAGRAPH]->(para_1443);
CREATE (para_1444:Paragraph {id: '11', content: 'Sık yıkanabilir kumaştan imal edilmelidir. Giysi yıkanma ile deforme olmamalı, boyutları değişmemeli ve yıkama talimatı hastaya verilmelidir.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 10}]->(para_1444);
CREATE (para_1443)-[:NEXT_PARAGRAPH]->(para_1444);
CREATE (para_1445:Paragraph {id: '12', content: 'Alt ekstremite bası giysisi ödeme göre çorap tarzı dize kadar, kasığa kadar veya külotlu olabilir.'});
CREATE (sec_1433)-[:HAS_PARAGRAPH {order: 11}]->(para_1445);
CREATE (para_1444)-[:NEXT_PARAGRAPH]->(para_1445);
CREATE (sec_1409)-[:NEXT_SUBSECTION]->(sec_1433);
CREATE (sec_1446:Subsection {id: '3.3.10', title: 'Sakral sinir stimülatörleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 9}]->(sec_1446);
CREATE (para_1447:Paragraph {id: '1', content: 'Sakral sinir stimülatörlerinin anal inkontinansta kullanımı: (Değişik: RG- 21/04/2024- 32524/ 11-a md. Yürürlük: 30/04/2024)'});
CREATE (sec_1446)-[:HAS_PARAGRAPH {order: 0}]->(para_1447);
CREATE (item_1448:Item {id: 'a', content: 'Eğitim kliniği olan üçüncü basamak resmi sağlık hizmeti sunucularında genel cerrahi, gastroenteroloji, nöroloji ve psikiyatri kliniklerince oluşturulacak konsey kararınca ve bu 4 (dört) branştan hekimin birlikte bulunduğu sağlık kurulu raporuna istinaden Kurumca bedeli karşılanır.'});
CREATE (para_1447)-[:HAS_ITEM {order: 0}]->(item_1448);
CREATE (item_1449:Item {id: 'b', content: 'Genel endikasyonlar; psikiyatri konsültasyonu ile belgelendirilmelidir, olmalıdır.'});
CREATE (para_1447)-[:HAS_ITEM {order: 1}]->(item_1449);
CREATE (subitem_1450:SubItem {id: '1', content: '75 (yetmiş beş) yaşın altındaki hastalarda kullanılmalıdır,'});
CREATE (item_1449)-[:HAS_SUBITEM {order: 0}]->(subitem_1450);
CREATE (subitem_1451:SubItem {id: '2', content: 'Hasta cihaz hakkında bilgilendirilmeli ve hastanın cihazı kullanabilecek bilişsel ve psikolojik yetide olduğu'});
CREATE (item_1449)-[:HAS_SUBITEM {order: 1}]->(subitem_1451);
CREATE (subitem_1450)-[:NEXT_SUBITEM]->(subitem_1451);
CREATE (subitem_1452:SubItem {id: '3', content: 'Kalıcı implantasyona geçmek için, test aşamasında klinik semptom ve bulgularda en az %50 azalma saptanmış'});
CREATE (item_1449)-[:HAS_SUBITEM {order: 2}]->(subitem_1452);
CREATE (subitem_1451)-[:NEXT_SUBITEM]->(subitem_1452);
CREATE (item_1448)-[:NEXT_ITEM]->(item_1449);
CREATE (item_1453:Item {id: 'c', content: 'Tıbbi endikasyonlar;'});
CREATE (para_1447)-[:HAS_ITEM {order: 2}]->(item_1453);
CREATE (subitem_1454:SubItem {id: '1', content: 'Medikal veya cerrahi tedaviye cevap vermeyen anal inkontinanslı hastalarda,'});
CREATE (item_1453)-[:HAS_SUBITEM {order: 0}]->(subitem_1454);
CREATE (subitem_1455:SubItem {id: '2', content: 'Medikal veya cerrahi sürecinin en az 6 (altı) ay devam ettiği hastalarda uygulanmalıdır.'});
CREATE (item_1453)-[:HAS_SUBITEM {order: 1}]->(subitem_1455);
CREATE (subitem_1454)-[:NEXT_SUBITEM]->(subitem_1455);
CREATE (item_1449)-[:NEXT_ITEM]->(item_1453);
CREATE (item_1456:Item {id: 'ç', content: 'Anal manometre, anal EMG, endoanal ultrason vb. tetkik sonuçlarının sağlık kurulu rapor ekinde yer alması gerekmektedir.'});
CREATE (para_1447)-[:HAS_ITEM {order: 3}]->(item_1456);
CREATE (item_1453)-[:NEXT_ITEM]->(item_1456);
CREATE (item_1457:Item {id: 'd', content: 'Konjenital anal rektal malformasyonlar, rektal prolapsus varlığı, inflamatuvar barsak hastalıklarında, kalıcı kolostomisi olan hastalarda ve gebelerde kullanıldığı takdirde bedeli Kurumca karşılanmaz. (Ek: RG- 21/04/2024- 32524/ 11-b md. Yürürlük: 30/04/2024)'});
CREATE (para_1447)-[:HAS_ITEM {order: 4}]->(item_1457);
CREATE (item_1456)-[:NEXT_ITEM]->(item_1457);
CREATE (para_1458:Paragraph {id: '2', content: 'Sakral sinir stimülatörlerinin üriner inkontinansta kullanımı:'});
CREATE (sec_1446)-[:HAS_PARAGRAPH {order: 1}]->(para_1458);
CREATE (item_1459:Item {id: 'a', content: 'Eğitim kliniği olan üçüncü basamak resmi sağlık hizmeti sunucularında üroloji, nöroloji ve psikiyatri kliniklerince oluşturulacak konsey kararınca ve bu 3 (üç) branştan hekimin birlikte bulunduğu sağlık kurulu raporuna istinaden Kurumca bedeli karşılanır.'});
CREATE (para_1458)-[:HAS_ITEM {order: 0}]->(item_1459);
CREATE (item_1460:Item {id: 'b', content: 'Genel Endikasyonlar; psikiyatri konsültasyonu ile belgelendirilmelidir, olmalıdır.'});
CREATE (para_1458)-[:HAS_ITEM {order: 1}]->(item_1460);
CREATE (subitem_1461:SubItem {id: '1', content: '75 (yetmiş beş) yaşın altındaki hastalarda kullanılmalıdır,'});
CREATE (item_1460)-[:HAS_SUBITEM {order: 0}]->(subitem_1461);
CREATE (subitem_1462:SubItem {id: '2', content: 'Hasta cihaz hakkında bilgilendirilmeli ve hastanın cihazı kullanabilecek bilişsel ve psikolojik yetide olup olmadığı'});
CREATE (item_1460)-[:HAS_SUBITEM {order: 1}]->(subitem_1462);
CREATE (subitem_1461)-[:NEXT_SUBITEM]->(subitem_1462);
CREATE (subitem_1463:SubItem {id: '3', content: 'Nöroloji konsültasyonu ile işeme bozukluğuna neden olabilecek bir bozukluğunun olmadığı belgelendirilmelidir,'});
CREATE (item_1460)-[:HAS_SUBITEM {order: 2}]->(subitem_1463);
CREATE (subitem_1462)-[:NEXT_SUBITEM]->(subitem_1463);
CREATE (subitem_1464:SubItem {id: '4', content: 'Kalıcı implantasyona geçmek için, test aşamasında klinik semptom ve bulgularda en az %50 azalma saptanmış'});
CREATE (item_1460)-[:HAS_SUBITEM {order: 3}]->(subitem_1464);
CREATE (subitem_1463)-[:NEXT_SUBITEM]->(subitem_1464);
CREATE (item_1459)-[:NEXT_ITEM]->(item_1460);
CREATE (item_1465:Item {id: 'c', content: 'Tıbbi endikasyonlar;'});
CREATE (para_1458)-[:HAS_ITEM {order: 2}]->(item_1465);
CREATE (subitem_1466:SubItem {id: '1', content: 'Kronik üriner retansiyonu'});
CREATE (item_1465)-[:HAS_SUBITEM {order: 0}]->(subitem_1466);
CREATE (item_1460)-[:NEXT_ITEM]->(item_1465);
CREATE (item_1467:Item {id: 'a', content: 'Bu sürecin en az 1 (bir) yıl devam ettiği hastalara uygulanmalıdır,'});
CREATE (para_1458)-[:HAS_ITEM {order: 3}]->(item_1467);
CREATE (item_1465)-[:NEXT_ITEM]->(item_1467);

// Batch 40
CREATE (item_1468:Item {id: 'b', content: 'Ürodinamik olarak 1- Mesane kapasitesi ve kompliyans normal olmalıdır, 2- İntravezikal obstrüksiyon olmamalıdır, 3- Detrüsör kontraksiyon bozukluğu olmalı ve bu durumun etyolojisinde miyojenik nedenler olmamalıdır. cevap vermeyen ve en az 2 (iki) yıldır izlemde olan hastalarda uygulanabilir. intravezikal tedavilere cevap vermeyen hastalara uygulanabilir. 60 3.3.11 Ayakta ağız ve diş tedavilerinde tıbbi malzeme temin/ödeme usul ve esasları'});
CREATE (para_1458)-[:HAS_ITEM {order: 4}]->(item_1468);
CREATE (subitem_1469:SubItem {id: '2', content: 'Refraktör idyopatik aşırı aktif mesane; antimuskarinik ve intradetrüsör botulinum toksin enjeksiyonu tedavisine'});
CREATE (item_1468)-[:HAS_SUBITEM {order: 0}]->(subitem_1469);
CREATE (subitem_1470:SubItem {id: '3', content: 'Ağrılı mesane sendromu (interstisyel sistit); bu tanıyı aldıktan sonra en az 2 (iki) yıl geçmiş ve yapılan tüm oral ve'});
CREATE (item_1468)-[:HAS_SUBITEM {order: 1}]->(subitem_1470);
CREATE (subitem_1469)-[:NEXT_SUBITEM]->(subitem_1470);
CREATE (item_1467)-[:NEXT_ITEM]->(item_1468);
CREATE (para_1447)-[:NEXT_PARAGRAPH]->(para_1458);
CREATE (para_1471:Paragraph {id: '1', content: 'Lokal anestezi altında, cerrahi tedavilerde kullanılan, greft, membran vb. iyileştirici nitelikteki tıbbi malzemeler (Kurumca bedeli karşılanmayacağı ayrıca belirtilen malzemeler ve SUT’ta belirtilen diğer istisnalar hariç) sağlık hizmeti sunucusu tarafından temin edilmek zorundadır. Bu malzemelerin reçete karşılığı hastaya aldırılması durumunda, fatura tutarı hastaya ödenerek ilgili sağlık hizmeti sunucusunun alacağından mahsup edilir.'});
CREATE (sec_1446)-[:HAS_PARAGRAPH {order: 2}]->(para_1471);
CREATE (para_1458)-[:NEXT_PARAGRAPH]->(para_1471);
CREATE (para_1472:Paragraph {id: '2', content: 'Bu kapsamdaki tıbbi malzemelerin bedelleri SUT’un 3.2.1.A ve 3.2.1.B maddelerinde belirtilen hükümler doğrultusunda Kurumca karşılanır.'});
CREATE (sec_1446)-[:HAS_PARAGRAPH {order: 3}]->(para_1472);
CREATE (para_1471)-[:NEXT_PARAGRAPH]->(para_1472);
CREATE (para_1473:Paragraph {id: '3', content: 'Greftler ve membranların bedelleri aynı sağlık hizmeti sunucusunda çalışan, en az (1) bir periodontoloji veya ağız diş çene cerrahisi uzman hekiminin yer aldığı 3 (üç) diş hekiminin imzası ile hazırlanan sağlık kurulu raporuna istinaden Kurumca karşılanır. Sağlık kurulu raporuna endikasyonu destekleyen operasyon öncesine ait radyograflar eklenir.'});
CREATE (sec_1446)-[:HAS_PARAGRAPH {order: 4}]->(para_1473);
CREATE (para_1472)-[:NEXT_PARAGRAPH]->(para_1473);
CREATE (para_1474:Paragraph {id: '4', content: 'Protez yapıştırıcıları, protez temizleme tabletleri, özel içerikli diş macunları vb. malzemelerin bedeli Kurumca karşılanmaz.'});
CREATE (sec_1446)-[:HAS_PARAGRAPH {order: 5}]->(para_1474);
CREATE (para_1473)-[:NEXT_PARAGRAPH]->(para_1474);
CREATE (sec_1433)-[:NEXT_SUBSECTION]->(sec_1446);
CREATE (sec_1475:Subsection {id: '3.3.11', title: 'Ayakta ağız ve diş tedavilerinde tıbbi malzeme temin/ödeme usul ve esasları ................................. 110'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 10}]->(sec_1475);
CREATE (sec_1446)-[:NEXT_SUBSECTION]->(sec_1475);
CREATE (sec_1476:Subsection {id: '3.3.12', title: 'Kulak kepçesi protezi'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 11}]->(sec_1476);
CREATE (para_1477:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-i md. Yürürlük: 24/03/2023) sağlık kurulu raporuna istinaden kulak, burun ve boğaz veya plastik, rekonstrüktif ve estetik cerrahi hekimlerince uygulanması halinde bedeli Kurumca karşılanır.'});
CREATE (sec_1476)-[:HAS_PARAGRAPH {order: 0}]->(para_1477);
CREATE (para_1478:Paragraph {id: '2', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-i md. Yürürlük: 24/03/2023) ilgili dal uzmanlarınca düzenlenecek sağlık kurulu raporuna istinaden kulak, burun ve boğaz veya plastik, rekonstrüktif ve estetik cerrahi hekimlerince gerekli durumlarda yenilenmesi halinde bedeli Kurumca karşılanır.'});
CREATE (sec_1476)-[:HAS_PARAGRAPH {order: 1}]->(para_1478);
CREATE (para_1477)-[:NEXT_PARAGRAPH]->(para_1478);
CREATE (sec_1475)-[:NEXT_SUBSECTION]->(sec_1476);
CREATE (sec_1479:Subsection {id: '3.3.13', title: 'Kıkırdak hücre kültürleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 12}]->(sec_1479);
CREATE (para_1480:Paragraph {id: '1', content: 'SUT eki “EK-2/B Hizmet Başı İşlem Puan Listesi” için 612731 veya 612975 SUT kodları, “EK-2/C Tanıya Dayalı İşlem Puan Listesi” için P612731 veya P612975 SUT kodları ile birlikte uygulanması ve üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-j md. Yürürlük:24/03/2023) (eğitim verme yetkisi olan klinik), Sağlık Bakanlığı “Ortopedi Bilimsel Danışma Kurulu” ndan her bir hasta için kullanılmasına onay alınması şartıyla bedelleri Kurumca karşılanacaktır.'});
CREATE (sec_1479)-[:HAS_PARAGRAPH {order: 0}]->(para_1480);
CREATE (sec_1476)-[:NEXT_SUBSECTION]->(sec_1479);
CREATE (sec_1481:Subsection {id: '3.3.14', title: 'Çift yüzlü yama (mesh)'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 13}]->(sec_1481);
CREATE (para_1482:Paragraph {id: '1', content: 'Karın içine veya göğüs duvarına bakan yüzeyi organlara yapışmayacak özellikte materyalden, karın duvarına karşılık gelen yüzeyi ise başlıca polipropilen olmak üzere emilmeyen ve doku ile entegrasyon sağlayan materyalden yapılmış olan protezler dahil, çift yüzlü yama (mesh) olarak kabul edilir.'});
CREATE (sec_1481)-[:HAS_PARAGRAPH {order: 0}]->(para_1482);
CREATE (para_1483:Paragraph {id: '2', content: 'Çift yüzlü yamalar (meshler) özellikli vakalarda ameliyat öncesinde hastanın karın duvarı defektinin görüntüsünün (fotoğraf veya bilgisayarlı tomografi gibi bir görüntüleme aracı kullanılarak) epikrize eklenmesi, kullanılacak meshin boyutu ve defektin boyutunun epikrizde ilişkilendirilmesi ile üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-k md. Yürürlük:24/03/2023) genel cerrahi, göğüs cerrahisi veya plastik ve rekonstrüktif cerrahi kliniklerince düzenlenecek sağlık kurulu raporu ile bedeli Kurumca karşılanır.'});
CREATE (sec_1481)-[:HAS_PARAGRAPH {order: 1}]->(para_1483);
CREATE (para_1482)-[:NEXT_PARAGRAPH]->(para_1483);
CREATE (para_1484:Paragraph {id: '3', content: 'Çift yüzlü yama (mesh);'});
CREATE (sec_1481)-[:HAS_PARAGRAPH {order: 2}]->(para_1484);
CREATE (item_1485:Item {id: 'a', content: 'Açık fıtık onarımlarında karın duvarının kapatılamadığı büyük defektlerin, büyük insizyonel hernilerin ve/veya büyük rekürren umbilikal hernilerin elektif onarımında,'});
CREATE (para_1484)-[:HAS_ITEM {order: 0}]->(item_1485);
CREATE (item_1486:Item {id: 'b', content: 'Laparoskopik teknikle yapılan insizyonel herni ve/veya ventral herni onarımlarında kullanılması,'});
CREATE (para_1484)-[:HAS_ITEM {order: 1}]->(item_1486);
CREATE (item_1485)-[:NEXT_ITEM]->(item_1486);
CREATE (item_1487:Item {id: 'c', content: 'Hiatus ve diyafragma hernilerinin açık ve laparoskopik onarımlarında kullanılması durumunda bedeli Kurumca karşılanır.'});
CREATE (para_1484)-[:HAS_ITEM {order: 2}]->(item_1487);
CREATE (item_1486)-[:NEXT_ITEM]->(item_1487);
CREATE (para_1483)-[:NEXT_PARAGRAPH]->(para_1484);
CREATE (para_1488:Paragraph {id: '4', content: 'Çift yüzlü yama (mesh), primer ve nüks inguinal ve/veya femoral fıtıkların açık ve laparoskopik onarımlarında, primer umbilikal ve/veya epigastrik hernilerin açık onarımlarında kullanılmaları durumunda bedeli Kurumca karşılanmaz.'});
CREATE (sec_1481)-[:HAS_PARAGRAPH {order: 3}]->(para_1488);
CREATE (para_1484)-[:NEXT_PARAGRAPH]->(para_1488);
CREATE (sec_1479)-[:NEXT_SUBSECTION]->(sec_1481);
CREATE (sec_1489:Subsection {id: '3.3.15', title: 'Trakeobronşiyal stentler'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 14}]->(sec_1489);
CREATE (para_1490:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında göğüs hastalıkları ve/veya göğüs cerrahisi uzmanlarınca düzenlenecek sağlık kurulu raporuna istinaden bedeli Kurumca karşılanır.'});
CREATE (sec_1489)-[:HAS_PARAGRAPH {order: 0}]->(para_1490);
CREATE (para_1491:Paragraph {id: '2', content: 'Trakeobronşiyal stentler;'});
CREATE (sec_1489)-[:HAS_PARAGRAPH {order: 1}]->(para_1491);
CREATE (item_1492:Item {id: 'a', content: 'Trakeobronşiyal malign darlıklarda (primer veya metastatik tümörlerin mikst ekzofitik veya dıştan bası ile oluşturabileceği hava yolu darlıkları gibi),'});
CREATE (para_1491)-[:HAS_ITEM {order: 0}]->(item_1492);
CREATE (item_1493:Item {id: 'b', content: 'Trakeobronşiyal benign darlıklarda (akciğer tranplantasyonu sonrası, entübasyon/trakeostomi sonrası, endobronşial tedavilerden sonra oluşabilen skar darlıkları, vasküler anomaliler veya büyük lenfadenopatilerin yaptığı dıştan basılar, trakeobronkomalazi, trakeal ağ, inflamasyon veya enfeksiyona bağlı hava yolu darlıkları gibi),'});
CREATE (para_1491)-[:HAS_ITEM {order: 1}]->(item_1493);
CREATE (item_1492)-[:NEXT_ITEM]->(item_1493);
CREATE (item_1494:Item {id: 'c', content: 'Trakea özefageal fistüllerde, kullanılmaları halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1491)-[:HAS_ITEM {order: 2}]->(item_1494);
CREATE (item_1493)-[:NEXT_ITEM]->(item_1494);
CREATE (para_1490)-[:NEXT_PARAGRAPH]->(para_1491);
CREATE (amend_1495:Amendment {content: '(Değişik: RG-12/12/2024-32750/4 md. Yürürlük: 20/12/2024)'});
CREATE (sec_1489)-[:HAS_AMENDMENT {order: 0}]->(amend_1495);
CREATE (sec_1481)-[:NEXT_SUBSECTION]->(sec_1489);
CREATE (sec_1496:Subsection {id: '3.3.16', title: 'Total yüz maskesi'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 15}]->(sec_1496);
CREATE (para_1497:Paragraph {id: '1', content: 'Noninvaziv mekanik ventilasyon ihtiyacı olan yüz deformiteli, yüz travmalı veya yüz yanığı olan ya da oronazal maskeye uyum sağlayamayan hastalarda kullanılması durumunda bedeli Kurumca karşılanır.'});
CREATE (sec_1496)-[:HAS_PARAGRAPH {order: 0}]->(para_1497);
CREATE (sec_1489)-[:NEXT_SUBSECTION]->(sec_1496);

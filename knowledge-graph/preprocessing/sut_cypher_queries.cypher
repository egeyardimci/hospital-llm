CREATE (sec_3506:Subsection {id: '4.2.47', title: 'Konjenital jeneralize lipodistrofi ve konjenital leptin eksikliği tanılarında metreleptin kullanım', content: 'ilkeleri;'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 46}]->(sec_3506);
CREATE (para_3507:Paragraph {id: '1', content: 'Konjenital jeneralize lipodistrofi tanısında; 2 yaş ve üzeri hastalarda, leptin düşüklüğü (erkeklerde <8 ng/ml; kadınlarda <12 ng/ml) bulunan ve jeneralize lipodistrofi kesin tanısının Manyetik Rezonans Görüntüleme yöntemi veya DEXA ile tespit edilmesi veya homozigot mutasyonun moleküler genetik tetkik ile tespit edilmesi halinde ve;'});
CREATE (sec_3506)-[:HAS_PARAGRAPH {order: 0}]->(para_3507);
CREATE (item_3508:Item {id: 'a', content: 'En az 6 ay düzenli diyet eşliğinde metformin veya glitazon içeren tedavi ile kombine günlük en az 1,5 ünite/kg insülin kullanımına rağmen HbA1c ≥ %8 olması,'});
CREATE (para_3507)-[:HAS_ITEM {order: 0}]->(item_3508);
CREATE (item_3509:Item {id: 'b', content: 'En az 6 ay düzenli fibrat grubu ilaçlar ile trigliserid düşürücü tedaviye rağmen Trigliserid > 300 mg/dl olması, kriterlerinden en az birinin sağlandığı vakalarda; üçüncü basamak resmi sağlık hizmeti sunucularında, çocuk endokrinoloji ve/veya çocuk metabolizma ve/veya çocuk endokrinoloji ve metabolizma ve/veya erişkin endokrinoloji ve metabolizma uzmanlarınca düzenlenecek 6 ay süreli sağlık kurulu raporu ile yine üçüncü basamak resmi sağlık hizmeti sunucularında bu uzmanlık dallarınca reçetelenerek tedaviye başlanır.'});
CREATE (para_3507)-[:HAS_ITEM {order: 1}]->(item_3509);
CREATE (item_3508)-[:NEXT_ITEM]->(item_3509);
CREATE (para_3510:Paragraph {id: '2', content: 'Konjenital leptin eksikliği tanısında; Erken başlangıçlı (1 yaştan önce) morbid obezitesi olan (2 yaşın altında boya göre vücut ağırlığı > %140, 2 yaş ve üzerinde Vücut Kitle İndeksi Standart Deviasyon Skoru > 3SDS olan) Leptin düzeyinin biyokimyasal olarak <2 ng/ml olduğu veya moleküler genetik tetkik ile Leptin geninde homozigot mutasyonun gösterildiği vakalarda; üçüncü basamak resmi sağlık hizmeti sunucularında çocuk endokrinoloji ve/veya çocuk metabolizma ve/veya çocuk endokrinoloji ve metabolizma ve/veya erişkin endokrinoloji ve metabolizma uzmanlarınca düzenlenecek 6 ay süreli sağlık kurulu raporu ile yine üçüncü basamak resmi sağlık hizmeti sunucularında bu uzmanlık dallarınca reçetelenerek tedaviye başlanır.'});
CREATE (sec_3506)-[:HAS_PARAGRAPH {order: 1}]->(para_3510);
CREATE (para_3507)-[:NEXT_PARAGRAPH]->(para_3510);
CREATE (para_3511:Paragraph {id: '3', content: 'Jeneralize lipodistrofi tanısında tedavinin devam kriterleri; Tedavinin başlamasının ardından 6 ay süreyle ilaç kullanımı sonrasında;'});
CREATE (sec_3506)-[:HAS_PARAGRAPH {order: 2}]->(para_3511);
CREATE (item_3512:Item {id: 'a', content: 'Başlangıç HbA1c düzeyinde en az 1,5 (%) düşüş olması ve bu düzeyin 6 aydan sonra da korunmaya devam edilmesi,'});
CREATE (para_3511)-[:HAS_ITEM {order: 0}]->(item_3512);
CREATE (item_3513:Item {id: 'b', content: 'Başlangıç trigliserid düzeyinde en az %30 oranında düşüş olması ve bu düzeyin 6 aydan sonra da korunmaya devam edilmesi, kriterlerinden en az birinin sağlandığı vakalarda üçüncü basamak resmi sağlık hizmeti sunucularında, çocuk endokrinoloji ve/veya çocuk metabolizma ve/veya çocuk endokrinoloji ve metabolizma ve/veya erişkin endokrinoloji ve metabolizma uzmanlarınca düzenlenecek 6 ay süreli sağlık kurulu raporu ile yine üçüncü basamak resmi sağlık hizmeti sunucularında bu uzmanlık dallarınca reçetelenerek tedaviye devam edilir.'});
CREATE (para_3511)-[:HAS_ITEM {order: 1}]->(item_3513);
CREATE (item_3512)-[:NEXT_ITEM]->(item_3513);
CREATE (para_3510)-[:NEXT_PARAGRAPH]->(para_3511);
CREATE (amend_3514:Amendment {content: '(Değişik:RG-16/03/2023-32134/34 md.Yürürlük:24/03/2023)'});

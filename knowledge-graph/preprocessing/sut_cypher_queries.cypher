CREATE (sec_1204:Section {id: '3.2', title: 'Tıbbi malzeme ödeme esasları'});
CREATE (doc_1)-[:HAS_SECTION {order: 18}]->(sec_1204);
CREATE (sec_1205:Subsection {id: '3.2.1', title: 'Yatarak tedavilerde tıbbi malzeme bedellerinin ödenmesi'});
CREATE (sec_1204)-[:HAS_SUBSECTION {order: 0}]->(sec_1205);
CREATE (sec_1206:Subsection {id: '3.2.1.A', title: 'Kamu İhale Kanununa tabi olan resmi sağlık hizmeti sunucularında;'});
CREATE (sec_1205)-[:HAS_SUBSECTION {order: 0}]->(sec_1206);
CREATE (para_1207:Paragraph {id: '1', content: 'SUT eki listelerde yer alan tıbbi malzemelerin temin edilmesi halinde, bu listelerdeki birim fiyatlar, sağlık hizmeti sunucuları tarafından hangi fiyatlara temin edildiğine bakılmaksızın geri ödemede esas alınacak olan fiyatlardır. Bu fiyatlara Kurum bilgi işlem sistemi tarafından %12 işletme gideri ilave edilir. Kurum tarafından SUT eki listelerde yer almayan tıbbi malzemeler için sözleşme yapılarak bedeli karşılanan tıbbi malzemelerin geri ödemede esas alınacak fiyatları ise sözleşmede belirtilen fiyatlar olup; sözleşmede yer alan bu fiyatları aşmamak üzere Kuruma fatura edilir.'});
CREATE (sec_1206)-[:HAS_PARAGRAPH {order: 0}]->(para_1207);
CREATE (para_1208:Paragraph {id: '2', content: 'SUT eki listelerde yer almayan tıbbi malzemelerin fatura edilmesi halinde bedelleri Kurumca karşılanmaz. Ancak, alım tarihi ve/veya 4734 sayılı Kanun kapsamında kesinleşen ihale karar tarihi 1/10/2014 tarihinden önce olmak kaydıyla, SUT eki EK-3/A listesi kapsamında değerlendirilecek ürünler için 1/7/2015 tarihine kadar bu şart aranmaz. Bu kapsamda değerlendirilmekle birlikte SUT eki EK-3/A listesinde tanımlanmayan tıbbi malzemeler alış fiyatı ile fatura edilir, alış fiyatının üzerine Kurum bilgi işlem sistemi tarafından %15 işletme gideri ile Hazine kesintisi, Sosyal Hizmetler ve Çocuk Esirgeme Kurumu kesintisi ilave edilerek bedelleri Kurumca karşılanır.'});
CREATE (sec_1206)-[:HAS_PARAGRAPH {order: 1}]->(para_1208);
CREATE (para_1207)-[:NEXT_PARAGRAPH]->(para_1208);
CREATE (para_1209:Paragraph {id: '3', content: 'Bu madde kapsamındaki sağlık hizmeti sunucularından Kurumca belirlenecek olanların tıbbi malzeme ihtiyaçlarını karşılamak üzere Kurum tıbbi malzeme satış merkezleriyle sözleşme yapabilir. Tıbbi malzeme satış merkezleri Kurumun belirlediği tıbbi malzeme alan tanımları için SUT fiyatları üzerinden Kurumun belirlediği oranda iskonto yapar. Kurum her bir tıbbi malzeme alan tanımı için ayrı ayrı iskonto oranı belirleyebilir. Herhangi bir tıbbi malzeme alan tanımı için tıbbi malzeme satış merkezlerine ödenecek olan tutar, aynı tıbbi malzeme alan tanımının SUT’ta belirlenen fiyatlarının Kuruma maliyetini geçemez.'});
CREATE (sec_1206)-[:HAS_PARAGRAPH {order: 2}]->(para_1209);
CREATE (para_1208)-[:NEXT_PARAGRAPH]->(para_1209);
CREATE (sec_1210:Subsection {id: '3.2.1.B', title: 'Kamu İhale Kanununa tabi olmayan resmi sağlık hizmeti sunucularında;'});
CREATE (sec_1205)-[:HAS_SUBSECTION {order: 1}]->(sec_1210);
CREATE (para_1211:Paragraph {id: '1', content: 'SUT eki listelerde yer alan tıbbi malzemelerin temin edilmesi halinde, bu listelerdeki birim fiyatlar, sağlık hizmeti sunucuları tarafından hangi fiyatlara temin edildiğine bakılmaksızın geri ödemede esas alınacak olan fiyatlardır. Bu fiyatlara Kurum bilgi işlem sistemi tarafından %12 işletme gideri ilave edilir. Kurum bilgi işlem sistemi tarafından KDV, Hazine kesintisi, Sosyal Hizmetler ve Çocuk Esirgeme Kurumu kesintisi ilave edilmeksizin Kurumca bedelleri karşılanır.'});
CREATE (sec_1210)-[:HAS_PARAGRAPH {order: 0}]->(para_1211);
CREATE (para_1212:Paragraph {id: '2', content: 'SUT eki listelerde yer almayan tıbbi malzemelerin fatura edilmesi halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1210)-[:HAS_PARAGRAPH {order: 1}]->(para_1212);
CREATE (para_1211)-[:NEXT_PARAGRAPH]->(para_1212);
CREATE (sec_1206)-[:NEXT_SUBSECTION]->(sec_1210);
CREATE (sec_1213:Subsection {id: '3.2.1.C', title: 'İkinci ve üçüncü basamak özel sağlık hizmeti sunucularında;'});
CREATE (sec_1205)-[:HAS_SUBSECTION {order: 2}]->(sec_1213);
CREATE (para_1214:Paragraph {id: '1', content: 'SUT eki listelerde yer alan tıbbi malzemelerin temin edilmesi halinde, bu listelerdeki birim fiyatlar, sağlık hizmeti sunucuları tarafından hangi fiyatlara temin edildiğine bakılmaksızın geri ödemede esas alınacak olan fiyatlardır. Kurum bilgi işlem sistemine girilen KDV oranında bedel ilave edilerek Kurumca bedelleri karşılanır.'});
CREATE (sec_1213)-[:HAS_PARAGRAPH {order: 0}]->(para_1214);
CREATE (para_1215:Paragraph {id: '2', content: 'SUT eki listelerde yer almayan tıbbi malzemelerin fatura edilmesi halinde bedelleri Kurumca karşılanmaz.'});

// Batch 33
CREATE (sec_1213)-[:HAS_PARAGRAPH {order: 1}]->(para_1215);
CREATE (para_1214)-[:NEXT_PARAGRAPH]->(para_1215);
CREATE (sec_1210)-[:NEXT_SUBSECTION]->(sec_1213);
CREATE (sec_1216:Subsection {id: '3.2.2', title: 'Ayakta tedavilerde tıbbi malzeme bedellerinin ödenmesi'});
CREATE (sec_1204)-[:HAS_SUBSECTION {order: 1}]->(sec_1216);
CREATE (para_1217:Paragraph {id: '1', content: 'SUT eki EK-3/C listelerinde yer alan tıbbi malzemeler belirlenen fiyatları aşmamak üzere fatura tutarı üzerinden ödenir.'});
CREATE (sec_1216)-[:HAS_PARAGRAPH {order: 0}]->(para_1217);
CREATE (para_1218:Paragraph {id: '2', content: 'SUT’ta yer alan ancak, fiyatı SUT eki EK-3/C listelerinde yer almayan tıbbi malzemelerin bedelleri, piyasa araştırması (her türlü fiyat araştırması) yapılarak taşra teşkilatı inceleme birimlerince benzer nitelikte, aynı işlevsel özellikte ve aynı tıbbi sonucu verdiği kabul edilen tıbbi malzemelerden en düşük olanının fiyatı esas alınarak fatura tutarını aşmamak üzere Kurumca karşılanır.'});
CREATE (sec_1216)-[:HAS_PARAGRAPH {order: 1}]->(para_1218);
CREATE (para_1217)-[:NEXT_PARAGRAPH]->(para_1218);
CREATE (sec_1205)-[:NEXT_SUBSECTION]->(sec_1216);
CREATE (sec_1219:Subsection {id: '3.2.3', title: 'Sözleşmesiz sağlık hizmeti sunucularında tıbbi malzeme bedellerinin ödenmesi'});
CREATE (sec_1204)-[:HAS_SUBSECTION {order: 2}]->(sec_1219);
CREATE (para_1220:Paragraph {id: '1', content: 'Kurum ile sözleşmesiz sağlık hizmeti sunucularınca acil haller nedeniyle kullanılan ve SUT’un 2.3 maddesi doğrultusunda Kurumca karşılanması gereken tıbbi malzeme bedelleri, şahıs ödemesi olarak SUT hükümleri doğrultusunda Kurumca karşılanır.'});
CREATE (sec_1219)-[:HAS_PARAGRAPH {order: 0}]->(para_1220);
CREATE (sec_1216)-[:NEXT_SUBSECTION]->(sec_1219);
CREATE (sec_1072)-[:NEXT_SECTION]->(sec_1204);
CREATE (sec_1221:Section {id: '3.3', title: 'Bazı tıbbi malzemelerin temin edilme esasları'});
CREATE (doc_1)-[:HAS_SECTION {order: 19}]->(sec_1221);
CREATE (sec_1222:Subsection {id: '3.3.1', title: 'Yara bakım ürünleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 0}]->(sec_1222);
CREATE (para_1223:Paragraph {id: '1', content: 'Yara bakım ürünlerinin bedelleri, sağlık kurulu raporuna istinaden Kurumca karşılanır.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 0}]->(para_1223);
CREATE (para_1224:Paragraph {id: '2', content: 'Yara bakım ürünleri için düzenlenecek sağlık kurulu raporları;'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 1}]->(para_1224);
CREATE (item_1225:Item {id: 'a', content: 'Yatarak tedavide; takip ve tedaviyi yapan uzman hekim ile genel cerrahi, geriatri, ortopedi ve travmatoloji ve plastik, rekonstrüktif ve estetik cerrahi uzman hekimlerinden en az birinin yer aldığı sağlık kurullarınca düzenlenecektir. 53'});
CREATE (para_1224)-[:HAS_ITEM {order: 0}]->(item_1225);
CREATE (item_1226:Item {id: 'b', content: 'Ayakta tedavide; resmi sağlık hizmeti sunucularında genel cerrahi, ortopedi ve travmatoloji, plastik, rekonstrüktif ve estetik cerrahi, geriatri uzman hekimlerinden en az birinin yer aldığı sağlık kurullarınca düzenlenecektir.'});
CREATE (para_1224)-[:HAS_ITEM {order: 1}]->(item_1226);
CREATE (item_1225)-[:NEXT_ITEM]->(item_1226);
CREATE (para_1223)-[:NEXT_PARAGRAPH]->(para_1224);
CREATE (para_1227:Paragraph {id: '3', content: 'Yara bakım ürünlerinin kullanımına dair düzenlenecek sağlık kurulu raporlarında hasta kimlik bilgilerinin dışında;'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 2}]->(para_1227);
CREATE (item_1228:Item {id: 'a', content: 'Etyolojik tanı (diyabetik ayak yarası vb.),'});
CREATE (para_1227)-[:HAS_ITEM {order: 0}]->(item_1228);
CREATE (item_1229:Item {id: 'b', content: 'Yara ve/veya yaraların anatomik lokalizasyonu,'});
CREATE (para_1227)-[:HAS_ITEM {order: 1}]->(item_1229);
CREATE (item_1228)-[:NEXT_ITEM]->(item_1229);
CREATE (item_1230:Item {id: 'c', content: 'Yara ve/veya yaraların ebatları,'});
CREATE (para_1227)-[:HAS_ITEM {order: 2}]->(item_1230);
CREATE (item_1229)-[:NEXT_ITEM]->(item_1230);
CREATE (item_1231:Item {id: 'ç', content: 'Klinik bulgular (eksüdasyon, kavitasyon enfeksiyon gibi özellikler ayrıca belirtilecektir),'});
CREATE (para_1227)-[:HAS_ITEM {order: 3}]->(item_1231);
CREATE (item_1230)-[:NEXT_ITEM]->(item_1231);
CREATE (item_1232:Item {id: 'd', content: 'Öncesinde medikal ve/veya cerrahi tedavi uygulanıp uygulanmadığı,'});
CREATE (para_1227)-[:HAS_ITEM {order: 4}]->(item_1232);
CREATE (item_1231)-[:NEXT_ITEM]->(item_1232);
CREATE (item_1233:Item {id: 'e', content: 'Tercih edilen yara bakım ürününün tercih gerekçesi, tipi, ebatları, değiştirilme süresi bilgilerinin yer alması zorunludur.'});
CREATE (para_1227)-[:HAS_ITEM {order: 5}]->(item_1233);
CREATE (item_1232)-[:NEXT_ITEM]->(item_1233);
CREATE (para_1224)-[:NEXT_PARAGRAPH]->(para_1227);
CREATE (para_1234:Paragraph {id: '4', content: 'Sağlık kurulu raporunda belirtilen yara bakım ürünü dışında başka bir yara bakım ürünü kullanılması gerektiğinde, gerekçesi ile birlikte yeniden sağlık kurulu raporu düzenlenecektir.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 3}]->(para_1234);
CREATE (para_1227)-[:NEXT_PARAGRAPH]->(para_1234);
CREATE (para_1235:Paragraph {id: '5', content: 'Sağlık kurulu raporları yatarak tedavilerde yatış süresince geçerlidir.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 4}]->(para_1235);
CREATE (para_1234)-[:NEXT_PARAGRAPH]->(para_1235);
CREATE (para_1236:Paragraph {id: '6', content: 'Ayakta tedavide kullanılacak yara bakım ürünleri için, sağlık kurulu raporuna dayanılarak genel cerrahi, ortopedi ve travmatoloji, plastik, rekonstrüktif ve estetik cerrahi, geriatri veya deri ve zührevi hastalıkları uzman hekimlerinden biri tarafından reçete düzenlenmesi gerekmektedir.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 5}]->(para_1236);
CREATE (para_1235)-[:NEXT_PARAGRAPH]->(para_1236);
CREATE (para_1237:Paragraph {id: '7', content: 'Reçetenin tekrar düzenlenmesi halinde yara/yaraların ebatları reçeteyi yazan hekim tarafından sağlık kurulu raporunun arkasına yazılır ve rapor aynı hekim tarafından imzalanarak kaşelenir.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 6}]->(para_1237);
CREATE (para_1236)-[:NEXT_PARAGRAPH]->(para_1237);
CREATE (para_1238:Paragraph {id: '8', content: 'Ayakta tedavide tedavi edici etkisini sadece hydrocolloid, köpük ve fiber içermesinden dolayı gösteren yara bakım ürünlerinin bedelleri Kurumca karşılanır.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 7}]->(para_1238);
CREATE (para_1237)-[:NEXT_PARAGRAPH]->(para_1238);
CREATE (para_1239:Paragraph {id: '9', content: 'Aşağıdaki deri taklitleri (yedekleri) sadece yanık tedavisinde kullanılması halinde ödenir.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 8}]->(para_1239);
CREATE (item_1240:Item {id: 'a', content: 'Dermis iskeleti: Dermis iskeleti (yeni dermis oluşumu için iskelet görevi gören ve içine hücre göçüne izin veren sentetik/ hayvan kaynaklı yapılar) görevi görebilen, tek veya çok katmanlı, fakat sadece dermisin tam kat hasar gördüğü üçüncü derece yanık bölgelerinin tedavisinde kullanılabilen deri taklitlerinin (yedekleri) bedeli yüz, boyun, el, ayak, perine, eklem, sadece kız çocuklarında ve kadınlarda meme alanlarını içeren yanıklarda veya %40’ı (0-12 yaş için %20) geçen üçüncü derece yanıklarda yanık merkezi ve/veya üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga: RG-16/03/2023-32134/17-a md. Yürürlük:24/03/2023) sağlık kurulu raporu ile kullanımı halinde Kurumca karşılanır.'});
CREATE (para_1239)-[:HAS_ITEM {order: 0}]->(item_1240);
CREATE (item_1241:Item {id: 'b', content: 'Deri benzerleri: Dermis iskeleti görevi göremeyen, bununla birlikte en az derin ikinci derece yanıkların tedavisinde, sahip oldukları fiziksel veya moleküler özellikler sayesinde epidermisin ve kısmen dermisin özelliklerini taklit ederek yarayı enfeksiyon, kontaminasyon gibi dış etkenlerden koruyan sentetik/hayvan kaynaklı, emilebilen veya yaradan kendiliğinden ayrılabilen deri taklitlerinin (yedekleri) bedeli yüz, boyun, el, ayak, perine, eklem, sadece kız çocuklarında ve kadınlarda meme alanlarını içeren yanıklarda veya %40’ı (0-12 yaş için %20) geçen derin ikinci derece ve/veya üçüncü derece yanıklarda yanık ünite/merkez ve/veya üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga: RG-16/03/2023- 32134/17-a md. Yürürlük:24/03/2023) sağlık kurulu raporu ile kullanımı halinde Kurumca karşılanır.'});
CREATE (para_1239)-[:HAS_ITEM {order: 1}]->(item_1241);
CREATE (item_1240)-[:NEXT_ITEM]->(item_1241);
CREATE (para_1238)-[:NEXT_PARAGRAPH]->(para_1239);
CREATE (para_1242:Paragraph {id: '10', content: 'Yanık hastalarının ayakta tedavilerinde, SUT ve eki listelerde yer alan yara bakımı ile ilgili hükümler geçerlidir.'});
CREATE (sec_1222)-[:HAS_PARAGRAPH {order: 9}]->(para_1242);
CREATE (para_1239)-[:NEXT_PARAGRAPH]->(para_1242);
CREATE (amend_1243:Amendment {content: '(Değişik: RG-12/12/2024-32750/3 md. Yürürlük: 23/08/2024)'});
CREATE (sec_1222)-[:HAS_AMENDMENT {order: 0}]->(amend_1243);
CREATE (sec_1244:Subsection {id: '3.3.2', title: 'Şeker ölçüm çubukları'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 1}]->(sec_1244);
CREATE (para_1245:Paragraph {id: '1', content: 'Tip I diyabetli ve tip II diyabetliler, hipoglisemili hastalar, gestasyonel diyabetliler ile sadece oral antidiyabetik ilaç kullanan diyabetli hastaların kullanmakta olduğu kan şekeri ölçüm çubuklarına ait bedeller, aşağıda belirtilen esas ve şartlar doğrultusunda Kurumca karşılanacaktır;'});
CREATE (sec_1244)-[:HAS_PARAGRAPH {order: 0}]->(para_1245);
CREATE (item_1246:Item {id: 'a', content: 'Tip I diyabetli, tip II diyabetli, hipoglisemili, gestasyonel diyabetli hastalar ile sadece oral antidiyabetik ilaç kullanan diyabetli hastalar için, aile hekimi uzmanı, endokrinoloji ve metabolizma, iç hastalıkları, çocuk sağlığı ve hastalıkları uzman hekimlerinden biri tarafından uzman hekim raporu düzenlenmesi gerekmektedir.'});
CREATE (para_1245)-[:HAS_ITEM {order: 0}]->(item_1246);
CREATE (item_1247:Item {id: 'b', content: 'Kan şekeri ölçüm cihazlarına ait bedeller Kurumca karşılanacaktır. Kan şekeri ölçüm cihazının yenilenme süresi 2 yıldır. Bu süreden önce temin edilen kan şekeri ölçüm cihazının bedeli Kurumca ödenmez.'});
CREATE (para_1245)-[:HAS_ITEM {order: 1}]->(item_1247);
CREATE (item_1246)-[:NEXT_ITEM]->(item_1247);
CREATE (item_1248:Item {id: 'c', content: 'Kan şekeri ölçüm çubukları; olarak belirtilen adetler esas alınarak, 150 adet, erişkin hastalar için en fazla 50 adet, reçete edilmesi halinde bedeli Kurumca karşılanır.'});
CREATE (para_1245)-[:HAS_ITEM {order: 2}]->(item_1248);
CREATE (subitem_1249:SubItem {id: '1', content: 'Tip I diyabetli çocuk hastalar (18 yaş altı), gebeler, transplantasyon hastalarında sağlık raporunda tedavi protokolü'});
CREATE (item_1248)-[:HAS_SUBITEM {order: 0}]->(subitem_1249);
CREATE (subitem_1250:SubItem {id: '2', content: 'Tip I diyabetli erişkin hastalar ve insülin kullanan tip II diyabetli tüm hastalarda ayda en fazla 150 adet,'});
CREATE (item_1248)-[:HAS_SUBITEM {order: 1}]->(subitem_1250);
CREATE (subitem_1249)-[:NEXT_SUBITEM]->(subitem_1250);
CREATE (subitem_1251:SubItem {id: '3', content: 'Medikal tedavi ile kontrol altında tutulan hiperinsülinemik hipoglisemisi olan çocuk hastalar için ayda en fazla'});
CREATE (item_1248)-[:HAS_SUBITEM {order: 2}]->(subitem_1251);
CREATE (subitem_1250)-[:NEXT_SUBITEM]->(subitem_1251);
CREATE (subitem_1252:SubItem {id: '4', content: 'Oral antidiyabetik ilaç kullanan diyabetli hastalara 3 ayda en fazla 100 adet hesabıyla,'});
CREATE (item_1248)-[:HAS_SUBITEM {order: 3}]->(subitem_1252);

// Batch 34
CREATE (subitem_1251)-[:NEXT_SUBITEM]->(subitem_1252);
CREATE (item_1247)-[:NEXT_ITEM]->(item_1248);
CREATE (item_1253:Item {id: 'ç', content: 'Kan şekeri ölçüm çubuklarına ait faturalara, sağlık raporunun fotokopisi (e-rapor hariç) ile reçetenin asılları (e- reçete hariç) eklenecektir.'});
CREATE (para_1245)-[:HAS_ITEM {order: 3}]->(item_1253);
CREATE (item_1248)-[:NEXT_ITEM]->(item_1253);
CREATE (item_1254:Item {id: 'd', content: 'Kan şekeri ölçüm çubukları ve kan şekeri ölçüm cihazları sözleşmeli eczanelerden temin edilecektir.'});
CREATE (para_1245)-[:HAS_ITEM {order: 4}]->(item_1254);
CREATE (item_1253)-[:NEXT_ITEM]->(item_1254);
CREATE (sec_1222)-[:NEXT_SUBSECTION]->(sec_1244);
CREATE (sec_1255:Subsection {id: '3.3.3', title: 'Görmeye yardımcı tıbbi malzemeler'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 2}]->(sec_1255);
CREATE (para_1256:Paragraph {id: '1', content: 'Gözlük cam ve çerçeve bedelleri ile göz sağlığı ve hastalıkları uzman hekimi tarafından düzenlenen sağlık kurulu raporunda/e-raporda belirtilen nitelikli görmeye yardımcı tıbbi malzeme bedelleri SUT eki “Görmeye Yardımcı Tıbbi Malzemeler” (EK-3/D) Listesinde yer alan fiyatları aşmamak üzere Kurumca karşılanır.'});
CREATE (sec_1255)-[:HAS_PARAGRAPH {order: 0}]->(para_1256);
CREATE (para_1257:Paragraph {id: '2', content: 'Reçetenin/e-reçetenin/sağlık kurulu raporunun/e-raporun düzenlenme tarihinden itibaren 10 (on) işgünü içerisinde yapılan hasta müracaatları optisyenlik müesseseleri tarafından kabul edilecektir. Süresi içerisinde kabul edilen sağlık kurulu raporu/e-raporun ve/veya reçetelerin/e-reçetelerin sisteme kaydı nitelikli malzemelerde 30 (otuz) iş günü, diğer reçeteli malzemelerde ise 20 (yirmi) iş günü içerisinde tamamlanır. Süresi içinde yapılmayan hasta müracaatları ve/veya sistem kayıtlarına ilişkin reçete/e-reçete/sağlık kurulu raporu/e-rapor ile kullanılması gerekli görülen görmeye yardımcı tıbbi malzemelerin bedelleri Kurumca karşılanmaz. 54'});
CREATE (sec_1255)-[:HAS_PARAGRAPH {order: 1}]->(para_1257);
CREATE (para_1256)-[:NEXT_PARAGRAPH]->(para_1257);
CREATE (sec_1258:Subsection {id: '3.3.3.A', title: 'Gözlük cam ve çerçevesi'});
CREATE (sec_1255)-[:HAS_SUBSECTION {order: 0}]->(sec_1258);
CREATE (para_1259:Paragraph {id: '1', content: 'Gözlük cam ve çerçevesinin temininde göz sağlığı ve hastalıkları uzman hekimleri ile bu dalda ihtisas yapan asistan hekimler tarafından düzenlenen reçeteye/e-reçeteye dayanılarak işlem yapılır. Ancak, acil polikliniklerinde yazılan gözlük cam ve çerçeve reçete/e-reçete bedelleri karşılanmaz.'});
CREATE (sec_1258)-[:HAS_PARAGRAPH {order: 0}]->(para_1259);
CREATE (para_1260:Paragraph {id: '2', content: 'Gözlük cam ve çerçeveleri, 5193 sayılı Optisyenlik Hakkında Kanun hükümlerine uygun olarak faaliyetlerini sürdüren ve Kurumla görmeye yardımcı tıbbi malzeme sözleşmesi imzalayan optisyenlik müesseselerinden temin edilebilir.'});
CREATE (sec_1258)-[:HAS_PARAGRAPH {order: 1}]->(para_1260);
CREATE (para_1259)-[:NEXT_PARAGRAPH]->(para_1260);
CREATE (para_1261:Paragraph {id: '3', content: 'Cam bedelleri, çerçeve bedeli ile birlikte sözleşmeli optisyenlik müesseseleri tarafından Kuruma fatura edilebilir.'});
CREATE (sec_1258)-[:HAS_PARAGRAPH {order: 2}]->(para_1261);
CREATE (para_1260)-[:NEXT_PARAGRAPH]->(para_1261);
CREATE (para_1262:Paragraph {id: '4', content: 'SUT eki EK-3/D Listesinde yer alan camlar ile hasta tarafından talep edilen farklı özelliklere sahip camlar arasında oluşacak fark ücreti Kurum tarafından karşılanmaz. (Değişik: RG- 16/03/2023-32134/17-b md. Yürürlük: 24/03/2023)'});
CREATE (sec_1258)-[:HAS_PARAGRAPH {order: 3}]->(para_1262);
CREATE (para_1261)-[:NEXT_PARAGRAPH]->(para_1262);
CREATE (para_1263:Paragraph {id: '5', content: 'Gözlük cam ve çerçevelerinin miat süresi 14 (on dört) yaş ve altı çocuklar için 1 (bir) yıl, 14 (on dört) yaş üzeri hastalar için 2 (iki) yıldır. Ancak, kırma kusurunun 0,5 diyoptrilik değişiklik göstermesi halinde gözlük camı süresinden önce yenilenebilir. 14 (on dört) yaş ve altı çocuklarda ise silendirik değerin 0,25 diyoptri veya silendirik aksın 10 derecenin üzerinde değişiklik göstermesi halinde gözlük camı süresinden önce yenilenebilir. (Mülga: RG- 16/03/2023-32134/17-b md. Yürürlük: 24/03/2023)'});
CREATE (sec_1258)-[:HAS_PARAGRAPH {order: 4}]->(para_1263);
CREATE (para_1262)-[:NEXT_PARAGRAPH]->(para_1263);
CREATE (sec_1264:Subsection {id: '3.3.3.B', title: 'Teleskopik gözlük'});
CREATE (sec_1255)-[:HAS_SUBSECTION {order: 1}]->(sec_1264);
CREATE (para_1265:Paragraph {id: '1', content: 'Konjenital nedenlere, kalıtsal hastalıklara, yaralanmalara, şeker hastalığına, glokoma, katarakta ve yaşlanmaya bağlı göz bozukluğu olan ve iyi gören gözde düzeltilmiş uzak görme keskinliği 3/10 ve altında olan hastalarda üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga:RG- 16/03/2023-32134/17-c md. Yürürlük:24/03/2023) düzenlenen ve en az bir göz sağlığı ve hastalıkları uzmanının yer aldığı sağlık kurulu raporuna/e-rapora dayanılarak bedelleri Kurumca karşılanır.'});
CREATE (sec_1264)-[:HAS_PARAGRAPH {order: 0}]->(para_1265);
CREATE (para_1266:Paragraph {id: '2', content: 'Sağlık kurulu raporunda/e-raporda zeminde yatan göz hastalığı ve bu hastalığa bağlı olarak “görme işlevlerindeki bozulma”, “uzak”, “yakın”, “uzak-yakın” ifadesi olması, büyütme gücü (x, diyoptri olarak), fiks foküs veya fokusable (foküslenebilme) olma durumu ve niteliği (prizmatik, galileon veya keplerin) belirtilmelidir. (Değişik: RG- 16/03/2023-32134/17-c md. Yürürlük: 24/03/2023)'});
CREATE (sec_1264)-[:HAS_PARAGRAPH {order: 1}]->(para_1266);
CREATE (para_1265)-[:NEXT_PARAGRAPH]->(para_1266);
CREATE (para_1267:Paragraph {id: '3', content: 'Teleskopik gözlükler sağlık kurulu raporuyla/e-raporla 18 (on sekiz) yaş ve altı çocuklar ile 25 (yirmi beş) yaş ve altı öğrenci olanlarda yılda bir yenilenir. Bunların dışındaki kişilerde 2 (iki) yılda bir yenilenebilir.'});
CREATE (sec_1264)-[:HAS_PARAGRAPH {order: 2}]->(para_1267);
CREATE (para_1266)-[:NEXT_PARAGRAPH]->(para_1267);
CREATE (para_1268:Paragraph {id: '4', content: 'Sağlık kurulu raporu/e-rapor ile gerekli görülen hallerde, yakın görme bozukluğu olan hastalara tek veya iki göz için kapak kep reçete edilebilir. Bu kişiler için ayrıca yakın teleskopik gözlük bedeli Kurumca karşılanmaz.'});
CREATE (sec_1264)-[:HAS_PARAGRAPH {order: 3}]->(para_1268);
CREATE (para_1267)-[:NEXT_PARAGRAPH]->(para_1268);
CREATE (sec_1258)-[:NEXT_SUBSECTION]->(sec_1264);
CREATE (sec_1269:Subsection {id: '3.3.3.C', title: 'Kontakt lensler'});
CREATE (sec_1255)-[:HAS_SUBSECTION {order: 2}]->(sec_1269);
CREATE (para_1270:Paragraph {id: '1', content: 'Kontakt lens bedelleri;'});
CREATE (sec_1269)-[:HAS_PARAGRAPH {order: 0}]->(para_1270);
CREATE (item_1271:Item {id: 'a', content: 'Konjenital katarakt nedeniyle opere olmuş afak olgularda,'});
CREATE (para_1270)-[:HAS_ITEM {order: 0}]->(item_1271);
CREATE (item_1272:Item {id: 'b', content: 'Travma ve iatrojenik nedenlerle tek gözde veya iki gözde göz lens bağlarının kopması ve akabinde göz içine tekrar lens konulamaması sonucu gelişen afaki olgularda,'});
CREATE (para_1270)-[:HAS_ITEM {order: 1}]->(item_1272);
CREATE (item_1271)-[:NEXT_ITEM]->(item_1272);
CREATE (item_1273:Item {id: 'c', content: 'Keratokonusu olan göze gözlük uygulanmış ve gözlükle görme keskinlikleri 10/10’a kadar (tama) artmayan olgularda, ve bu durumlarının üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga: RG-16/03/2023-32134/17-ç md. Yürürlük:24/03/2023) düzenlenen en az bir göz sağlığı ve hastalıkları uzman hekiminin yer aldığı sağlık kurulu raporunda/e- raporda, teşhis, hastaya uygun görülen lensin çapı (BC), derinliği (DİA), diyoptri değeri (POW) ile lensin niteliğinin (sert, yumuşak, gaz geçirgenliği vb.) belirtilmesi ve Kurumla sözleşmeli optisyenlik müesseselerinden temin edilmesi şartıyla SUT eki EK-3/D Listesinde yer alan bedeller üzerinden Kurumca karşılanır.'});
CREATE (para_1270)-[:HAS_ITEM {order: 2}]->(item_1273);
CREATE (item_1272)-[:NEXT_ITEM]->(item_1273);
CREATE (para_1274:Paragraph {id: '2', content: 'Kontakt lenslerin miat süresi 2 (iki) yıldır.'});
CREATE (sec_1269)-[:HAS_PARAGRAPH {order: 1}]->(para_1274);
CREATE (para_1270)-[:NEXT_PARAGRAPH]->(para_1274);
CREATE (para_1275:Paragraph {id: '3', content: 'Konjenital katarakt nedeniyle opere olmuş 6 (altı) yaşından küçük çocuklarda 6 (altı) ayda bir yenilenmesi halinde sağlık kurulu raporuna/e-rapora istinaden bedelleri Kurumca karşılanır.'});
CREATE (sec_1269)-[:HAS_PARAGRAPH {order: 2}]->(para_1275);
CREATE (para_1274)-[:NEXT_PARAGRAPH]->(para_1275);
CREATE (para_1276:Paragraph {id: '4', content: 'Konjenital katarakt nedeniyle opere olmuş ve afakı 6 (altı) yaşından sonra da devam eden olgularda kontakt lensin sağlık kurulu raporu/e-rapor ile “aylık sık replasmanlı” olarak kullanılacağının belirtilmesi halinde 6 (altı) ayda bir, “yıllık” olarak kullanılacağının belirtilmesi halinde ise yılda bir yenilenebilir.'});
CREATE (sec_1269)-[:HAS_PARAGRAPH {order: 3}]->(para_1276);
CREATE (para_1275)-[:NEXT_PARAGRAPH]->(para_1276);
CREATE (para_1277:Paragraph {id: '5', content: 'Konjenital katarakt nedeniyle opere olmuş afak olgular hariç kontakt lens kullanan hastaların ayrıca gözlük cam ve çerçeve bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1269)-[:HAS_PARAGRAPH {order: 4}]->(para_1277);
CREATE (para_1276)-[:NEXT_PARAGRAPH]->(para_1277);
CREATE (para_1278:Paragraph {id: '6', content: 'Kontakt lens solüsyonlarının bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1269)-[:HAS_PARAGRAPH {order: 5}]->(para_1278);
CREATE (para_1277)-[:NEXT_PARAGRAPH]->(para_1278);
CREATE (sec_1264)-[:NEXT_SUBSECTION]->(sec_1269);
CREATE (sec_1279:Subsection {id: '3.3.3.Ç', title: 'Görmeye yardımcı tıbbi malzemelerde elektronik reçete uygulaması'});
CREATE (sec_1255)-[:HAS_SUBSECTION {order: 3}]->(sec_1279);
CREATE (para_1280:Paragraph {id: '1', content: 'E-reçete uygulamasında, e-reçetelerin Kurum tarafından belirlenen yöntem ve standartlarla (elektronik imza, şifre) imzalanması şarttır.'});
CREATE (sec_1279)-[:HAS_PARAGRAPH {order: 0}]->(para_1280);
CREATE (para_1281:Paragraph {id: '2', content: 'Sağlık hizmeti sunucuları tarafından düzenlenecek reçeteler Kurum MEDULA sisteminde SGK Hekim Şifresi ile düzenlenecektir. Kurumca belirlenecek istisnalar haricinde manuel reçetelerin bedelleri karşılanmayacaktır. Kurum tarafından gerekli düzenlemelerin yapılması sonrasında ise reçeteler Kurum tarafından belirlenerek Kurum web sayfasından ilan edilecek tarihten itibaren elektronik imza ile imzalanacaktır.'});
CREATE (sec_1279)-[:HAS_PARAGRAPH {order: 1}]->(para_1281);
CREATE (para_1280)-[:NEXT_PARAGRAPH]->(para_1281);
CREATE (para_1282:Paragraph {id: '3', content: 'Kurum tarafından gerekli düzenlenmeler tamamlanıncaya kadar manuel olarak düzenlenmeye devam edilecek olan reçeteler;'});
CREATE (sec_1279)-[:HAS_PARAGRAPH {order: 2}]->(para_1282);
CREATE (item_1283:Item {id: 'a', content: 'Sağlık hizmeti sunucularına müracaatlar sırasında Kurum bilgi işlem sistemi tarafından sigortalının prim ödeme gün sayısı veya prim borcu bulunması nedeniyle hasta takip numarası/provizyon verilmemesi halinde; sağlık hizmeti sunucularınca kişinin müracaatının SUT’un 1.7 Provizyon İşlemleri başlıklı maddesinin ikinci fıkrasının (b) bendinde tanımlanan 18 (on sekiz) yaş altı çocuklar, iş kazası ile meslek hastalığı, afet ve savaş ile grev ve lokavt halleri kapsamında veya SUT’un 1.7 Provizyon İşlemleri başlıklı maddesinin ikinci fıkrasının (c) bendinde tanımlanan durumlarda olduğunun belirtildiği hallerde düzenlenen reçeteler.'});
CREATE (para_1282)-[:HAS_ITEM {order: 0}]->(item_1283);
CREATE (item_1284:Item {id: 'b', content: 'Resmi sağlık hizmeti sunucularından; kamu idareleri bünyesindeki Kurum tabipliklerinde, belediyelere ait polikliniklerde, aile hekimlikleri dışındaki birinci basamak resmi sağlık hizmeti sunucularında, üniversiteler bünyesindeki 55 mediko-sosyal birimlerde düzenlenen reçeteler (resmi sağlık hizmeti sunucularının MEDULA-Hastane sistemini kullanmaya başlamaları veya teknik alt yapılarını oluşturmaları halinde e-reçete uygulamasına geçmeleri zorunludur.).'});
CREATE (para_1282)-[:HAS_ITEM {order: 1}]->(item_1284);
CREATE (item_1283)-[:NEXT_ITEM]->(item_1284);
CREATE (para_1281)-[:NEXT_PARAGRAPH]->(para_1282);
CREATE (para_1285:Paragraph {id: '4', content: 'MEDULA sisteminin ve/veya sağlık hizmeti sunucusuna ait sistemin çalışmaması nedeniyle e-reçetenin düzenlenememesi halinde manuel olarak düzenlenen reçete üzerinde e-reçete olarak düzenlenememesine ilişkin “Sistemlerin çalışmaması nedeniyle e-reçete düzenlenememiştir” ibaresi kaşe ya da el yazısı şeklinde belirtilmeli ve bu ibare reçeteyi düzenleyen hekim tarafından onaylanmalıdır. (Yukarıda tanımlanmış olan istisnai hallerde düzenlenen manuel reçetelerde bu ibare aranmayacaktır.) (Ek: RG- 16/03/2023-32134/17-d md. Yürürlük: 24/03/2023)'});
CREATE (sec_1279)-[:HAS_PARAGRAPH {order: 3}]->(para_1285);
CREATE (para_1282)-[:NEXT_PARAGRAPH]->(para_1285);
CREATE (sec_1269)-[:NEXT_SUBSECTION]->(sec_1279);
CREATE (sec_1286:Subsection {id: '3.3.3.D', title: 'Prizmatik cam'});
CREATE (sec_1255)-[:HAS_SUBSECTION {order: 4}]->(sec_1286);
CREATE (para_1287:Paragraph {id: '1', content: 'Kalıcı çift görme bozukluğu nedeniyle (çift görme şikayetinin 6 (altı) ay ve üzerinde devam etmesi halinde) başvuran paralitik ve restriktrif şaşılık hastalarında bu durumun üçüncü basamak resmi sağlık hizmeti sunucularınca düzenlenen üç göz sağlığı ve hastalıkları uzmanının yer aldığı sağlık kurulu raporunda/e-raporda belirtilmesi halinde bedeli Kurumca karşılanır.'});
CREATE (sec_1286)-[:HAS_PARAGRAPH {order: 0}]->(para_1287);
CREATE (para_1288:Paragraph {id: '2', content: 'Prizmatik camlar sağlık kurulu raporuyla/e-raporla 3 (üç) yılda bir yenilenir. Ancak, prizmatik cam derecesinin değişimi halinde yılda bir yenilenebilir.'});
CREATE (sec_1286)-[:HAS_PARAGRAPH {order: 1}]->(para_1288);
CREATE (para_1287)-[:NEXT_PARAGRAPH]->(para_1288);

// Batch 35
CREATE (sec_1279)-[:NEXT_SUBSECTION]->(sec_1286);
CREATE (sec_1244)-[:NEXT_SUBSECTION]->(sec_1255);
CREATE (sec_1289:Subsection {id: '3.3.4', title: 'Greftler'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 3}]->(sec_1289);
CREATE (sec_1290:Subsection {id: '3.3.4.A', title: 'Genel hükümler'});
CREATE (sec_1289)-[:HAS_SUBSECTION {order: 0}]->(sec_1290);
CREATE (para_1291:Paragraph {id: '1', content: 'İnsan dokusu kaynaklı ürünlerin (allogreftler) MEDULA-Hastane sistemine girişlerinde TİTUBB/ÜTS kayıt/bildirim işleminin “Allogreft Ürün Onay Ekranı” nda tamamlanmış olma şartı aranacak olup tüm gönderimlerin küresel ürün numaraları (barkod) ile yapılması gerekmektedir.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 0}]->(para_1291);
CREATE (para_1292:Paragraph {id: '2', content: 'Sağlık hizmeti sunucusu tarafından, benzeri olmayan tanımlayıcı kodun (Donör ID) MEDULA-Hastane sisteminde açılmış olan alana girilmesi zorunludur.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 1}]->(para_1292);
CREATE (para_1291)-[:NEXT_PARAGRAPH]->(para_1292);
CREATE (para_1293:Paragraph {id: '3', content: 'Dermis ve/veya epidermis yerine geçen allogreftlerin bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 2}]->(para_1293);
CREATE (para_1292)-[:NEXT_PARAGRAPH]->(para_1293);
CREATE (para_1294:Paragraph {id: '4', content: 'Sentetik greftler ve xenogreftler; Sağlık Bakanlığı “Tıbbi Cihaz Yönetmeliği” kapsamında olduğundan TİTUBB/ÜTS kayıt/bildirim işlemi tamamlanmış olma şartı aranır.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 3}]->(para_1294);
CREATE (para_1293)-[:NEXT_PARAGRAPH]->(para_1294);
CREATE (para_1295:Paragraph {id: '5', content: 'Epifiz hattı açık olan hastaların, patolojik olmayan primer kırıklarında hiçbir greft bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 4}]->(para_1295);
CREATE (para_1294)-[:NEXT_PARAGRAPH]->(para_1295);
CREATE (para_1296:Paragraph {id: '6', content: 'Tümör dışı kalça kırığı nedeniyle artroplasti uygulanan vakalarda hiçbir greft bedeli Kurumca karşılanmaz.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 5}]->(para_1296);
CREATE (para_1295)-[:NEXT_PARAGRAPH]->(para_1296);
CREATE (para_1297:Paragraph {id: '7', content: 'İlgili listelerde bulunan alan tanımlarında boyut ve ölçüler belirtilmiş olup, küçük boyut ve ölçüler bir arada kullanılarak listede yer alan büyük miktarlar elde edilemez.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 6}]->(para_1297);
CREATE (para_1296)-[:NEXT_PARAGRAPH]->(para_1297);
CREATE (para_1298:Paragraph {id: '8', content: 'Sentetik greft, allogreft ve xenogreftlerin birbirleri ile kombine edilerek kullanılması halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 7}]->(para_1298);
CREATE (para_1297)-[:NEXT_PARAGRAPH]->(para_1298);
CREATE (para_1299:Paragraph {id: '9', content: 'Sentetik greft, allogreft ve xenogreftler;'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 8}]->(para_1299);
CREATE (item_1300:Item {id: 'a', content: 'Daha önce otogreft uygulanmış ve greft alımında yeterli doku bulunmayan hastalarda,'});
CREATE (para_1299)-[:HAS_ITEM {order: 0}]->(item_1300);
CREATE (item_1301:Item {id: 'b', content: 'Otogreft donör alımında morbidite riski olan hastalarda,'});
CREATE (para_1299)-[:HAS_ITEM {order: 1}]->(item_1301);
CREATE (item_1300)-[:NEXT_ITEM]->(item_1301);
CREATE (item_1302:Item {id: 'c', content: 'Çok parçalı ve defektli kırıkların en az biri ortopedi ve travmatoloji uzmanı olmak kaydıyla 3 (üç) uzman hekim tarafından düzenlenecek rapor ile belgelendirilen cerrahi tedavisinde,'});
CREATE (para_1299)-[:HAS_ITEM {order: 2}]->(item_1302);
CREATE (item_1301)-[:NEXT_ITEM]->(item_1302);
CREATE (item_1303:Item {id: 'ç', content: 'Kemiklerde geniş defektler oluşturan benign veya malign tümörlerin cerrahisinde,'});
CREATE (para_1299)-[:HAS_ITEM {order: 3}]->(item_1303);
CREATE (item_1302)-[:NEXT_ITEM]->(item_1303);
CREATE (item_1304:Item {id: 'd', content: '3 (üç) veya daha fazla vertebra içeren füzyon uygulanan omurga cerrahisinde,'});
CREATE (para_1299)-[:HAS_ITEM {order: 4}]->(item_1304);
CREATE (item_1303)-[:NEXT_ITEM]->(item_1304);
CREATE (item_1305:Item {id: 'e', content: 'Spinal cerrahide tümör ya da travma nedeniyle korpektomi boşluğuna titanyum ya da çelik interbody kafes yerleştirilmesi sırasında kafes içinin doldurulduğu (DBM içeren tüm formlar hariç olmak üzere) hastalarda kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1299)-[:HAS_ITEM {order: 5}]->(item_1305);
CREATE (item_1304)-[:NEXT_ITEM]->(item_1305);
CREATE (para_1298)-[:NEXT_PARAGRAPH]->(para_1299);
CREATE (para_1306:Paragraph {id: '10', content: 'Sentetik greft kullanılan tüm uygulamalarda vaka başı 30 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 9}]->(para_1306);
CREATE (para_1299)-[:NEXT_PARAGRAPH]->(para_1306);
CREATE (para_1307:Paragraph {id: '11', content: 'Allogreft/xenogreft kullanılan tüm uygulamalarda vaka başı 60 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 10}]->(para_1307);
CREATE (para_1306)-[:NEXT_PARAGRAPH]->(para_1307);
CREATE (para_1308:Paragraph {id: '12', content: '3 (üç) veya daha fazla vertebra içeren füzyon uygulanan omurga cerrahisinde;'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 11}]->(para_1308);
CREATE (item_1309:Item {id: 'a', content: 'Allogreft/xenogreft kullanılan posterior spinal stabilizasyon uygulamalarında Servikal 1-Torakal 10 vertebralar arası her seviye için 5 cc, Torakal 11-Sakral 1 vertebralar arası her seviye için 10 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (para_1308)-[:HAS_ITEM {order: 0}]->(item_1309);
CREATE (item_1310:Item {id: 'b', content: 'Sentetik greft kullanılan posterior spinal stabilizasyon uygulamalarında Servikal 1-Torakal 10 vertebralar arası her seviye için 2,5 cc, Torakal 11-Sakral 1 vertebralar arası her seviye için 5 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (para_1308)-[:HAS_ITEM {order: 1}]->(item_1310);
CREATE (item_1309)-[:NEXT_ITEM]->(item_1310);
CREATE (para_1307)-[:NEXT_PARAGRAPH]->(para_1308);
CREATE (para_1311:Paragraph {id: '13', content: 'Allogreft/xenogreft kullanılan büyük kemik kistlerinin cerrahi tedavisinde; ayrıntılı koronal ve aksiyel bilgisayarlı tomografi kesitlerine ait raporlarla belgelendirilmek kaydıyla 120 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 12}]->(para_1311);
CREATE (para_1308)-[:NEXT_PARAGRAPH]->(para_1311);
CREATE (para_1312:Paragraph {id: '14', content: 'Tendon yerine kullanılabilecek sentetik greftlerin bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 13}]->(para_1312);
CREATE (para_1311)-[:NEXT_PARAGRAPH]->(para_1312);
CREATE (para_1313:Paragraph {id: '15', content: 'Fasiya Temporalis alan tanımında yer alan allogreftlerin yalnızca Kulak Burun Boğaz uzmanlık dalı tarafından kullanıldığında bedelleri Kurumca karşılanır.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 14}]->(para_1313);
CREATE (para_1312)-[:NEXT_PARAGRAPH]->(para_1313);
CREATE (para_1314:Paragraph {id: '16', content: 'Ayakta tedavilerde; ağız, diş sağlığı ve çene cerrahisi uygulamalarında dokuzuncu fıkranın (a) ve (b) bentlerinde tanımlı bulunan kurallar aranmaz.'});
CREATE (sec_1290)-[:HAS_PARAGRAPH {order: 15}]->(para_1314);
CREATE (para_1313)-[:NEXT_PARAGRAPH]->(para_1314);
CREATE (sec_1315:Subsection {id: '3.3.4.B', title: 'Tendon allogreftleri'});
CREATE (sec_1289)-[:HAS_SUBSECTION {order: 1}]->(sec_1315);
CREATE (para_1316:Paragraph {id: '1', content: 'Eğitim verme yetkisi bulunan üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga:RG-16/03/2023- 32134/17-e md. Yürürlük:24/03/2023) ,'});
CREATE (sec_1315)-[:HAS_PARAGRAPH {order: 0}]->(para_1316);
CREATE (item_1317:Item {id: 'a', content: 'Rekonstrüksiyon revizyon ameliyatlarında en fazla 1 (bir) adet kullanıldığında bedelleri Kurumca karşılanır.'});
CREATE (para_1316)-[:HAS_ITEM {order: 0}]->(item_1317);
CREATE (item_1318:Item {id: 'b', content: 'Çoklu bağ rekonstrüksiyon ameliyatlarında en fazla 2 (iki) adet kullanıldığında bedelleri Kurumca karşılanır.'});
CREATE (para_1316)-[:HAS_ITEM {order: 1}]->(item_1318);
CREATE (item_1317)-[:NEXT_ITEM]->(item_1318);
CREATE (item_1319:Item {id: 'c', content: 'Primer tekli bağ tendon yaralanmalarında hiçbir durumda bedelleri Kurumca karşılanmaz.'});
CREATE (para_1316)-[:HAS_ITEM {order: 2}]->(item_1319);
CREATE (item_1318)-[:NEXT_ITEM]->(item_1319);
CREATE (sec_1290)-[:NEXT_SUBSECTION]->(sec_1315);
CREATE (sec_1320:Subsection {id: '3.3.4.C', title: 'Kemik yapımını uyaran materyaller (DBM içeren tüm formlar)'});
CREATE (sec_1289)-[:HAS_SUBSECTION {order: 2}]->(sec_1320);
CREATE (para_1321:Paragraph {id: '1', content: 'Kemik yapımını uyaran materyallerin kendi aralarında kombine edilerek kullanılması halinde bedelleri Kurumca karşılanmaz. 56'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 0}]->(para_1321);
CREATE (para_1322:Paragraph {id: '2', content: 'Tek başına DBM için; servikal füzyon ameliyatlarında disk mesafesinde kafes içine 1 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 1}]->(para_1322);
CREATE (para_1321)-[:NEXT_PARAGRAPH]->(para_1322);
CREATE (para_1323:Paragraph {id: '3', content: 'En az 2 (iki) ortopedi ve travmatoloji uzmanının yer aldığı sağlık kurulu raporu ile belgelendirilen, osteojenik aktivitenin istendiği atrofik nonunion pseudoartroz olgularında kemik yerine geçen materyallerle kombine kullanılması halinde humerus/pelvis/femur/tibiada 5 cc, fibula/radius/ulnada 2 cc ve diğer kemiklerde 1 cc’yi geçmemek üzere bedelleri Kurumca karşılanır. Hipertrofik nonunion olgularında kullanıldığı takdirde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 2}]->(para_1323);
CREATE (para_1322)-[:NEXT_PARAGRAPH]->(para_1323);
CREATE (para_1324:Paragraph {id: '4', content: 'Otojen greft kullanılması halinde, kemik yapımını uyaran materyallerin bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 3}]->(para_1324);

// Batch 36
CREATE (para_1323)-[:NEXT_PARAGRAPH]->(para_1324);
CREATE (para_1325:Paragraph {id: '5', content: 'Epifiz hattı açık olan hastaların tümoral hastalıklarında oluşan defektlerin giderilmesinde kullanılması halinde kemik tümörünün ve kemik yapımını uyaran materyale duyulan ihtiyacın niteliğinin 3 (üç) ortopedi ve travmatoloji uzmanının yer aldığı sağlık kurulu raporu ile belgelendirilmesi halinde ve humerus/pelvis/femur/tibiada 5 cc, fibula/radius/ulnada 2 cc ve diğer kemiklerde 1 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 4}]->(para_1325);
CREATE (para_1324)-[:NEXT_PARAGRAPH]->(para_1325);
CREATE (para_1326:Paragraph {id: '6', content: 'Omurga füzyon cerrahisi uygulanmış ve enstrümante edilmiş ancak, üzerinden en az 1 (bir) yıl geçmesine rağmen füzyon elde edilememiş revizyon enstrümantasyon cerrahisi gereken vakalarda vaka başı 5 cc’yi geçmemek üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 5}]->(para_1326);
CREATE (para_1325)-[:NEXT_PARAGRAPH]->(para_1326);
CREATE (para_1327:Paragraph {id: '7', content: 'Yetişkin primer kırıklarında kullanılması halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1320)-[:HAS_PARAGRAPH {order: 6}]->(para_1327);
CREATE (para_1326)-[:NEXT_PARAGRAPH]->(para_1327);
CREATE (sec_1315)-[:NEXT_SUBSECTION]->(sec_1320);
CREATE (sec_1328:Subsection {id: '3.3.4.Ç', title: 'Dura greftleri'});
CREATE (sec_1289)-[:HAS_SUBSECTION {order: 3}]->(sec_1328);
CREATE (para_1329:Paragraph {id: '1', content: 'Otojen greftler ile kapatılamayan dura defekti olan vakalarda bedelleri Kurumca karşılanır.'});
CREATE (sec_1328)-[:HAS_PARAGRAPH {order: 0}]->(para_1329);
CREATE (para_1330:Paragraph {id: '2', content: 'Dura greftlerinin aşağıdaki durumlarda kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_1328)-[:HAS_PARAGRAPH {order: 1}]->(para_1330);
CREATE (item_1331:Item {id: 'a', content: 'Nüks tümör cerrahisi,'});
CREATE (para_1330)-[:HAS_ITEM {order: 0}]->(item_1331);
CREATE (item_1332:Item {id: 'b', content: 'Kafa kaidesi girişimleri,'});
CREATE (para_1330)-[:HAS_ITEM {order: 1}]->(item_1332);
CREATE (item_1331)-[:NEXT_ITEM]->(item_1332);
CREATE (item_1333:Item {id: 'c', content: 'Dekompresyon/disk/kırık cerrahisi hariç olmak üzere intramedüller/intradural spinal cerrahi,'});
CREATE (para_1330)-[:HAS_ITEM {order: 2}]->(item_1333);
CREATE (item_1332)-[:NEXT_ITEM]->(item_1333);
CREATE (item_1334:Item {id: 'ç', content: 'Kraniyotomi sırasında duranın parçalandığı olgular,'});
CREATE (para_1330)-[:HAS_ITEM {order: 3}]->(item_1334);
CREATE (item_1333)-[:NEXT_ITEM]->(item_1334);
CREATE (item_1335:Item {id: 'd', content: 'Posterior fossa cerrahisi,'});
CREATE (para_1330)-[:HAS_ITEM {order: 4}]->(item_1335);
CREATE (item_1334)-[:NEXT_ITEM]->(item_1335);
CREATE (item_1336:Item {id: 'e', content: 'Leptomeningeal kist,'});
CREATE (para_1330)-[:HAS_ITEM {order: 5}]->(item_1336);
CREATE (item_1335)-[:NEXT_ITEM]->(item_1336);
CREATE (item_1337:Item {id: 'f', content: 'Ensefalosel cerrahisi,'});
CREATE (para_1330)-[:HAS_ITEM {order: 6}]->(item_1337);
CREATE (item_1336)-[:NEXT_ITEM]->(item_1337);
CREATE (item_1338:Item {id: 'g', content: 'Dekompresif kraniyektomi yapılan olgular,'});
CREATE (para_1330)-[:HAS_ITEM {order: 7}]->(item_1338);
CREATE (item_1337)-[:NEXT_ITEM]->(item_1338);
CREATE (item_1339:Item {id: 'ğ', content: 'Daha önce durası açık bırakılan olgular,'});
CREATE (para_1330)-[:HAS_ITEM {order: 8}]->(item_1339);
CREATE (item_1338)-[:NEXT_ITEM]->(item_1339);
CREATE (item_1340:Item {id: 'h', content: 'Beyin omurilik sıvısı fistülleri,'});
CREATE (para_1330)-[:HAS_ITEM {order: 9}]->(item_1340);
CREATE (item_1339)-[:NEXT_ITEM]->(item_1340);
CREATE (item_1341:Item {id: 'ı', content: 'Dura kaynaklı veya durayı atake eden tümörler.'});
CREATE (para_1330)-[:HAS_ITEM {order: 10}]->(item_1341);
CREATE (item_1340)-[:NEXT_ITEM]->(item_1341);
CREATE (para_1329)-[:NEXT_PARAGRAPH]->(para_1330);
CREATE (sec_1320)-[:NEXT_SUBSECTION]->(sec_1328);
CREATE (sec_1255)-[:NEXT_SUBSECTION]->(sec_1289);
CREATE (sec_1342:Subsection {id: '3.3.5', title: 'Enjektör bedelleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 4}]->(sec_1342);
CREATE (para_1343:Paragraph {id: '1', content: 'Ayaktan tedavide reçeteye yazılan enjektabl ilaç adedine ve ml’sine uygun enjektör bedeli Kurumca belirlenen bedel üzerinden ödenir.'});
CREATE (sec_1342)-[:HAS_PARAGRAPH {order: 0}]->(para_1343);
CREATE (para_1344:Paragraph {id: '2', content: 'İnsülin kalem iğne uçları bedelleri, insülin kartuşları ile birlikte ya da tek başına reçete edildiğinde bedeli Kurumca karşılanır.'});
CREATE (sec_1342)-[:HAS_PARAGRAPH {order: 1}]->(para_1344);
CREATE (para_1343)-[:NEXT_PARAGRAPH]->(para_1344);
CREATE (sec_1289)-[:NEXT_SUBSECTION]->(sec_1342);
CREATE (sec_1345:Subsection {id: '3.3.6', title: 'Kurumca iade alınan tıbbi malzemeler'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 5}]->(sec_1345);
CREATE (para_1346:Paragraph {id: '1', content: 'Kurum sağlık yardımlarından yararlandırılan kişilere iade alınmak kaydıyla taahhütname karşılığı temin edilen tıbbi malzemeler;'});
CREATE (sec_1345)-[:HAS_PARAGRAPH {order: 0}]->(para_1346);
CREATE (item_1347:Item {id: 'a', content: 'Non-İnvaziv Mekanik Ventilasyon Cihazları (CPAP, Auto CPAP, (Mülga:RG-21/04/2024-32524/10-a md. Yürürlük: 30/04/2024) BPAP-S, BPAP S/T, BPAP S/T AVAPS, ASV),'});
CREATE (para_1346)-[:HAS_ITEM {order: 0}]->(item_1347);
CREATE (item_1348:Item {id: 'b', content: 'Evde uzun süreli veya taşınabilir komponenti olan oksijen tedavisi cihazları (oksijen konsantratörü, oksijen tüpü ve başlığı, taşınabilir komponenti olan oksijen tedavi cihazları),'});
CREATE (para_1346)-[:HAS_ITEM {order: 1}]->(item_1348);
CREATE (item_1347)-[:NEXT_ITEM]->(item_1348);
CREATE (item_1349:Item {id: 'c', content: 'Ev tipi ventilatör,'});
CREATE (para_1346)-[:HAS_ITEM {order: 2}]->(item_1349);
CREATE (item_1348)-[:NEXT_ITEM]->(item_1349);
CREATE (item_1350:Item {id: 'ç', content: 'Akülü tekerlekli sandalye,'});
CREATE (para_1346)-[:HAS_ITEM {order: 3}]->(item_1350);
CREATE (item_1349)-[:NEXT_ITEM]->(item_1350);
CREATE (item_1351:Item {id: 'd', content: 'Ev tipi ventilatör için kesintisiz güç kaynağı.'});
CREATE (para_1346)-[:HAS_ITEM {order: 4}]->(item_1351);
CREATE (item_1350)-[:NEXT_ITEM]->(item_1351);
CREATE (para_1352:Paragraph {id: '2', content: 'Kurum tarafından iade alınan cihazların, Kurum sağlık yardımlarından yararlandırılan hastalara verilebilmesi için hastaların sağlık kurulu raporu ile Sosyal Güvenlik İl Müdürlüklerine müracaatta bulunmaları gerekmektedir. Sağlık kurulu raporlarında, “iade cihazın temini için Kuruma müracaat edilmesi gerektiği” belirtilecektir. Müracaatı takiben, söz konusu tıbbi cihazların Kurum stoklarından temin edilmesi yoluna gidilecek olup, stoklarda yok ise Kurum stoklarında cihazın olmadığına dair onay alınmak suretiyle hasta tarafından temin edilen cihaz bedelleri (maske, filtre, hasta devresi, su kabı, chamber (su haznesi), nazal kanül, başlık, nemlendirici, ısıtıcılı nemlendirici vb. aksesuarlar dahil) SUT’un 3.2.2 maddesi doğrultusunda Kurumca karşılanır. Onay alınmadan hasta tarafından temin edilen cihazların bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1345)-[:HAS_PARAGRAPH {order: 1}]->(para_1352);
CREATE (para_1346)-[:NEXT_PARAGRAPH]->(para_1352);
CREATE (sec_1353:Subsection {id: '3.3.6.A', title: 'Non-invaziv mekanik ventilasyon cihazlarının (NİMV) temini', content: '(Değişik: RG- 21/04/2024- 32524/ 10-b md. Yürürlük: 30/04/2024)'});
CREATE (sec_1345)-[:HAS_SUBSECTION {order: 0}]->(sec_1353);
CREATE (sec_1354:Subsection {id: '3.3.6.A-1', title: 'Uykuda solunum bozukluğu hastalıklarında NİMV cihazları verilme ilkeleri'});
CREATE (sec_1353)-[:HAS_SUBSECTION {order: 0}]->(sec_1354);
CREATE (para_1355:Paragraph {id: '1', content: 'NİMV cihazı verilecek hastalıklar; (Uluslararası Uyku Bozuklukları Sınıflamasına göre)'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 0}]->(para_1355);
CREATE (item_1356:Item {id: 'a', content: 'Obstruktif Uyku Apne Sendromu (OUAS),'});
CREATE (para_1355)-[:HAS_ITEM {order: 0}]->(item_1356);
CREATE (item_1357:Item {id: 'b', content: 'Santral Uyku Apne Sendromu,'});
CREATE (para_1355)-[:HAS_ITEM {order: 1}]->(item_1357);
CREATE (item_1356)-[:NEXT_ITEM]->(item_1357);
CREATE (item_1358:Item {id: 'c', content: 'Cheyne Stokes Solunumu,'});
CREATE (para_1355)-[:HAS_ITEM {order: 2}]->(item_1358);
CREATE (item_1357)-[:NEXT_ITEM]->(item_1358);
CREATE (item_1359:Item {id: 'ç', content: 'Uykuyla ilişkili hipoventilasyon/hipoksemik sendromlardır (uyku ilişkili obstrüktif olmayan idiyopatik alveoler hipoventilasyon, konjenital santral alveoler hipoventilasyon sendromu, pulmoner parankimal veya vasküler patolojilere bağlı hipoventilasyon hipoksemi, alt solunum yolu hastalıklarına/kronik obstrüktif akciğer hastalığına bağlı hipoventilasyon hipoksemi, nöromuskuler ya da göğüs duvarı hastalıklarına bağlı hipoventilasyon hipoksemi).'});
CREATE (para_1355)-[:HAS_ITEM {order: 3}]->(item_1359);
CREATE (item_1358)-[:NEXT_ITEM]->(item_1359);
CREATE (item_1360:Item {id: 'd', content: 'Kompleks uyku apnesi. (Değişik: RG- 21/04/2024- 32524/ 10-b md. Yürürlük: 30/04/2024)'});
CREATE (para_1355)-[:HAS_ITEM {order: 4}]->(item_1360);

// Batch 37
CREATE (item_1359)-[:NEXT_ITEM]->(item_1360);
CREATE (para_1361:Paragraph {id: '2', content: 'NİMV cihazları verilmesine ilişkin sağlık kurulu raporlarının (tanı-titrasyon uyku testleri), bünyesinde uyku merkezi bulunan sağlık hizmeti sunucuları sağlık kurullarınca düzenlenmesi gerekmektedir. Bu testlerin (tanı-titrasyon uyku 57 testleri) aynı sağlık hizmeti sunucusunda yapılma şartı aranmaksızın, sağlık kurulu raporunun titrasyon uyku testinin yapıldığı sağlık hizmeti sunucularınca düzenlenmesi gerekmektedir.'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 1}]->(para_1361);
CREATE (para_1355)-[:NEXT_PARAGRAPH]->(para_1361);
CREATE (para_1362:Paragraph {id: '3', content: 'Sağlık kurulu raporunda; göğüs hastalıkları, psikiyatri veya nöroloji uzman hekimlerinden herhangi üç uzman hekimin (aynı branştan üçünün veya farklı branştan birer kişinin veya bir branştan iki, diğer branştan bir olmak üzere toplam üç uzman hekimin) yer aldığı; hastanın çocuk olması halinde ise sağlık kurulu raporunda çocuk göğüs hastalıkları veya çocuk nöroloji uzmanlarından en az birinin yer alması ve bu hekimler tarafından reçete edilmesi zorunludur.'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 2}]->(para_1362);
CREATE (para_1361)-[:NEXT_PARAGRAPH]->(para_1362);
CREATE (para_1363:Paragraph {id: '4', content: 'Tüm gece boyunca, en az 16 kanallı polisomnografi cihazı (en az 3 kanallı olmak üzere elektroensefalografi, elektromyografi, elektrokardiyografi, elektrookülografi, oksimetre, hava akımı, karın ve göğüs solunum efor bantlarını ve horlama mikrofonu kaydını içermesi) ile yapılan tetkike ait raporda;'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 3}]->(para_1363);
CREATE (item_1364:Item {id: 'a', content: 'Uyku evreleri (total uyku süresi, uykuya geçiş süreleri, uyku etkinliği),'});
CREATE (para_1363)-[:HAS_ITEM {order: 0}]->(item_1364);
CREATE (item_1365:Item {id: 'b', content: 'Oksijen saturasyonu ortalama ve en düşük değerleri,'});
CREATE (para_1363)-[:HAS_ITEM {order: 1}]->(item_1365);
CREATE (item_1364)-[:NEXT_ITEM]->(item_1365);
CREATE (item_1366:Item {id: 'c', content: 'Oksijen desaturasyon indeksi,'});
CREATE (para_1363)-[:HAS_ITEM {order: 2}]->(item_1366);
CREATE (item_1365)-[:NEXT_ITEM]->(item_1366);
CREATE (item_1367:Item {id: 'ç', content: 'Apne-Hipopne İndeksi veya solunum bozukluğu indeksi (respiratory disturbance index/RDİ)'});
CREATE (para_1363)-[:HAS_ITEM {order: 3}]->(item_1367);
CREATE (item_1366)-[:NEXT_ITEM]->(item_1367);
CREATE (item_1368:Item {id: 'd', content: 'Apne-Hipopne veya RDI (Apne-Hipopne-Solunum çabasına bağlı uyanma reaksiyonu (respiratory effort related arousal: RERA)) süreleri,'});
CREATE (para_1363)-[:HAS_ITEM {order: 4}]->(item_1368);
CREATE (item_1367)-[:NEXT_ITEM]->(item_1368);
CREATE (item_1369:Item {id: 'e', content: 'Bunların yatış pozisyonu ve uyku evrelerine göre dağılımı, bilgilerinin yer alması gerekmektedir.'});
CREATE (para_1363)-[:HAS_ITEM {order: 5}]->(item_1369);
CREATE (item_1368)-[:NEXT_ITEM]->(item_1369);
CREATE (para_1362)-[:NEXT_PARAGRAPH]->(para_1363);
CREATE (para_1370:Paragraph {id: '5', content: 'Sağlık kurulu raporu ekinde polisomnografi ve titrasyon tetkikine ait raporlar yer almalıdır. (Değişik: RG- 21/04/2024- 32524/ 10-b md. Yürürlük: 30/04/2024)'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 4}]->(para_1370);
CREATE (para_1363)-[:NEXT_PARAGRAPH]->(para_1370);
CREATE (para_1371:Paragraph {id: '6', content: 'Sağlık kurulu raporunda tanı ve tedavi, tedavi basıncı ile hastanın kullanacağı NİMV cihazının türü ve birlikte kullanılacak aksesuarlar (maske, nemlendirici ve ısıtıcılı nemlendirici gibi) yer almalıdır.'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 5}]->(para_1371);
CREATE (para_1370)-[:NEXT_PARAGRAPH]->(para_1371);
CREATE (para_1372:Paragraph {id: '7', content: 'NİMV cihazı kullanımı sırasında oksijen saturasyonu %88’in üzerine çıkarılamadığının sağlık kurulu raporunda belirtilmesi koşuluyla NİMV tedavisine ek olarak verilen kronik oksijen tedavisine yönelik cihaz bedelleri Kurumca karşılanır.'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 6}]->(para_1372);
CREATE (para_1371)-[:NEXT_PARAGRAPH]->(para_1372);
CREATE (para_1373:Paragraph {id: '8', content: 'NİMV cihazlarının yıllık minimum 1.200 saatin altında kullanıldığının saptanması durumunda, kullanım saati bilgilerinin yer aldığı sevk evrakı ile hastaların sağlık hizmeti sunucusuna sevk edilmesi ve cihazla tedavinin devam edilip edilmeyeceğine ilişkin sağlık kurulu raporu tanzim edilmesi gerekmektedir. (Değişik: RG- 21/04/2024- 32524/ 10-b md. Yürürlük: 30/04/2024)'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 7}]->(para_1373);
CREATE (para_1372)-[:NEXT_PARAGRAPH]->(para_1373);
CREATE (para_1374:Paragraph {id: '9', content: 'Bünyesinde polisomnografi cihazı bulunan ikinci ve üçüncü basamak özel sağlık hizmeti sunucularının faaliyet izin belgesinde göğüs hastalıkları branşı veya nöroloji branşı (tam zamanlı göğüs hastalıkları uzmanı veya nöroloji uzmanı olan) olması halinde tanı-titrasyon uyku testleri yapılarak NİMV cihazlarının verilmesine ilişkin sağlık kurulu raporları düzenlenebilir. (Sağlık Bakanlığı “Özel Hastaneler Yönetmeliği” nde düzenleme yapılıp uyku laboratuvar ünitesi ruhsatı düzenleninceye kadar, polisomnografi cihazının faaliyet izin belgesine işlenmiş olup olmamasına bakılmayacaktır.)'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 8}]->(para_1374);
CREATE (para_1373)-[:NEXT_PARAGRAPH]->(para_1374);
CREATE (para_1375:Paragraph {id: '10', content: 'Isıtıcılı nemlendiricili üniteleri NİMV cihazlarına dâhildir. Ayrıca ısıtıcılı nemlendiricinin bedeli Kurumca karşılanmaz.'});
CREATE (sec_1354)-[:HAS_PARAGRAPH {order: 9}]->(para_1375);
CREATE (para_1374)-[:NEXT_PARAGRAPH]->(para_1375);
CREATE (sec_1376:Subsection {id: '3.3.6.A-2', title: 'Kronik solunum yetmezliğinde NİMV cihazları verilme ilkeleri'});
CREATE (sec_1353)-[:HAS_SUBSECTION {order: 1}]->(sec_1376);
CREATE (para_1377:Paragraph {id: '1', content: 'Kronik solunum yetmezliğinde yalnızca BPAP-S (Değişik:RG-21/04/2024-32524/10-c md. Yürürlük: 30/04/2024) , BPAP S/T ve BPAP S/T AVAPS cihaz bedelleri Kurumca karşılanacak olup, teminine ilişkin düzenlenecek sağlık kurulu raporunda göğüs hastalıkları, nöroloji, anestezi ve reanimasyon, yoğun bakım sorumlu uzmanı ile çocuk göğüs hastalıkları hekimlerinden en az birinin yer alması ve bu hekimler tarafından reçete edilmesi gerekmektedir.'});
CREATE (sec_1376)-[:HAS_PARAGRAPH {order: 0}]->(para_1377);
CREATE (para_1378:Paragraph {id: '2', content: 'Kronik stabil ya da yavaş ilerleyen solunum yetmezliği (gündüz ya da gece karbondioksit retansiyonuna bağlı semptom varlığı, noktürnal hipoventilasyon) varlığında hastanın ilaç ve oksijen tedavisi alıyorken stabil dönemde solunum yetmezliğinin önlenemiyor olması BPAP-S (Değişik:RG-21/04/2024-32524/10-c md. Yürürlük:30/04/2024) , BPAP S/T veya BPAP S/T AVAPS cihazı verilme endikasyonu olarak kabul edilir.'});
CREATE (sec_1376)-[:HAS_PARAGRAPH {order: 1}]->(para_1378);
CREATE (para_1377)-[:NEXT_PARAGRAPH]->(para_1378);
CREATE (para_1379:Paragraph {id: '3', content: 'Sağlık kurulu raporunda hastanın kullanacağı NİMV cihazının türü ve birlikte kullanılacak aksesuarlar (maske, nemlendirici ve ısıtıcılı nemlendirici gibi) yer alacaktır.'});
CREATE (sec_1376)-[:HAS_PARAGRAPH {order: 2}]->(para_1379);
CREATE (para_1378)-[:NEXT_PARAGRAPH]->(para_1379);
CREATE (sec_1354)-[:NEXT_SUBSECTION]->(sec_1376);
CREATE (sec_1380:Subsection {id: '3.3.6.B', title: 'Evde uzun süreli veya taşınabilir komponenti olan oksijen tedavisi cihazları', content: '(Değişik: RG- 21/04/2024- 32524/ 10-ç md. Yürürlük: 30/04/2024)'});
CREATE (sec_1345)-[:HAS_SUBSECTION {order: 1}]->(sec_1380);
CREATE (para_1381:Paragraph {id: '1', content: 'Kronik solunum yetmezliği tedavisinde uygulanacak oksijen sistemlerinin verilmesine yönelik sağlık kurulu raporları, göğüs hastalıkları, nöroloji, anestezi ve reanimasyon ile yoğun bakım sorumlu uzman tabiplerinden; hastanın çocuk olması halinde ise çocuk göğüs hastalıkları veya çocuk nöroloji uzmanlarından birinin yer aldığı sağlık kurullarınca düzenlenecektir. Ancak, çocuk göğüs hastalıkları veya çocuk nöroloji uzmanı bulunmayan sağlık hizmeti sunucularında, sağlık kurulu raporunun üçüncü basamak resmi sağlık hizmeti sunucularınca düzenlenmiş olması şartıyla, kronik solunum yetmezliği tedavisinde uygulanacak oksijen sistemlerinin verilmesine yönelik sağlık kurulu raporları, çocuk sağlığı ve hastalıkları uzman hekiminin bulunduğu sağlık kurullarınca da düzenlenecek ve bu hekimlerce reçete edilecektir.'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 0}]->(para_1381);
CREATE (para_1382:Paragraph {id: '2', content: 'Sağlık kurulu raporunda; tanı, hastanın kullanacağı oksijen cihazının türü ve gerekçesi, oksijen akım hızı, günlük kaç saat kullanılacağı ve birlikte kullanılacak aksesuarlar yer alacaktır. (Değişik: RG- 21/04/2024- 32524/ 10-ç md. Yürürlük: 30/04/2024)'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 1}]->(para_1382);
CREATE (para_1381)-[:NEXT_PARAGRAPH]->(para_1382);
CREATE (para_1383:Paragraph {id: '3', content: 'Sağlık kurulu raporu ekinde arteriyel kan gazı tetkiki (hasta adı-soyadı ve tarihin olduğu sağlık hizmeti sunucusu laboratuvar çıktısı) ve diğer kanıtlayıcı belgeler eklenecektir.'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 2}]->(para_1383);
CREATE (para_1382)-[:NEXT_PARAGRAPH]->(para_1383);
CREATE (para_1384:Paragraph {id: '4', content: 'Sağlık kurulu raporunda belirtilmek koşuluyla; (Değişik: RG- 21/04/2024- 32524/ 10-ç md. Yürürlük: 30/04/2024)'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 3}]->(para_1384);
CREATE (item_1385:Item {id: 'a', content: 'Kronik solunum yetmezliği olanlarda; (istirahat veya egzersiz halinde) PaO2 (Parsiyel Oksijen Basıncı) ≤ 55 mmHg veya SaO2 (Oksijen Saturasyonu) ≤ %88 olması halinde,'});
CREATE (para_1384)-[:HAS_ITEM {order: 0}]->(item_1385);
CREATE (item_1386:Item {id: 'b', content: 'Korpulmonale varlığında; PaO2’de 55-59 mmHg veya SaO2 ≤ %89 ile birlikte EKG’de “P Pulmonale” bulgusu olması veya hematokrit > %55 veya konjestif kalp yetmezliği olması halinde,'});
CREATE (para_1384)-[:HAS_ITEM {order: 1}]->(item_1386);
CREATE (item_1385)-[:NEXT_ITEM]->(item_1386);
CREATE (item_1387:Item {id: 'c', content: 'Akut solunum yetmezliği olan hastalarda stabil dönemde solunum yetmezliğinin önlenemiyor olması durumunda yukarıda birinci veya ikinci fıkralarda sıralanan bulgular sağlanıyorsa, 58'});
CREATE (para_1384)-[:HAS_ITEM {order: 2}]->(item_1387);
CREATE (item_1386)-[:NEXT_ITEM]->(item_1387);
CREATE (item_1388:Item {id: 'ç', content: 'Efor kapasitesini sınırlayan terminal dönem (kanser ve diğer sistemik hastalıklara bağlı) hastalarda, evde uzun süreli oksijen tedavisi cihazı bedelleri Kurumca karşılanır.'});
CREATE (para_1384)-[:HAS_ITEM {order: 3}]->(item_1388);
CREATE (item_1387)-[:NEXT_ITEM]->(item_1388);
CREATE (para_1383)-[:NEXT_PARAGRAPH]->(para_1384);
CREATE (para_1389:Paragraph {id: '5', content: 'Kurumca finansmanı sağlanacak evde uzun süreli veya taşınabilir komponenti olan oksijen tedavisi cihazları;'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 4}]->(para_1389);
CREATE (item_1390:Item {id: 'a', content: 'Oksijen tüpü (gaz hali),'});
CREATE (para_1389)-[:HAS_ITEM {order: 0}]->(item_1390);
CREATE (item_1391:Item {id: 'b', content: 'Oksijen konsantratörü,'});
CREATE (para_1389)-[:HAS_ITEM {order: 1}]->(item_1391);
CREATE (item_1390)-[:NEXT_ITEM]->(item_1391);
CREATE (item_1392:Item {id: 'c', content: 'Taşınabilir komponenti olan oksijen tedavi cihazları. (Değişik: RG- 21/04/2024- 32524/ 10-ç md. Yürürlük: 30/04/2024)'});
CREATE (para_1389)-[:HAS_ITEM {order: 2}]->(item_1392);
CREATE (item_1391)-[:NEXT_ITEM]->(item_1392);
CREATE (para_1384)-[:NEXT_PARAGRAPH]->(para_1389);
CREATE (para_1393:Paragraph {id: '6', content: 'Taşınabilir komponenti olan oksijen tedavisi cihazları; istirahat halinde PaO2 (Parsiyel Oksijen Basıncı) > 55 mmHg veya SaO2 (Oksijen Saturasyonu) > %88 olmasına karşın egzersiz durumunda veya iş sırasında desatüre (PaO2 ≤ 55 mmHg veya SaO2 ≤ %88) olması (egzersiz ile %4’den fazla desatüre olan) ve bu durumunu gösterir istirahat ve efor kan gazı sonuçlarının sağlık kurulu raporunda belirtilmesi ve/veya rapor ekinde belgelendirilmesi halinde, yatalak olmayan ve aktif iş yaşamını sürdüren veya öğrenci olan mobilize hastalarda (Sağlık kurulu raporunda bu durum ayrıca belirtilmelidir.) bedelleri Kurumca karşılanır. Ancak, istirahatte PaO2 ≤ 55 mmHg veya SaO2 ≤ %88 olan hastalar için efor kan gazı sonuçları istenmeyecektir.'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 5}]->(para_1393);
CREATE (para_1389)-[:NEXT_PARAGRAPH]->(para_1393);
CREATE (para_1394:Paragraph {id: '7', content: 'Oksijen konsantratörü verilen kişilere, raporda belirtilmek koşuluyla oksijen tüpü önerilmesi durumunda bedelleri Kurumca karşılanır.'});
CREATE (sec_1380)-[:HAS_PARAGRAPH {order: 6}]->(para_1394);
CREATE (para_1393)-[:NEXT_PARAGRAPH]->(para_1394);
CREATE (sec_1353)-[:NEXT_SUBSECTION]->(sec_1380);
CREATE (sec_1342)-[:NEXT_SUBSECTION]->(sec_1345);
CREATE (sec_1395:Subsection {id: '3.3.7', title: 'Ayakta dik pozisyonlama ve yürütme cihazları'});

// Batch 38
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 6}]->(sec_1395);
CREATE (sec_1396:Subsection {id: '3.3.7.A', title: 'Çocuklar için standing table'});
CREATE (sec_1395)-[:HAS_SUBSECTION {order: 0}]->(sec_1396);
CREATE (para_1397:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga:RG-16/03/2023-32134/17-g md. Yürürlük: 24/03/2023) fizik tedavi ve rehabilitasyon kliniklerinde yatırılarak uygulama ve eğitiminin yapılması sonucunda; ortopedi ve travmatoloji veya fiziksel tıp ve rehabilitasyon veya nöroloji uzman hekimlerinden herhangi üç uzman hekimin (aynı branştan üçünün veya farklı branştan birer kişinin veya bir branştan 2 (iki), diğer branştan 1 (bir) olmak üzere toplam 3 (üç) uzman hekimin) yer aldığı üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga:RG-16/03/2023-32134/17-g md. Yürürlük: 24/03/2023) düzenlenecek sağlık kurulu raporunda;'});
CREATE (sec_1396)-[:HAS_PARAGRAPH {order: 0}]->(para_1397);
CREATE (item_1398:Item {id: 'a', content: 'Bilinci açık olan,'});
CREATE (para_1397)-[:HAS_ITEM {order: 0}]->(item_1398);
CREATE (item_1399:Item {id: 'b', content: 'Kısmen baş kontrolü olan,'});
CREATE (para_1397)-[:HAS_ITEM {order: 1}]->(item_1399);
CREATE (item_1398)-[:NEXT_ITEM]->(item_1399);
CREATE (item_1400:Item {id: 'c', content: 'Herhangi bir nedene bağlı tetrapleji veya parapleji klinik tablosu olan veya diğer nörolojk defisitlere bağlı olarak ayakta durmanın tedaviye katkı sağlayacağının belirtilmesi ve 2-18 yaş arası hastalara bu hekimlerce reçete edilmesi halinde Kurumca bedeli karşılanır.'});
CREATE (para_1397)-[:HAS_ITEM {order: 2}]->(item_1400);
CREATE (item_1399)-[:NEXT_ITEM]->(item_1400);
CREATE (sec_1401:Subsection {id: '3.3.7.B', title: 'Erişkinler için stand up wheelchair'});
CREATE (sec_1395)-[:HAS_SUBSECTION {order: 1}]->(sec_1401);
CREATE (para_1402:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularının (Mülga:RG-16/03/2023-32134/17-ğ md. Yürürlük: 24/03/2023) fizik tedavi ve rehabilitasyon kliniklerinde yatırılarak uygulama ve eğitiminin yapılması sonucunda; ortopedi ve travmatoloji veya fiziksel tıp ve rehabilitasyon veya nöroloji uzman hekimlerinden herhangi 3 (üç) uzman hekimin (aynı branştan üçünün veya farklı branştan birer kişinin veya bir branştan 2 (iki), diğer branştan 1 (bir) olmak üzere toplam 3 (üç) uzman hekimin) yer aldığı üçüncü basamak resmi sağlık hizmeti sunucularınca (Mülga:RG-16/03/2023-32134/17-ğ md. Yürürlük:24/03/2023) düzenlenecek sağlık kurulu raporunda;'});
CREATE (sec_1401)-[:HAS_PARAGRAPH {order: 0}]->(para_1402);
CREATE (item_1403:Item {id: 'a', content: 'Bilinci açık ve kognitif fonksiyonları yerinde olan,'});
CREATE (para_1402)-[:HAS_ITEM {order: 0}]->(item_1403);
CREATE (item_1404:Item {id: 'b', content: 'Üst ekstremite motor fonksiyonları yerinde olan,'});
CREATE (para_1402)-[:HAS_ITEM {order: 1}]->(item_1404);
CREATE (item_1403)-[:NEXT_ITEM]->(item_1404);
CREATE (item_1405:Item {id: 'c', content: 'Progresif hastalığı olmayan,'});
CREATE (para_1402)-[:HAS_ITEM {order: 2}]->(item_1405);
CREATE (item_1404)-[:NEXT_ITEM]->(item_1405);
CREATE (item_1406:Item {id: 'ç', content: 'Herhangi bir nedene bağlı yerleşmiş parapleji klinik tablosu olduğunun belirtilmesi ve bu hekimlerce reçete edilmesi halinde aktif çalışan ve/veya öğrenci olan hastalarda Kurumca bedeli karşılanır.'});
CREATE (para_1402)-[:HAS_ITEM {order: 3}]->(item_1406);
CREATE (item_1405)-[:NEXT_ITEM]->(item_1406);
CREATE (para_1407:Paragraph {id: '2', content: 'Bu hastalarda, ayrıca tekerlekli sandalye ve ayakta dik konumlandırma cihaz bedeli Kurumca karşılanmaz.'});
CREATE (sec_1401)-[:HAS_PARAGRAPH {order: 1}]->(para_1407);
CREATE (para_1402)-[:NEXT_PARAGRAPH]->(para_1407);
CREATE (para_1408:Paragraph {id: '3', content: 'Stand up wheelchair miat süresi 5 (beş) yıldır. Bu süreden önce yenilenmesi halinde bedeli Kurumca karşılanmaz.'});
CREATE (sec_1401)-[:HAS_PARAGRAPH {order: 2}]->(para_1408);
CREATE (para_1407)-[:NEXT_PARAGRAPH]->(para_1408);
CREATE (sec_1396)-[:NEXT_SUBSECTION]->(sec_1401);
CREATE (sec_1345)-[:NEXT_SUBSECTION]->(sec_1395);

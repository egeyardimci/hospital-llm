CREATE (sec_1579:Subsection {id: '3.3.27', title: 'Kanama durdurmada kullanılan tıbbi malzemeler'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 26}]->(sec_1579);
CREATE (para_1580:Paragraph {id: '1', content: 'EK-3/A “Birden Fazla Branşta Kullanılan Tıbbi Malzemeler” listesinde bulunan ve kanama durdurmada kullanılan tıbbi malzemelerin, aşağıda yer alan geri ödeme kural ve/veya kriterlerine uygun olmak şartıyla bedelleri Kurumca karşılanır.'});
CREATE (sec_1579)-[:HAS_PARAGRAPH {order: 0}]->(para_1580);
CREATE (para_1581:Paragraph {id: '2', content: 'Kanama durdurmada kullanılan emilemeyen tıbbi malzemelerin, acil servislerde veya yatarak tedavilerde, epikrizde aşağıdaki durumlardan en az birinin belirtilmesi şartıyla en fazla 2 (iki) adet olmak üzere bedelleri Kurumca karşılanır.'});
CREATE (sec_1579)-[:HAS_PARAGRAPH {order: 1}]->(para_1581);
CREATE (item_1582:Item {id: 'a', content: 'Hemorajik diyateze neden olan durumlar ve/veya hastalıklarının olduğu bilinen vakalarda,'});
CREATE (para_1581)-[:HAS_ITEM {order: 0}]->(item_1582);
CREATE (item_1583:Item {id: 'b', content: 'Trombosit değerinin 50.000 K/mm³\'ün altında olduğu vakalarda,'});
CREATE (para_1581)-[:HAS_ITEM {order: 1}]->(item_1583);
CREATE (item_1582)-[:NEXT_ITEM]->(item_1583);
CREATE (item_1584:Item {id: 'c', content: 'Maligniteye sekonder kanamalarda,'});
CREATE (para_1581)-[:HAS_ITEM {order: 2}]->(item_1584);
CREATE (item_1583)-[:NEXT_ITEM]->(item_1584);
CREATE (item_1585:Item {id: 'ç', content: 'Girişimsel ve iatrojenik işlemler hariç olmak üzere boyun, aksiller bölge ve inguinal bölgenin direkt bası ile durdurulamayan travmaya bağlı açık kanamalı damar yaralanmalarında.'});
CREATE (para_1581)-[:HAS_ITEM {order: 3}]->(item_1585);
CREATE (item_1584)-[:NEXT_ITEM]->(item_1585);
CREATE (para_1580)-[:NEXT_PARAGRAPH]->(para_1581);
CREATE (para_1586:Paragraph {id: '3', content: 'Kanama durdurmada kullanılan emilebilen tıbbi malzemelerin yatarak tedavilerde, epikrizde aşağıdaki durumlardan en az birinin ve kullanılan tıbbi malzeme sayısının belirtilmesi şartıyla bedelleri Kurumca karşılanır.'});
CREATE (sec_1579)-[:HAS_PARAGRAPH {order: 2}]->(para_1586);
CREATE (item_1587:Item {id: 'a', content: 'Hemorajik diyateze neden olan durumlar ve/veya hastalıklarının olduğu bilinen vakalarda,'});
CREATE (para_1586)-[:HAS_ITEM {order: 0}]->(item_1587);
CREATE (item_1588:Item {id: 'b', content: 'Trombosit değeri 50.000 K/mm³\'ün altında olduğu vakalarda,'});
CREATE (para_1586)-[:HAS_ITEM {order: 1}]->(item_1588);
CREATE (item_1587)-[:NEXT_ITEM]->(item_1588);
CREATE (item_1589:Item {id: 'c', content: 'Maligniteye sekonder kanamalarda,'});
CREATE (para_1586)-[:HAS_ITEM {order: 2}]->(item_1589);
CREATE (item_1588)-[:NEXT_ITEM]->(item_1589);
CREATE (item_1590:Item {id: 'ç', content: 'Multi travmaya bağlı açık kanamalı damar yaralanmalarında,'});
CREATE (para_1586)-[:HAS_ITEM {order: 3}]->(item_1590);
CREATE (item_1589)-[:NEXT_ITEM]->(item_1590);
CREATE (item_1591:Item {id: 'd', content: 'Ligasyon, koter, sütür uygulanamayan veya bu uygulamalarla durdurulamayan endoskopik/intraoperatif kanamalarda.'});
CREATE (para_1586)-[:HAS_ITEM {order: 4}]->(item_1591);
CREATE (item_1590)-[:NEXT_ITEM]->(item_1591);
CREATE (para_1581)-[:NEXT_PARAGRAPH]->(para_1586);
CREATE (sec_1525)-[:NEXT_SUBSECTION]->(sec_1579);
CREATE (sec_1592:Subsection {id: '3.3.28', title: 'Hücresiz kıkırdak matriksleri'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 27}]->(sec_1592);
CREATE (para_1593:Paragraph {id: '1', content: 'SUT eki “EK-2/B Hizmet Başı İşlem Puan Listesi” için 612732 veya 612976 SUT kodları, “EK-2/C Tanıya Dayalı İşlem Puan Listesi” için P612732 veya P612976 SUT kodları ile birlikte uygulanması ve üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-ş md. Yürürlük:24/03/2023) (eğitim verme yetkisi olan klinik) işlem başına en fazla 1 (bir) adet kullanılması halinde bedeli Kurumca karşılanır.'});
CREATE (sec_1592)-[:HAS_PARAGRAPH {order: 0}]->(para_1593);
CREATE (sec_1579)-[:NEXT_SUBSECTION]->(sec_1592);
CREATE (sec_1594:Subsection {id: '3.3.29', title: 'Hücresiz menisküs implantları:'});
CREATE (sec_1221)-[:HAS_SUBSECTION {order: 28}]->(sec_1594);
CREATE (para_1595:Paragraph {id: '1', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG-16/03/2023-32134/17-t md. Yürürlük: 24/03/2023) (eğitim verme yetkisi olan klinik) işlem başına en fazla 1 (bir) adet kullanıldığında bedeli Kurumca karşılanır.'});
CREATE (sec_1594)-[:HAS_PARAGRAPH {order: 0}]->(para_1595);
CREATE (sec_1592)-[:NEXT_SUBSECTION]->(sec_1594);

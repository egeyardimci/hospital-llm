CREATE (sec_3676)-[:NEXT_SUBSECTION]->(sec_3680);
CREATE (sec_3711:Subsection {id: '4.2.72', title: 'Mitokondriyal sitopati hastalığında tedaviye yardımcı olarak kullanılan ürünler'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 70}]->(sec_3711);
CREATE (para_3712:Paragraph {id: '1', content: 'Mitokondriyal sitopati hastalığında tedaviye yardımcı olarak kullanılan takviye edici gıdalar için; aşağıda yer alan durumların belirtildiği üçüncü basamak sağlık hizmeti sunucularında 6 ay süreli çocuk nöroloji, çocuk endokrinoloji ve metabolizma, çocuk metabolizma veya erişkin endokrinoloji ve metabolizma uzman hekimlerinden en az birinin bulunduğu sağlık kurulu raporuna istinaden tedaviye başlanır. Tedavinin devamında hastanın klinik durumu değerlendirilir ve yukarıda belirtilen uzman hekimlerden birinin yer aldığı raporlarda hastanın klinik durumu da belirtilir.'});
CREATE (sec_3711)-[:HAS_PARAGRAPH {order: 0}]->(para_3712);
CREATE (item_3713:Item {id: 'a', content: 'Mitokondriyal DNA veya nükleer DNA’da mitokondriyal hastalığa yol açtığı bilinen gende patojenik mutasyon saptanması sonucunda mitokondriyal hastalık tanısı kesinleşmiş hastalar.'});
CREATE (para_3712)-[:HAS_ITEM {order: 0}]->(item_3713);
CREATE (item_3714:Item {id: 'b', content: 'Mitokondriyal hastalık tanısı genetik çalışmalar ile kesinleşmemiş hastalarda ise aşağıdaki kriterlerden en az ikisi karşılanan hastalar: asit veya kan gazı analizi veya kan laktat yüksekliği) anlamlı bulguların görülmesi.'});
CREATE (para_3712)-[:HAS_ITEM {order: 1}]->(item_3714);
CREATE (subitem_3715:SubItem {id: '1', content: 'Kas veya diğer organ biyopsilerinde mitokondriyal hastalık telkin eden bulguların olması.'});
CREATE (item_3714)-[:HAS_SUBITEM {order: 0}]->(subitem_3715);
CREATE (subitem_3716:SubItem {id: '2', content: 'Mitokondriyal hastalığı destekleyen en az bir organ tutulumu olması.'});
CREATE (item_3714)-[:HAS_SUBITEM {order: 1}]->(subitem_3716);
CREATE (subitem_3715)-[:NEXT_SUBITEM]->(subitem_3716);
CREATE (subitem_3717:SubItem {id: '3', content: 'Biyokimyasal tetkiklerde (kanda açil karnitin veya karnitin analizi veya idrar-kan aminoasitleri veya idrar organik'});
CREATE (item_3714)-[:HAS_SUBITEM {order: 2}]->(subitem_3717);
CREATE (subitem_3716)-[:NEXT_SUBITEM]->(subitem_3717);
CREATE (subitem_3718:SubItem {id: '4', content: 'Görüntüleme incelemelerinde klinik olarak mitokondriyal hastalığı destekleyici bulguların görülmesi.'});
CREATE (item_3714)-[:HAS_SUBITEM {order: 3}]->(subitem_3718);
CREATE (subitem_3717)-[:NEXT_SUBITEM]->(subitem_3718);
CREATE (subitem_3719:SubItem {id: '5', content: 'Genetik olarak kanıtlanmış mitokondriyal hastalık aile öyküsü görülmesi.'});
CREATE (item_3714)-[:HAS_SUBITEM {order: 4}]->(subitem_3719);
CREATE (subitem_3718)-[:NEXT_SUBITEM]->(subitem_3719);
CREATE (item_3713)-[:NEXT_ITEM]->(item_3714);
CREATE (para_3720:Paragraph {id: '2', content: 'Mitokondriyal sitopati hastalığında tedaviye yardımcı olarak kullanılan takviye edici gıdaların bedelleri aylık nakden 800,00 (sekiz yüz) TL olarak sağlık kurulu raporu ile şahıs bazında ödenir.'});
CREATE (sec_3711)-[:HAS_PARAGRAPH {order: 1}]->(para_3720);
CREATE (para_3712)-[:NEXT_PARAGRAPH]->(para_3720);
CREATE (sec_3680)-[:NEXT_SUBSECTION]->(sec_3711);
CREATE (sec_1687)-[:NEXT_SECTION]->(sec_1795);
CREATE (sec_3721:Section {id: '4.3', title: 'Yurt dışından ilaç getirilmesi'});
CREATE (doc_1)-[:HAS_SECTION {order: 22}]->(sec_3721);
CREATE (para_3722:Paragraph {id: '1', content: 'Kurum sağlık yardımlarından yararlandırılan kişiler için gerekli görülen ve yurt içinden sağlanması mümkün olmayan ilaçların, yurt içinde bulunmadığı ve kullanılmasının zorunlu olduğu Sağlık Bakanlığı tarafından onaylanarak ilaç teminine izin verildiği takdirde yurt dışından temini mümkündür. Bu amaçla, Türk Eczacıları Birliği (TEB) ile Kurum arasında protokol yürürlüktedir. Mevzuat değişikliği yapılarak Sağlık Bakanlığınca yetkilendirilmiş diğer taraflarla da protokol yapılabilir.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 0}]->(para_3722);
CREATE (para_3723:Paragraph {id: '2', content: 'Sağlık Bakanlığınca, yurt dışından getirtilebilecek ilaç listesi yayımlanması halinde listede yer alacak ilaçlar için ayrıca onay aranmayacaktır.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 1}]->(para_3723);
CREATE (para_3722)-[:NEXT_PARAGRAPH]->(para_3723);
CREATE (para_3724:Paragraph {id: '3', content: 'Yurt dışından temini halinde bedeli ödenecek olan ilaçlar “Yurt Dışı İlaç Fiyat Listesi” nde (EK-4/C) belirtilmiştir. Bu listede yer almayan ilaçların bedelleri Kurumca ödenmez. Bu liste Kurumun resmi internet sitesinde yayımlanır.  EK-4/C Listesinde yer almayan ilaçların EK-4/C Listesine alınmasına yönelik başvuruların (eşdeğer ilaç uygulaması kapsamında yapılan eşdeğer ilaç kaydı başvuruları hariç olmak üzere) Kurumca değerlendirmeye alınabilmesi için; üçüncü basamak resmi sağlık (Değişik:RG-25/08/2022-31934/50-a md. Yürürlük: 03/09/2022) hizmet sunucularında düzenlenmiş sağlık kurulu raporu ile üçüncü basamak resmi sağlık (Değişik:RG- 25/08/2022-31934/50-a md. Yürürlük:03/09/2022) hizmet sunucularında düzenlenmiş reçetenin Kuruma ibraz edilmesi gerekmektedir.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 2}]->(para_3724);
CREATE (para_3723)-[:NEXT_PARAGRAPH]->(para_3724);
CREATE (para_3725:Paragraph {id: '4', content: 'EK-4/C Listesinde yer alan ilaçların kişilerin kendi imkânları ile (yurt dışından veya yurt içinden) temini halinde, ilaç bedelleri Kurumca belirlenen mevzuat kapsamında hak sahibi adına banka aracılığıyla ödenir. Bu şekilde ödemesi yapılacak ilacın bedeli, farklı finansal modeller kapsamında değerlendirilen ilaçlar dahil olmak üzere, aynı ilacın Kuruma mal oluş bedelinden fazla olamaz. Farklı finansal modeller kapsamında değerlendirilen ve Kurumun internet sayfasında kamu baz fiyatları (ilacın 11/12/2015 tarihli ve 29559 sayılı Resmî Gazete’de yayımlanan Beşeri Tıbbi Ürünlerin Fiyatlandırılması Hakkında Tebliğde yer alan güncel referans ülkelerdeki veya bu referans ülkelerde ruhsatlı olmaması halinde ruhsatlı olduğu Avrupa ülkelerindeki en düşük depocuya satış fiyatından yüksek olmamak koşulu ile farklı finansal model sözleşmeleri kapsamında belirlenen fiyat) yayımlanan yurtdışı ilaçları hak sahiplerinin kendi imkanlarıyla temin etmeleri halinde ilaç bedelleri; ilacın Kurumla protokolü bulunan tedarikçiden protokollerde belirlenen süreler dahilinde temin edilemediğinin belgelenmesi kaydıyla Kuruma mal oluş bedeli üzerinden ödenir.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 3}]->(para_3725);
CREATE (para_3724)-[:NEXT_PARAGRAPH]->(para_3725);
CREATE (para_3726:Paragraph {id: '5', content: 'Bu ilaçlardan EK-4/D Listesi kapsamında olanlardan hasta katılım payı alınmaz.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 4}]->(para_3726);
CREATE (para_3725)-[:NEXT_PARAGRAPH]->(para_3726);
CREATE (para_3727:Paragraph {id: '6', content: 'Tedavi için yurt dışından getirtilecek ilaçların, SUT ve eki listelerde yer alan özel hükümler saklı kalmak kaydıyla, uzman hekim tarafından düzenlenen uzman hekim raporuna dayanılarak uzman hekimler tarafından reçeteye en fazla 90 günlük doza kadar yazılması halinde bedelleri ödenir. Bu raporlarda ilacın etken maddesi, günlük kullanım dozu, uygulama planı ve süresi de belirtilecektir.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 5}]->(para_3727);
CREATE (para_3726)-[:NEXT_PARAGRAPH]->(para_3727);
CREATE (para_3728:Paragraph {id: '7', content: 'Onkoloji ilaçları en fazla 90 gündeki kür sayısı kadar dozda ve SUT’un 4.2.14 maddesi doğrultusunda reçetelenir.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 6}]->(para_3728);
CREATE (para_3727)-[:NEXT_PARAGRAPH]->(para_3728);
CREATE (para_3729:Paragraph {id: '8', content: 'Sağlık Bakanlığı izni ile yurt dışından temin edilerek tedavide kullanılan ilacın/ilaçların ülkemizde ruhsat alarak (Değişik:RG-25/08/2022-31934/50-b md. Yürürlük:03/09/2022) dağıtım belgesi alması durumunda; (Ek:RG- 25/08/2022- 31934/50-b md. Yürürlük:03/09/2022) dağıtım belgesi tarihi esas alınacak şekilde EK-4/A Listesine giriş talebinden itibaren, talebin sonuçlandırılacağı maksimum süre içerisinde, SUT ve eki listelerde yer alan özel hükümler saklı kalmak kaydıyla, uzman hekim raporuna ve Sağlık Bakanlığınca verilecek kullanım onayına dayanılarak söz konusu kullanım onayında belirtilmiş süre boyunca uzman hekimlerce en fazla birer aylık miktarlarda reçete edilmesi koşuluyla, Sağlık Bakanlığınca ilaca verilen perakende satış fiyatı üzerinden SUT’un 4.4.1 maddesinde tanımlı indirim oranları (firmalar tarafından verilen özel iskontolar dahil) uygulandıktan sonra kademeli eczane iskontosu uygulanarak sözleşmeli eczanelerden şahıslara düzenlenecek faturalara dayanılarak ödemesi yapılacaktır. Ödemelerde, faturada yer alan her bir kutu ilaç için ödenecek tutar her hâlükârda Yurt Dışı İlaç Fiyat Listesi’nde (EK-4/C) kayıtlı fiyatın standart kamu kurum iskontosu olarak oranı SUT’un 4.4.1 maddesinde tanımlı baz iskonto uygulandıktan sonra bulunacak tutarından daha fazla olamaz. (Ek:RG-09/09/2017-30175/36md. 147 Yürürlük:09/09/2017) Ancak, Sağlık Bakanlığınca ilaca verilen perakende satış fiyatı nedeniyle, bu fıkra kapsamında yapılan hesaplama sonucu bulunacak tutarın fazla olması halinde, bu durumdaki ilaca ilişkin MEDULA sistemi kayıtları, EK-4/C’de kayıtlı fiyatının EK-4/A Listesine giriş talep tarihindeki T.C. Merkez Bankası efektif döviz satış kuru üzerinden TL karşılığına çevrilerek SUT’un 4.4.1 maddesinde tanımlı baz iskontonun uygulanmasını müteakip bulunacak tutar üzerinden yapılır. Bu ilaçların temin edilmesinde SUT’un 4.5.2 maddesinin birinci fıkrasında belirtilen 4 iş günlük süre aranmaz. Bu ilaçlardan EK- 4/D Listesi kapsamında olanlardan hasta katılım payı alınmaz. (Ek: RG-25/08/2022-31934/50-b md. Yürürlük:03/09/2022) Uzman hekim raporu ve reçetenin Sağlık Bakanlığınca verilecek kullanım onay tarihi sonrasında düzenlenmesi esastır.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 7}]->(para_3729);
CREATE (para_3728)-[:NEXT_PARAGRAPH]->(para_3729);
CREATE (para_3730:Paragraph {id: '9', content: 'Sağlık Hizmetleri Fiyatlandırma Komisyonunca fiyatları güncellenenler ile listeye ilave edilerek ödenmesine karar verilen ilaçların onaylanan fiyatları EK-4/C Listesinde yayınlanır.'});
CREATE (sec_3721)-[:HAS_PARAGRAPH {order: 8}]->(para_3730);

// Batch 100
CREATE (para_3729)-[:NEXT_PARAGRAPH]->(para_3730);

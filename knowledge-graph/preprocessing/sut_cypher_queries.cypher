CREATE (sec_2480)-[:NEXT_SUBSECTION]->(sec_2488);
CREATE (sec_2858:Subsection {id: '4.2.14.Ç', title: 'Kanser tedavisinde kullanılan diğer ilaçlar'});
CREATE (sec_2472)-[:HAS_SUBSECTION {order: 3}]->(sec_2858);
CREATE (para_2859:Paragraph {id: '1', content: 'SUT’un 4.2.14 maddesinde isimleri veya endikasyonu belirtilmeyen ilaçların kanser tedavisinde kullanımında; tıbbi onkoloji veya hematoloji uzman hekimlerinden en az birinin yer aldığı 1 yıl süreli sağlık kurulu raporuna dayanılarak tüm uzman hekimlerce reçete edilir. (Değişik: RG- 04/05/2013- 28637/ 13-a md. Yürürlük: 11/05/2013) (Değişik: RG- 26/09/2013- 28777/ 6-a md. Yürürlük: 04/10/2013) (Değişik: RG- 25/07/2014- 29071/ 28-a md. Yürürlük: 07/08/2014)'});
CREATE (sec_2858)-[:HAS_PARAGRAPH {order: 0}]->(para_2859);
CREATE (sec_2488)-[:NEXT_SUBSECTION]->(sec_2858);
CREATE (sec_2379)-[:NEXT_SUBSECTION]->(sec_2472);
CREATE (sec_2860:Subsection {id: '4.2.15', title: 'Klopidogrel, silostazol, ivabradin, prasugrel, dabigatran, rivaroksaban, apiksaban,(Ek: RG-21/04/2022-', content: '31816/4-a md. Yürürlük: 29/04/2022) edoksaban, tikagrelor ve ranolazin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 14}]->(sec_2860);
CREATE (sec_2861:Subsection {id: '4.2.15.A', title: 'Klopidogrel (kombinasyonları dahil);'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 0}]->(sec_2861);
CREATE (para_2862:Paragraph {id: '1', content: 'Koroner artere stent uygulanacak hastalarda; kardiyoloji veya kalp damar cerrahisi uzman hekimleri tarafından rapor aranmaksızın 24 saat öncesinden başlanabilir. Stent takılan hastalarda hastanın taburcu olmasından itibaren rapor aranmaksızın 4 haftalık doz bu hekimler tarafından reçete edilebilir.'});
CREATE (sec_2861)-[:HAS_PARAGRAPH {order: 0}]->(para_2862);
CREATE (para_2863:Paragraph {id: '2', content: 'Akut koroner sendrom tanısıyla hastaneye yatırılan veya müşahedeye alınan hastalarda EKG değişikliği veya troponin pozitif olan ST yükselmesiz miyokard enfarktüsü veya anstabil anginalı hastalar ile ST yükselmeli miyokard enfarktüsü hastalarında; kardiyoloji, kalp damar cerrahisi, iç hastalıkları veya acil tıp uzman hekimleri tarafından rapor aranmaksızın reçete edilebilir. Bu durumlarda hasta taburcu olduktan sonra 4 haftayı geçmemek üzere bu hekimlerden biri tarafından raporsuz veya bu uzman hekimlerce düzenlenen ve 12 ayı geçmemek üzere kullanım süresinin belirtildiği uzman hekim raporu ile diğer hekimler tarafından da reçete edilebilir.'});
CREATE (sec_2861)-[:HAS_PARAGRAPH {order: 1}]->(para_2863);
CREATE (para_2862)-[:NEXT_PARAGRAPH]->(para_2863);
CREATE (para_2864:Paragraph {id: '3', content: '(Değişik: RG- 04/05/2013- 28637/ 13-b md. Yürürlük: 11/05/2013) ) (Değişik: RG- 25/07/2014- 29071/ 28- b md. Yürürlük: 07/08/2014 ) . (Değişik: RG-30/08/2014-29104/15-a md. Yürürlük: 06/09/2014) Kalp kapak biyoprotezi bulunan veya anjiografik olarak belgelenmiş koroner arter hastalığı olan veya tıkayıcı periferik arter hastalığı olan veya serebral iskemik olay (iskemik inme) saptanmış olan hastalarda; kardiyoloji, iç hastalıkları, nöroloji, kalp damar cerrahisi veya acil tıp uzman hekimlerinden biri tarafından düzenlenen ve 12 ayı geçmemek üzere kullanım süresinin belirtildiği uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilebilir. Raporun yenilenmesi halinde yukarıda belirtilen hususlar geçerlidir.'});
CREATE (sec_2861)-[:HAS_PARAGRAPH {order: 2}]->(para_2864);
CREATE (para_2863)-[:NEXT_PARAGRAPH]->(para_2864);
CREATE (para_2865:Paragraph {id: '4', content: 'Girişimsel periferik veya serebral işlemler sonucu, intrakraniyal de dahil olmak üzere tüm intravasküler (intraarteriyel veya intravenöz) stent, stentgraft, kaplı stent veya tüm intravasküler cihaz (koil, trispan, onyx veya benzeri) yerleştirilen hastalarda; kardiyoloji, iç hastalıkları, nöroloji, kalp damar cerrahisi  , beyin cerrahi uzman hekimleri veya girişimsel radyoloji işlemini yapan radyoloji uzman hekimi tarafından rapor aranmaksızın 24 saat öncesinden başlanabilir. Bu işlemler ile stent takılan hastanın taburcu olmasından itibaren rapor aranmaksızın 4 haftalık doz bu hekimler tarafından reçete edilebilir.'});
CREATE (sec_2861)-[:HAS_PARAGRAPH {order: 3}]->(para_2865);
CREATE (para_2864)-[:NEXT_PARAGRAPH]->(para_2865);
CREATE (amend_2866:Amendment {content: '(Ek: RG- 07/10/2016- 29850/ 24 md. \nYürürlük: 15/10/2016)'});
CREATE (sec_2861)-[:HAS_AMENDMENT {order: 0}]->(amend_2866);
CREATE (sec_2867:Subsection {id: '4.2.15.B', title: 'Silostazol;'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 1}]->(sec_2867);
CREATE (para_2868:Paragraph {id: '1', content: 'En az bir kalp damar cerrahi uzman hekiminin yer aldığı, kalp damar cerrahi uzman hekiminin bulunmadığı yerlerde ise kardiyoloji uzmanı ile genel cerrahi uzman hekiminin birlikte yer aldığı, 1 yıl süreli sağlık kurulu raporuna dayanılarak; bu hekimlerce veya iç hastalıkları veya aile hekimliği uzman hekimlerince;'});
CREATE (sec_2867)-[:HAS_PARAGRAPH {order: 0}]->(para_2868);
CREATE (item_2869:Item {id: 'a', content: 'İleri evre periferik arter hastalığı olup (doppler veya anjiyografik olarak hastalığı tespit edilmiş ve klas 3 veya klas 4 semptomları olan) operasyon yapılamayan hastalarda;'});
CREATE (para_2868)-[:HAS_ITEM {order: 0}]->(item_2869);
CREATE (item_2870:Item {id: 'b', content: 'Doppler veya anjiyografi ile periferik arter hastalığı tespit edilmiş olan ve eşlik eden hastalıklar nedeniyle operasyonu yüksek riskli olan hastalarda; reçete edilir.'});
CREATE (para_2868)-[:HAS_ITEM {order: 1}]->(item_2870);
CREATE (item_2869)-[:NEXT_ITEM]->(item_2870);
CREATE (sec_2861)-[:NEXT_SUBSECTION]->(sec_2867);
CREATE (sec_2871:Subsection {id: '4.2.15.C', title: 'Ivabradin; (Değişik: RG- 25/07/2014- 29071/ 28 md. Yürürlük: 07/08/2014)'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 2}]->(sec_2871);
CREATE (para_2872:Paragraph {id: '1', content: 'Normal sinüs ritmi olan, kronik stabil angına pektorisli hastaların semptomatik tedavisinde Beta blokör ve/veya verapamil-diltiazem intoleransı veya kontrendikasyonu olan hastalar için kardiyoloji uzmanlarınca düzenlenen 1 yıl süreli uzman hekim raporuna dayanılarak kardiyoloji uzmanı veya iç hastalıkları uzmanı tarafından reçete edilebilir.'});
CREATE (sec_2871)-[:HAS_PARAGRAPH {order: 0}]->(para_2872);
CREATE (para_2873:Paragraph {id: '2', content: 'Kronik kalp yetmezliği  tedavisinde; sistolik disfonksiyonlu NYHA II ilâ IV sınıfında, sinüs ritminde olan ve kalp hızı 75 vuru/dakika ve üzeri yetişkin hastalarda aşağıdaki durumlarda kardiyoloji uzmanlarınca düzenlenen 1 yıl süreli uzman hekim raporuna dayanılarak kardiyoloji veya iç hastalıkları uzman hekimleri tarafından reçete edilebilir;'});
CREATE (sec_2871)-[:HAS_PARAGRAPH {order: 1}]->(para_2873);
CREATE (item_2874:Item {id: 'a', content: 'Beta blokör tedavisi dahil standart tedavi ile kombinasyon halinde veya'});
CREATE (para_2873)-[:HAS_ITEM {order: 0}]->(item_2874);
CREATE (item_2875:Item {id: 'b', content: 'Beta blokör kontrendikasyonu olan veya'});
CREATE (para_2873)-[:HAS_ITEM {order: 1}]->(item_2875);
CREATE (item_2874)-[:NEXT_ITEM]->(item_2875);
CREATE (item_2876:Item {id: 'c', content: 'Beta blokör tedavisine intoleransı olan. (Ek: RG- 25/08/2022- 31934/ 28-a md. Yürürlük: 03/09/2022)'});
CREATE (para_2873)-[:HAS_ITEM {order: 2}]->(item_2876);
CREATE (item_2875)-[:NEXT_ITEM]->(item_2876);
CREATE (para_2872)-[:NEXT_PARAGRAPH]->(para_2873);
CREATE (amend_2877:Amendment {content: '(Değişik: RG- 07/10/2016- 29850/ 25 md. Yürürlük: 15/10/2016)'});
CREATE (sec_2871)-[:HAS_AMENDMENT {order: 0}]->(amend_2877);
CREATE (amend_2878:Amendment {content: '(Değişik:RG-16/03/2023-32134/25 md. Yürürlük:24/03/2023)'});
CREATE (sec_2871)-[:HAS_AMENDMENT {order: 1}]->(amend_2878);
CREATE (amend_2879:Amendment {content: '(Değişik: RG- 16/03/2023-32134/25 md. Yürürlük: 24/03/2023)'});
CREATE (sec_2871)-[:HAS_AMENDMENT {order: 2}]->(amend_2879);
CREATE (sec_2867)-[:NEXT_SUBSECTION]->(sec_2871);
CREATE (sec_2880:Subsection {id: '4.2.15.Ç', title: 'Prasugrel;'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 3}]->(sec_2880);
CREATE (para_2881:Paragraph {id: '1', content: '75 yaşın altında 60 kg’ın üstündeki serebrovasküler olay öyküsü olmayan akut koroner sendromlu olup;'});
CREATE (sec_2880)-[:HAS_PARAGRAPH {order: 0}]->(para_2881);

// Batch 78
CREATE (item_2882:Item {id: 'a', content: 'Perkütan koroner girişim kararı alınan ST yükselmesiz miyokard enfarktüsü [NSTEMI] hastalarda,'});
CREATE (para_2881)-[:HAS_ITEM {order: 0}]->(item_2882);
CREATE (item_2883:Item {id: 'b', content: 'Perkütan koroner girişim kararı alınan ST yükselmeli miyokard enfarktüsü [STEMI]) hastalarında,'});
CREATE (para_2881)-[:HAS_ITEM {order: 1}]->(item_2883);
CREATE (item_2882)-[:NEXT_ITEM]->(item_2883);
CREATE (para_2884:Paragraph {id: '2', content: 'Klopidogrel tedavisi altında iken stent trombozu gelişen akut koroner sendromlu (AKS) hastalarda,'});
CREATE (sec_2880)-[:HAS_PARAGRAPH {order: 1}]->(para_2884);
CREATE (para_2881)-[:NEXT_PARAGRAPH]->(para_2884);
CREATE (para_2885:Paragraph {id: '3', content: 'Bu durumlarda rapor aranmaksızın 4 haftalık doz kardiyoloji veya kalp damar cerrahi uzman hekimlerince veya bu durumların belirtildiği en az bir kardiyoloji veya kalp damar cerrahi uzman hekiminin yer aldığı 1 yıl süreli sağlık kurulu raporuna dayanılarak yine bu hekimlerce ya da iç hastalıkları uzman hekimlerince reçetelenebilir. Tedavi süresi 1 yıldır. İlacın hastaya tekrar kullanımı ancak hastada aynı koşulların yeniden oluşması halinde mümkündür. (Değişik: RG- 25/07/2014- 29071/ 28-d md. Yürürlük: 07/08/2014) (Ek:RG-09/09/2017-30175/21-a md.Yürürlük: 23/09/2017) 118'});
CREATE (sec_2880)-[:HAS_PARAGRAPH {order: 2}]->(para_2885);
CREATE (para_2884)-[:NEXT_PARAGRAPH]->(para_2885);
CREATE (sec_2871)-[:NEXT_SUBSECTION]->(sec_2880);
CREATE (sec_2886:Subsection {id: '4.2.15.D', title: 'Dabigatran, rivaroksaban, edoksaban ve apiksaban;', content: '(Ek:RG- 09/09/2017-30175/ 21-b md. Yürürlük: 23/09/2017)'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 4}]->(sec_2886);
CREATE (sec_2887:Subsection {id: '4.2.15.D-1', title: 'Dabigatran, rivaroksaban, edoksaban ve apiksaban;'});
CREATE (sec_2886)-[:HAS_SUBSECTION {order: 0}]->(sec_2887);
CREATE (para_2888:Paragraph {id: '1', content: '(Değişik: RG-16/06/2020-31157/10-a md. Yürürlük: 24/06/2020) Sağlık kurulu raporunda belirtilmek kaydıyla; inme veya geçici iskemik atak öyküsü, ≥ 75 yaş, kalp yetmezliği NYHA Sınıf ≥II, diabetes mellitus veya hipertansiyon durumlarından bir ya da daha fazlasına sahip olan orta-ciddi mitral darlık veya mekanik protez kapağı olmayan nonvalvuler atriyal fibrilasyonlu hastalarda;'});
CREATE (sec_2887)-[:HAS_PARAGRAPH {order: 0}]->(para_2888);
CREATE (item_2889:Item {id: 'a', content: 'En az 2 ay süre ile varfarin kullanılmasından sonra en az birer hafta ara ile yapılan son 5 ölçümün en az üçünde varfarin ile hedeflenen INR değerinin 2-3 arasında tutulamadığı durumlarda varfarin kesilerek dabigatran veya rivaroksaban veya apiksaban (Ek:RG-09/09/2017- 30175/21-c md.Yürürlük: 23/09/2017) veya edoksaban tedavisine geçilebilir.'});
CREATE (para_2888)-[:HAS_ITEM {order: 0}]->(item_2889);
CREATE (item_2890:Item {id: 'b', content: 'Varfarin tedavisi altında iken serebrovasküler olay geçirenlerde doğrudan dabigatran veya rivaroksaban veya apiksaban (Ek:RG-09/09/2017- 30175/21-c md.Yürürlük: 23/09/2017) veya edoksaban tedavisine geçilebilir. (Ek: RG- 30/08/2014- 29104/ 15-c md. Yürürlük: 06/09/2014)'});
CREATE (para_2888)-[:HAS_ITEM {order: 1}]->(item_2890);
CREATE (item_2889)-[:NEXT_ITEM]->(item_2890);
CREATE (para_2891:Paragraph {id: '2', content: 'Yukarıda tanımlanan durumların belirtildiği; (Mülga:RG-16/06/2020-31157/10-b md. Yürürlük: 24/06/2020) en az birinin kardiyoloji (Ek: RG-16/06/2020-31157/10-b md. Yürürlük: 24/06/2020) veya nöroloji uzman hekimi olması koşuluyla, kardiyoloji, iç hastalıkları, göğüs hastalıkları, kalp damar cerrahisi ve nöroloji uzman hekimlerinden en az üçünün bulunduğu 6 ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimlerince reçete edilmesi halinde bedeli ödenir.'});
CREATE (sec_2887)-[:HAS_PARAGRAPH {order: 1}]->(para_2891);
CREATE (para_2888)-[:NEXT_PARAGRAPH]->(para_2891);
CREATE (para_2892:Paragraph {id: '4', content: 'Dabigatran, rivaroksaban, edoksaban ve apiksaban etken maddeli ilaçların kombine olarak kullanılması halinde bedelleri Kurumca karşılanmaz. (Değişik: RG- 30/08/2014- 29104/ 15-ç md. Yürürlük: 06/09/2014) -'});
CREATE (sec_2887)-[:HAS_PARAGRAPH {order: 2}]->(para_2892);
CREATE (para_2891)-[:NEXT_PARAGRAPH]->(para_2892);
CREATE (amend_2893:Amendment {content: '(Mülga: RG- 18/06/2016- 29746/ 15 md. Yürürlük: 25/06/2016)'});
CREATE (sec_2887)-[:HAS_AMENDMENT {order: 0}]->(amend_2893);
CREATE (amend_2894:Amendment {content: '(Ek: RG- 04/09/2019- 30878/ 24 md. Yürürlük: 12/09/2019)'});
CREATE (sec_2887)-[:HAS_AMENDMENT {order: 1}]->(amend_2894);
CREATE (amend_2895:Amendment {content: '(Değişik: RG- 18/06/2016- 29746/ 16 md. Yürürlük: 25/06/2016)'});
CREATE (sec_2887)-[:HAS_AMENDMENT {order: 2}]->(amend_2895);
CREATE (sec_2896:Subsection {id: '4.2.15.D-2', title: 'Rivaroksaban, Dabigatran, Apiksaban (Ek:RG-10/05/2018-30417/ 14-a md. Yürürlük:18/05/2018)', content: 've Edoksaban;'});
CREATE (sec_2886)-[:HAS_SUBSECTION {order: 1}]->(sec_2896);
CREATE (para_2897:Paragraph {id: '1', content: 'Yetişkin hastalarda;'});
CREATE (sec_2896)-[:HAS_PARAGRAPH {order: 0}]->(para_2897);
CREATE (item_2898:Item {id: 'a', content: 'Rivaroksaban, dabigatran (Ek:RG-10/05/2018-30417/ 14-b md. Yürürlük:18/05/2018), edoksaban ve apiksaban; Derin Ven Trombozu (DVT) tedavisi ile akut DVT sonrası tekrarlayan DVT ve Pulmoner Embolizmin (PE) önlenmesinde veya Pulmoner Embolizm (PE) tedavisi ile tekrarlayan PE ve DVT’nin önlenmesinde kullanılır.'});
CREATE (para_2897)-[:HAS_ITEM {order: 0}]->(item_2898);
CREATE (item_2899:Item {id: 'b', content: 'Yukarıdaki durumlarda; öncesinde en az 2 ay süre ile varfarin kullanılmasından sonra en az birer hafta ara ile yapılan son 5 ölçümün en az üçünde varfarin ile hedeflenen INR değerinin 2-3 arasında tutulamaması halinde varfarin kesilerek rivaroksaban veya dabigatran veya apiksaban (EK:RG-10/05/2018-30417/14-b md.Yürürlük:18/05/2018) veya edoksaban tedavisine geçilebilir.'});
CREATE (para_2897)-[:HAS_ITEM {order: 1}]->(item_2899);
CREATE (item_2898)-[:NEXT_ITEM]->(item_2899);
CREATE (para_2900:Paragraph {id: '2', content: 'Tekrarlayan idiopatik pulmoner embolisi olan veya homozigot trombofilisi olan veya daha önce venöz tromboemboli (VTE) geçiren aktif kanser hastaları veya immobil (raporda nedeni belirtilmek koşuluyla) hastalarda varfarin kullanımı koşulu aranmaz.'});
CREATE (sec_2896)-[:HAS_PARAGRAPH {order: 1}]->(para_2900);
CREATE (para_2897)-[:NEXT_PARAGRAPH]->(para_2900);
CREATE (para_2901:Paragraph {id: '3', content: 'Yukarıda tanımlanan durumların belirtildiği kardiyoloji, iç hastalıkları, göğüs hastalıkları, kalp damar cerrahisi uzman hekimlerinden (Değişik:RG-10/05/2018-30417/14-c md. Yürürlük:18/05/2018) ; aynı uzmanlık dalından üçünün veya bu uzmanlık dallarından herhangi üçünün bulunduğu 6 ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimlerince reçete edilmesi halinde bedeli ödenir.'});
CREATE (sec_2896)-[:HAS_PARAGRAPH {order: 2}]->(para_2901);
CREATE (para_2900)-[:NEXT_PARAGRAPH]->(para_2901);
CREATE (para_2902:Paragraph {id: '4', content: 'Rapor süresinin bitiminde ilaç tedavisinin devamına karar verilmesi halinde, bu durumun belirtildiği yeni sağlık kurulu raporu düzenlenerek tedaviye devam edilebilir. (Ek: RG- 25/07/2014- 29071/ 28-e md. Yürürlük: 07/08/2014)'});
CREATE (sec_2896)-[:HAS_PARAGRAPH {order: 3}]->(para_2902);
CREATE (para_2901)-[:NEXT_PARAGRAPH]->(para_2902);
CREATE (amend_2903:Amendment {content: '(Değişik: RG- 07/10/2016- 29850/ 27 md. Yürürlük: 15/10/2016)'});
CREATE (sec_2896)-[:HAS_AMENDMENT {order: 0}]->(amend_2903);
CREATE (sec_2887)-[:NEXT_SUBSECTION]->(sec_2896);
CREATE (sec_2880)-[:NEXT_SUBSECTION]->(sec_2886);
CREATE (sec_2904:Subsection {id: '4.2.15.E', title: 'Tikagrelor;'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 5}]->(sec_2904);
CREATE (para_2905:Paragraph {id: '1', content: 'Akut koroner sendromlu hastalardan ST yükselmesiz miyokard enfarktüsü [NSTEMI] veya ST yükselmeli miyokard enfarktüsü [STEMI]) olan (Mülga:RG-25/08/2022-31934/28-b md. Yürürlük:03/09/2022) hastalarda;'});
CREATE (sec_2904)-[:HAS_PARAGRAPH {order: 0}]->(para_2905);
CREATE (para_2906:Paragraph {id: '2', content: 'Tikagrelor başlanmadan önceki 72 saat içinde (Mülga:RG-25/08/2022-31934/ 28-b md. Yürürlük:03/09/2022) fibrinolitik tedavi uygulanmamış olması,'});
CREATE (sec_2904)-[:HAS_PARAGRAPH {order: 1}]->(para_2906);
CREATE (para_2905)-[:NEXT_PARAGRAPH]->(para_2906);
CREATE (para_2907:Paragraph {id: '3', content: 'Hastanın varfarin tedavisi altında olmaması,'});
CREATE (sec_2904)-[:HAS_PARAGRAPH {order: 2}]->(para_2907);
CREATE (para_2906)-[:NEXT_PARAGRAPH]->(para_2907);
CREATE (para_2908:Paragraph {id: '4', content: 'Aşağıdaki durumlardan birinin mevcut olması;'});
CREATE (sec_2904)-[:HAS_PARAGRAPH {order: 3}]->(para_2908);
CREATE (item_2909:Item {id: 'a', content: 'EKG\'de en az iki ardışık derivasyonda 1mm ve üzeri persistan ST segment yükselme göstermesi ve troponin/CK- MB pozitif olması (STEMI) veya,'});
CREATE (para_2908)-[:HAS_ITEM {order: 0}]->(item_2909);
CREATE (item_2910:Item {id: 'b', content: 'Persistan göğüs ağrısı bulunması ve EKG\'de en az iki ardışık derivasyonda 1mm den derin ST depresyonu veya R dalgasının dominant olduğu en az iki ardışık derivasyonda 1mm den derin T negatifliği veya persistan olmayan ST segment yükselmesi göstermesi ve miyokard nekrozunu gösteren troponin/CK-MB pozitif olması (NSTEMI),'});
CREATE (para_2908)-[:HAS_ITEM {order: 1}]->(item_2910);
CREATE (item_2909)-[:NEXT_ITEM]->(item_2910);
CREATE (para_2907)-[:NEXT_PARAGRAPH]->(para_2908);
CREATE (para_2911:Paragraph {id: '5', content: 'Yukarıdaki maddelerde tanımlanan koşulların tamamını gösteren hastalarda (Ek: RG-25/08/2022-31934/28-b md. Yürürlük:03/09/2022) rapor aranmaksızın 4 haftalık doz kardiyoloji veya kalp damar cerrahi uzman hekimlerince veya bu durumların belirtildiği kardiyoloji veya kalp damar cerrahisi uzman hekimlerinden birinin bulunduğu 1 yıl süreli sağlık kurulu raporuna dayanılarak (Değişik: RG- 05/08/2015- 29436/ 16-b md. Yürürlük: 13/08/2015) kardiyoloji, kalp damar cerrahisi veya iç hastalıkları uzman hekimleri tarafından reçetelenir. Tedavi süresi 1 yıldır (13 kutu). İlacın hastaya tekrar kullanımı ancak hastada aynı koşulların yeniden oluşması halinde mümkündür.'});
CREATE (sec_2904)-[:HAS_PARAGRAPH {order: 4}]->(para_2911);
CREATE (para_2908)-[:NEXT_PARAGRAPH]->(para_2911);
CREATE (sec_2886)-[:NEXT_SUBSECTION]->(sec_2904);
CREATE (sec_2912:Subsection {id: '4.2.15.F', title: 'Ranolazin; Kronik stabil angina pektorisli hastaların semptomatik tedavisinde beta blokör ve/veya', content: 'verapamil-diltiazem tedavisine rağmen anjinası devam eden veya bu ilaçlara intoleransı ve/veya kontrendikasyonu olan hastalarda, kardiyoloji uzmanlarınca düzenlenen  2 yıl süreli uzman hekim raporuna istinaden kardiyoloji uzmanı veya iç hastalıkları uzmanı tarafından reçete edilebilir. 119 (Mülga: RG- 25/08/2022- 31934/ 28-c md. Yürürlük: 03/09/2022)'});
CREATE (sec_2860)-[:HAS_SUBSECTION {order: 6}]->(sec_2912);
CREATE (amend_2913:Amendment {content: '(Değişik: RG-02/11/2024-32710/16 md. Yürürlük:09/11/2024)'});
CREATE (sec_2912)-[:HAS_AMENDMENT {order: 0}]->(amend_2913);
CREATE (amend_2914:Amendment {content: '(Değişik: RG-02/11/2024- 32710/17 md. Yürürlük: 09/11/2024)'});
CREATE (sec_2912)-[:HAS_AMENDMENT {order: 1}]->(amend_2914);
CREATE (sec_2904)-[:NEXT_SUBSECTION]->(sec_2912);
CREATE (sec_2472)-[:NEXT_SUBSECTION]->(sec_2860);
CREATE (sec_2915:Subsection {id: '4.2.16', title: 'Doğuştan metabolik hastalıklar, Gıda allerjileri ile Çölyak Hastalığı'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 15}]->(sec_2915);
CREATE (para_2916:Paragraph {id: '1', content: 'Çocuk mamaları, gıda olması nedeniyle EK-4/A Listesine ve Kurumun resmi internet sitesinde yayımlanan “Hastalığa Özel (Doğuştan Metabolik Hastalıklar, Kistik Fibrozis ve İnek Sütü Alerjisi) Diyet Ürünleri ile Tıbbi Mamalar Listesi” ne (EK-4/B) dahil edilmemiştir.'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 0}]->(para_2916);
CREATE (para_2917:Paragraph {id: '2', content: 'Doğuştan metabolik hastalığı olanlarda, protein metabolizması bozukluklarında (aminoasit metabolizması bozuklukları, üre siklus bozuklukları, organik asidemiler), malabsorbsiyona neden olan bir hastalığı olan hastalarda kullanılan özel mamalar:'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 1}]->(para_2917);
CREATE (item_2918:Item {id: 'a', content: 'Çocuk metabolizma hastalıkları, çocuk endokrinolojisi ve metabolizma hastalıkları veya çocuk gastroenteroloji uzman hekimi tarafından, bu uzman hekimlerin bulunmadığı hastanelerde çocuk sağlığı ve hastalıkları uzman hekimlerince düzenlenen 3 yıl süreli uzman hekim raporuna dayanılarak, tüm hekimler tarafından reçete edilebilir.'});
CREATE (para_2917)-[:HAS_ITEM {order: 0}]->(item_2918);
CREATE (item_2919:Item {id: 'b', content: 'Erişkin endokrinoloji ve metabolizma hastalıkları ya da erişkin gastroenteroloji uzman hekimi tarafından, bu uzman hekimlerin bulunmadığı hastanelerde iç hastalıkları uzman hekimlerince düzenlenen 3 yıl süreli uzman hekim raporuna dayanılarak, tüm hekimler tarafından reçete edilebilir.'});
CREATE (para_2917)-[:HAS_ITEM {order: 1}]->(item_2919);
CREATE (item_2918)-[:NEXT_ITEM]->(item_2919);
CREATE (item_2920:Item {id: 'c', content: 'Glikojen depo hastalığının diyet yönetiminde kullanılan yüksek amilopektin içeren nişastalı ürünler; 2 yaş ve üzerindeki hastalarda, bu durumun belirtildiği en az bir çocuk metabolizma hastalıkları veya gastroenteroloji uzmanının bulunduğu sağlık kurulu raporuna dayanılarak çocuk metabolizma hastalıkları ile çocuk sağlığı ve hastalıkları veya gastroenteroloji uzman hekimlerince reçete edilebilir. Raporda, ürünün adı, günlük kullanım miktarı açıkça belirtilerek aylık en fazla dört kutu yazılır.'});
CREATE (para_2917)-[:HAS_ITEM {order: 2}]->(item_2920);

// Batch 79
CREATE (item_2919)-[:NEXT_ITEM]->(item_2920);
CREATE (para_2916)-[:NEXT_PARAGRAPH]->(para_2917);
CREATE (para_2921:Paragraph {id: '3', content: 'Protein metabolizması bozukluklarında (aminoasit metabolizması bozuklukları, üre siklus bozuklukları, organik asidemiler) yukarıda belirtilen uzman hekim raporuna dayanılarak hastaların kısıtlı diyetleri sebebi ile hayati önemi haiz özel formüllü un ve özel formül içeren mamul ürünler (makarna, şehriye, bisküvi, çikolata, gofret vb.) için bir aylık;'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 2}]->(para_2921);
CREATE (item_2922:Item {id: 'a', content: '0-12 ay için 203,42 (iki yüz üç virgül kırk iki) TL,'});
CREATE (para_2921)-[:HAS_ITEM {order: 0}]->(item_2922);
CREATE (item_2923:Item {id: 'b', content: '1-5 yaş için 393,73 (üç yüz doksan üç virgül yetmiş üç) TL,'});
CREATE (para_2921)-[:HAS_ITEM {order: 1}]->(item_2923);
CREATE (item_2922)-[:NEXT_ITEM]->(item_2923);
CREATE (item_2924:Item {id: 'c', content: '5-15 yaş için 508,56 (beş yüz sekiz virgül elli altı) TL,'});
CREATE (para_2921)-[:HAS_ITEM {order: 2}]->(item_2924);
CREATE (item_2923)-[:NEXT_ITEM]->(item_2924);
CREATE (item_2925:Item {id: 'ç', content: '15 yaş üstü için 525 (beş yüz yirmi beş) TL, tutar ödenir.'});
CREATE (para_2921)-[:HAS_ITEM {order: 3}]->(item_2925);
CREATE (item_2924)-[:NEXT_ITEM]->(item_2925);
CREATE (para_2917)-[:NEXT_PARAGRAPH]->(para_2921);
CREATE (para_2926:Paragraph {id: '4', content: 'Kistik fibrozisli hastalarda kullanılan özel mamalar; gastroenteroloji veya göğüs hastalıkları uzman hekimleri tarafından bu uzman hekimlerin bulunmadığı hastanelerde çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimlerince düzenlenen 1 yıl süreli uzman hekim raporuna dayanılarak tüm hekimler tarafından reçete edilebilir.'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 3}]->(para_2926);
CREATE (para_2921)-[:NEXT_PARAGRAPH]->(para_2926);
CREATE (para_2927:Paragraph {id: '5', content: 'İki yaşına kadar inek sütü ve/veya çoklu gıda protein alerjisi olan bebeklerde kullanılan tıbbi mamalar, çocuk gastroenteroloji veya çocuk immünoloji ve alerji hastalıkları uzman hekimlerince, bu uzman hekimlerin bulunmadığı hastanelerde çocuk sağlığı ve hastalıkları uzman hekimlerince düzenlenecek uzman hekim raporuna dayanılarak tüm hekimler tarafından reçete edilmesi halinde bedeli Kurumca karşılanır.'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 4}]->(para_2927);
CREATE (para_2926)-[:NEXT_PARAGRAPH]->(para_2927);
CREATE (para_2928:Paragraph {id: '6', content: 'Çölyak hastalığında; gastroenteroloji uzman hekimi tarafından, bu uzman hekimlerin bulunmadığı hastanelerde çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimlerince 3 yıl süreli rapor düzenlenir. Bu hastaların kısıtlı diyetleri sebebi ile hayati önemi haiz özel formüllü un ve özel formüllü un içeren mamul ürünler (makarna, şehriye, bisküvi, çikolata, gofret vb.); gastroenteroloji uzman hekimi tarafından düzenlenen uzman hekim raporuna dayanılarak bir aylık;'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 5}]->(para_2928);
CREATE (item_2929:Item {id: 'a', content: '0-5 yaş için 344,48 (üç yüz kırk dört virgül kırk sekiz) TL,'});
CREATE (para_2928)-[:HAS_ITEM {order: 0}]->(item_2929);
CREATE (item_2930:Item {id: 'b', content: '5-15 yaş için 525 (beş yüz yirmi beş) TL,'});
CREATE (para_2928)-[:HAS_ITEM {order: 1}]->(item_2930);
CREATE (item_2929)-[:NEXT_ITEM]->(item_2930);
CREATE (item_2931:Item {id: 'c', content: '15 yaş üstü için 475,74 (dört yüz yetmiş beş virgül yetmiş dört) TL, tutar ödenir.'});
CREATE (para_2928)-[:HAS_ITEM {order: 2}]->(item_2931);
CREATE (item_2930)-[:NEXT_ITEM]->(item_2931);
CREATE (para_2927)-[:NEXT_PARAGRAPH]->(para_2928);
CREATE (para_2932:Paragraph {id: '7', content: 'Kronik böbrek hastalığı (evre 2-5) tanısı olan 3 yaş ve üzeri ve boy SDS ve/veya kilo SDS –1 ve altında olan çocuklarda; bu durumun belirtildiği 6 ay süreli pediyatrik nefroloji uzman hekim raporuna istinaden pediyatrik nefroloji uzman hekimi tarafından günlük en fazla 3 şişe reçete edilmesi halinde bedeli Kurumca karşılanır. Tedavinin takibinde boy SDS değeri sıfıra yükselip altı ay süre bu düzeyde seyretmesi halinde tedavi kesilir.'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 6}]->(para_2932);
CREATE (para_2928)-[:NEXT_PARAGRAPH]->(para_2932);
CREATE (para_2933:Paragraph {id: '8', content: 'Yukarıda belirtilen hastalıklarda kullanılan ürünler; EK-4/B Listesinde belirtilmiş olup bu listede yer almayan ürün bedelleri Kurumca karşılanmaz.'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 7}]->(para_2933);
CREATE (para_2932)-[:NEXT_PARAGRAPH]->(para_2933);
CREATE (para_2934:Paragraph {id: '9', content: 'Üçüncü ve altıncı fıkralarda belirtilen ödemeye ilişkin izlenecek yöntem Kurum tarafından ayrıca duyurulur.'});
CREATE (sec_2915)-[:HAS_PARAGRAPH {order: 8}]->(para_2934);
CREATE (para_2933)-[:NEXT_PARAGRAPH]->(para_2934);
CREATE (sec_2860)-[:NEXT_SUBSECTION]->(sec_2915);
CREATE (sec_2935:Subsection {id: '4.2.17', title: 'Osteoporoz, Sudek Atrofisi (Algonörodistrofi) ve Paget Hastalığında ilaç kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 16}]->(sec_2935);
CREATE (sec_2936:Subsection {id: '4.2.17.A', title: 'Osteoporoz'});
CREATE (sec_2935)-[:HAS_SUBSECTION {order: 0}]->(sec_2936);
CREATE (para_2937:Paragraph {id: '1', content: 'Osteoporoz tedavisinde bifosfonatlar (kombinasyonları dahil) ve diğer osteoporoz ilaçları (raloksifen, calcitonin, stronsiyum ranelat (kombinasyonları dahil), denosumab) aşağıda belirtilen koşullar çerçevesinde ödenir. Bu ilaçlar tedavi süresinin belirtildiği sağlık raporuna dayanılarak reçete edilirler. Rapor süresi (Değişik: RG-21/03/2018-30367/ 25-a md. Yürürlük: 01/04/2018) 2 yıldır. Bu grup ilaçların birlikte kombine kullanımı halinde sadece birinin bedeli ödenir.'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 0}]->(para_2937);
CREATE (para_2938:Paragraph {id: '2', content: 'Osteoporozda ilaç tedavisi, düzenlenecek rapor tarihinden önce son (Değişik: RG-21/03/2018-30367/25-b md. Yürürlük:01/04/2018) iki yıl içinde yapılan Kemik Mineral Yoğunluk (KMY) ölçümüyle planlanır. Ölçüm yılda bir defadan daha sık yapılamaz. KMY ölçümünün tarihi ve sonucu reçete veya raporda belirtilir. KMY ölçümü bir kalçasında protez olan hastada diğer kalçadan, her iki kalçasında da protez olan hastada vertebra ya da ön koldan yapılabilir.'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 1}]->(para_2938);
CREATE (para_2937)-[:NEXT_PARAGRAPH]->(para_2938);
CREATE (para_2939:Paragraph {id: '3', content: '75 yaş ve üzerindeki hastalar ile raporunda osteoporotik patolojik kalça kırığı belirtilen hastalarda KMY ölçümü şartı aranmaz.'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 2}]->(para_2939);
CREATE (para_2938)-[:NEXT_PARAGRAPH]->(para_2939);
CREATE (para_2940:Paragraph {id: '4', content: 'Bu ilaçlar;'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 3}]->(para_2940);
CREATE (item_2941:Item {id: 'a', content: 'Patolojik kırığı olan hastalarda lomber bölgeden posteroanterior yapılan KMY ölçümünde lomber total (L1-4 veya L2-4) veya femur total veya femur boynu KMY ölçümünde “T” değerlerinden herhangi birinin -1 veya daha düşük olması durumunda, 120'});
CREATE (para_2940)-[:HAS_ITEM {order: 0}]->(item_2941);
CREATE (item_2942:Item {id: 'b', content: 'Patolojik kırığı olmayan 65 yaş ve üzeri hastalarda, lomber bölgeden posteroanterior yapılan KMY ölçümünde lomber total (L1-4 veya L2-4) veya femur total veya femur boynu KMY ölçümünde “T” değerlerinden herhangi birinin -2,5 veya daha düşük olması durumunda,'});
CREATE (para_2940)-[:HAS_ITEM {order: 1}]->(item_2942);
CREATE (item_2941)-[:NEXT_ITEM]->(item_2942);
CREATE (item_2943:Item {id: 'c', content: 'Patolojik kırığı olmayan 65 yaş altı hastalarda; lomber bölgeden posteroanterior yapılan kemik mineral yoğunluk (KMY) ölçümünde lomber total (L1-4 veya L2-4) veya femur total veya femur boynu KMY ölçümünde “T” değerlerinden herhangi birinin -3 veya daha düşük olması durumunda,'});
CREATE (para_2940)-[:HAS_ITEM {order: 2}]->(item_2943);
CREATE (item_2942)-[:NEXT_ITEM]->(item_2943);
CREATE (item_2944:Item {id: 'ç', content: 'Romatoid artrit, çölyak hastalığı, kronik inflamatuar barsak hastalığı (crohn hastalığı veya ülseratif kolit), ankilozan spondilit, hipertiroidi, hipogonadizm, hipopituitarizm, anoreksia nevroza, kronik obstrüktif akciğer hastalığı, tip I diyabet, cushing sendromu ve primer hiperparatiroidizmde, uzun süreli (en az 3 ay) ve > 5mg/gün sistemik kortikosteroid kullanımı olan, kanser tedavisi alan veya organ nakli uygulanmış hastalarda; sekonder gelişen osteoporozda KMY ölçümünde lomber total (L1-4 veya L2-4) veya femur total veya femur boynu KMY ölçümünde “T” değerlerinden herhangi birinin -1 veya daha düşük olması durumunda, (primer hastalığını da belirtir sağlık raporu ile birlikte) reçetelenir.'});
CREATE (para_2940)-[:HAS_ITEM {order: 3}]->(item_2944);
CREATE (item_2943)-[:NEXT_ITEM]->(item_2944);
CREATE (item_2945:Item {id: 'd', content: 'Bifosfanatların, kalça çıkığı veya bel kemiği zedelenmesine bağlı heterotopik ossifikasyon (HO) endikasyonu olan formları, bu endikasyonda prospektüsünde belirtilen dozlar ve sürelerde KMY ölçüm sonucu aranmaksızın kullanılabilir.'});
CREATE (para_2940)-[:HAS_ITEM {order: 4}]->(item_2945);
CREATE (item_2944)-[:NEXT_ITEM]->(item_2945);
CREATE (para_2939)-[:NEXT_PARAGRAPH]->(para_2940);
CREATE (para_2946:Paragraph {id: '5', content: 'Bifosfanat grubu ilaçlar; iç hastalıkları, fiziksel tıp ve rehabilitasyon, ortopedi ve travmatoloji, romatoloji, tıbbi ekoloji ve hidroklimatoloji, kadın hastalıkları ve doğum, endokrinoloji uzmanları tarafından düzenlenen uzman hekim raporu ile tüm uzman hekimlerce reçete edilebilir.'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 4}]->(para_2946);
CREATE (para_2940)-[:NEXT_PARAGRAPH]->(para_2946);
CREATE (para_2947:Paragraph {id: '6', content: 'Stronsiyum ranelat (kombinasyonları dahil), raloksifen ve denosumab;'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 5}]->(para_2947);
CREATE (item_2948:Item {id: 'a', content: 'Stronsiyum ranelat (kombinasyonları dahil), raloksifen  ; yalnızca bifosfonatları tolere edemeyen veya yeterli yanıt alınamayan osteoporozlu hastalarda bu durumun, iç hastalıkları, fiziksel tıp ve rehabilitasyon, romatoloji, ortopedi ve travmatoloji, kadın hastalıkları ve doğum , endokrinoloji ve metabolizma hastalıkları uzmanlarından en az birinin yer aldığı sağlık kurulu raporunda belirtilmesi halinde, bu rapora dayanılarak tüm uzman hekimlerce reçete edilebilir.'});
CREATE (para_2947)-[:HAS_ITEM {order: 0}]->(item_2948);
CREATE (item_2949:Item {id: 'b', content: 'Denosumab; aromataz inhibitörü tedavisi gören yüksek kırık riskine sahip hastalardaki osteoporoz tedavisinde; bu durumun belirtildiği, en az bir tıbbi onkoloji uzman hekiminin yer aldığı sağlık kurulu raporuna dayanılarak tüm uzman hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır. 24/03/2023) veya renal yetmezlik nedeniyle bifosfonatları kullanamayan osteoporozlu hastalardan;'});
CREATE (para_2947)-[:HAS_ITEM {order: 1}]->(item_2949);
CREATE (subitem_2950:SubItem {id: '1', content: 'Hormon ablasyonu uygulanmış olan nonmetastatik prostat kanserli veya meme kanseri nedeniyle adjuvan'});
CREATE (item_2949)-[:HAS_SUBITEM {order: 0}]->(subitem_2950);
CREATE (subitem_2951:SubItem {id: '2', content: 'Bifosfonatları tolere edemeyen veya yeterli yanıt alınamayan (Ek:RG-16/03/2023-32134/27-a md.Yürürlük:'});
CREATE (item_2949)-[:HAS_SUBITEM {order: 1}]->(subitem_2951);
CREATE (subitem_2950)-[:NEXT_SUBITEM]->(subitem_2951);
CREATE (item_2948)-[:NEXT_ITEM]->(item_2949);
CREATE (item_2952:Item {id: 'a', content: 'Postmenopozal osteoporozu bulunan kadın veya osteoporozu bulunan erkek hastaların tedavisinde veya'});
CREATE (para_2947)-[:HAS_ITEM {order: 2}]->(item_2952);
CREATE (item_2949)-[:NEXT_ITEM]->(item_2952);
CREATE (item_2953:Item {id: 'b', content: 'Yüksek kırık riski olan yetişkin hastalarda uzun dönem glukokortikoid tedavisiyle ilişkili kemik kaybının tedavisinde iç hastalıkları, fiziksel tıp ve rehabilitasyon, romatoloji, ortopedi ve travmatoloji, kadın hastalıkları ve doğum veya endokrinoloji ve metabolizma hastalıkları uzman hekimlerinden en az birinin yer aldığı ve bu durumların belirtildiği sağlık kurulu raporuna istinaden tüm uzman hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (para_2947)-[:HAS_ITEM {order: 3}]->(item_2953);
CREATE (item_2952)-[:NEXT_ITEM]->(item_2953);
CREATE (para_2946)-[:NEXT_PARAGRAPH]->(para_2947);
CREATE (para_2954:Paragraph {id: '7', content: 'Kalsitonin, ağrılı vertebral kırığı bulunan osteoporozlu hastalarda bu durumun, iç hastalıkları, fiziksel tıp ve rehabilitasyon, romatoloji, ortopedi ve travmatoloji, kadın hastalıkları ve doğum, endokrinoloji uzmanlarından en az birinin yer aldığı sağlık kurulu raporunda belirtilmesi halinde her ağrılı vertebral kırık durumunda en fazla 3 aylık tedavi dozu verilmesi koşulu ile bu uzman hekimlerce reçete edilebilir.'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 6}]->(para_2954);
CREATE (para_2947)-[:NEXT_PARAGRAPH]->(para_2954);
CREATE (para_2955:Paragraph {id: '8', content: 'Kalsitonin, yalnızca üniversite veya eğitim ve araştırma hastanelerinde; ağrılı vertebral kırığı bulunmayan osteoporozlu ve bifosfonatları tolere edemeyen veya yeterli yanıt alınamayan hastalarda, bu durumun iç hastalıkları, fiziksel tıp ve rehabilitasyon, ortopedi ve travmatoloji, romatoloji, kadın hastalıkları ve doğum, endokrinoloji uzmanlarından en az birinin yer aldığı sağlık kurulu raporunda belirtilmesi halinde, bu uzmanlarca reçete edilerek kullanılabilir.'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 7}]->(para_2955);
CREATE (para_2954)-[:NEXT_PARAGRAPH]->(para_2955);

// Batch 80
CREATE (para_2956:Paragraph {id: '9', content: 'Aktif D vitaminleri (kalsitriol ve alfakalsidol) osteoporoz tedavisinde ödenmez. (EK-4/D Listesindeki düzenlemeler hariç)'});
CREATE (sec_2936)-[:HAS_PARAGRAPH {order: 8}]->(para_2956);
CREATE (para_2955)-[:NEXT_PARAGRAPH]->(para_2956);
CREATE (amend_2957:Amendment {content: '(Değişik: RG- 21/04/2015- 29333/ 11 md. Yürürlük: 30/04/2015)'});
CREATE (sec_2936)-[:HAS_AMENDMENT {order: 0}]->(amend_2957);
CREATE (amend_2958:Amendment {content: '(Değişik: RG- 05/08/2015- 29436/ 17 md. Yürürlük: 13/08/2015)'});
CREATE (sec_2936)-[:HAS_AMENDMENT {order: 1}]->(amend_2958);
CREATE (amend_2959:Amendment {content: '(Mülga: RG- 30/12/2020-31350/ 5 md. Yürürlük: \n08/01/2021)'});
CREATE (sec_2936)-[:HAS_AMENDMENT {order: 2}]->(amend_2959);
CREATE (amend_2960:Amendment {content: '(Ek: RG- \n04/09/2019- 30878/ 25 md. Yürürlük: 12/09/2019)'});
CREATE (sec_2936)-[:HAS_AMENDMENT {order: 3}]->(amend_2960);
CREATE (amend_2961:Amendment {content: '(Değişik: RG- 30/12/2020- 31350/ 5 md. Yürürlük: 08/01/2021)'});
CREATE (sec_2936)-[:HAS_AMENDMENT {order: 4}]->(amend_2961);
CREATE (sec_2962:Subsection {id: '4.2.17.B', title: 'Sudek Atrofisi (Algonörodistrofi)'});
CREATE (sec_2935)-[:HAS_SUBSECTION {order: 1}]->(sec_2962);
CREATE (para_2963:Paragraph {id: '1', content: 'Kalsitonin bu endikasyonda tanı konulduktan sonraki ilk altı ay süresince fiziksel tıp ve rehabilitasyon veya ortopedi ve travmatoloji veya romatoloji uzman hekim raporuna dayanılarak bu uzman hekimlerce reçete edilir. Bu sürenin üstündeki kullanımı ödenmez.'});
CREATE (sec_2962)-[:HAS_PARAGRAPH {order: 0}]->(para_2963);
CREATE (sec_2936)-[:NEXT_SUBSECTION]->(sec_2962);
CREATE (sec_2964:Subsection {id: '4.2.17.C', title: 'Juvenil Osteoporoz'});
CREATE (sec_2935)-[:HAS_SUBSECTION {order: 2}]->(sec_2964);
CREATE (para_2965:Paragraph {id: '1', content: 'Uzman hekim raporuna dayanılarak uzman hekimlerce reçete edilir. Rapor süresi 1 yıldır.'});
CREATE (sec_2964)-[:HAS_PARAGRAPH {order: 0}]->(para_2965);
CREATE (sec_2962)-[:NEXT_SUBSECTION]->(sec_2964);
CREATE (sec_2966:Subsection {id: '4.2.17.Ç', title: 'Paget Hastalığı'});
CREATE (sec_2935)-[:HAS_SUBSECTION {order: 3}]->(sec_2966);
CREATE (para_2967:Paragraph {id: '1', content: 'Endokrinoloji uzman hekimi tarafından düzenlenen uzman hekim raporuna istinaden tüm uzman hekimlerce reçete edilir. Rapor süresi 1 yıldır. (Değişik: RG- 16/03/2023-32134/27-b md. Yürürlük: 24/03/2023)'});
CREATE (sec_2966)-[:HAS_PARAGRAPH {order: 0}]->(para_2967);
CREATE (sec_2964)-[:NEXT_SUBSECTION]->(sec_2966);
CREATE (sec_2968:Subsection {id: '4.2.17.D', title: 'Osteoporozda teriparatid ve romosozumab kullanımı'});
CREATE (sec_2935)-[:HAS_SUBSECTION {order: 4}]->(sec_2968);
CREATE (para_2969:Paragraph {id: '1', content: '65 yaş üstü hastalardan; T skoru -3,5 ve daha az olan (L1-L4 veya kalça total) ve 2 veya daha fazla kırığı olduğu röntgenle kesin tanı konulmuş osteoporozlu hastalarda, bu durumların belirtildiği 24 hafta süreli endokrinoloji veya fizik tedavi ve rehabilitasyon ve/veya geriatri uzmanının bulunduğu sağlık kurulu raporuna dayanılarak uzman hekimler tarafından reçete edilmesi halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_2968)-[:HAS_PARAGRAPH {order: 0}]->(para_2969);
CREATE (para_2970:Paragraph {id: '2', content: '24 hafta sonunda yanıt değerlendirmesi yapılır. Tedaviye yanıt veren hastalarda bu durumun kanıtlandığı raporla teriparatid için 52 hafta, romosozumab için 6 ay süreli yeni bir sağlık kurulu raporu düzenlenmesi halinde tedaviye devam edilebilir. Teriparatid ile toplam tedavi süresi ömür boyu 76 haftayı, romosozumab ile 12 ayı geçmeyecektir.'});
CREATE (sec_2968)-[:HAS_PARAGRAPH {order: 1}]->(para_2970);
CREATE (para_2969)-[:NEXT_PARAGRAPH]->(para_2970);
CREATE (para_2971:Paragraph {id: '3', content: 'Teriparatid veya romosozumab kullanan hastalarda KMY ölçümü yılda 2 kez yapılabilir. 121'});
CREATE (sec_2968)-[:HAS_PARAGRAPH {order: 2}]->(para_2971);
CREATE (para_2970)-[:NEXT_PARAGRAPH]->(para_2971);
CREATE (sec_2966)-[:NEXT_SUBSECTION]->(sec_2968);
CREATE (sec_2915)-[:NEXT_SUBSECTION]->(sec_2935);
CREATE (sec_2972:Subsection {id: '4.2.18', title: 'Orlistat kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 17}]->(sec_2972);
CREATE (para_2973:Paragraph {id: '1', content: '(Değişik: RG- 30/08/2014- 29104/ 16 md. Yürürlük: 06/09/2014 Endokrinoloji ve metabolizma uzman hekimi tarafından düzenlenen en fazla üç ay süreli uzman hekim raporuna dayanılarak tüm hekimler tarafından reçete edilebilir. Yazılan her reçeteye, hastanın bir önceki reçeteye göre kaybettiği kilo, diyet ve egzersize uyduğu, BMI değeri hekim tarafından yazılarak kaşe ve imza onayı yapılacaktır.'});
CREATE (sec_2972)-[:HAS_PARAGRAPH {order: 0}]->(para_2973);
CREATE (para_2974:Paragraph {id: '2', content: 'Daha önce dört ardışık hafta boyunca yalnızca diyetle en az 2,5 kg’lık bir kilo kaybı ve obez hastalarda vücut kitle indeksi (BMI) ≥ 40 kg/m2 olmalıdır.'});
CREATE (sec_2972)-[:HAS_PARAGRAPH {order: 1}]->(para_2974);
CREATE (para_2973)-[:NEXT_PARAGRAPH]->(para_2974);
CREATE (para_2975:Paragraph {id: '3', content: 'Reçeteler birer aylık düzenlenecektir.'});
CREATE (sec_2972)-[:HAS_PARAGRAPH {order: 2}]->(para_2975);
CREATE (para_2974)-[:NEXT_PARAGRAPH]->(para_2975);
CREATE (para_2976:Paragraph {id: '4', content: 'Tedavinin 12 haftası sonunda hastalarda başlangıçtaki vücut ağırlığının en az %5\'ini kaybetmesi halinde tedavinin devamına karar verilirse, yeni bir rapor daha düzenlenerek tedavi üçer aylık sürelerle uzatılabilecektir. 12 hafta sonunda vücut ağırlığının en az %5’inin kaybolmaması halinde tedavi kesilecektir. Bu ilacın kullanımı hastanın hayatı boyunca 2 yılı geçmeyecektir.'});
CREATE (sec_2972)-[:HAS_PARAGRAPH {order: 3}]->(para_2976);
CREATE (para_2975)-[:NEXT_PARAGRAPH]->(para_2976);
CREATE (sec_2935)-[:NEXT_SUBSECTION]->(sec_2972);
CREATE (sec_2977:Subsection {id: '4.2.19', title: 'Migrende ilaç kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 18}]->(sec_2977);
CREATE (para_2978:Paragraph {id: '1', content: 'Triptanlar, nöroloji uzman hekimleri tarafından reçete edilir. Bu grup ilaçlardan yalnız bir etken madde reçete edilebilir ve ayda en fazla 6 doz/adet yazılabilir. Aynı ilacın farklı farmasötik formlarının aynı anda reçete edilmesi halinde birisinin bedeli ödenir.'});
CREATE (sec_2977)-[:HAS_PARAGRAPH {order: 0}]->(para_2978);
CREATE (para_2979:Paragraph {id: '2', content: 'Topiramat tedavisine, diğer profilaktik migren ilaçlarının 6 ay süreyle kullanılıp etkisiz kaldığı durumlarda nöroloji uzman hekimince düzenlenen uzman hekim raporunda bu husus belirtilerek nöroloji uzman hekimince başlanır.'});
CREATE (sec_2977)-[:HAS_PARAGRAPH {order: 1}]->(para_2979);
CREATE (para_2978)-[:NEXT_PARAGRAPH]->(para_2979);
CREATE (para_2980:Paragraph {id: '3', content: 'Uzman hekim raporu 1 yıl süreyle geçerlidir ve nöroloji uzman hekimince düzenlenen uzman hekim raporuna dayanılarak diğer hekimler tarafından en fazla birer aylık dozda reçete edilmesi halinde bedeli ödenir.'});
CREATE (sec_2977)-[:HAS_PARAGRAPH {order: 2}]->(para_2980);
CREATE (para_2979)-[:NEXT_PARAGRAPH]->(para_2980);
CREATE (amend_2981:Amendment {content: '(Değişik: RG-16/06/2020-31157/12 md. Yürürlük: 24/06/2020)'});
CREATE (sec_2977)-[:HAS_AMENDMENT {order: 0}]->(amend_2981);
CREATE (sec_2972)-[:NEXT_SUBSECTION]->(sec_2977);
CREATE (sec_2982:Subsection {id: '4.2.20', title: 'Palivizumab kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 19}]->(sec_2982);
CREATE (para_2983:Paragraph {id: '1', content: 'Palivizumab etken maddeli ilaç; Respiratuar Sinsitiyal Virüs (RSV) sezonu boyunca (Ekim ile Mart ayları arasında) çocuk alerjisi, çocuk immünolojisi ve alerji hastalıkları, çocuk enfeksiyon hastalıkları, çocuk göğüs hastalıkları, çocuk kardiyolojisi veya neonatoloji uzman hekimlerinden biri tarafından düzenlenen 1 yıl süreli uzman hekim raporuna dayanılarak bu uzman hekimler veya çocuk sağlığı ve hastalıkları uzman hekimlerince en fazla 5 doz ve maksimum 2 yaşa kadar reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_2982)-[:HAS_PARAGRAPH {order: 0}]->(para_2983);
CREATE (para_2984:Paragraph {id: '2', content: 'Yüksek risk taşıyan bebeklerde RSV’nin neden olduğu ciddi alt solunum yolu hastalığının önlenmesinde;'});
CREATE (sec_2982)-[:HAS_PARAGRAPH {order: 1}]->(para_2984);
CREATE (item_2985:Item {id: 'a', content: 'RSV sezonunda takvim yaşı 12 aydan küçük olup gebelik yaşı 29 0/7 haftadan küçük veya doğum ağırlığı 1000 g altında olan preterm bebeklerde veya'});
CREATE (para_2984)-[:HAS_ITEM {order: 0}]->(item_2985);
CREATE (item_2986:Item {id: 'b', content: 'RSV sezonunda takvim yaşı 90 gün ve daha küçük gebelik yaşı 29 0/7-31 6/7 hafta arası olan preterm bebeklerde veya'});
CREATE (para_2984)-[:HAS_ITEM {order: 1}]->(item_2986);
CREATE (item_2985)-[:NEXT_ITEM]->(item_2986);
CREATE (item_2987:Item {id: 'c', content: 'RSV sezonu başlangıcından önceki son 6 ay içinde kronik akciğer hastalığı için bronkodilatör, oksijen, diüretik veya kortikosteroid tedavilerinden en az birisini alan 2 yaşından küçük bebeklerde veya'});
CREATE (para_2984)-[:HAS_ITEM {order: 2}]->(item_2987);
CREATE (item_2986)-[:NEXT_ITEM]->(item_2987);
CREATE (item_2988:Item {id: 'ç', content: 'RSV sezonu başlangıcında 2 yaşından küçük; siyanotik doğuştan kalp hastalığı, konjestif kalp yetersizliği tedavisi gerektiren asiyanotik doğuştan kalp hastalığı, opere edildiği halde rezidiv hemodinamik bozukluk nedeniyle konjestif kalp yetersizliği tedavisi almaya devam eden, pulmoner arteriyel hipertansiyon veya hemodinamik bozukluk nedeniyle tedavi alması gereken kardiyomiyopati hastalığı olan bebeklerde kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_2984)-[:HAS_ITEM {order: 3}]->(item_2988);
CREATE (item_2987)-[:NEXT_ITEM]->(item_2988);
CREATE (para_2983)-[:NEXT_PARAGRAPH]->(para_2984);
CREATE (sec_2977)-[:NEXT_SUBSECTION]->(sec_2982);
CREATE (sec_2989:Subsection {id: '4.2.21', title: 'Anagrelid kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 20}]->(sec_2989);
CREATE (para_2990:Paragraph {id: '1', content: 'Hidroksiüre + asetil salisilik asit tedavisine dirençli olduğu ya da hidroksiüre ile dirençli sitopeni (anemi ve/veya lökopeni) geliştiği belgelenen, yüksek vasküler risk taşıyan esansiyel trombositemi hastalıklarında, hematoloji veya tıbbi onkoloji uzman hekimlerinden biri tarafından düzenlenen uzman hekim raporuna dayanılarak bu uzman hekimler tarafından reçete edilebilir.'});
CREATE (sec_2989)-[:HAS_PARAGRAPH {order: 0}]->(para_2990);
CREATE (sec_2982)-[:NEXT_SUBSECTION]->(sec_2989);
CREATE (sec_2991:Subsection {id: '4.2.22', title: 'Aktive protein C kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 21}]->(sec_2991);
CREATE (para_2992:Paragraph {id: '1', content: 'Yoğun bakım ünitelerinde, anestezi ve reanimasyon, enfeksiyon hastalıkları, iç hastalıkları, göğüs hastalıkları, genel cerrahi hekimlerinden en az üçünün onayının bulunduğu, en az iki organ yetmezliği gelişmiş ağır sepsis hastalarının tedavisinde, ilk 48 saat içerisinde, hastalığın teşhisi, günlük kullanım dozu ve süresini (24 μg/kg/saat IV x 96 saat) belirten onaylı epikriz raporuna dayanılarak reçete edilmesi halinde bedeli ödenir. Yeniden kullanım gerektiğinde yukarıda belirtilen hekimlerden en az üçü tarafından sağlık kurulu raporu düzenlenecektir. Bu raporda, günlük kullanım dozu ve süresi ile epikriz raporuna dayanılarak verilen ilacın kullanıldığının belirtilmesi gereklidir.'});
CREATE (sec_2991)-[:HAS_PARAGRAPH {order: 0}]->(para_2992);
CREATE (sec_2989)-[:NEXT_SUBSECTION]->(sec_2991);
CREATE (sec_2993:Subsection {id: '4.2.23', title: 'Amfoterisin-B, kaspofungin, anidilofungin, vorikonazol, posakonazol (Ek:RG-09/09/2017- 30175/23-a md.', content: 'Yürürlük: 23/09/2017) (oral süspansiyon ve tablet formu), ıtrakonazol (infüzyon ve solüsyon) (Ek: RG- 18/06/2016- 29746/ 17-a md. Yürürlük: 25/06/2016) , mikafungin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 22}]->(sec_2993);
CREATE (para_2994:Paragraph {id: '1', content: '(Mülga:RG-21/03/2018- 30367/ 26-a md. Yürürlük: 01/04/2018) (Değişik: RG- 21/03/2018- 30367/ 26-b md. Yürürlük: 01/04/2018)'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 0}]->(para_2994);

// Batch 81
CREATE (para_2995:Paragraph {id: '2', content: 'Bu maddede belirtilen etken maddeli ilaçların sistemik mantar enfeksiyonları tedavisinde kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 1}]->(para_2995);
CREATE (para_2994)-[:NEXT_PARAGRAPH]->(para_2995);
CREATE (para_2996:Paragraph {id: '3', content: 'Itrakonazol solüsyon;'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 2}]->(para_2996);
CREATE (item_2997:Item {id: 'a', content: 'HIV pozitif veya bağışıklığı bozulan hastalardaki flukonazole dirençli özofajiyal kandidozun tedavisinde kullanılır.'});
CREATE (para_2996)-[:HAS_ITEM {order: 0}]->(item_2997);
CREATE (item_2998:Item {id: 'b', content: 'Hematolojik malignitesi olan veya kemik iliği transplantasyonu yapılan ve nötropeni geliştirmesi beklenen (<500 hücre/ml) hastalardaki derin fungal (mantar) enfeksiyonlarının profilaksisinde kullanılır.'});
CREATE (para_2996)-[:HAS_ITEM {order: 1}]->(item_2998);
CREATE (item_2997)-[:NEXT_ITEM]->(item_2998);
CREATE (item_2999:Item {id: 'c', content: 'Itrakonazol’un oral formları (Solüsyon formları hariç), SUT eki “Sistemik Antimikrobik ve Diğer İlaçların Reçeteleme Kuralları Listesi” nin (EK-4/E) 10.5 maddesinde belirtildiği şekilde reçetelenebilecektir.'});
CREATE (para_2996)-[:HAS_ITEM {order: 2}]->(item_2999);
CREATE (item_2998)-[:NEXT_ITEM]->(item_2999);
CREATE (para_2995)-[:NEXT_PARAGRAPH]->(para_2996);
CREATE (para_3000:Paragraph {id: '4', content: 'Posakonazol; 122'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 3}]->(para_3000);
CREATE (item_3001:Item {id: 'a', content: 'Aşağıda tanımlanan hastalardaki invazif mantar enfeksiyonlarının profilaksisinde kullanılır. (Mülga: RG- 21/03/2018- 30367/ 26-c md. Yürürlük: 01/04/2018) (Ek: RG-21/03/2018-30367/ 26-c md. Yürürlük:01/04/2018) Posakonazolün parenteral formları yalnızca oral formlarını kullanamayan hastalarda kullanılabilir. miyeloid lösemi (AML) veya miyelodisplastik sendrom (MDS) nedeniyle remisyon-indüksiyon kemoterapisi alan hastalarda. immünsupresif tedavi alan allojenik hematopoetik kök hücre transplantı (HSCT) alıcısı olan hastalarda.'});
CREATE (para_3000)-[:HAS_ITEM {order: 0}]->(item_3001);
CREATE (subitem_3002:SubItem {id: '1', content: 'İnvazif mantar enfeksiyonu gelişme riski yüksek olan ve uzun süreli nötropeni oluşabileceği düşünülen akut'});
CREATE (item_3001)-[:HAS_SUBITEM {order: 0}]->(subitem_3002);
CREATE (subitem_3003:SubItem {id: '2', content: 'İnvazif mantar enfeksiyonu gelişme riski yüksek olan ve Graft versus host hastalığına yönelik olarak yüksek doz'});
CREATE (item_3001)-[:HAS_SUBITEM {order: 1}]->(subitem_3003);
CREATE (subitem_3002)-[:NEXT_SUBITEM]->(subitem_3003);
CREATE (item_3004:Item {id: 'b', content: 'Tedavi amaçlı olarak aşağıda tanımlanan durumlarda kullanılır. b md. Yürürlük: 23/09/2017) yalnızca oral süspansiyon formu kullanılır. olan hastalarda. koksidiodomikoz hastalığı olan hastalarda.'});
CREATE (para_3000)-[:HAS_ITEM {order: 1}]->(item_3004);
CREATE (subitem_3005:SubItem {id: '1', content: 'İmmun yetmezliği olan flukonazole dirençli orofarengeal kandiyazis tedavisinde (Ek:RG-09/09/2017- 30175/23-'});
CREATE (item_3004)-[:HAS_SUBITEM {order: 0}]->(subitem_3005);
CREATE (subitem_3006:SubItem {id: '2', content: 'Amfoterisin B, lipozomal amfoterisin B veya vorikonazol tedavilerine refrakter invazif aspergilozis tedavisinde.'});
CREATE (item_3004)-[:HAS_SUBITEM {order: 1}]->(subitem_3006);
CREATE (subitem_3005)-[:NEXT_SUBITEM]->(subitem_3006);
CREATE (subitem_3007:SubItem {id: '3', content: 'Amfoterisin B ile tedaviye refrakter ya da amfoterisin B’yi tolere edemeyen fusariozis hastalığı olan hastalarda.'});
CREATE (item_3004)-[:HAS_SUBITEM {order: 2}]->(subitem_3007);
CREATE (subitem_3006)-[:NEXT_SUBITEM]->(subitem_3007);
CREATE (subitem_3008:SubItem {id: '4', content: 'Itrakonazol ile tedaviye refrakter ya da itrakonazol’u tolere edemeyen kromoblastomikoz ve micetoma hastalığı'});
CREATE (item_3004)-[:HAS_SUBITEM {order: 3}]->(subitem_3008);
CREATE (subitem_3007)-[:NEXT_SUBITEM]->(subitem_3008);
CREATE (subitem_3009:SubItem {id: '5', content: 'Amfoterisin B ya da ıtrakonazol veya flukonazol ile tedaviye refrakter ya da bu tıbbi ürünleri tolere edemeyen'});
CREATE (item_3004)-[:HAS_SUBITEM {order: 4}]->(subitem_3009);
CREATE (subitem_3008)-[:NEXT_SUBITEM]->(subitem_3009);
CREATE (item_3001)-[:NEXT_ITEM]->(item_3004);
CREATE (para_2996)-[:NEXT_PARAGRAPH]->(para_3000);
CREATE (para_3010:Paragraph {id: '5', content: 'Anidulofungin, nötropenik olmayan (Mutlak nötrofil sayısı ≥ 500/mm3 olacak ve laboratuvar sonucu aranacaktır.) erişkin hastalarda, invazif kandidiyazis vakalarında reçetelendirilebilir. (Değişik: RG- 18/06/2016- 29746/ 17-c md. Yürürlük: 25/06/2016) (Değişik: RG- 21/03/2018- 30367/ 26-ç md. Yürürlük: 01/04/2018)'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 4}]->(para_3010);
CREATE (para_3000)-[:NEXT_PARAGRAPH]->(para_3010);
CREATE (para_3011:Paragraph {id: '6', content: 'Mikafungin; nötropenik dönemde ve takip eden bir hafta içinde veya mukoziti olan otolog hematopoietik kök hücre nakli yapılan hastalarda nötropenik dönemde aspergilloz ve candida enfeksiyonlarının profilaksisinde kullanılır. profilaksisi endikasyonunda ödenmez. (Ek: RG- 18/06/2016- 29746/ 17-ç md. Yürürlük: 25/06/2016)'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 5}]->(para_3011);
CREATE (para_3010)-[:NEXT_PARAGRAPH]->(para_3011);
CREATE (para_3012:Paragraph {id: '7', content: 'Lipozomal amfoterisin-B, lipid kompleks veya kolloidal dispersiyon amfoterisin-B’nin parenteral formları, kaspofungin, anidilofungin, vorikanazol, mikafungin, posakonazol veya ıtrakonazol (infüzyon) yukarıdaki şartları sağlayan uzman hekim raporu ve enfeksiyon hastalıkları uzmanı onayı ile yatarak tedavide kullanılır. Bu ilaçların oral formları ise enfeksiyon hastalıkları uzmanınca düzenlenecek uzman hekim raporuna dayanılarak tüm uzman hekimlerce reçetelenmesi halinde ayakta tedavide de kullanılabilecektir. (Ek: RG- 21/03/2018- 30367/ 26-d md. Yürürlük: 01/04/2018)'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 6}]->(para_3012);
CREATE (para_3011)-[:NEXT_PARAGRAPH]->(para_3012);
CREATE (para_3013:Paragraph {id: '8', content: 'Vorikonazol 200 mg tablet; nötropeni olması beklenen hematopoietik kök hücre nakli alıcısı hastaların aspergilloz ve candida enfeksiyonlarının profilaksi endikasyonunda da kullanılır.'});
CREATE (sec_2993)-[:HAS_PARAGRAPH {order: 7}]->(para_3013);
CREATE (para_3012)-[:NEXT_PARAGRAPH]->(para_3013);
CREATE (item_3014:Item {content: 'İnvaziv kandidiyazis ve özofajiyal kandidiyazis endikasyonlarında kullanılır.'});
CREATE (sec_2993)-[:HAS_ITEM {order: 0}]->(item_3014);
CREATE (item_3015:Item {content: 'Allojenik hematopoietik kök hücre nakli (HSCT) yapılan hastalarda veya akut lenfositer lösemi (ALL) hastalarında'});
CREATE (sec_2993)-[:HAS_ITEM {order: 1}]->(item_3015);
CREATE (item_3014)-[:NEXT_ITEM]->(item_3015);
CREATE (item_3016:Item {content: '10 gün veya daha uzun süreyle nötropeni olması beklenen diğer hastalarda aspergilloz ve candida enfeksiyonlarının'});
CREATE (sec_2993)-[:HAS_ITEM {order: 2}]->(item_3016);
CREATE (item_3015)-[:NEXT_ITEM]->(item_3016);
CREATE (amend_3017:Amendment {content: '(Değişik: RG- 30/08/2014- 29104/ 17 md. Yürürlük: 06/09/2014)'});
CREATE (sec_2993)-[:HAS_AMENDMENT {order: 0}]->(amend_3017);
CREATE (sec_2991)-[:NEXT_SUBSECTION]->(sec_2993);
CREATE (sec_3018:Subsection {id: '4.2.24', title: 'Solunum sistemi hastalıkları ilaçları kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 23}]->(sec_3018);
CREATE (para_3019:Paragraph {id: '1', content: 'Bu grup ilaçların ayakta tedavide kullanımı aşağıdaki ilkelere göre yapılacaktır.'});
CREATE (sec_3018)-[:HAS_PARAGRAPH {order: 0}]->(para_3019);
CREATE (sec_3020:Subsection {id: '4.2.24.A', title: 'Astım tedavisinde'});
CREATE (sec_3018)-[:HAS_SUBSECTION {order: 0}]->(sec_3020);
CREATE (para_3021:Paragraph {id: '1', content: 'Formeterol, salmeterol , vilanterol ve kombinasyonları; göğüs hastalıkları, göğüs cerrahisi, alerji, iç hastalıkları, çocuk sağlığı ve hastalıkları uzman hekimleri tarafından reçete edilir. Bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporu mevcut ise tedavinin devamı için diğer hekimlerce de reçete edilebilir.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 0}]->(para_3021);
CREATE (para_3022:Paragraph {id: '2', content: 'Montelukast, zafirlukast; iç hastalıkları, çocuk sağlığı ve hastalıkları, göğüs hastalıkları ve alerji uzman hekimleri tarafından veya bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporuna dayanılarak diğer hekimlerce de reçete edilebilir.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 1}]->(para_3022);
CREATE (para_3021)-[:NEXT_PARAGRAPH]->(para_3022);
CREATE (para_3023:Paragraph {id: '3', content: 'Mepolizumab (Ek: RG-19/10/2023-32344/10-a md. Yürürlük:27/10/2023) ve benralizumab;'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 2}]->(para_3023);
CREATE (item_3024:Item {id: 'a', content: 'Aşağıdaki kriterlerin tümünü karşılayan “(Değişik: RG- 21/04/2022- 31816/5-a md. Yürürlük: 29/04/2022) Eozinofilik (Ek: RG- 04/09/2019- 30878/ 26-a md. Yürürlük: 12/09/2019) Ağır Persistan Astım” tanılı hastalarda; (Değişik: RG- 04/09/2019- 30878/ 26-a md. Yürürlük: 12/09/2019) (Değişik: RG- 21/04/2022- 31816/5-b md. Yürürlük: 29/04/2022) (Değişik: RG-19/10/2023- 32344/10-a md. Yürürlük: 27/10/2023) kullanan hastalarda ise tedavi altında ≥150 hücre/µl olması), benralizumab kullanımında ise kan eozinofil sayımının ≥300 hücre/µl olması, kortikosteroid (>800 mcg/gün budesonid veya eşdeğeri (Ek: RG-21/04/2022-31816/5-c md. Yürürlük:29/04/2022), 6-11 yaş için >400 mcg/gün budesonid veya eşdeğeri) ve inhaler uzun etkili beta iki agonist  kombinasyonunu en az 1 (bir) yıldır kullanmakta olmasına rağmen kontrolsüz astımı olması (en az 3 gün sistemik kortikosteroid kullanımını gerektiren yılda en az 2 atağı olması).'});
CREATE (para_3023)-[:HAS_ITEM {order: 0}]->(item_3024);
CREATE (subitem_3025:SubItem {id: '1', content: 'Mepolizumab 6 yaş ve üzeri çocuklar ile adölesanlar ve yetişkinlerde, benralizumab yalnızca yetişkinlerde,'});
CREATE (item_3024)-[:HAS_SUBITEM {order: 0}]->(subitem_3025);
CREATE (subitem_3026:SubItem {id: '2', content: 'Mepolizumab kullanımında kan eozinofil sayımının ≥300 hücre/µl olması (uzun süredir düzenli sistemik steroid'});
CREATE (item_3024)-[:HAS_SUBITEM {order: 1}]->(subitem_3026);
CREATE (subitem_3025)-[:NEXT_SUBITEM]->(subitem_3026);
CREATE (subitem_3027:SubItem {id: '3', content: 'En az 6 aydır düzenli sistemik steroid altında kontrollü veya kontrolsüz astımı olması ve/veya yüksek doz inhaler'});
CREATE (item_3024)-[:HAS_SUBITEM {order: 2}]->(subitem_3027);
CREATE (subitem_3026)-[:NEXT_SUBITEM]->(subitem_3027);
CREATE (item_3028:Item {id: 'b', content: 'Üçüncü basamak (Ek: RG-21/04/2022-31816/5-ç md. Yürürlük:29/04/2022) resmi sağlık hizmeti sunucularında, en az bir immünoloji ve alerji hastalıkları uzman hekiminin yer aldığı sağlık kurulu raporuna dayanılarak (Ek: RG- 04/09/2019- 123 30878/ 26-b md. Yürürlük: 12/09/2019) göğüs hastalıkları veya immünoloji ve alerji hastalıkları uzman hekimleri tarafından reçete edilmesi halinde bedeli ödenir.'});
CREATE (para_3023)-[:HAS_ITEM {order: 1}]->(item_3028);
CREATE (item_3024)-[:NEXT_ITEM]->(item_3028);
CREATE (item_3029:Item {id: 'c', content: 'İlk tedaviye yanıtın üçüncü basamak (Ek: RG-21/04/2022-31816/5-ç md. Yürürlük:29/04/2022) resmi sağlık hizmeti sunucularında 16 ncı haftada değerlendirilmesi ve tedaviye devamın uygun görülmesi halinde bu durumun belirtildiği en az bir immünoloji ve alerji hastalıkları uzman hekiminin yer aldığı sağlık kurulu raporu ile (Ek:RG- 04/09/2019- 30878/ 26-b md. Yürürlük: 12/09/2019) göğüs hastalıkları veya immünoloji ve alerji hastalıkları uzman hekimleri tarafından reçete edilmesi halinde bedeli ödenir. (Ek:RG- 04/09/2019- 30878/ 26-c md. Yürürlük: 12/09/2019)'});
CREATE (para_3023)-[:HAS_ITEM {order: 2}]->(item_3029);
CREATE (item_3028)-[:NEXT_ITEM]->(item_3029);
CREATE (para_3022)-[:NEXT_PARAGRAPH]->(para_3023);
CREATE (para_3030:Paragraph {id: '4', content: 'Uzun etkili solunum yolu beta-agonistleri (LABA) ve inhale kortikosteroidler (İKS) gruplarında mono olarak yer alan ürünlerin tek başına veya birlikte reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 3}]->(para_3030);
CREATE (para_3023)-[:NEXT_PARAGRAPH]->(para_3030);
CREATE (para_3031:Paragraph {id: '5', content: 'Aynı reçetede bulunan uzun etkili solunum yolu beta-agonistini (LABA) mono veya sabit doz kombinasyonu şeklinde içeren müstahzarlardan yalnızca bir müstahzarın bedeli Kurumca karşılanır.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 4}]->(para_3031);
CREATE (para_3030)-[:NEXT_PARAGRAPH]->(para_3031);

// Batch 82
CREATE (para_3032:Paragraph {id: '6', content: 'Aynı reçetede bulunan inhale kortikosteroidi (İKS) mono veya sabit doz kombinasyonu şeklinde içeren müstahzarlardan yalnızca bir müstahzarın bedeli Kurumca karşılanır.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 5}]->(para_3032);
CREATE (para_3031)-[:NEXT_PARAGRAPH]->(para_3032);
CREATE (para_3033:Paragraph {id: '7', content: 'Uzun etkili solunum yolu beta-agonistleri (LABA) ve inhale kortikosteroidlerin (İKS) mono veya sabit doz kombinasyonu gruplarında yer alan ürünlerin diğer şekillerde reçete edilmesi halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 6}]->(para_3033);
CREATE (para_3032)-[:NEXT_PARAGRAPH]->(para_3033);
CREATE (para_3034:Paragraph {id: '8', content: 'Kısa etkili solunum yolu beta-agonistini (SABA) veya kısa etkili solunum yolu beta-agonistini (SABA) ve obstrüktif solunum yolu hastalıklarında kullanılan kısa etkili antikolinerjik maddeyi (SAMA) kombine olarak içeren ürünler (SABA+SAMA) (Değişik:RG- 09/05/2024-32541/11-a md. Yürürlük:17/05/2024) inhale formları 4.2.24.A numaralı maddesinde yer alan hükümlerden istisnadır. (Ek:RG- 26/10/2021- 31640/ 8-a md. Yürürlük: 04/11/2021)'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 7}]->(para_3034);
CREATE (para_3033)-[:NEXT_PARAGRAPH]->(para_3034);
CREATE (para_3035:Paragraph {id: '9', content: 'Beklometazon+formoterol+glikopronyum  veya (Ek:RG-19/10/2023-32344/10-b md. Yürürlük:27/10/2023) flutikazonfuroat 100 mcg + umeklidinyum+ vilanterol etken maddelerini sabit dozda içeren ürünler; uzun etkili beta-2 agonist ve orta doz inhale kortikosteroid kombinasyonu ile yeterince kontrol edilemeyen ve önceki yıl bir veya daha fazla astım alevlenmesi yaşayan erişkin hastaların idame tedavisinde göğüs hastalıkları, göğüs cerrahisi, alerji, iç hastalıkları uzman hekimleri tarafından reçete edilir. Bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporu mevcut ise tedavinin devamı için diğer hekimlerce de reçete edilmesi halinde bedelleri Kurumca karşılanır. (Ek: RG- 19/10/2023- 32344/10-c md. Yürürlük: 27/10/2023)'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 8}]->(para_3035);
CREATE (para_3034)-[:NEXT_PARAGRAPH]->(para_3035);
CREATE (para_3036:Paragraph {id: '10', content: 'Flutikazonfuroat 200 mcg + umeklidinyum + vilanterol etken maddelerini sabit dozda içeren ürünler; flutikazonfuroat 100 mcg + umeklidinyum + vilanterol veya uzun etkili beta-2 agonist ve yüksek doz inhale kortikosteroid kombinasyonu ile yeterince kontrol edilemeyen ve önceki yıl bir veya daha fazla astım alevlenmesi yaşayan erişkin hastaların idame tedavisinde göğüs hastalıkları veya alerji uzman hekimleri tarafından reçete edilir. Bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporu mevcut ise tedavinin devamı için diğer hekimlerce de reçete edilmesi halinde bedelleri Kurumca karşılanır. (Ek: RG- 09/05/2024-32541/11-b md. Yürürlük: 17/05/2024)'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 9}]->(para_3036);
CREATE (para_3035)-[:NEXT_PARAGRAPH]->(para_3036);
CREATE (para_3037:Paragraph {id: '11', content: 'Nebül formundaki solunum sistemi ilaçları Sağlık Bakanlığınca onaylı endikasyonlarında kullanılması koşulu ile tüm hekimlerce raporsuz olarak en fazla bir kutu reçete edilmesi halinde, göğüs hastalıkları, immünoloji, immünoloji ve alerji, alerji veya çocuk sağlığı ve hastalıkları tarafından düzenlenen uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır. Aynı grupta yer alan etkin maddeleri içeren iki ayrı nebül formundaki ilaçlar kombine olarak kullanılamaz.'});
CREATE (sec_3020)-[:HAS_PARAGRAPH {order: 10}]->(para_3037);
CREATE (para_3036)-[:NEXT_PARAGRAPH]->(para_3037);
CREATE (amend_3038:Amendment {content: '(Ek:RG-07/10/2016-29850/30 \nmd. \nYürürlük:15/10/2016)'});
CREATE (sec_3020)-[:HAS_AMENDMENT {order: 0}]->(amend_3038);
CREATE (amend_3039:Amendment {content: '(Ek: RG- 04/02/2018- 30322/ 17 md. Yürürlük: 15/02/2018)'});
CREATE (sec_3020)-[:HAS_AMENDMENT {order: 1}]->(amend_3039);
CREATE (amend_3040:Amendment {content: '(Değişik: RG- 30/12/2020- 31350/ 6 md. \nYürürlük: 08/01/2021)'});
CREATE (sec_3020)-[:HAS_AMENDMENT {order: 2}]->(amend_3040);
CREATE (amend_3041:Amendment {content: '(Ek:RG-25/08/2022-31934/30 md. Yürürlük:03/09/2022)'});
CREATE (sec_3020)-[:HAS_AMENDMENT {order: 3}]->(amend_3041);
CREATE (sec_3042:Subsection {id: '4.2.24.B', title: 'Kronik obstrüktif akciğer hastalığı (KOAH) tedavisinde', content: '(Değişik:RG- 04/09/2019- 30878/ 27-a md. Yürürlük: 12/09/2019)'});
CREATE (sec_3018)-[:HAS_SUBSECTION {order: 1}]->(sec_3042);
CREATE (para_3043:Paragraph {id: '1', content: 'Formeterol, salmeterol ve bunların inhaler kortikosteroidlerle kombinasyonları, indakaterol, glikopironyum, (Ek: RG-21/04/2022-31816/5-d md. Yürürlük:29/04/2022) indakaterol+glikopironyum, tiotropium, vilanterol+flutikazon, vilanterol+umeklidinyum, tiotropium+olodaterol, beklometazon+formoterol+glikopronyum veya flutikazon furoat+umeklidinyum+vilanterol etken maddeli ilaçlar; göğüs hastalıkları, göğüs cerrahisi, iç hastalıkları, çocuk sağlığı ve hastalıkları veya kardiyoloji uzman hekimleri tarafından veya bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 0}]->(para_3043);
CREATE (para_3044:Paragraph {id: '2', content: 'Beklometazon+formoterol+glikopronyum etken maddelerini sabit dozda içeren veya flutikazon furoat+umeklidinyum+vilanterol etken maddelerini sabit doz kombinasyonu şeklinde içeren ürünlerin;'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 1}]->(para_3044);
CREATE (item_3045:Item {id: 'a', content: 'En az 3 ay süreyle inhale kortikosteroid (İKS) ve uzun etkili solunum yolu beta-agonistleri (LABA) (Değişik: RG- 26/10/2021- 31640/ 8-b md. Yürürlük: 04/11/2021) (Ek: RG- 30/12/2020- 31350/ 7-a md. Yürürlük: 08/01/2021) veya en az 3 ay süreyle, uzun etkili solunum yolu beta-agonistleri (LABA) ve uzun etkili antikolinerjikler (LAMA) ile tedavi edildiği halde yeterli yanıt alınamayan, sık atak geçiren (yılda 2 ve üzeri atak veya 1 ve üzeri yatarak tedavi) ve dispnesi olan (mMrc 2 ve üzeri veya CAT skoru 10 ve üzeri) orta-ağır Kronik Obstrüktif Akciğer Hastalığı (KOAH) olan erişkin hastaların idame tedavisinde kullanılmaları ve bu durumların uzman hekim raporunda belirtilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (para_3044)-[:HAS_ITEM {order: 0}]->(item_3045);
CREATE (item_3046:Item {id: 'b', content: 'Birbirleri ile veya uzun etkili solunum yolu beta-agonistleri (LABA), obstrüktif solunum yolu hastalıklarında kullanılan uzun etkili antikolinerjikler (LAMA) ve inhale kortikosteroidler (İKS) ile kombine olarak kullanılmaları halinde bedelleri Kurumca karşılanmaz.'});
CREATE (para_3044)-[:HAS_ITEM {order: 1}]->(item_3046);
CREATE (item_3045)-[:NEXT_ITEM]->(item_3046);
CREATE (para_3043)-[:NEXT_PARAGRAPH]->(para_3044);
CREATE (para_3047:Paragraph {id: '3', content: 'Roflumilast; uzun etkili bronkodilatör ve/veya inhale kortikosteroid tedavisine rağmen en az 2 yıl boyunca her yıl için; yılda en az 3 ay öksürük, balgam şikayeti olan ve yılda en az iki atak geçiren ağır kronik obstruktif akciğer hastalarında;'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 2}]->(para_3047);
CREATE (item_3048:Item {id: 'a', content: 'Solunum fonksiyon testi (SFT) kriteri olarak, FEV1/FVC değeri %70’in altında olmak koşulu ile FEV1≤%50 olanlarda mevcut tedaviye ek olarak kullanılmaya başlanır.'});
CREATE (para_3047)-[:HAS_ITEM {order: 0}]->(item_3048);
CREATE (item_3049:Item {id: 'b', content: 'Göğüs hastalıkları uzmanınca düzenlenen 6 ay süreli uzman hekim raporuna dayanılarak göğüs hastalıkları uzmanı tarafından reçete edilir. 124'});
CREATE (para_3047)-[:HAS_ITEM {order: 1}]->(item_3049);
CREATE (item_3048)-[:NEXT_ITEM]->(item_3049);
CREATE (item_3050:Item {id: 'c', content: 'Sağlık raporunda hastanın kullandığı uzun etkili bronkodilatör ve/veya inhale kortikosteroid tedavi şeması ile diğer durumlar belirtilir.'});
CREATE (para_3047)-[:HAS_ITEM {order: 2}]->(item_3050);
CREATE (item_3049)-[:NEXT_ITEM]->(item_3050);
CREATE (item_3051:Item {id: 'ç', content: 'Teofilinle kombine olarak kullanılamaz. (Ek: RG- 04/09/2019- 30878/ 27-b md. Yürürlük: 12/09/2019)'});
CREATE (para_3047)-[:HAS_ITEM {order: 3}]->(item_3051);
CREATE (item_3050)-[:NEXT_ITEM]->(item_3051);
CREATE (para_3044)-[:NEXT_PARAGRAPH]->(para_3047);
CREATE (para_3052:Paragraph {id: '4', content: 'Uzun etkili solunum yolu beta-agonistleri (LABA), obstrüktif solunum yolu hastalıklarında kullanılan uzun etkili antikolinerjikler (LAMA) ve inhale kortikosteroidler (İKS) gruplarında mono olarak yer alan ürünlerin tek başına veya birlikte reçete edilmesi halinde bedelleri Kurumca karşılanır. (Mülga:RG-16/06/2020-31157/13-a md. Yürürlük: 24/06/2020)'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 3}]->(para_3052);
CREATE (para_3047)-[:NEXT_PARAGRAPH]->(para_3052);
CREATE (para_3053:Paragraph {id: '5', content: 'Uzun etkili solunum yolu beta-agonistini (LABA) ve inhale kortikosteroidi (İKS) kombine olarak içeren ürünlerin (LABA+İKS) tek başına veya obstrüktif solunum yolu hastalıklarında kullanılan uzun etkili antikolinerjik maddeyi içeren ürünler (LAMA) ile birlikte reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 4}]->(para_3053);
CREATE (para_3052)-[:NEXT_PARAGRAPH]->(para_3053);
CREATE (para_3054:Paragraph {id: '6', content: 'Uzun etkili solunum yolu beta-agonistini (LABA) ve obstrüktif solunum yolu hastalıklarında kullanılan uzun etkili antikolinerjik maddeyi (LAMA) kombine olarak içeren ürünlerin (LABA+LAMA) tek başına veya inhale kortikosteroid içeren ürünler (İKS) ile birlikte reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 5}]->(para_3054);
CREATE (para_3053)-[:NEXT_PARAGRAPH]->(para_3054);
CREATE (para_3055:Paragraph {id: '7', content: 'Uzun etkili solunum yolu beta-agonistleri (LABA), obstrüktif solunum yolu hastalıklarında kullanılan uzun etkili antikolinerjikler (LAMA) ve inhale kortikosteroidlerin (İKS) mono veya sabit doz kombinasyonu gruplarında yer alan ürünlerin diğer şekillerde reçete edilmesi halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 6}]->(para_3055);
CREATE (para_3054)-[:NEXT_PARAGRAPH]->(para_3055);
CREATE (para_3056:Paragraph {id: '8', content: 'Aynı reçetede bulunan uzun etkili solunum yolu beta-agonistini (LABA) mono veya sabit doz kombinasyonu şeklinde içeren müstahzarlardan yalnızca bir müstahzarın bedeli Kurumca karşılanır.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 7}]->(para_3056);
CREATE (para_3055)-[:NEXT_PARAGRAPH]->(para_3056);
CREATE (para_3057:Paragraph {id: '9', content: 'Aynı reçetede bulunan obstrüktif solunum yolu hastalıklarında kullanılan uzun etkili antikolinerjikleri (LAMA) mono veya sabit doz kombinasyonu şeklinde içeren müstahzarlardan yalnızca bir müstahzarın bedeli Kurumca karşılanır.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 8}]->(para_3057);
CREATE (para_3056)-[:NEXT_PARAGRAPH]->(para_3057);
CREATE (para_3058:Paragraph {id: '10', content: 'Aynı reçetede bulunan inhale kortikosteroidi (İKS) mono veya sabit doz kombinasyonu şeklinde içeren müstahzarlardan yalnızca bir müstahzarın bedeli Kurumca karşılanır.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 9}]->(para_3058);
CREATE (para_3057)-[:NEXT_PARAGRAPH]->(para_3058);
CREATE (para_3059:Paragraph {id: '11', content: 'Kısa etkili solunum yolu beta-agonistini (SABA) veya kısa etkili solunum yolu beta-agonistini (SABA) ve obstrüktif solunum yolu hastalıklarında kullanılan kısa etkili antikolinerjik maddeyi (SAMA) kombine olarak içeren ürünler (SABA+SAMA) (Değişik:RG-09/05/2024-32541/12-a md. Yürürlük:17/05/2024) inhale formları 4.2.24.B numaralı maddesinde yer alan hükümlerden istisnadır. (Ek: RG-16/06/2020-31157/13-b md. Yürürlük: 24/06/2020)'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 10}]->(para_3059);
CREATE (para_3058)-[:NEXT_PARAGRAPH]->(para_3059);
CREATE (para_3060:Paragraph {id: '12', content: '(4), (5) ve (6) ncı fıkralarda yer alan mono LABA/LAMA/İKS veya sabit doz LABA/LAMA/İKS kombinasyonlarıyla yapılacak üçlü kombinasyon tedavilerinde; en az 3 ay süreyle inhale kortikosteroid (İKS) ve uzun etkili solunum yolu beta-agonistleri (LABA) (Ek: RG-30/12/2020-31350/7-b md. Yürürlük: 08/01/2021) veya uzun etkili solunum yolu beta-agonistleri (LABA) ve uzun etkili antikolinerjikler (LAMA) ile tedavi edildiği halde yeterli yanıt alınamayan, sık atak geçiren (yılda 2 ve üzeri atak veya 1 ve üzeri yatarak tedavi) ve dispnesi olan (mMrc 2 ve üzeri veya CAT skoru 10 ve üzeri) orta-ağır kronik obstrüktif akciğer hastalığı (KOAH) olan erişkin hastaların idame tedavisinde kullanılmaları ve bu durumların uzman hekim raporunda belirtilmesi halinde bedelleri Kurumca karşılanır. (Ek: RG- 09/05/2024-32541/12-b md. Yürürlük: 17/05/2024)'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 11}]->(para_3060);
CREATE (para_3059)-[:NEXT_PARAGRAPH]->(para_3060);
CREATE (para_3061:Paragraph {id: '13', content: 'Nebül formundaki solunum sistemi ilaçları Sağlık Bakanlığınca onaylı endikasyonlarında kullanılması koşulu ile tüm hekimlerce raporsuz olarak en fazla bir kutu reçete edilmesi halinde, göğüs hastalıkları, immünoloji, immünoloji ve alerji, alerji veya çocuk sağlığı ve hastalıkları uzman hekimlerin biri tarafından düzenlenen uzman hekim raporu mevcut ise tedavinin devamı için diğer hekimlerce de reçete edilmesi halinde bedelleri Kurumca karşılanır. Aynı grupta yer alan etkin maddeleri içeren iki ayrı nebül formundaki ilaçlar kombine olarak kullanılamaz.'});
CREATE (sec_3042)-[:HAS_PARAGRAPH {order: 12}]->(para_3061);
CREATE (para_3060)-[:NEXT_PARAGRAPH]->(para_3061);
CREATE (amend_3062:Amendment {content: '(Ek: RG- 25/07/2014- 29071/ 31 md. Yürürlük: 07/08/2014)'});
CREATE (sec_3042)-[:HAS_AMENDMENT {order: 0}]->(amend_3062);
CREATE (sec_3020)-[:NEXT_SUBSECTION]->(sec_3042);
CREATE (sec_3063:Subsection {id: '4.2.24.C', title: 'Alerjik rinit (mevsimsel, yıl boyu devam eden (pereniyal), birlikte seyreden astım dahil) tedavisinde;'});
CREATE (sec_3018)-[:HAS_SUBSECTION {order: 2}]->(sec_3063);
CREATE (para_3064:Paragraph {id: '1', content: 'Montelukast ve antihistaminik kombinasyonları; kulak burun boğaz uzman hekimleri, iç hastalıkları, çocuk sağlığı ve hastalıkları, göğüs hastalıkları, alerji uzman hekimlerince veya bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporuna dayanılarak diğer hekimlerce de reçete edilebilir. (Değişik:RG-28/04/2021-31468/17-a md. Yürürlük: 06/05/2021)'});
CREATE (sec_3063)-[:HAS_PARAGRAPH {order: 0}]->(para_3064);
CREATE (para_3065:Paragraph {id: '2', content: 'Mevsimsel ve pereniyal alerjik rinit semptomlarının giderilmesinde intranazal antihistaminik veya glukokortikoid monoterapilerinin yeterli olmadığı durumlarda; azelastin hidroklorür ve flutikazon propiyonat etken maddelerini içeren sabit doz kombine preparatları 12 yaş ve üzeri hastalarda alerji ve immünoloji, kulak burun boğaz, iç hastalıkları, çocuk sağlığı ve hastalıkları, göğüs hastalıkları uzman hekimlerince reçete edilmesi halinde Kurumca bedelleri karşılanır. (Ek:RG-28/04/2021-31468/17-b md. Yürürlük: 06/05/2021)'});
CREATE (sec_3063)-[:HAS_PARAGRAPH {order: 1}]->(para_3065);
CREATE (para_3064)-[:NEXT_PARAGRAPH]->(para_3065);
CREATE (para_3066:Paragraph {id: '3', content: 'Mevsimsel ve pereniyal alerjik rinit semptomlarının giderilmesinde intranazal antihistaminik veya glukokortikoid monoterapilerinin yeterli olmadığı durumlarda; mono intranazal kortikosteroid ve mono intranazal antihistaminik ilaçların birlikte kullanımı alerji ve immünoloji, kulak burun boğaz, iç hastalıkları, çocuk sağlığı ve hastalıkları, göğüs hastalıkları uzman hekimlerince birlikte reçete edilmesi halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_3063)-[:HAS_PARAGRAPH {order: 2}]->(para_3066);
CREATE (para_3065)-[:NEXT_PARAGRAPH]->(para_3066);
CREATE (sec_3042)-[:NEXT_SUBSECTION]->(sec_3063);
CREATE (sec_3067:Subsection {id: '4.2.24.Ç', title: 'Mevsimsel veya yıl boyu devam eden alerjik rinit tedavisinde'});
CREATE (sec_3018)-[:HAS_SUBSECTION {order: 3}]->(sec_3067);
CREATE (para_3068:Paragraph {id: '1', content: 'Nasal kortikosteroid preparatları; 2-5 yaş grubu hastalarda (2 ve 5 yaş grubu dahil), yalnızca çocuk sağlığı ve hastalıkları, alerji, klinik immünoloji veya KBB hastalıkları uzman hekimleri tarafından reçete edilir.'});
CREATE (sec_3067)-[:HAS_PARAGRAPH {order: 0}]->(para_3068);

// Batch 83
CREATE (sec_3063)-[:NEXT_SUBSECTION]->(sec_3067);
CREATE (sec_2993)-[:NEXT_SUBSECTION]->(sec_3018);
CREATE (sec_3069:Subsection {id: '4.2.25', title: 'Antiepileptik ilaçların kullanım ilkeleri', content: '(Değişik: RG- 04/09/2019- 30878/ 28-a md. Yürürlük: 12/09/2019)'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 24}]->(sec_3069);
CREATE (para_3070:Paragraph {id: '1', content: 'Yeni nesil antiepileptiklerin (lamotrigin, topiramat, vigabatrin, levatirasetam)  nöroloji veya beyin cerrahisi uzman hekimleri tarafından veya bu uzman hekimlerden biri tarafından düzenlenen uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3069)-[:HAS_PARAGRAPH {order: 0}]->(para_3070);
CREATE (para_3071:Paragraph {id: '2', content: 'Zonisamit etken maddeli ilaçların nöroloji uzman hekimleri tarafından veya bu uzman hekimler tarafından düzenlenen 1 yıl süreli uzman hekim raporuna dayanılarak tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır. 125'});
CREATE (sec_3069)-[:HAS_PARAGRAPH {order: 1}]->(para_3071);
CREATE (para_3070)-[:NEXT_PARAGRAPH]->(para_3071);
CREATE (para_3072:Paragraph {id: '3', content: 'Pregabalin etken maddeli ilaçların mono veya sabit doz kombinasyonlarının   ikinci veya üçüncü basamak sağlık hizmeti sunucularında  düzenlenen en az bir nöroloji uzman hekiminin yer aldığı 1 yıl süreli sağlık kurulu raporuna istinaden nöroloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. Pregabalin etken maddeli ilaçların mono veya sabit doz kombinasyonlarının yaygın anksiyete bozukluğu endikasyonunda bedelleri Kurumca karşılanmaz. Pregabalin ve gabapentin kombine olarak kullanılamaz.'});
CREATE (sec_3069)-[:HAS_PARAGRAPH {order: 2}]->(para_3072);
CREATE (para_3071)-[:NEXT_PARAGRAPH]->(para_3072);
CREATE (para_3073:Paragraph {id: '4', content: 'Lakozamid; 16 yaş ve üzerindeki parsiyel başlangıçlı epilepsi hastalarında ikincil jeneralize olan veya olmayan nöbetlerin tedavisinde, en az iki antiepileptik ilacın en az 6 ay süreyle tek başına veya kombine kullanımından sonra tedaviye yanıt alınamayan hastalarda ek tedavi  veya monoterapi olarak, bu durumların belirtildiği nöroloji uzman hekim raporuna dayanılarak tüm uzman hekimlerce reçete edilebilir. (Ek: RG- 04/09/2019- 30878/ 28-b md. Yürürlük: 12/09/2019)'});
CREATE (sec_3069)-[:HAS_PARAGRAPH {order: 3}]->(para_3073);
CREATE (para_3072)-[:NEXT_PARAGRAPH]->(para_3073);
CREATE (para_3074:Paragraph {id: '5', content: 'Gabapentin etken maddeli ilaçların ikinci veya üçüncü basamak sağlık hizmeti sunucularında düzenlenen en az bir nöroloji uzman hekiminin yer aldığı 1 yıl süreli sağlık kurulu raporuna istinaden nöroloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. Pregabalin ve gabapentin kombine olarak kullanılamaz.'});
CREATE (sec_3069)-[:HAS_PARAGRAPH {order: 4}]->(para_3074);
CREATE (para_3073)-[:NEXT_PARAGRAPH]->(para_3074);

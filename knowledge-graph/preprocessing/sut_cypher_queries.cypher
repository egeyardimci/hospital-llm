CREATE (sec_3872:Subsection {id: '5.2.6', title: 'Kişiye özel üretilen ısmarlama malzemeler ve iyileştirici araç ve gereçleri karşılayan sözleşmeli resmi', content: 'kurum/kuruluşlar tarafından ayakta tedavide kullanılan tıbbi malzemelere ait faturaların düzenlenmesi'});

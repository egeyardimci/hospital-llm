// Batch 41
CREATE (item_1503)-[:NEXT_ITEM]->(item_1504);
CREATE (item_1505:Item {id: 'e', content: 'Tümörün submukozal yayılımının ayırt edilmesi,'});
CREATE (para_1499)-[:HAS_ITEM {order: 5}]->(item_1505);
CREATE (item_1504)-[:NEXT_ITEM]->(item_1505);
CREATE (item_1506:Item {id: 'f', content: 'Mediastinal kitlelerin tanısında, kullanılması durumunda bedeli Kurumca karşılanır. 61'});

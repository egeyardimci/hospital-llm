CREATE (para_135:Paragraph {id: '1', content: 'Kişiler, resmi sağlık hizmeti sunucularında uygun yoğun bakım yatağının bulunmaması ve hasta naklinin 112 Komuta Kontrol Merkezi koordinasyonunda gerçekleştirilmesi koşuluyla yoğun bakım tedavisi için özel sağlık hizmeti sunucularına da sevk edilebilir. Bu durumda, naklin 112 Komuta Kontrol Merkezi koordinasyonunda gerçekleştiğini gösterir belge yeterli kabul edilecektir.'});

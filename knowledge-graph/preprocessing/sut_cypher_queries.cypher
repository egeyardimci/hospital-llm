CREATE (sec_2152:Subsection {id: '4.2.7', title: 'Düşük molekül ağırlıklı heparinlerin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 6}]->(sec_2152);
CREATE (para_2153:Paragraph {id: '1', content: 'Uzman hekimlerce veya uzman hekim tarafından düzenlenen en fazla 3 ay süreli kullanılacak ilacın dozunu gösteren uzman hekim raporuna dayanılarak tedaviye başlanır ve bu rapora istinaden diğer hekimler tarafından reçete edilebilir. Devam tedavisi için düzenlenecek sağlık kurulu raporları, en fazla 1 yıl süreli olup bu rapora dayanılarak tüm hekimler tarafından reçete edilebilir.  Düşük molekül ağırlıklı heparinlerin 1 yıldan daha uzun sürede kullanımı gerektiğinde; onkoloji, hematoloji, kalp damar cerrahisi, kardiyoloji, göğüs hastalıkları veya nöroloji uzman hekimlerinden herhangi birinin bulunduğu sağlık kurulu raporuna istinaden tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.  Gebelerde ise kadın hastalıkları ve doğum uzman hekimince düzenlenen 9 ay süreli uzman hekim raporuna istinaden tüm hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_2152)-[:HAS_PARAGRAPH {order: 0}]->(para_2153);
CREATE (para_2154:Paragraph {id: '2', content: 'Yatan hastalarda veya acil müdahale gerektiren durumlarda acil servislerde rapor aranmaksızın tüm hekimler tarafından reçete edilebilir.'});
CREATE (sec_2152)-[:HAS_PARAGRAPH {order: 1}]->(para_2154);
CREATE (para_2153)-[:NEXT_PARAGRAPH]->(para_2154);
CREATE (para_2155:Paragraph {id: '3', content: 'Hemodiyaliz tedavilerinde, heparinler tanıya dayalı işlem puanına dahil olduğundan reçete edilse dahi bedeli ödenmez.'});
CREATE (sec_2152)-[:HAS_PARAGRAPH {order: 2}]->(para_2155);
CREATE (para_2154)-[:NEXT_PARAGRAPH]->(para_2155);
CREATE (para_2156:Paragraph {id: '4', content: 'Farklı etken maddeli düşük molekül ağırlıklı heparinlerin birlikte kullanılması halinde bedelleri Kurumca karşılanmaz.'});
CREATE (sec_2152)-[:HAS_PARAGRAPH {order: 3}]->(para_2156);
CREATE (para_2155)-[:NEXT_PARAGRAPH]->(para_2156);
CREATE (amend_2157:Amendment {content: '(Değişik: RG- 25/08/2022- 31934/ 21 md. Yürürlük: 03/09/2022)'});
CREATE (sec_2152)-[:HAS_AMENDMENT {order: 0}]->(amend_2157);
CREATE (amend_2158:Amendment {content: '(Ek: RG-02/11/2024-32710/11 md. Yürürlük:09/11/2024)'});

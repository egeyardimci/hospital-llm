CREATE (sec_3878:Subsection {id: '5.2.7', title: 'Kurum ile Sağlık Bakanlığı arasındaki protokole istinaden gaziler için her türlü ortez/protez ve diğer', content: 'iyileştirici araç ve gereçlerin teminine ilişkin faturaların düzenlenmesi'});
CREATE (sec_3822)-[:HAS_SUBSECTION {order: 6}]->(sec_3878);
CREATE (para_3879:Paragraph {id: '1', content: '3.1.2 numaralı maddenin on yedinci fıkrasında gazilerle ilgili yapılan düzenlemeler kapsamında temin edilen malzemeler için tek fatura düzenlenir.'});
CREATE (sec_3878)-[:HAS_PARAGRAPH {order: 0}]->(para_3879);
CREATE (para_3880:Paragraph {id: '2', content: 'Sağlık Bakanlığı Sağlık Bilimleri Üniversitesi Gaziler Fizik Tedavi ve Rehabilitasyon Eğitim ve Araştırma Hastanesi bünyesinde toplanan tıbbi uygunluk komisyonu tarafından düzenlenmiş tıbbi uygunluk raporu ve sağlık kurulu raporu istenir.'});
CREATE (sec_3878)-[:HAS_PARAGRAPH {order: 1}]->(para_3880);
CREATE (para_3879)-[:NEXT_PARAGRAPH]->(para_3880);
CREATE (sec_3872)-[:NEXT_SUBSECTION]->(sec_3878);
CREATE (sec_3815)-[:NEXT_SECTION]->(sec_3822);
CREATE (sec_3881:Section {id: '5.3', title: 'İncelemeye esas belgeler'});
CREATE (doc_1)-[:HAS_SECTION {order: 29}]->(sec_3881);
CREATE (para_3882:Paragraph {id: '1', content: 'Sağlık hizmeti sunucularından sağlık hizmeti alımına ilişkin yapılan (Mülga: RG- 25/08/2022- 31934/ 54-a md. Yürürlük: 03/09/2022) sözleşmelerde belirtilen incelemeye esas belgelerden hangilerinin Kuruma teslim edileceği ile ilgili hükümleri saklıdır.'});
CREATE (sec_3881)-[:HAS_PARAGRAPH {order: 0}]->(para_3882);
CREATE (para_3883:Paragraph {id: '2', content: 'Sağlık hizmeti sunucuları bu Tebliğde, (Mülga: RG- 25/08/2022- 31934/ 54-a md. Yürürlük: 03/09/2022) sözleşmelerde yer alan özel hükümleri saklı kalmak kaydıyla Kurumun sair mevzuatında belirtilen belgeleri Kuruma göndermekle yükümlüdür.'});
CREATE (sec_3881)-[:HAS_PARAGRAPH {order: 1}]->(para_3883);
CREATE (para_3882)-[:NEXT_PARAGRAPH]->(para_3883);
CREATE (para_3884:Paragraph {id: '3', content: 'Eczaneler, optisyenlik müesseseleri, sözleşmeli satış merkezleri/satış merkezleri, kişiye özel üretilen ısmarlama malzemeler ve iyileştirici araç ve gereçleri karşılayan sözleşmeli merkezler/resmi (Değişik: RG- 25/08/2022- 31934/ 54-b md. Yürürlük: 03/09/2022) sağlık hizmeti sunucuları, Gaziler Fizik Tedavi ve Rehabilitasyon Eğitim ve Araştırma Hastanesi için bu Tebliğ hükümlerinde ve Kurumun sair mevzuatında belirtilen incelemeye esas belgeleri Kuruma gönderir. (Değişik: RG- 25/08/2022- 31934/ 54-c md. Yürürlük: 03/09/2022)'});
CREATE (sec_3881)-[:HAS_PARAGRAPH {order: 2}]->(para_3884);

// Batch 104
CREATE (para_3883)-[:NEXT_PARAGRAPH]->(para_3884);
CREATE (sec_3885:Subsection {id: '5.3.1', title: 'Sağlık hizmeti sunucuları için incelemeye esas belgeler'});
CREATE (sec_3881)-[:HAS_SUBSECTION {order: 0}]->(sec_3885);
CREATE (para_3886:Paragraph {id: '1', content: 'Aşağıda sayılan incelemeye esas belgeler, incelenmek ve ödeme yapılmak üzere Kuruma gönderilir. Ancak örnekleme yöntemi ile incelenen işlemlere ait incelemeye esas belgelerden, örneklemeye düşmüş olanlar Kuruma gönderilir, örnekleme dışında kalan işlemlere ait olanlar ise ihtiyaç duyulması halinde Kuruma ibraz edilmek üzere sağlık hizmeti sunucularında muhafaza edilir. İncelemeye esas belgeler elektronik olarak düzenlenerek ve/veya elektronik ortama aktarılarak Kurum bilgi işlem sistemine intikal ettirilir. Kuruma gönderilmesi gereken belgelerden elektronik ortamda gönderilmesine başlanılan belgelerin ayrıca manuel olarak gönderilip gönderilmeyeceği Kurumca belirlenir.'});
CREATE (sec_3885)-[:HAS_PARAGRAPH {order: 0}]->(para_3886);
CREATE (para_3887:Paragraph {id: '2', content: 'Sağlık hizmeti sunucularının incelemeye esas belgeleri;'});
CREATE (sec_3885)-[:HAS_PARAGRAPH {order: 1}]->(para_3887);
CREATE (item_3888:Item {id: 'a', content: 'Ayakta tedaviler için uzmanlık dalı bazında ayrılmış,'});
CREATE (para_3887)-[:HAS_ITEM {order: 0}]->(item_3888);
CREATE (item_3889:Item {id: 'b', content: 'Yatarak tedaviler için uzmanlık dalı bazında ayrılmış,'});
CREATE (para_3887)-[:HAS_ITEM {order: 1}]->(item_3889);
CREATE (item_3888)-[:NEXT_ITEM]->(item_3889);
CREATE (item_3890:Item {id: 'c', content: '5.2.1 numaralı maddede örneklenmeyeceği belirtilen işlemler için her bir işlem başlığı altında ayrılmış olmalıdır.'});
CREATE (para_3887)-[:HAS_ITEM {order: 2}]->(item_3890);
CREATE (item_3889)-[:NEXT_ITEM]->(item_3890);
CREATE (para_3886)-[:NEXT_PARAGRAPH]->(para_3887);
CREATE (para_3891:Paragraph {id: '3', content: 'Kuruma MEDULA hastane sistemi üzerinden elektronik ortamda gönderilen belgeler ayrıca manuel ortamda gönderilmez. (Değişik: RG- 25/08/2022- 31934/ 54-ç md. Yürürlük: 03/09/2022)'});
CREATE (sec_3885)-[:HAS_PARAGRAPH {order: 2}]->(para_3891);
CREATE (para_3887)-[:NEXT_PARAGRAPH]->(para_3891);
CREATE (sec_3892:Subsection {id: '5.3.1.A', title: 'Fatura üst yazısı'});
CREATE (sec_3885)-[:HAS_SUBSECTION {order: 0}]->(sec_3892);
CREATE (para_3893:Paragraph {id: '1', content: 'Fatura üst yazısı, Kurumca elektronik evrak kabulü yapılıncaya kadar sağlık hizmeti sunucusu başhekimliği tarafından onaylanarak Kuruma teslim edilir. Ayrıca Kurumca belirlenen istisnalar nedeni ile manuel olarak gönderilecek faturalara ait fatura üst yazısı da sağlık hizmeti sunucusu başhekimliği tarafından onaylanarak Kuruma teslim edilir. Fatura üst yazısında aşağıda bulunan bilgiler yer alır;'});
CREATE (sec_3892)-[:HAS_PARAGRAPH {order: 0}]->(para_3893);
CREATE (item_3894:Item {id: 'a', content: 'Sağlık hizmeti sunucusunun adı,'});
CREATE (para_3893)-[:HAS_ITEM {order: 0}]->(item_3894);
CREATE (item_3895:Item {id: 'b', content: 'Sağlık hizmeti sunucusunun MEDULA tesis kodu,'});
CREATE (para_3893)-[:HAS_ITEM {order: 1}]->(item_3895);
CREATE (item_3894)-[:NEXT_ITEM]->(item_3895);
CREATE (item_3896:Item {id: 'c', content: 'Sağlık hizmeti sunucusunun adresi,'});
CREATE (para_3893)-[:HAS_ITEM {order: 2}]->(item_3896);
CREATE (item_3895)-[:NEXT_ITEM]->(item_3896);
CREATE (item_3897:Item {id: 'ç', content: 'Fatura dönemi,'});
CREATE (para_3893)-[:HAS_ITEM {order: 3}]->(item_3897);
CREATE (item_3896)-[:NEXT_ITEM]->(item_3897);
CREATE (item_3898:Item {id: 'd', content: 'Hasta sayısı (uzmanlık dalı bazında ve toplam),'});
CREATE (para_3893)-[:HAS_ITEM {order: 4}]->(item_3898);
CREATE (item_3897)-[:NEXT_ITEM]->(item_3898);
CREATE (item_3899:Item {id: 'e', content: 'Fatura tutarı (uzmanlık dalı bazında ve toplam).'});
CREATE (para_3893)-[:HAS_ITEM {order: 5}]->(item_3899);
CREATE (item_3898)-[:NEXT_ITEM]->(item_3899);
CREATE (sec_3900:Subsection {id: '5.3.1.B', title: 'İcmal listesi'});
CREATE (sec_3885)-[:HAS_SUBSECTION {order: 1}]->(sec_3900);
CREATE (para_3901:Paragraph {id: '1', content: 'Kuruma MEDULA hastane sistemi üzerinden elektronik ortamda gönderilen her uzmanlık dalı ve ayrı gönderileceği belirtilen gruplar için ayrı ayrı düzenlenmiş icmal listesinde aşağıdaki bilgiler yer alır. Ayrıca Kurumca belirlenen istisnalar nedeni ile manuel olarak gönderilecek faturaların icmal listesinde de aynı bilgiler bulunur.'});
CREATE (sec_3900)-[:HAS_PARAGRAPH {order: 0}]->(para_3901);
CREATE (item_3902:Item {id: 'a', content: 'Sıra numarası,'});
CREATE (para_3901)-[:HAS_ITEM {order: 0}]->(item_3902);
CREATE (item_3903:Item {id: 'b', content: 'Takip numarası, takip tarihi,'});
CREATE (para_3901)-[:HAS_ITEM {order: 1}]->(item_3903);
CREATE (item_3902)-[:NEXT_ITEM]->(item_3903);
CREATE (item_3904:Item {id: 'c', content: 'T.C. Kimlik Numarası, hasta adı soyadı, (8/3/2012 tarihli ve 6284 sayılı Ailenin Korunması ve Kadına Karşı Şiddetin Önlenmesine Dair Kanun hükümlerine göre hakkında koruyucu tedbir kararı verilen kişiler hariç),'});
CREATE (para_3901)-[:HAS_ITEM {order: 2}]->(item_3904);
CREATE (item_3903)-[:NEXT_ITEM]->(item_3904);
CREATE (item_3905:Item {id: 'ç', content: 'Hasta bazında toplam hizmet tutarı,'});
CREATE (para_3901)-[:HAS_ITEM {order: 3}]->(item_3905);
CREATE (item_3904)-[:NEXT_ITEM]->(item_3905);
CREATE (item_3906:Item {id: 'd', content: 'Listede tüm hastalara verilen hizmet tutar toplamı.'});
CREATE (para_3901)-[:HAS_ITEM {order: 4}]->(item_3906);
CREATE (item_3905)-[:NEXT_ITEM]->(item_3906);
CREATE (sec_3892)-[:NEXT_SUBSECTION]->(sec_3900);
CREATE (sec_3907:Subsection {id: '5.3.1.C', title: 'Hizmet detay belgesi'});
CREATE (sec_3885)-[:HAS_SUBSECTION {order: 2}]->(sec_3907);
CREATE (para_3908:Paragraph {id: '1', content: 'MEDULA sistemini kullanan sağlık (Değişik: RG- 25/08/2022- 31934/ 54-d md. Yürürlük: 03/09/2022) hizmeti sunucuları, tedaviye ait hizmet detay belgesini MEDULA sistemine elektronik olarak kaydeder. Hizmet detay belgesi Kurumun ilgili birimine teslim edilmez. Ancak Kurum tarafından fatura incelemesi dışında başka bir nedenle talep edilmesi halinde, hizmet detay belgesinin dökümü başhekimlikçe onaylanarak teslim edilir. Hizmet detay belgesindeki epikriz bölümü, yatarak tedavilerde ve cerrahi işlemlerin yapıldığı tüm sağlık hizmetlerinde elektronik ortamda ayrıntılı olarak düzenlenmek zorundadır. Kuruma MEDULA hastane sistemi üzerinden elektronik ortamda gönderilen hizmet detay belgesinde aşağıdaki 153 bilgiler yer alır. Ayrıca Kurumca belirlenen istisnalar nedeni ile manuel olarak gönderilen faturalara ait hizmet detay belgesinde de aynı bilgiler bulunur.'});
CREATE (sec_3907)-[:HAS_PARAGRAPH {order: 0}]->(para_3908);
CREATE (item_3909:Item {id: 'a', content: 'Hastanın adı soyadı, telefon numarası, adres bilgileri,'});
CREATE (para_3908)-[:HAS_ITEM {order: 0}]->(item_3909);
CREATE (item_3910:Item {id: 'b', content: 'T.C. Kimlik Numarası,'});
CREATE (para_3908)-[:HAS_ITEM {order: 1}]->(item_3910);
CREATE (item_3909)-[:NEXT_ITEM]->(item_3910);
CREATE (item_3911:Item {id: 'c', content: 'Kapsam türü,'});
CREATE (para_3908)-[:HAS_ITEM {order: 2}]->(item_3911);
CREATE (item_3910)-[:NEXT_ITEM]->(item_3911);
CREATE (item_3912:Item {id: 'ç', content: 'Branş,'});
CREATE (para_3908)-[:HAS_ITEM {order: 3}]->(item_3912);
CREATE (item_3911)-[:NEXT_ITEM]->(item_3912);
CREATE (item_3913:Item {id: 'd', content: 'Provizyon numarası/MEDULA takip numarası,'});
CREATE (para_3908)-[:HAS_ITEM {order: 4}]->(item_3913);
CREATE (item_3912)-[:NEXT_ITEM]->(item_3913);
CREATE (item_3914:Item {id: 'e', content: 'İşlem tarihi,'});
CREATE (para_3908)-[:HAS_ITEM {order: 5}]->(item_3914);
CREATE (item_3913)-[:NEXT_ITEM]->(item_3914);
CREATE (item_3915:Item {id: 'f', content: 'İlgili hekimin bilgileri (hekim adı, soyadı, doktor tescil numarası),'});
CREATE (para_3908)-[:HAS_ITEM {order: 6}]->(item_3915);
CREATE (item_3914)-[:NEXT_ITEM]->(item_3915);
CREATE (item_3916:Item {id: 'g', content: 'Hasta yatış ve çıkış günleri,'});
CREATE (para_3908)-[:HAS_ITEM {order: 7}]->(item_3916);
CREATE (item_3915)-[:NEXT_ITEM]->(item_3916);
CREATE (item_3917:Item {id: 'ğ', content: 'Hastaya konulan tanı, ICD-10 kodu, ICD-O kodu,'});
CREATE (para_3908)-[:HAS_ITEM {order: 8}]->(item_3917);
CREATE (item_3916)-[:NEXT_ITEM]->(item_3917);
CREATE (item_3918:Item {id: 'h', content: 'İşlemlerin (muayene, tetkik, tahlil, yatak, ameliyat, tedavi vb.) tarihi, hizmet türü, SUT kodu, adı, adedi, tutarı,'});
CREATE (para_3908)-[:HAS_ITEM {order: 9}]->(item_3918);
CREATE (item_3917)-[:NEXT_ITEM]->(item_3918);
CREATE (item_3919:Item {id: 'ı', content: 'Tıbbi malzemelerin adları, adetleri, birim fiyatları, SUT kodları, Küresel Ürün Numarası (barkod),'});
CREATE (para_3908)-[:HAS_ITEM {order: 10}]->(item_3919);
CREATE (item_3918)-[:NEXT_ITEM]->(item_3919);
CREATE (item_3920:Item {id: 'i', content: 'Hasta tabelasına uygun olarak tane hesabıyla hastaya verilen ilaçların, kutu bazında değil, tane hesabıyla birim fiyatları ve tutarı (parenteral ilaçlar için hizmet detay belgesinde hastaya verilen dozlar (mg, IU, ml. vb.) belirtilecek ancak fiyat ve tutarlar kutu/adet üzerinden fatura edilecektir.),'});
CREATE (para_3908)-[:HAS_ITEM {order: 11}]->(item_3920);
CREATE (item_3919)-[:NEXT_ITEM]->(item_3920);
CREATE (item_3921:Item {id: 'j', content: 'Kullanılan kan ve kan bileşenleri, miktarları, ünite ve ISBT (Uluslararası Kan Nakli Derneği) numaraları, (Değişik: RG- 25/08/2022- 31934/ 54-d md. Yürürlük: 03/09/2022)'});
CREATE (para_3908)-[:HAS_ITEM {order: 12}]->(item_3921);

// Batch 105
CREATE (item_3920)-[:NEXT_ITEM]->(item_3921);
CREATE (item_3922:Item {id: 'k', content: 'Epikriz notu. (Yoğun bakım, yatarak ve günübirlik hastalarda; günlük progreslerin, tedavi orderların ve kullanılan malzeme bilgilerinin eklenmesi.)'});
CREATE (para_3908)-[:HAS_ITEM {order: 13}]->(item_3922);
CREATE (item_3921)-[:NEXT_ITEM]->(item_3922);
CREATE (sec_3900)-[:NEXT_SUBSECTION]->(sec_3907);
CREATE (sec_3923:Subsection {id: '5.3.1.Ç', title: 'Diğer belgeler'});
CREATE (sec_3885)-[:HAS_SUBSECTION {order: 3}]->(sec_3923);
CREATE (para_3924:Paragraph {id: '1', content: 'MEDULA hastane sistemi üzerinden elektronik ortamda gönderilme sağlanıncaya kadar aşağıdaki incelemeye esas belgeler manuel olarak gönderilir.'});
CREATE (sec_3923)-[:HAS_PARAGRAPH {order: 0}]->(para_3924);
CREATE (item_3925:Item {id: 'a', content: 'MEDULA sisteminden kaynaklanan ve Kurumca kabul edilen nedenlerle müstehaklık sorgulaması yapılamadan işlemleri yürütülen ve daha sonrasında sağlık (Değişik: RG- 25/08/2022- 31934/ 54-e md. Yürürlük: 03/09/2022) hizmeti sunucusunca yapılan sorgulama sonucu müstehak olmadığı tespit edilen kişiler için işlemleri yürütmeye esas belge,'});
CREATE (para_3924)-[:HAS_ITEM {order: 0}]->(item_3925);
CREATE (item_3926:Item {id: 'b', content: 'Sevkle başvuran hastalar için tedavi sevk belgesi (e-sevk hariç),'});
CREATE (para_3924)-[:HAS_ITEM {order: 1}]->(item_3926);
CREATE (item_3925)-[:NEXT_ITEM]->(item_3926);
CREATE (item_3927:Item {id: 'c', content: 'Adli vaka ve iş kazası geçiren kişilere ait faturaların ekinde ilk müdahalenin yapıldığı sağlık hizmeti sunucusu tarafından hastane polisi veya ilgili kolluk kuvvetinden konuyla ilgili sağlanacak belge, tutanak, ifade tutanağı, adli rapor gibi temin edilebilen her türlü belge,'});
CREATE (para_3924)-[:HAS_ITEM {order: 2}]->(item_3927);
CREATE (item_3926)-[:NEXT_ITEM]->(item_3927);
CREATE (item_3928:Item {id: 'ç', content: 'Meslek hastalığı tanısı koymaya yetkili ve ilk tanının konulduğu sağlık hizmeti sunucusu tarafından meslek hastalığı tanısı alan kişilere bu tanıya ait sağlık kurulu raporu,'});
CREATE (para_3924)-[:HAS_ITEM {order: 3}]->(item_3928);
CREATE (item_3927)-[:NEXT_ITEM]->(item_3928);
CREATE (item_3929:Item {id: 'e', content: 'MEDULA sistemine karekod girişleri yapılıncaya kadar, mor ve turuncu reçete  kapsamında bulunan kan ürünlerinin kupürleri,'});
CREATE (para_3924)-[:HAS_ITEM {order: 4}]->(item_3929);
CREATE (item_3928)-[:NEXT_ITEM]->(item_3929);
CREATE (item_3930:Item {id: 'f', content: 'Diş tedavilerinde, belgesindeki diş şeması üzerinde işaretlenir.), vb. işlemlerde MEDULA hastane sisteminde yer alan epikriz alanında belirtilmek üzere açıklayıcı operasyon bilgileri, operasyona ait radyolojik teşhis filmleri, MR ve BT gibi görüntüleme yöntemlerine ait sonuç bilgileri, işlemlerinde, radyolojik teşhis filmleri, kontrol filmleri (dijital, periapikal, panoromik vb. hangisi kullanıldı ise),'});
CREATE (para_3924)-[:HAS_ITEM {order: 5}]->(item_3930);
CREATE (subitem_3931:SubItem {id: '1', content: 'Diş hastalarına yapılan işlemleri gösteren diş şeması (ağız ve diş sağlığı hizmetlerinde tüm işlemler, hizmet detay'});
CREATE (item_3930)-[:HAS_SUBITEM {order: 0}]->(subitem_3931);
CREATE (subitem_3932:SubItem {id: '2', content: 'Ağız ve diş cerrahisi işlemlerinden büyük-küçük kist operasyonları, büyük-küçük odontojenik tümör operasyonları'});
CREATE (item_3930)-[:HAS_SUBITEM {order: 1}]->(subitem_3932);
CREATE (subitem_3931)-[:NEXT_SUBITEM]->(subitem_3932);
CREATE (subitem_3933:SubItem {id: '3', content: 'Gömülü diş çekimi (mukoza-kemik retansiyonlu), gömülü kanin-premolar çekimi, kök ucu rezeksiyonu'});
CREATE (item_3930)-[:HAS_SUBITEM {order: 2}]->(subitem_3933);
CREATE (subitem_3932)-[:NEXT_SUBITEM]->(subitem_3933);
CREATE (subitem_3934:SubItem {id: '4', content: 'Kanal tedavisi, gangren ve periapikal lezyonlu dişlere uygulanan kanal tedavilerinde, radyolojik teşhis ve sonuç'});
CREATE (item_3930)-[:HAS_SUBITEM {order: 3}]->(subitem_3934);
CREATE (subitem_3933)-[:NEXT_SUBITEM]->(subitem_3934);
CREATE (subitem_3935:SubItem {id: '5', content: 'Ortodontik tedavi gereksinimi olan hastalar için düzenlenecek sağlık kurulu raporu (e-rapor hariç),'});
CREATE (item_3930)-[:HAS_SUBITEM {order: 4}]->(subitem_3935);
CREATE (subitem_3934)-[:NEXT_SUBITEM]->(subitem_3935);
CREATE (item_3929)-[:NEXT_ITEM]->(item_3930);
CREATE (item_3936:Item {id: 'g', content: 'SUT ve eki listelerde, Kurumun yapacağı sözleşmelerde ve yayımladığı genelgelerde ayrıca ekleneceği belirtilen belgeler,'});
CREATE (para_3924)-[:HAS_ITEM {order: 6}]->(item_3936);
CREATE (item_3930)-[:NEXT_ITEM]->(item_3936);
CREATE (item_3937:Item {id: 'ğ', content: 'Hemodiyaliz tedavilerinde ilave olarak; tetkikler dahil) gösterir belgeler,'});
CREATE (para_3924)-[:HAS_ITEM {order: 7}]->(item_3937);
CREATE (subitem_3938:SubItem {id: '1', content: 'Tüm tetkiklerin, tetkiki yapan ilgili uzman hekim tarafından onaylanmış sonuçlarını (hizmet alımı ile yaptırılmış'});
CREATE (item_3937)-[:HAS_SUBITEM {order: 0}]->(subitem_3938);
CREATE (subitem_3939:SubItem {id: '2', content: 'Yukarıda yer alan hizmet detay belgesine ek olarak;'});
CREATE (item_3937)-[:HAS_SUBITEM {order: 1}]->(subitem_3939);
CREATE (subitem_3938)-[:NEXT_SUBITEM]->(subitem_3939);
CREATE (item_3936)-[:NEXT_ITEM]->(item_3937);
CREATE (item_3940:Item {id: 'i', content: 'Her seansın tarihi, seansların başlayış ve bitiş saatlerinin, ii) Hastaların hemodiyalize alındığı cihazların seri numaralarının, iii) Hemodiyaliz hemşiresinin T.C. Kimlik Numarasının, iv) Her bir seans sonrasında, alınan tedaviyi takip eden sorumlu uzman hekim ya da sorumlu hekim imzasının yer aldığı belge, hastalar için hasta imzasının ya da parmak izinin (eğer alınamıyorsa adı ve telefon numarası belirtilmek kaydıyla hasta yakınının imzasının) yer aldığı belge/belgeler,'});
CREATE (para_3924)-[:HAS_ITEM {order: 8}]->(item_3940);
CREATE (subitem_3941:SubItem {id: '3', content: 'Her seans için biyometrik kimlik doğrulaması yapılması zorunlu olup biyometrik kimlik doğrulaması yapılamayan'});
CREATE (item_3940)-[:HAS_SUBITEM {order: 0}]->(subitem_3941);
CREATE (item_3937)-[:NEXT_ITEM]->(item_3940);
CREATE (item_3942:Item {id: 'h', content: 'Ayaktan veya yatarak yapılan hiperbarik oksijen tedavilerinde ilave olarak;'});
CREATE (para_3924)-[:HAS_ITEM {order: 9}]->(item_3942);
CREATE (subitem_3943:SubItem {id: '1', content: 'Yukarıda yer alan hizmet detay belgesine ek olarak;'});
CREATE (item_3942)-[:HAS_SUBITEM {order: 0}]->(subitem_3943);
CREATE (item_3940)-[:NEXT_ITEM]->(item_3942);
CREATE (item_3944:Item {id: 'i', content: 'Her seansın tarihi, seansların başlayış ve bitiş saatlerinin, ii) Her bir seans sonrasında, alınan tedaviyi takip eden sorumlu uzman hekim ya da sorumlu hekim imzasının yer aldığı belge, 154 hastalar için hasta imzasının ya da parmak izinin (eğer alınamıyorsa adı ve telefon numarası belirtilmek kaydıyla hasta yakınının imzasının) yer aldığı belge/belgeler,'});
CREATE (para_3924)-[:HAS_ITEM {order: 10}]->(item_3944);
CREATE (subitem_3945:SubItem {id: '2', content: 'Her seans için biyometrik kimlik doğrulaması yapılması zorunlu olup biyometrik kimlik doğrulaması yapılamayan'});
CREATE (item_3944)-[:HAS_SUBITEM {order: 0}]->(subitem_3945);
CREATE (item_3942)-[:NEXT_ITEM]->(item_3944);
CREATE (item_3946:Item {id: 'ı', content: 'Ayaktan veya yatarak yapılan fizik tedavi ve rehabilitasyon ve ESWT tedavilerinde ilave olarak;'});
CREATE (para_3924)-[:HAS_ITEM {order: 11}]->(item_3946);
CREATE (subitem_3947:SubItem {id: '1', content: 'Yukarıda yer alan hizmet detay belgesine ek olarak;'});
CREATE (item_3946)-[:HAS_SUBITEM {order: 0}]->(subitem_3947);
CREATE (item_3944)-[:NEXT_ITEM]->(item_3946);
CREATE (item_3948:Item {id: 'i', content: 'Her seansın tarihi, seansların başlayış ve bitiş saatlerinin, ii) Tedaviyi uygulayan terapist/teknikerin T.C. Kimlik Numarası, iii) Her bir seans sonrasında, alınan tedaviyi takip eden sorumlu uzman hekim  imzasının yer aldığı belge, hastalar için hasta imzasının ya da parmak izinin (eğer alınamıyorsa adı ve telefon numarası belirtilmek kaydıyla hasta yakınının imzasının) yer aldığı belge/belgeler,'});
CREATE (para_3924)-[:HAS_ITEM {order: 12}]->(item_3948);
CREATE (subitem_3949:SubItem {id: '2', content: 'Her seans için biyometrik kimlik doğrulaması yapılması zorunlu olup biyometrik kimlik doğrulaması yapılamayan'});
CREATE (item_3948)-[:HAS_SUBITEM {order: 0}]->(subitem_3949);
CREATE (item_3946)-[:NEXT_ITEM]->(item_3948);
CREATE (item_3950:Item {id: 'i', content: 'Provizyon alınamadan vefat eden hastalara ait faturalar ve takip numarası alınmamış vefat eden hastalar için Kurumdan alınan tedavi tarihlerinde müstehak olduklarını belirten belge ve ölüm belgesi.'});
CREATE (para_3924)-[:HAS_ITEM {order: 13}]->(item_3950);
CREATE (item_3948)-[:NEXT_ITEM]->(item_3950);

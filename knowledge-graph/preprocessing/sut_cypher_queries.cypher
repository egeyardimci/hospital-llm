CREATE (sec_1221)-[:HAS_SUBSECTION {order: 16}]->(sec_1498);
CREATE (para_1499:Paragraph {id: '1', content: 'Transbronşiyal iğne aspirasyonu iğnesi;'});
CREATE (sec_1498)-[:HAS_PARAGRAPH {order: 0}]->(para_1499);

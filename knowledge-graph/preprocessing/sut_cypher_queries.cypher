CREATE (amend_2072:Amendment {content: '(Ek: RG- 30/08/2014- 29104/ 11 md. Yürürlük: 06/09/2014)'});
CREATE (sec_2061)-[:HAS_AMENDMENT {order: 3}]->(amend_2072);
CREATE (sec_2059)-[:NEXT_SUBSECTION]->(sec_2061);
CREATE (sec_2073:Subsection {id: '4.2.6', title: 'Büyüme bozuklukları'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 5}]->(sec_2073);
CREATE (sec_2074:Subsection {id: '4.2.6.A', title: 'Büyüme hormonu bozuklukları'});
CREATE (sec_2073)-[:HAS_SUBSECTION {order: 0}]->(sec_2074);
CREATE (para_2075:Paragraph {id: '1', content: 'Hastanın yaş grubuna göre endokrinoloji uzman hekiminin yer aldığı sağlık kurulu raporu ile bu hekimlerce reçete edilmesi halinde bedeli ödenir. Bu raporda, ilacın kullanım dozu, uygulama planı ve süresi de belirtilir. Rapor, en fazla 1 yıl süreyle geçerli olup hastanın yaşı ve fiziki boy uzunluğu bu rapora yazılacaktır.'});
CREATE (sec_2074)-[:HAS_PARAGRAPH {order: 0}]->(para_2075);
CREATE (para_2076:Paragraph {id: '2', content: 'İlaçların günlük doz miktarı belirtilmek suretiyle en fazla üçer aylık dozlar halinde reçete edilebilir. (Değişik: RG- 09/05/2024- 32541/7-a md. Yürürlük: 17/05/2024)'});
CREATE (sec_2074)-[:HAS_PARAGRAPH {order: 1}]->(para_2076);
CREATE (para_2075)-[:NEXT_PARAGRAPH]->(para_2076);
CREATE (amend_2077:Amendment {content: '(Değişik: RG-16/06/2020-31157/2 md. Yürürlük: 24/06/2020)'});
CREATE (sec_2074)-[:HAS_AMENDMENT {order: 0}]->(amend_2077);
CREATE (sec_2078:Subsection {id: '4.2.6.A-1', title: 'Çocuklarda somatropin ve somatrogon kullanım ilkeleri;'});
CREATE (sec_2074)-[:HAS_SUBSECTION {order: 0}]->(sec_2078);
CREATE (para_2079:Paragraph {id: '1', content: 'Tedaviye başlanabilmesi için hastanın çocuk endokrinolojisi veya çocuk endokrinolojisi ve metabolizma hastalıkları uzman hekimi tarafından en az 6 ay süreyle büyüme hızı izlendikten sonra; büyümeyi etkileyen sistematik bir hastalığı (Mülga:RG- 09/05/2024- 32541/7-b md. Yürürlük: 17/05/2024) olmayan, boy sapması -2,0 standart sapmadan 83 (SD) küçük ve yıllık büyüme hızı ve kemik yaşı için aşağıda yer verilen kriterleri birlikte karşılayan hastalarda çocuk endokrinolojisi veya çocuk endokrinolojisi ve metabolizma hastalıkları uzman hekimlerinden en az birinin bulunduğu 1 yıl süreli sağlık kurulu raporu ile büyüme hormonu tedavisine başlanması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_2078)-[:HAS_PARAGRAPH {order: 0}]->(para_2079);
CREATE (item_2080:Item {id: 'a', content: 'Yıllık büyüme hızı; endokrinolojisi ve metabolizma hastalıkları uzman hekimince değerlendirilmesi,'});
CREATE (para_2079)-[:HAS_ITEM {order: 0}]->(item_2080);
CREATE (subitem_2081:SubItem {id: '1', content: '0-2 yaş aralığında 10 cm’nin altında,'});
CREATE (item_2080)-[:HAS_SUBITEM {order: 0}]->(subitem_2081);
CREATE (subitem_2082:SubItem {id: '2', content: '2,1-4 yaş aralığında 7 cm’nin altında,'});
CREATE (item_2080)-[:HAS_SUBITEM {order: 1}]->(subitem_2082);
CREATE (subitem_2081)-[:NEXT_SUBITEM]->(subitem_2082);
CREATE (subitem_2083:SubItem {id: '3', content: '4,1 yaş-ergenlik döneminde 5 cm’nin altında,'});
CREATE (item_2080)-[:HAS_SUBITEM {order: 2}]->(subitem_2083);
CREATE (subitem_2082)-[:NEXT_SUBITEM]->(subitem_2083);
CREATE (subitem_2084:SubItem {id: '4', content: 'Puberte’de; izleme süresi ve büyüme hızı hastanın diğer bulgularına göre çocuk endokrinolojisi veya çocuk'});
CREATE (item_2080)-[:HAS_SUBITEM {order: 3}]->(subitem_2084);
CREATE (subitem_2083)-[:NEXT_SUBITEM]->(subitem_2084);
CREATE (item_2085:Item {id: 'b', content: 'Kemik yaşı; ml ve üzerine çıkması, kızlarda T2 düzeyinde telarşın olması pubertenin başlangıcı olarak kabul edilecektir.)'});
CREATE (para_2079)-[:HAS_ITEM {order: 1}]->(item_2085);
CREATE (subitem_2086:SubItem {id: '1', content: '4 yaş öncesi veya puberte döneminde kemik yaşı geriliği dikkate alınmayacaktır.'});
CREATE (item_2085)-[:HAS_SUBITEM {order: 0}]->(subitem_2086);
CREATE (subitem_2087:SubItem {id: '2', content: '4 yaş ve puberte arası kronolojik yaşa göre en az 2 yıl geri olması,'});
CREATE (item_2085)-[:HAS_SUBITEM {order: 1}]->(subitem_2087);
CREATE (subitem_2086)-[:NEXT_SUBITEM]->(subitem_2087);
CREATE (subitem_2088:SubItem {id: '3', content: 'Pubertal dönem için sadece epifizlerin açık olması, (Puberte kıstasları: erkeklerde gonadarj (testis hacimlerinin) 4'});
CREATE (item_2085)-[:HAS_SUBITEM {order: 2}]->(subitem_2088);
CREATE (subitem_2087)-[:NEXT_SUBITEM]->(subitem_2088);
CREATE (item_2080)-[:NEXT_ITEM]->(item_2085);
CREATE (item_2089:Item {id: 'c', content: 'Ötiroid hastalarda uygulanan büyüme hormonu uyarı testlerinden en az ikisine (laboratuvarın kriterlerine göre) yetersiz yanıt alınarak izole büyüme hormonu eksikliği veya büyüme hormonunun diğer hipofiz hormonlarının eksikliği ile birlikte olması (hipopituitarizm),'});
CREATE (para_2079)-[:HAS_ITEM {order: 2}]->(item_2089);
CREATE (item_2085)-[:NEXT_ITEM]->(item_2089);
CREATE (item_2090:Item {id: 'ç', content: 'Boy sapması patolojik olan <-2 SD ve yıllık uzama hızı yetersiz kalan, kemik yaşı takvim yaşına göre 2 yıldan daha fazla geri olan (4 yaş altı veya puberte dönemi hariç), ancak yapılan 2 büyüme hormonu uyarı testine yeterli yanıt alınan hastalara uyku esnasında büyüme hormonu profili çıkartılmalı ve hastada büyüme hormonu eksikliği olmamasına rağmen eğer büyüme hormonu salınımında bir bozukluk söz konusu ise, yani nörosekretuar disfonksiyon söz konusu ise ya da hastanın test öncesi bakılan serum IGF-1 düzeyi <-2 SD olması koşuluyla yapılacak olan IGF-1 jenerasyon testi ile hastada biyoinaktif büyüme hormonu saptanmış olması (Ek:RG- 09/05/2024- 32541/7-c md. Yürürlük: 17/05/2024) (Yalnızca somatropin etkin maddeli ilaçlar kullanılabilir.),'});
CREATE (para_2079)-[:HAS_ITEM {order: 3}]->(item_2090);
CREATE (item_2089)-[:NEXT_ITEM]->(item_2090);
CREATE (item_2091:Item {id: 'd', content: 'Epifizlerin açık olması dışında başkaca şartlar aranmaksızın; moleküler genetik testlerle hipotalamo-hipofiz gelişim defekti gösterilmiş organik büyüme hormonu eksikliği veya hipotalamo-hipofiz aksını/hipofiz bölgesini etkileyen intrakraniyal cerrahilere bağlı büyüme hormonu eksikliği tespit edilmesi,'});
CREATE (para_2079)-[:HAS_ITEM {order: 4}]->(item_2091);
CREATE (item_2090)-[:NEXT_ITEM]->(item_2091);
CREATE (item_2092:Item {id: 'e', content: 'Bu bendin uygulanmasında başkaca şart aranmaksızın aşağıdaki hallerde (Ek:RG- 09/05/2024- 32541/7-c md. Yürürlük: 17/05/2024) (Yalnızca somatropin etkin maddeli ilaçlar kullanılabilir.); büyümeyi yakalayamamış (son yıl süresince uzama hızı standard sapması <0) olması, babaya uyarlanmış standart sapması <-1 olması,'});
CREATE (para_2079)-[:HAS_ITEM {order: 5}]->(item_2092);
CREATE (subitem_2093:SubItem {id: '1', content: 'Gestasyonel yaşa göre doğum ağırlığı ve/veya boy uzunluğu standart sapması <-2 doğmuş olup 4 yaş ve üzerinde'});
CREATE (item_2092)-[:HAS_SUBITEM {order: 0}]->(subitem_2093);
CREATE (subitem_2094:SubItem {id: '2', content: 'Gestasyonel yaşa göre küçük doğmuş kısa boylu çocuklarda mevcut uzunluk standart sapması <-2,5 ve anne-'});
CREATE (item_2092)-[:HAS_SUBITEM {order: 1}]->(subitem_2094);
CREATE (subitem_2093)-[:NEXT_SUBITEM]->(subitem_2094);
CREATE (item_2091)-[:NEXT_ITEM]->(item_2092);
CREATE (para_2095:Paragraph {id: '2', content: 'Büyüme hormonu ile tedavisine başlanmış hastalarda epifiz hatlarının açık olması tedavinin devamı için yeterli olup kemik yaşı geriliği şartı aranmaz. Bu hususlar yeni düzenlenecek 1 yıl süreli sağlık kurulu raporunda belirtilir.'});
CREATE (sec_2078)-[:HAS_PARAGRAPH {order: 1}]->(para_2095);
CREATE (para_2079)-[:NEXT_PARAGRAPH]->(para_2095);
CREATE (para_2096:Paragraph {id: '3', content: 'Tedaviler aşağıda yer alan kriterlerin herhangi birinin varlığında sonlandırılır.'});
CREATE (sec_2078)-[:HAS_PARAGRAPH {order: 2}]->(para_2096);
CREATE (item_2097:Item {id: 'a', content: 'Epifiz hattı kapandığında,'});
CREATE (para_2096)-[:HAS_ITEM {order: 0}]->(item_2097);
CREATE (item_2098:Item {id: 'b', content: 'Yıllık büyüme hızı 4 cm ve altında olduğunda,'});
CREATE (para_2096)-[:HAS_ITEM {order: 1}]->(item_2098);
CREATE (item_2097)-[:NEXT_ITEM]->(item_2098);
CREATE (item_2099:Item {id: 'c', content: 'Boy uzunluğu kızlarda 157 cm’ye erkeklerde 168 cm’ye ulaştığında, (Mülga: RG- 09/05/2024- 32541/7-b md. Yürürlük: 17/05/2024) (Değişik: RG- 09/05/2024- 32541/7-ç md. Yürürlük: 17/05/2024)'});
CREATE (para_2096)-[:HAS_ITEM {order: 2}]->(item_2099);
CREATE (item_2098)-[:NEXT_ITEM]->(item_2099);
CREATE (para_2095)-[:NEXT_PARAGRAPH]->(para_2096);
CREATE (sec_2100:Subsection {id: '4.2.6.A-2', title: 'Erişkinlerde somatropin kullanım ilkeleri;'});
CREATE (sec_2074)-[:HAS_SUBSECTION {order: 1}]->(sec_2100);
CREATE (para_2101:Paragraph {id: '1', content: 'Epifiz hatları açık olan erişkin yaştaki hastaların büyüme hormonu kullanım esasları, çocuk yaş grubu ile aynıdır.'});
CREATE (sec_2100)-[:HAS_PARAGRAPH {order: 0}]->(para_2101);
CREATE (para_2102:Paragraph {id: '2', content: 'Epifiz hatları kapalı olan hastalarda:'});
CREATE (sec_2100)-[:HAS_PARAGRAPH {order: 1}]->(para_2102);
CREATE (item_2103:Item {id: 'a', content: 'Çocukluk yaş grubunda büyüme hormonu eksikliği tanısı konulup, büyüme hormonu tedavisi verilen ve epifizleri kapandığı için tedavisi kesilen hastalarda tekrarlanan iki adet büyüme hormonu uyarı testine yetersiz yanıt alınmışsa (kontrendikasyon yoksa testlerden biri insülin tolerans testi olarak tercih edilmelidir) erişkin dozda büyüme hormonu tedavisi başlanabilir.'});
CREATE (para_2102)-[:HAS_ITEM {order: 0}]->(item_2103);
CREATE (item_2104:Item {id: 'b', content: 'Erişkin yaş grubunda hipotalamohipofizer hastalıklara bağlı büyüme hormonu eksikliği düşünülen hastalarda, 2 adet büyüme hormonu uyarı testine yetersiz yanıt alınmışsa (kontrendikasyon yoksa testlerden biri insülin tolerans testi olarak tercih edilmelidir) erişkin dozda büyüme hormonu tedavisi başlanabilir.'});
CREATE (para_2102)-[:HAS_ITEM {order: 1}]->(item_2104);
CREATE (item_2103)-[:NEXT_ITEM]->(item_2104);
CREATE (para_2101)-[:NEXT_PARAGRAPH]->(para_2102);
CREATE (para_2105:Paragraph {id: '3', content: 'Hipofiz hormonlarından (prolaktin ve büyüme hormonu dışında) bir veya daha fazla ek ön hipofiz hormonu eksikliği varsa, bir adet büyüme hormonu uyarı testi (kontrendikasyon yoksa insülin tolerans testi tercih edilmelidir) tanı için yeterlidir.'});
CREATE (sec_2100)-[:HAS_PARAGRAPH {order: 2}]->(para_2105);
CREATE (para_2102)-[:NEXT_PARAGRAPH]->(para_2105);
CREATE (para_2106:Paragraph {id: '4', content: 'İnsülin tolerans testine göre büyüme hormonu eksikliği tanısı için pik büyüme hormonu cevabının 3mcg/L’den küçük olduğunun raporda belirtilmesi gereklidir.'});
CREATE (sec_2100)-[:HAS_PARAGRAPH {order: 3}]->(para_2106);
CREATE (para_2105)-[:NEXT_PARAGRAPH]->(para_2106);

// Batch 57
CREATE (para_2107:Paragraph {id: '5', content: 'Büyüme hormonu, büyüme hormonu tedavisine karar verilen hastalara erişkin endokrinoloji uzman hekiminin yer aldığı sağlık kurulu raporuna dayanılarak erişkin endokrinoloji veya iç hastalıkları uzman hekimleri tarafından reçete edildiğinde bedeli ödenecektir. Rapora tedavi şeması ile ilgili ayrıntılı bilgi yazılacaktır. Bu rapor en fazla 1 yıl süreyle geçerli olacaktır. (Değişik: RG- 09/05/2024- 32541/7-d md. Yürürlük: 17/05/2024)'});
CREATE (sec_2100)-[:HAS_PARAGRAPH {order: 4}]->(para_2107);
CREATE (para_2106)-[:NEXT_PARAGRAPH]->(para_2107);
CREATE (amend_2108:Amendment {content: '(Ek:RG-21/03/2018-30367/ 17 md. Yürürlük: 01/04/2018)'});
CREATE (sec_2100)-[:HAS_AMENDMENT {order: 0}]->(amend_2108);
CREATE (sec_2078)-[:NEXT_SUBSECTION]->(sec_2100);
CREATE (sec_2109:Subsection {id: '4.2.6.A-3', title: 'Turner sendromunda somatropin kullanım ilkeleri;'});
CREATE (sec_2074)-[:HAS_SUBSECTION {order: 2}]->(sec_2109);
CREATE (para_2110:Paragraph {id: '1', content: 'Epifiz hatları açık olan, klinik ve genetik olarak turner sendromu tanısı almış hastalarda, en az bir çocuk endokrinoloji uzman hekiminin yer aldığı sağlık kurulu raporu ile çocuk endokrinoloji uzman hekimince reçete edilmesi halinde büyüme hormonu bedelleri Kurumca karşılanır. Rapor en fazla 1 yıl süreyle geçerli olup, raporda ilacın kullanım dozu, uygulama planı, süresi ve başlama kriterleri belirtilir. 84'});
CREATE (sec_2109)-[:HAS_PARAGRAPH {order: 0}]->(para_2110);
CREATE (para_2111:Paragraph {id: '2', content: 'Aşağıdaki kriterlerin herhangi biri sağlandığında tedavi sonlandırılır:'});
CREATE (sec_2109)-[:HAS_PARAGRAPH {order: 1}]->(para_2111);
CREATE (item_2112:Item {id: 'a', content: 'Epifiz hattı kapandığında.'});
CREATE (para_2111)-[:HAS_ITEM {order: 0}]->(item_2112);
CREATE (item_2113:Item {id: 'b', content: 'Yıllık büyüme hızı 4 cm. ve altında olduğunda.'});
CREATE (para_2111)-[:HAS_ITEM {order: 1}]->(item_2113);
CREATE (item_2112)-[:NEXT_ITEM]->(item_2113);
CREATE (item_2114:Item {id: 'c', content: 'Boy uzunluğu 155 cm.’ ye ulaştığında.'});
CREATE (para_2111)-[:HAS_ITEM {order: 2}]->(item_2114);
CREATE (item_2113)-[:NEXT_ITEM]->(item_2114);
CREATE (item_2115:Item {id: 'ç', content: 'Kemik yaşı 14’ e ulaştığında. (Değişik: RG- 09/05/2024- 32541/7-e md. Yürürlük: 17/05/2024)'});
CREATE (para_2111)-[:HAS_ITEM {order: 3}]->(item_2115);
CREATE (item_2114)-[:NEXT_ITEM]->(item_2115);
CREATE (para_2110)-[:NEXT_PARAGRAPH]->(para_2111);
CREATE (amend_2116:Amendment {content: '(Ek:RG-26/10/2021-31640/ 3 md. Yürürlük: 04/11/2021)'});
CREATE (sec_2109)-[:HAS_AMENDMENT {order: 0}]->(amend_2116);
CREATE (sec_2100)-[:NEXT_SUBSECTION]->(sec_2109);
CREATE (sec_2117:Subsection {id: '4.2.6.A-4', title: 'Çocuklarda Prader-Willi Sendromunda (PWS) somatropin kullanım ilkeleri;'});
CREATE (sec_2074)-[:HAS_SUBSECTION {order: 3}]->(sec_2117);
CREATE (para_2118:Paragraph {id: '1', content: 'Genetik olarak Prader-Willi sendromu tanısı almış epifiz hatları açık olan çocuklarda büyüme hormonu uyarı testi yapılması koşulu aranmaksızın aşağıdaki durumlarda büyüme hormonu tedavisine başlanması halinde bedelleri Kurumca karşılanır:'});
CREATE (sec_2117)-[:HAS_PARAGRAPH {order: 0}]->(para_2118);
CREATE (item_2119:Item {id: 'a', content: 'Serum IGF1 düzeyinin +2 SD altında olması ve'});
CREATE (para_2118)-[:HAS_ITEM {order: 0}]->(item_2119);
CREATE (item_2120:Item {id: 'b', content: 'Şiddetli obezite (ideal ağırlığının %225 üzerinde olması), kontrol edilemeyen diyabet, tedavi edilemeyen obstrüktif uyku apnesi, aktif kanser, aktif psikozu olmaması.'});
CREATE (para_2118)-[:HAS_ITEM {order: 1}]->(item_2120);
CREATE (item_2119)-[:NEXT_ITEM]->(item_2120);
CREATE (para_2121:Paragraph {id: '2', content: 'Üçüncü basamak hastanelerde en az bir çocuk endokrinoloji uzman hekiminin yer aldığı 3 ay süreli sağlık kurulu raporu ile çocuk endokrinoloji uzman hekimince reçete edilmesi halinde büyüme hormonu bedelleri Kurumca karşılanır. Tedavinin devamında raporlar 6 ay süreli düzenlenir.'});
CREATE (sec_2117)-[:HAS_PARAGRAPH {order: 1}]->(para_2121);
CREATE (para_2118)-[:NEXT_PARAGRAPH]->(para_2121);
CREATE (para_2122:Paragraph {id: '3', content: 'Büyüme hormonu infant ve çocuklarda 0,5 mg/m²/gün dozunda başlanır. Klinik cevaba göre ve serum IGF1 düzeyi fizyolojik düzeylerde kalmak şartıyla 3-6 ayda bir 1 mg/ m²/gün dozuna geçilebilir.'});
CREATE (sec_2117)-[:HAS_PARAGRAPH {order: 2}]->(para_2122);
CREATE (para_2121)-[:NEXT_PARAGRAPH]->(para_2122);
CREATE (para_2123:Paragraph {id: '4', content: 'Serum IGF1 düzeyi +2 SD üzerine çıktığında tedaviye ara verilir. Serum IGF1 düzeyi +2 SD altına düştüğünde tedaviye yukarıdaki koşullarda yeniden başlanabilir. Solunum yolu enfeksiyonlarında iyileşme sağlanıncaya kadar tedavi başlanmaz.'});
CREATE (sec_2117)-[:HAS_PARAGRAPH {order: 3}]->(para_2123);
CREATE (para_2122)-[:NEXT_PARAGRAPH]->(para_2123);
CREATE (para_2124:Paragraph {id: '5', content: 'Kontrol edilemeyen diyabet, tedavi edilemeyen obstrüktif uyku apnesi, aktif kanser, aktif psikoz, progresyon gösteren skolyoz durumlarında tedavi kesilir.'});
CREATE (sec_2117)-[:HAS_PARAGRAPH {order: 4}]->(para_2124);
CREATE (para_2123)-[:NEXT_PARAGRAPH]->(para_2124);
CREATE (para_2125:Paragraph {id: '6', content: 'Epifiz hatları kapandığında tedavi sonlandırılır. (Değişik: RG- 09/05/2024- 32541/7-f md. Yürürlük: 17/05/2024)'});
CREATE (sec_2117)-[:HAS_PARAGRAPH {order: 5}]->(para_2125);
CREATE (para_2124)-[:NEXT_PARAGRAPH]->(para_2125);
CREATE (sec_2109)-[:NEXT_SUBSECTION]->(sec_2117);
CREATE (sec_2126:Subsection {id: '4.2.6.A-5', title: 'Çocuklarda Kronik Böbrek Yetmezliği (KBY) ile ilişkili büyüme bozukluklarında somatropin', content: 'kullanım ilkeleri;'});
CREATE (sec_2074)-[:HAS_SUBSECTION {order: 4}]->(sec_2126);
CREATE (para_2127:Paragraph {id: '1', content: 'KBY evresi evre III, IV, V olan veya 6 aydan fazla süredir diyalizde olan, epifiz hatları açık olan, paratiroid hormonu 500 pikogram(pg)/ml altında olan çocuk hastalarda; malnutrisyonu, metabolik asidozu, sıvı elektrolit dengesizliği, anemisi olmaması ve aşağıdaki koşulların sağlanması durumunda büyüme hormonu tedavisine başlanması halinde bedelleri Kurumca karşılanır:'});
CREATE (sec_2126)-[:HAS_PARAGRAPH {order: 0}]->(para_2127);
CREATE (item_2128:Item {id: 'a', content: 'Persistan büyüme geriliği olması (boyun yaş ve cinsiyete göre 3 persentilin altında (-2 SD altında) ve yıllık büyüme hızının 25 persentilin altında olması) veya'});
CREATE (para_2127)-[:HAS_ITEM {order: 0}]->(item_2128);
CREATE (item_2129:Item {id: 'b', content: 'Böbrek naklinden 1 yıl sonra steroid tedavisi almaksızın spontan büyümenin olmaması (boyun yaş ve cinsiyete göre 3 persentilin altında (-2 SD altında) ve yıllık büyüme hızının 25 persentilin altında olması) veya'});
CREATE (para_2127)-[:HAS_ITEM {order: 1}]->(item_2129);
CREATE (item_2128)-[:NEXT_ITEM]->(item_2129);
CREATE (item_2130:Item {id: 'c', content: 'Nefropatik sistinozise bağlı KBY hastası çocuklarda boyun yaş ve cinsiyete göre 3 persentilin altında (-2 SD altında) ve yıllık büyüme hızının 25 persentilin altında olması halinde büyüme hormonu tedavisine başlanabilir.'});
CREATE (para_2127)-[:HAS_ITEM {order: 2}]->(item_2130);
CREATE (item_2129)-[:NEXT_ITEM]->(item_2130);
CREATE (para_2131:Paragraph {id: '2', content: 'Epifiz hatları kapalı olanlara, persistan ağır sekonder hiperparatiroidizmi olanlara (Paratiroid hormonun 500 pikogram(pg)/ml ve üzerinde olması), proliferatif veya şiddetli nonproliferatif diyabetik retinopatisi olanlara, renal transplantasyonun ilk 1 yıl içerisindeki hastalara veya aktif kanserlilere tedavi başlanmaz.'});
CREATE (sec_2126)-[:HAS_PARAGRAPH {order: 1}]->(para_2131);
CREATE (para_2127)-[:NEXT_PARAGRAPH]->(para_2131);
CREATE (para_2132:Paragraph {id: '3', content: 'Tedavi dozu 0,045-0,05 mg/kg/gündür.'});
CREATE (sec_2126)-[:HAS_PARAGRAPH {order: 2}]->(para_2132);
CREATE (para_2131)-[:NEXT_PARAGRAPH]->(para_2132);
CREATE (para_2133:Paragraph {id: '4', content: 'Üçüncü basamak hastanelerde en az bir çocuk nefroloji ve çocuk endokrinoloji uzman hekiminin yer aldığı 6 ay süreli sağlık kurulu raporu ile çocuk endokrinoloji uzman hekimince reçete edilir.'});
CREATE (sec_2126)-[:HAS_PARAGRAPH {order: 3}]->(para_2133);
CREATE (para_2132)-[:NEXT_PARAGRAPH]->(para_2133);
CREATE (para_2134:Paragraph {id: '5', content: 'Epifiz hatları kapandığında, böbrek nakli sırasında, persistan ağır sekonder hiperparatiroidizmde (Paratiroid hormonun 500 pikogram(pg)/ml ve üzerinde olması), intrakraniyal hipertansiyonda, femoral epifiz başının kaydığı durumlarda, en az 6 aylık büyüme hormonu tedavisine rağmen yeterli yanıt alınamaması durumunda (yılda 2 cm ve üzeri büyüme olmaması), kemik maturasyonunun hızlandığı durumlarda veya tahmini GFR’de açıklanamayan azalma durumunda tedavi sonlandırılır.'});
CREATE (sec_2126)-[:HAS_PARAGRAPH {order: 4}]->(para_2134);
CREATE (para_2133)-[:NEXT_PARAGRAPH]->(para_2134);
CREATE (sec_2117)-[:NEXT_SUBSECTION]->(sec_2126);
CREATE (sec_2135:Subsection {id: '4.2.6.B', title: 'Laron Sendromu tanı kriterleri ve rhIGF-I (mecasermin) kullanım ilkeleri'});
CREATE (sec_2073)-[:HAS_SUBSECTION {order: 1}]->(sec_2135);
CREATE (para_2136:Paragraph {id: '1', content: 'En az bir  çocuk endokrinolojisi ve metabolizma hastalıkları veya çocuk endokrinoloji uzman hekiminin yer aldığı sağlık kurulu raporu ile  çocuk endokrinolojisi ve metabolizma hastalıkları veya çocuk endokrinoloji uzman hekimince reçete edilmesi halinde bedeli ödenir. Bu raporda, ilacın kullanım dozu, uygulama planı, süresi ve başlama kriterleri belirtilir.'});
CREATE (sec_2135)-[:HAS_PARAGRAPH {order: 0}]->(para_2136);
CREATE (amend_2137:Amendment {content: '(Ek:RG-09/09/2017- 30175/ 17 md. Yürürlük: 23/09/2017)'});
CREATE (sec_2135)-[:HAS_AMENDMENT {order: 0}]->(amend_2137);
CREATE (amend_2138:Amendment {content: '(Ek:RG-09/09/2017- 30175/ 17 md. \nYürürlük: 23/09/2017)'});
CREATE (sec_2135)-[:HAS_AMENDMENT {order: 1}]->(amend_2138);
CREATE (sec_2139:Subsection {id: '4.2.6.B-1', title: 'Başlama kriterleri'});
CREATE (sec_2135)-[:HAS_SUBSECTION {order: 0}]->(sec_2139);
CREATE (para_2140:Paragraph {id: '1', content: 'İlgili uzman hekim tarafından en az 6 ay süreyle büyüme hızı izlendikten sonra büyümeyi etkileyen sistemik bir hastalığı veya beslenme bozukluğu olmadığı tespit edilen hastalarda; boy (-3) standart sapmanın altında, yıllık büyüme hızı yaş ve cinse göre 25 persentilin altında, serum IGF-I düzeyi < -2 SD, serum IGFBP-3 düzeyi < -1 SD, bazal veya uyarılmış büyüme hormonu düzeyi > 10 mcg/L, somatomedin jenerasyon testinde büyüme hormonu uyarısına IGF-I artışının yetersiz olduğu durumlarda tedaviye başlanılır.'});
CREATE (sec_2139)-[:HAS_PARAGRAPH {order: 0}]->(para_2140);
CREATE (para_2141:Paragraph {id: '2', content: 'Başlangıç dozu 120 mcg/kg/gün’e kadar çıkılabilir.'});
CREATE (sec_2139)-[:HAS_PARAGRAPH {order: 1}]->(para_2141);
CREATE (para_2140)-[:NEXT_PARAGRAPH]->(para_2141);
CREATE (para_2142:Paragraph {id: '3', content: 'Büyüme hormonu tedavisinin yerine kullanılmaz.'});
CREATE (sec_2139)-[:HAS_PARAGRAPH {order: 2}]->(para_2142);
CREATE (para_2141)-[:NEXT_PARAGRAPH]->(para_2142);
CREATE (sec_2143:Subsection {id: '4.2.6.B-2', title: 'Devam kriterleri'});
CREATE (sec_2135)-[:HAS_SUBSECTION {order: 1}]->(sec_2143);
CREATE (para_2144:Paragraph {id: '1', content: 'Tedavi alan hastalar en az 3 aylık sürelerle izlenerek, radyolojik olarak epifiz hatlarının açık olduğunun reçetede belirtilmesi kaydıyla hedeflenen yaş grubu ortalama boy skalasına göre 25 persentile ulaşana kadar, tedavi ile yıllık büyüme hızının izlemde tedavi öncesi yıllık büyüme hızının 2 cm üstünde olan hastalarda yılda bir sağlık kurulu raporu yenilenerek tedavi devam ettirilir. 85'});
CREATE (sec_2143)-[:HAS_PARAGRAPH {order: 0}]->(para_2144);
CREATE (para_2145:Paragraph {id: '2', content: 'Yenilenen raporlarda tedavi öncesi ve tedaviyle sağlanan büyüme hızı, ulaştığı boy skalası ve epifiz hatlarının durumu belirtilir.'});

// Batch 58
CREATE (sec_2143)-[:HAS_PARAGRAPH {order: 1}]->(para_2145);
CREATE (para_2144)-[:NEXT_PARAGRAPH]->(para_2145);

CREATE (sec_3657:Subsection {id: '4.2.66', title: 'Gonadotropin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 65}]->(sec_3657);
CREATE (para_3658:Paragraph {id: '1', content: 'Hipogonadotropik hipogonadizm tanısı; 6 ay ara ile yapılan değerlendirmelerde toplamda 3 yıl süre ile FSH ve LH değerleri normal aralığın alt sınırında veya düşük olan ve total testesteron değeri sayısal olarak düşük olan erkek hastalarda bu durumların belirtildiği en az biri endokrinoloji ve metabolizma uzman  hekimi veya üroloji uzman hekiminin yer aldığı 6 ay süreli sağlık kurulu raporuna dayanılarak endokrinoloji ve metabolizma uzman hekimi veya üroloji uzman hekimi tarafından reçete edilmesi halinde Kurumca bedeli karşılanır.  Kombine FSH-LH preparatları ile koryogonadotropin alfa etkin maddeli ilaçların birlikte kullanımı halinde Kurumca bedeli ödenmez.'});
CREATE (sec_3657)-[:HAS_PARAGRAPH {order: 0}]->(para_3658);
CREATE (amend_3659:Amendment {content: '(Değişik:RG-16/03/2023-32134/36 md. Yürürlük: \n24/03/2023)'});
CREATE (sec_3657)-[:HAS_AMENDMENT {order: 0}]->(amend_3659);
CREATE (amend_3660:Amendment {content: '(Ek:RG-02/11/2024-32710/24 md. \nYürürlük:09/11/2024)'});
CREATE (sec_3657)-[:HAS_AMENDMENT {order: 1}]->(amend_3660);
CREATE (sec_3641)-[:NEXT_SUBSECTION]->(sec_3657);
CREATE (sec_3661:Subsection {id: '4.2.67', title: 'Otozomal dominant polikistik böbrek hastalığında (ADPKD) tolvaptan kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 66}]->(sec_3661);
CREATE (para_3662:Paragraph {id: '1', content: 'Aşağıdaki kriterlerin tümünü karşılayan 18 (18,0) - 55 (55,0 hariç) yaş arası, GFR’si 25ml/dk’nın üzerinde ADPKD tanısı almış hastalarda tedaviye başlanır:'});
CREATE (sec_3661)-[:HAS_PARAGRAPH {order: 0}]->(para_3662);
CREATE (item_3663:Item {id: 'a', content: 'Son bir ay içinde 2 defa yapılan ölçüm sonunda CKD-EPI formülü ile hesaplanmış aşağıdaki glomerüler filtrasyon hızı değeri aranır.'});
CREATE (para_3662)-[:HAS_ITEM {order: 0}]->(item_3663);
CREATE (subitem_3664:SubItem {id: '1', content: '≥18 -<40 yaş arası: GFR kriteri aranmaz'});
CREATE (item_3663)-[:HAS_SUBITEM {order: 0}]->(subitem_3664);
CREATE (subitem_3665:SubItem {id: '2', content: '40 - 44 yaş arası: GFR <90 olmalı'});
CREATE (item_3663)-[:HAS_SUBITEM {order: 1}]->(subitem_3665);
CREATE (subitem_3664)-[:NEXT_SUBITEM]->(subitem_3665);
CREATE (subitem_3666:SubItem {id: '3', content: '45 - 49 yaş arası: GFR <75 olmalı'});
CREATE (item_3663)-[:HAS_SUBITEM {order: 2}]->(subitem_3666);
CREATE (subitem_3665)-[:NEXT_SUBITEM]->(subitem_3666);
CREATE (subitem_3667:SubItem {id: '4', content: '50 - 55 yaş arası: GFR <60 olmalı'});
CREATE (item_3663)-[:HAS_SUBITEM {order: 3}]->(subitem_3667);
CREATE (subitem_3666)-[:NEXT_SUBITEM]->(subitem_3667);
CREATE (item_3668:Item {id: 'b', content: 'Aşağıdaki tanımlarda yer aldığı şekilde, hızlı ilerleyen olgu olmalıdır. düşüşü ≥3 ml/dk/1.73m2 veya'});
CREATE (para_3662)-[:HAS_ITEM {order: 1}]->(item_3668);
CREATE (subitem_3669:SubItem {id: '1', content: 'En az 4 yıllık takip süresinde yapılmış ve yılda en az 1 kez yapılan toplam 5 ölçüme göre yıllık ortalama GFR'});
CREATE (item_3668)-[:HAS_SUBITEM {order: 0}]->(subitem_3669);
CREATE (subitem_3670:SubItem {id: '2', content: 'Mayo Clinic sınıflandırmasına göre MR veya CT ile ölçülen böbrek hacminin 1D veya 1E olması'});
CREATE (item_3668)-[:HAS_SUBITEM {order: 1}]->(subitem_3670);
CREATE (subitem_3669)-[:NEXT_SUBITEM]->(subitem_3670);
CREATE (item_3663)-[:NEXT_ITEM]->(item_3668);
CREATE (para_3671:Paragraph {id: '2', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularında  en az bir nefroloji uzman hekiminin yer aldığı sağlık kurulu raporuna dayanılarak nefroloji uzmanlarınca reçete edilmesi halinde bedeli ödenir. Rapor en fazla 1 yıl süreyle geçerli olup, yukarıda yer alan kriterler belirtilir. Maksimum doz günde 120 mg’yi aşmamalıdır. GFR<25 ml/dk olduğunda ilaç sonlandırılır.'});
CREATE (sec_3661)-[:HAS_PARAGRAPH {order: 1}]->(para_3671);
CREATE (para_3662)-[:NEXT_PARAGRAPH]->(para_3671);
CREATE (amend_3672:Amendment {content: '(Mülga:RG-16/03/2023-32134/37 md. Yürürlük: \n24/03/2023)'});
CREATE (sec_3661)-[:HAS_AMENDMENT {order: 0}]->(amend_3672);
CREATE (sec_3657)-[:NEXT_SUBSECTION]->(sec_3661);
CREATE (sec_3673:Subsection {id: '4.2.68', title: '3,4 diaminopyridin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 67}]->(sec_3673);
CREATE (para_3674:Paragraph {id: '1', content: '6 Yaş üzeri çocuklar ve yetişkin hastalarda: Elektrofizyolojik test ve/veya klinik değerlendirmeyle tanı konulmuş Lambert Eaton Miyastenik Sendromlu (LEMS) veya genetik analiz ile tanı konulmuş konjenital miyastenik sendromlu hastaların tedavisi için, üçüncü basamak resmi sağlık 145 hizmet sunucularında düzenlenen ve yukarıda yer alan tanı kriterlerinin belirtildiği, en az bir çocuk nöroloji ve/veya nöroloji uzman hekiminin yer aldığı sağlık kurulu raporuna dayanılarak bu uzman hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3673)-[:HAS_PARAGRAPH {order: 0}]->(para_3674);
CREATE (amend_3675:Amendment {content: '(Değişik: RG- 16/03/2023-32134/38 md. Yürürlük: 24/03/2023)'});
CREATE (sec_3673)-[:HAS_AMENDMENT {order: 0}]->(amend_3675);
CREATE (sec_3661)-[:NEXT_SUBSECTION]->(sec_3673);
CREATE (sec_3676:Subsection {id: '4.2.69', title: 'Sakrosidaz kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 68}]->(sec_3676);
CREATE (para_3677:Paragraph {id: '1', content: 'Sükraz-izomaltaz eksikliği klinik tablosu bulunan ve sükraz-izomaltaz (SI) geninde homozigot mutasyonu ya da bileşik heterozigot mutasyonu genetik analiz ile kanıtlanmış jeneralize sükraz-izomaltaz eksikliği olan;'});
CREATE (sec_3676)-[:HAS_PARAGRAPH {order: 0}]->(para_3677);
CREATE (item_3678:Item {id: 'a', content: 'Pediatrik hastaların tedavisi için; üçüncü basamak resmi sağlık hizmeti sunucularında düzenlenen ve yukarıda yer alan tanı kriterlerinin belirtildiği, en az bir çocuk gastroentroloji uzman hekiminin yer aldığı üç çocuk sağlığı ve hastalıkları uzman hekimince düzenlenecek sağlık kurulu raporuna istinaden çocuk sağlığı ve hastalıkları uzman hekimlerince reçete edilmesi halinde,'});
CREATE (para_3677)-[:HAS_ITEM {order: 0}]->(item_3678);
CREATE (item_3679:Item {id: 'b', content: 'Yetişkin hastaların tedavisi için; üçüncü basamak resmi sağlık hizmeti sunucularında düzenlenen ve yukarıda yer alan tanı kriterlerinin belirtildiği, en az bir gastroentereoloji uzman hekiminin yer aldığı sağlık kurulu raporuna istinaden gastroentereloji uzman hekimlerince reçete edilmesi halinde, bedeli Kurumca karşılanır.'});
CREATE (para_3677)-[:HAS_ITEM {order: 1}]->(item_3679);
CREATE (item_3678)-[:NEXT_ITEM]->(item_3679);
CREATE (sec_3673)-[:NEXT_SUBSECTION]->(sec_3676);
CREATE (sec_3680:Subsection {id: '4.2.70', title: 'Tafamidis kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 69}]->(sec_3680);
CREATE (para_3681:Paragraph {id: '1', content: 'Vahşi tip veya herediter tip transtiretin aracılı amiloidoz kardiyomiyopati (ATTR-KM) tanısı aşağıdaki kriterlere uygun olarak alınmalıdır.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 0}]->(para_3681);
CREATE (item_3682:Item {id: 'a', content: 'EKG, ekokardiyografi ve/veya kardiyak MR ile kardiyak amiloidozis şüphesi olması,'});
CREATE (para_3681)-[:HAS_ITEM {order: 0}]->(item_3682);
CREATE (item_3683:Item {id: 'b', content: 'Aşağıdaki bulguların hepsinin negatif olması ile monoklonal gamapatisi dışlanması, 45 ml/dk/1,72m2 halinde Kappa/Lambda oranının ≥ 2,0 olması) ve'});
CREATE (para_3681)-[:HAS_ITEM {order: 1}]->(item_3683);
CREATE (subitem_3684:SubItem {id: '1', content: 'Serbest plazma hafif zincir Kappa/serbest plazma hafif zincir Lambda oranının < 0,25 veya >1,62 olması (GFR <'});
CREATE (item_3683)-[:HAS_SUBITEM {order: 0}]->(subitem_3684);
CREATE (subitem_3685:SubItem {id: '2', content: 'Plazma kapiller protein elektroforezinde klonal gamapati olması ve'});
CREATE (item_3683)-[:HAS_SUBITEM {order: 1}]->(subitem_3685);
CREATE (subitem_3684)-[:NEXT_SUBITEM]->(subitem_3685);
CREATE (subitem_3686:SubItem {id: '3', content: 'Kan immünfiksasyon elektroforezinde monoklonal gamapati olması ve'});
CREATE (item_3683)-[:HAS_SUBITEM {order: 2}]->(subitem_3686);
CREATE (subitem_3685)-[:NEXT_SUBITEM]->(subitem_3686);
CREATE (subitem_3687:SubItem {id: '4', content: 'Yirmi dört saatlik idrar immünfiksasyon elektroforezinde monoklonal gamapati olması.'});
CREATE (item_3683)-[:HAS_SUBITEM {order: 3}]->(subitem_3687);
CREATE (subitem_3686)-[:NEXT_SUBITEM]->(subitem_3687);
CREATE (item_3682)-[:NEXT_ITEM]->(item_3683);
CREATE (item_3688:Item {id: 'c', content: 'Yukardaki bulgulardan herhangi birinin pozitif olması halinde hematoloji uzman hekimi tarafından monoklonal gamapatinin dışlanması.'});
CREATE (para_3681)-[:HAS_ITEM {order: 2}]->(item_3688);
CREATE (item_3683)-[:NEXT_ITEM]->(item_3688);
CREATE (item_3689:Item {id: 'ç', content: 'Monoklonal gamapati dışlanmış hastalarda, 99mTc-PYP, DPD veya HMDP kardiyak sintigrafisiyle Türk Nükleer Tıp Derneğinin kardiyak amiloidoz güncel tanı rehberine göre Grade II-III kardiyak tutulumu olduğunun belirtilmesi.'});
CREATE (para_3681)-[:HAS_ITEM {order: 3}]->(item_3689);
CREATE (item_3688)-[:NEXT_ITEM]->(item_3689);
CREATE (item_3690:Item {id: 'd', content: 'Nükleer sintigrafide tipik TTR kardiyak amiloid tutulumu olması halinde TTR genetik mutasyon analizinin yapılması gereklidir. Analizde mutasyon saptanmaması halinde vahşi tip TTR kardiyak amiloidoz kabul edilmesi, mutasyon saptanması halinde; (endomiyokardiyal veya multiple ekstrakardiyak biyopsi) bulgusunun olması. kardiyak amiloidoz kabul edilmesi,'});
CREATE (para_3681)-[:HAS_ITEM {order: 4}]->(item_3690);
CREATE (subitem_3691:SubItem {id: '1', content: 'Mutasyonun VUS (variance unknown significans) olması durumunda hastalığı ispatlayıcı biyopsi'});
CREATE (item_3690)-[:HAS_SUBITEM {order: 0}]->(subitem_3691);
CREATE (subitem_3692:SubItem {id: '2', content: 'Mutasyonun olası patojenik veya patojenik olması halinde destekleyici klinik bulguları var ise herediter TTR'});
CREATE (item_3690)-[:HAS_SUBITEM {order: 1}]->(subitem_3692);
CREATE (subitem_3691)-[:NEXT_SUBITEM]->(subitem_3692);
CREATE (item_3689)-[:NEXT_ITEM]->(item_3690);
CREATE (para_3693:Paragraph {id: '2', content: 'Vahşi tip veya herediter transtiretin aracılı amiloidoz kardiyomiyopatisi (ATTR-KM) tanısı almış erişkin hastalar aşağıdaki kriterlerin tamamını sağladığı takdirde ilaç başlanması uygundur.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 1}]->(para_3693);
CREATE (item_3694:Item {id: 'a', content: 'Ekokardiyografide duvar kalınlığının 1,2 cm’nin üzerinde olması,'});
CREATE (para_3693)-[:HAS_ITEM {order: 0}]->(item_3694);
CREATE (item_3695:Item {id: 'b', content: 'Son bir yıl içerisinde en az bir kez kalp yetersizliği (ICD-10 kodları) tanısı ile ayaktan ya da yatarak tedavi almış olması,'});
CREATE (para_3693)-[:HAS_ITEM {order: 1}]->(item_3695);

// Batch 99
CREATE (item_3694)-[:NEXT_ITEM]->(item_3695);
CREATE (item_3696:Item {id: 'c', content: 'N-terminal pro-B-tip natriüretik peptid (NT-proBNP) seviyesinin 600 pg/ml üzerinde  veya B-tip natriüretik peptid (BNP) seviyesinin 150 pg/ml üzerinde olması,'});
CREATE (para_3693)-[:HAS_ITEM {order: 2}]->(item_3696);
CREATE (item_3695)-[:NEXT_ITEM]->(item_3696);
CREATE (item_3697:Item {id: 'ç', content: 'Altı dakika yürüme mesafesinin 100 m’nin üzerinde olması ve NYHA fonksiyonel kapasite I-III olması,'});
CREATE (para_3693)-[:HAS_ITEM {order: 3}]->(item_3697);
CREATE (item_3696)-[:NEXT_ITEM]->(item_3697);
CREATE (item_3698:Item {id: 'd', content: 'Karaciğer ve/veya kalp nakli cerrahisi geçirmemiş olması,'});
CREATE (para_3693)-[:HAS_ITEM {order: 4}]->(item_3698);
CREATE (item_3697)-[:NEXT_ITEM]->(item_3698);
CREATE (item_3699:Item {id: 'e', content: 'Tahmini GFR’nin 30 ml/dk/1,72m2’nin üzerinde olması,'});
CREATE (para_3693)-[:HAS_ITEM {order: 5}]->(item_3699);
CREATE (item_3698)-[:NEXT_ITEM]->(item_3699);
CREATE (item_3700:Item {id: 'f', content: 'Modifiye vücut kitle indeksinin (VKİ x serum albümin mg/dl) 600’den büyük olması.'});
CREATE (para_3693)-[:HAS_ITEM {order: 6}]->(item_3700);
CREATE (item_3699)-[:NEXT_ITEM]->(item_3700);
CREATE (para_3681)-[:NEXT_PARAGRAPH]->(para_3693);
CREATE (para_3701:Paragraph {id: '3', content: 'Üçüncü basamak üniversite ve eğitim araştırma hastanelerinde; hastalığın tanı kriterleri ile ilaca başlama kriterlerini sağlayan ve bu durumların belirtildiği üç kardiyoloji uzman hekiminden oluşan 3 ay süreli sağlık kurulu raporuna istinaden kardiyoloji uzman hekimlerince reçetelenmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 2}]->(para_3701);
CREATE (para_3693)-[:NEXT_PARAGRAPH]->(para_3701);
CREATE (para_3702:Paragraph {id: '4', content: 'İlaca başlanan hastalarda; her üç ayda bir yapılan değerlendirmede tahmini GFR’nin 30 ml/dk/1,72m2’nin üzerinde olması, ciddi karaciğer yetmezliğinin gelişmemiş olması ve altı dakika yürüme mesafesinin 100 m’nin üzerinde olmasının ve NYHA fonksiyonel kapasite I-III olmasının korunması halinde bu durumların raporda belirtilmesi koşuluyla 3 aylık raporlarla ilaca devam edilebilir.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 3}]->(para_3702);
CREATE (para_3701)-[:NEXT_PARAGRAPH]->(para_3702);
CREATE (para_3703:Paragraph {id: '5', content: 'On beşinci ayın sonunda yapılan değerlendirmede; son altı ayda kalp yetersizliği nedeniyle bir ve üzeri hastaneye yatışının veya son altı ayda intravenöz diüretik ihtiyacı ile bir veya üzeri acil servis başvurusu olmaması ve bu durumların raporda belirtilmesi koşuluyla tedaviye devam edilebilir. İlaç devam kriterlerinin karşılanamadığı durumlarda tedaviye son verilir. 4.2.71. Amiloidoz hastalığında ilaç kullanım ilkeleri'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 4}]->(para_3703);
CREATE (para_3702)-[:NEXT_PARAGRAPH]->(para_3703);
CREATE (para_3704:Paragraph {id: '1', content: 'Daratumumabın yalnızca sc formu; biyopsi ile AL tipi amiloid varlığı tespit edilmiş yeni teşhis edilmiş sistemik hafif zincir (AL) amiloidozlu yetişkin hastaların tedavisinde siklofosfamid, bortezomib ve deksametazon ile kombine olarak progresyona kadar kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 5}]->(para_3704);
CREATE (para_3703)-[:NEXT_PARAGRAPH]->(para_3704);
CREATE (para_3705:Paragraph {id: '2', content: 'Üçüncü kür sonunda en az minör yanıt, altıncı kür sonunda ve devam eden her 6 kür sonunda ise en az kısmi yanıt olduğunun belirtildiği, hematoloji uzman hekiminin yer aldığı, en fazla 3 ay süreli sağlık kurulu raporuna istinaden hematoloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. 146'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 6}]->(para_3705);
CREATE (para_3704)-[:NEXT_PARAGRAPH]->(para_3705);
CREATE (para_3706:Paragraph {id: '3', content: 'NYHA Sınıf IIIB veya Sınıf IV kalp hastalığı olan veya Mayo Evre IIIB hafif zincir (AL) amiloidozu olan hastalarda ödenmez.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 7}]->(para_3706);
CREATE (para_3705)-[:NEXT_PARAGRAPH]->(para_3706);
CREATE (para_3707:Paragraph {id: '4', content: 'Tedavi süresi en fazla 2 yıldır.'});
CREATE (sec_3680)-[:HAS_PARAGRAPH {order: 8}]->(para_3707);
CREATE (para_3706)-[:NEXT_PARAGRAPH]->(para_3707);

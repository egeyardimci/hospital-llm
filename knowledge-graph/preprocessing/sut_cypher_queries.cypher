CREATE (para_1428:Paragraph {id: '2', content: 'Aşağıda sayılan tıbbi malzemelerin bedelleri üçüncü basamak resmi sağlık hizmeti sunucularında (Mülga:RG- 16/03/2023-32134/17-h md. Yürürlük:24/03/2023) (eğitim verme yetkisi olan klinik) uygulanması ve Sağlık Bakanlığı 59 “Ortopedi Bilimsel Danışma Kurulu” ndan her bir hasta için kullanılmasına onay alınması şartıyla bedeli Kurumca karşılanacaktır.'});
CREATE (sec_1409)-[:HAS_PARAGRAPH {order: 1}]->(para_1428);

CREATE (sec_3578:Subsection {id: '4.2.56', title: 'Large Neutral Amino Acids (LNNA) etken maddesini içeren beslenme ürünlerinin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 55}]->(sec_3578);
CREATE (para_3579:Paragraph {id: '1', content: '8 yaş ve üzerinde, diyete uyum gösteremeyen ve tıbbi mama kullanamayan klasik fenilketonüri hastalığında, çocuk metabolizma hastalıkları veya çocuk endokrinolojisi ve metabolizma hastalıkları uzman hekimi tarafından düzenlenen uzman hekim raporuna dayanılarak bu hekimlerce veya çocuk sağlığı ve hastalıkları uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3578)-[:HAS_PARAGRAPH {order: 0}]->(para_3579);
CREATE (amend_3580:Amendment {content: '(Değişik: RG- 05/08/2024- 32623/9 md. Yürürlük: 13/08/2024)'});
CREATE (sec_3578)-[:HAS_AMENDMENT {order: 0}]->(amend_3580);
CREATE (sec_3575)-[:NEXT_SUBSECTION]->(sec_3578);
CREATE (sec_3581:Subsection {id: '4.2.57', title: 'Dupilumab kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 56}]->(sec_3581);
CREATE (para_3582:Paragraph {id: '1', content: 'Dupilumab orta/şiddetli atopik dermatitli hastalarda;'});
CREATE (sec_3581)-[:HAS_PARAGRAPH {order: 0}]->(para_3582);
CREATE (item_3583:Item {id: 'a', content: 'Abrositinib veya upadasitinib tedavilerinden en az birini 12 hafta süre ile kullanmış olmasına rağmen yanıt vermeyen veya bu tedavileri tolere edemeyen veya bu ilaçların kontrendike olduğu 18 yaş ve üzeri orta ve şiddetli atopik dermatitli hastalarda, bu durumların sağlık kurulu raporunda belirtilmesi koşuluyla tedaviye başlanması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_3582)-[:HAS_ITEM {order: 0}]->(item_3583);
CREATE (item_3584:Item {id: 'b', content: 'Ancak iki aydan uzun süreli sistemik kortikosteroid ve siklosporin kullanımından yarar görmeyen veya bu ilaçları tolere edemeyen veya bu ilaçların kontrendike olduğu ve aşağıda belirtilen risk faktörlerinden en az birine sahip olan 18 yaş ve üzeri orta ve şiddetli atopik dermatitli hastalarda bu durumların sağlık kurulu raporunda belirtilmesi koşuluyla tedaviye Dupilumab ile başlanması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_3582)-[:HAS_ITEM {order: 1}]->(item_3584);
CREATE (subitem_3585:SubItem {id: '1', content: 'Aktif veya latent tüberküloz enfeksiyonu,'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 0}]->(subitem_3585);
CREATE (subitem_3586:SubItem {id: '2', content: 'Hepatit B veya C enfeksiyonu,'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 1}]->(subitem_3586);
CREATE (subitem_3585)-[:NEXT_SUBITEM]->(subitem_3586);
CREATE (subitem_3587:SubItem {id: '3', content: 'Son 5 yılda malignite hikayesi (non melanom deri kanseri hariç), veya artmış kanser riski'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 2}]->(subitem_3587);
CREATE (subitem_3586)-[:NEXT_SUBITEM]->(subitem_3587);
CREATE (subitem_3588:SubItem {id: '4', content: 'HIV enfeksiyonu,'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 3}]->(subitem_3588);
CREATE (subitem_3587)-[:NEXT_SUBITEM]->(subitem_3588);
CREATE (subitem_3589:SubItem {id: '5', content: 'Karaciğer yetmezliği (Child Pugh C) veya böbrek yetmezliği (GFR <30),'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 4}]->(subitem_3589);
CREATE (subitem_3588)-[:NEXT_SUBITEM]->(subitem_3589);
CREATE (subitem_3590:SubItem {id: '6', content: 'Arteriyel veya venöz tromboemboli öyküsü,'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 5}]->(subitem_3590);
CREATE (subitem_3589)-[:NEXT_SUBITEM]->(subitem_3590);
CREATE (subitem_3591:SubItem {id: '7', content: 'Tromboza eğilim ya da trombofili varlığı,'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 6}]->(subitem_3591);
CREATE (subitem_3590)-[:NEXT_SUBITEM]->(subitem_3591);
CREATE (subitem_3592:SubItem {id: '8', content: '65 yaş ve üzeri kişiler.'});
CREATE (item_3584)-[:HAS_SUBITEM {order: 7}]->(subitem_3592);
CREATE (subitem_3591)-[:NEXT_SUBITEM]->(subitem_3592);
CREATE (item_3583)-[:NEXT_ITEM]->(item_3584);
CREATE (para_3593:Paragraph {id: '2', content: '16 haftalık ilaç kullanım süresi sonunda tedavi başlangıcına göre aşağıdaki kriterlerden en az birinin sağlanması durumunda tedaviye devam edilebilir; 143 Yukarıdaki kriterlerin hiçbirinin sağlanamaması durumu tedavide yanıtsızlık olarak değerlendirilir ve tedaviye son verilir.'});
CREATE (sec_3581)-[:HAS_PARAGRAPH {order: 1}]->(para_3593);
CREATE (para_3582)-[:NEXT_PARAGRAPH]->(para_3593);
CREATE (para_3594:Paragraph {id: '3', content: 'Üçüncü basamak resmi sağlık hizmet sunucularında, üç deri ve zührevi hastalıkları uzman hekiminin yer aldığı 4 ay süreli sağlık kurulu raporuna dayanılarak deri ve zührevi hastalıkları uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. Upadasitinib, abrositinib ve dupilumab birlikte kullanılamaz.'});
CREATE (sec_3581)-[:HAS_PARAGRAPH {order: 2}]->(para_3594);
CREATE (para_3593)-[:NEXT_PARAGRAPH]->(para_3594);
CREATE (para_3595:Paragraph {id: '4', content: 'Dupilumab tedavisine yanıtsızlık durumunda dupilumab öncesinde kullanılmamış olması şartıyla abrositinib veya upadasitinib tedavilerinden herhangi birine geçilebilir.'});
CREATE (sec_3581)-[:HAS_PARAGRAPH {order: 3}]->(para_3595);
CREATE (para_3594)-[:NEXT_PARAGRAPH]->(para_3595);
CREATE (item_3596:Item {content: 'EASI skorunda en az %50 azalma,'});
CREATE (sec_3581)-[:HAS_ITEM {order: 0}]->(item_3596);
CREATE (item_3597:Item {content: 'Dermatoloji Yaşam Kalite İndeksinde en az 4 puanlık azalma,'});
CREATE (sec_3581)-[:HAS_ITEM {order: 1}]->(item_3597);
CREATE (item_3596)-[:NEXT_ITEM]->(item_3597);
CREATE (item_3598:Item {content: 'Pruritus NRS skorunda en az 3 puanlık düşüş.'});
CREATE (sec_3581)-[:HAS_ITEM {order: 2}]->(item_3598);
CREATE (item_3597)-[:NEXT_ITEM]->(item_3598);
CREATE (amend_3599:Amendment {content: '(Ek: RG- 04/09/2019- 30878/ 41 md. Yürürlük: 12/09/2019)'});
CREATE (sec_3581)-[:HAS_AMENDMENT {order: 0}]->(amend_3599);
CREATE (sec_3578)-[:NEXT_SUBSECTION]->(sec_3581);
CREATE (sec_3600:Subsection {id: '4.2.58', title: 'Pimekrolimus ve takrolimus (topikal formları) kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 57}]->(sec_3600);
CREATE (para_3601:Paragraph {id: '1', content: 'Ayakta tedavilerde aynı reçetede 2 kutuya kadar tüm hekimlerce, 2 kutu üzeri kullanım gereken hallerde dermatoloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır. Dermatoloji uzman hekimlerince düzenlenen 1 yıl süreli rapora istinaden aynı reçetede 10 kutuya kadar tüm hekimlerce, 10 kutu üzeri kullanım gereken hallerde dermatoloji uzman hekimlerince reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3600)-[:HAS_PARAGRAPH {order: 0}]->(para_3601);
CREATE (amend_3602:Amendment {content: '(Ek: RG-09/05/2020-31122/3 md. Yürürlük: 05/05/2020)'});
CREATE (sec_3600)-[:HAS_AMENDMENT {order: 0}]->(amend_3602);
CREATE (sec_3581)-[:NEXT_SUBSECTION]->(sec_3600);
CREATE (sec_3603:Subsection {id: '4.2.59', title: 'Belinostat kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 58}]->(sec_3603);
CREATE (para_3604:Paragraph {id: '1', content: 'Relaps Refrakter Periferik T Hücreli Lenfoma hastalarında tedavi olarak kullanımı uygundur. Üçüncü basamak resmi sağlık hizmet sunucularında düzenlenen en az bir hematoloji veya hematoloji-onkoloji uzmanının yer aldığı 3 (üç) ay süreli sağlık kurulu raporuna dayanılarak ilgili uzman hekimlerce reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3603)-[:HAS_PARAGRAPH {order: 0}]->(para_3604);
CREATE (amend_3605:Amendment {content: '(Değişik:RG-25/08/2022-31934/44 md. Yürürlük:03/09/2022)'});
CREATE (sec_3603)-[:HAS_AMENDMENT {order: 0}]->(amend_3605);
CREATE (sec_3600)-[:NEXT_SUBSECTION]->(sec_3603);
CREATE (sec_3606:Subsection {id: '4.2.60', title: 'Sodium benzoate kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 59}]->(sec_3606);
CREATE (para_3607:Paragraph {id: '1', content: 'Üre döngüsü enzim bozukluklarının tedavisinde aşağıda belirtilen enzimlerden en az biri eksik olan hastalarda kullanılması halinde,'});
CREATE (sec_3606)-[:HAS_PARAGRAPH {order: 0}]->(para_3607);

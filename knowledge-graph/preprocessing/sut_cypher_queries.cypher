CREATE (sec_458)-[:HAS_AMENDMENT {order: 2}]->(amend_471);
CREATE (sec_472:Subsection {id: '2.2.2.B-1', title: 'Tanıya dayalı işlemlerin kapsamı'});
CREATE (sec_458)-[:HAS_SUBSECTION {order: 0}]->(sec_472);
CREATE (para_473:Paragraph {id: '1', content: 'Tanıya dayalı ödeme listesi işlem puanlarına yatarak tedaviler kapsamında takip alındıktan sonraki, özel hükümler saklı kalmak kaydıyla;'});
CREATE (sec_472)-[:HAS_PARAGRAPH {order: 0}]->(para_473);
CREATE (item_474:Item {id: 'a', content: 'Yatak bedeli,'});
CREATE (para_473)-[:HAS_ITEM {order: 0}]->(item_474);
CREATE (item_475:Item {id: 'b', content: 'Muayeneler ve konsültasyonlar,'});
CREATE (para_473)-[:HAS_ITEM {order: 1}]->(item_475);
CREATE (item_474)-[:NEXT_ITEM]->(item_475);
CREATE (item_476:Item {id: 'c', content: 'Operasyon ve girişimler,'});
CREATE (para_473)-[:HAS_ITEM {order: 2}]->(item_476);
CREATE (item_475)-[:NEXT_ITEM]->(item_476);
CREATE (item_477:Item {id: 'ç', content: 'Anestezi ilaçları,'});
CREATE (para_473)-[:HAS_ITEM {order: 3}]->(item_477);
CREATE (item_476)-[:NEXT_ITEM]->(item_477);
CREATE (item_478:Item {id: 'd', content: 'Yatış dönemindeki ilaçlar  (kan ürünleri ayrıca faturalandırılır,kanama durdurma, sızdırmazlık sağlama doku yapıştırmada kullanılan ilaçlar bu kapsamda değerlendirilmez ),'});
CREATE (para_473)-[:HAS_ITEM {order: 4}]->(item_478);
CREATE (item_477)-[:NEXT_ITEM]->(item_478);
CREATE (item_479:Item {id: 'e', content: 'Kan bileşenleri (Ancak kan bileşenlerinin tanıya dayalı işlemler kapsamında kullanılması halinde kan bileşenleri puanlarının; 705371, 705430 ve 705440 kodlu kan bileşenleri için  %36’sı, 705372 ve 705373 kodlu kan bileşenleri için  %24’ü, 705441 kodlu kan bileşenleri için %20’si, 705442 ve 705443 kodlu kan bileşenleri için  %28’i sağlık hizmeti sunucusunca ayrıca faturalandırılır. Tüm kan bileşenlerinin MEDULA sistemine kaydedilmesi zorunludur.)'});
CREATE (para_473)-[:HAS_ITEM {order: 5}]->(item_479);
CREATE (item_478)-[:NEXT_ITEM]->(item_479);
CREATE (item_480:Item {id: 'f', content: 'Sarf malzemesi,'});
CREATE (para_473)-[:HAS_ITEM {order: 6}]->(item_480);
CREATE (item_479)-[:NEXT_ITEM]->(item_480);
CREATE (item_481:Item {id: 'g', content: 'Anestezi bedeli,'});
CREATE (para_473)-[:HAS_ITEM {order: 7}]->(item_481);
CREATE (item_480)-[:NEXT_ITEM]->(item_481);
CREATE (item_482:Item {id: 'ğ', content: 'Laboratuvar, patoloji ve radyoloji tetkikleri,'});
CREATE (para_473)-[:HAS_ITEM {order: 8}]->(item_482);
CREATE (item_481)-[:NEXT_ITEM]->(item_482);
CREATE (item_483:Item {id: 'h', content: 'Refakatçi bedeli (tıbbi zorunluluk halinde), gibi tanı ve tedavi kapsamında yapılan tüm işlemler dahil olup ayrıca faturalandırılamaz.'});
CREATE (para_473)-[:HAS_ITEM {order: 9}]->(item_483);
CREATE (item_482)-[:NEXT_ITEM]->(item_483);
CREATE (para_484:Paragraph {id: '2', content: 'SUT eki EK-2/C Listesi “Açıklama” bölümünde belirtilen istisnalar dikkate alınacaktır.'});
CREATE (sec_472)-[:HAS_PARAGRAPH {order: 1}]->(para_484);
CREATE (para_473)-[:NEXT_PARAGRAPH]->(para_484);
CREATE (para_485:Paragraph {id: '3', content: 'Tanıya dayalı işlemin uygulandığı tarih birinci gün kabul edilmek kaydıyla aşağıda belirtilen süreler içerisinde aynı sağlık hizmeti sunucusunda bu işlemle ilgili olarak verilen sağlık hizmetleri tanıya dayalı işlem kapsamında değerlendirilir.'});
CREATE (sec_472)-[:HAS_PARAGRAPH {order: 2}]->(para_485);
CREATE (item_486:Item {id: 'a', content: 'A Grubu tanıya dayalı işlemlerde; 15 gün'});
CREATE (para_485)-[:HAS_ITEM {order: 0}]->(item_486);
CREATE (item_487:Item {id: 'b', content: 'B Grubu tanıya dayalı işlemlerde; 10 gün'});
CREATE (para_485)-[:HAS_ITEM {order: 1}]->(item_487);
CREATE (item_486)-[:NEXT_ITEM]->(item_487);
CREATE (item_488:Item {id: 'c', content: 'C Grubu tanıya dayalı işlemlerde; 8 gün'});
CREATE (para_485)-[:HAS_ITEM {order: 2}]->(item_488);
CREATE (item_487)-[:NEXT_ITEM]->(item_488);
CREATE (item_489:Item {id: 'ç', content: 'D Grubu tanıya dayalı işlemlerde; 5 gün'});
CREATE (para_485)-[:HAS_ITEM {order: 3}]->(item_489);
CREATE (item_488)-[:NEXT_ITEM]->(item_489);
CREATE (item_490:Item {id: 'd', content: 'E Grubu tanıya dayalı işlemlerde; 3 gün'});
CREATE (para_485)-[:HAS_ITEM {order: 4}]->(item_490);
CREATE (item_489)-[:NEXT_ITEM]->(item_490);
CREATE (para_484)-[:NEXT_PARAGRAPH]->(para_485);
CREATE (para_491:Paragraph {id: '4', content: 'Üçüncü fıkrada belirtilen sürelerin aşılması halinde verilen sağlık hizmetlerinin bedelleri, ayrıca faturalandırılır.'});
CREATE (sec_472)-[:HAS_PARAGRAPH {order: 3}]->(para_491);
CREATE (para_485)-[:NEXT_PARAGRAPH]->(para_491);
CREATE (para_492:Paragraph {id: '5', content: 'Tanıya dayalı işlem kapsamında olan, ilaç ve/veya tıbbi malzemelerin bedellerinin hasta tarafından ödendiğinin tespiti halinde ilaç ve/veya tıbbi malzemelerin fatura tutarları hastaya ödenir. Kurumca ödenen tutar ilgili sağlık (Değişik: RG- 25/08/2022- 31934/ 12-f md. Yürürlük: 03/09/2022) hizmeti sunucusundan mahsup edilir. Sağlık Bakanlığına bağlı sağlık hizmeti sunucuları için Bakanlığa yapılan global bütçe ödemesinden mahsup edilir. Mahsup edilen tutar hiçbir surette sağlık hizmet sunucusuna iade edilmez.'});
CREATE (sec_472)-[:HAS_PARAGRAPH {order: 4}]->(para_492);
CREATE (para_491)-[:NEXT_PARAGRAPH]->(para_492);
CREATE (amend_493:Amendment {content: '(Ek: RG- 21/04/2015- 29333/ 3 md. Yürürlük: 01/05/2015)'});
CREATE (sec_472)-[:HAS_AMENDMENT {order: 0}]->(amend_493);

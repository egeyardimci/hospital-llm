CREATE (sec_2337:Subsection {id: '4.2.11', title: 'Glokom ilaçları'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 10}]->(sec_2337);
CREATE (para_2338:Paragraph {id: '1', content: 'Glokom ilaçları ile tedaviye göz sağlığı ve hastalıkları uzman hekimi tarafından başlanacaktır. Göz sağlığı ve hastalıkları uzman hekimi tarafından düzenlenen uzman hekim raporuna dayanılarak diğer hekimlerce de reçete edilebilir.'});
CREATE (sec_2337)-[:HAS_PARAGRAPH {order: 0}]->(para_2338);
CREATE (sec_2247)-[:NEXT_SUBSECTION]->(sec_2337);
CREATE (sec_2339:Subsection {id: '4.2.12', title: 'İmmünglobulinlerin kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 11}]->(sec_2339);
CREATE (amend_2340:Amendment {content: '(Değişik: RG-16/06/2020-31157/5 md. Yürürlük: 24/06/2020)'});
CREATE (sec_2339)-[:HAS_AMENDMENT {order: 0}]->(amend_2340);
CREATE (sec_2341:Subsection {id: '4.2.12.A', title: 'Spesifik immünglobulinlerin kullanım ilkeleri'});
CREATE (sec_2339)-[:HAS_SUBSECTION {order: 0}]->(sec_2341);
CREATE (para_2342:Paragraph {id: '1', content: 'Hepatit B ve tetanoz immünglobulinlerinin ayakta tedavide, sadece Sağlık Bakanlığının onay verdiği endikasyonlarda ve dozlarda olmak üzere uzman hekim raporuna dayanılarak uzman hekimler tarafından birer aylık dozda reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_2341)-[:HAS_PARAGRAPH {order: 0}]->(para_2342);
CREATE (para_2343:Paragraph {id: '2', content: 'Hepatit B immünglobulini (HBIg)’nin, Hepatit B virüs yüzey antijeni (HbsAg) taşıyan hastalarda karaciğer transplantasyonu sonrası enfeksiyon profilaksisi endikasyonunda belirlenen risk grubuna göre aşağıdaki durumların rapor/reçetede belirtilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_2341)-[:HAS_PARAGRAPH {order: 1}]->(para_2343);
CREATE (item_2344:Item {id: 'a', content: 'Risk grupları ve kriterleri aşağıda yer almaktadır:'});
CREATE (para_2343)-[:HAS_ITEM {order: 0}]->(item_2344);
CREATE (subitem_2345:SubItem {id: '1', content: 'Yüksek risk grubu hastalar;'});
CREATE (item_2344)-[:HAS_SUBITEM {order: 0}]->(subitem_2345);
CREATE (item_2346:Item {id: 'a', content: 'Karaciğer nakli öncesi HBV DNA pozitif olan veya'});
CREATE (para_2343)-[:HAS_ITEM {order: 1}]->(item_2346);
CREATE (item_2344)-[:NEXT_ITEM]->(item_2346);
CREATE (item_2347:Item {id: 'b', content: 'Karaciğer nakli öncesi HBeAg pozitif olan veya'});
CREATE (para_2343)-[:HAS_ITEM {order: 2}]->(item_2347);
CREATE (item_2346)-[:NEXT_ITEM]->(item_2347);
CREATE (item_2348:Item {id: 'c', content: 'Karaciğer nakli öncesi hepatoselüler kanseri bulunan veya'});
CREATE (para_2343)-[:HAS_ITEM {order: 3}]->(item_2348);
CREATE (item_2347)-[:NEXT_ITEM]->(item_2348);
CREATE (item_2349:Item {id: 'ç', content: 'Delta virüs veya HIV ile ko-enfekte olan veya'});
CREATE (para_2343)-[:HAS_ITEM {order: 4}]->(item_2349);
CREATE (item_2348)-[:NEXT_ITEM]->(item_2349);
CREATE (item_2350:Item {id: 'd', content: 'Karaciğer nakli öncesi antiviral tedaviye direnç öyküsü ya da uyumsuzluğu olanlardır.'});
CREATE (para_2343)-[:HAS_ITEM {order: 5}]->(item_2350);
CREATE (subitem_2351:SubItem {id: '2', content: 'Düşük risk grubu hastalar; karaciğer nakli öncesi HBV DNA negatif olanlardır.'});
CREATE (item_2350)-[:HAS_SUBITEM {order: 0}]->(subitem_2351);
CREATE (item_2349)-[:NEXT_ITEM]->(item_2350);
CREATE (item_2352:Item {id: 'b', content: 'Karaciğer naklinin anhepatik fazında; yüksek risk grubu hastalarda 10.000 IU, düşük risk grubu hastalarda 5.000 IU HBIg kullanılması halinde bedelleri Kurumca karşılanır.'});
CREATE (para_2343)-[:HAS_ITEM {order: 6}]->(item_2352);
CREATE (item_2350)-[:NEXT_ITEM]->(item_2352);
CREATE (item_2353:Item {id: 'c', content: 'Düşük ve yüksek risk grubundaki hastalara karaciğer naklinden sonra; bakılır. HBsAg negatif olması durumunda ve/veya AntiHBs düzeyi>100 IU/l ise aylık 2.000 IU HBIg idame tedavisi uygulamasına geçilir. gün 2.000 IU HBIg kullanılabilir. Nakilden 14 gün sonra AntiHBs düzeylerine yeniden bakılır. AntiHBs düzeyi>100 IU/l ise aylık 2.000 IU HBIg idame tedavisi uygulamasına geçilir. kullanılabilir. Bu sürenin de sonunda AntiHBs düzeyinden bağımsız olarak aylık 2.000 IU HBIg idame tedavisi uygulamasına geçilir. (Ek: RG- 25/08/2022- 31934/ 25-a md. Yürürlük: 03/09/2022) uygulamasına geçilebilir. Bu sürenin de sonunda AntiHBs düzeyinden bağımsız olarak aylık 2.000 IU SC HBIg idame tedavisi uygulamasına geçilir.'});
CREATE (para_2343)-[:HAS_ITEM {order: 7}]->(item_2353);
CREATE (subitem_2354:SubItem {id: '1', content: '7 gün boyunca her gün 2.000 IU HBIg kullanılabilir. Nakilden 7 gün sonra HBsAg ve AntiHBs düzeylerine'});
CREATE (item_2353)-[:HAS_SUBITEM {order: 0}]->(subitem_2354);
CREATE (subitem_2355:SubItem {id: '2', content: 'Nakilden 7 gün sonra HBsAg pozitif olması durumunda ve/veya AntiHBs düzeyi<100 IU/l 7 gün boyunca her'});
CREATE (item_2353)-[:HAS_SUBITEM {order: 1}]->(subitem_2355);
CREATE (subitem_2354)-[:NEXT_SUBITEM]->(subitem_2355);
CREATE (subitem_2356:SubItem {id: '3', content: 'Nakilden 14 gün sonra AntiHBs düzeyinin<100 IU/l olması halinde 7 gün boyunca her gün 2.000 IU HBIg'});
CREATE (item_2353)-[:HAS_SUBITEM {order: 2}]->(subitem_2356);
CREATE (subitem_2355)-[:NEXT_SUBITEM]->(subitem_2356);
CREATE (subitem_2357:SubItem {id: '4', content: 'Nakilden 14 gün sonra HBsAg negatif ve AntiHBs düzeyi>100 IU/l ise aylık 2.000 IU SC HBIg idame tedavisi'});
CREATE (item_2353)-[:HAS_SUBITEM {order: 3}]->(subitem_2357);
CREATE (subitem_2356)-[:NEXT_SUBITEM]->(subitem_2357);
CREATE (item_2352)-[:NEXT_ITEM]->(item_2353);
CREATE (item_2358:Item {id: 'ç', content: 'HBIg idame tedavileri için düzenlenen her reçetede HBsAg veya HBV DNA sonuçları yer almalıdır; (Değişik:RG-26/10/2021-31640/ 4-a md. Yürürlük: 04/11/2021) nakli öncesi hepatoselüler kanseri bulunan hastalarda karaciğer naklinden 10 yıl, diğer yüksek risk grubu hastalarda karaciğer naklinden 5 yıl sonra HBIg tedavisi sonlandırılır. Delta virüs veya HIV ile ko-enfekte olan hastalarda ise karaciğer naklinden sonra ömür boyu HBIg tedavisi devam eder. (Ek: RG- 25/08/2022- 31934/ 25-b md. Yürürlük: 03/09/2022) 92'});
CREATE (para_2343)-[:HAS_ITEM {order: 8}]->(item_2358);
CREATE (subitem_2359:SubItem {id: '1', content: 'HBsAg veya HBV DNA sonucunun pozitif olması durumunda HBIg tedavisi sonlandırılır.'});
CREATE (item_2358)-[:HAS_SUBITEM {order: 0}]->(subitem_2359);
CREATE (subitem_2360:SubItem {id: '2', content: 'Düşük risk grubu hastalarda her halukarda karaciğer naklinden 1 yıl, yüksek risk grubu hastalardan karaciğer'});
CREATE (item_2358)-[:HAS_SUBITEM {order: 1}]->(subitem_2360);
CREATE (subitem_2359)-[:NEXT_SUBITEM]->(subitem_2360);
CREATE (item_2353)-[:NEXT_ITEM]->(item_2358);
CREATE (para_2342)-[:NEXT_PARAGRAPH]->(para_2343);
CREATE (para_2361:Paragraph {id: '3', content: 'Sitomegalavirüs immunglobulini; yalnızca kalp ve/veya akciğer nakli alıcılarında, donör CMV-IgG pozitif, alıcı negatif olan yüksek riskli ve immünosupresif tedaviye maruz kalan hastalarda, sitomegalovirüs enfeksiyonunun klinik belirtilerinin profilaksisinde; bu durumların belirtildiği kalp naklinde kardiyovasküler cerrahi, kardiyoloji ve enfeksiyon hastalıkları, akciğer naklinde göğüs cerrahisi, göğüs hastalıkları ve enfeksiyon hastalıkları uzman hekimlerinden oluşan sağlık kurulu raporuna dayanılarak tabela/reçetelerin uzman hekimlerce düzenlenmesi halinde bedelleri Kurumca ödenir.'});
CREATE (sec_2341)-[:HAS_PARAGRAPH {order: 2}]->(para_2361);
CREATE (para_2343)-[:NEXT_PARAGRAPH]->(para_2361);
CREATE (amend_2362:Amendment {content: '(Değişik: RG-02/11/2024- 32710/12 md. Yürürlük: 09/11/2024)'});
CREATE (sec_2341)-[:HAS_AMENDMENT {order: 0}]->(amend_2362);
CREATE (sec_2363:Subsection {id: '4.2.12.B', title: 'Spesifik olmayan/gamma/polivalan immünglobulinler'});
CREATE (sec_2339)-[:HAS_SUBSECTION {order: 1}]->(sec_2363);
CREATE (sec_2364:Subsection {id: '4.2.12.B-1', title: 'Spesifik olmayan/gamma/polivalan immünglobulinler (Uygulama yolu Intravenöz veya Intravenöz', content: '/Subcutan olan İmmunglobulinler)'});
CREATE (sec_2363)-[:HAS_SUBSECTION {order: 0}]->(sec_2364);
CREATE (para_2365:Paragraph {id: '1', content: 'Aşağıda yer alan endikasyonlar için;'});
CREATE (sec_2364)-[:HAS_PARAGRAPH {order: 0}]->(para_2365);
CREATE (item_2366:Item {id: 'a', content: 'Antikor üretiminin bozulduğu primer (konjenital) immün yetmezlik sendromlarında 1 yıl süre ile hematoloji, tıbbi onkoloji, enfeksiyon hastalıkları ve klinik mikrobiyoloji, göğüs hastalıkları, romatoloji, nefroloji veya immünoloji ve alerji uzman hekimlerinden herhangi biri tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 0}]->(item_2366);
CREATE (item_2367:Item {id: 'b', content: 'Profilaktik antibiyotiklerin başarısız veya kontrendike olduğu Kronik Lenfositik Lösemi (KLL) hastalarındaki hipogamaglobulinemi ve rekürren bakteriyel enfeksiyonlarda veya Multipl Miyelom (MM) hastalarındaki hipogamaglobulinemi ve rekürren bakteriyel enfeksiyonlarda veya allojenik hematopoietik kök hücre transplantasyonu öncesinde veya sonrasında hipogamaglobulinemi endikasyonlarında 1 yıl süre ile hematoloji veya çocuk hematolojisi ve onkolojisi uzman hekimleri tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 1}]->(item_2367);
CREATE (item_2366)-[:NEXT_ITEM]->(item_2367);
CREATE (item_2368:Item {id: 'c', content: 'Kanama riski yüksek olan veya cerrahi müdahale öncesi trombosit sayısının hızla yükseltilmesi gereken İmmün Trombositopeni (İTP) olgularında 1 yıl süre ile hematoloji uzman hekimi tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 2}]->(item_2368);
CREATE (item_2367)-[:NEXT_ITEM]->(item_2368);
CREATE (item_2369:Item {id: 'ç', content: 'Guillan-Barre sendromunda IVIG kritik fazda ilk tercih olarak 2 gr/kg dozunda (0,4 gr/kg/gün olarak ilk 5 günde, tekrarı gerekmesi halinde bir ay içinde 2 gr/kg dozunda (0,4 gr/kg/gün olarak 5 gün kullanılabilir.) 1 ay süre ile nöroloji uzman hekimi tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 3}]->(item_2369);
CREATE (item_2368)-[:NEXT_ITEM]->(item_2369);
CREATE (item_2370:Item {id: 'd', content: 'Kawasaki hastalığında 1 yıl süre ile romatoloji, immünoloji, immünoloji ve alerji, kardiyoloji, enfeksiyon hastalıkları ve klinik mikrobiyoloji veya çocuk enfeksiyon hastalıkları uzman hekimleri tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 4}]->(item_2370);
CREATE (item_2369)-[:NEXT_ITEM]->(item_2370);
CREATE (item_2371:Item {id: 'e', content: 'Multifokal motor nöropati endikasyonunda, 2-5 günde bölünmüş dozlarda en fazla 2g/kg yükleme dozunda, yükleme tedavisine yanıt alınması durumunda ayda bir (0,4 g/kg/ay) tek dozda verilir ve 2 ay sonunda yanıt alınamazsa tedavi sonlandırılır. Başlangıç tedavisine yanıt alınması halinde idame tedavide 1 yıl süre ile nöroloji uzman hekimi tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 5}]->(item_2371);
CREATE (item_2370)-[:NEXT_ITEM]->(item_2371);
CREATE (item_2372:Item {id: 'f', content: 'Kronik inflamatuvar demiyelinizan polinöropati endikasyonunda steroid tedavisine (puls ve idame tedavisine en az 6 ay) yetersiz cevap veya steroid tedavisine kanıtlanmış komplikasyon ve/veya kontrendikasyon durumlarında 2-5 ardışık günde bölünmüş dozlarda en fazla 2 g/kg yükleme dozunda, yükleme dozuna yanıt alınamaması durumunda ayda bir (0,4 g/kg/ay) tek dozda 1 veya 2 günde verilir ve 2 ay sonunda yanıt alınamazsa tedavi sonlandırılır. Başlangıç tedavisine yanıt alınması halinde ayda bir (0,4 g/kg/ay) tek doz, idame tedavide 1 yıl süre ile nöroloji uzman hekimi tarafından,'});
CREATE (para_2365)-[:HAS_ITEM {order: 6}]->(item_2372);
CREATE (item_2371)-[:NEXT_ITEM]->(item_2372);

// Batch 64
CREATE (item_2373:Item {id: 'g', content: 'Bulber tutulumu olan myastenia graviste 2 gr/kg dozunda (0,4 gr/kg/gün olarak ilk 5 günde) 1 yıl süre ile nöroloji uzman hekimi tarafından, düzenlenen, yukarıdaki bentlerde belirtilen ilgili uzman hekimlerin yer aldığı sağlık kurulu raporuna istinaden, ilgili bentlerde belirtilen uzman hekimlerce 1 aylık dozda reçete edilmesi halinde bedelleri Kurumca karşılanır. Akut guillain barre sendromu ve bulber tutulumu olan myastenia gravis tanılı acil durumlarda ilgili uzman hekim raporu ile kullanılabilir. (Birdshot retinokoroidopati endikasyonu ödenmez.)'});
CREATE (para_2365)-[:HAS_ITEM {order: 7}]->(item_2373);
CREATE (item_2372)-[:NEXT_ITEM]->(item_2373);
CREATE (sec_2374:Subsection {id: '4.2.12.B-2', title: 'Spesifik olmayan/gamma/polivalan immünglobulinler (Uygulama yolu yalnızca Subcutan olan', content: 'İmmunglobulinler)'});
CREATE (sec_2363)-[:HAS_SUBSECTION {order: 1}]->(sec_2374);
CREATE (para_2375:Paragraph {id: '1', content: 'Aşağıda yer alan endikasyonlar için;'});
CREATE (sec_2374)-[:HAS_PARAGRAPH {order: 0}]->(para_2375);
CREATE (item_2376:Item {id: 'a', content: 'Antikor üretiminin bozulduğu primer (konjenital) immün yetmezlik sendromlarında 1 yıl süre ile hematoloji, göğüs hastalıkları veya immünoloji ve alerji uzman hekimleri tarafından,'});
CREATE (para_2375)-[:HAS_ITEM {order: 0}]->(item_2376);
CREATE (item_2377:Item {id: 'b', content: 'Profilaktik antibiyotiklerin başarısız veya kontrendike olduğu Kronik Lenfositik Lösemi (KLL) hastalarındaki hipogamaglobulinemi ve rekürren bakteriyel enfeksiyonlarda veya Multipl Miyelom (MM) hastalarındaki hipogamaglobulinemi ve rekürren bakteriyel enfeksiyonlarda veya allojenik hematopoietik kök hücre transplantasyonu öncesinde veya sonrasında hipogamaglobulinemi endikasyonlarında 1 yıl süre ile hematoloji veya çocuk hematolojisi ve onkolojisi uzman hekimleri tarafından,'});
CREATE (para_2375)-[:HAS_ITEM {order: 1}]->(item_2377);
CREATE (item_2376)-[:NEXT_ITEM]->(item_2377);
CREATE (item_2378:Item {id: 'c', content: 'Kronik inflamatuvar demiyelinizan polinöropatisi olan hastalarda IVIG ile stabilizasyondan sonra tedaviye SC immunglobulin ile devam edilecek ise yalnızca erişkinlerde bu tanıda SC kullanım dozu 0,4 g/kg/hafta, idame tedavisi en fazla 1 yıl süre ile nöroloji uzman hekimleri tarafından, düzenlenen, yukarıdaki bentlerde belirtilen ilgili uzman hekimlerin yer aldığı sağlık kurulu raporuna istinaden, ilgili bentlerde belirtilen uzman hekimlerce 1 aylık dozda reçete edilmesi halinde bedelleri Kurumca karşılanır. (Birdshot retinokoroidopati endikasyonu ödenmez.)'});
CREATE (para_2375)-[:HAS_ITEM {order: 2}]->(item_2378);
CREATE (item_2377)-[:NEXT_ITEM]->(item_2378);
CREATE (sec_2364)-[:NEXT_SUBSECTION]->(sec_2374);
CREATE (sec_2341)-[:NEXT_SUBSECTION]->(sec_2363);
CREATE (sec_2337)-[:NEXT_SUBSECTION]->(sec_2339);
CREATE (sec_2379:Subsection {id: '4.2.13', title: 'Hepatit tedavisi', content: '(Değişik: RG- 18/06/2016- 29746/ 13-a md. Yürürlük: 18/06/2016) (Değişik: RG- 26/09/2013- 28777/ 4-a md. Yürürlük: 04/10/2013)'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 12}]->(sec_2379);
CREATE (para_2380:Paragraph {id: '1', content: 'Akut ve kronik viral hepatit tedavisinde kullanılan ilaçlar gastroenteroloji veya enfeksiyon hastalıkları uzman hekimlerinden biri tarafından düzenlenen sağlık raporuna dayanılarak bu uzman hekimler ile çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimleri tarafından reçete edilir. (Ek: RG-02/11/2024- 32710/13-a md. Yürürlük: 09/11/2024)'});
CREATE (sec_2379)-[:HAS_PARAGRAPH {order: 0}]->(para_2380);
CREATE (para_2381:Paragraph {id: '3', content: 'Akut Hepatit B tedavisi'});
CREATE (sec_2379)-[:HAS_PARAGRAPH {order: 1}]->(para_2381);
CREATE (item_2382:Item {id: 'a', content: 'Akut hepatit B nedeniyle izlenen hastalarda ciddi akut HBV kliniği ve laboratuvar bulguları olan (İNR ≥ 1,5 veya PT normalin üst sınırından 4 saniyeden daha uzun olanlar ve sarılık dönemi > 4 hafta olanlar) hastalarda 4 hafta arayla iki kere 93 HBsAg negatifliği elde edilene kadar Sağlık Bakanlığınca onaylı endikasyonu bulunan antiviral ilaçların bedeli Kurumca karşılanır. (Değişik: RG- 18/06/2016- 29746/ 13-b md. Yürürlük: 18/06/2016)'});
CREATE (para_2381)-[:HAS_ITEM {order: 0}]->(item_2382);
CREATE (para_2380)-[:NEXT_PARAGRAPH]->(para_2381);
CREATE (amend_2383:Amendment {content: '(Değişik: RG- 07/10/2016- 29850/ 20 md. Yürürlük: 18/06/2016)'});
CREATE (sec_2379)-[:HAS_AMENDMENT {order: 0}]->(amend_2383);
CREATE (amend_2384:Amendment {content: '(Mülga: RG- 25/08/2022- 31934/ 26 md. Yürürlük: 03/09/2022)'});
CREATE (sec_2379)-[:HAS_AMENDMENT {order: 1}]->(amend_2384);
CREATE (sec_2385:Subsection {id: '4.2.13.1', title: 'Kronik Hepatit B tedavisi', content: '(Değişik: RG- 25/07/2014- 29071/ 26-a md. Yürürlük: 07/08/2014 ) (Değişik: RG-02/11/2024- 32710/13-b md. Yürürlük: 09/11/2024)'});
CREATE (sec_2379)-[:HAS_SUBSECTION {order: 0}]->(sec_2385);
CREATE (para_2386:Paragraph {id: '1', content: 'İlk tedaviye başlamak için;'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 0}]->(para_2386);
CREATE (item_2387:Item {id: 'a', content: 'HBV DNA seviyesi 10.000 (10) kopya/ml (2.000 IU/ml) veya üzerinde olan hastalarda, bu durumun belirtildiği rapor ve eki tetkik sonuçlarına göre; 1- Erişkin hastalarda; karaciğer biyopsisinde Histolojik Aktivite İndeksi (HAI) ≥6 veya fibrozis ≥2 olanlar ile 2-18 yaş grubu hastalarda; “ALT normalin üst sınırının 2 katından daha yüksek ve karaciğer biyopsisinde HAI ≥4” veya “ALT düzeyine bakılmaksızın fibrozis ≥ 2” olan hastalarda veya, 2- Erişkin hastalarda; en az 3 ay ara ile tekrarlanan testlerde ALT normalin üst sınırının üzerinde ve FIB-4 skoru >1.45 veya APRI > 0.5 üzerinde olanlarda, tedaviye pegile interferonlar veya oral antiviraller ile başlanabilir.'});
CREATE (para_2386)-[:HAS_ITEM {order: 0}]->(item_2387);
CREATE (item_2388:Item {id: 'b', content: '40 yaş üzerinde ve HBV DNA 20.000 IU/mL veya üzerinde olan hastalarda biyopsi yapılmadan oral antiviraller ile tedaviye başlanabilir. (Değişik:RG-26/10/2021-31640/ 5-a md. Yürürlük: 04/11/2021)'});
CREATE (para_2386)-[:HAS_ITEM {order: 1}]->(item_2388);
CREATE (item_2387)-[:NEXT_ITEM]->(item_2388);
CREATE (para_2389:Paragraph {id: '2', content: 'Pegile interferonlar ile tedavi;'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 1}]->(para_2389);
CREATE (item_2390:Item {id: 'a', content: 'Erişkin hastalarda pegile interferonlar ALT değeri normalin üst sınırının 2 katını geçen, HBeAg negatif olan ve HBV DNA ≤ 107 kopya/ml olan hastalar ile HBeAg pozitif olan ve HBV DNA ≤ 109 olan hastalarda kullanılabilir. Pegile interferonlar kronik hepatit B hastalarında en fazla 48 hafta süreyle kullanılabilir.'});
CREATE (para_2389)-[:HAS_ITEM {order: 0}]->(item_2390);
CREATE (item_2391:Item {id: 'b', content: 'Çocuklarda pegile interferon tedavi süresi 24 haftadır. Bu grup hastalarda 24 haftalık tedavinin bitiminden en az 1 yıl sonra bu maddenin birinci fıkrasının (b) bendinde tarif edilen koşulları yeniden taşıyan hastalara en fazla 24 haftalık ikinci bir pegile interferon tedavisi daha verilebilir.'});
CREATE (para_2389)-[:HAS_ITEM {order: 1}]->(item_2391);
CREATE (item_2390)-[:NEXT_ITEM]->(item_2391);
CREATE (para_2386)-[:NEXT_PARAGRAPH]->(para_2389);
CREATE (para_2392:Paragraph {id: '3', content: 'Erişkin hastalarda oral antiviral tedaviye; günde 100 mg lamivudin, 600 mg telbivudin, 245 mg tenofovir disoproksil fumarat, 0,5 mg entekavir veya 25 mg tenofovir alafenamid fumarat ile başlanır. (Mülga:RG-16/06/2020-31157/7- a md. Yürürlük: 24/06/2020)'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 2}]->(para_2392);
CREATE (para_2389)-[:NEXT_PARAGRAPH]->(para_2392);
CREATE (para_2393:Paragraph {id: '4', content: 'Erişkin hastalar oral antiviral tedavi almakta iken;'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 3}]->(para_2393);
CREATE (item_2394:Item {id: 'a', content: 'Lamivudin veya telbivudin tedavisi almakta iken 24 üncü haftada HBV DNA düzeyi 50 IU/ml (300 kopya/ml) ve üzerinde olan hastalarda diğer antiviraller kullanılabilir. Ancak bu tedavilerin 24 üncü haftasında HBV DNA düzeyi 50 IU/ml’nin (300 kopya/ml) altında ise başka bir oral antiviral ajana geçilemez veya eklenemez.'});
CREATE (para_2393)-[:HAS_ITEM {order: 0}]->(item_2394);
CREATE (item_2395:Item {id: 'b', content: 'Oral antiviral tedavi almakta olan hastalarda negatif (-) olan HBV DNA’nın pozitifleşmesi veya HBV DNA düzeyinin 10 kat yükselmesi ile başka bir oral antivirale geçilebilir veya almakta oldukları tedaviye ikinci bir oral antiviral eklenebilir.'});
CREATE (para_2393)-[:HAS_ITEM {order: 1}]->(item_2395);
CREATE (item_2394)-[:NEXT_ITEM]->(item_2395);
CREATE (item_2396:Item {id: 'c', content: 'Tenofovir disoproksil fumarat veya tenofovir alafenamid fumarat veya entekavir ile tedavi alan hastalarda birinci yılın sonunda halen HBV DNA düzeyinin pozitif olması durumunda bu antiviraller arasında geçiş yapılabilir veya tenofovir disoproksil fumarat ile entekavir veya tenofovir alafenamid fumarat ile entekavir birlikte kullanılabilir.'});
CREATE (para_2393)-[:HAS_ITEM {order: 2}]->(item_2396);
CREATE (item_2395)-[:NEXT_ITEM]->(item_2396);
CREATE (item_2397:Item {id: 'ç', content: 'Oral antiviral tedavisi almakta olan hastalarda gebelik oluşması durumunda oral antiviral değişiminde bu koşullar aranmaz.'});
CREATE (para_2393)-[:HAS_ITEM {order: 3}]->(item_2397);
CREATE (item_2396)-[:NEXT_ITEM]->(item_2397);
CREATE (item_2398:Item {id: 'd', content: 'Kullanılan antivirale karşı yan etki gelişmesi halinde koşul aranmaksızın başka bir antivirale geçilebilir. (Mülga:RG-16/06/2020-31157/7-b md. Yürürlük: 24/06/2020)'});
CREATE (para_2393)-[:HAS_ITEM {order: 4}]->(item_2398);
CREATE (item_2397)-[:NEXT_ITEM]->(item_2398);
CREATE (item_2399:Item {id: 'e', content: 'Oral antiviral değişimi ya da tedaviye yeni oral antiviral eklenmesi gerekçesi mevcut raporda veya düzenlenecek yeni raporda belirtilir.'});
CREATE (para_2393)-[:HAS_ITEM {order: 5}]->(item_2399);
CREATE (item_2398)-[:NEXT_ITEM]->(item_2399);
CREATE (item_2400:Item {id: 'f', content: 'Adefovir tedavisinden koşul aranmaksızın tenofovir disoproksil fumarat veya tenofovir alafenamid fumarat veya entekavire geçilebilir.'});
CREATE (para_2393)-[:HAS_ITEM {order: 6}]->(item_2400);
CREATE (item_2399)-[:NEXT_ITEM]->(item_2400);
CREATE (para_2392)-[:NEXT_PARAGRAPH]->(para_2393);
CREATE (para_2401:Paragraph {id: '5', content: '2-18 yaş çocuk hastalarda oral antiviral tedaviye;'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 4}]->(para_2401);
CREATE (item_2402:Item {id: 'a', content: 'Lamivudin ile 3 mg/kg/gün (günlük maksimum doz 100 mg) dozunda 2-18 yaş grubunda, tenofovir disoproksil fumarat ile 245 mg/gün veya tenofovir alafenamid fumarat ile 25 mg/gün dozunda 12-18 yaş grubunda, entekavir ile 0,5 mg/gün dozunda 16-18 yaş grubunda başlanabilir.'});
CREATE (para_2401)-[:HAS_ITEM {order: 0}]->(item_2402);
CREATE (item_2403:Item {id: 'b', content: 'Çocuk hastalar oral antiviral tedavi almakta iken; çocuk hastalarda yaş grubu göz önüne alınarak tenofovir disoproksil fumarat veya tenofovir alafenamid fumarat veya entekavir kullanılabilir. Ancak bu tedavilerin 24 üncü haftasında HBV DNA düzeyi 50 IU/ml’nin (300 kopya/ml) altında ise başka bir oral antiviral ajana geçilemez veya eklenemez. düzeyinin 10 kat yükselmesi ile yaş grubu göz önüne alınarak başka bir oral antivirale geçilebilir veya almakta oldukları tedaviye ikinci bir oral antiviral eklenebilir. birinci yılın sonunda halen HBV DNA düzeyinin pozitif olması durumunda yaş grubu göz önüne alınarak bu antiviraller arasında geçiş yapılabilir veya tenofovir disoproksil fumarat ile entekavir veya tenofovir alafenamid fumarat ile entekavir birlikte kullanılabilir. bir antivirale geçilebilir. yeni raporda belirtilir. 94 tenofovir alafenamid fumarat veya entekavire geçilebilir.'});
CREATE (para_2401)-[:HAS_ITEM {order: 1}]->(item_2403);
CREATE (subitem_2404:SubItem {id: '1', content: 'Lamivudin tedavisi almakta iken 24 üncü haftada HBV DNA düzeyi 50 IU/ml (300 kopya/ml) ve üzerinde olan'});
CREATE (item_2403)-[:HAS_SUBITEM {order: 0}]->(subitem_2404);
CREATE (subitem_2405:SubItem {id: '2', content: 'Oral antiviral tedavi almakta olan çocuk hastalarda negatif (-) olan HBV DNA’nın pozitifleşmesi veya HBV DNA'});
CREATE (item_2403)-[:HAS_SUBITEM {order: 1}]->(subitem_2405);
CREATE (subitem_2404)-[:NEXT_SUBITEM]->(subitem_2405);
CREATE (subitem_2406:SubItem {id: '3', content: 'Tenofovir disoproksil fumarat veya tenofovir alafenamid fumarat veya entekavir ile tedavi alan çocuk hastalarda'});
CREATE (item_2403)-[:HAS_SUBITEM {order: 2}]->(subitem_2406);
CREATE (subitem_2405)-[:NEXT_SUBITEM]->(subitem_2406);
CREATE (subitem_2407:SubItem {id: '4', content: 'Kullanılan antivirale karşı yan etki gelişmesi halinde koşul aranmaksızın çocuğun yaşı göz önüne alınarak başka'});
CREATE (item_2403)-[:HAS_SUBITEM {order: 3}]->(subitem_2407);
CREATE (subitem_2406)-[:NEXT_SUBITEM]->(subitem_2407);
CREATE (subitem_2408:SubItem {id: '5', content: 'Oral antiviral değişimi ya da tedaviye yeni oral antiviral eklenmesi gerekçesi mevcut raporda veya düzenlenecek'});
CREATE (item_2403)-[:HAS_SUBITEM {order: 4}]->(subitem_2408);
CREATE (subitem_2407)-[:NEXT_SUBITEM]->(subitem_2408);
CREATE (subitem_2409:SubItem {id: '6', content: 'Adefovir tedavisinden koşul aranmaksızın çocuğun yaşı göz önüne alınarak tenofovir disoproksil fumarat veya'});
CREATE (item_2403)-[:HAS_SUBITEM {order: 5}]->(subitem_2409);
CREATE (subitem_2408)-[:NEXT_SUBITEM]->(subitem_2409);
CREATE (item_2402)-[:NEXT_ITEM]->(item_2403);
CREATE (para_2393)-[:NEXT_PARAGRAPH]->(para_2401);
CREATE (para_2410:Paragraph {id: '6', content: 'Oral antiviral tedavinin sonlandırılması;'});

// Batch 65
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 5}]->(para_2410);
CREATE (item_2411:Item {id: 'a', content: 'Her yenilenen raporda tek başına HBsAg pozitifliği veya HBsAg negatifliği ile birlikte Anti-HBs negatifliği raporda belirtilmelidir.'});
CREATE (para_2410)-[:HAS_ITEM {order: 0}]->(item_2411);
CREATE (item_2412:Item {id: 'b', content: 'Oral antiviral tedavi, HBsAg negatif hastalarda Anti-HBs pozitifleştikten sonra en fazla 12 ay daha sürdürülür.'});
CREATE (para_2410)-[:HAS_ITEM {order: 1}]->(item_2412);
CREATE (item_2411)-[:NEXT_ITEM]->(item_2412);
CREATE (para_2401)-[:NEXT_PARAGRAPH]->(para_2410);
CREATE (para_2413:Paragraph {id: '7', content: 'Antiviral tedavi almakta olan HBsAg pozitifliği devam eden hastalarda; klinik, laboratuvar, görüntüleme ve gerekmesi halinde karaciğer biyopsisi verilerinin değerlendirilmesi sonucunda verilecek karara göre tedaviye devam edilir. Tedaviye ara verilmesi durumunda bu fıkra hükümleri uygulanır. (Ek: RG- 21/03/2018- 30367/ 22-c md. Yürürlük: 01/04/2018)'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 6}]->(para_2413);
CREATE (para_2410)-[:NEXT_PARAGRAPH]->(para_2413);
CREATE (para_2414:Paragraph {id: '8', content: 'Oral antiviral tedavilerde ilk rapor süresi en fazla 6 ay, sonraki rapor süreleri bir yılı geçemez. (Değişik: RG- 18/06/2016- 29746/ 13-c md. Yürürlük: 18/06/2016) (Değişik: RG- 26/09/2013- 28777/ 4-b md. Yürürlük: 04/10/2013)'});
CREATE (sec_2385)-[:HAS_PARAGRAPH {order: 7}]->(para_2414);
CREATE (para_2413)-[:NEXT_PARAGRAPH]->(para_2414);
CREATE (amend_2415:Amendment {content: '(Değişik: RG- 28/12/2018- 30639/ 16 md. Yürürlük: 08/01/2019)'});
CREATE (sec_2385)-[:HAS_AMENDMENT {order: 0}]->(amend_2415);
CREATE (amend_2416:Amendment {content: '(Değişik: RG- 10/05/2018-30417/ 11 md. Yürürlük: 18/05/2018)'});
CREATE (sec_2385)-[:HAS_AMENDMENT {order: 1}]->(amend_2416);
CREATE (amend_2417:Amendment {content: '(Değişik: RG- 28/12/2018- 30639/ 16 md. Yürürlük: 08/01/2019)'});
CREATE (sec_2385)-[:HAS_AMENDMENT {order: 2}]->(amend_2417);
CREATE (sec_2418:Subsection {id: '4.2.13.1.1', title: 'Hepatit B’ye bağlı karaciğer sirozunda tedavi'});
CREATE (sec_2385)-[:HAS_SUBSECTION {order: 0}]->(sec_2418);
CREATE (para_2419:Paragraph {id: '1', content: 'Karaciğer sirozunda HBV DNA (+) olan hastalarda tedaviye başlanılabilir ve bu durum raporda belirtilir. Tedavi süreleri; HBV DNA (+) olanlar için kronik hepatit B tedavisinde olduğu gibidir. (Ek: RG-02/11/2024-32710/13-c md. Yürürlük:09/11/2024) Kronik Hepatit B’ye bağlı karaciğer sirozu tanısı için, biyopsi kanıtı olmayan hastalarda, trombosit sayısının 150.000/mm³’ün altında veya protrombin zamanının 3 saniye ve/veya üzerinde olması koşulu aranır. (Değişik: RG- 18/06/2016- 29746/ 13-ç md. Yürürlük: 18/06/2016)'});
CREATE (sec_2418)-[:HAS_PARAGRAPH {order: 0}]->(para_2419);
CREATE (sec_2420:Subsection {id: '4.2.13.1.2', title: 'İmmünsupresif ilaç tedavisi, sitotoksik kemoterapi, monoklonal antikor tedavisi uygulanmakta olan', content: 'hastalarda tedavi'});
CREATE (sec_2385)-[:HAS_SUBSECTION {order: 1}]->(sec_2420);
CREATE (para_2421:Paragraph {id: '1', content: 'İmmünsupresif ilaç tedavisi veya sitotoksik kemoterapi veya monoklonal antikor tedavisi uygulanmakta olan HBsAg (+) hastalarda, ALT yüksekliği, HBV DNA pozitifliği ve karaciğer biyopsisi koşulu aranmaksızın uygulanmakta olan diğer tedavisi süresince ve bu tedavisinden sonraki en fazla 12 ay boyunca (Değişik: RG- 25/07/2014- 29071/ 26-b md. Yürürlük: 07/08/2014) günde 100 mg lamivudin veya 600 mg telbivudin veya 245 mg tenofovir  disoproksil fumarat veya 25 mg tenofovir alafenamid fumarat veya 0,5 mg entekavir kullanılabilir. İmmünsupresif, sitotoksik kemoterapi ve monoklonal antikor tedavisine ilişkin ilaç raporunun tarih ve sayısı reçetede belirtilir.'});
CREATE (sec_2420)-[:HAS_PARAGRAPH {order: 0}]->(para_2421);
CREATE (para_2422:Paragraph {id: '2', content: 'İmmünsupresif ilaç tedavisi veya sitotoksik kemoterapi veya monoklonal antikor tedavisi uygulanmakta olan kronik hepatit B hastalarında ise tedavi süreleri ve ilaç seçimi kronik hepatit tedavi prensiplerinde belirlendiği şekildedir.'});
CREATE (sec_2420)-[:HAS_PARAGRAPH {order: 1}]->(para_2422);
CREATE (para_2421)-[:NEXT_PARAGRAPH]->(para_2422);
CREATE (para_2423:Paragraph {id: '3', content: 'HBsAg negatif olduğu durumlarda HBV DNA pozitifliği ve/veya Anti HBc pozitifliği durumlarında immünsupresif ilaç tedavisi veya sitotoksik kemoterapi veya monoklonal antikor tedavisi uygulanmakta olan hastalara ALT yüksekliği ve karaciğer biyopsisi koşulu aranmaksızın lamivudin (Ek: RG- 25/07/2014- 29071/ 26-c md. Yürürlük: 07/08/2014)veya telbivudin veya tenofovir  disoproksil fumarat veya tenofovir alafenamid fumarat veya entekavir kullanılabilir. Söz konusu tedavilerin bitiminden sonraki en fazla 12 ay boyunca da (Değişik: RG- 25/07/2014- 29071/ 26-c md. Yürürlük: 07/08/2014) antiviral tedavi kullanılabilir. (Değişik: RG- 18/06/2016- 29746/ 13-d md. Yürürlük: 18/06/2016)'});
CREATE (sec_2420)-[:HAS_PARAGRAPH {order: 2}]->(para_2423);
CREATE (para_2422)-[:NEXT_PARAGRAPH]->(para_2423);
CREATE (amend_2424:Amendment {content: '(Ek:RG- 28/12/2018- 30639/ \n17 md. Yürürlük: 08/01/2019)'});
CREATE (sec_2420)-[:HAS_AMENDMENT {order: 0}]->(amend_2424);
CREATE (amend_2425:Amendment {content: '(Ek:RG- 28/12/2018- 30639/ 17 md. Yürürlük: 08/01/2019)'});
CREATE (sec_2420)-[:HAS_AMENDMENT {order: 1}]->(amend_2425);
CREATE (sec_2418)-[:NEXT_SUBSECTION]->(sec_2420);
CREATE (sec_2426:Subsection {id: '4.2.13.1.3', title: 'HBV’ye bağlı karaciğer hastalığından dolayı karaciğer transplantasyonu yapılan hastalar veya Anti-', content: 'Hbc(+) kişiden karaciğer alan hastalarda tedavi'});
CREATE (sec_2385)-[:HAS_SUBSECTION {order: 2}]->(sec_2426);
CREATE (para_2427:Paragraph {id: '1', content: 'HBV’ye bağlı karaciğer hastalığından dolayı karaciğer transplantasyonu yapılan hastalar veya Anti-HBc(+) kişiden karaciğer alan hastalara; biyopsi, viral seroloji, ALT seviyesi yada HBV DNA bakılmaksızın oral antiviral tedavi verilebilir. 4.2.13.1.4 Karaciğer biyopsisi ile ilgili genel prensipler'});
CREATE (sec_2426)-[:HAS_PARAGRAPH {order: 0}]->(para_2427);
CREATE (para_2428:Paragraph {id: '1', content: 'Karaciğer biyopsisi ile ilgili kurallar Ishak skorlamasına göre (pediatrik hastalarda Knodell skorlamasına göre) belirlenmiştir.'});
CREATE (sec_2426)-[:HAS_PARAGRAPH {order: 1}]->(para_2428);
CREATE (para_2427)-[:NEXT_PARAGRAPH]->(para_2428);
CREATE (para_2429:Paragraph {id: '2', content: '(Değişik: RG-02/11/2024-32710/13-ç md. Yürürlük:09/11/2024) Tedaviye başlamak için biyopsi yapılması gereken hastalardan; biyopsi için kontrendikasyon bulunan hastalarda [PT de 3 sn den fazla uzama veya trombosit sayısı <80.000 /mm3 veya kanama eğilimini artıran hastalıklar veya kronik böbrek yetmezliği/böbrek nakli veya biyopsiye engel olacak konumda bir yer kaplayıcı lezyonun varlığı veya karaciğer sirozu veya karaciğer nakli veya gebeler veya (Ek: RG- 02/11/2024-32710/13-ç md. Yürürlük:09/11/2024) gebelikte tanı alarak tedavisi başlananların tedavisinin devamında, biyopsiye engel teşkil edecek şekilde ciddi yeti yitimine neden olan psikotik bozukluğu ve zeka geriliği olan hastalarda (biyopsi uyumunun olmadığının psikiyatri uzman hekimlerince düzenlenecek sağlık kurulu raporunda belirtilmesi koşuluyla)] karaciğer biyopsisi koşulu aranmaz. Biyopsi koşulu aranmayan durumlar sağlık raporunda açık olarak belirtilir. (Değişik: RG- 18/06/2016- 29746/ 13-e md. Yürürlük: 18/06/2016)'});
CREATE (sec_2426)-[:HAS_PARAGRAPH {order: 2}]->(para_2429);
CREATE (para_2428)-[:NEXT_PARAGRAPH]->(para_2429);
CREATE (amend_2430:Amendment {content: '(Ek: RG- 26/11/2016- 29900/ 14 md. Yürürlük: 18/06/2016)'});
CREATE (sec_2426)-[:HAS_AMENDMENT {order: 0}]->(amend_2430);
CREATE (amend_2431:Amendment {content: '(Değişik:RG-10/05/2018-30417/12md.Yürürlük:18/05/2018)'});
CREATE (sec_2426)-[:HAS_AMENDMENT {order: 1}]->(amend_2431);
CREATE (sec_2420)-[:NEXT_SUBSECTION]->(sec_2426);
CREATE (sec_2432:Subsection {id: '4.2.13.2', title: 'Kronik Hepatit D (=Delta) tedavisi'});
CREATE (sec_2379)-[:HAS_SUBSECTION {order: 1}]->(sec_2432);
CREATE (para_2433:Paragraph {id: '1', content: 'Delta ajanlı Kronik Hepatit B tanısı konmuş anti HDV(+) hastalarda (Mülga:RG-26/10/2021-31640/5-b md. Yürürlük: 04/11/2021) pegile interferonlar, kronik hepatit B’deki kullanım süre ve dozunda kullanılabilir. Bu hastalardan Kronik Hepatit B tedavi koşullarını taşıyanlarda tedaviye oral antiviral ilaçlardan biri eklenebilir. (Anti HDV(+) ve HBV DNA sonucu reçete veya raporda belirtilir.)  Biyopsisi ile ilgili hepatit B’deki belirtilen genel prensipler esas alınır. (Değişik: RG- 18/06/2016- 29746/ 13-f md. Yürürlük: 18/06/2016)'});
CREATE (sec_2432)-[:HAS_PARAGRAPH {order: 0}]->(para_2433);
CREATE (amend_2434:Amendment {content: '(Ek: RG- 26/11/2016- 29900/ 15 md. Yürürlük: 18/06/2016)'});
CREATE (sec_2432)-[:HAS_AMENDMENT {order: 0}]->(amend_2434);
CREATE (sec_2385)-[:NEXT_SUBSECTION]->(sec_2432);
CREATE (sec_2435:Subsection {id: '4.2.13.3', title: 'Hepatit C tedavisi', content: '95 (Değişik: RG- 18/06/2016- 29746/ 13-g md. Yürürlük: 18/06/2016)'});
CREATE (sec_2379)-[:HAS_SUBSECTION {order: 2}]->(sec_2435);
CREATE (sec_2436:Subsection {id: '4.2.13.3.1', title: 'Akut Hepatit C tedavisi'});
CREATE (sec_2435)-[:HAS_SUBSECTION {order: 0}]->(sec_2436);
CREATE (para_2437:Paragraph {id: '1', content: 'Akut hepatit C tedavisinde kullanılan ilaçlar gastroenteroloji veya enfeksiyon hastalıkları uzman hekimlerinden biri tarafından düzenlenen ilaç kullanım raporuna dayanılarak bu uzman hekimler ile çocuk sağlığı ve hastalıkları veya iç hastalıkları uzman hekimleri tarafından reçete edilir.'});
CREATE (sec_2436)-[:HAS_PARAGRAPH {order: 0}]->(para_2437);
CREATE (para_2438:Paragraph {id: '2', content: 'Akut hepatit C hastalarında (HCV RNA pozitif sonuç raporda belirtilir) 24 hafta süreyle, onaylanmış Kısa Ürün Bilgisinde Kronik C hepatitinde tanımlanan dozlarda (Mülga:RG-26/10/2021-31640/5-c md. Yürürlük: 04/11/2021) pegile interferon alfa monoterapisi uygulanır. Bu hastalarda tedaviye ribavirin eklenemez. Akut hepatit C tedavisi için karaciğer biyopsisi ve 12 nci haftada HCV RNA seviyesinde 2 log azalma koşulu aranmaz. (Değişik: RG- 18/06/2016- 29746/ 13-ğ md. Yürürlük: 18/06/2016)'});
CREATE (sec_2436)-[:HAS_PARAGRAPH {order: 1}]->(para_2438);
CREATE (para_2437)-[:NEXT_PARAGRAPH]->(para_2438);
CREATE (amend_2439:Amendment {content: '(Değişik: RG- 07/10/2016- 29850/ 21md. Yürürlük: 18/06/2016)'});
CREATE (sec_2436)-[:HAS_AMENDMENT {order: 0}]->(amend_2439);
CREATE (amend_2440:Amendment {content: '(Değişik: RG- 07/10/2016- 29850/ 22 md. Yürürlük: 18/06/2016)'});
CREATE (sec_2436)-[:HAS_AMENDMENT {order: 1}]->(amend_2440);
CREATE (amend_2441:Amendment {content: '(Değişik: RG- 01/06/2022- 31853/9 md. Yürürlük: 09/06/2022)'});
CREATE (sec_2436)-[:HAS_AMENDMENT {order: 2}]->(amend_2441);
CREATE (sec_2442:Subsection {id: '4.2.13.3.2', title: 'Kronik Hepatit C tedavisinde genel hükümler'});
CREATE (sec_2435)-[:HAS_SUBSECTION {order: 1}]->(sec_2442);
CREATE (para_2443:Paragraph {id: '1', content: 'HCV RNA pozitifliğine bakılır.'});
CREATE (sec_2442)-[:HAS_PARAGRAPH {order: 0}]->(para_2443);
CREATE (para_2444:Paragraph {id: '2', content: 'Kronik Hepatit C’ye bağlı kompanse (Child-Pugh A) karaciğer sirozu olan hastalarda; histopatolojik tanı olmadığı durumda trombosit sayısının 150.000/mm³’ün altında veya protrombin zamanının 3 saniye ve/veya üzerinde olması koşulu aranır.'});
CREATE (sec_2442)-[:HAS_PARAGRAPH {order: 1}]->(para_2444);
CREATE (para_2443)-[:NEXT_PARAGRAPH]->(para_2444);
CREATE (para_2445:Paragraph {id: '3', content: 'Kronik Hepatit C’ye bağlı dekompanse (Child-Pugh B veya Child-Pugh C) karaciğer sirozu olan hastalarda; asit sıvısının varlığı veya hepatik ensefalopati veya sarılık (total bilirubin >3 mg/dl) veya özefagus varis kanaması olması koşulları aranır. Dekompanse karaciğer sirozu olan erişkin hastalarda HCV genotip tayini yapılır. Bunun dışındaki erişkin hastalar için genotip tayini gerekmez.'});
CREATE (sec_2442)-[:HAS_PARAGRAPH {order: 2}]->(para_2445);
CREATE (para_2444)-[:NEXT_PARAGRAPH]->(para_2445);
CREATE (para_2446:Paragraph {id: '4', content: 'Çocuk hastalarda “4.2.13.3.2.B- Çocuk hastalarda Kronik Hepatit C tedavisi” maddesinde tanımlı durumlarda genotip tayini yapılır.'});
CREATE (sec_2442)-[:HAS_PARAGRAPH {order: 3}]->(para_2446);
CREATE (para_2445)-[:NEXT_PARAGRAPH]->(para_2446);
CREATE (para_2447:Paragraph {id: '5', content: 'Tedavide kullanılan ilaçlar,  ikinci ve üçüncü basamak sağlık kurumlarında gastroenteroloji veya enfeksiyon hastalıkları uzman hekimlerinden biri tarafından düzenlenen uzman hekim raporuna dayanılarak, bu uzman hekimler ile çocuk sağlığı ve hastalıkları uzman hekimi  veya iç hastalıkları uzman hekimi tarafından reçete edilir.'});
CREATE (sec_2442)-[:HAS_PARAGRAPH {order: 4}]->(para_2447);
CREATE (para_2446)-[:NEXT_PARAGRAPH]->(para_2447);
CREATE (para_2448:Paragraph {id: '6', content: 'Düzenlenecek uzman hekim raporunda; HCV RNA pozitifliği, hastanın nonsirotik veya sirotik olma durumu, hastanın siroz olduğu belirtiliyorsa siroz varlığını, Child-Pugh B veya Child-Pugh C karaciğer sirozu var ise bu durumu kanıtlayıcı bilgi/belgeler, dekompanse siroz hastalarında veya genotip tayini yapılması gerekli görülen çocuk hastalarda genotipi gösterir bilgi/belgeler, hastanın daha önce hepatit C tedavisi alıp almadığı, eğer daha önce hepatit C tedavisi almış ise tedavisinde NS5A inhibitörü olan ilaç kullanıp kullanmadığını da belirterek hangi tedaviyi almış olduğu ve hasta için planlanan tedavi şeması belirtilecektir.'});
CREATE (sec_2442)-[:HAS_PARAGRAPH {order: 5}]->(para_2448);
CREATE (para_2447)-[:NEXT_PARAGRAPH]->(para_2448);
CREATE (amend_2449:Amendment {content: '(Ek: RG- 05/08/2024-32623/3 md. Yürürlük: 13/08/2024)'});
CREATE (sec_2442)-[:HAS_AMENDMENT {order: 0}]->(amend_2449);
CREATE (amend_2450:Amendment {content: '(Ek: RG- 05/08/2024-\n32623/3 md. Yürürlük: 13/08/2024)'});
CREATE (sec_2442)-[:HAS_AMENDMENT {order: 1}]->(amend_2450);
CREATE (sec_2451:Subsection {id: '4.2.13.3.2.A', title: 'Erişkin hastalarda Kronik Hepatit C tedavisi'});
CREATE (sec_2442)-[:HAS_SUBSECTION {order: 0}]->(sec_2451);

// Batch 66
CREATE (sec_2452:Subsection {id: '4.2.13.3.2.A.1', title: 'Daha önce Kronik Hepatit C tedavisi almamış hastalarda tedavi'});
CREATE (sec_2451)-[:HAS_SUBSECTION {order: 0}]->(sec_2452);
CREATE (para_2453:Paragraph {id: '1', content: 'Nonsirotik hastalarda; tedavi süresi (Sofosbuvir+Velpatasvir+Voxilaprevir) ile toplam 8 hafta ya da (Glekaprevir+Pibrentasvir) ile toplam 8 haftadır.'});
CREATE (sec_2452)-[:HAS_PARAGRAPH {order: 0}]->(para_2453);
CREATE (para_2454:Paragraph {id: '2', content: 'Kompanse sirotik (Child-Pugh A) hastalarda; tedavi süresi (Sofosbuvir+Velpatasvir+Voxilaprevir) ile toplam 12 hafta ya da (Glekaprevir+Pibrentasvir) ile toplam 8 haftadır.'});
CREATE (sec_2452)-[:HAS_PARAGRAPH {order: 1}]->(para_2454);
CREATE (para_2453)-[:NEXT_PARAGRAPH]->(para_2454);
CREATE (para_2455:Paragraph {id: '3', content: 'Dekompanse sirotik (Child-Pugh B veya Child-Pugh C) Genotip 1a,1b, 4, 5, 6 hastalarda (Sofosbuvir+Ledipasvir)+Ribavirin ile tedavi süresi toplam 12 haftadır.'});
CREATE (sec_2452)-[:HAS_PARAGRAPH {order: 2}]->(para_2455);
CREATE (para_2454)-[:NEXT_PARAGRAPH]->(para_2455);
CREATE (sec_2456:Subsection {id: '4.2.13.3.2.A.2', title: 'Tedavi deneyimli Kronik Hepatit C hastalarında yeniden tedavi'});
CREATE (sec_2451)-[:HAS_SUBSECTION {order: 1}]->(sec_2456);
CREATE (para_2457:Paragraph {id: '1', content: 'Daha önce NS5A inhibitörü olan ilaçlar haricindeki ilaçlar ile tedavi deneyimli, nonsirotik hastalarda tedavi süresi (Sofosbuvir+Velpatasvir+Voxilaprevir) ile toplam 12 hafta ya da (Glekaprevir+Pibrentasvir) ile toplam 8 haftadır.'});
CREATE (sec_2456)-[:HAS_PARAGRAPH {order: 0}]->(para_2457);
CREATE (para_2458:Paragraph {id: '2', content: 'Daha önce NS5A inhibitörü olan ilaçlar haricindeki ilaçlar ile tedavi deneyimli, kompanse sirotik hastalarda tedavi süresi (Sofosbuvir+Velpatasvir+Voxilaprevir) ile toplam 12 hafta ya da (Glekaprevir+Pibrentasvir) ile toplam 12 haftadır.'});
CREATE (sec_2456)-[:HAS_PARAGRAPH {order: 1}]->(para_2458);
CREATE (para_2457)-[:NEXT_PARAGRAPH]->(para_2458);
CREATE (para_2459:Paragraph {id: '3', content: 'Daha önce NS5A inhibitörü veya proteaz inhibitörü olan ilaçlar ile tedavi deneyimi olan, nonsirotik veya kompanse sirotik hastalarda tedavi süresi (Sofosbuvir+Velpatasvir+Voxilaprevir) ile toplam 12 hafta ya da Sağlık Bakanlığınca hasta bazında verilen ilaç kullanım onayı ile mümkün olacak şekilde (Glekaprevir+Pibrentasvir)+Ribavirin veya (Glekaprevir+Pibrentasvir) ile toplam 16 haftadır.'});
CREATE (sec_2456)-[:HAS_PARAGRAPH {order: 2}]->(para_2459);
CREATE (para_2458)-[:NEXT_PARAGRAPH]->(para_2459);
CREATE (para_2460:Paragraph {id: '4', content: 'Daha önce NS5A inhibitörü veya proteaz inhibitörü olan ilaçlar ile tedavi deneyimi olan dekompanse sirotik Genotip 1a,1b, 4, 5, 6 hastalarda (Sofosbuvir+Ledipasvir)+Ribavirin ile tedavi süresi toplam 24 haftadır.'});
CREATE (sec_2456)-[:HAS_PARAGRAPH {order: 3}]->(para_2460);
CREATE (para_2459)-[:NEXT_PARAGRAPH]->(para_2460);
CREATE (sec_2452)-[:NEXT_SUBSECTION]->(sec_2456);
CREATE (sec_2461:Subsection {id: '4.2.13.3.2.B', title: 'Çocuk hastalarda Kronik Hepatit C tedavisi'});
CREATE (sec_2442)-[:HAS_SUBSECTION {order: 1}]->(sec_2461);
CREATE (para_2462:Paragraph {id: '1', content: 'HCV RNA’sı pozitif hastalarda Genotip tayini ile tedaviye başlanabilir.'});
CREATE (sec_2461)-[:HAS_PARAGRAPH {order: 0}]->(para_2462);
CREATE (para_2463:Paragraph {id: '2', content: 'Kronik Hepatit C tedavisinde İnterferon+Ribavirin veya Peginterferon+Ribavirin kombinasyonu kullanılır. Ribavirin kullanımı için kontrendikasyon bulunanlarda tek başına İnterferon veya Peginterferon kullanılabilir. Tek başına Ribavirin kullanım endikasyonu yoktur.'});
CREATE (sec_2461)-[:HAS_PARAGRAPH {order: 1}]->(para_2463);
CREATE (para_2462)-[:NEXT_PARAGRAPH]->(para_2463);
CREATE (para_2464:Paragraph {id: '3', content: 'Genotip 1 ve Genotip 4 için tedavi süresi toplam 48 haftadır. Tedavi başlandıktan sonra 12 nci hafta sonunda HCV RNA düzeyleri 2 log (100 kat) azalmayanlarda tedavi süresi 16 haftayı geçemez. 24 üncü haftada HCV RNA pozitifliği devam eden hastalarda tedavi en geç 28 inci hafta sonunda kesilir. 16 ncı haftada 2 log (100 kat) azalan hastalarda ve 28 inci haftada HCV RNA (-) olan hastalarda HCV RNA analiz sonucu reçete veya raporda belirtilir. Bu süreler içinde komplikasyonlar nedeniyle tedaviye ara vermek zorunda kalınan hastalarda, belirtilen haftalar içinde süreye tekabül eden dozda ilaç alınamamışsa, ara verilme nedenleri gerekçeleri ile yeni raporda belirtilmek kaydıyla tedavi bu fıkrada belirtilen haftalık dozlara tamamlanır. Tedaviye devam kriterleri yeni rapora göre değerlendirilir.'});
CREATE (sec_2461)-[:HAS_PARAGRAPH {order: 2}]->(para_2464);
CREATE (para_2463)-[:NEXT_PARAGRAPH]->(para_2464);
CREATE (para_2465:Paragraph {id: '4', content: '3-18 yaş çocuklarda; Ribavirin dozu 15 mg/kg/gün, maksimum 1.200 mg/gündür. Peginterferon daha önce İnterferon tedavisi almamış hastalarda uygulanabilir. 96'});
CREATE (sec_2461)-[:HAS_PARAGRAPH {order: 3}]->(para_2465);
CREATE (para_2464)-[:NEXT_PARAGRAPH]->(para_2465);
CREATE (para_2466:Paragraph {id: '5', content: '12-18 yaş daha önce tedavi almamış çocuklarda; genotip tayinine gerek duyulmaksızın tedavi süresi (Glekaprevir+Pibrentasvir) ile toplam 8 haftadır.'});
CREATE (sec_2461)-[:HAS_PARAGRAPH {order: 4}]->(para_2466);
CREATE (para_2465)-[:NEXT_PARAGRAPH]->(para_2466);
CREATE (sec_2467:Subsection {id: '4.2.13.3.2.B.1', title: 'Çocuk hastalarda Kronik Hepatit C’nin yeniden tedavisi'});
CREATE (sec_2461)-[:HAS_SUBSECTION {order: 0}]->(sec_2467);
CREATE (para_2468:Paragraph {id: '1', content: 'İnterferon+Ribavirin veya Peginterferon+Ribavirin tedavisi almış ve komplikasyonlar nedeniyle tedaviye 12 nci haftadan önce son verilmiş olan 3 ilâ 18 yaş Kronik Hepatit C çocuk hastaları, tedavi almamış hastalar ile aynı kurallara tabi olarak yeniden tedaviye alınabilirler. İlk 12 hafta içinde komplikasyonlar nedeniyle tedavisine ara vermek zorunda kalınan hastalar, 12 hafta içinde 12 doz ilacı alamamışsa ara verilme nedenleri gerekçeleriyle yeni raporda belirtilmek kaydıyla tedavi 12 haftalık doza tamamlanır.'});
CREATE (sec_2467)-[:HAS_PARAGRAPH {order: 0}]->(para_2468);
CREATE (para_2469:Paragraph {id: '2', content: 'Daha önce Hepatit C tedavisi deneyimli 12 ilâ 18 yaş Kronik Hepatit C çocuk hastalarında tedavi süresi;'});
CREATE (sec_2467)-[:HAS_PARAGRAPH {order: 1}]->(para_2469);
CREATE (item_2470:Item {id: 'a', content: '(Sofosbuvir+Ledipasvir) ile; Genotip 1 için nonsirotik hastalarda 12 hafta, kompanse sirozu olan hastalarda toplam 24 hafta; Genotip 4, 5, 6 nonsirotik hastalarda veya kompanse sirozu olan hastalarda toplam 12 haftadır.'});
CREATE (para_2469)-[:HAS_ITEM {order: 0}]->(item_2470);
CREATE (item_2471:Item {id: 'b', content: '(Glekaprevir+Pibrentasvir) ile; Genotip 1, 2, 4, 5 ve 6 nonsirotik olan NS5A inhibitörü veya proteaz inhibitörü tedavisi almamış hastalarda toplam 8 hafta; Genotip 1, 2, 4, 5 ve 6 kompanse sirozu olan NS5A inhibitörü veya proteaz inhibitörü tedavisi almamış hastalarda toplam 12 hafta; Genotip 3 nonsirotik veya kompanse sirozu olan hastalarda daha önce interferon içeren (ribavirinli ya da ribavirinsiz) veya sofosbuvir almış fakat NS5A inhibitörü veya proteaz inhibitörü almamış hastalarda toplam 16 hafta; Genotip 1 nonsirotik ya da kompanse sirozu olan daha önceden proteaz inhibitörü kullanmış fakat NS5A inhibitörü almamış hastalarda 12 hafta; Genotip 1 nonsirotik ya da kompanse sirozu olan daha önceden NS5A inhibitörü kullanmış fakat proteaz inhibitörü almamış hastalarda 16 haftadır.'});
CREATE (para_2469)-[:HAS_ITEM {order: 1}]->(item_2471);
CREATE (item_2470)-[:NEXT_ITEM]->(item_2471);
CREATE (para_2468)-[:NEXT_PARAGRAPH]->(para_2469);
CREATE (sec_2451)-[:NEXT_SUBSECTION]->(sec_2461);
CREATE (sec_2436)-[:NEXT_SUBSECTION]->(sec_2442);
CREATE (sec_2432)-[:NEXT_SUBSECTION]->(sec_2435);
CREATE (sec_2339)-[:NEXT_SUBSECTION]->(sec_2379);
CREATE (sec_2472:Subsection {id: '4.2.14', title: 'Kanser tedavisinde ilaç kullanım ilkeleri'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 13}]->(sec_2472);
CREATE (para_2473:Paragraph {id: '1', content: 'Ayakta kemoterapi yapılacak kanserli hastalara tedavi protokolünü gösterir sağlık kurulu/uzman hekim raporuna dayanılarak kür tanımına uyacak tedavi uygulanıyor ise bir kürlük, kür tanımına uymayan tedavi uygulanıyor ise en fazla 3 aylık dozda ilaç verilebilir.'});
CREATE (sec_2472)-[:HAS_PARAGRAPH {order: 0}]->(para_2473);
CREATE (para_2474:Paragraph {id: '2', content: 'Kanser tedavisinde kullanılacak hormonlar ve hormon antagonistleri ile maligniteye bağlı metastatik olgularda kullanılan yardımcı ilaçlar, tedavi protokolünü gösterir uzman hekim raporuna dayanılarak 3 aylık dozlarda verilebilir. (SUT’ta bu ilaçlar için ayrıca bulunan düzenlemeler saklıdır.)'});
CREATE (sec_2472)-[:HAS_PARAGRAPH {order: 1}]->(para_2474);
CREATE (para_2473)-[:NEXT_PARAGRAPH]->(para_2474);
CREATE (para_2475:Paragraph {id: '3', content: 'Kanser tedavisinde endikasyon dışı ilaç kullanımında, tedavi protokolünü ve daha önce uygulanan kemoterapi dahil diğer tedavileri de gösteren tıbbi onkoloji veya hematoloji uzman hekimlerinden birinin bulunduğu sağlık kurulu raporu aranır. (SUT’un 4.2.14.A maddesinde belirtilen etken maddeler hariç)  Histopatolojiyle kanıtlanmış mikozis fungoides tedavisinde endikasyon dışı \"interferon-alfa-2b\"nin kullanımında, tedavi protokolünü ve daha önce uygulanan kemoterapi dahil diğer tedavileri de gösteren; tıbbi onkoloji veya hematoloji uzman hekimlerinden birinin bulunduğu veya 3 dermatoloji uzmanının yer aldığı sağlık kurulu raporu aranır.'});
CREATE (sec_2472)-[:HAS_PARAGRAPH {order: 2}]->(para_2475);
CREATE (para_2474)-[:NEXT_PARAGRAPH]->(para_2475);
CREATE (amend_2476:Amendment {content: '(Ek:RG-18/02/2017-29983/8md.Yürürlük: \n01/03/2017)'});
CREATE (sec_2472)-[:HAS_AMENDMENT {order: 0}]->(amend_2476);
CREATE (sec_2477:Subsection {id: '4.2.14.A', title: 'Tedavi protokolünü gösteren uzman hekim raporuna dayanılarak endikasyon uyumu aranmaksızın', content: 'kullanılabilecek ilaçlar'});
CREATE (sec_2472)-[:HAS_SUBSECTION {order: 0}]->(sec_2477);
CREATE (para_2478:Paragraph {id: '1', content: 'Adriamisin, asparaginaz, bleomisin, busulfan, treosulfan, dakarbazin, daktinomisin, daunorubisin, epirubisin, estramustin, etoposid, fluorourasil, folinik asit, ifosfamid, hidroksiüre, karboplatin, (Mülga:RG-26/11/2016-29900/16-a md. Yürürlük:29/11/2016) klorambusil, lomustin, methotrexat, melfalan, merkaptourin, mesna, mitoksantron, mitomisin, prokarbazin, siklofosfamid, sisplatin, sitozin arabinosid, tamoksifen, vinblastin, vinkristin.'});
CREATE (sec_2477)-[:HAS_PARAGRAPH {order: 0}]->(para_2478);
CREATE (amend_2479:Amendment {content: '(Ek:RG-19/10/2023-32344/8 md.Yürürlük:27/10/2023)'});
CREATE (sec_2477)-[:HAS_AMENDMENT {order: 0}]->(amend_2479);
CREATE (sec_2480:Subsection {id: '4.2.14.B', title: 'Tedavi protokolünü gösterir sağlık kurulu raporuna dayanılarak uzman hekimlerce reçetelendirilecek', content: 'ilaçlar'});
CREATE (sec_2472)-[:HAS_SUBSECTION {order: 1}]->(sec_2480);
CREATE (para_2481:Paragraph {id: '1', content: 'Amifostin, anastrazol, bikalutamid, buserelin, dosetaksel, eksemestan,  flutamid, gemsitabin, goserelin, ibandronik asit, interferon alfa 2a-2b, irinotekan, kapesitabin, klodronat,  letrozol, löprolid asetat, medroksiprogesteron asetat, oksaliplatin, paklitaksel, pamidronat, siproteron asetat, tegafur-urasil, topotekan, triptorelin asetat, vinorelbin, (vinorelbin tartaratın oral formları, kür protokolünde belirtilmesi ve tedaviye enjektabl form ile başlanması şartıyla kullanılır) zolendronik asit  .'});
CREATE (sec_2480)-[:HAS_PARAGRAPH {order: 0}]->(para_2481);
CREATE (para_2482:Paragraph {id: '2', content: 'Filgrastim, lenograstim, pegfilgrastim ve lipegfilgrastim; hematoloji, tıbbi onkoloji, enfeksiyon, radyasyon onkolojisi, göğüs hastalıkları, üroloji, kadın hastalıkları ve doğum uzman hekimlerinden birinin yer aldığı 6 ay süreli sağlık kurulu raporuna dayanılarak hematoloji, tıbbi onkoloji, enfeksiyon, radyasyon onkolojisi, göğüs hastalıkları, üroloji, kadın hastalıkları ve doğum, iç hastalıkları veya çocuk hastalıkları uzman hekimleri tarafından en fazla birer aylık dozlarda reçete edilmesi halinde bedelleri Kurumca karşılanır. Lenograstim etken maddeli ilacın günde 4 flakona kadar kullanımı yalnızca periferik kan progenitör hücrelerinin mobilizasyonu işleminde mümkündür.'});
CREATE (sec_2480)-[:HAS_PARAGRAPH {order: 1}]->(para_2482);
CREATE (para_2481)-[:NEXT_PARAGRAPH]->(para_2482);
CREATE (amend_2483:Amendment {content: '(Mülga: RG-28/04/2021-31468/14 md. \nYürürlük:06/05/2021)'});
CREATE (sec_2480)-[:HAS_AMENDMENT {order: 0}]->(amend_2483);
CREATE (amend_2484:Amendment {content: '(Mülga:RG-28/04/2021-31468/14 md. Yürürlük:06/05/2021)'});
CREATE (sec_2480)-[:HAS_AMENDMENT {order: 1}]->(amend_2484);
CREATE (amend_2485:Amendment {content: '(Mülga:RG-28/04/2021-31468/14 md. Yürürlük:06/05/2021)'});
CREATE (sec_2480)-[:HAS_AMENDMENT {order: 2}]->(amend_2485);
CREATE (amend_2486:Amendment {content: '(Ek: RG-28/04/2021-31468/14 md. Yürürlük:06/05/2021)'});
CREATE (sec_2480)-[:HAS_AMENDMENT {order: 3}]->(amend_2486);
CREATE (amend_2487:Amendment {content: '(Değişik:RG-02/11/2024-32710/14md. \nYürürlük:09/11/2024)'});
CREATE (sec_2480)-[:HAS_AMENDMENT {order: 4}]->(amend_2487);
CREATE (sec_2477)-[:NEXT_SUBSECTION]->(sec_2480);
CREATE (sec_2488:Subsection {id: '4.2.14.C', title: 'Özel düzenleme yapılan ilaçlar;'});
CREATE (sec_2472)-[:HAS_SUBSECTION {order: 2}]->(sec_2488);
CREATE (para_2489:Paragraph {id: '1', content: '(Mülga: RG-21/03/2018- 30367/ 23-a md. Yürürlük: 01/04/2018) fotemustin, (Mülga:RG- 10/05/2018- 30417/ 13-a md. Yürürlük:18/05/2018) interleukin-2, octreotid, lanreotid, (Mülga: RG- 30/08/2014- 29104/ 14-a md. Yürürlük: 06/09/2014) , streptozosin; tıbbi onkoloji uzman hekiminin yer aldığı sağlık kurulu raporu ile bu hekimlerce veya bu sağlık kurulu raporuna dayanılarak ikinci ve üçüncü basamak sağlık kurumlarında tüm uzman hekimlerce reçete edilir.'});
CREATE (sec_2488)-[:HAS_PARAGRAPH {order: 0}]->(para_2489);
CREATE (para_2490:Paragraph {id: '2', content: '(Değişik: RG- 26/09/2013- 28777/ 5-a md. Yürürlük: 04/10/2013) Tioguanin, tiotepa, bortezomib, talidomid, kladribin, anagrelid, idarubisin, pentostatin, (Mülga:RG-19/10/2023-32344/9-a md. Yürürlük:27/10/2023) fludarabin, tretinoin, klofarabine, bendamustin; tıbbi onkoloji veya hematoloji uzman hekimlerinden en az birinin yer aldığı sağlık kurulu raporuna dayanılarak bu hekimlerce veya bu sağlık kurulu raporuna dayanılarak ikinci ve üçüncü basamak sağlık kurumlarında tüm uzman hekimlerce reçete edilir. 97'});
CREATE (sec_2488)-[:HAS_PARAGRAPH {order: 1}]->(para_2490);
CREATE (para_2489)-[:NEXT_PARAGRAPH]->(para_2490);
CREATE (para_2491:Paragraph {id: '3', content: 'Bu fıkrada belirtilen ilaç grupları için bu maddede ilaca yönelik özel rapor süresi düzenlemesi yapılmamış ise en fazla bir yıl süreli sağlık kurulu raporlarında, tedavi protokolü ve teşhise esas teşkil eden radyoloji, patoloji veya sitoloji raporunun merkezi, tarihi ve numarası veya teşhise esas teşkil eden bilgiler, evre veya risk grubu, varsa daha önce uygulanan kanser tedavi planı bulunmalıdır. (Değişik: RG- 18/02/2015- 29271/ 12-a md. Yürürlük: 28/02/2015)'});

// Batch 67
CREATE (sec_2488)-[:HAS_PARAGRAPH {order: 2}]->(para_2491);
CREATE (item_2492:Item {id: 'a', content: 'Trastuzumab; 1) HER-2 immünhistokimya ile +3 veya FISH/CISH/SISH (+) olan hastalarda, metastatik meme kanseri endikasyonunda, bu durumun belirtildiği tıbbi onkoloji uzman hekiminin yer aldığı sağlık kurulu raporuna dayanılarak tıbbi onkoloji uzman hekimlerince reçete edilir. Trastuzumab kullanılırken progresyon gelişmesi halinde tedavi sonlandırılır. (Değişik: RG- 25/08/2022- 31934/ 27-a md. Yürürlük: 03/09/2022) endikasyonunda, tedavi süresi 9 haftadır. Sağlık Bakanlığı’nın ilaca ilişkin düzenlemesi esas alınarak tedavinin 52 haftaya tamamlanması düşünülen durumlarda, 9 haftalık tedaviden sonra en az bir tıbbi onkoloji uzman hekiminin bulunduğu ve ekokardiyografi değerlendirmesinin de yer aldığı 3 ay süreli sağlık kurulu raporu ile bu hekimlerce reçete edilir. Toplam tedavi süresi 52 haftayı geçemez. uygulanmamış olup, Her-2 neu pozitifliği, hem immunhistokimyasal yöntemle +2/+3 hem de FISH/CISH/SISH ile pozitif olarak saptananlarda; platin ve kapesitabin ya da platin ve 5-Fluorourasil içeren kemoterapi rejimleri ile kombine olarak kullanılabilir. Progresyon gelişmesi halinde tedavi sonlandırılır. Tıbbi onkoloji uzman hekiminin yer aldığı sağlık kurulu raporu ile tıbbi onkoloji uzman hekimlerince reçete edilir. (Mülga: RG-09/05/2020-31122/1-a md. Yürürlük: 16/05/2020) (Değişik: RG- 04/02/2018- 30322/ 16-a md. Yürürlük: 15/02/2018)'});
CREATE (para_2491)-[:HAS_ITEM {order: 0}]->(item_2492);
CREATE (subitem_2493:SubItem {id: '2', content: 'HER-2 immünhistokimya ile +3 veya FISH/CISH/SISH (+) olan hastalarda, erken evre meme kanseri'});
CREATE (item_2492)-[:HAS_SUBITEM {order: 0}]->(subitem_2493);
CREATE (subitem_2494:SubItem {id: '3', content: 'Metastatik mide veya özofagogastrik bileşke yerleşimli adenokanserli hastalardan daha önce kemoterapi'});
CREATE (item_2492)-[:HAS_SUBITEM {order: 1}]->(subitem_2494);
CREATE (subitem_2493)-[:NEXT_SUBITEM]->(subitem_2494);
CREATE (item_2495:Item {id: 'c', content: 'BCG canlı intravezikal; Tıbbi onkoloji veya üroloji uzman hekimlerinden birinin yer aldığı, tedavi protokolü ve teşhise esas teşkil eden radyoloji, patoloji veya sitoloji raporu ile hastalığın evresi veya risk grubunu gösterir en fazla bir yıl süreli sağlık kurulu raporuna dayanılarak üroloji uzman hekimleri tarafından reçete edilmesi halinde bedeli ödenir. (Değişik: RG-28/04/2021-31468/ 15-a md. Yürürlük: 06/05/2021)'});
CREATE (para_2491)-[:HAS_ITEM {order: 1}]->(item_2495);
CREATE (item_2492)-[:NEXT_ITEM]->(item_2495);
CREATE (item_2496:Item {id: 'ç', content: 'Fulvestrant; eksemestan veya letrozol)] sırasında veya sonrasında nüks gelişen (Değişik:RG-19/10/2023-32344/9-b md. Yürürlük:27/10/2023) pre/peri/postmenopozal (doğal veya yapay yollarla) lokal ileri veya metastatik meme kanseri olan hastalarda, en az bir tıbbi onkoloji uzman hekiminin yer aldığı (Değişik:RG-25/08/2022-31934/27-b md. Yürürlük:03/09/2022) tedavi protokolünü gösterir sağlık kurulu raporuna istinaden tüm uzman hekimler tarafından reçete edilmesi halinde Kurumca bedelleri karşılanır. (Değişik:RG-19/10/2023-32344/9-b md. Yürürlük:27/10/2023) pre/peri/postmenopozal nüks/metastatik meme kanseri olan hastalarda en az bir tıbbi onkoloji uzman hekiminin yer aldığı en fazla 6 ay süreli sağlık kurulu raporuna istinaden tıbbi onkoloji uzman hekimleri tarafından reçete edilmesi halinde aşağıda yer alan kriterler çerçevesinde Kurumca bedelleri karşılanır. a. Nüks/metastatik meme kanseri tedavisi için birinci sıra aromataz inhibitörü tedavisini 6 aydan daha uzun süre kullandıktan sonra klinik ve/veya radyolojik hastalık progresyonu varlığında ribosiklib veya palbosiklib ile kombine olarak kullanılması halinde Kurumca bedelleri karşılanır. Daha önce fulvestrant tedavisi almış veya adjuvan aromataz inhibitörü tedavisinin ilk 12 ayı içinde relaps yapan veya metastatik hastalık için bir sıradan daha fazla aromataz inhibitörü almış hastalarda kullanılması halinde Kurumca bedelleri karşılanmaz. b. Adjuvan aromataz inhibitörü tedavisi devam ederken (en az 12 ay tedavi almış olmak şartıyla) ya da bu tedavi tamamlandıktan sonraki 12 ay içinde nüks/metastaz görülen hastalarda ribosiklib veya palbosiklib ile kombine olarak kullanılması halinde Kurumca bedelleri karşılanır. Daha önce fulvestrant tedavisi almış veya adjuvan aromataz inhibitörü tedavisinin ilk 12 ayı içinde relaps yapan veya metastatik hastalık için bir sıradan daha fazla aromataz inhibitörü almış hastalarda kullanılması halinde Kurumca bedelleri karşılanmaz. c. Rapor süresinin sonunda tedavinin devamı için düzenlenecek yeni raporda hastalıkta progresyon olmadığı belirtilmelidir.'});
CREATE (para_2491)-[:HAS_ITEM {order: 2}]->(item_2496);

CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 7}]->(para_3757);
CREATE (item_3758:Item {id: 'a', content: 'Depocuya satış fiyatı 39,04 (otuz dokuz virgül sıfır dört) TL ve altında olan ilaçlar için kamu kurum iskontosu uygulanmaz (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3757)-[:HAS_ITEM {order: 0}]->(item_3758);
CREATE (item_3759:Item {id: 'b', content: 'Depocuya satış fiyatı 39,05 (otuz dokuz virgül sıfır beş) TL (dahil) ile 74,72 (yetmiş dört virgül yetmiş iki) TL (dahil) arasında olan ilaçlara; %11 baz iskonto uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3757)-[:HAS_ITEM {order: 1}]->(item_3759);
CREATE (item_3758)-[:NEXT_ITEM]->(item_3759);
CREATE (item_3760:Item {id: 'c', content: 'Depocuya satış fiyatı 74,73 (yetmiş dört virgül yetmiş üç) TL (dahil) ile 112,58 (yüz on iki virgül elli sekiz) TL (dahil) arasında olan ilaçlara; %31 iskonto (baz iskonto %11+%20 ilave iskonto) uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3757)-[:HAS_ITEM {order: 2}]->(item_3760);
CREATE (item_3759)-[:NEXT_ITEM]->(item_3760);
CREATE (item_3761:Item {id: 'ç', content: 'Depocuya satış fiyatı 112,59 (yüz on iki virgül elli dokuz) TL ve üzerinde olan ilaçlara; %41 iskonto (baz iskonto %11+%30 ilave iskonto) uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3757)-[:HAS_ITEM {order: 3}]->(item_3761);
CREATE (item_3760)-[:NEXT_ITEM]->(item_3761);
CREATE (para_3756)-[:NEXT_PARAGRAPH]->(para_3757);
CREATE (para_3762:Paragraph {id: '9', content: 'Piyasaya verilecek, mevcut EK-4/A listesinde bulunmayan yeni moleküller ile tedaviye yenilik getirecek ürünlerin EK-4/A listesine kabulü halinde, bu ürünler listeye girdiği tarihten itibaren 1 yıl süre ile ilave iskontolardan muaf tutulur. Bu süre; SUT’un “4.3- Yurt dışından ilaç getirilmesi” başlıklı maddesinin sekizinci fıkrası kapsamında Kurumca ödemesi yapılan 148 ilaçlar için EK-4/A listesine giriş talebi tarihinden itibaren başlar. Molekülün ilave iskontodan muafiyeti açısından 1 yıllık süresi, tüm farmasötik formları için listeye ilk giren forma uygulanan süre bitiminde sona erer.'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 8}]->(para_3762);
CREATE (para_3757)-[:NEXT_PARAGRAPH]->(para_3762);
CREATE (para_3763:Paragraph {id: '10', content: 'EK-4/A listesinde yer alıp, Sağlık Hizmetleri Fiyatlandırma Komisyonu tarafından kamu kurum iskontosu ayrıca belirlenen ilaçlar için bu maddenin (4), (5) ve (6) numaralı fıkraları uygulanmaz.'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 9}]->(para_3763);
CREATE (para_3762)-[:NEXT_PARAGRAPH]->(para_3763);
CREATE (para_3764:Paragraph {id: '11', content: 'Ayakta veya yatarak tanı ve tedavi hizmeti sunan sözleşmeli sağlık hizmeti sunucuları, ayakta veya yatarak tedavilerde kullandıkları ve kendi eczanelerinden temin ettikleri ilaçlara da Kurum eşdeğer ilaç uygulaması ile belirlenen azami birim bedel esas alınmak suretiyle yukarıda belirtilen esaslara göre kamu kurum iskontosu ile %3,5 oranında eczacı indirimi uygulayarak fatura edeceklerdir. Ayakta veya yatarak tanı ve tedavi hizmeti sunan sözleşmeli sağlık hizmeti sunucularının ilaç satın alma bedeli ile eşdeğer ilaçların Kurumca ödenen azami fiyatları arasında fark oluşması halinde fark ücreti kişilerden talep edilemez. Serbest eczane satışı olmayan ve Sağlık Bakanlığı tarafından “depocu fiyatlı ilaçlar” şeklinde tanımlanan ürünlere, depocu satış fiyatı üzerinden EK-4/A listesinde gösterilen indirim oranları (özel iskontolar dahil) uygulanır, ayrıca eczacı indirimi uygulanmaz.'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 10}]->(para_3764);
CREATE (para_3763)-[:NEXT_PARAGRAPH]->(para_3764);
CREATE (para_3765:Paragraph {id: '12', content: 'Sağlık Bakanlığı tarafından perakende satış fiyatı verilen ürünlere, perakende satış fiyatı üzerinden EK-4/A listesinde gösterilen indirim oranları (özel iskontolar dahil) uygulanmak suretiyle, ilaçların indirimli bedeli (kamu fiyatı) bulunur. Ayrıca tüm ilaçlara indirimli bedel üzerinden eczacı indirimi yapılır.'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 11}]->(para_3765);
CREATE (para_3764)-[:NEXT_PARAGRAPH]->(para_3765);
CREATE (amend_3766:Amendment {content: '(Değişik: RG- 26/10/2021- 31640/ 10 md. Yürürlük: 26/10/2021)'});
CREATE (sec_3739)-[:HAS_AMENDMENT {order: 0}]->(amend_3766);
CREATE (amend_3767:Amendment {content: '(Değişik: RG- 29/12/2023- 32414/ 1 md. Yürürlük: 29/12/2023)'});
CREATE (sec_3739)-[:HAS_AMENDMENT {order: 1}]->(amend_3767);
CREATE (sec_3768:Subsection {id: '4.4.2', title: 'İç Referans Fiyatlandırma Uygulaması'});
CREATE (sec_3735)-[:HAS_SUBSECTION {order: 1}]->(sec_3768);
CREATE (para_3769:Paragraph {id: '1', content: 'İç referans fiyatlandırma uygulaması; aynı endikasyonlar için kullanılabilecek etken maddeleri içeren ürünlerin benzer dozaj formları arasında birim fiyat karşılaştırması esasına dayanır. Kurum, iç referans fiyatlandırma uygulaması kapsamında gruplar oluşturabilir.'});

// Batch 101
CREATE (sec_3768)-[:HAS_PARAGRAPH {order: 0}]->(para_3769);
CREATE (item_3770:Item {id: 'a', content: 'Eşdeğer grup uygulaması; aynı etken maddeyi aynı dozda içeren benzer dozaj formundaki ilaçlar aynı eşdeğer grupta değerlendirilir, bu ilaçlar eczanede ikame edilebilir.'});
CREATE (para_3769)-[:HAS_ITEM {order: 0}]->(item_3770);
CREATE (item_3771:Item {id: 'b', content: 'Eşdeğer grup uygulaması dışında yapılan diğer iç referans fiyatlandırma uygulamaları arasında; aynı etken maddeyi içermekle birlikte Sağlık Bakanlığınca ruhsatlı endikasyonlarında farklılık olan ilaçlardan oluşan gruplar, aynı etken maddeyi içermekle birlikte Sağlık Bakanlığınca cihaz-direnç farklılıkları belirtilen ilaçlardan oluşan gruplar, aynı etken maddeyi içermekle birlikte hasta sağlığının korunması ve Sağlık Bakanlığınca eczane ikamesinin emniyetli olmadığı belirtilen ilaçlardan oluşan gruplar ile akılcı ilaç kullanımı çerçevesinde değerlendirilen ve hastaların tedaviye erişiminde zorluk oluşturmayacağı komisyonlar tarafından belirlenen ilaçlardan oluşan gruplar yer alır. Ancak bu gruplarda yer almakla birlikte farklı eşdeğer gruplarda bulunan ilaçlar eczanede ikame edilemez.'});
CREATE (para_3769)-[:HAS_ITEM {order: 1}]->(item_3771);
CREATE (item_3770)-[:NEXT_ITEM]->(item_3771);
CREATE (para_3772:Paragraph {id: '2', content: 'İç referans fiyatlandırma uygulaması kapsamında yer alan ilaçlara ait ödemelerde, grubun en ucuz ilaç bedelinin %5 fazlasına kadarı dikkate alınacaktır.'});
CREATE (sec_3768)-[:HAS_PARAGRAPH {order: 1}]->(para_3772);
CREATE (item_3773:Item {id: 'a', content: 'Bu esaslara göre belirlenen gruplarda; SUT’un 4.4.1 maddesinde belirtilen kamu kurum iskontoları ile belirlenen kamu fiyatı üzerinden gruptaki ilaçların ortak en küçük birimi başına düşen “indirimli birim bedeller” karşılaştırılarak en ucuz birim bedel bulunur. Bulunan en ucuz birim bedele %5 ilave edilerek o gruptaki ilaçlar için ödenebilecek azami birim bedel bulunur. Bu şekilde bulunan ödenebilecek azami birim bedel esas alınarak, gruptaki her bir ilacın ambalaj formuna göre o ilaca özgü kutu bedeli hesaplanır ve ortaya çıkan bu kutu fiyatı, aynı ilacın kamu fiyatı ile karşılaştırılır. Kamu fiyatının, azami birim bedelden yola çıkılarak hesaplanan kutu fiyatını aşan kısmı ödenmez.'});
CREATE (para_3772)-[:HAS_ITEM {order: 0}]->(item_3773);
CREATE (item_3774:Item {id: 'b', content: 'Hastalar ve eczaneler tarafından ulaşılabilir olması amacıyla azami birim bedelin hesaplanmasına esas olan en ucuz ilacın belirlenmesinde Kurum tarafından tespit edilebilen son 5 aylık verinin en az 1 ayında grup içinde %1 pazar payına sahip olması hususu gözetilir. Söz konusu süre ve pazar payının her bir ilaç grubundaki ilaç sayısı dikkate alınarak yeniden belirlenmesinde ve bunlara ilişkin tereddütlerin giderilmesinde “Sağlık Hizmetleri Fiyatlandırma Komisyonu” yetkilidir.'});
CREATE (para_3772)-[:HAS_ITEM {order: 1}]->(item_3774);
CREATE (item_3773)-[:NEXT_ITEM]->(item_3774);
CREATE (para_3769)-[:NEXT_PARAGRAPH]->(para_3772);
CREATE (sec_3739)-[:NEXT_SUBSECTION]->(sec_3768);
CREATE (sec_3721)-[:NEXT_SECTION]->(sec_3735);
CREATE (sec_3775:Section {id: '4.5', title: 'Eczanelerden ilaç temini'});
CREATE (doc_1)-[:HAS_SECTION {order: 24}]->(sec_3775);
CREATE (sec_3776:Subsection {id: '4.5.1', title: 'Kişilerin acil durumlarda sözleşmesiz eczanelerden temin ettikleri ilaç bedelinin ödenmesi'});
CREATE (sec_3775)-[:HAS_SUBSECTION {order: 0}]->(sec_3776);
CREATE (para_3777:Paragraph {id: '1', content: 'Reçete edilen ilaçların, Kurumla sözleşme yapan eczanelerden temin edilmesi halinde bedelleri ödenir.'});
CREATE (sec_3776)-[:HAS_PARAGRAPH {order: 0}]->(para_3777);
CREATE (para_3778:Paragraph {id: '2', content: 'Acil haller dışında Kurum ile sözleşmesi olmayan eczanelerden temin edilen ilaçların bedelleri Kurumca karşılanmaz. Kurum sağlık yardımlarından yararlandırılan kişilerin sözleşmesiz eczanelerden acil haller nedeniyle temin ettikleri ilaç bedelleri acil halin Kurumca kabul edilmesi şartıyla karşılanır. Bu şekilde temin edilen ilacın/ilaçların, SUT’un 4.4 maddesinde belirtildiği şekilde kamu iskontosu ile en yüksek eczacı iskontosu ve hasta katılım payı düşüldükten sonra, kalan kısım Kurum tarafından ilgiliye ödenecektir. Bu ödemenin yapılabilmesi için, reçeteye ilaçların fiyat kupürlerinin tamamı ilacın ismi de yer alacak şekilde yapıştırılacaktır. Eczane tarafından verilen ilaçları ve tutarını gösteren faturanın da ilaç fiyat kupürleri yapıştırılmış olan reçete ile birlikte ibrazı zorunludur. Ayrıca Kuzey Kıbrıs Türk Cumhuriyetinde; eczaneler ile sözleşme yapılıncaya kadar bu ülkedeki Kurumla sözleşmeli sağlık hizmeti sunucularınca düzenlenen reçete bedelleri, SUT’un 4.4 maddesinde belirtildiği şekilde kamu iskontosu ile en yüksek eczacı iskontosu ve ilaç katılım payı düşüldükten sonra, kalan kısım Kurum tarafından ilgiliye ödenecektir. Ödeme için, eczane tarafından verilen ilaçları ve tutarını gösteren faturanın ilaç fiyat kupürleri/karekodları ile birlikte ibraz edilmesi gerekir.'});
CREATE (sec_3776)-[:HAS_PARAGRAPH {order: 1}]->(para_3778);
CREATE (para_3777)-[:NEXT_PARAGRAPH]->(para_3778);
CREATE (para_3779:Paragraph {id: '3', content: 'Kurum ilaç ödemesinde, ilacın veriliş tarihindeki perakende satış fiyatları esas alınır.'});
CREATE (sec_3776)-[:HAS_PARAGRAPH {order: 2}]->(para_3779);
CREATE (para_3778)-[:NEXT_PARAGRAPH]->(para_3779);
CREATE (amend_3780:Amendment {content: '(Ek: RG- 30/08/2014- 29104/ 18 md. Yürürlük: 18/04/2014)'});
CREATE (sec_3776)-[:HAS_AMENDMENT {order: 0}]->(amend_3780);
CREATE (sec_3781:Subsection {id: '4.5.2', title: 'Reçetelerin geçerli olduğu süre'});
CREATE (sec_3775)-[:HAS_SUBSECTION {order: 1}]->(sec_3781);
CREATE (para_3782:Paragraph {id: '1', content: 'İlaçlar reçetenin tanzim tarihinden itibaren 4 işgünü içinde sözleşme yapılan eczanelerden temin edilecektir. Bu sürenin dışındaki müracaatlarda reçete muhteviyatı ilaçlar eczanece verilmeyecektir.'});
CREATE (sec_3781)-[:HAS_PARAGRAPH {order: 0}]->(para_3782);
CREATE (para_3783:Paragraph {id: '2', content: 'Sağlık raporuna dayanılarak yazılan reçetelerde, EK-4/D Listesinde bulunan veya bulunmayan (kür ve tedavi planı olan ilaçlar hariç) ilaçlar, ilaç bitim tarihinden 15 gün öncesinde verilebilir.'});
CREATE (sec_3781)-[:HAS_PARAGRAPH {order: 1}]->(para_3783);
CREATE (para_3782)-[:NEXT_PARAGRAPH]->(para_3783);
CREATE (sec_3776)-[:NEXT_SUBSECTION]->(sec_3781);
CREATE (sec_3784:Subsection {id: '4.5.3', title: 'İlaç bedellerinin ödenmesi'});
CREATE (sec_3775)-[:HAS_SUBSECTION {order: 2}]->(sec_3784);
CREATE (para_3785:Paragraph {id: '1', content: 'Sağlık kurum ve kuruluşlarında yatarak sağlanan tedaviler sonucu doğan ilaç bedelleri SUT hükümlerine uyulmak kaydıyla Kurum tarafından karşılanır.'});
CREATE (sec_3784)-[:HAS_PARAGRAPH {order: 0}]->(para_3785);
CREATE (para_3786:Paragraph {id: '2', content: 'Ayakta yapılan tedavilerde kullanılan ilaç bedellerinden, ilaç kurum indirimi, eczane tarafından yapılan indirim ile birlikte hasta katılım payı düşüldükten sonra kalan tutarlar Kurum tarafından ödenecektir. 149'});
CREATE (sec_3784)-[:HAS_PARAGRAPH {order: 1}]->(para_3786);
CREATE (para_3785)-[:NEXT_PARAGRAPH]->(para_3786);
CREATE (sec_3781)-[:NEXT_SUBSECTION]->(sec_3784);
CREATE (sec_3787:Subsection {id: '4.5.4', title: 'İlaç takip sistemi'});
CREATE (sec_3775)-[:HAS_SUBSECTION {order: 3}]->(sec_3787);
CREATE (para_3788:Paragraph {id: '1', content: 'Sağlık Bakanlığı “İlaç Takip Sistemi”ne kayıt edilmiş karekodlu ilaçların Kuruma fatura edilmesinde Kurumca belirlenecek usul ve esaslara göre işlem yapılacaktır.'});
CREATE (sec_3787)-[:HAS_PARAGRAPH {order: 0}]->(para_3788);
CREATE (sec_3784)-[:NEXT_SUBSECTION]->(sec_3787);
CREATE (sec_3735)-[:NEXT_SECTION]->(sec_3775);
CREATE (sec_3789:Section {id: '4.6', title: 'Kan ve kan bileşenlerinin temini ve bedelinin ödenmesi'});
CREATE (doc_1)-[:HAS_SECTION {order: 25}]->(sec_3789);
CREATE (para_3790:Paragraph {id: '1', content: 'Kan ihtiyacının karşılanmasında güvenli kan temini esas olup, hasta yakınlarının kan verecek kişileri bulmasının sebep olduğu sağlık ve sosyal sorunları önlemek için, Kızılay kan birimlerinde kan ve kan bileşenlerinin bulunduğu durumlarda, replasman kan alınma yöntemi tercih edilmeyecektir.'});
CREATE (sec_3789)-[:HAS_PARAGRAPH {order: 0}]->(para_3790);
CREATE (para_3791:Paragraph {id: '2', content: 'İkinci ve üçüncü basamak sağlık kurum ve kuruluşlarınca, hastalar için hekimler tarafından gerekli görülen kan ve kan bileşenleri (eritrosit süspansiyonu, tam kan, trombosit, plazma, vb.), Sağlık Bakanlığınca ruhsatlandırılmış kan hizmet birimleri ile Kızılay’a ait kan birimi bulunan yerlerde, bu birimlerden temin edilir. Sağlık kurum ve kuruluşlarınca, hastalara kan temin ettirilmeyecektir. Sağlık kurum ve kuruluşlarınca temin edilmesi zorunlu olduğu halde temin edilmeyerek hastaya aldırılan kan ve kan bileşenlerine ait fatura bedeli hastaya ödenir ve ilgili sağlık kurum ve kuruluşlarından mahsup edilir.'});
CREATE (sec_3789)-[:HAS_PARAGRAPH {order: 1}]->(para_3791);
CREATE (para_3790)-[:NEXT_PARAGRAPH]->(para_3791);
CREATE (para_3792:Paragraph {id: '3', content: 'SUT eki EK-2/B Listesi üzerinden faturalandırılan tedaviler için kullanılması gerekli görülen ve sağlık kurumlarınca temin edilen kan ve kan bileşenlerinin bedelleri, epikrizde kan bileşeninin adı, sayısı, (Değişik: RG-08/06/2017- 30090/ 16-a md. Yürürlük: 19/06/2017) ISBT (International Society of Blood Transfusion) 128 kan barkod numaralarının belirtilmesi kaydıyla, SUT eki EK-2/B Listesi puanları esas alınarak Kurumca sağlık kurum ve kuruluşuna ödenir.'});
CREATE (sec_3789)-[:HAS_PARAGRAPH {order: 2}]->(para_3792);
CREATE (para_3791)-[:NEXT_PARAGRAPH]->(para_3792);
CREATE (para_3793:Paragraph {id: '4', content: 'SUT eki EK-2/C Listesi kapsamında yer alan işlemler için sağlık kurum ve kuruluşlarında kullanılan kan ve kan bileşenleri, tanıya dayalı işlem puanlarına dâhil olduğundan Kuruma fatura edilemez.  (Ancak 705371, 705430 ve 705440 kodlu kan bileşenlerinin tanıya dayalı işlemler kapsamında kullanılması halinde bu kan bileşenlerinin puanının  %36’sı , 705372 ve 705373 kodlu kan bileşenlerinin kullanılması halinde  %24’ü, 705441 kodlu kan bileşenin kullanılması halinde  %20’si, 705442 ve 705443 kodlu kan bileşenlerinin kullanılması halinde ise  %28’i sağlık hizmeti sunucusunca ayrıca faturalandırılır. Tüm kan bileşenlerinin (Ek: RG- 08/06/2017- 30090/ 16-b md. Yürürlük: 19/06/2017) ISBT (International Society of Blood Transfusion) 128 kan barkod numaraları ile birlikte MEDULA sistemine kaydedilmesi zorunludur.)'});
CREATE (sec_3789)-[:HAS_PARAGRAPH {order: 3}]->(para_3793);
CREATE (para_3792)-[:NEXT_PARAGRAPH]->(para_3793);
CREATE (amend_3794:Amendment {content: '(Ek: RG- 25/08/2016- 29812/ 20 md. \nYürürlük: 24/07/2016)'});
CREATE (sec_3789)-[:HAS_AMENDMENT {order: 0}]->(amend_3794);
CREATE (amend_3795:Amendment {content: '(Değişik: RG- 11/10/2017- 30207/ 3 md. Yürürlük: 01/10/2017)'});
CREATE (sec_3789)-[:HAS_AMENDMENT {order: 1}]->(amend_3795);
CREATE (amend_3796:Amendment {content: '(Ek: RG- 25/03/2017- 30018/ 23 md. Yürürlük: 05/04/2017)'});
CREATE (sec_3789)-[:HAS_AMENDMENT {order: 2}]->(amend_3796);
CREATE (amend_3797:Amendment {content: '(Değişik: RG- 11/10/2017- 30207/ 3 md. Yürürlük: 01/10/2017)'});
CREATE (sec_3789)-[:HAS_AMENDMENT {order: 3}]->(amend_3797);
CREATE (amend_3798:Amendment {content: '(Değişik: RG- 11/10/2017- 30207/ 3 md. Yürürlük: 01/10/2017)'});
CREATE (sec_3789)-[:HAS_AMENDMENT {order: 4}]->(amend_3798);
CREATE (amend_3799:Amendment {content: '(Değişik: RG- 11/10/2017- 30207/ 3 md. Yürürlük: 01/10/2017)'});
CREATE (sec_3789)-[:HAS_AMENDMENT {order: 5}]->(amend_3799);
CREATE (sec_3775)-[:NEXT_SECTION]->(sec_3789);
CREATE (sec_3800:Section {id: '4.7', title: 'Faktör ve diğer kan ürünlerinin reçete edilmesi ve hemofili hastalarının bildirim zorunluluğu'});
CREATE (doc_1)-[:HAS_SECTION {order: 26}]->(sec_3800);
CREATE (para_3801:Paragraph {id: '1', content: 'Hemofili teşhisi konulan hastalar, teşhisi koyan hastane tarafından “Hemofili Bildirim Formu” düzenlenerek, Sağlık Bakanlığına bildirilecektir.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 0}]->(para_3801);
CREATE (para_3802:Paragraph {id: '2', content: 'Hemofili hastaları bildirim formu eksiksiz olarak doldurulacaktır.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 1}]->(para_3802);
CREATE (para_3801)-[:NEXT_PARAGRAPH]->(para_3802);
CREATE (para_3803:Paragraph {id: '3', content: 'Hemofili hastaları için en az bir hematoloji uzman hekiminin imzasının da bulunduğu sağlık kurulu raporu düzenlenecektir. Hemofili hastaları için düzenlenen sağlık kurulu raporlarında, faktör düzeyleri ve hematoloji uzman hekimi ibaresi mutlaka belirtilecektir. Hematoloji uzman hekiminin olmadığı hastanelerde sağlık kurul raporu üç iç hastalıkları ya da üç çocuk sağlığı ve hastalıkları uzman hekimi tarafından da düzenlenebilir. .'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 2}]->(para_3803);
CREATE (para_3802)-[:NEXT_PARAGRAPH]->(para_3803);
CREATE (para_3804:Paragraph {id: '4', content: 'Hemofili reçetelerinin; hematoloji, iç hastalıkları veya çocuk sağlığı ve hastalıkları uzman hekimlerinden biri tarafından ilgili mevzuata uygun olarak düzenlenmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 3}]->(para_3804);
CREATE (para_3803)-[:NEXT_PARAGRAPH]->(para_3804);
CREATE (para_3805:Paragraph {id: '5', content: 'Faktör dışındaki diğer kan ürünleri de özel renkte (mor) “Kan Ürünleri Reçetesi”ne yazılacaktır. Hastanede yatan hastalar için de aynı reçete kullanılacaktır.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 4}]->(para_3805);
CREATE (para_3804)-[:NEXT_PARAGRAPH]->(para_3805);
CREATE (para_3806:Paragraph {id: '6', content: 'Kan ürünü reçeteleri, ilgili birimlerden alınacak sağlık kurulu raporlarına bağlı olarak uzman hekimler tarafından yazılabilecektir. Ancak, acil hallerde kullanılması zorunlu olan ürünlerden yalnız tetanos ve anti D immünglobulinleri ile larenks ödemi ile başvuran herediter anjiyoödem tanılı hastaların acil (akut) tedavisinde C1 esteraz inhibitörleri için sağlık kurulu raporu ve mor reçete şartı aranmayacaktır. Hastanelerde yatan hastalarda, faktör dışındaki kan ürünleri için sağlık raporu gerekli değildir. Yeterli uzman hekimi olmayan yerlerde, çıkan vakalara vaktinde müdahale edilebilmesi için yalnız kuduz ve tetanos immunglobulinleri pratisyen hekim tarafından da kan ürünleri reçetesine yazılabilir.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 5}]->(para_3806);
CREATE (para_3805)-[:NEXT_PARAGRAPH]->(para_3806);
CREATE (para_3807:Paragraph {id: '8', content: 'Hemofili takip karnesini alamadan herhangi bir nedenle hastalanmış olanların ilaçları, ilgili uzman hekimler tarafından, bir kereye mahsus olmak üzere sağlık kurulu raporuna istinaden “Kan Ürünleri Reçetesi”ne yazılabilir. Karnesiz ikinci defa tedavi görme imkânı olmadığından, tedaviden sonra hastaların, sağlık kurulu raporu ile birlikte vakit geçirmeden hemofili takip karnesi alabilmek için İl Sağlık Müdürlüklerine müracaat etmeleri gerekmektedir.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 6}]->(para_3807);
CREATE (para_3806)-[:NEXT_PARAGRAPH]->(para_3807);

// Batch 102
CREATE (para_3808:Paragraph {id: '9', content: 'Kan ürünü veren eczaneler, reçetelerin ilk nüshası ile birlikte reçete bilgilerini de içeren “Hemofili Reçete Formunu” ve “Kan Ürünleri Reçete Formunu” doldurarak her ay İl Sağlık Müdürlüklerine gönderecektir.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 7}]->(para_3808);
CREATE (para_3807)-[:NEXT_PARAGRAPH]->(para_3808);
CREATE (para_3809:Paragraph {id: '10', content: 'İl Sağlık Müdürlükleri, eczanelerin gönderdiği form ve beraberindeki reçeteleri kontrol ettikten sonra, tüm formları birleştirerek tek bir form halinde Sağlık Bakanlığına gönderecektir.'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 8}]->(para_3809);
CREATE (para_3808)-[:NEXT_PARAGRAPH]->(para_3809);
CREATE (para_3810:Paragraph {id: '11', content: 'Kan ürünleri ve faktörlerden hasta katılım payı alınmayacaktır. BEŞİNCİ BÖLÜM Faturalandırma ve Ödeme İşlemleri'});
CREATE (sec_3800)-[:HAS_PARAGRAPH {order: 9}]->(para_3810);
CREATE (para_3809)-[:NEXT_PARAGRAPH]->(para_3810);
CREATE (amend_3811:Amendment {content: '(Değişik:RG-10/05/2018-30417/ 24 md. Yürürlük:18/05/2018)'});
CREATE (sec_3800)-[:HAS_AMENDMENT {order: 0}]->(amend_3811);
CREATE (amend_3812:Amendment {content: '(Mülga:RG- 04/09/2019- 30878/ 44 md. Yürürlük: 12/09/2019)'});
CREATE (sec_3800)-[:HAS_AMENDMENT {order: 1}]->(amend_3812);
CREATE (amend_3813:Amendment {content: '(Mülga:RG- 10/05/2018-30417/ 24 md. Yürürlük:18/05/2018)'});
CREATE (sec_3800)-[:HAS_AMENDMENT {order: 2}]->(amend_3813);
CREATE (amend_3814:Amendment {content: '(Değişik: RG- 04/02/2018- 30322/ 19 md. Yürürlük: 01/01/2018)'});
CREATE (sec_3800)-[:HAS_AMENDMENT {order: 3}]->(amend_3814);
CREATE (sec_3789)-[:NEXT_SECTION]->(sec_3800);
CREATE (sec_3815:Section {id: '5.1', title: 'MEDULA sistemi', content: '150'});
CREATE (doc_1)-[:HAS_SECTION {order: 27}]->(sec_3815);
CREATE (para_3816:Paragraph {id: '1', content: 'Kurumla  sözleşmeli sağlık hizmeti sunucularına, sundukları sağlık hizmetlerine ilişkin bedellerin ödenebilmesi için Kurum mevzuatı gereği istenilen bilgilerin belirlenen istisnalar hariç olmak üzere MEDULA sistemine girilmesi zorunludur.'});
CREATE (sec_3815)-[:HAS_PARAGRAPH {order: 0}]->(para_3816);
CREATE (para_3817:Paragraph {id: '2', content: 'Kurumca “MEDULA Web Servisleri Kullanım Kılavuzu” ayrıca yayımlanmakta olup sağlık hizmeti sunucularının MEDULA entegrasyonu için yapacakları yazılımlar Kılavuzdaki açıklamalara göre gerçekleştirilir.'});
CREATE (sec_3815)-[:HAS_PARAGRAPH {order: 1}]->(para_3817);
CREATE (para_3816)-[:NEXT_PARAGRAPH]->(para_3817);
CREATE (para_3818:Paragraph {id: '3', content: 'Ayrıca Kurumla  sözleşmeli sağlık hizmeti sunucularının, sundukları sağlık hizmetlerine ilişkin bedellerin ödenebilmesi için, Kurumca belirlenecek sağlık hizmetlerine ait oluşturulan ulusal kayıt formlarını ve MEDULA sistemine girilmesi gerekli görülen geri ödemeye esas teşkil edecek diğer bilgi/belgelerini MEDULA sistemine girmesi zorunludur. Sağlık hizmeti ulusal kayıt formları ve MEDULA sistemine girilmesi gerekli görülen geri ödemeye esas teşkil edecek diğer bilgi/belgeler ile ilgili uyulması gereken kurallar Kurumca ayrıca duyurulur.'});
CREATE (sec_3815)-[:HAS_PARAGRAPH {order: 2}]->(para_3818);
CREATE (para_3817)-[:NEXT_PARAGRAPH]->(para_3818);
CREATE (para_3819:Paragraph {id: '4', content: 'Sunulan hizmete ilişkin MEDULA sisteminden alınan provizyonlar ön izin niteliğinde olup mevzuat ile açıkça belirtilmediği sürece tek başına yeterli değildir. Sağlık hizmetine ilişkin elektronik olarak sisteme eklenmemiş kuralların varlığı halinde gerekli kontroller sağlık hizmeti sunucularınca yapılır.'});
CREATE (sec_3815)-[:HAS_PARAGRAPH {order: 3}]->(para_3819);
CREATE (para_3818)-[:NEXT_PARAGRAPH]->(para_3819);
CREATE (amend_3820:Amendment {content: '(Mülga: RG-25/08/2022-31934/52 md. Yürürlük:03/09/2022)'});
CREATE (sec_3815)-[:HAS_AMENDMENT {order: 0}]->(amend_3820);
CREATE (amend_3821:Amendment {content: '(Mülga:RG-25/08/2022-31934/52 md. Yürürlük:03/09/2022)'});
CREATE (sec_3815)-[:HAS_AMENDMENT {order: 1}]->(amend_3821);
CREATE (sec_3800)-[:NEXT_SECTION]->(sec_3815);
CREATE (sec_3822:Section {id: '5.2', title: 'Fatura düzenlenmesi'});
CREATE (doc_1)-[:HAS_SECTION {order: 28}]->(sec_3822);
CREATE (para_3823:Paragraph {id: '1', content: 'Sağlık hizmeti sunucuları;'});
CREATE (sec_3822)-[:HAS_PARAGRAPH {order: 0}]->(para_3823);
CREATE (item_3824:Item {id: 'a', content: 'MEDULA sisteminden provizyon alarak MEDULA sistemine kaydettikleri hizmetler için (SUT’ta belirtilen istisnalar hariç) tek fatura/e-fatura düzenler.'});
CREATE (para_3823)-[:HAS_ITEM {order: 0}]->(item_3824);
CREATE (item_3825:Item {id: 'b', content: 'MEDULA sisteminden provizyon alınamaması nedeniyle MEDULA sistemine kaydedilemeyen aşağıda sayılan hizmetler için ayrı manuel fatura düzenler. sisteminden kaynaklanan arıza nedeniyle provizyon numarasının alınamadığı süre zarfında sağlık hizmeti bedellerinin Kurumca karşılandığını yazılı olarak beyan etmek veya belgelemek suretiyle müracaat eden kişilerden daha sonra yapılan sorgulama sonucu müstehak olmadığı tespit edilenlere ait tüm işlemler ayrı faturalandırılır. ile provizyon alınamadan vefat eden hastaların tedavi bedelleri manuel olarak fatura edilebilir.'});
CREATE (para_3823)-[:HAS_ITEM {order: 1}]->(item_3825);
CREATE (subitem_3826:SubItem {id: '2', content: 'Hizmet Sunumu Genel Müdürlüğü yetkililerince imzalanacak bir tutanak ile tevsik edilmesi kaydıyla MEDULA'});
CREATE (item_3825)-[:HAS_SUBITEM {order: 0}]->(subitem_3826);
CREATE (subitem_3827:SubItem {id: '3', content: 'Kurumdan kaynaklanan sebeplerden dolayı elektronik ortamda Kuruma fatura edilemeyen sağlık hizmeti bedelleri'});
CREATE (item_3825)-[:HAS_SUBITEM {order: 1}]->(subitem_3827);
CREATE (subitem_3826)-[:NEXT_SUBITEM]->(subitem_3827);
CREATE (item_3824)-[:NEXT_ITEM]->(item_3825);
CREATE (para_3828:Paragraph {id: '2', content: 'Sağlık hizmeti sunucuları trafik kazası, iş kazası, meslek hastalıkları ve adli vaka nedeniyle sundukları sağlık hizmetleri için ayrı fatura düzenlemeyecek, ancak icmal listelerinde bu grup vakalar ayrı ayrı belirtilecek olup örnekleme yapılmaksızın tamamı incelenir.'});
CREATE (sec_3822)-[:HAS_PARAGRAPH {order: 1}]->(para_3828);
CREATE (para_3823)-[:NEXT_PARAGRAPH]->(para_3828);
CREATE (para_3829:Paragraph {id: '3', content: 'Sağlık hizmeti sunucularından sağlık hizmeti alımına ilişkin yapılan (Mülga: RG- 25/08/2022- 31934/ 53-a md. Yürürlük: 03/09/2022) sözleşmelerin faturalama ile ilgili hükümleri saklıdır.'});
CREATE (sec_3822)-[:HAS_PARAGRAPH {order: 2}]->(para_3829);
CREATE (para_3828)-[:NEXT_PARAGRAPH]->(para_3829);
CREATE (para_3830:Paragraph {id: '4', content: 'Kurumun “e-reçete/e-fatura alıcısı” uygulamasına başlaması halinde Kurumca duyurulacak usul ve esaslara uyulur. (Değişik: RG- 25/08/2022- 31934/ 53-b md. Yürürlük: 03/09/2022)'});
CREATE (sec_3822)-[:HAS_PARAGRAPH {order: 3}]->(para_3830);
CREATE (para_3829)-[:NEXT_PARAGRAPH]->(para_3830);
CREATE (amend_3831:Amendment {content: '(Mülga: RG- 01/06/2022- 31853/11 md. Yürürlük: 01/03/2022)'});
CREATE (sec_3822)-[:HAS_AMENDMENT {order: 0}]->(amend_3831);
CREATE (sec_3832:Subsection {id: '5.2.1', title: 'Sağlık hizmeti sunucuları faturalarının düzenlenmesi'});
CREATE (sec_3822)-[:HAS_SUBSECTION {order: 0}]->(sec_3832);
CREATE (para_3833:Paragraph {id: '1', content: 'MEDULA hastane sistemini kullanan sağlık (Değişik: RG- 25/08/2022- 31934/ 53-b md. Yürürlük: 03/09/2022) hizmeti sunucuları, sağlık hizmeti bedelleri Kurumca karşılanan kişiler için, her ayın ilk ve son günü arasında verdikleri sağlık hizmetlerine ilişkin tek fatura düzenler. Kurumun “e-fatura alıcısı” uygulamasına başlaması halinde elektronik fatura düzenlenmesine ilişkin olarak Kurumca duyurulacak usul ve esaslara uyulur. Herhangi bir nedenle döneminde faturalandırılamayan sağlık hizmeti, işlemin bittiği tarih itibarıyla faturalandırılması gereken dönemi takip eden en geç 30 gün içerisindeki dönem sonlandırılmasına dâhil edilir. Trafik kazası nedeniyle verilen sağlık hizmetleri için dönem sonlandırma süresi dikkate alınmaz.'});
CREATE (sec_3832)-[:HAS_PARAGRAPH {order: 0}]->(para_3833);
CREATE (para_3834:Paragraph {id: '2', content: 'Aşağıdaki nedenlerle verilen sağlık hizmetleri Kurumca örneklemeye dâhil edilmeksizin tamamı incelenir;'});
CREATE (sec_3832)-[:HAS_PARAGRAPH {order: 1}]->(para_3834);
CREATE (item_3835:Item {id: 'a', content: 'Trafik kazası, iş kazası, meslek hastalıkları ve adli vaka durumlarında sunulan sağlık hizmetleri,'});
CREATE (para_3834)-[:HAS_ITEM {order: 0}]->(item_3835);
CREATE (item_3836:Item {id: 'b', content: '(a) bendinde sayılan haller hariç olmak üzere 1.7 numaralı maddenin ikinci fıkrasının (b) bendinde sayılan hallerdeki işlemler, kemik iliği, kök hücre nakilleri, ekstrakorporeal fotoferez tedavisi, hiperbarik oksijen tedavileri, tüp bebek tedavileri, plazmaferez tedavileri, allogreftlerin kullanıldığı tedaviler, ağız ve diş tedavileri ile ilgili olarak damak yarığı protezi, yenidoğanda preoperatif aparey, velum uzantılı konuşma apareyi, geçici opturatörler, basit çene defektlerinin protetik tedavileri, komplike çene defektlerinin protetik tedavileri, yüz protezleri, palyatif bakım tedavisine ait işlemler, genel sağlık sigortalısı veya genel sağlık sigortalısının bakmakla yükümlü olduğu kişisi sayılan yabancı ülke vatandaşlarına sunulan sağlık hizmetleri,'});
CREATE (para_3834)-[:HAS_ITEM {order: 1}]->(item_3836);
CREATE (item_3835)-[:NEXT_ITEM]->(item_3836);
CREATE (item_3837:Item {id: 'c', content: 'Yabancı ülkelerle yapılan sosyal güvenlik sözleşmeleri kapsamında sağlık hizmeti bedelleri Kurumca karşılanan ve  “Yurt dışı Provizyon Aktivasyon ve Sağlık Sistemi (YUPASS)” numarası ile hasta takip numarası/provizyon alınan kişilere sunulan sağlık hizmetleri,'});
CREATE (para_3834)-[:HAS_ITEM {order: 2}]->(item_3837);
CREATE (item_3836)-[:NEXT_ITEM]->(item_3837);
CREATE (item_3838:Item {id: 'ç', content: 'Yerleşim yeri dışı sunulan ambulans hizmetleri (MEDULA sisteminde gerekli düzenlemeler yapılıncaya kadar manuel),'});
CREATE (para_3834)-[:HAS_ITEM {order: 3}]->(item_3838);
CREATE (item_3837)-[:NEXT_ITEM]->(item_3838);
CREATE (item_3839:Item {id: 'd', content: '3713 sayılı Kanunun 21 inci maddesinin üçüncü fıkrası hükümleri gereği tedavi yardımından yararlananlara sunulan sağlık hizmetleri.'});
CREATE (para_3834)-[:HAS_ITEM {order: 4}]->(item_3839);
CREATE (item_3838)-[:NEXT_ITEM]->(item_3839);
CREATE (para_3833)-[:NEXT_PARAGRAPH]->(para_3834);
CREATE (amend_3840:Amendment {content: '(Değişik:RG-12/12/2024-32750/12 md. Yürürlük:01/01/2025)'});
CREATE (sec_3832)-[:HAS_AMENDMENT {order: 0}]->(amend_3840);
CREATE (amend_3841:Amendment {content: '(Mülga:RG-01/06/2022-31853/12md.Yürürlük:01/03/2022)'});
CREATE (sec_3832)-[:HAS_AMENDMENT {order: 1}]->(amend_3841);
CREATE (sec_3842:Subsection {id: '5.2.2', title: 'Eczane faturalarının düzenlenmesi'});
CREATE (sec_3822)-[:HAS_SUBSECTION {order: 1}]->(sec_3842);
CREATE (para_3843:Paragraph {id: '1', content: 'MEDULA eczane sistemini kullanan sözleşmeli eczaneler tarafından Kurum mevzuatı ile belirlenen esaslar çerçevesinde karşılanan reçetelerden;'});
CREATE (sec_3842)-[:HAS_PARAGRAPH {order: 0}]->(para_3843);
CREATE (item_3844:Item {id: 'a', content: 'Her ayın ilk ve son günü arasındaki döneme ait reçeteler, o aya ait son günün tarihini taşıyacak şekilde provizyon sistemi üzerinden dönem sonlandırması yapılarak faturalandırılır.'});
CREATE (para_3843)-[:HAS_ITEM {order: 0}]->(item_3844);
CREATE (item_3845:Item {id: 'b', content: 'Kan ürünü ve hemofili reçeteleri ise; her ayın 1’i ila 15’i arasında karşılanan reçeteler takip eden 3 iş günü içinde, her ayın 16’sı ila ayın son günü arasında karşılanan reçeteler ise takip eden 3 iş günü içinde olmak üzere ayda iki kere faturalandırılır. 151'});
CREATE (para_3843)-[:HAS_ITEM {order: 1}]->(item_3845);
CREATE (item_3844)-[:NEXT_ITEM]->(item_3845);
CREATE (para_3846:Paragraph {id: '2', content: 'Faturalar;'});
CREATE (sec_3842)-[:HAS_PARAGRAPH {order: 1}]->(para_3846);
CREATE (item_3847:Item {id: 'a', content: 'Yatan hasta reçetelerini (günübirlik tedavi reçeteleri de dahil) ve sağlık raporu ile temin edilen ilaç/ilaçları içeren reçeteler “A Grubu”,'});
CREATE (para_3846)-[:HAS_ITEM {order: 0}]->(item_3847);
CREATE (item_3848:Item {id: 'b', content: 'Kurum mevzuatına göre ayrı fatura edilmesine ilişkin düzenleme olmayan veya içeriğinde herhangi bir raporlu ilaç bulundurmayan ayaktan hasta reçeteleri “B Grubu”,'});

// Batch 103
CREATE (para_3846)-[:HAS_ITEM {order: 1}]->(item_3848);
CREATE (item_3847)-[:NEXT_ITEM]->(item_3848);
CREATE (item_3849:Item {id: 'c', content: 'Kurum mevzuatına göre ayrı fatura edilmesine ilişkin düzenleme olan reçetelerden; ve YUPASS numarası ile provizyon alınan kişilere ait; i. Kan ürünü ve hemofili ilacı/ilaçları içeren reçeteler “Yurt dışı Sigortalı Kan Ürünü”, ii. Diğer ilaçları içeren reçeteler “Yurt dışı Sigortalı Normal”, ayrı ayrı faturalandırılır.'});
CREATE (para_3846)-[:HAS_ITEM {order: 2}]->(item_3849);
CREATE (subitem_3850:SubItem {id: '1', content: 'Kan ürünü ve hemofili ilacı/ilaçları içeren reçeteler “C Grubu Kan Ürünü”,'});
CREATE (item_3849)-[:HAS_SUBITEM {order: 0}]->(subitem_3850);
CREATE (subitem_3851:SubItem {id: '2', content: 'Sıralı dağıtım sistemine tabi diğer reçeteler “C Grubu Sıralı Dağıtım”,'});
CREATE (item_3849)-[:HAS_SUBITEM {order: 1}]->(subitem_3851);
CREATE (subitem_3850)-[:NEXT_SUBITEM]->(subitem_3851);
CREATE (subitem_3852:SubItem {id: '3', content: 'Yabancı ülkelerle yapılan sosyal güvenlik sözleşmeleri kapsamında sağlık hizmeti bedelleri Kurumca karşılanan'});
CREATE (item_3849)-[:HAS_SUBITEM {order: 2}]->(subitem_3852);
CREATE (subitem_3851)-[:NEXT_SUBITEM]->(subitem_3852);
CREATE (item_3848)-[:NEXT_ITEM]->(item_3849);
CREATE (para_3843)-[:NEXT_PARAGRAPH]->(para_3846);
CREATE (sec_3832)-[:NEXT_SUBSECTION]->(sec_3842);
CREATE (sec_3853:Subsection {id: '5.2.3', title: 'Optisyenlik müesseseleri faturalarının düzenlenmesi'});
CREATE (sec_3822)-[:HAS_SUBSECTION {order: 2}]->(sec_3853);
CREATE (para_3854:Paragraph {id: '1', content: 'MEDULA optik sistemini kullanan optisyenlik müesseseleri, sağlık hizmeti bedelleri Kurumca karşılanan tüm kişiler için her ayın ilk ve son günü arasında verdikleri sağlık hizmetlerine ilişkin;'});
CREATE (sec_3853)-[:HAS_PARAGRAPH {order: 0}]->(para_3854);
CREATE (item_3855:Item {id: 'a', content: 'SUT’ta sağlık raporu ile temin edileceği belirtilen görmeye yardımcı tıbbi malzemeler için diğer reçetelerden ayrı tek fatura düzenlenir.'});
CREATE (para_3854)-[:HAS_ITEM {order: 0}]->(item_3855);
CREATE (item_3856:Item {id: 'b', content: '(a) bendinde sayılan haller hariç olmak üzere sağlık hizmeti bedelleri Kurumca karşılanan diğer kişiler için, her ayın ilk ve son günü arasında verdikleri sağlık hizmetlerine ilişkin tek fatura düzenler.'});
CREATE (para_3854)-[:HAS_ITEM {order: 1}]->(item_3856);
CREATE (item_3855)-[:NEXT_ITEM]->(item_3856);
CREATE (para_3857:Paragraph {id: '2', content: 'Provizyon sisteminden yapılan sorgu neticesinde müstehaklıkları 60/c-1 veya 60/c-3 dönen kişiler ile 5510 sayılı Sosyal Sigortalar ve Genel Sağlık Sigortası Kanununun 60 ıncı maddesinin on ikinci, on üçüncü ve on dördüncü fıkralarında tanımlanan kişilere, Kurumla götürü bedel protokolü yapan sağlık hizmeti sunucuları dışında sağlık hizmeti sunucularınca reçete düzenlenmesi halinde (acil haller dışında) sevk belgesi eklenir. (e-sevk hariç)'});
CREATE (sec_3853)-[:HAS_PARAGRAPH {order: 1}]->(para_3857);
CREATE (para_3854)-[:NEXT_PARAGRAPH]->(para_3857);
CREATE (sec_3842)-[:NEXT_SUBSECTION]->(sec_3853);
CREATE (sec_3858:Subsection {id: '5.2.4', title: 'Sözleşmeli satış merkezleri ve eczaneler tarafından ayakta tedavide kullanılan tıbbi malzemelere ait', content: 'faturaların düzenlenmesi'});
CREATE (sec_3822)-[:HAS_SUBSECTION {order: 3}]->(sec_3858);
CREATE (para_3859:Paragraph {id: '1', content: 'MEDULA Tıbbi Malzeme Provizyon Sistemini kullanan sözleşmeli satış merkez/sözleşmeli merkezler ve eczaneler, sağlık hizmeti bedelleri Kurumca karşılanan tüm kişiler için her ayın ilk ve son günü arasında verdikleri sağlık hizmetlerine ilişkin;'});
CREATE (sec_3858)-[:HAS_PARAGRAPH {order: 0}]->(para_3859);
CREATE (item_3860:Item {id: 'a', content: 'Tıbbi sarf malzemelerine ilişkin reçeteler (I. Grup reçete),'});
CREATE (para_3859)-[:HAS_ITEM {order: 0}]->(item_3860);
CREATE (item_3861:Item {id: 'b', content: 'Örnekleme yöntemine tabi reçeteler (II. Grup reçete),'});
CREATE (para_3859)-[:HAS_ITEM {order: 1}]->(item_3861);
CREATE (item_3860)-[:NEXT_ITEM]->(item_3861);
CREATE (item_3862:Item {id: 'c', content: 'Hazır protez ve ortez reçeteleri (III. Grup reçete) olarak her grup için ayrı olmak üzere 3 ayrı grupta fatura düzenler.'});
CREATE (para_3859)-[:HAS_ITEM {order: 2}]->(item_3862);
CREATE (item_3861)-[:NEXT_ITEM]->(item_3862);
CREATE (para_3863:Paragraph {id: '2', content: 'YUPASS numarası ile hasta takip numarası/provizyon alınan kişiler de dahil olmak üzere yabancı ülkelerle yapılan sosyal güvenlik sözleşmesi kapsamında sağlık hizmeti bedelleri Kurumca karşılanan kişilere sağlanacak protez ve ortez, tıbbi araç ve gereç ile kişi kullanımına mahsus tıbbi cihazlarının temini için Kurumun ilgili biriminden onay alınır.'});
CREATE (sec_3858)-[:HAS_PARAGRAPH {order: 1}]->(para_3863);
CREATE (para_3859)-[:NEXT_PARAGRAPH]->(para_3863);
CREATE (para_3864:Paragraph {id: '3', content: 'Provizyon sisteminden yapılan sorgu neticesinde müstehaklıkları 60/c-1 veya 60/c-3 dönen kişiler ile 5510 sayılı Sosyal Sigortalar ve Genel Sağlık Sigortası Kanununun 60 ıncı maddesinin on ikinci, on üçüncü ve on dördüncü fıkralarında tanımlanan kişilere, Kurumla götürü bedel protokolü yapan sağlık hizmeti sunucuları dışında sağlık hizmeti sunucularınca reçete düzenlenmesi halinde (acil haller dışında) sevk belgesi eklenir. (e-sevk hariç)'});
CREATE (sec_3858)-[:HAS_PARAGRAPH {order: 2}]->(para_3864);
CREATE (para_3863)-[:NEXT_PARAGRAPH]->(para_3864);
CREATE (para_3865:Paragraph {id: '4', content: 'Engelli sağlık kurulu raporu bulunması halinde aslının veya onaylı fotokopisinin reçete ekinde ibrazı zorunludur.'});
CREATE (sec_3858)-[:HAS_PARAGRAPH {order: 3}]->(para_3865);
CREATE (para_3864)-[:NEXT_PARAGRAPH]->(para_3865);
CREATE (sec_3853)-[:NEXT_SUBSECTION]->(sec_3858);
CREATE (sec_3866:Subsection {id: '5.2.5', title: 'Kişiye özel üretilen ısmarlama malzemeler ve iyileştirici araç ve gereçleri karşılayan sözleşmeli', content: 'merkezler tarafından ayakta tedavide kullanılan tıbbi malzemelere ait faturaların düzenlenmesi'});

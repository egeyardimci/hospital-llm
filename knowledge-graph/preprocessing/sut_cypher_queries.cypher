CREATE (sec_1885:Subsection {id: '4.2.1.C-5', title: 'Tosilizumab'});
CREATE (sec_1809)-[:HAS_SUBSECTION {order: 4}]->(sec_1885);
CREATE (para_1886:Paragraph {id: '1', content: 'Romatoid artritli erişkin hastalarda; (Değişik: RG- 18/06/2016- 29746/ 10-ç md. Yürürlük: 25/06/2016) .'});
CREATE (sec_1885)-[:HAS_PARAGRAPH {order: 0}]->(para_1886);
CREATE (item_1887:Item {id: 'a', content: 'Aktif romatoid artriti bulunan, biri methotrexat olmak üzere en az 3 farklı hastalık modifiye edici antiromatizmal ilacı, en az üçer ay kullanmış olmasına veya en az bir anti TNF tedavisine rağmen hastalığı kontrol edilemeyen (DAS 28 SKORU >5.1 olan) erişkin hastalarda  , tüm romatoloji uzman hekimleri veya üniversite hastaneleri ile eğitim ve araştırma hastanelerinde klinik immunoloji veya fiziksel tıp ve rehabilitasyon uzman hekimlerinden birinin yer aldığı 3 ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimler tarafından reçetelenir.'});
CREATE (para_1886)-[:HAS_ITEM {order: 0}]->(item_1887);
CREATE (item_1888:Item {id: 'b', content: 'İlaca başlandıktan 3 ay sonra yapılan değerlendirmede DAS 28 skorunda 0,6 puandan fazla düşme olması halinde, bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile 3 ay daha tedaviye devam edilir.'});
CREATE (para_1886)-[:HAS_ITEM {order: 1}]->(item_1888);
CREATE (item_1887)-[:NEXT_ITEM]->(item_1888);
CREATE (item_1889:Item {id: 'c', content: 'Bu raporun süresi sonunda DAS 28 skorunda toplam 1,2 puandan fazla düşme olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. 75'});
CREATE (para_1886)-[:HAS_ITEM {order: 2}]->(item_1889);
CREATE (item_1888)-[:NEXT_ITEM]->(item_1889);
CREATE (item_1890:Item {id: 'ç', content: 'Tedavinin devamında DAS 28 kriterine 6 ayda bir bakılır, başlangıç ve yeni DAS 28 skorları her 6 ay süreli sağlık kurulu raporunda belirtilir. Tedaviye rağmen hastanın DAS 28 skorunda, başlangıç DAS 28 skoruna göre 1,2 puandan fazla düşme olmaması halinde tedavi sonlandırılır. (Mülga: RG- 18/06/2016- 29746/ 10-d md. Yürürlük: 25/06/2016)'});
CREATE (para_1886)-[:HAS_ITEM {order: 3}]->(item_1890);
CREATE (item_1889)-[:NEXT_ITEM]->(item_1890);
CREATE (para_1891:Paragraph {id: '2', content: 'poliartiküler juvenil idiopatik artriti bulunan 2 yaş ve üzeri çocuklarda;'});
CREATE (sec_1885)-[:HAS_PARAGRAPH {order: 1}]->(para_1891);
CREATE (item_1892:Item {id: 'a', content: 'NSAİ ve/veya methotrexat veya anti-TNF ile 3 aylık tedavi sonunda ACR pediatrik 30 yanıtı alınamamış ise bu durumun belirtildiği 3 ay süreli sağlık kurulu raporuna dayanılarak ilaca başlanabilir. İlaca başlandıktan 3 ay sonra yapılan değerlendirmede ACR pediatrik 30 yanıtının alınması halinde, bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile tedaviye devam edilir. Bu raporun süresi sonunda hastanın ACR pediatrik cevap kriteri 50 ve üzerinde olması halinde bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile hastaların tedavisine devam edilebilir. Tedavinin devamında ACR pediatrik cevap kriterine 6 ayda bir bakılır, başlangıç ve ACR pediatrik cevap kriteri her sağlık kurulu raporunda belirtilir. (Mülga: RG- 18/06/2016- 29746/ 10-d md. Yürürlük: 25/06/2016)'});
CREATE (para_1891)-[:HAS_ITEM {order: 0}]->(item_1892);
CREATE (item_1893:Item {id: 'b', content: 'Sağlık Kurulu raporları; yalnızca üniversite veya eğitim ve araştırma hastanelerinde en az bir çocuk romatoloji uzmanı yer alacak şekilde düzenlenir ve bu rapora dayanılarak çocuk romatoloji veya çocuk sağlığı ve hastalıkları uzman hekimleri tarafından reçete edilir. (Ek: RG- 18/06/2016- 29746/ 10-e md. Yürürlük: 25/06/2016)'});
CREATE (para_1891)-[:HAS_ITEM {order: 1}]->(item_1893);
CREATE (item_1892)-[:NEXT_ITEM]->(item_1893);
CREATE (para_1886)-[:NEXT_PARAGRAPH]->(para_1891);
CREATE (para_1894:Paragraph {id: '3', content: 'Sistemik juvenil idiyopatik artriti (SJİA) bulunan 2 yaş ve üzeri çocuklarda;'});
CREATE (sec_1885)-[:HAS_PARAGRAPH {order: 2}]->(para_1894);
CREATE (item_1895:Item {id: 'a', content: 'Sistemik bulguların ön planda olduğu tip; hastalarda tosilizumab veya anakinra tedavisine geçilebilir. yanıtının alınması halinde bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile tedaviye devam edilir. her sağlık kurulu raporunda belirtilir.'});
CREATE (para_1894)-[:HAS_ITEM {order: 0}]->(item_1895);
CREATE (subitem_1896:SubItem {id: '1', content: 'Tedaviye nonsteroid antiinflamatuar ilaçlar ve sistemik kortikosteroidler ile başlanır.'});
CREATE (item_1895)-[:HAS_SUBITEM {order: 0}]->(subitem_1896);
CREATE (subitem_1897:SubItem {id: '2', content: 'Nonsteroid antiinflamatuvar ilaç ve sistemik steroid tedavisi ile üçüncü ayın sonunda remisyona girmemiş'});
CREATE (item_1895)-[:HAS_SUBITEM {order: 1}]->(subitem_1897);
CREATE (subitem_1896)-[:NEXT_SUBITEM]->(subitem_1897);
CREATE (subitem_1898:SubItem {id: '3', content: 'Tosilizumab veya anakinra ile tedaviye başlandıktan 3 ay sonra yapılan değerlendirmede ACR pediatrik 50'});
CREATE (item_1895)-[:HAS_SUBITEM {order: 2}]->(subitem_1898);
CREATE (subitem_1897)-[:NEXT_SUBITEM]->(subitem_1898);
CREATE (subitem_1899:SubItem {id: '4', content: 'Tedavinin devamında ACR pediatrik yanıt kriterine 3 ayda bir bakılır, başlangıç ve ACR pediatrik yanıt kriteri'});
CREATE (item_1895)-[:HAS_SUBITEM {order: 3}]->(subitem_1899);
CREATE (subitem_1898)-[:NEXT_SUBITEM]->(subitem_1899);
CREATE (subitem_1900:SubItem {id: '5', content: 'Tedaviye rağmen ACR pediatrik yanıt kriteri 50’ye ulaşmayan hastalarda tedaviye devam edilmez.'});
CREATE (item_1895)-[:HAS_SUBITEM {order: 4}]->(subitem_1900);
CREATE (subitem_1899)-[:NEXT_SUBITEM]->(subitem_1900);
CREATE (item_1901:Item {id: 'b', content: 'Artrit bulgularının ön planda olduğu tip; yanıtının elde edilemediği durumlarda tosilizumab veya anakinra tedavisine geçilebilir. yanıtının alınması halinde bu durumun yeni düzenlenecek 3 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile tedaviye devam edilir. her sağlık kurulu raporunda belirtilir.'});
CREATE (para_1894)-[:HAS_ITEM {order: 1}]->(item_1901);
CREATE (subitem_1902:SubItem {id: '1', content: 'Tedaviye nonsteroid antiinflamatuar ilaçlar ve sistemik kortikosteroidler ile başlanır.'});
CREATE (item_1901)-[:HAS_SUBITEM {order: 0}]->(subitem_1902);
CREATE (subitem_1903:SubItem {id: '2', content: 'Nonsteroid antiinflamatuvar ilaçlar ve sistemik kortikosteroidler ile üçüncü ayın sonunda ACR pediatrik 50'});
CREATE (item_1901)-[:HAS_SUBITEM {order: 1}]->(subitem_1903);
CREATE (subitem_1902)-[:NEXT_SUBITEM]->(subitem_1903);
CREATE (subitem_1904:SubItem {id: '3', content: 'Tosilizumab veya anakinra ile tedaviye başlandıktan 3 ay sonra yapılan değerlendirmede ACR pediyatrik 50'});
CREATE (item_1901)-[:HAS_SUBITEM {order: 2}]->(subitem_1904);
CREATE (subitem_1903)-[:NEXT_SUBITEM]->(subitem_1904);
CREATE (subitem_1905:SubItem {id: '4', content: 'Tedavinin devamında ACR pediatrik yanıt kriterine 3 ayda bir bakılır, başlangıç ve ACR pediatrik yanıt kriteri'});
CREATE (item_1901)-[:HAS_SUBITEM {order: 3}]->(subitem_1905);
CREATE (subitem_1904)-[:NEXT_SUBITEM]->(subitem_1905);
CREATE (subitem_1906:SubItem {id: '5', content: 'Tedaviye rağmen ACR pediatrik yanıt kriteri 50’ye ulaşmayan hastalarda tedaviye devam edilmez.'});
CREATE (item_1901)-[:HAS_SUBITEM {order: 4}]->(subitem_1906);
CREATE (subitem_1905)-[:NEXT_SUBITEM]->(subitem_1906);
CREATE (item_1895)-[:NEXT_ITEM]->(item_1901);
CREATE (item_1907:Item {id: 'c', content: 'Üniversite veya eğitim ve araştırma hastanelerinde bu durumların belirtildiği çocuk romatoloji uzmanının yer aldığı en fazla 3 ay süreli sağlık kurulu raporuna dayanılarak çocuk romatoloji uzman hekimlerince reçete edilir.'});
CREATE (para_1894)-[:HAS_ITEM {order: 2}]->(item_1907);
CREATE (item_1901)-[:NEXT_ITEM]->(item_1907);
CREATE (para_1891)-[:NEXT_PARAGRAPH]->(para_1894);
CREATE (para_1908:Paragraph {id: '4', content: 'Dev Hücreli Arteriti (DHA) bulunan erişkin hastalarda, uzun süre ve yüksek doz kortikosteroid kullanımının kontrendike olduğu durumlarda 3 ay süreli sağlık kurulu raporuna dayanılarak tosilizumabın subkütan formu ile tedaviye başlanır. İlacın etkinliği, ilaca başlandıktan 3 ay sonra değerlendirilir. Tedaviye cevap alınmış ve ilaca devam edilecek ise bu durumun yeni düzenlenecek 6 ay süreli sağlık kurulu raporunda belirtilmesi koşulu ile tedaviye devam edilebilir. Düzenlenecek sağlık kurulu raporlarında en az bir romatoloji veya immünoloji ve alerji uzman hekimlerinden birinin yer alması ve reçetelerin romatoloji veya immünoloji ve alerji uzman hekimlerince düzenlenmesi halinde Kurumca bedelleri karşılanır. (Değişik:RG-19/10/2023-32344/3-c md.Yürürlük:27/10/2023)'});
CREATE (sec_1885)-[:HAS_PARAGRAPH {order: 3}]->(para_1908);
CREATE (para_1894)-[:NEXT_PARAGRAPH]->(para_1908);
CREATE (amend_1909:Amendment {content: '(Mülga: RG- 14/07/2016- 29770/ 9 md. Yürürlük: 25/06/2016)'});
CREATE (sec_1885)-[:HAS_AMENDMENT {order: 0}]->(amend_1909);
CREATE (amend_1910:Amendment {content: '(Değişik: RG- 05/08/2015- 29436/ 13 md. Yürürlük: 13/08/2015)'});
CREATE (sec_1885)-[:HAS_AMENDMENT {order: 1}]->(amend_1910);

// -----------------------------------------------------------------
// 1. SET UP CONSTRAINTS (Run these first to ensure data integrity)
// -----------------------------------------------------------------
CREATE CONSTRAINT section_id IF NOT EXISTS FOR (s:DocumentNode) REQUIRE s.id IS UNIQUE;
CREATE CONSTRAINT service_name IF NOT EXISTS FOR (m:MedicalService) REQUIRE m.name IS UNIQUE;
CREATE CONSTRAINT list_code IF NOT EXISTS FOR (l:SUTList) REQUIRE l.code IS UNIQUE;
CREATE CONSTRAINT provider_type IF NOT EXISTS FOR (p:ProviderType) REQUIRE p.name IS UNIQUE;
CREATE CONSTRAINT level_name IF NOT EXISTS FOR (h:HealthcareLevel) REQUIRE h.name IS UNIQUE;


CREATE (para_1508)-[:HAS_ITEM {order: 0}]->(item_1509);
CREATE (item_1510:Item {id: 'b', content: 'Hayatı tehdit eden hemoptizilerde kanayan tarafın ana bronşunu oblitere etmek, durumlarında kullanılması halinde bedeli Kurumca karşılanır.'});

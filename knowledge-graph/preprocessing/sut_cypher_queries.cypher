CREATE (para_2147)-[:HAS_ITEM {order: 0}]->(item_2148);
CREATE (item_2149:Item {id: 'b', content: 'Yıllık büyüme hızı tedavi öncesi hıza göre + 2 cm’den düşük olduğunda veya'});
CREATE (para_2147)-[:HAS_ITEM {order: 1}]->(item_2149);
CREATE (item_2148)-[:NEXT_ITEM]->(item_2149);
CREATE (item_2150:Item {id: 'c', content: 'Boy uzunluğu kızlarda 155 cm ve erkeklerde 165 cm’ye ulaştığında veya'});
CREATE (para_2147)-[:HAS_ITEM {order: 2}]->(item_2150);
CREATE (item_2149)-[:NEXT_ITEM]->(item_2150);
CREATE (item_2151:Item {id: 'ç', content: 'Tedavi esnasında boy 25 persentile ulaştığında, sonlandırılacaktır.'});
CREATE (para_2147)-[:HAS_ITEM {order: 3}]->(item_2151);
CREATE (item_2150)-[:NEXT_ITEM]->(item_2151);

CREATE (para_1185)-[:HAS_ITEM {order: 6}]->(item_1192);
CREATE (item_1191)-[:NEXT_ITEM]->(item_1192);
CREATE (item_1193:Item {id: 'g', content: 'Koroner stentler.'});
CREATE (para_1185)-[:HAS_ITEM {order: 7}]->(item_1193);
CREATE (item_1192)-[:NEXT_ITEM]->(item_1193);
CREATE (item_1194:Item {id: 'ğ', content: 'Kalp kapakları.'});
CREATE (para_1185)-[:HAS_ITEM {order: 8}]->(item_1194);
CREATE (item_1193)-[:NEXT_ITEM]->(item_1194);
CREATE (item_1195:Item {id: 'h', content: 'İntraaortik balon, ventrikül destek cihazı.'});
CREATE (para_1185)-[:HAS_ITEM {order: 9}]->(item_1195);
CREATE (item_1194)-[:NEXT_ITEM]->(item_1195);
CREATE (item_1196:Item {id: 'ı', content: 'Kapaklı kapaksız kondüit.'});
CREATE (para_1185)-[:HAS_ITEM {order: 10}]->(item_1196);
CREATE (item_1195)-[:NEXT_ITEM]->(item_1196);
CREATE (item_1197:Item {id: 'i', content: 'Valf ringi.'});
CREATE (para_1185)-[:HAS_ITEM {order: 11}]->(item_1197);
CREATE (item_1196)-[:NEXT_ITEM]->(item_1197);
CREATE (item_1198:Item {id: 'j', content: 'Her türlü greft, shunt ve suni damar.'});
CREATE (para_1185)-[:HAS_ITEM {order: 12}]->(item_1198);
CREATE (item_1197)-[:NEXT_ITEM]->(item_1198);
CREATE (item_1199:Item {id: 'k', content: 'Protezler.'});
CREATE (para_1185)-[:HAS_ITEM {order: 13}]->(item_1199);
CREATE (item_1198)-[:NEXT_ITEM]->(item_1199);
CREATE (item_1200:Item {id: 'l', content: 'Aterektomi cihazı.'});
CREATE (para_1185)-[:HAS_ITEM {order: 14}]->(item_1200);
CREATE (item_1199)-[:NEXT_ITEM]->(item_1200);
CREATE (item_1201:Item {id: 'm', content: 'Çift yüzlü yamalar (meshler).'});
CREATE (para_1185)-[:HAS_ITEM {order: 15}]->(item_1201);
CREATE (item_1200)-[:NEXT_ITEM]->(item_1201);
CREATE (item_1202:Item {id: 'n', content: 'SUT eki EK-2/C Listesi açıklama bölümünde tanıya dayalı ödeme işlem puanına dâhil olmadığı belirtilen tıbbi malzemeler.'});
CREATE (para_1185)-[:HAS_ITEM {order: 16}]->(item_1202);

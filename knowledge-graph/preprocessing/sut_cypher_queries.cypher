CREATE (sec_782:Subsection {id: '2.4.4.I', title: 'Göz hastalıkları branşına ait işlemler'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 10}]->(sec_782);
CREATE (para_783:Paragraph {id: '1', content: 'Kurumla sözleşmeli ikinci veya üçüncü basamak özel sağlık hizmeti sunucuları  , FAKO işlemi uygulayacakları hastalar için planlanan işlem tarihini, en az 2 gün öncesinde Kurum bilgi işlem sistemi üzerine kaydedeceklerdir. Kurum bilgi işlem sistemi üzerinde gerekli düzenlemeler yapılıncaya kadar bu hüküm uygulanmaz.'});
CREATE (sec_782)-[:HAS_PARAGRAPH {order: 0}]->(para_783);
CREATE (para_784:Paragraph {id: '2', content: 'Göz hastalıkları branşında ayaktan başvurularda ikinci veya üçüncü basamak özel sağlık hizmeti sunucuları için günlük muayene sınırı acil servis/polikliniğe başvurular hariç olmak üzere, sağlık hizmeti sunucusundaki sözleşme kapsamında çalışan hekimlerin çalışma saatlerinin 4,5 ile çarpılması ile bulunur. Küsuratlı rakamlar üste tamamlanır. Her bir hekim için günlük muayene sayısı her halükârda 45’i geçemez. SUT eki EK-2/B Listesindeki 617340, 617341, 617342 kodlu işlemler ile EK-2/C Listesindeki P617340, P617341, P617342 kodlu işlemlerin yapılması halinde her bir işlem için hekim çalışma saatinden 30 dakika düşülerek yeni günlük muayene sayısı hesaplanır. SUT eki EK-2/B Listesindeki 602200, 616510, 616520, 616550, 616780, 616790, 616800, 616810 kodlu işlemler ile EK-2/C Listesindeki P602200, P616510, P616520, P616550, P616780, P616790, P616800, P616810 kodlu işlemlerin yapılması halinde ise her bir işlem için hekim çalışma saatinden 60 dakika düşülerek yeni günlük muayene sayısı hesaplanır. SUT eki EK-2/B Listesindeki 602200, 616510, 616520, 616550, 616780, 616790, 616800, 616810 kodlu işlemler ile EK-2/C Listesindeki P602200, P616510, P616520, P616550, P616780, P616790, P616800, P616810 kodlu işlemlerden bir göz hastalıkları uzman hekimi günlük en fazla toplam 8 adet, bir sağlık hizmeti sunucusu ise en fazla toplam 16 adet Kuruma fatura edebilir.'});
CREATE (sec_782)-[:HAS_PARAGRAPH {order: 1}]->(para_784);
CREATE (para_783)-[:NEXT_PARAGRAPH]->(para_784);
CREATE (para_785:Paragraph {id: '3', content: 'Hastanın, Kurumumuz ile sözleşmeli ikinci veya üçüncü basamak özel sağlık hizmeti sunucuları  (acil servise başvuruları hariç olmak üzere) göz hastalıkları uzmanlık dalına ayaktan başvurduğu gün dâhil, 15 (on beş) gün içindeki aynı uzmanlık dalına diğer ayaktan başvurularında; sadece SUT eki EK-2/A-2 Listesinde yer alan işlemler faturalandırılır. SUT eki EK-2/A Listesinde yer alan tutarlar faturalandırılamaz.'});
CREATE (sec_782)-[:HAS_PARAGRAPH {order: 2}]->(para_785);
CREATE (para_784)-[:NEXT_PARAGRAPH]->(para_785);
CREATE (para_786:Paragraph {id: '4', content: 'Kurumumuz ile sözleşmeli ikinci veya üçüncü basamak özel sağlık hizmeti sunucuları  göz hastalıkları branşında bir fatura döneminde günübirlik ve yatarak tedavi kapsamında SUT eki EK-2/B ve EK-2/C Listelerinde “6.9.Göz ve Adneksleri” başlığı altında Kuruma fatura edilen işlem sayı sınırı; göz hastalıkları branşında ayaktan başvuru sayısı ile günübirlik ve yatarak tedavi kapsamında SUT eki EK-2/B ve EK- 2/C Listelerinde “6.9.Göz ve Adneksleri” başlığı altında Kuruma fatura edilen işlemlerin sayıları toplamlarının %13’ünü geçemez.'});
CREATE (sec_782)-[:HAS_PARAGRAPH {order: 3}]->(para_786);
CREATE (para_785)-[:NEXT_PARAGRAPH]->(para_786);
CREATE (amend_787:Amendment {content: '(Mülga:RG-16/03/2023-32134/12 \nmd. Yürürlük:24/03/2023)'});
CREATE (sec_782)-[:HAS_AMENDMENT {order: 0}]->(amend_787);
CREATE (amend_788:Amendment {content: '(Mülga:RG-16/03/2023-32134/12 md. Yürürlük:24/03/2023)'});
CREATE (sec_782)-[:HAS_AMENDMENT {order: 1}]->(amend_788);
CREATE (amend_789:Amendment {content: '(Mülga:RG- \n16/03/2023-32134/12 md. Yürürlük:24/03/2023)'});
CREATE (sec_782)-[:HAS_AMENDMENT {order: 2}]->(amend_789);
CREATE (amend_790:Amendment {content: '(Mülga:RG-16/03/2023-\n32134/12 md. Yürürlük:24/03/2023)'});
CREATE (sec_782)-[:HAS_AMENDMENT {order: 3}]->(amend_790);
CREATE (sec_767)-[:NEXT_SUBSECTION]->(sec_782);
CREATE (sec_791:Subsection {id: '2.4.4.İ', title: 'Yardımcı üreme yöntemi tedavileri'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 11}]->(sec_791);
CREATE (para_792:Paragraph {id: '1', content: 'İnvitro fertilizasyon işlemleri (IVF), 5510 sayılı Kanunun 63 üncü maddesinde tanımlanan “yardımcı üreme yöntemi” olarak kabul edilir. Ovulasyon indüksiyonu (OI) ve intrauterin inseminasyonu (IUI) işlemi bu kapsamda değerlendirilmez.'});
CREATE (sec_791)-[:HAS_PARAGRAPH {order: 0}]->(para_792);
CREATE (sec_793:Subsection {id: '2.4.4.İ-1', title: '3 - IVF tedavi bedellerinin ödenmesi'});
CREATE (sec_791)-[:HAS_SUBSECTION {order: 0}]->(sec_793);
CREATE (para_794:Paragraph {id: '1', content: 'IVF tedavisi, SUT eki EK-2/C Listesinde belirtilen bedel esas alınarak faturalandırılır. Bu bedele; IVF tedavisi kapsamında yapılan ovulasyon takibi, oosit aspirasyonu, sperm-oosit hazırlanması ve inkübasyonu, ICSI (mikro enjeksiyon), invaziv sperm elde etme yöntemleri, işlem öncesi kadın ve erkeğe yapılan tetkik ve tahlil bedelleri, kullanılan her türlü sarf malzemesi ile embriyo transferi dahildir.'});
CREATE (sec_793)-[:HAS_PARAGRAPH {order: 0}]->(para_794);
CREATE (para_795:Paragraph {id: '2', content: 'Embriyo freezing bedeli, (Değişik: RG-11/08/2021-31565/4-c md. Yürürlük:11/08/2021) birinci veya ikinci denemeden sonra SUT eki EK-2/B Listesinde yer alan bedel üzerinden faturalandırılabilir.'});
CREATE (sec_793)-[:HAS_PARAGRAPH {order: 1}]->(para_795);
CREATE (para_794)-[:NEXT_PARAGRAPH]->(para_795);
CREATE (para_796:Paragraph {id: '3', content: 'Hastaya IVF uygulamasının yapılamaması durumunda; bu süreye kadar yapılan işlemler SUT eki EK-2/B Listesi üzerinden %10 indirim yapılarak faturalandırılır. Bu durumda söz konusu işlemler deneme sayısına dâhil edilmeyecektir. Ancak kullanılan ilaçlar maksimum doz hesabında dikkate alınır.'});
CREATE (sec_793)-[:HAS_PARAGRAPH {order: 2}]->(para_796);
CREATE (para_795)-[:NEXT_PARAGRAPH]->(para_796);
CREATE (para_797:Paragraph {id: '4', content: 'IVF tedavisinin, freezing işlemi uygulanan embriyonun transferi ile yapılması durumunda işlemler, SUT eki EK- 2/C Listesinde yer alan “Freezing işlemi uygulanan embriyonun transferi” işlemi üzerinden faturalandırılacaktır. Bu durumda söz konusu işlem, deneme sayısına dâhil edilecektir.'});
CREATE (sec_793)-[:HAS_PARAGRAPH {order: 3}]->(para_797);
CREATE (para_796)-[:NEXT_PARAGRAPH]->(para_797);
CREATE (para_798:Paragraph {id: '5', content: 'Yaş faktörü, embriyo kalitesi ve benzeri tıbbî zorunluluk hallerinin uygulamayı yapan hekim tarafından gerekçesinin belgelendirildiği durumlar hariç olmak üzere birden fazla embriyo transfer edilmesi nedeniyle birden fazla gerçekleşen doğumlarda, bebeklere ait taburcu edilinceye kadar ortaya çıkacak sağlık hizmeti bedelleri Kurumca karşılanmaz. Sözkonusu bebeklerin tedavilerinin embriyo transfer işlemini gerçekleştiren sağlık hizmeti sunucusu dışındaki sözleşmeli (Mülga:RG-25/08/2022-31934/16-p md. Yürürlük:03/09/2022) sağlık hizmeti sunucusunda yapılması halinde söz konusu giderler Kurumca karşılanır ancak ödenen bedeller embriyo transfer işlemini yapan merkezden mahsup edilir.'});
CREATE (sec_793)-[:HAS_PARAGRAPH {order: 4}]->(para_798);
CREATE (para_797)-[:NEXT_PARAGRAPH]->(para_798);
CREATE (sec_799:Subsection {id: '2.4.4.İ.1', title: '4 - Kayıtların tutulması'});
CREATE (sec_791)-[:HAS_SUBSECTION {order: 1}]->(sec_799);
CREATE (para_800:Paragraph {id: '1', content: 'Kurumla sözleşmeli (Mülga:RG-25/08/2022-31934/16-r md. Yürürlük:03/09/2022) üremeye yardımcı tedavi merkezlerinde, IVF kapsamında yapılan her türlü tıbbi işlemin kaydının tutulması ve tutulan kayıtların denetim esnasında ibrazı zorunludur. Bu kayıtların doğru ve sağlıklı bir şekilde tutulması ve muhafazasında, merkez sorumlusu ve ruhsat (uygunluk belgesi) sahibi kişiler, müşterek ve müteselsilen yükümlüdür.'});
CREATE (sec_799)-[:HAS_PARAGRAPH {order: 0}]->(para_800);
CREATE (para_801:Paragraph {id: '2', content: 'Evli çiftlerin çocuklarının olup olmadığı ile eşler için vukuatlı nüfus kayıt örneği, merkezde tutulan hasta dosyasında saklanacaktır.'});
CREATE (sec_799)-[:HAS_PARAGRAPH {order: 1}]->(para_801);
CREATE (para_800)-[:NEXT_PARAGRAPH]->(para_801);
CREATE (sec_793)-[:NEXT_SUBSECTION]->(sec_799);
CREATE (sec_802:Subsection {id: '2.4.4.İ-2', title: 'Kök hücre vericisi kardeş doğmasına yönelik IVF tedavisi', content: '(Değişik: RG- 25/08/2022- 31934/ 16-s md. Yürürlük: 03/09/2022)'});
CREATE (sec_791)-[:HAS_SUBSECTION {order: 2}]->(sec_802);
CREATE (para_803:Paragraph {id: '1', content: 'Hasta çocuk sahibi olup, tedavisinin başka tıbbî bir yöntemle mümkün olmaması ve tıbben zorunlu görülmesi halinde bu çocuğun tedavisi amaçlı Preimplantasyon Genetik Tanı (PGT) yapılarak uygun kök hücre vericisi kardeş doğmasına yönelik olarak bünyesinde kemik iliği transplantasyon merkezi bulunan Sağlık Bakanlığına bağlı  üçüncü basamak hastaneler, Tıp Fakülteleri Bulunan Devlet Üniversiteleri Sağlık Uygulama ve Araştırma Merkezleri, Tıp Fakülteleri Bulunan Vakıf Üniversiteleri Sağlık Uygulama ve Araştırma Merkezleri sağlık kurulları tarafından hasta çocuk adına düzenlenen bu durumların belirtildiği genetik uzmanının yer aldığı sağlık kurulu raporuna dayanılarak yapılan IVF tedavilerine ilişkin giderler, SUT’un 2.4.4.İ-1 maddesinde yer alan hükümler uygulanmaksızın Kurumca karşılanır. Bu durum ve SUT’ un 2.4.4.İ-3 maddesinde belirtilen durumlar dışında preimplantasyon genetik tanı ve bu işlem ile birlikte yapılan IVF bedelleri Kurumca karşılanmaz.'});
CREATE (sec_802)-[:HAS_PARAGRAPH {order: 0}]->(para_803);
CREATE (para_804:Paragraph {id: '2', content: 'Aileler, söz konusu sağlık kurulu raporuna istinaden Kurumla sözleşmeli üremeye yardımcı tedavi merkezlerinden (tüp bebek merkezi) birine başvurabilirler.'});
CREATE (sec_802)-[:HAS_PARAGRAPH {order: 1}]->(para_804);
CREATE (para_803)-[:NEXT_PARAGRAPH]->(para_804);
CREATE (para_805:Paragraph {id: '3', content: 'Sağlık Kurulu raporu ile belirlenen ilaç dozları için SUT’un 4.2.42.C maddesinde yer alan hükümler geçerlidir. (Ek: RG- 11/08/2021- 31565 /4-ç md. Yürürlük: 11/08/2021)'});
CREATE (sec_802)-[:HAS_PARAGRAPH {order: 2}]->(para_805);
CREATE (para_804)-[:NEXT_PARAGRAPH]->(para_805);
CREATE (para_806:Paragraph {id: '4', content: 'PGT tetkikleri için EK-2/B listesinde yer alan (Değişik: RG- 08/02/2022- 31744/2-a md. Yürürlük: 16/02/2022) G101600 kodlu “Preimplantasyon Genetik Tanı Tetkikleri, kök hücre vericisi kardeş doğmasına yönelik” işlem fatura edilecek olup ön hazırlık ve embriyoya yapılan tüm işlemler dahildir. (Ek: RG- 11/08/2021- 31565 /4-d md. Yürürlük: 11/08/2021)'});
CREATE (sec_802)-[:HAS_PARAGRAPH {order: 3}]->(para_806);
CREATE (para_805)-[:NEXT_PARAGRAPH]->(para_806);
CREATE (amend_807:Amendment {content: '(Değişik:RG-21/04/2024- \n32524/8 md. Yürürlük:30/04/2024)'});
CREATE (sec_802)-[:HAS_AMENDMENT {order: 0}]->(amend_807);
CREATE (sec_799)-[:NEXT_SUBSECTION]->(sec_802);
CREATE (sec_808:Subsection {id: '2.4.4.İ-3', title: 'Sağlam çocuk doğmasına yönelik Preimplantasyon Genetik Tanı (PGT) ve IVF tedavisi'});
CREATE (sec_791)-[:HAS_SUBSECTION {order: 3}]->(sec_808);
CREATE (para_809:Paragraph {id: '1', content: 'Mevcut evliliğinde sağlam çocuk sahibi olan çiftler hariç olmak üzere; SUT eki “Preimplantasyon Genetik Tanı (PGT) ile Invitro Fertilizasyon (IVF) Yapılacak Kalıtsal Hastalıklar Listesi (EK-2/K)” nde yer alan kalıtsal bir hastalığı olan veya bu hastalık için taşıyıcı olduğu belgelenen evli çiftin PGT yapılarak sağlam çocuk doğmasına yönelik sözleşmeli (Mülga: RG-25/08/2022-31934/16-ş md. Yürürlük:03/09/2022) üçüncü basamak resmi sağlık hizmeti sunucularında düzenlenen sağlık kurulu raporuna dayanılarak yapılan IVF tedavilerine ilişkin giderler SUT’un 2.4.4.İ-1 maddesinin birinci fıkrasının (b), (c) ve (ç) bentlerinde belirtilen şartların birlikte gerçekleşmesi halinde en fazla üç deneme (siklus) ile sınırlı olmak üzere Kurumca karşılanır.'});

// Batch 22
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 0}]->(para_809);
CREATE (para_810:Paragraph {id: '2', content: 'PGT ile birlikte uygulanacak IVF tedavisi için gerekli sağlık kurulu raporu; sözleşmeli (Mülga:RG-25/08/2022- 31934/16-ş md. Yürürlük:03/09/2022) üçüncü basamak resmi sağlık hizmeti sunucularında SUT eki EK-2/K listesinde belirtilen branş hekimlerinin yer aldığı sağlık kurulu tarafından düzenlenecektir. Sağlık kurulu, sağlık hizmeti sunucusunda görevli hekimlerden oluşur.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 1}]->(para_810);
CREATE (para_809)-[:NEXT_PARAGRAPH]->(para_810);
CREATE (para_811:Paragraph {id: '3', content: 'Sağlık kurulu raporu ile belirlenen ilaç dozları için SUT’ un 4.2.42.D maddesinde yer alan hükümler geçerlidir.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 2}]->(para_811);
CREATE (para_810)-[:NEXT_PARAGRAPH]->(para_811);
CREATE (para_812:Paragraph {id: '4', content: 'Sağlam çocuk doğmasına yönelik preimplantasyon genetik tanı ile IVF tedavi bedelleri, SUT eki EK-2/K listesinde yer alan tanılarda Kurumca karşılanır. Bu tanılara ait evli çiftin tıbbi genetik uzman imzalı genetik danışmanlık notu ile klinik yorumun yapıldığı genetik tanı raporu bulunmalıdır.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 3}]->(para_812);
CREATE (para_811)-[:NEXT_PARAGRAPH]->(para_812);
CREATE (para_813:Paragraph {id: '5', content: 'PGT tetkikleri için EK-2/B listesinde yer alan (Değişik: RG- 08/02/2022- 31744/2-b md. Yürürlük: 16/02/2022) G101610 kodlu “Preimplantasyon Genetik Tanı Tetkikleri, sağlam çocuk doğmasına yönelik” işlem fatura edilecek olup ön hazırlık ve embriyoya yapılan tüm işlemler dahildir. 38'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 4}]->(para_813);
CREATE (para_812)-[:NEXT_PARAGRAPH]->(para_813);
CREATE (para_814:Paragraph {id: '6', content: 'Kurumla sözleşmeli (Mülga:RG-25/08/2022-31934/16-ş md. Yürürlük:03/09/2022) üremeye yardımcı tedavi merkezi (tüp bebek merkezi) tarafından elde edilen IVF’ye uygun embriyoların en fazla sekiz adet olmak üzere numaralandırılması gerekmekte olup, bu şekilde oluşturulan raporlar ile embriyoların genetik tanı raporunda belirtilen hastalık açısından “sağlıklı”, “taşıyıcı”, “hasta” olarak belirtildiği analiz sonuçlarını içeren raporların Kuruma incelemeye esas belge olarak gönderilmesi gereklidir.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 5}]->(para_814);
CREATE (para_813)-[:NEXT_PARAGRAPH]->(para_814);
CREATE (para_815:Paragraph {id: '7', content: 'Yalnızca genetik tanı raporunda belirtilen hastalık açısından “sağlıklı” embriyo transfer edilmelidir.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 6}]->(para_815);
CREATE (para_814)-[:NEXT_PARAGRAPH]->(para_815);
CREATE (para_816:Paragraph {id: '8', content: 'Kalıtsal bir hastalığı olan veya bu hastalık için taşıyıcı olduğu bilinen evli çiftin sağlam çocuk sahibi olmasına yönelik IVF işlemi, PGT ile belirlenen sağlıklı embriyo transferi ile yapıldığından üç deneme sayısı PGT için de geçerlidir. Üç deneme IVF yapılması durumunda PGT hakkı da sona erer.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 7}]->(para_816);
CREATE (para_815)-[:NEXT_PARAGRAPH]->(para_816);
CREATE (para_817:Paragraph {id: '9', content: 'PGT veya IVF hakkı en fazla üç deneme ile sınırlıdır.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 8}]->(para_817);
CREATE (para_816)-[:NEXT_PARAGRAPH]->(para_817);
CREATE (para_818:Paragraph {id: '10', content: 'PGT ile elde edilen ve transfer edilmeyen sağlıklı embriyo veya embriyoların freezing işlemi, IVF deneme hakkının bulunması durumunda Kurumca karşılanır.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 9}]->(para_818);
CREATE (para_817)-[:NEXT_PARAGRAPH]->(para_818);
CREATE (para_819:Paragraph {id: '11', content: 'IVF tedavisinin freezing işlemi uygulanan embriyonun transferi ile yapılması durumunda işlemler, SUT eki EK- 2/C listesinde yer alan “Freezing işlemi uygulanan embriyonun transferi” işlemi üzerinden faturalandırılacaktır. Bu durumda söz konusu işlem deneme sayısına dâhil edilecektir.'});
CREATE (sec_808)-[:HAS_PARAGRAPH {order: 10}]->(para_819);
CREATE (para_818)-[:NEXT_PARAGRAPH]->(para_819);
CREATE (sec_802)-[:NEXT_SUBSECTION]->(sec_808);
CREATE (sec_782)-[:NEXT_SUBSECTION]->(sec_791);
CREATE (sec_820:Subsection {id: '2.4.4.J', title: 'Kaplıca tedavileri'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 12}]->(sec_820);
CREATE (para_821:Paragraph {id: '1', content: 'Kaplıca tedavileri için, resmi sağlık (Değişik:RG-25/08/2022-31934/16-t md. Yürürlük:03/09/2022) hizmeti sunucularınca en az bir fiziksel tıp ve rehabilitasyon veya tıbbi ekoloji ve hidroklimatoloji uzman hekiminin yer aldığı sağlık kurulları tarafından sağlık kurulu raporu düzenlenecektir. Sağlık raporunda tanı, önerilen tedavi, seans ve gün sayısı bilgilerinin yer alması zorunludur.'});
CREATE (sec_820)-[:HAS_PARAGRAPH {order: 0}]->(para_821);
CREATE (para_822:Paragraph {id: '2', content: 'Sağlık kurulu raporunun düzenlendiği tarihten itibaren 6 ay içerisinde tedaviye başlanamaması halinde yeniden sağlık kurulu raporu düzenlenmesi gerekmektedir.'});
CREATE (sec_820)-[:HAS_PARAGRAPH {order: 1}]->(para_822);
CREATE (para_821)-[:NEXT_PARAGRAPH]->(para_822);
CREATE (para_823:Paragraph {id: '3', content: 'Kaplıca tedavisine gerek görülenler, Sağlık Bakanlığınca işletme izni verilen kaplıca tesislerine müracaat edebilirler. Sağlık Bakanlığınca işletme izni verilmeyen kaplıcalarda tedavi görenlerin, kaplıca tedavilerine ait bedeller Kurumca karşılanmaz.'});
CREATE (sec_820)-[:HAS_PARAGRAPH {order: 2}]->(para_823);
CREATE (para_822)-[:NEXT_PARAGRAPH]->(para_823);
CREATE (para_824:Paragraph {id: '4', content: 'Sağlık Bakanlığınca işletme izni verilen kaplıca tesisleri ile sözleşme yapılıncaya kadar kaplıca tedavilerine ait giderler, hasta tarafından karşılanacak olup tedaviye ilişkin fatura ve sağlık raporuna dayanılarak her bir gün için bir adet olmak üzere, SUT eki EK-2/B Listesinde “702.020” kodu ile yer alan “banyo-kaplıca” bedeli hastaya ödenir. SUT’ta yer alan diğer işlemler faturalandırılsa dahi bedelleri karşılanmaz.'});
CREATE (sec_820)-[:HAS_PARAGRAPH {order: 3}]->(para_824);
CREATE (para_823)-[:NEXT_PARAGRAPH]->(para_824);
CREATE (para_825:Paragraph {id: '5', content: 'Kaplıca tedavileri ile ilgili yol, gündelik ve refakatçi giderleri SUT’un 2.6 maddesi hükümlerine göre karşılanır.'});
CREATE (sec_820)-[:HAS_PARAGRAPH {order: 4}]->(para_825);
CREATE (para_824)-[:NEXT_PARAGRAPH]->(para_825);
CREATE (amend_826:Amendment {content: '(Ek: RG- 24/12/2014- 29215/ 6 md. Yürürlük: 01/01/2015)'});
CREATE (sec_820)-[:HAS_AMENDMENT {order: 0}]->(amend_826);
CREATE (sec_791)-[:NEXT_SUBSECTION]->(sec_820);
CREATE (sec_827:Subsection {id: '2.4.4.K', title: 'Palyatif Bakım Tedavisi', content: '(Değişik: RG- 25/08/2022- 31934/ 16-u md. Yürürlük: 03/09/2022)'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 13}]->(sec_827);
CREATE (para_828:Paragraph {id: '1', content: 'Palyatif bakım tedavisi, Sağlık Bakanlığınca palyatif bakım verme konusunda tescil edilmiş olan Sağlık Bakanlığına bağlı yataklı sağlık tesislerince ve Tıp Fakülteleri Bulunan Devlet Üniversiteleri Sağlık Uygulama ve Araştırma Merkezleri, Tıp Fakülteleri Bulunan Vakıf Üniversiteleri Sağlık Uygulama ve Araştırma Merkezleri tarafından faturalandırılır.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 0}]->(para_828);
CREATE (para_829:Paragraph {id: '2', content: 'Palyatif bakım tedavisi yalnızca palyatif bakım yatağında yatan hastalara verilen hizmettir.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 1}]->(para_829);
CREATE (para_828)-[:NEXT_PARAGRAPH]->(para_829);
CREATE (para_830:Paragraph {id: '3', content: 'Palyatif bakım tedavisi vermeye yetkili sağlık hizmeti sunucusunun tescil edilmiş palyatif bakım yatakları dışındaki herhangi bir yataktan bu hizmetleri göndermesi durumunda bu hizmet bedelleri Kurumca karşılanmaz.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 2}]->(para_830);
CREATE (para_829)-[:NEXT_PARAGRAPH]->(para_830);
CREATE (para_831:Paragraph {id: '4', content: 'Palyatif bakım tedavisi aşağıdaki hizmetleri kapsamaktadır.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 3}]->(para_831);
CREATE (item_832:Item {id: 'a', content: 'Beslenmesi fiziksel ve psikolojik/nörolojik nedenlerle bozulup enteral, parenteral beslenme desteğine ihtiyaç duyanlar,'});
CREATE (para_831)-[:HAS_ITEM {order: 0}]->(item_832);
CREATE (item_833:Item {id: 'b', content: 'Enfeksiyon, kas ve nörolojik hastalıklar nedeniyle solunumu bozulmuş olup, invaziv ve noninvaziv mekanik ventilasyon desteğine ihtiyacı olan hastalar,'});
CREATE (para_831)-[:HAS_ITEM {order: 1}]->(item_833);
CREATE (item_832)-[:NEXT_ITEM]->(item_833);
CREATE (item_834:Item {id: 'c', content: 'Enfekte yatak yarası açılan, ostomi bölgelerinde enfeksiyon, kaçak sorunları olan(trakeotomi, gastrostomi, ileostomi, kolostomi vs), kateteri olup tıkanan, kırılan, giriş yeri enfeksiyonu olan yada katetere bağlı fonksiyon bulguları bulunan (diyaliz kateteri, santral venöz kateteri, şant kateterleri, ağrı portu ve kateteri, perkütan plevral kateter, perkütan mesane kateteri) hastalarının tedavisi ve tıbbi sorunlarının giderilmesi,'});
CREATE (para_831)-[:HAS_ITEM {order: 2}]->(item_834);
CREATE (item_833)-[:NEXT_ITEM]->(item_834);
CREATE (para_830)-[:NEXT_PARAGRAPH]->(para_831);
CREATE (para_835:Paragraph {id: '5', content: 'Palyatif bakım tedavisi EK-2/C Listesindeki P560000 SUT kodundan günde en fazla 1(bir) kez faturalandırılır.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 4}]->(para_835);
CREATE (para_831)-[:NEXT_PARAGRAPH]->(para_835);
CREATE (para_836:Paragraph {id: '6', content: 'Palyatif bakım tedavisi altında tedavi gören hastaya EK-2/C Listesindeki işlemlerden herhangi birinin yapılması durumunda, EK-2/C Listesindeki işlem bedeli faturalandırılır ve 2.2.2.B-1(3) maddesinde belirtilen sürelerde palyatif bakım tedavisi adı altında herhangi bir bedel ödenmez.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 5}]->(para_836);
CREATE (para_835)-[:NEXT_PARAGRAPH]->(para_836);
CREATE (para_837:Paragraph {id: '7', content: 'Palyatif bakım tedavisine tanı ve tedavi kapsamında yapılan tüm işlemler (SUT’un  2.2.2.B-1 maddesinin birinci fıkrasının (e) bendinde belirtilen tanıya dayalı işlemler kapsamında kullanılması halinde sağlık hizmeti sunucularınca ayrıca faturalandırılan kan bileşenleri oranları ve SUT’un 2.4.4.H maddesinin altıncı fıkrasında yer alan ilaçlar hariç) dahil olup ayrıca faturalandırılamaz.'});
CREATE (sec_827)-[:HAS_PARAGRAPH {order: 6}]->(para_837);
CREATE (para_836)-[:NEXT_PARAGRAPH]->(para_837);
CREATE (amend_838:Amendment {content: '(Değişik: RG-05/07/2018-30469/ 5 md. Yürürlük: 05/07/2018)'});
CREATE (sec_827)-[:HAS_AMENDMENT {order: 0}]->(amend_838);
CREATE (amend_839:Amendment {content: '(Değişik: RG- 28/12/2018- \n30639/ 6 md. Yürürlük: 05/07/2018)'});
CREATE (sec_827)-[:HAS_AMENDMENT {order: 1}]->(amend_839);
CREATE (amend_840:Amendment {content: '(Ek:RG-25/03/2017-30018/9 md. Yürürlük:05/04/2017)'});
CREATE (sec_827)-[:HAS_AMENDMENT {order: 2}]->(amend_840);
CREATE (sec_820)-[:NEXT_SUBSECTION]->(sec_827);
CREATE (sec_841:Subsection {id: '2.4.4.L', title: 'Epidural Girişimler'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 14}]->(sec_841);
CREATE (para_842:Paragraph {id: '1', content: 'P551120, P615895 ve P615991 kodlu işlemler sadece SUT EK-2/C Listesinde belirtilen puanlar üzerinden faturalandırılacaktır. Bu işlemlerin bedelleri algoloji, beyin cerrahisi ve ortopedi ve travmatoloji branş hekimlerince üçüncü basamak sağlık hizmet sunucularında yapılması halinde Kurumca karşılanacaktır.'});
CREATE (sec_841)-[:HAS_PARAGRAPH {order: 0}]->(para_842);
CREATE (para_843:Paragraph {id: '2', content: 'Transsakral girişimle kamera eşliğinde lomber Epidural Diskoplasti/Adezyolizis/Nöroplasti amaçlı P551120, P615895 ve P615991 kodlu işlemlerin yapılabilmesi için algoloji, nöroloji, fiziksel tıp ve rehabilitasyon, ortopedi ve travmatoloji ile beyin cerrahi branşlarından herhangi üç uzman hekim tarafından oluşturulan sağlık kurulu raporu düzenlenmesi gerekir.'});
CREATE (sec_841)-[:HAS_PARAGRAPH {order: 1}]->(para_843);
CREATE (para_842)-[:NEXT_PARAGRAPH]->(para_843);
CREATE (para_844:Paragraph {id: '3', content: 'Aşağıdaki kriterlerin tespit edildiği lomber vakalarda; 39'});
CREATE (sec_841)-[:HAS_PARAGRAPH {order: 2}]->(para_844);
CREATE (item_845:Item {id: 'a', content: 'Daha Önce Cerrahi Tedavi Uygulanmamış Lomber Spondiloz ve Dejeneratif Disk Hastalığı Olan Olgular İçin; aşağıdaki kriterlerin tümünün varlığı halinde; arka kök gangliona yönelik girişimler veya epidural enjeksiyon tedavilerinden en az birini görmüş olma ) tedavilerinden fayda görmemiş olması,'});
CREATE (para_844)-[:HAS_ITEM {order: 0}]->(item_845);

// Batch 23
CREATE (subitem_846:SubItem {id: '1', content: 'Üç (3) aylık sürede konservatif tedavi, fizik tedavi, girişimsel ağrı işlemleri ( faset ekleme yönelik girişimler veya'});
CREATE (item_845)-[:HAS_SUBITEM {order: 0}]->(subitem_846);
CREATE (subitem_847:SubItem {id: '2', content: 'Radyolojik incelemelerinde ekstrude ve sekestre disk hernisinin olmaması,'});
CREATE (item_845)-[:HAS_SUBITEM {order: 1}]->(subitem_847);
CREATE (subitem_846)-[:NEXT_SUBITEM]->(subitem_847);
CREATE (subitem_848:SubItem {id: '3', content: 'Radiküler ağrının olması (bacak ağrısı),'});
CREATE (item_845)-[:HAS_SUBITEM {order: 2}]->(subitem_848);
CREATE (subitem_847)-[:NEXT_SUBITEM]->(subitem_848);
CREATE (item_849:Item {id: 'b', content: 'Daha Önce Spinal Cerrahi Tedavi Uygulanmış Nüks Olgular İçin; yeni nörolojik defisiti olmayan, sekestre lomber disk hernisi bulunmayan, kontrastlı manyetik rezonans görüntüleme yöntemi ile işlem bölgesinde fibrozise ilişkin granülasyon dokusunun varlığı halinde, bedeli Kurumca karşılanır.'});
CREATE (para_844)-[:HAS_ITEM {order: 1}]->(item_849);
CREATE (item_845)-[:NEXT_ITEM]->(item_849);
CREATE (para_843)-[:NEXT_PARAGRAPH]->(para_844);
CREATE (sec_827)-[:NEXT_SUBSECTION]->(sec_841);
CREATE (sec_850:Subsection {id: '2.4.4.M', title: 'İntraoperatif Nöromonitörizasyon İşlemi'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 15}]->(sec_850);
CREATE (para_851:Paragraph {id: '1', content: 'SUT eki EK-2/D-4 Listesinde yer alan işlemlerin, P703365 kodlu “Intraoperatif nöromonitörizasyon” işlemi ile birlikte uygulanması şartıyla SUT’un 2.2.2.B (3) fıkrasında belirtilen kurallar uygulanmaksızın faturalandırılması halinde Kurumca karşılanır.'});
CREATE (sec_850)-[:HAS_PARAGRAPH {order: 0}]->(para_851);
CREATE (para_852:Paragraph {id: '2', content: 'İntraoperatif nöromonitörizasyon işleminde; cerrahi işlemi gerçekleştiren hekim ve nöroloji/nörofizyoloji/fizik tedavi ve rehabilitasyon alanında uzmanlık ve/veya yan dal eğitimi almış hekimler tarafından düzenlenecek nöromonitörizasyon kayıt raporunun bir sureti fatura eki belge olarak ibraz edilmelidir.'});
CREATE (sec_850)-[:HAS_PARAGRAPH {order: 1}]->(para_852);
CREATE (para_851)-[:NEXT_PARAGRAPH]->(para_852);
CREATE (amend_853:Amendment {content: '(Ek:RG-08/06/2017-30090/4 md. Yürürlük:19/06/2017)'});
CREATE (sec_850)-[:HAS_AMENDMENT {order: 0}]->(amend_853);
CREATE (sec_841)-[:NEXT_SUBSECTION]->(sec_850);
CREATE (sec_854:Subsection {id: '2.4.4.N', title: 'Epidermolizis Bülloza'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 16}]->(sec_854);
CREATE (para_855:Paragraph {id: '1', content: '(Değişik: RG-25/08/2022-31934/16-ü md. Yürürlük:03/09/2022) Epidermolizis bülloza tanılı hastalara yara bakım hizmetlerinin ödenebilmesi için üçüncü basamak  resmi sağlık hizmeti sunucuları  tarafından, deri ve zührevi hastalıkları uzman hekimi, plastik, rekonstrüktif ve estetik cerrahi uzman hekimi ile genel cerrahi veya çocuk cerrahisi uzman hekimlerinin yer aldığı sağlık kurulu raporu düzenlenmesi gerekmektedir. Sağlık kurulu raporu 1 (bir) yıl geçerlidir. Bu hastaların tedavisi, yatan hastalar için Sağlık Bakanlığı’na bağlı sağlık hizmeti sunucuları ve üniversite hastaneleri tarafından sağlanacaktır. Epidermolizis bülloza hastalarının ayakta tedavisi ise sadece Evde Sağlık Hizmeti Birimlerince faturalandırılabilir. Epidermolizis bülloza tanılı hastaların yatarak veya ayakta tedavileri kapsamındaki yara bakım hizmetleri SUT EK-2/B Listesinde yer alan “530533” kodlu “Epidermolizis bülloza hastalığında yara bakım hizmetleri” işlemi üzerinden faturalandırılır. Bu grup hastalara yara bakım hizmetlerinde kullanılan malzemeler işlem puanına dahil olup sağlık hizmeti sunucularınca ayrıca faturalandırılmaz ve şahıs ödemesi kapsamında da herhangi bir ödeme yapılmaz. Ancak bu kapsamda tedavi gören hastalara kullanılan malzemelerin sağlık hizmeti sunucuları tarafından temin edilmeyerek hastaya reçete karşılığı dışarıdan temin ettirilmesi durumunda fatura tutarı ilgili hastaya ödenerek sağlık hizmeti sunucusuna yapılacak ödemeden düşülür.'});
CREATE (sec_854)-[:HAS_PARAGRAPH {order: 0}]->(para_855);
CREATE (amend_856:Amendment {content: '(Ek:RG-16/03/2023-32134/14 md. Yürürlük:24/03/2023)'});
CREATE (sec_854)-[:HAS_AMENDMENT {order: 0}]->(amend_856);
CREATE (amend_857:Amendment {content: '(Mülga:RG-16/03/2023-32134/14 md. Yürürlük:24/03/2023)'});
CREATE (sec_854)-[:HAS_AMENDMENT {order: 1}]->(amend_857);
CREATE (amend_858:Amendment {content: '(Ek: RG- 04/02/2018-30322/13 md. Yürürlük:15/02/2018)'});
CREATE (sec_854)-[:HAS_AMENDMENT {order: 2}]->(amend_858);
CREATE (sec_850)-[:NEXT_SUBSECTION]->(sec_854);
CREATE (sec_859:Subsection {id: '2.4.4.O', title: 'Obezite Cerrahisi'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 17}]->(sec_859);
CREATE (para_860:Paragraph {id: '1', content: 'SUT ve eki listelerinde yer alan obezite cerrahisi işlemlerinin faturalandırılmasında aşağıdaki kurallara uyulur.'});
CREATE (sec_859)-[:HAS_PARAGRAPH {order: 0}]->(para_860);
CREATE (item_861:Item {id: 'a', content: 'BMI > 40 kg/m2 olan kişilerde; genel cerrahi, endokrinoloji (endokrinoloji uzmanının bulunmaması halinde dahiliye), akıl ve ruh sağlığı hastalıkları ile anestezi ve reanimasyon uzman hekimlerinin yer aldığı ve tıbbi endikasyonun belirtildiği sağlık kurulu raporunun düzenlenmesi gerekmektedir.'});
CREATE (para_860)-[:HAS_ITEM {order: 0}]->(item_861);
CREATE (item_862:Item {id: 'b', content: 'BMI 35-40 kg/m2 olan ve eşlik eden hastalığı bulunan (koroner arter, diabetes mellitus, hiperlipidemi, hipertansiyon, uyku apnesi, hareket kısıtlılığına neden olan dejeneratif osteoartrit ve vertebral disk bozuklukları) kişilerde; genel cerrahi, endokrinoloji (endokrinoloji uzmanının bulunmaması halinde dahiliye), akıl ve ruh sağlığı hastalıkları, anestezi ve reanimasyon uzman hekimleri ile mevcut eşlik eden hastalığı ile ilgili branş uzman hekiminin de yer aldığı ve tıbbi endikasyonun belirtildiği sağlık kurulu raporunun düzenlenmesi gerekmektedir.'});
CREATE (para_860)-[:HAS_ITEM {order: 1}]->(item_862);
CREATE (item_861)-[:NEXT_ITEM]->(item_862);
CREATE (item_863:Item {id: 'c', content: 'BMI 35-40 kg/m2 olan ve eşlik eden hastalığı bulunan (koroner arter, diabetes mellitus, hiperlipidemi, hipertansiyon, uyku apnesi, hareket kısıtlılığına neden olan dejeneratif osteoartrit ve vertebral disk bozuklukları) kişilere düzenlenecek sağlık kurulu raporunda; uzman kontrolünde en az 6 ay yaşam tarzı değişikliği ve/veya medikal tedavi ile kilo verilemediğinin belirtilmesi gerekmektedir.'});
CREATE (para_860)-[:HAS_ITEM {order: 2}]->(item_863);
CREATE (item_862)-[:NEXT_ITEM]->(item_863);
CREATE (item_864:Item {id: 'ç', content: 'Sağlık kurulu, hizmeti veren sağlık hizmeti sunucusunda görevli hekimlerden oluşur ve düzenlendiği sağlık hizmeti sunucusunda geçerlidir.'});
CREATE (para_860)-[:HAS_ITEM {order: 3}]->(item_864);
CREATE (item_863)-[:NEXT_ITEM]->(item_864);
CREATE (item_865:Item {id: 'd', content: 'Obezite cerrahisinin yapılacağı sağlık tesislerinin tescili yapılmış üçüncü seviye erişkin yoğun bakım servisi ve endoskopi ünitesi ile obezite şartlarına uygun alt yapı ve cerrahi donanım şartlarını haiz ameliyathanesi bulunmalıdır.'});
CREATE (para_860)-[:HAS_ITEM {order: 4}]->(item_865);
CREATE (item_864)-[:NEXT_ITEM]->(item_865);
CREATE (amend_866:Amendment {content: '(Ek:RG-10/12/2021-31685/2 md. Yürürlük:25/12/2021)'});
CREATE (sec_859)-[:HAS_AMENDMENT {order: 0}]->(amend_866);
CREATE (sec_854)-[:NEXT_SUBSECTION]->(sec_859);
CREATE (sec_867:Subsection {id: '2.4.4.Ö', title: 'İntraoperatif Nöronavigasyon İşlemi'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 18}]->(sec_867);
CREATE (para_868:Paragraph {id: '1', content: '“İntraoperatif nöronavigasyon” işlem bedeli SUT eki EK-2/C listesinde yer alan P614981 kodu üzerinden ve SUT’ un 2.2.2.B numaralı maddesinin üçüncü fıkrasında belirtilen kurallar uygulanmaksızın faturalandırılacak olup; SUT eki “İntraoperatif Nöronavigasyon İşleminin Ayrıca Faturalandırılabileceği İşlemler Listesi (EK-2/D-5)” nde yer alan işlemler ile birlikte uygulanması ve işlemin beyin ve sinir cerrahisi ile kulak burun boğaz hastalıkları uzman hekimleri tarafından gerçekleştirilmesi halinde bedeli Kurumca karşılanır.'});
CREATE (sec_867)-[:HAS_PARAGRAPH {order: 0}]->(para_868);
CREATE (amend_869:Amendment {content: '(Ek:RG- 25/09/2024-32673/4 md. Yürürlük: 03/10/2024)'});
CREATE (sec_867)-[:HAS_AMENDMENT {order: 0}]->(amend_869);
CREATE (sec_859)-[:NEXT_SUBSECTION]->(sec_867);
CREATE (sec_870:Subsection {id: '2.4.4.P', title: 'Prostat adenokarsinom tedavilerinde Lu-177 veya Y-90 işaretli PSMA bileşiklerinin kullanım', content: 'kriterleri;'});
CREATE (sec_606)-[:HAS_SUBSECTION {order: 19}]->(sec_870);
CREATE (para_871:Paragraph {id: '1', content: 'Nükleer tıp, üroloji ve tıbbi onkoloji uzman hekiminin yer aldığı 3 (üç) imzalı, tıbbi gerekçenin belirtildiği sağlık kurulu raporu bulunmalıdır.'});
CREATE (sec_870)-[:HAS_PARAGRAPH {order: 0}]->(para_871);
CREATE (para_872:Paragraph {id: '2', content: 'Sağlık kurulu raporunda progrese, kastrasyona dirençli prostat kanseri tanısının bulunması gerekir. 40'});
CREATE (sec_870)-[:HAS_PARAGRAPH {order: 1}]->(para_872);
CREATE (para_871)-[:NEXT_PARAGRAPH]->(para_872);
CREATE (para_873:Paragraph {id: '3', content: 'Tedavi öncesinde kan testesteron düzeyinin 50 ng/dl altında olması gerekir. Tedaviye başlanması için PSA değeri kriter değildir.'});
CREATE (sec_870)-[:HAS_PARAGRAPH {order: 2}]->(para_873);
CREATE (para_872)-[:NEXT_PARAGRAPH]->(para_873);
CREATE (para_874:Paragraph {id: '4', content: 'Lu-177 veya Y-90 işaretli PSMA bileşikleri ile radyonüklid tedavi öncesi standart antineoplastik tedavilere (dosetaksel, kabazitaksel) refrakter olmalıdır. Hastaya enzulatamid veya abirateron tedavilerinden biri kullanılmış veya bu tedavileri alamıyor olmalıdır. Hastanın performans skoru ≤ 2 olmalı, organ fonksiyonları yeterli olmalıdır.'});
CREATE (sec_870)-[:HAS_PARAGRAPH {order: 3}]->(para_874);
CREATE (para_873)-[:NEXT_PARAGRAPH]->(para_874);
CREATE (para_875:Paragraph {id: '5', content: 'Lu-177 veya Y-90 işaretli PSMA bileşikleri ile tedavisi öncesinde Ga-68 PSMA PET görüntülemenin mutlaka yapılmış olması ve en az 3 odakta patolojik tutulumun bulunması gerekir.'});
CREATE (sec_870)-[:HAS_PARAGRAPH {order: 4}]->(para_875);
CREATE (para_874)-[:NEXT_PARAGRAPH]->(para_875);
CREATE (para_876:Paragraph {id: '6', content: 'Tedavi en az 6 hafta ara ile uygulanır, elde edilen cevaba göre en fazla 8 tedavi dozu şeklinde uygulanır.'});
CREATE (sec_870)-[:HAS_PARAGRAPH {order: 5}]->(para_876);
CREATE (para_875)-[:NEXT_PARAGRAPH]->(para_876);
CREATE (sec_867)-[:NEXT_SUBSECTION]->(sec_870);
CREATE (sec_596)-[:NEXT_SUBSECTION]->(sec_606);
CREATE (sec_508)-[:NEXT_SECTION]->(sec_515);
CREATE (sec_877:Section {id: '2.5', title: 'Yurt dışında tedavi'});
CREATE (doc_1)-[:HAS_SECTION {order: 15}]->(sec_877);
CREATE (sec_878:Subsection {id: '2.5.1', title: 'Yurt dışında görevlendirme halinde sağlanacak sağlık hizmetleri'});
CREATE (sec_877)-[:HAS_SUBSECTION {order: 0}]->(sec_878);
CREATE (para_879:Paragraph {id: '1', content: '5510 sayılı Kanunun 4 üncü maddesinin birinci fıkrasının (a) bendinde sayılan sigortalılardan işverenleri tarafından, 5510 sayılı Kanunun 4 üncü maddesinin birinci fıkrasının (c) bendinde sayılan sigortalılardan özel mevzuatlarında belirtilen usûle uygun olarak;'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 0}]->(para_879);
CREATE (item_880:Item {id: 'a', content: 'Geçici görevle yurt dışına gönderilenlere sadece acil hallerde,'});
CREATE (para_879)-[:HAS_ITEM {order: 0}]->(item_880);
CREATE (item_881:Item {id: 'b', content: 'Sürekli görevle gönderilenler ile bunların yurt dışında birlikte yaşadıkları bakmakla yükümlü olduğu kişilere, acil hal olup olmadığına bakılmaksızın, sağlanan sağlık hizmetleri bedelleri, yurt içinde sözleşmeli sağlık hizmeti sunucularına tedavinin yapıldığı tarihte ödenen en yüksek tutarı aşmamak kaydıyla Kurumca karşılanır.'});
CREATE (para_879)-[:HAS_ITEM {order: 1}]->(item_881);
CREATE (item_880)-[:NEXT_ITEM]->(item_881);
CREATE (para_882:Paragraph {id: '2', content: 'Sağlık hizmeti giderleri, öncelikle işverenler tarafından ödenir ve yurt dışında görevli olunduğuna dair belge ile birlikte (belgede geçici veya sürekli görevlendirme yapıldığının belirtilmesi gerekmektedir) mahalli konsolosluktan, Kuzey Kıbrıs Türk Cumhuriyeti’nde görevli Türk Silahlı Kuvvetleri personeline ait belgelerin ise konsolosluk veya görevlendireceği/yetki devredeceği kurum/kuruluş tarafından tasdikli rapor, fatura ve sair belgelere dayanılarak Kurumdan talep edilir. Kurumca ödemeler, ödeme tarihindeki Türkiye Cumhuriyeti Merkez Bankası döviz satış kuru esas alınarak Türk Lirası üzerinden yapılır. Tedavi giderinin Kurumun ödediği tutarları aşması halinde aşan kısım, işverenlerce karşılanır. Uluslararası sözleşme hükümleri saklıdır.'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 1}]->(para_882);
CREATE (para_879)-[:NEXT_PARAGRAPH]->(para_882);
CREATE (para_883:Paragraph {id: '3', content: 'Yurt dışına geçici veya sürekli görevle gönderilen kişilerin sağlık hizmetlerinin, Kurumca ilgili ülkede sağlık sigortası yaptırmak suretiyle sağlanması halinde sağlık hizmeti giderleri ödenmez.'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 2}]->(para_883);

// Batch 24
CREATE (para_882)-[:NEXT_PARAGRAPH]->(para_883);
CREATE (para_884:Paragraph {id: '4', content: 'Yurt dışına geçici veya sürekli görevle gönderilenlerin bulunduğu ülkede sözleşmeli sağlık hizmeti sunucusu bulunması halinde tedavi giderleri sözleşme hükümlerine göre ödenir.'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 3}]->(para_884);
CREATE (para_883)-[:NEXT_PARAGRAPH]->(para_884);
CREATE (para_885:Paragraph {id: '5', content: 'Yurt dışına geçici veya sürekli görevle gönderilen kişiler ile bakmakla yükümlü olduğu kişiler için yol gideri, gündelik, refakatçi ve cenaze giderleri ödenmez.'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 4}]->(para_885);
CREATE (para_884)-[:NEXT_PARAGRAPH]->(para_885);
CREATE (para_886:Paragraph {id: '6', content: 'Kuzey Kıbrıs Türk Cumhuriyeti’nde Kurumla sözleşmeli sağlık hizmeti sunucusu bulunması halinde, geçici ya da sürekli görevle bu ülkede bulunanlar ile bakmakla yükümlü olduğu kişilerin acil haller hariç sözleşmesiz sağlık hizmeti sunucularından alınan sağlık hizmeti bedelleri Kurumca karşılanmaz.'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 5}]->(para_886);
CREATE (para_885)-[:NEXT_PARAGRAPH]->(para_886);
CREATE (para_887:Paragraph {id: '7', content: '5510 sayılı Kanunun 60 ıncı maddesinin on ikinci fıkrası kapsamında genel sağlık sigortalısı sayılanlardan özel mevzuatlarında belirtilen usule uygun olarak sürekli veya geçici görevle yurtdışına gönderilenlere acil hal olup olmadığına bakılmaksızın, sağlanan sağlık hizmeti bedelleri, yurt içinde sözleşmeli sağlık hizmeti sunucularına tedavinin yapıldığı tarihte ödenen en yüksek tutarı aşmamak kaydıyla Kurumca karşılanır.'});
CREATE (sec_878)-[:HAS_PARAGRAPH {order: 6}]->(para_887);
CREATE (para_886)-[:NEXT_PARAGRAPH]->(para_887);
CREATE (amend_888:Amendment {content: '(Ek: RG- 30/08/2014- 29104/ 2 md. Yürürlük: 18/04/2014)'});
CREATE (sec_878)-[:HAS_AMENDMENT {order: 0}]->(amend_888);
CREATE (amend_889:Amendment {content: '(Ek: RG- 25/03/2017- 30018/ 10 md. Yürürlük: 01/03/2017)'});
CREATE (sec_878)-[:HAS_AMENDMENT {order: 1}]->(amend_889);
CREATE (sec_890:Subsection {id: '2.5.2', title: 'Yurt dışında bulunma halinde sağlanacak sağlık hizmetleri'});
CREATE (sec_877)-[:HAS_SUBSECTION {order: 1}]->(sec_890);
CREATE (para_891:Paragraph {id: '1', content: 'Genel sağlık sigortalısı veya bakmakla yükümlü olduğu kişilerin yurt dışında bulundukları sırada sağlanan sağlık hizmetlerine ilişkin bedellerin ödenmesinde, bulundukları ülke ile Türkiye arasında sağlık yardımlarını kapsayan sosyal güvenlik sözleşmesi olması halinde sözleşme hükümleri uygulanır. Sağlık yardımlarını kapsayan sosyal güvenlik sözleşmesinin olmaması halinde, sağlık hizmetleri giderleri ile yol gideri, gündelik ve refakatçi vb. giderler ödenmez.'});
CREATE (sec_890)-[:HAS_PARAGRAPH {order: 0}]->(para_891);
CREATE (para_892:Paragraph {id: '2', content: 'Türk vatandaşı olan genel sağlık sigortalılarının ve bakmakla yükümlü olduğu kişilerin Kuzey Kıbrıs Türk Cumhuriyetinde bulundukları sırada sağlanan sağlık hizmeti bedelleri, yurt içinde sözleşmeli sağlık hizmeti sunucularına ödenen en yüksek tutarı geçmemek üzere Kurumca karşılanır. Bu ülkede Kurumla sözleşmeli sağlık hizmeti sunucusu bulunması halinde acil haller hariç sözleşmesiz sağlık hizmeti sunucularından alınan sağlık hizmeti bedelleri Kurumca karşılanmaz. Bu fıkra kapsamında olan kişilere ayrıca yol ve gündelik gideri ödenmez.'});
CREATE (sec_890)-[:HAS_PARAGRAPH {order: 1}]->(para_892);
CREATE (para_891)-[:NEXT_PARAGRAPH]->(para_892);
CREATE (amend_893:Amendment {content: '(Ek: RG- 30/08/2014- 29104/ 3 md. Yürürlük: 18/04/2014)'});
CREATE (sec_890)-[:HAS_AMENDMENT {order: 0}]->(amend_893);
CREATE (sec_878)-[:NEXT_SUBSECTION]->(sec_890);
CREATE (sec_894:Subsection {id: '2.5.3', title: 'Tetkik/tedavi için yurt dışına gönderilme halinde sağlanacak sağlık hizmetleri'});
CREATE (sec_877)-[:HAS_SUBSECTION {order: 2}]->(sec_894);
CREATE (sec_895:Subsection {id: '2.5.3.A', title: 'Yurt dışı tedavi'});
CREATE (sec_894)-[:HAS_SUBSECTION {order: 0}]->(sec_895);
CREATE (para_896:Paragraph {id: '1', content: 'Yurt içi sağlık hizmeti sunucularında sağlanamayan sağlık hizmetlerinin yurt dışı sağlık hizmeti sunucularında sağlanabilmesi için aşağıdaki düzenlemelere uyulacaktır.'});
CREATE (sec_895)-[:HAS_PARAGRAPH {order: 0}]->(para_896);
CREATE (sec_897:Subsection {id: '2.5.3.A-1', title: 'Yurt dışı tedavi sağlık kurulu raporu'});
CREATE (sec_895)-[:HAS_SUBSECTION {order: 0}]->(sec_897);
CREATE (para_898:Paragraph {id: '1', content: 'Yurt dışı tedavi için gerekli sağlık kurulu raporları;'});
CREATE (sec_897)-[:HAS_PARAGRAPH {order: 0}]->(para_898);
CREATE (item_899:Item {id: 'a', content: 'Doku ve organ nakli için Kurumun resmi internet sitesinde yayımlanan “Yurt Dışında Doku ve Organ Nakli Amacıyla Sağlık Kurulu Raporu Vermeye Yetkili Resmi Sağlık Kurumları Listesi” nde yer alan hastanelerin sağlık kurullarınca, )'});
CREATE (para_898)-[:HAS_ITEM {order: 0}]->(item_899);
CREATE (item_900:Item {id: 'b', content: 'Diğer tedaviler için ise üçüncü basamak resmi sağlık kurumlarının sağlık kurullarınca,'});
CREATE (para_898)-[:HAS_ITEM {order: 1}]->(item_900);
CREATE (item_899)-[:NEXT_ITEM]->(item_900);
CREATE (item_901:Item {id: 'c', content: 'SUT eki “Yurt Dışına Tedaviye Gönderileceklere İlişkin Sağlık Kurulu Raporu” (EK-2/E-1) formatına uygun olarak düzenlenecek ve raporda altı ayı geçmemek kaydı ile tedavi süresi belirtilecektir.'});
CREATE (para_898)-[:HAS_ITEM {order: 2}]->(item_901);
CREATE (item_900)-[:NEXT_ITEM]->(item_901);
CREATE (para_902:Paragraph {id: '2', content: 'Sağlık kurulu en az biri ilgili dal uzman hekimi olmak kaydıyla; üniversite hastanelerinde beş öğretim üyesi, eğitim ve araştırma hastanelerinde beş eğitim görevlisi katılımıyla oluşturulacaktır.'});
CREATE (sec_897)-[:HAS_PARAGRAPH {order: 1}]->(para_902);
CREATE (para_898)-[:NEXT_PARAGRAPH]->(para_902);
CREATE (para_903:Paragraph {id: '3', content: 'Düzenlenen sağlık kurulu raporları (Değişik: RG- 04/09/2019- 30878/ 4-a md. Yürürlük: 26/05/2019) Ankara Şehir Hastanesi, İstanbul Şişli Hamidiye Etfal Eğitim ve 41 Araştırma Hastanesi ve İzmir Yenişehir Eğitim ve Araştırma Hastanesinden herhangi biri tarafından teyit edilecek ve sonrasında Sağlık Bakanlığınca onaylanacaktır.'});
CREATE (sec_897)-[:HAS_PARAGRAPH {order: 2}]->(para_903);
CREATE (para_902)-[:NEXT_PARAGRAPH]->(para_903);
CREATE (para_904:Paragraph {id: '4', content: 'Söz konusu işlemler sonrasında, Dışişleri Bakanlığı nezdinde gerçekleştirilecek işlemler Kurum tarafından yürütülecektir.'});
CREATE (sec_897)-[:HAS_PARAGRAPH {order: 3}]->(para_904);
CREATE (para_903)-[:NEXT_PARAGRAPH]->(para_904);
CREATE (amend_905:Amendment {content: '(Değişik: RG- 30/08/2014- 29104/ 4 md. Yürürlük: 25/07/2014)'});
CREATE (sec_897)-[:HAS_AMENDMENT {order: 0}]->(amend_905);
CREATE (amend_906:Amendment {content: '(Mülga: RG- 07/10/2016- 29850/ 8 md. Yürürlük: 18/10/2016)'});
CREATE (sec_897)-[:HAS_AMENDMENT {order: 1}]->(amend_906);
CREATE (sec_907:Subsection {id: '2.5.3.A-2', title: 'Raporların yenilenmesi, bekleme süreleri ve süre uzatımı'});
CREATE (sec_895)-[:HAS_SUBSECTION {order: 1}]->(sec_907);
CREATE (para_908:Paragraph {id: '1', content: 'Yurt dışı tedaviye ilişkin raporların Sağlık Bakanlığınca onaylanmasından itibaren üç ay içinde yurt dışına çıkılmaması nedeniyle işlem yapılmayan raporların yenilenmesi gerekir.'});
CREATE (sec_907)-[:HAS_PARAGRAPH {order: 0}]->(para_908);
CREATE (para_909:Paragraph {id: '2', content: 'Yurt dışı tedavi süresi raporda belirtilen süreyi geçemez. Tıbbi nedenlerle yurt dışında tedavinin uzaması halinde, tıbbi gerekçeler misyon şeflikleri vasıtasıyla Kuruma gönderilir. Tedavi süresinin uzatılmasının uygun olup olmadığı konusunda (Değişik: RG- 04/09/2019- 30878/ 4-b md. Yürürlük: 26/05/2019) Ankara Şehir Hastanesinin veya bu konuda Kurumca yetkilendirilmiş hastanelerden birinin yazılı görüşü alınarak altı ayı geçmeyen dönemler halinde (Mülga: RG- 25/07/2014- 29071/ 12 md. Yürürlük: 01/01/2014 ) Kurumun onayı ile tedavi süresi uzatılabilir. Belirlenen ya da uzatılan sürenin aşılması halinde aşılan süreye ait tedavi giderleri ile gündelik ve refakatçi giderleri ödenmez.'});
CREATE (sec_907)-[:HAS_PARAGRAPH {order: 1}]->(para_909);
CREATE (para_908)-[:NEXT_PARAGRAPH]->(para_909);
CREATE (para_910:Paragraph {id: '3', content: 'Yurt içinde sağlanamayan organ nakli işlemleri yurt dışında uzun bekleme sürelerini gerektirdiğinden, hastaların yurt dışındaki ilk tetkiklerinin tamamlanmasını müteakip uygun organ teminine kadar geçecek süredeki tetkik ve tedavileri yurt içinde yapılacaktır. Uygun organ temini üzerine hasta, yeni bir sağlık kurulu raporuna ihtiyaç duyulmadan nakil işlemi için yurt dışına gönderilecektir. Ancak hastanın organ nakli sırasına alındığı tarihten itibaren bekleme süresinin beş yılı geçmesi halinde, yurt dışına gönderilmeye ilişkin sağlık kurulu raporunun SUT’un 2.5.3.A-1 maddesi doğrultusunda yenilenmesi ve ilgili onayların yapılmış olması gereklidir.'});
CREATE (sec_907)-[:HAS_PARAGRAPH {order: 2}]->(para_910);
CREATE (para_909)-[:NEXT_PARAGRAPH]->(para_910);
CREATE (para_911:Paragraph {id: '4', content: 'Organ nakli tedavisi için yurt dışına gönderilen kişilerin, organ teminine kadar geçecek sürenin naklin gerçekleştirileceği ülkede geçirilmesinin zorunlu olduğunun yurt dışı sağlık hizmeti sunucusunca gerekçeleriyle belgelendirilmesi halinde Genel Sağlık Sigortası Genel Müdürlüğü, Sağlık Bakanlığının yazılı görüşünü almak suretiyle bekleme süresinin yurt dışında geçirilmesine karar vermeye ve yurt dışında geçirilecek süreyi belirlemeye yetkilidir. Bu süre 6 ayı geçmeyen dönemler halinde uzatılabilir. Yurt dışında toplam bekleme süresi iki yılı geçemez. Belirlenen ya da uzatılan sürenin aşılması halinde aşılan süreye ait tedavi giderleri ile gündelik ve refakatçi giderleri ödenmez.'});
CREATE (sec_907)-[:HAS_PARAGRAPH {order: 3}]->(para_911);
CREATE (para_910)-[:NEXT_PARAGRAPH]->(para_911);
CREATE (para_912:Paragraph {id: '5', content: 'Yurt dışına tedavi amacıyla gönderilen hastaların kontrol tedavilerinin yurt içindeki sağlık hizmeti sunucularında yapılması esastır. Ancak, hastaların kontrol tedavisi amacıyla yurt dışına gönderilebilmesi için;'});
CREATE (sec_907)-[:HAS_PARAGRAPH {order: 4}]->(para_912);
CREATE (item_913:Item {id: 'a', content: 'Yurt dışına tedavi amacıyla gönderilen hastaların ilk muayene ve/veya tedavi işleminin başlangıç tarihinden itibaren, organ, doku ve kök hücre nakli gibi tedaviler için gönderilen hastaların ise nakil tarihinden itibaren; dört yıllık sürenin tamamlandığı tarihten sonraki her kontrol tedavileri için SUT’un 2.5.3.A-1 maddesinde yer alan şekil ve şartları içeren yeni bir sağlık kurulu raporu düzenlenmiş olması,'});
CREATE (para_912)-[:HAS_ITEM {order: 0}]->(item_913);
CREATE (item_914:Item {id: 'b', content: 'Hastaların bu dört yıllık süreden önceki kontrol tedavileri için yurt içindeki SUT’un 2.5.3.A-1 maddesinde belirtilen ilgili sağlık hizmeti sunucularınca ya da yurt dışında tedavi gördüğü sağlık hizmeti sunucusu tarafından kontrol tarihini de içeren gerekçeli kontrol tedavi raporunun düzenlenmiş olması,'});
CREATE (para_912)-[:HAS_ITEM {order: 1}]->(item_914);
CREATE (item_913)-[:NEXT_ITEM]->(item_914);
CREATE (item_915:Item {id: 'c', content: 'Düzenlenmiş olan bu raporların SUT’un 2.5.3.A-1(3) maddesinde yer alan sağlık hizmeti sunucularından biri tarafından uygun görülerek teyit edilmiş olması, gerekir.'});
CREATE (para_912)-[:HAS_ITEM {order: 2}]->(item_915);
CREATE (item_914)-[:NEXT_ITEM]->(item_915);
CREATE (para_911)-[:NEXT_PARAGRAPH]->(para_912);
CREATE (amend_916:Amendment {content: '(Değişik: RG- 30/04/2016- 29699/ 7 md. Yürürlük: 30/04/2016)'});
CREATE (sec_907)-[:HAS_AMENDMENT {order: 0}]->(amend_916);
CREATE (amend_917:Amendment {content: '(Ek: RG- 05/08/2015- 29436/ 4 md. Yürürlük: 15/09/2015)'});
CREATE (sec_907)-[:HAS_AMENDMENT {order: 1}]->(amend_917);
CREATE (sec_897)-[:NEXT_SUBSECTION]->(sec_907);
CREATE (sec_918:Subsection {id: '2.5.3.A-3', title: 'Sağlık hizmeti bedellerinin ödenmesi'});
CREATE (sec_895)-[:HAS_SUBSECTION {order: 2}]->(sec_918);
CREATE (para_919:Paragraph {id: '1', content: 'Yurt dışında tedavi edilecek kişi, var ise yurt dışındaki sevke konu tedaviye ilişkin sözleşmeli sağlık hizmeti sunucusuna sevk edilir ve sağlık hizmeti giderlerinin tümü karşılanır. Yurt dışında sözleşmeli sağlık hizmeti sunucusunun olmaması hâlinde de sevk edilen sağlık hizmeti sunucusunda yapılan tedavilere ait giderlerin tamamı Kurumca ödenir. Ancak, kişinin tercihi doğrultusunda Kurumun yurt dışında sözleşmeli olduğu sağlık hizmeti sunucusuna gitmemesi hâlinde, sözleşmeli yere ödenebilecek tutarı geçmemek üzere Kurumca ödeme yapılır, arada fark oluşması hâlinde fark kişi tarafından karşılanır.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 0}]->(para_919);
CREATE (para_920:Paragraph {id: '2', content: 'Kişilerin Ülkemizle sosyal güvenlik sözleşmesi olan bir ülkeye gönderilmesi halinde; o ülke ile yapılan sosyal güvenlik sözleşmesinde tedavi uygulaması öngörülmüş ve tedavi amacıyla gönderilen kişi sosyal güvenlik sözleşmesinin kapsamında bulunuyorsa, bunlar hakkında sosyal güvenlik sözleşmesi hükümleri uygulanır.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 1}]->(para_920);
CREATE (para_919)-[:NEXT_PARAGRAPH]->(para_920);
CREATE (para_921:Paragraph {id: '3', content: 'Yurt dışında yapılan tedavi bedelleri, Kurum tarafından yurt dışı sağlık hizmeti sunucusu banka hesabına havale edilmesi veya kişilerce ödenen tutarın belge karşılığı kendilerine ödenmesi suretiyle karşılanır.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 2}]->(para_921);
CREATE (para_920)-[:NEXT_PARAGRAPH]->(para_921);
CREATE (para_922:Paragraph {id: '4', content: 'Kurumca, yurt dışında yapılacak tedaviler için oluşacak giderlere mahsuben talep edilmesi halinde, kişilere veya sağlık hizmeti sunucusuna avans ödenebilir. Avans ödemesi misyon şefliği aracılığıyla da yapılabilir.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 3}]->(para_922);
CREATE (para_921)-[:NEXT_PARAGRAPH]->(para_922);

// Batch 25
CREATE (para_923:Paragraph {id: '5', content: 'Kurum, avans ödemeleri için, yurt dışındaki sağlık hizmeti sunucuları tarafından düzenlenen belgelerin ve raporların misyon şeflikleri tarafından onaylanmasını isteyebilir.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 4}]->(para_923);
CREATE (para_922)-[:NEXT_PARAGRAPH]->(para_923);
CREATE (para_924:Paragraph {id: '6', content: 'Acil müdahaleyi gerektiren durumlar, sevke konu hastalığın komplikasyonuna bağlı olarak yapılan tedaviler ile ilişkili tedaviler hariç olmak üzere yurt dışına sevke konu hastalık dışındaki tedavi giderleri Kurumca ödenmez. Hastaya uygulanan başka bir tedavinin sevke konu hastalıkla ilgili olup olmadığının tespit edilemediği durumlarda yurt dışı tedavi raporunu teyit eden hastanenin görüşü alınarak işlem yapılır.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 5}]->(para_924);
CREATE (para_923)-[:NEXT_PARAGRAPH]->(para_924);
CREATE (para_925:Paragraph {id: '7', content: 'Sosyal güvenlik il müdürlükleri tarafından, SUT eki “Yurt Dışı Tedavi/Tetkik İçin Hasta İzleme Çizelgesi” (EK- 2/E-3) ile birlikte yapılan işlemlerin sonucundan Genel Sağlık Sigortası Genel Müdürlüğüne bilgi verilecektir. (Ek: RG- 25/07/2014- 29071/ 13 md. Yürürlük: 01/01/2014 )'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 6}]->(para_925);
CREATE (para_924)-[:NEXT_PARAGRAPH]->(para_925);
CREATE (para_926:Paragraph {id: '8', content: 'Türkiye’de tedavisi yapılamayan bir hastalık için yurt dışına gönderilen hastaya, gönderildiği ülkedeki sağlık hizmeti sunucusu tarafından sevke konu tedavi dışında farklı bir tedavi uygulaması öngörülmekte ise, SUT ’un 2.5.3.A-1 42 maddesinde belirtilen rapor ve onayların öngörülen yeni tedavi için de alınmış olması halinde tedavi giderleri karşılanır. Aksi halde yeni tedavi bedeli ile bu tedaviye ilişkin yol ve gündelik gideri Kurumca karşılanmaz.'});
CREATE (sec_918)-[:HAS_PARAGRAPH {order: 7}]->(para_926);
CREATE (para_925)-[:NEXT_PARAGRAPH]->(para_926);
CREATE (sec_907)-[:NEXT_SUBSECTION]->(sec_918);
CREATE (sec_927:Subsection {id: '2.5.3.B', title: 'Yurt dışı tetkik işlemleri'});
CREATE (sec_894)-[:HAS_SUBSECTION {order: 1}]->(sec_927);
CREATE (para_928:Paragraph {id: '1', content: 'Yurt içinde yapılamayan tetkik ve/veya tahlillerin, numunenin gönderilmesi suretiyle yurt dışı sağlık hizmeti sunucularında yaptırılabilmesi için aşağıdaki düzenlemelere uyulacaktır. Tetkik ve/veya tahlillerin kişilerin yurt dışına gönderilmesi suretiyle yaptırılması işlemleri SUT’un 2.5.3.A maddesi doğrultusunda yürütülecektir.'});
CREATE (sec_927)-[:HAS_PARAGRAPH {order: 0}]->(para_928);
CREATE (sec_929:Subsection {id: '2.5.3.B-1', title: 'Yurt dışı tetkik sağlık kurulu raporu'});
CREATE (sec_927)-[:HAS_SUBSECTION {order: 0}]->(sec_929);
CREATE (para_930:Paragraph {id: '1', content: 'Numunenin gönderilmesi veya hastanın gönderilmesi suretiyle tetkiklerin ve/veya tahlillerin yurt dışında yaptırılabilmesi için gerekli sağlık kurulu raporları, üniversite veya eğitim araştırma hastaneleri sağlık kurullarınca, SUT eki “Yurt Dışı Tetkike İlişkin Sağlık Kurulu Raporu” (EK-2/E-2) formatına uygun olarak düzenlenecektir. Raporlarda tetkikin/tahlilin yurt içinde yapılamadığı ayrıntılı gerekçeleri ile belirtilecektir.'});
CREATE (sec_929)-[:HAS_PARAGRAPH {order: 0}]->(para_930);
CREATE (para_931:Paragraph {id: '2', content: 'Sağlık kurulu, en az biri ilgili dal uzman hekimi olmak kaydıyla; üniversite hastanelerinde en az bir öğretim üyesi, eğitim ve araştırma hastanelerinde en az bir eğitim görevlisi katılımıyla oluşturulacaktır.'});
CREATE (sec_929)-[:HAS_PARAGRAPH {order: 1}]->(para_931);
CREATE (para_930)-[:NEXT_PARAGRAPH]->(para_931);
CREATE (para_932:Paragraph {id: '3', content: 'Numunenin gönderilmesi suretiyle yurt dışında yapılacak tetkikler ve/veya tahliller için düzenlenen sağlık kurulu raporları, Sağlık Bakanlığınca onaylanacaktır.'});
CREATE (sec_929)-[:HAS_PARAGRAPH {order: 2}]->(para_932);
CREATE (para_931)-[:NEXT_PARAGRAPH]->(para_932);
CREATE (sec_933:Subsection {id: '2.5.3.B-2', title: 'Yurt dışı tetkik bedellerinin ödenmesi'});
CREATE (sec_927)-[:HAS_SUBSECTION {order: 1}]->(sec_933);
CREATE (para_934:Paragraph {id: '1', content: 'Numunenin gönderilmesi veya hastanın gönderilmesi suretiyle yurt dışında yapılan tetkik ve/veya tahlil bedeli tetkik ve/veya tahlili yapan sağlık hizmeti sunucusunca düzenlenen faturada/fatura yerine geçen belgede belirtilen tutar üzerinden, Kurum tarafından yurt dışı sağlık hizmeti sunucusu banka hesabına havale edilmesi veya kişilerce ödenen tutarın belge karşılığı kendilerine ödenmesi suretiyle karşılanır.'});
CREATE (sec_933)-[:HAS_PARAGRAPH {order: 0}]->(para_934);
CREATE (para_935:Paragraph {id: '2', content: 'Kurumca, yurt dışında yapılacak tetkikler/tahliller için oluşacak giderlere mahsuben talep edilmesi halinde kişilere veya sağlık hizmeti sunucusuna avans ödenebilir. Avans ödemesi misyon şefliği aracılığıyla da yapılabilir.'});
CREATE (sec_933)-[:HAS_PARAGRAPH {order: 1}]->(para_935);
CREATE (para_934)-[:NEXT_PARAGRAPH]->(para_935);
CREATE (para_936:Paragraph {id: '3', content: 'Kurum, avans ödemeleri için, yurt dışındaki sağlık hizmeti sunucuları tarafından düzenlenen belgelerin ve raporların misyon şeflikleri tarafından onaylanmasını isteyebilir.'});
CREATE (sec_933)-[:HAS_PARAGRAPH {order: 2}]->(para_936);
CREATE (para_935)-[:NEXT_PARAGRAPH]->(para_936);
CREATE (para_937:Paragraph {id: '4', content: 'Sosyal güvenlik il müdürlüklerince yurt dışında tetkik yaptırılması ile ilgili olarak yapılan işlemler sonrasında, SUT eki EK-2/E-3 ile birlikte Genel Sağlık Sigortası Genel Müdürlüğüne bilgi verilecektir.'});
CREATE (sec_933)-[:HAS_PARAGRAPH {order: 3}]->(para_937);
CREATE (para_936)-[:NEXT_PARAGRAPH]->(para_937);
CREATE (sec_929)-[:NEXT_SUBSECTION]->(sec_933);
CREATE (sec_895)-[:NEXT_SUBSECTION]->(sec_927);
CREATE (sec_938:Subsection {id: '2.5.3.C', title: 'Yurt dışı yol, gündelik ve refakatçi giderleri'});
CREATE (sec_894)-[:HAS_SUBSECTION {order: 2}]->(sec_938);
CREATE (sec_939:Subsection {id: '2.5.3.C-1', title: 'Yol gideri'});
CREATE (sec_938)-[:HAS_SUBSECTION {order: 0}]->(sec_939);
CREATE (para_940:Paragraph {id: '1', content: 'Yurt dışına gönderilen hasta ile raporda öngörülmesi halinde bir kişiyle sınırlı olmak üzere refakatçisinin (18 yaşını doldurmamış kişiler için refakatçi öngörülme şartı aranmaz) yol gideri, ulaşım aracına ilişkin fatura/bilet tutarı üzerinden Kurumca ödenir. Yurt dışı tetkik/tedavi için düzenlenen sağlık kurulu raporunda hastanın yurt dışına tarifeli hava taşıtı dışındaki hava taşıtı ile (ambulans uçak, özel uçak vb.) naklinin gerektiğinin belirtilmesi halinde gidiş için söz konusu taşıt bedelleri fatura/belge karşılığı ödenir. Yurt dışına gönderilen hastanın dönüşü için; tedavinin yapıldığı sağlık hizmeti sunucusunca tarifeli hava taşıtı dışında bir hava taşıtı ile dönmesi gerektiğinin belgelendirilmesi halinde de taşıt bedelleri ulaşım aracına ilişkin fatura/belge tutarı üzerinden ödenir.'});
CREATE (sec_939)-[:HAS_PARAGRAPH {order: 0}]->(para_940);
CREATE (para_941:Paragraph {id: '2', content: 'Tedavi/tetkik için yurt dışına gönderilen kişinin tedavi/tetkik sırasında ölümü hâlinde, cenazesinin nakil gideri ile varsa refakatçisinin yurda dönüş yol giderleri de Kurumca karşılanır.'});
CREATE (sec_939)-[:HAS_PARAGRAPH {order: 1}]->(para_941);
CREATE (para_940)-[:NEXT_PARAGRAPH]->(para_941);
CREATE (sec_942:Subsection {id: '2.5.3.C-2', title: 'Gündelik'});
CREATE (sec_938)-[:HAS_SUBSECTION {order: 1}]->(sec_942);
CREATE (para_943:Paragraph {id: '1', content: 'Yurt dışına gönderilen hasta ile raporda öngörülmesi halinde bir kişiyle sınırlı olmak üzere refakatçisine (18 yaşını doldurmamış kişiler için refakatçi öngörülme şartı aranmaz) gündelik/yemek ve yatak gideri ödemesi işlemleri aşağıda belirtilen düzenlemeye göre yürütülecektir.'});
CREATE (sec_942)-[:HAS_PARAGRAPH {order: 0}]->(para_943);
CREATE (para_944:Paragraph {id: '2', content: 'Ayakta tedavinin sağlandığı her gün için hasta ve refakatçinin her birine “gündelik”, yatarak tedavide ise yatarak tedavi süresi ile sınırlı olmak üzere sağlık hizmeti sunucusunda kalınmayan her gün için refakatçisine yemek ve yatak gideri ödenir. Ödemelerde, 6245 sayılı Harcırah Kanunu gereği Bakanlar Kurulunca belirlenen ilgili yıl “Yurtdışı Gündeliklerinin Hesaplanmasında Esas Alınacak Cetvel” in  (Aylık/kadro derecesi 5-15 olanlar) sütununda gönderilen ülke için belirlenen bedel esas alınır.'});
CREATE (sec_942)-[:HAS_PARAGRAPH {order: 1}]->(para_944);
CREATE (para_943)-[:NEXT_PARAGRAPH]->(para_944);
CREATE (amend_945:Amendment {content: '(Mülga: RG- 04/05/2013- 28637/ 4 md. Yürürlük: 01/01/2013)'});
CREATE (sec_942)-[:HAS_AMENDMENT {order: 0}]->(amend_945);
CREATE (sec_939)-[:NEXT_SUBSECTION]->(sec_942);
CREATE (sec_927)-[:NEXT_SUBSECTION]->(sec_938);
CREATE (sec_890)-[:NEXT_SUBSECTION]->(sec_894);
CREATE (sec_515)-[:NEXT_SECTION]->(sec_877);
CREATE (sec_946:Section {id: '2.6', title: 'Yol ve gündelik giderleri'});
CREATE (doc_1)-[:HAS_SECTION {order: 16}]->(sec_946);
CREATE (sec_947:Subsection {id: '2.6.1', title: 'Yol ve gündelik gideri esasları'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 0}]->(sec_947);
CREATE (para_948:Paragraph {id: '1', content: '5510 sayılı Kanunun 60 ıncı maddesinin onikinci, onüçüncü ve ondördüncü fıkralarında sayılan kişiler hariç genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişilerin Kurumumuzca finansmanı sağlanan sağlık hizmetlerine ilişkin yol, gündelik ve refakatçi gideri ödenebilmesi için;'});
CREATE (sec_947)-[:HAS_PARAGRAPH {order: 0}]->(para_948);
CREATE (item_949:Item {id: 'a', content: 'Kişilerin, müracaat ettikleri sözleşmeli sağlık hizmeti sunucusunda yapılan hekim veya diş hekiminin muayenesi veya tedavisi sonrasında, gerekli teşhis veya tedavi cihazlarının veya ilgili branş uzmanının bulunmaması gibi tıbbi ve zorunlu nedenlerle yerleşim yeri dışındaki sağlık hizmeti sunucusuna sevk yapılması,'});
CREATE (para_948)-[:HAS_ITEM {order: 0}]->(item_949);
CREATE (item_950:Item {id: 'b', content: 'Sevkin, Kurumca belirlenen istisnalar hariç olmak üzere, sözleşmeli ikinci veya üçüncü basamak sağlık hizmeti sunucusunca yapılmış olması,'});
CREATE (para_948)-[:HAS_ITEM {order: 1}]->(item_950);
CREATE (item_949)-[:NEXT_ITEM]->(item_950);
CREATE (item_951:Item {id: 'c', content: 'Sevkin, elektronik ortamda veya SUT eki “Hasta Sevk Formu” (EK-2/F) ile veya bu formda istenilen bilgilerin yer aldığı belge tanzim edilerek yapılmış olması (sevk belgesinde hekim imza ve kaşesinin dışında ayrıca başhekim onayı aranmayacaktır.),'});
CREATE (para_948)-[:HAS_ITEM {order: 2}]->(item_951);
CREATE (item_950)-[:NEXT_ITEM]->(item_951);
CREATE (item_952:Item {id: 'ç', content: '(Değişik: RG- 25/07/2014-29071 / 14 md. Yürürlük: 18/04/2014) Sevkin yapıldığı gün dahil 5 işgünü içinde sevk edilen sağlık hizmeti sunucusuna müracaat edilmiş olunması, gerekmektedir.'});
CREATE (para_948)-[:HAS_ITEM {order: 3}]->(item_952);
CREATE (item_951)-[:NEXT_ITEM]->(item_952);
CREATE (para_953:Paragraph {id: '2', content: '3713 sayılı Kanuna göre aylık bağlanmış maluller, 5434 sayılı Türkiye Cumhuriyeti Emekli Sandığı Kanununun 56 ncı maddesi veya 2330 sayılı Kanunun 2 nci maddesinin birinci fıkrasının (e) ve (f) bentlerinde sayılanlardan 3713 sayılı Kanun kapsamına giren olaylar sebebiyle aylık bağlananlar ile 3713 sayılı Kanun kapsamına girmese dahi başkasının yardımı ve desteği olmaksızın yaşamak için gereken hareketleri yapamayacak derecede malul olan vazife ve harp malulü hastalar, 3713 43 sayılı Kanun kapsamına girmese dahi atış, tatbikat veya diğer ateşli silah yaralanmaları nedeniyle malul olan vazife ve harp malulleri, tedavileri sonuçlanıncaya veya maluliyetleri kesinleşinceye kadar geçen süre içerisinde 3713 sayılı Kanunun 21 inci maddesinde sayılan olaylara maruz kalmaları nedeniyle yaralanan kişilerin yerleşim yeri dışına sevki için birinci fıkranın (a) bendinde yer alan şartlar aranmaz.'});
CREATE (sec_947)-[:HAS_PARAGRAPH {order: 1}]->(para_953);
CREATE (para_948)-[:NEXT_PARAGRAPH]->(para_953);
CREATE (amend_954:Amendment {content: '(Ek: RG- 25/03/2017- 30018/ 11 md. Yürürlük: 01/03/2017)'});
CREATE (sec_947)-[:HAS_AMENDMENT {order: 0}]->(amend_954);
CREATE (amend_955:Amendment {content: '(Ek: RG-09/09/2017- 30175/ 9 md. Yürürlük: 09/09/2017)'});
CREATE (sec_947)-[:HAS_AMENDMENT {order: 1}]->(amend_955);
CREATE (sec_956:Subsection {id: '2.6.1.A', title: 'Yol giderlerinde esas alınacak mesafeler'});
CREATE (sec_947)-[:HAS_SUBSECTION {order: 0}]->(sec_956);
CREATE (para_957:Paragraph {id: '1', content: 'Sevklerin teşhis ve/veya tedavinin sağlanabildiği en yakın sağlık hizmeti sunucusuna yapılması esastır. Ancak, hekimin veya diş hekiminin muayenesi veya tedavisi sonrasında, gerekli teşhis veya tedavi cihazlarının veya ilgili branş uzmanının bulunmaması gibi tıbbi ve zorunlu nedenlerle yerleşim yeri dışındaki sağlık hizmeti sunucusuna sevk yapılması durumunda, Kurumca belirlenen istisnalar hariç olmak üzere; (Değişik: RG- 25/08/2022- 31934/ 17-a md. Yürürlük: 03/09/2022)'});
CREATE (sec_956)-[:HAS_PARAGRAPH {order: 0}]->(para_957);
CREATE (item_958:Item {id: 'a', content: 'İkinci veya üçüncü basamak sağlık hizmeti sunucusu bulunmayan ilçelerde birinci basamak sağlık hizmeti sunucusu tarafından yapılan sevklere ilişkin yol gideri, en yakın ikinci basamak sağlık hizmeti sunucusunun bulunduğu yerleşim yeri,'});
CREATE (para_957)-[:HAS_ITEM {order: 0}]->(item_958);
CREATE (item_959:Item {id: 'b', content: 'İkinci basamak sağlık hizmeti sunucularınca yapılan sevklere ilişkin yol gideri, tedavinin yapılabildiği en yakın üçüncü basamak resmi sağlık hizmeti sunucusunun bulunduğu yerleşim yeri mesafesini aşmamak kaydıyla sevk edilen yerleşim yeri,'});
CREATE (para_957)-[:HAS_ITEM {order: 1}]->(item_959);
CREATE (item_958)-[:NEXT_ITEM]->(item_959);
CREATE (item_960:Item {id: 'c', content: 'Üçüncü basamak resmi sağlık hizmeti sunucularınca yapılan sevklere ilişkin yol gideri sevk edilen yerleşim yeri, mesafesi esas alınarak karşılanır.'});
CREATE (para_957)-[:HAS_ITEM {order: 2}]->(item_960);
CREATE (item_959)-[:NEXT_ITEM]->(item_960);

// Batch 26
CREATE (para_961:Paragraph {id: '2', content: 'Sağlık hizmeti sunucuları tarafından yerleşim yeri dışına:'});
CREATE (sec_956)-[:HAS_PARAGRAPH {order: 1}]->(para_961);
CREATE (item_962:Item {id: 'a', content: 'Organ, doku ve kök hücre nakli tedavisi ve/veya kontrolü (Ek:RG-21/03/2018-30367/5-c md. Yürürlük: 01/04/2018) (donör dahil),'});
CREATE (para_961)-[:HAS_ITEM {order: 0}]->(item_962);
CREATE (item_963:Item {id: 'b', content: 'Kanser tedavisi ve/veya kontrolü,'});
CREATE (para_961)-[:HAS_ITEM {order: 1}]->(item_963);
CREATE (item_962)-[:NEXT_ITEM]->(item_963);
CREATE (item_964:Item {id: 'c', content: 'Uzuv replantasyonu (Ek:RG-21/03/2018-30367/5-ç md.Yürürlük: 01/04/2018) veya kontrolü,'});
CREATE (para_961)-[:HAS_ITEM {order: 2}]->(item_964);
CREATE (item_963)-[:NEXT_ITEM]->(item_964);
CREATE (item_965:Item {id: 'ç', content: 'SUT’un 1.7 maddesinde tanımlanan acil hal,'});
CREATE (para_961)-[:HAS_ITEM {order: 3}]->(item_965);
CREATE (item_964)-[:NEXT_ITEM]->(item_965);
CREATE (item_966:Item {id: 'd', content: 'Meslek hastalıkları hastanesine meslek hastalığı tedavisi ve/veya kontrolü, nedenleri ile sevk edilen kişilerin tedavinin yapılabildiği en yakın üçüncü basamak (Ek:RG-25/08/2022-31934/17-a md. Yürürlük:03/09/2022) resmi sağlık hizmeti sunucusunun bulunduğu yerleşim yeri mesafesi aranmaksızın sevk edildikleri yer üzerinden hesaplanan yol gideri Kurumca karşılanır.'});
CREATE (para_961)-[:HAS_ITEM {order: 4}]->(item_966);
CREATE (item_965)-[:NEXT_ITEM]->(item_966);
CREATE (para_957)-[:NEXT_PARAGRAPH]->(para_961);
CREATE (para_967:Paragraph {id: '3', content: 'Kurum tarafından, sürekli iş göremezlik veya malullük durumlarının tespiti ve/veya kontrolü ile 5510 sayılı Kanunun 94 üncü maddesi gereğince gerekli görülen kişilerin kontrol muayeneleri için yerleşim yeri dışına yapılan sevklerine ilişkin yol, gündelik ve refakatçi giderleri Kurumca karşılanır. Ayrıca, Kurumca yapılan sevklerde sevkin kişilere tebliğ edildiği gün dahil 10 işgünü içinde sağlık hizmeti sunucularına müracaat edilmiş olması gerekmektedir.'});
CREATE (sec_956)-[:HAS_PARAGRAPH {order: 2}]->(para_967);
CREATE (para_961)-[:NEXT_PARAGRAPH]->(para_967);
CREATE (para_968:Paragraph {id: '4', content: 'Kaplıca tedavilerinde yol gideri, tedavinin sağlanabildiği en yakın kaplıca tesisinin bulunduğu yerleşim yeri esas alınarak ödenir.'});
CREATE (sec_956)-[:HAS_PARAGRAPH {order: 3}]->(para_968);
CREATE (para_967)-[:NEXT_PARAGRAPH]->(para_968);
CREATE (para_969:Paragraph {id: '5', content: 'Diyaliz tedavilerinde yol giderleri, en yakın diyaliz merkezinin bulunduğu yerleşim yeri esas alınarak ödenir. En yakın diyaliz merkezinin bulunduğu mesafeden daha uzak bir yerleşim yerinde bulunan diyaliz merkezinde diyalize gidip gelen hastaların yol giderleri, tedavinin yapılabildiği en yakın diyaliz ünitesinin (yatak kapasitesi, günlük hasta sayısı, boş yatak olup olmadığı, HBs Ag (+) hastalar için ayrı bir bölüm, HCV Ab (+) hastalar için ayrı cihaz bulunup bulunmadığı gibi durumlar dikkate alınarak) tespit edilmesi halinde Kurumca karşılanır. Hastalara diyaliz merkezinin/sağlık hizmeti sunucusunun servis hizmeti verdiğinin tespit edilmesi halinde servis hizmetinden faydalananlara bu mesafeler için ayrıca yol gideri ödenmez.'});
CREATE (sec_956)-[:HAS_PARAGRAPH {order: 4}]->(para_969);
CREATE (para_968)-[:NEXT_PARAGRAPH]->(para_969);
CREATE (para_970:Paragraph {id: '6', content: '3713 sayılı Kanuna göre aylık bağlanmış maluller, 5434 sayılı Türkiye Cumhuriyeti Emekli Sandığı Kanununun 56 ncı maddesi veya 2330 sayılı Kanunun 2 nci maddesinin birinci fıkrasının (e) ve (f) bentlerinde sayılanlardan 3713 sayılı Kanun kapsamına giren olaylar sebebiyle aylık bağlananlar ile 3713 sayılı Kanun kapsamına girmese dahi başkasının yardımı ve desteği olmaksızın yaşamak için gereken hareketleri yapamayacak derecede malul olan vazife ve harp malulü hastalar, 3713 sayılı Kanun kapsamına girmese dahi atış, tatbikat veya diğer ateşli silah yaralanmaları nedeniyle malul olan vazife ve harp malulleri, tedavileri sonuçlanıncaya veya maluliyetleri kesinleşinceye kadar geçen süre içerisinde 3713 sayılı Kanunun 21 inci maddesinde sayılan olaylara maruz kalmaları nedeniyle yaralanan kişiler için birinci fıkrada yer alan şartlar aranmaz.'});
CREATE (sec_956)-[:HAS_PARAGRAPH {order: 5}]->(para_970);
CREATE (para_969)-[:NEXT_PARAGRAPH]->(para_970);
CREATE (amend_971:Amendment {content: '(Ek:RG-09/09/2017- 30175/ 10 md. Yürürlük: 09/09/2017)'});
CREATE (sec_956)-[:HAS_AMENDMENT {order: 0}]->(amend_971);
CREATE (sec_972:Subsection {id: '2.6.1.B', title: '4 maddeleri doğrultusunda yürütülür.'});
CREATE (sec_947)-[:HAS_SUBSECTION {order: 1}]->(sec_972);
CREATE (sec_973:Subsection {id: '2.6.1.B-1', title: 'Mutat taşıt ile yapılan nakile ilişkin sevkler'});
CREATE (sec_972)-[:HAS_SUBSECTION {order: 0}]->(sec_973);
CREATE (para_974:Paragraph {id: '1', content: 'Sevk formunda sevk vasıtası belirtilmemiş ise mutat taşıt ücreti ödenir.'});
CREATE (sec_973)-[:HAS_PARAGRAPH {order: 0}]->(para_974);
CREATE (para_975:Paragraph {id: '2', content: 'Mutat taşıtla yapılan nakillerde bilet/fatura ibrazı zorunluluğu bulunmamaktadır. Ancak, yurt içinde demiryollarında, denizyollarında, karayollarında kurumlar/kuruluşlar veya özel firmalar aracılığıyla şehirlerarası yapılan yolcu taşıma işinde kullanılan araçlarda ücretsiz seyahat hakkı bulunan kişiler ile bu haktan faydalanan eşleri, ana ve babaları ile bakmakla yükümlü olunan çocukları ve eşlik eden refakatçilerinin bilet/fatura ibraz etmeleri gerekmektedir. Ücretsiz seyahat etmenin mümkün olmadığı yerleşim yerleri/mesafeleri için ise bilet/fatura ibrazı zorunluluğu bulunmamaktadır.'});
CREATE (sec_973)-[:HAS_PARAGRAPH {order: 1}]->(para_975);
CREATE (para_974)-[:NEXT_PARAGRAPH]->(para_975);
CREATE (amend_976:Amendment {content: '(Değişik: RG- 01/06/2022- 31853/ 3 md. Yürürlük: 09/06/2022)'});
CREATE (sec_973)-[:HAS_AMENDMENT {order: 0}]->(amend_976);
CREATE (sec_977:Subsection {id: '2.6.1.B-2', title: 'Mutat taşıt ücretleri'});
CREATE (sec_972)-[:HAS_SUBSECTION {order: 1}]->(sec_977);
CREATE (para_978:Paragraph {id: '1', content: 'Yerleşim yeri dışındaki sağlık hizmeti sunucusuna yapılan sevklere istinaden mutat taşıt giderleri; var ise fatura/bilet tutarını aşmamak üzere, SUT eki “Mutat Taşıt Yol Ücreti Listesi (EK-2/L)” nde yer alan KDV dahil ücretler üzerinden ödenir.'});
CREATE (sec_977)-[:HAS_PARAGRAPH {order: 0}]->(para_978);
CREATE (para_979:Paragraph {id: '2', content: 'Ulaştırma ve Altyapı Bakanlığı tarafından karayolları şehirlerarası yolcu taşımacılığı alanında uygulanmak üzere, SUT eki EK-2/L’de yer alan ücretlerden daha düşük tutarda taban ve/veya tavan ücret yayınlanması halinde mutat taşıt giderlerinin, düşük ücretin geçerli olduğu tarihler ile sınırlı olmak kaydıyla ilgili mesafeye ilişkin yayınlanan en düşük ücret esas alınarak ödenir. Ulaştırma ve Altyapı Bakanlığı tarafından yayınlanan ücret tarifesinde “0 ila 100 km” arası için ücret belirlenmemiş olması halinde ücret tarifesinde 101 km için geçerli olan ücretin; “0-25 km” arası mesafeler için 0,3 katsayısı ile, “26-50 km” arası mesafeler için 0,4 katsayısı ile, “51-75 km” arası mesafeler için 0,5 katsayısı ile, “76-100 km” arası mesafeler için 0,8 katsayısı ile çarpımı sonucu bulunacak miktarlar üzerinden ücret kıyaslaması yapılır.'});
CREATE (sec_977)-[:HAS_PARAGRAPH {order: 1}]->(para_979);
CREATE (para_978)-[:NEXT_PARAGRAPH]->(para_979);
CREATE (sec_973)-[:NEXT_SUBSECTION]->(sec_977);
CREATE (sec_980:Subsection {id: '2.6.1.B-3', title: 'Mutat taşıt dışı araçla nakile ilişkin sevkler'});
CREATE (sec_972)-[:HAS_SUBSECTION {order: 2}]->(sec_980);
CREATE (para_981:Paragraph {id: '1', content: 'Genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişilerin yerleşim yeri dışına mutat taşıt dışı araç (ambulans, ticari taksi, tarifeli uçak vs.) ile sevk edilmeleri halinde;'});
CREATE (sec_980)-[:HAS_PARAGRAPH {order: 0}]->(para_981);
CREATE (item_982:Item {id: 'a', content: 'Sevk eden sağlık (Değişik:RG-25/08/2022-31934/17-b md. Yürürlük:03/09/2022) hizmeti sunucusunca; hastalığın ne olduğu, mutat taşıt aracı ile seyahat edememe gerekçeleri ve taşıt tipinin belirtildiği sağlık kurulu raporu düzenlenmesi (bu rapor sadece tek sefer gidiş için geçerlidir),'});
CREATE (para_981)-[:HAS_ITEM {order: 0}]->(item_982);
CREATE (item_983:Item {id: 'b', content: 'Sevk ile müracaat edilen sağlık (Değişik:RG-25/08/2022-31934/17-b md. Yürürlük:03/09/2022) hizmeti sunucusunca; tedavi sonrasında dönüş için mutat taşıt dışı araçla naklin öngörülmesi durumunda da  hastalığın ne olduğu, mutat taşıt aracı ile seyahat edememe gerekçeleri ve taşıt tipinin belirtildiği sağlık kurulu raporunun ayrıca düzenlenmesi (bu rapor sadece tek sefer dönüş için geçerlidir),'});
CREATE (para_981)-[:HAS_ITEM {order: 1}]->(item_983);
CREATE (item_982)-[:NEXT_ITEM]->(item_983);
CREATE (item_984:Item {id: 'c', content: 'Acil hal nedeniyle sağlık kurulu raporu düzenlenmeksizin sevk edilen kişinin mutat taşıt dışı araç ile nakline ilişkin yol gideri, acil hal nedeniyle naklin gerektiğinin tıbbi gerekçeleriyle birlikte, sevk eden sağlık (Değişik:RG-25/08/2022- 31934/17-b md. Yürürlük:03/09/2022) hizmeti sunucusunun ilgili hekimi tarafından imzalanmış belge ile belgelenmesi, ve Kurumca kabul edilmesi durumunda yol gideri ödenir.'});
CREATE (para_981)-[:HAS_ITEM {order: 2}]->(item_984);
CREATE (item_983)-[:NEXT_ITEM]->(item_984);
CREATE (para_985:Paragraph {id: '2', content: 'Belli bir program çerçevesinde sayılan tedavilerde (kemoterapi, radyoterapi, diyaliz, PUVA vb.) kişilerin mutat taşıt dışı araç ile nakillerine ilişkin gidiş- dönüş yol giderinin ödenmesinde, her seferinde sağlık kurulu raporu aranmaz. Ödeme işlemleri ilk sağlık kurulu raporuna istinaden yürütülür.'});
CREATE (sec_980)-[:HAS_PARAGRAPH {order: 1}]->(para_985);
CREATE (item_986:Item {id: 'a', content: 'Kemoterapi ve radyoterapi tedavileri nedeniyle düzenlenen mutat taşıt dışı araç ile nakile ilişkin sağlık kurulu raporu 3 ay süre ile geçerlidir.'});
CREATE (para_985)-[:HAS_ITEM {order: 0}]->(item_986);
CREATE (item_987:Item {id: 'b', content: 'Diyaliz tedavileri nedeniyle düzenlenen mutat taşıt dışı nakile ilişkin sağlık kurulu raporunda en az bir erişkin/çocuk nefroloji uzman hekimi veya hastanın bulunduğu ilde nefroloji uzmanı bulunmaması durumunda  iç hastalıkları uzman hekimi veya çocuk sağlığı ve hastalıkları uzman hekiminin yer alması gerekmektedir. Bu sağlık kurulu raporu 3 ay süre ile geçerlidir.'});
CREATE (para_985)-[:HAS_ITEM {order: 1}]->(item_987);
CREATE (item_986)-[:NEXT_ITEM]->(item_987);
CREATE (para_981)-[:NEXT_PARAGRAPH]->(para_985);
CREATE (para_988:Paragraph {id: '3', content: 'Genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişiler, kendilerine bir vasıta tahsis edilmesi suretiyle başka bir yere gönderilmiş iseler, eşlik eden refakatçiye ayrıca yol gideri ödenmez.'});
CREATE (sec_980)-[:HAS_PARAGRAPH {order: 2}]->(para_988);
CREATE (para_985)-[:NEXT_PARAGRAPH]->(para_988);
CREATE (para_989:Paragraph {id: '4', content: 'Sağlık kurulu raporlarının elektronik ortamda alınmaya başlanılması durumunda ayrıca basılı olarak istenilip istenilmeyeceği, onay süreci ve diğer gönderilme usulleri Kurumca belirlenerek duyurulur.'});
CREATE (sec_980)-[:HAS_PARAGRAPH {order: 3}]->(para_989);
CREATE (para_988)-[:NEXT_PARAGRAPH]->(para_989);
CREATE (amend_990:Amendment {content: '(Ek: RG-21/03/2018-\n30367/ 6md. Yürürlük: 01/04/2018)'});
CREATE (sec_980)-[:HAS_AMENDMENT {order: 0}]->(amend_990);
CREATE (amend_991:Amendment {content: '(Ek: RG- 24/12/2014- 29215/ 7 md. Yürürlük: 01/01/2015)'});
CREATE (sec_980)-[:HAS_AMENDMENT {order: 1}]->(amend_991);
CREATE (amend_992:Amendment {content: '(Değişik: RG- \n16/03/2023-32134/15 md. Yürürlük:24/03/2023)'});
CREATE (sec_980)-[:HAS_AMENDMENT {order: 2}]->(amend_992);
CREATE (sec_977)-[:NEXT_SUBSECTION]->(sec_980);
CREATE (sec_993:Subsection {id: '2.6.1.B-4', title: 'Mutat taşıt dışı araç ücretleri'});
CREATE (sec_972)-[:HAS_SUBSECTION {order: 3}]->(sec_993);
CREATE (para_994:Paragraph {id: '1', content: 'Mutat taşıt dışı araçla yapılan sevklerde mutlaka bilet/fatura ibrazı zorunludur. Bilet/fatura ibraz edilememesi halinde mutat taşıt bedeli üzerinden ödeme yapılır.'});
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 0}]->(para_994);
CREATE (para_995:Paragraph {id: '2', content: 'Kişilerin özel araçları ile sağlık hizmeti sunucusuna gidiş ve/veya dönüşlerinde mutat taşıt ücreti ödenir.'});
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 1}]->(para_995);
CREATE (para_994)-[:NEXT_PARAGRAPH]->(para_995);
CREATE (para_996:Paragraph {id: '3', content: 'Kurumca ticari taksi için ödenecek ücret, ilgili yerleşim yerleri arası için geçerli mutat taşıt ücreti bedelinin 5 katını geçemez. 45'});
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 2}]->(para_996);
CREATE (para_995)-[:NEXT_PARAGRAPH]->(para_996);
CREATE (para_997:Paragraph {id: '4', content: '(Değişik: RG-21/03/2018- 30367/ 7-a md. Yürürlük:01/04/2018) Tarifeli uçak için ibraz edilen bilet/fatura tutarı, ekonomi sınıf bedeli üzerinden ödenir. (Mülga: RG-21/03/2018- 30367/ 7-a md. Yürürlük:01/04/2018)  Uçak ile yapılan sevklerde, faturanın/biletin yanında o seferle seyahat ettiğine ilişkin olarak uçak biniş kartının da ibraz edilmesi gerekmektedir.'});
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 3}]->(para_997);
CREATE (para_996)-[:NEXT_PARAGRAPH]->(para_997);
CREATE (para_998:Paragraph {id: '5', content: 'Kara ambulansı ve hasta nakil aracı ücreti, 07.12.2006 tarih, 26369 sayılı Resmi Gazetede yayımlanan “Ambulanslar ve Acil Sağlık Araçları İle Ambulans Hizmetleri Yönetmeliği”nin 28 inci maddesi gereği belirlenen (Ek: RG- 21/03/2018-30367/ 7-b md. Yürürlük:01/04/2018) asgari fiyatlar esas alınarak ödenir. Ancak özel kara ambulans firmalarının Sağlık Bakanlığı onayı ile yürürlüğe giren “Ambulans Ücret Tarifesi”nden daha düşük bedelle hasta nakil beyanlarının olması durumunda, kamu ve Kurum yararı doğrultusunda belirlenen ücret tarifesinden daha düşük fatura edilmesi halinde fatura bedeli üzerinden ödeme yapılacaktır.'});
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 4}]->(para_998);
CREATE (para_997)-[:NEXT_PARAGRAPH]->(para_998);
CREATE (para_999:Paragraph {id: '6', content: 'Hava ambulans ücretleri sadece uzuv replantasyonu gerektiren acil sağlık hizmeti ile SUT’un 2.4.2 maddesi kapsamında sağlanan sağlık hizmetleri için ödenir. Organın/dokunun naklin yapılacağı sağlık (Değişik:RG-25/08/2022-31934/ 17-c md. Yürürlük:03/09/2022) hizmeti sunucusuna, hava ambulansı dışındaki özel hava taşıtı ile getirilmesi halinde gidiş- dönüş yol giderleri hava ambulansı için belirlenen tutarlar esas alınarak ödenir. Hava ambulansı ve hava ambulansı dışındaki özel hava taşıtı bedelinin ödenebilmesi için fatura ekinde taşıtın ambulans görevi maksadıyla ilk kule teması “ambulans görevi” ifadesi ile kurulmuş olması, hava aracının uçucu ve teknik kayıtlarının (motor çalıştırma-motor susturma arasındaki geçen zaman dilimi) ibraz edilmesi gerekmektedir. Ruhsatlandırılmış hava ve deniz ambulansları için aşağıda belirtilen ücretler azami ücretler olup ücretlere tıbbi müdahale bakım ücretleri dâhildir.'});

// Batch 27
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 5}]->(para_999);
CREATE (item_1000:Item {id: 'a', content: 'Uçak ambulans ücretleri; + KDV, TL+KDV, yurt dışı uçuşlar için 4.000 (dörtbin) TL,'});
CREATE (para_999)-[:HAS_ITEM {order: 0}]->(item_1000);
CREATE (subitem_1001:SubItem {id: '1', content: 'Turbo prob motorlu ambulans uçağı için gidiş dönüş hesap edilmek suretiyle uçuş saati başına 2.000 (ikibin) TL'});
CREATE (item_1000)-[:HAS_SUBITEM {order: 0}]->(subitem_1001);
CREATE (subitem_1002:SubItem {id: '2', content: 'Jet motorlu ambulans uçağı için gidiş dönüş hesap edilmek suretiyle uçuş saati başına 3.500 (üçbinbeşyüz)'});
CREATE (item_1000)-[:HAS_SUBITEM {order: 1}]->(subitem_1002);
CREATE (subitem_1001)-[:NEXT_SUBITEM]->(subitem_1002);
CREATE (item_1003:Item {id: 'b', content: 'Helikopter ambulans ücretleri; TL+KDV, (ikibinyediyüzelli) TL+KDV, c-) Deniz ambulans ücretleri;'});
CREATE (para_999)-[:HAS_ITEM {order: 1}]->(item_1003);
CREATE (subitem_1004:SubItem {id: '1', content: 'Tek motorlu ambulans helikopter için gidiş dönüş hesap edilmek suretiyle uçuş saati başına 1.500 (binbeşyüz)'});
CREATE (item_1003)-[:HAS_SUBITEM {order: 0}]->(subitem_1004);
CREATE (subitem_1005:SubItem {id: '2', content: 'Çift motorlu ambulans helikopter için gidiş dönüş hesap edilmek suretiyle uçuş saati başına 2.750'});
CREATE (item_1003)-[:HAS_SUBITEM {order: 1}]->(subitem_1005);
CREATE (subitem_1004)-[:NEXT_SUBITEM]->(subitem_1005);
CREATE (subitem_1006:SubItem {id: '1', content: 'Deniz ambulansı için gidiş dönüş hesap edilmek suretiyle seyir saati başına 1.500 (binbeşyüz) TL+KDV.'});
CREATE (item_1003)-[:HAS_SUBITEM {order: 2}]->(subitem_1006);
CREATE (subitem_1005)-[:NEXT_SUBITEM]->(subitem_1006);
CREATE (item_1000)-[:NEXT_ITEM]->(item_1003);
CREATE (para_998)-[:NEXT_PARAGRAPH]->(para_999);
CREATE (para_1007:Paragraph {id: '7', content: 'Cenaze nakil aracı ücretleri ilgili belediye tarafından onaylanan ücret tarifesi üzerinden fatura tutarını aşmamak kaydıyla Kurumca karşılanır.'});
CREATE (sec_993)-[:HAS_PARAGRAPH {order: 6}]->(para_1007);
CREATE (para_999)-[:NEXT_PARAGRAPH]->(para_1007);
CREATE (amend_1008:Amendment {content: '(Ek: RG-\n26/11/2016- 29900/ 8 md. Yürürlük: 07/12/2016)'});
CREATE (sec_993)-[:HAS_AMENDMENT {order: 0}]->(amend_1008);
CREATE (sec_980)-[:NEXT_SUBSECTION]->(sec_993);
CREATE (sec_956)-[:NEXT_SUBSECTION]->(sec_972);
CREATE (sec_1009:Subsection {id: '2.6.2', title: 'Gündelik giderleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 1}]->(sec_1009);
CREATE (para_1010:Paragraph {id: '1', content: 'Kişilerin, yerleşim yeri dışındaki sağlık hizmeti sunucusuna yapılan sevklerinde hasta ve refakatçisine;'});
CREATE (sec_1009)-[:HAS_PARAGRAPH {order: 0}]->(para_1010);
CREATE (item_1011:Item {id: 'a', content: 'Ayakta tedavilerde, sevk edildikleri sağlık hizmeti sunucusuna müracaat tarihi ile tedavinin sona erdiği tarihler arasında, istirahat raporu verilen süreler dışında kalan günler için gündelik ödenir.'});
CREATE (para_1010)-[:HAS_ITEM {order: 0}]->(item_1011);
CREATE (item_1012:Item {id: 'b', content: 'Yatarak tedavilerde, hasta ve refakatçisine yalnızca gidiş ve dönüş tarihi için gündelik ödenir.'});
CREATE (para_1010)-[:HAS_ITEM {order: 1}]->(item_1012);
CREATE (item_1011)-[:NEXT_ITEM]->(item_1012);
CREATE (item_1013:Item {id: 'c', content: 'Müracaat sonrası sağlık hizmeti sunucusunda yatarak tedavi edilmesi gerekli görülmesine rağmen, yatak bulunmaması nedeniyle sağlık hizmeti sunucusuna yatırılmaksızın geçen günler için bu durumun sağlık hizmeti sunucunca belgelenmesi şartıyla 5 günü geçmemek üzere gündelik ödenir.'});
CREATE (para_1010)-[:HAS_ITEM {order: 2}]->(item_1013);
CREATE (item_1012)-[:NEXT_ITEM]->(item_1013);
CREATE (item_1014:Item {id: 'ç', content: 'Belli bir program çerçevesinde sayılan tedaviler hariç olmak üzere sevk edilen sağlık hizmeti sunucusunda ayaktan tedavinin başvuru tarihinden itibaren 10 günü aşması halinde, gerekçesinin sevk belgesinde belirtilmesi durumunda 10 günü aşan süreler için de gündelik ödenir.'});
CREATE (para_1010)-[:HAS_ITEM {order: 3}]->(item_1014);
CREATE (item_1013)-[:NEXT_ITEM]->(item_1014);
CREATE (para_1015:Paragraph {id: '2', content: 'Gündelikler; il dâhilindeki sevklerde (ilçe-merkez arası) 100, iller arası sevklerde ise 200 gösterge rakamının devlet memurları aylıklarına uygulanan katsayı ile çarpımı sonucu bulunacak tutar üzerinden ödenir.  Gündelik giderlerinin ödenmesinde uygulanacak gösterge rakamlarının ödemeye esas ücrete çevrilmesinde; gösterge rakamlarının devlet memurları aylıklarına uygulanan katsayı ile çarpılması sonucu bulunacak tutar, yuvarlama işlemi yapılmaksızın virgülden sonraki basamaklar alınmayarak uygulanır.'});
CREATE (sec_1009)-[:HAS_PARAGRAPH {order: 1}]->(para_1015);
CREATE (para_1010)-[:NEXT_PARAGRAPH]->(para_1015);
CREATE (para_1016:Paragraph {id: '3', content: 'Sevk edilen sağlık hizmeti sunucusuna müracaat tarihi ile tedavinin sona erdiği tarihin aynı gün olması halinde gündelik ödenmez.'});
CREATE (sec_1009)-[:HAS_PARAGRAPH {order: 2}]->(para_1016);
CREATE (para_1015)-[:NEXT_PARAGRAPH]->(para_1016);
CREATE (para_1017:Paragraph {id: '4', content: 'Sevk edildiği sağlık hizmeti sunucusuna müracaatları sonrasında, hastanın sevk edildiği branş dışında başka bir branşa tedavinin devamı niteliğinde sevk edilmesi ve bu durumun belgelendirilmesi halinde sevk edildiği branşta ayakta tedavi görülen günler için de gündelik ödenir.'});
CREATE (sec_1009)-[:HAS_PARAGRAPH {order: 3}]->(para_1017);
CREATE (para_1016)-[:NEXT_PARAGRAPH]->(para_1017);
CREATE (para_1018:Paragraph {id: '5', content: 'Sevk edildiği sağlık hizmeti sunucusuna müracaatları sonrasında, hastanın sevk edildiği yerleşim yerinde başka bir sağlık hizmeti sunucusuna tedavinin devamı niteliğinde sevk edilmesi ve bu durumun belgelendirilmesi halinde sevk edildiği sağlık hizmeti sunucusunda ayakta tedavi görülen günler için de gündelik ödenir.'});
CREATE (sec_1009)-[:HAS_PARAGRAPH {order: 4}]->(para_1018);
CREATE (para_1017)-[:NEXT_PARAGRAPH]->(para_1018);
CREATE (amend_1019:Amendment {content: '(Ek: RG- 21/03/2018- 30367/ 8 md. Yürürlük: 01/04/2018)'});
CREATE (sec_1009)-[:HAS_AMENDMENT {order: 0}]->(amend_1019);
CREATE (amend_1020:Amendment {content: '(Ek:RG-01/06/2022- \n31853/4 md.Yürürlük:01/07/2022)'});
CREATE (sec_1009)-[:HAS_AMENDMENT {order: 1}]->(amend_1020);
CREATE (sec_947)-[:NEXT_SUBSECTION]->(sec_1009);
CREATE (sec_1021:Subsection {id: '2.6.3', title: 'Refakatçi giderleri (Ek: RG-21/03/2018- 30367/ 9-a md. Yürürlük: 01/04/2018) (yol, gündelik)'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 2}]->(sec_1021);
CREATE (para_1022:Paragraph {id: '1', content: 'Genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişilerin bir kişiyle sınırlı olmak üzere  refakatçi giderlerinde; sevki düzenleyen sağlık hizmeti sunucusunca refakatin tıbben gerekli olduğunun, sevk ile müracaat edilen sağlık hizmeti sunucusunca refakatçi eşliğinde gelindiğinin ve/veya kalındığının elektronik ortamda veya SUT eki EK-2/F formunda belirtilmiş olması gerekmektedir. (Ek: RG- 21/03/2018- 30367/ 9-b md. Yürürlük: 01/04/2018) %40 ve üzeri engelli kişilerde, organ, doku, kök hücre nakli, uzuv replantasyonu tedavilerinde ve  18 yaşını doldurmamış çocuklar için bir kişi ile sınırlı olmak üzere refakatçi giderlerinin ödenmesinde yukarıda belirtilen koşullar aranmaz.'});
CREATE (sec_1021)-[:HAS_PARAGRAPH {order: 0}]->(para_1022);
CREATE (para_1023:Paragraph {id: '2', content: 'Kişilerin yatarak tedavileri sırasında hekimin veya diş hekiminin tıbben göreceği lüzum üzerine; ilgili sağlık hizmeti sunucusunca düzenlenen refakatçi kalındığına dair belgeye istinaden, hastanın yanında kalan refakatçisinin yatak ve 46 yemek giderleri, sağlık hizmeti sunucusunca Kuruma fatura edilmesi halinde SUT eki EK-2/B Listesinde yer alan “refakat” puanı esas alınarak karşılanır, ayrıca bu günler için ilgililere gündelik ödenmez.Günübirlik tedavilerde SUT eki EK-2/B Listesinde yer alan “refakat” kodu faturalandırılamaz.'});
CREATE (sec_1021)-[:HAS_PARAGRAPH {order: 1}]->(para_1023);
CREATE (para_1022)-[:NEXT_PARAGRAPH]->(para_1023);
CREATE (para_1024:Paragraph {id: '3', content: 'Hastanın yoğun bakım ünitesindeki yatarak tedavi süresi ile sınırlı olmak üzere sağlık hizmeti sunucusunda kalınmayan her gün için refakatçisine gündelik ödenir.'});
CREATE (sec_1021)-[:HAS_PARAGRAPH {order: 2}]->(para_1024);
CREATE (para_1023)-[:NEXT_PARAGRAPH]->(para_1024);
CREATE (amend_1025:Amendment {content: '(Mülga: RG-\n26/11/2016- 29900/ 9 md. Yürürlük: 07/12/2016)'});
CREATE (sec_1021)-[:HAS_AMENDMENT {order: 0}]->(amend_1025);
CREATE (amend_1026:Amendment {content: '(Ek: RG- 26/11/2016- 29900/9 md.Yürürlük:07/12/2016)'});
CREATE (sec_1021)-[:HAS_AMENDMENT {order: 1}]->(amend_1026);
CREATE (sec_1009)-[:NEXT_SUBSECTION]->(sec_1021);
CREATE (sec_1027:Subsection {id: '2.6.4', title: 'Kontrol çağrılarına istinaden yapılan sevklere ilişkin yol ve gündelik giderleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 3}]->(sec_1027);
CREATE (para_1028:Paragraph {id: '1', content: 'Mevzuata uygun olarak yerleşim yeri dışındaki sağlık hizmeti sunucusuna sevk edilen ve sevk edildiği sağlık hizmeti sunucusunca belirli aralıklarla kontrolü uygun görülen organ, doku ve kök hücre nakli uygulanan, kanser tedavisi gören, uzuv replantasyonu yapılan veya meslek hastalıkları hastanesinde meslek hastalığı nedeniyle tedavi olan hastaların kontrol amaçlı sevkleri;'});
CREATE (sec_1027)-[:HAS_PARAGRAPH {order: 0}]->(para_1028);
CREATE (item_1029:Item {id: 'a', content: 'Kontrole çağrıldığını gösteren belgeye istinaden birinci basamak sağlık hizmeti sunucuları dâhil tüm sağlık hizmeti sunucularınca yapılabilecektir.'});
CREATE (para_1028)-[:HAS_ITEM {order: 0}]->(item_1029);
CREATE (item_1030:Item {id: 'b', content: 'Kontrol çağrılarına istinaden birinci basamak sağlık hizmeti sunucusunca yapılan sevklere ilişkin yol gideri ödemesi yapılırken, sevk belgesi ile birlikte kontrol çağrı belgesinin de ödeme belgeleriyle birlikte ibrazı/gönderilmesi zorunludur. Kontrol çağrı tarihinin sevk belgesi veya tedavi gördüğünü belirtir belge üzerinde hekim tarafından belirtilmiş olması yeterlidir. Hekim imza ve kaşesini içermeyen belge, kontrol çağrı belgesi olarak kabul edilmez.'});
CREATE (para_1028)-[:HAS_ITEM {order: 1}]->(item_1030);
CREATE (item_1029)-[:NEXT_ITEM]->(item_1030);
CREATE (item_1031:Item {id: 'c', content: 'Kontrol çağrılarına istinaden ikinci ve üçüncü basamak sağlık hizmeti sunucusunca düzenlenen sevklere ilişkin yol gideri ödemesi yapılırken kontrol çağrı belgesi aranmaz.'});
CREATE (para_1028)-[:HAS_ITEM {order: 2}]->(item_1031);
CREATE (item_1030)-[:NEXT_ITEM]->(item_1031);
CREATE (item_1032:Item {id: 'ç', content: 'Birinci fıkrada sayılan tedaviler/hastalıklar dışında kalan tedavilerin/hastalıkların kontrol amaçlı çağrılarına ilişkin giderler Kurumca karşılanmaz.'});
CREATE (para_1028)-[:HAS_ITEM {order: 3}]->(item_1032);
CREATE (item_1031)-[:NEXT_ITEM]->(item_1032);
CREATE (item_1033:Item {id: 'd', content: 'Kontrol çağrılarına istinaden mutat taşıt dışı vasıta ile yapılan sevklere ilişkin işlemler SUT’un 2.6.1.B-3 ve'});
CREATE (para_1028)-[:HAS_ITEM {order: 4}]->(item_1033);
CREATE (item_1032)-[:NEXT_ITEM]->(item_1033);
CREATE (amend_1034:Amendment {content: '(Değişik: RG-21/03/2018-30367/10md. Yürürlük:01/04/2018)'});
CREATE (sec_1027)-[:HAS_AMENDMENT {order: 0}]->(amend_1034);
CREATE (sec_1021)-[:NEXT_SUBSECTION]->(sec_1027);
CREATE (sec_1035:Subsection {id: '2.6.5', title: 'Organ nakli tedavilerine ait yol ve gündelik giderleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 4}]->(sec_1035);
CREATE (para_1036:Paragraph {id: '1', content: 'Organ nakli tedavilerinde hastanın organın bulunduğu yere veya organın organ nakli yapılacak merkezin bulunduğu yere getirilmesine ilişkin gidiş-dönüş nakliye/transfer masrafları, Ulusal Koordinasyon Merkezi veya Bölge Koordinasyon Merkezi tarafından tutanak altına alınarak belirlenen ulaşım aracı esas alınmak kaydıyla karşılanır.'});
CREATE (sec_1035)-[:HAS_PARAGRAPH {order: 0}]->(para_1036);
CREATE (para_1037:Paragraph {id: '2', content: 'Ulusal Koordinasyon Merkezi veya Bölge Koordinasyon Merkezi tarafından tutanak altına alınarak belirlenen ulaşım aracı için, SUT’un 2.6.1.B-4 maddesi doğrultusunda tespit edilen bedel, fatura/bilet tutarını aşmamak üzere ödenir.'});

// Batch 28
CREATE (sec_1035)-[:HAS_PARAGRAPH {order: 1}]->(para_1037);
CREATE (para_1036)-[:NEXT_PARAGRAPH]->(para_1037);
CREATE (para_1038:Paragraph {id: '3', content: 'Organ naklinin gerçekleştirilememiş olması ilgili giderlerin ödenmesine engel teşkil etmez.'});
CREATE (sec_1035)-[:HAS_PARAGRAPH {order: 2}]->(para_1038);
CREATE (para_1037)-[:NEXT_PARAGRAPH]->(para_1038);
CREATE (para_1039:Paragraph {id: '4', content: 'Kemik iliği/kordon kanı nakline ilişkin yol giderleri, SUT’un 2.6.1.B-4(6) fıkrası doğrultusunda karşılanır.'});
CREATE (sec_1035)-[:HAS_PARAGRAPH {order: 3}]->(para_1039);
CREATE (para_1038)-[:NEXT_PARAGRAPH]->(para_1039);
CREATE (para_1040:Paragraph {id: '5', content: 'Uzuv replantasyonu gerektiren acil sağlık hizmeti için müracaat edilen sağlık hizmeti sunucusunca hava ambulansı ile başka bir sağlık hizmeti sunucusuna sevkin gerekli görülmesi ve bu durumun belgelendirilmesi koşulu ile hava ambulansı için SUT’un 2.6.1.B-4(6) fıkrası doğrultusunda tespit edilen bedel, fatura/bilet tutarını aşmamak üzere ödenir.'});
CREATE (sec_1035)-[:HAS_PARAGRAPH {order: 4}]->(para_1040);
CREATE (para_1039)-[:NEXT_PARAGRAPH]->(para_1040);
CREATE (para_1041:Paragraph {id: '6', content: 'Donör (verici) durumundaki kişilerin sağlık giderlerinin finansmanının Kurumumuzca karşılanması durumunda, mevzuata uygun sevk edilmeleri halinde yol, gündelik ve refakatçi giderleri Kurumca karşılanır.'});
CREATE (sec_1035)-[:HAS_PARAGRAPH {order: 5}]->(para_1041);
CREATE (para_1040)-[:NEXT_PARAGRAPH]->(para_1041);
CREATE (sec_1027)-[:NEXT_SUBSECTION]->(sec_1035);
CREATE (sec_1042:Subsection {id: '2.6.6', title: 'Kaplıca tedavilerine ait yol ve gündelik giderleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 5}]->(sec_1042);
CREATE (para_1043:Paragraph {id: '1', content: 'Kaplıca tedavilerine ilişkin yol, gündelik ve refakatçi giderleri, tedavi için düzenlenen sağlık kurulu raporuna dayanılarak karşılanır.'});
CREATE (sec_1042)-[:HAS_PARAGRAPH {order: 0}]->(para_1043);
CREATE (para_1044:Paragraph {id: '2', content: 'Sağlık kurulu raporunun düzenlendiği gün dahil  5 işgünü içinde kaplıca tesisine müracaat edilmesi gerekmektedir. Bu süre içinde kaplıca tesisine müracaat edilmemesi halinde yol gideri ve gündeliklerin ödenebilmesi için yeniden sağlık kurulu raporu düzenlenmesine gerek bulunmayıp, raporun geçerli olduğu süre içerisinde sağlık hizmeti sunucusu tarafından elektronik ortamda veya SUT eki EK- 2/F formu (sevk belgesi) düzenlenmesi ve  5 işgünü içerisinde kaplıca tesisine müracaat edilmesi gerekmektedir.'});
CREATE (sec_1042)-[:HAS_PARAGRAPH {order: 1}]->(para_1044);
CREATE (para_1043)-[:NEXT_PARAGRAPH]->(para_1044);
CREATE (para_1045:Paragraph {id: '3', content: 'Sağlık Bakanlığınca işletme izni verilmeyen kaplıcalarda tedavi görenlere ve refakatçilerine ait giderler Kurumca karşılanmaz.'});
CREATE (sec_1042)-[:HAS_PARAGRAPH {order: 2}]->(para_1045);
CREATE (para_1044)-[:NEXT_PARAGRAPH]->(para_1045);
CREATE (para_1046:Paragraph {id: '4', content: 'Raporda/sevk formunda refakatin tıbben gerekli olduğunun belirtilmesi (18 yaşını doldurmamış çocuklar için aranmaz) ve tedavinin yapıldığı tesis tarafından refakatçi kalındığının belgelenmesi halinde refakatçinin yol giderleri ve gündelikleri Kurumca karşılanır.'});
CREATE (sec_1042)-[:HAS_PARAGRAPH {order: 3}]->(para_1046);
CREATE (para_1045)-[:NEXT_PARAGRAPH]->(para_1046);
CREATE (para_1047:Paragraph {id: '5', content: 'Yol giderleri mutat taşıt bedeli üzerinden ödenir.'});
CREATE (sec_1042)-[:HAS_PARAGRAPH {order: 4}]->(para_1047);
CREATE (para_1046)-[:NEXT_PARAGRAPH]->(para_1047);
CREATE (amend_1048:Amendment {content: '(Değişik: RG- 25/07/2014- 29071/ 15 md. Yürürlük: \n18/04/2014)'});
CREATE (sec_1042)-[:HAS_AMENDMENT {order: 0}]->(amend_1048);
CREATE (amend_1049:Amendment {content: '(Değişik: RG- 25/07/2014- 29071/ 15 md. Yürürlük: 18/04/2014)'});
CREATE (sec_1042)-[:HAS_AMENDMENT {order: 1}]->(amend_1049);
CREATE (sec_1035)-[:NEXT_SUBSECTION]->(sec_1042);
CREATE (sec_1050:Subsection {id: '2.6.7', title: 'Belli bir program çerçevesinde sayılan tedavilere ait yol ve gündelik giderleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 6}]->(sec_1050);
CREATE (para_1051:Paragraph {id: '1', content: 'Belli bir program çerçevesinde tedavi gören (kemoterapi, radyoterapi, diyaliz vb.) genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişilerin ilk sevk belgesine istinaden tedavilerinin devamı niteliğindeki diğer müracaatları nedeniyle oluşan yol gideri, gündelik ve refakatçi giderlerinin ödenmesinde, her gidişleri için sevk belgesi aranmaz.'});
CREATE (sec_1050)-[:HAS_PARAGRAPH {order: 0}]->(para_1051);
CREATE (para_1052:Paragraph {id: '2', content: 'Ödeme işlemleri ilk sevk belgesine istinaden, diğer müracaatlara ilişkin tedavi gördüğü tarihleri belirtir müracaat edilen sağlık hizmeti sunucusunca düzenlenecek belge doğrultusunda yürütülür.'});
CREATE (sec_1050)-[:HAS_PARAGRAPH {order: 1}]->(para_1052);
CREATE (para_1051)-[:NEXT_PARAGRAPH]->(para_1052);
CREATE (para_1053:Paragraph {id: '3', content: 'Yerleşim yerinde ikinci veya üçüncü basamak sağlık hizmeti sunucusu bulunmaması halinde birinci basamak sağlık kuruluşunca düzenlenen sevk belgesi kabul edilecek olup sözleşmeli herhangi bir sağlık hizmeti sunucusu bulunmaması durumunda ise yerleşim yerinin belirlenmesi halinde tedavi için düzenlenen geçerli sağlık raporu, sevk belgesi olarak kabul edilir.'});
CREATE (sec_1050)-[:HAS_PARAGRAPH {order: 2}]->(para_1053);
CREATE (para_1052)-[:NEXT_PARAGRAPH]->(para_1053);
CREATE (sec_1042)-[:NEXT_SUBSECTION]->(sec_1050);
CREATE (sec_1054:Subsection {id: '2.6.8', title: 'Cenaze nakil işlemleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 7}]->(sec_1054);
CREATE (para_1055:Paragraph {id: '1', content: 'Yerleşim yeri dışındaki sağlık hizmeti sunucusuna sevk edilen, ancak yapılan tedavilere rağmen vefat eden genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişilerin cenaze nakline ilişkin giderleri, sevkin düzenlendiği sağlık hizmeti sunucusunun bulunduğu yerleşim yeri mesafesini aşmamak üzere Kurumca karşılanır.'});
CREATE (sec_1054)-[:HAS_PARAGRAPH {order: 0}]->(para_1055);
CREATE (para_1056:Paragraph {id: '2', content: 'Sevk edilmeksizin müracaat edilen sağlık hizmeti sunucusunda vefat eden kişilerin cenaze nakline ilişkin giderler Kurumca karşılanmaz. 47'});
CREATE (sec_1054)-[:HAS_PARAGRAPH {order: 1}]->(para_1056);
CREATE (para_1055)-[:NEXT_PARAGRAPH]->(para_1056);
CREATE (para_1057:Paragraph {id: '3', content: '5510 sayılı Kanunun 4 üncü maddesinin birinci fıkrasının (c) bendinde sayılan sigortalıların cenaze nakline ilişkin giderler ilgili kamu idaresince karşılanacağından Kurumca ayrıca ödeme yapılmaz.'});
CREATE (sec_1054)-[:HAS_PARAGRAPH {order: 2}]->(para_1057);
CREATE (para_1056)-[:NEXT_PARAGRAPH]->(para_1057);
CREATE (sec_1050)-[:NEXT_SUBSECTION]->(sec_1054);
CREATE (sec_1058:Subsection {id: '2.6.9', title: 'Yol ve gündelik gideri ortak hükümleri'});
CREATE (sec_946)-[:HAS_SUBSECTION {order: 8}]->(sec_1058);
CREATE (para_1059:Paragraph {id: '1', content: 'Genel sağlık sigortalısı ve bakmakla yükümlü olduğu kişiler ile refakatçilere  yerleşim yeri içindeki nakiller için yol ve gündelik gideri ödenmez.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 0}]->(para_1059);
CREATE (para_1060:Paragraph {id: '2', content: 'Sevk yapılmaksızın belediye/büyükşehir belediye  yerleşim yeri dışındaki bir sağlık hizmeti sunucusundan sağlık hizmeti alınması hâlinde yol gideri ve gündelik ödenmez.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 1}]->(para_1060);
CREATE (para_1059)-[:NEXT_PARAGRAPH]->(para_1060);
CREATE (para_1061:Paragraph {id: '3', content: 'Sözleşmesiz sağlık hizmeti sunucusu tarafından yapılan sevklerdeki yol, gündelik ve refakatçi giderlerinin ödenebilmesi için sevkin, acil hal nedeniyle yapıldığının Kurumca kabul edilmesi gereklidir.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 2}]->(para_1061);
CREATE (para_1060)-[:NEXT_PARAGRAPH]->(para_1061);
CREATE (para_1062:Paragraph {id: '4', content: 'Sevk edilen sağlık hizmeti sunucularına ayaktan müracaatlarda, ilgili branş uzman hekiminin bulunmaması nedeniyle sağlık hizmeti verilemediğinin ilgili sağlık hizmeti sunucusu başhekimliğince onaylanarak belgelenmesi halinde gidiş-dönüş için ilgili giderler Kurumca karşılanır.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 3}]->(para_1062);
CREATE (para_1061)-[:NEXT_PARAGRAPH]->(para_1062);
CREATE (para_1063:Paragraph {id: '5', content: 'Genel sağlık sigortalısı veya bakmakla yükümlü olduğu kişilerin bu madde kapsamındaki ödemeye esas fatura ve eki belgeleri için Kurumca tıbbi uygunluk aranan veya Kurumca kabul edilmesi halinde ödenebileceği belirtilen durumlarda tıbbi uygunluk, hastane faturası ödemelerinin yapıldığı bağlı bulunulan İl Müdürlükleri tarafından verilir.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 4}]->(para_1063);
CREATE (para_1062)-[:NEXT_PARAGRAPH]->(para_1063);
CREATE (para_1064:Paragraph {id: '6', content: '5510 sayılı Kanunun 60 ıncı maddesinin birinci fıkrasının (c) bendinin (Değişik: RG-RG-09/09/2017- 30175/11 md. Yürürlük: 29/04/2017) (1) ve (3) numaralı alt bentleri gereği genel sağlık sigortası kapsamına alınan kişilerin SUT’un 1.5.1 maddesinde belirtilen usul ve esaslara uygun sevklerine ilişkin yol gündelik ve refakatçi giderleri SUT’un 2.6 madde hükümleri doğrultusunda karşılanır.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 5}]->(para_1064);
CREATE (para_1063)-[:NEXT_PARAGRAPH]->(para_1064);
CREATE (para_1065:Paragraph {id: '7', content: 'Kurum taşra birimleri tarafından üçer aylık dönemler halinde, yerleşim yeri dışına yapılan sevkler ve gerekçeleri konusunda sevk eden sağlık hizmeti sunucusunun bulunduğu ilin   İl Sağlık Müdürlüğüne yazılı bilgilendirme yapılacaktır.'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 6}]->(para_1065);
CREATE (para_1064)-[:NEXT_PARAGRAPH]->(para_1065);
CREATE (para_1066:Paragraph {id: '8', content: 'Sürekli iş göremezlik, malûllük ve çalışma gücü kaybı hâllerinin tespiti veya bu amaçla yapılan kontroller için sağlık hizmeti sunucusuna yapılan sevkler nedeniyle ödenecek gündelik ve yol giderleri ile refakatçi giderleri, kısa ve uzun vadeli sigorta kolları prim gelirlerinden karşılandığından Kurumun ödeme birimlerince bu durumun dikkate alınması gerekmektedir. ÜÇÜNCÜ BÖLÜM Tıbbi Malzeme'});
CREATE (sec_1058)-[:HAS_PARAGRAPH {order: 7}]->(para_1066);
CREATE (para_1065)-[:NEXT_PARAGRAPH]->(para_1066);
CREATE (amend_1067:Amendment {content: '(Değişik: RG- 30/08/2014- 29104/ \n5 md. Yürürlük: 30/08/2014)'});
CREATE (sec_1058)-[:HAS_AMENDMENT {order: 0}]->(amend_1067);
CREATE (amend_1068:Amendment {content: '(Değişik: RG-30/08/2014-29104/ 5md. Yürürlük: \n30/08/2014)'});
CREATE (sec_1058)-[:HAS_AMENDMENT {order: 1}]->(amend_1068);
CREATE (amend_1069:Amendment {content: '(Değişik: RG- 26/11/2016- 29900/ 10 md. Yürürlük: \n07/12/2016)'});
CREATE (sec_1058)-[:HAS_AMENDMENT {order: 2}]->(amend_1069);
CREATE (amend_1070:Amendment {content: '(Değişik: RG-21/03/2018-30367/ 11 md. Yürürlük: 01/04/2018)'});
CREATE (sec_1058)-[:HAS_AMENDMENT {order: 3}]->(amend_1070);
CREATE (amend_1071:Amendment {content: '(Değişik: RG- 25/08/2022- 31934/ 18 md. Yürürlük: 03/09/2022)'});
CREATE (sec_1058)-[:HAS_AMENDMENT {order: 4}]->(amend_1071);
CREATE (sec_1054)-[:NEXT_SUBSECTION]->(sec_1058);
CREATE (sec_877)-[:NEXT_SECTION]->(sec_946);
CREATE (sec_1072:Section {id: '3.1', title: 'Tıbbi malzeme temin esasları'});
CREATE (doc_1)-[:HAS_SECTION {order: 17}]->(sec_1072);
CREATE (sec_1073:Subsection {id: '3.1.1', title: 'Tanım ve genel hükümler'});
CREATE (sec_1072)-[:HAS_SUBSECTION {order: 0}]->(sec_1073);
CREATE (para_1074:Paragraph {id: '1', content: 'Ortez, protez, tıbbî araç ve gereç, kişi kullanımına mahsus tıbbî cihaz, tıbbî sarf, basit sıhhi sarf ve iyileştirici nitelikteki tıbbî sarf malzemeleri tıbbi malzeme kapsamında değerlendirilir.'});

// Batch 29
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 0}]->(para_1074);
CREATE (para_1075:Paragraph {id: '2', content: 'Kurumca bedeli karşılanan tıbbi malzemelerin, Türkiye İlaç ve Tıbbi Cihaz Ulusal Bilgi Bankası (TİTUBB)/ Ürün Takip Sistemi (ÜTS) kayıt/bildirim işlemi tamamlanmış olmalıdır. TİTUBB/ÜTS kayıt/bildirim işlemi tamamlanmamış tıbbi malzemelerin bedelleri Kurumca karşılanmaz. Ancak, Sağlık Bakanlığının tıbbi cihazlar ile ilgili mevzuatı kapsamında yer almayan tıbbi malzeme bedellerinin Kurumca karşılanmasında ve SUT’ta belirtilen istisnalardan TİTUBB/ÜTS kayıt/bildirim işleminin tamamlanmış olması şartı aranmaz. TİTUBB/ÜTS’ye kayıtlı olan bir malzemenin ayrıca üretici ve/veya distribütör firmalarının da TİTUBB/ÜTS’de tanımlanmış olması gerekmekte olup resmi kurumlar/resmi sağlık hizmeti sunucularından bu şart aranmaz. Bir malzemenin TİTUBB/ÜTS kayıt/bildirim işleminin tamamlanmış olması o malzemenin Kurumca bedelinin karşılanması için tek başına yeterli değildir.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 1}]->(para_1075);
CREATE (para_1074)-[:NEXT_PARAGRAPH]->(para_1075);
CREATE (para_1076:Paragraph {id: '3', content: 'Kurumla sözleşmeli sağlık hizmeti sunucularınca temin edilerek hastalara kullanılan tıbbi malzemelerin TİTUBB/ÜTS kayıt/bildiriminde tanımlı barkod numara bilgisi, hasta güvenliği açısından, hasta işlem dosyasında muhafaza edilir ve Kurumca gerekli görüldüğü durumlarda ibrazı zorunludur. Ancak, SUT eki EK-3/A Listesinde yer alan bedeli 100 (yüz) TL’nin altındaki tıbbi sarf malzemelerin yatarak tedavi gören hastalarda kullanılması halinde (inceleme, soruşturma, denetim gibi haller hariç) barkod numara belgesinin ibrazı zorunlu değildir.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 2}]->(para_1076);
CREATE (para_1075)-[:NEXT_PARAGRAPH]->(para_1076);
CREATE (para_1077:Paragraph {id: '4', content: 'Kurumla sözleşmeli 4734 sayılı Kamu İhale Kanununa tabi resmi sağlık hizmeti sunucuları, temin ettikleri tıbbi malzemeler için 4734 sayılı Kanunun 19 uncu, 20 nci, 21 inci ve 22 nci maddelerinde belirtilen ihale usulleri ve doğrudan temin alımları da dâhil olmak üzere yaptıkları alımların; ihale kayıt numarasını (İKN) (doğrudan temin alımlarında ihale kayıt numarası girilmez), TİTUBB/ÜTS kayıt numarasını, KDV hariç alış fiyatını, adedini, tarihini, hastane kodunu, firma bilgisini ve kayıt için istenen diğer tüm bilgileri “İhale/Doğrudan Temin Sonuç Bilgileri Ekranı” na eksiksiz ve düzenli olarak girmek zorundadır.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 3}]->(para_1077);
CREATE (para_1076)-[:NEXT_PARAGRAPH]->(para_1077);
CREATE (para_1078:Paragraph {id: '5', content: 'Kurumla sözleşmeli sağlık hizmeti sunucularında yatarak tedavilerde kullanılan tıbbi malzemeler sağlık hizmeti sunucusu tarafından temin edilmek zorundadır. Bu malzemelerin reçete karşılığı hastaya aldırılması durumunda, fatura tutarı hastaya ödenerek ilgili sağlık hizmeti sunucusunun alacağından mahsup edilir.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 4}]->(para_1078);
CREATE (para_1077)-[:NEXT_PARAGRAPH]->(para_1078);
CREATE (para_1079:Paragraph {id: '6', content: 'Kurumla sözleşmeli sağlık hizmeti sunucularında yatarak tedavilerde Kurumca bedeli karşılanmayan tıbbi malzemelerin hastaya aldırılarak kullanıldığı durumlarda fatura tutarı hastaya ödenerek ilgili sağlık hizmeti sunucusunun 48 alacağından mahsup edilir. Ancak, sağlık hizmeti sunucularınca hastaya aldırılan bu tıbbi malzemenin Kurumca ödenmediğine ilişkin hastanın yazılı olarak bilgilendirilmesi halinde hastaya herhangi bir ödeme yapılmaz.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 5}]->(para_1079);
CREATE (para_1078)-[:NEXT_PARAGRAPH]->(para_1079);
CREATE (para_1080:Paragraph {id: '7', content: 'SUT eki EK-3/B Listesinde yer alan tıbbi malzemelerin SUT’ta belirtilen istisnalar hariç bedelleri Kurumca karşılanmaz. Ayrıca bir tıbbi malzemenin söz konusu listede olmaması, o malzemenin Kurumca bedelinin karşılanacağı anlamına gelmez.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 6}]->(para_1080);
CREATE (para_1079)-[:NEXT_PARAGRAPH]->(para_1080);
CREATE (para_1081:Paragraph {id: '8', content: 'SUT eki listelerde yer alan tıbbi malzeme birim fiyatları, SUT’ta belirtilen istisnalar hariç tavan fiyatlardır.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 7}]->(para_1081);
CREATE (para_1080)-[:NEXT_PARAGRAPH]->(para_1081);
CREATE (para_1082:Paragraph {id: '9', content: 'Bedeli Kurumca karşılanmayan işlemlere ait tıbbi malzeme bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 8}]->(para_1082);
CREATE (para_1081)-[:NEXT_PARAGRAPH]->(para_1082);
CREATE (para_1083:Paragraph {id: '10', content: 'SUT eki EK-3 listelerinde yer alan tıbbi malzeme fiyatları, KDV hariç fiyatlardır. İlgili kanunlarda tanımlanan KDV istisna ve muafiyetler ile SUT’ta belirtilen istisnalar ve yurt dışında faaliyet gösteren Kurumla sözleşmeli sağlık hizmeti sunucuları hariç olmak üzere KDV ilave edilerek ödenir. Ancak, 3065 sayılı Katma Değer Vergisi Kanununun 17 nci maddesinin birinci fıkrasında sayılan kurum ve kuruluşlara ayrıca KDV ödenmez.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 9}]->(para_1083);
CREATE (para_1082)-[:NEXT_PARAGRAPH]->(para_1083);
CREATE (para_1084:Paragraph {id: '11', content: 'Kurum SUT eki EK-3 listelerinde yer alan tıbbi malzemelerin bedellerinin karşılanabilmesi için kalite ve ürün güvenliğine ait belgeleri istemeye yetkilidir. Bu yetkisini ilgili resmi/özel kurum veya kuruluşlara yaptırmak suretiyle de yerine getirebilir.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 10}]->(para_1084);
CREATE (para_1083)-[:NEXT_PARAGRAPH]->(para_1084);
CREATE (para_1085:Paragraph {id: '12', content: 'Yurt dışında faaliyet gösteren Kurumla sözleşmeli sağlık hizmeti sunucularında kullanılan tıbbi malzemeler için işletme gideri, hazine kesintisi, Sosyal Hizmetler ve Çocuk Esirgeme Kurumu kesintisi bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 11}]->(para_1085);
CREATE (para_1084)-[:NEXT_PARAGRAPH]->(para_1085);
CREATE (para_1086:Paragraph {id: '13', content: 'Tıbbi malzeme alan tanımları (SUT kodları), SUT eki EK-3 listelerinde yer almaktadır. Tıbbi malzemeler bu SUT kodları ile Kuruma fatura edilebilecek olmakla birlikte, SUT eki EK-3 listelerinde yer alan SUT kodlarının, SUT eki işlem listelerinde (EK-2/B, EK-2/C gibi) yer alan SUT işlem kodlarına ilave olarak ayrıca faturalandırılabilmesi için SUT veya eklerinde ilgili tıbbi malzemenin işlem bedeline ilave olarak faturalandırılabileceğinin belirtilmiş olması gerekmektedir.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 12}]->(para_1086);
CREATE (para_1085)-[:NEXT_PARAGRAPH]->(para_1086);
CREATE (para_1087:Paragraph {id: '14', content: 'Tıbbi malzeme imal veya ithal eden firmalar tıbbi malzemelerini; Kurumca duyurulan yöntemlerle ve/veya Kurumca yayınlanan Tıbbi Malzeme Başvuru Kılavuzu kapsamında SUT eki EK-3 listelerindeki tıbbi malzeme alan tanımlarına (SUT kodlarına), küresel ürün numarası (barkod) bazında tanımlar. SUT kodları bazında MEDULA sisteminde işlem tarihinde tanımlı olmayan tıbbi malzemelerin bedelleri Kurumca karşılanmaz.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 13}]->(para_1087);
CREATE (para_1086)-[:NEXT_PARAGRAPH]->(para_1087);
CREATE (para_1088:Paragraph {id: '15', content: 'Barkod-SUT kodu eşleştirmelerinin hatalı olduğunun herhangi bir şekilde tespit edilmesi veya tıbbi malzemelerin Kurumca belirlenen kural ve/veya kriterlere uygunsuz bir şekilde fatura edilmesi halinde, söz konusu tıbbi malzeme bedelleri ödenmez, ödenmiş ise ilgililerden yersiz ödeme kapsamında tahsil edilir.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 14}]->(para_1088);
CREATE (para_1087)-[:NEXT_PARAGRAPH]->(para_1088);
CREATE (para_1089:Paragraph {id: '16', content: 'Ödeme kural ve/veya kriterlerinde sağlık hizmeti sunucusu kısıtı bulunan tıbbi malzemelerin faturalandırıldığı SUT eki işlem bedellerinin ödemesinde de aynı kısıt aranır. Tıbbi malzemelerdeki sağlık hizmeti sunucusu kısıtına uymayan işlemlerin bedelleri ödenmez.'});
CREATE (sec_1073)-[:HAS_PARAGRAPH {order: 15}]->(para_1089);
CREATE (para_1088)-[:NEXT_PARAGRAPH]->(para_1089);
CREATE (sec_1090:Subsection {id: '3.1.2', title: 'Ayakta tedavilerde kullanılan tıbbi malzemeler'});
CREATE (sec_1072)-[:HAS_SUBSECTION {order: 1}]->(sec_1090);
CREATE (para_1091:Paragraph {id: '1', content: 'SUT eki “Ayakta Tedavilerde Kullanılan Tıbbi Malzemeler” (EK-3/C) Listesinde yer alan Kurumca bedeli karşılanacak tıbbi malzemeler;'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 0}]->(para_1091);
CREATE (item_1092:Item {id: 'a', content: 'Tıbbi Uygunluk Aranacak Tıbbi Malzemeler (EK-3/C-1),'});
CREATE (para_1091)-[:HAS_ITEM {order: 0}]->(item_1092);
CREATE (item_1093:Item {id: 'b', content: 'Eksternal Alt ve Üst Ekstremite/Gövde Protez ve Ortezleri (EK-3/C-2),'});
CREATE (para_1091)-[:HAS_ITEM {order: 1}]->(item_1093);
CREATE (item_1092)-[:NEXT_ITEM]->(item_1093);
CREATE (item_1094:Item {id: 'c', content: 'Diğer Protez ve Ortezler (EK-3/C-3),'});
CREATE (para_1091)-[:HAS_ITEM {order: 2}]->(item_1094);
CREATE (item_1093)-[:NEXT_ITEM]->(item_1094);
CREATE (item_1095:Item {id: 'ç', content: 'Tıbbi Sarf Malzemeleri (EK-3/C-4),'});
CREATE (para_1091)-[:HAS_ITEM {order: 3}]->(item_1095);
CREATE (item_1094)-[:NEXT_ITEM]->(item_1095);
CREATE (item_1096:Item {id: 'd', content: 'Özel Hallerde Karşılanan Tıbbi Malzemeler (EK-3/C-5), listelerinde SUT kodları, alan tanımları ve fiyatları ile tanımlanmıştır.'});
CREATE (para_1091)-[:HAS_ITEM {order: 4}]->(item_1096);
CREATE (item_1095)-[:NEXT_ITEM]->(item_1096);
CREATE (para_1097:Paragraph {id: '2', content: 'SUT eki EK-3/C listelerinde yer almayan tıbbi malzemelerin bedelleri, SUT’ta belirtilen istisnalar hariç Kurumca karşılanmaz.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 1}]->(para_1097);
CREATE (para_1091)-[:NEXT_PARAGRAPH]->(para_1097);
CREATE (para_1098:Paragraph {id: '3', content: 'SUT eki EK-3/C listelerinde yer alan tıbbi malzemeler genel alan tanımları ile belirlenmiştir. Bu alan tanımları, benzer nitelikleri veya aynı işlevsel özellikleri taşıyan tüm tıbbi malzemeleri kapsamaktadır.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 2}]->(para_1098);
CREATE (para_1097)-[:NEXT_PARAGRAPH]->(para_1098);
CREATE (para_1099:Paragraph {id: '4', content: 'SUT eki EK-3/C-2, EK-3/C-3 ve EK-3/C-5 listelerinin açıklama bölümünde “I” harfi yer alan (kişiye özel ısmarlama üretilen) ürünler ile ilgili olarak;'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 3}]->(para_1099);
CREATE (item_1100:Item {id: 'a', content: '“Ismarlama Protez ve Ortez Merkezleri ile İşitme Cihazı Merkezleri Hakkında Yönetmelik” kapsamında Sağlık Bakanlığı tarafından ruhsatlandırılmış protez ve ortez merkezleri ile işitme cihazı merkezlerinden temin edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (para_1099)-[:HAS_ITEM {order: 0}]->(item_1100);
CREATE (item_1101:Item {id: 'b', content: 'Bu tıbbi malzemeler için fatura eki belgelere, SUT’un 5.3.2 maddesinde belirtilen belgelere ilave olarak, Sağlık Bakanlığı tarafından verilmiş ruhsatnamenin ve sorumlu müdür belgesinin “aslı gibidir” onaylı örneği eklenir. Ancak, resmi kurumlar/resmi sağlık hizmeti sunucuları bünyesindeki ısmarlama protez ve ortez merkezlerinden bu belgeler istenmez.'});
CREATE (para_1099)-[:HAS_ITEM {order: 1}]->(item_1101);
CREATE (item_1100)-[:NEXT_ITEM]->(item_1101);
CREATE (item_1102:Item {id: 'c', content: 'SUT eki EK-3/C-3 listesinin “Lenfödem Bası Giysileri (Ismarlama)” ve “Yanık Bası Giysileri (Ismarlama)” başlıkları altında tanımlanmış tıbbi malzemeler, “Ismarlama Protez ve Ortez Merkezleri ile İşitme Cihazı Merkezleri Hakkında Yönetmelik” kapsamında olmadığından sözleşme hükümleri doğrultusunda karşılanır.'});
CREATE (para_1099)-[:HAS_ITEM {order: 2}]->(item_1102);
CREATE (item_1101)-[:NEXT_ITEM]->(item_1102);
CREATE (para_1098)-[:NEXT_PARAGRAPH]->(para_1099);
CREATE (para_1103:Paragraph {id: '5', content: 'SUT eki EK-3/C-1 Listesinde yer alan tıbbi malzemelerden tıbbi uygunluk aranması esas olup, SUT eki EK-3/C listelerinde yer alan diğer tıbbi malzemelerden tıbbi uygunluk aranmaz. Ancak, sürekli kullanım gerektiren rapor takipli;'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 4}]->(para_1103);
CREATE (item_1104:Item {id: 'a', content: 'Hasta alt bezi/külotlu hasta alt bezi veçocuk hasta alt bezi/ çocuk külotlu hasta alt bezi,'});
CREATE (para_1103)-[:HAS_ITEM {order: 0}]->(item_1104);
CREATE (item_1105:Item {id: 'b', content: 'Kolostomi, ileostomi ve ürostomi malzemeleri,'});
CREATE (para_1103)-[:HAS_ITEM {order: 1}]->(item_1105);
CREATE (item_1104)-[:NEXT_ITEM]->(item_1105);
CREATE (item_1106:Item {id: 'c', content: 'Hidrofilik kendinden kayganlaştırıcılı sonda, hidro kit sonda,'});
CREATE (para_1103)-[:HAS_ITEM {order: 2}]->(item_1106);
CREATE (item_1105)-[:NEXT_ITEM]->(item_1106);
CREATE (item_1107:Item {id: 'ç', content: 'Aspirasyon kateteri için tıbbi uygunluk aranması zorunlu olmayıp, ihtiyaç duyulması halinde tıbbi uygunluk aranabilecektir.'});
CREATE (para_1103)-[:HAS_ITEM {order: 3}]->(item_1107);
CREATE (item_1106)-[:NEXT_ITEM]->(item_1107);
CREATE (para_1099)-[:NEXT_PARAGRAPH]->(para_1103);
CREATE (para_1108:Paragraph {id: '6', content: 'Kullanım adetleri günlük/haftalık/aylık vb. olarak reçetelendirilebilen tıbbi malzemelerin, SUT’ta belirtilen miktarlardan fazla reçete edilmesi durumunda, SUT’ta belirtilen kullanım adetleri doğrultusunda bedelleri Kurumca karşılanır.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 5}]->(para_1108);
CREATE (para_1103)-[:NEXT_PARAGRAPH]->(para_1108);
CREATE (para_1109:Paragraph {id: '7', content: 'Kurumca bedeli karşılanan tıbbi malzemelerin kaybolması veya çalınması halinde malzemenin SUT’ta belirtilen miat süresi doluncaya kadar Kurumca yenisinin bedeli karşılanmaz.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 6}]->(para_1109);

// Batch 30
CREATE (para_1108)-[:NEXT_PARAGRAPH]->(para_1109);
CREATE (para_1110:Paragraph {id: '8', content: 'Ortez, protez ve Kurumca iade alınan cihazların bakım ve onarımı; 49'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 7}]->(para_1110);
CREATE (item_1111:Item {id: 'a', content: 'Ortez, protez ve Kurumca iade alınan cihazlara ilişkin hasta kullanımı sırasında ortaya çıkabilecek bakım ve onarım masraflarından garanti kapsamı süresi içinde oluşan masraflar firma tarafından, garanti kapsamı süresi dışında oluşan masraflar ise bakım ve onarımın gerektiğinin Kurumca tespit edilmesi halinde Kurum tarafından karşılanacaktır.'});
CREATE (para_1110)-[:HAS_ITEM {order: 0}]->(item_1111);
CREATE (item_1112:Item {id: 'b', content: 'Ortez, protez ve Kurumca iade alınan cihazlara ilişkin bakım ve onarım ihtiyacı olması halinde; garanti süresi içerisinde satışı yapan firmaya, garanti süresi dışında ise Kurumun ilgili birimine müracaat edilir. Kurumca iade alınan DO1009, DO1017 ve DO1071 SUT kodlu cihazlara ilişkin bakım ve onarım ihtiyacı olması halinde; garanti süresi içerisinde olan cihazların bakım ve onarımı sağlanıncaya kadar satışı yapan firma hastalara ücretsiz yedek cihaz temin etmek zorundadır. Garanti süresi dışında olan cihazlarda ise bakım ve onarım sağlanıncaya kadar Kurumun ilgili birimi varsa stoktan hastaya yedek cihaz temini yapacak olup, stoklarda bulunmadığında bakım ve onarım hizmeti satın alınan firma tarafından hastalara ücretsiz yedek cihaz temin edilir.'});
CREATE (para_1110)-[:HAS_ITEM {order: 1}]->(item_1112);
CREATE (item_1111)-[:NEXT_ITEM]->(item_1112);
CREATE (item_1113:Item {id: 'c', content: 'Söz konusu malzemelerin kullanım kurallarına uyulmaması nedeniyle oluşan onarım masrafları Kurumca karşılanmaz. Bu amaçla Kurum, arızanın meydana geliş sebebini hekim raporu ile ihtiyaç duyulması halinde ise hekim raporuna ek olarak teknik servis raporu ile tespit eder.'});
CREATE (para_1110)-[:HAS_ITEM {order: 2}]->(item_1113);
CREATE (item_1112)-[:NEXT_ITEM]->(item_1113);
CREATE (para_1109)-[:NEXT_PARAGRAPH]->(para_1110);
CREATE (para_1114:Paragraph {id: '9', content: 'SUT eki EK-3/C-2 ve EK-3/C-3 listelerinde yer alan tıbbi malzemeler SUT’ta belirtilen miat sürelerinden önce yenilenmez. Ancak;'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 8}]->(para_1114);
CREATE (item_1115:Item {id: 'a', content: 'Büyüme ve gelişme çağındaki çocuklara kullanılması gerekli görülen miatlı tıbbi malzemeler, malzemenin çocuğun büyüme ve gelişmesi nedeni ile kullanılamadığı ve yenilenmesi gerektiğinin sağlık raporu ile belgelenmesi koşuluyla süresinden önce SUT hükümleri doğrultusunda yenilenebilir.'});
CREATE (para_1114)-[:HAS_ITEM {order: 0}]->(item_1115);
CREATE (item_1116:Item {id: 'b', content: 'SUT eki EK-3/C-2 ve EK-3/C-3 listelerinde yer alan miatlı tıbbi malzemelerin kullanım süresi dolmadan kullanıcının kasıt ve kusuru olmaksızın arızalandığının veya kullanılamaz hale geldiğinin sağlık raporu ile belgelendirilmesi ve Kurumca onarımının sağlanamaması hâlinde; garanti süresi içerisinde satışı yapan firma tarafından, garanti süresi dışında ise Kurum tarafından süresinden önce yenilenebilir.'});
CREATE (para_1114)-[:HAS_ITEM {order: 1}]->(item_1116);
CREATE (item_1115)-[:NEXT_ITEM]->(item_1116);
CREATE (item_1117:Item {id: 'c', content: 'SUT eki EK-3/C-2 Listesinde yer alan protez/ortezlerin bakım ve onarımının mümkün olmadığı durumlarda protez/ortezin miat süresinden önceki yenilenme talepleri, protez/ortezi oluşturan ara ürünlerin hangilerinin bakım ve onarımının mümkün olmadığının ayrıntılı olarak belirtildiği, bünyesinde protez/ortez ünitesi bulunduran resmi kurumlar/resmi sağlık hizmeti sunucuları tarafından düzenlenmiş sağlık raporu ile belgelenmesi koşuluyla, ilgili parçaların bakım/onarım masraflarının toplam bedelinin protez/ortez bedelinin %75’ini aşması halinde süresinden önce SUT hükümleri doğrultusunda Kurum tarafından karşılanacaktır.'});
CREATE (para_1114)-[:HAS_ITEM {order: 2}]->(item_1117);
CREATE (item_1116)-[:NEXT_ITEM]->(item_1117);
CREATE (item_1118:Item {id: 'ç', content: 'SUT eki EK-3/C-2 Listesinde yer alan protez/ortezlerin miat süresi içerisinde, protez/ortezi oluşturan ara ürünlerden herhangi birisinin yenilerek mevcut protez/ortezin kullanılabileceğinin sağlık raporu ile belgelendirilmesi halinde, bakım onarımı gereken parçaların bedelleri, SUT hükümleri doğrultusunda Kurum tarafından karşılanacaktır.'});
CREATE (para_1114)-[:HAS_ITEM {order: 3}]->(item_1118);
CREATE (item_1117)-[:NEXT_ITEM]->(item_1118);
CREATE (para_1110)-[:NEXT_PARAGRAPH]->(para_1114);
CREATE (para_1119:Paragraph {id: '10', content: 'Protez ve ortezlerin miat süresi sonunda bazı parçalarının değiştirilerek kullanılabileceğinin sağlık raporu ile saptanması halinde; protez ve ortezin değişim süresi, aslına uygun olarak değiştirilen parçalardan değişim süresi en uzun olanın kullanım süresi kadar uzar. Ancak, aynı protez ve ortezin yeniden talep edilmesi halinde değişen parçaların bedeli ödenecek tutardan mahsup edilir. ('});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 9}]->(para_1119);
CREATE (para_1114)-[:NEXT_PARAGRAPH]->(para_1119);
CREATE (para_1120:Paragraph {id: '11', content: 'SUT eki EK-3/C-2 ve EK-3/C-3 listelerinde yer alan tıbbi malzemelerin garanti süresi dışında oluşan bakım/onarım masraflarının ayrı ayrı toplamı veya bir defada oluşacak bakım onarım masrafı, SUT’ta belirtilen istisnalar hariç, tıbbi malzeme bedelinin %75’ ini geçemez. Kurumca iade alınan cihazların bakım onarım işlemlerinde ise bu maddede belirtilen cihazın garanti süresi dışında oluşan bakım/onarım masraflarının ayrı ayrı toplamı cihaz bedelinin %75’ ini geçemez hükmü dikkate alınmayacak olup, Kurumca iade alınan cihazlarda bir defada oluşacak bakım onarım masrafı (Akü ve batarya tutarı bakım onarım bedelinin hesaplanmasında dikkate alınmaz.) cihaz bedelinin %75’ ini geçemez.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 10}]->(para_1120);
CREATE (para_1119)-[:NEXT_PARAGRAPH]->(para_1120);
CREATE (para_1121:Paragraph {id: '12', content: 'Tıbbi malzemelerin yenilenmesi için düzenlenecek sağlık kurulu raporlarında, önceden Kurumca bedeli karşılanan protez veya ortezin yenilenmesi gerektiğinin gerekçeleriyle birlikte belirtilmesi gerekmektedir. Kurumca bedeli karşılanan protez veya ortezin kullanım süresinin dolduğu ve/veya sağlık kurulu raporu ile yenilenmesinin gerektiği durumlarda düzenlenecek sağlık kurulu raporlarında daha önce kullanılan protez veya ortezin belirtilmesi gerekmektedir.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 11}]->(para_1121);
CREATE (para_1120)-[:NEXT_PARAGRAPH]->(para_1121);
CREATE (para_1122:Paragraph {id: '13', content: 'SUT eki EK-3/C-2, EK-3/C-3, EK-3/C-4 ve EK-3/C-5 listelerinde yer alan tıbbi malzemeler, Kurumun uygun gördüğü mücbir sebeplere bağlı olarak kullanılamayacağının belgelendirilmesi halinde, kullanım sürelerine bakılmaksızın yenilenir.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 12}]->(para_1122);
CREATE (para_1121)-[:NEXT_PARAGRAPH]->(para_1122);
CREATE (para_1123:Paragraph {id: '14', content: '3713 sayılı Kanuna göre aylık bağlanmış maluller, 5434 sayılı Kanunun 56 ncı maddesi veya 2330 sayılı Kanunun 2 nci maddesinin birinci fıkrasının (e) ve (f) bentlerinde sayılanlardan 3713 sayılı Kanun kapsamına giren olaylar sebebiyle aylık bağlananlar 3713 sayılı Kanun kapsamına girmese dahi başkasının yardımı ve desteği olmaksızın yaşamak için gereken hareketleri yapamayacak derecede malul olan vazife ve harp malulleri ile atış, tatbikat veya diğer ateşli silah yaralanmaları nedeniyle malul olan vazife ve harp malullerinin sağlık kurulu raporuyla ihtiyaç duydukları her türlü ortez/protez ve diğer iyileştirici araç ve gereçlerin bedelleri herhangi bir kısıtlama getirilmeksizin Kurumca karşılanır. Ancak, bu kapsamdaki kişilerin;'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 13}]->(para_1123);
CREATE (item_1124:Item {id: 'a', content: 'SUT ve eki listelerinde yer alan tıbbi cihazları temin etmeleri halinde fatura bedelleri SUT ve eki listelerde yer alan fiyatları aşmıyor ise bu fiyatlar üzerinden Kurumca karşılanır.'});
CREATE (para_1123)-[:HAS_ITEM {order: 0}]->(item_1124);
CREATE (item_1125:Item {id: 'b', content: 'SUT’ta yer alan fiyatlarla temin edilemeyen özellikli akülü tekerlekli sandalye, ortez/protez ve diğer iyileştirici araç ve gereçler ile SUT’ta yer almayan her türlü ortez/protez ve diğer iyileştirici araç ve gereçler için Sağlık Bakanlığı Sağlık Bilimleri Üniversitesi Gaziler Fizik Tedavi ve Rehabilitasyon Eğitim ve Araştırma Hastanesi ile yapılan, SUT’ta yer alan fiyatlarla temin edilemeyen özellikli akülü tekerlekli sandalye, hazır ortez/protez ve diğer iyileştirici araç ve gereçler ile SUT’ta yer almayan hazır ortez/protez ve diğer iyileştirici araç ve gereçler için ise Sağlık Bakanlığına bağlı İstanbul Fizik Tedavi ve Rehabilitasyon Eğitim ve Araştırma Hastanesi ile yapılan sözleşme/protokoller kapsamında, bu sağlık hizmeti sunucularınca oluşan ve/veya oluşturulacak komisyonlar/kurullarca ihtiyacı olduğunun tespit edilmesi ve ihtiyacın sağlık hizmeti 50 sunucularınca karşılanarak Kuruma faturalandırılması halinde fatura tutarı üzerinden ödenir. Ancak, özellikli akülü tekerlekli sandalye, hazır ortez/protez ve diğer iyileştirici araç ve gereçler, sağlık hizmeti sunucusu tarafından temin edilme bedeli üzerine 10 (on) brüt asgari ücret tutarını geçmemek üzere %12 oranında işletme gideri eklenerek Kuruma fatura edilir.'});
CREATE (para_1123)-[:HAS_ITEM {order: 1}]->(item_1125);
CREATE (item_1124)-[:NEXT_ITEM]->(item_1125);
CREATE (item_1126:Item {id: 'c', content: 'Tıbbi malzemelere ilişkin bakım ve onarım masrafları garanti süresi içinde firma tarafından karşılanacağından Kuruma ayrıca faturalandırılamaz.'});
CREATE (para_1123)-[:HAS_ITEM {order: 2}]->(item_1126);
CREATE (item_1125)-[:NEXT_ITEM]->(item_1126);
CREATE (item_1127:Item {id: 'ç', content: 'Tıbbi malzemelerin garanti süresi içindeki yenilenme talepleri Kurumca karşılanmaz.'});
CREATE (para_1123)-[:HAS_ITEM {order: 3}]->(item_1127);
CREATE (item_1126)-[:NEXT_ITEM]->(item_1127);
CREATE (item_1128:Item {id: 'd', content: 'Aynı işlevi gören birden fazla ürün çeşidi bulunan tıbbi malzemelerden birinin temini halinde diğerlerinin bedeli, temin edilen tıbbi malzemenin garanti süresi dolana kadar Kurumca karşılanmaz.'});
CREATE (para_1123)-[:HAS_ITEM {order: 4}]->(item_1128);
CREATE (item_1127)-[:NEXT_ITEM]->(item_1128);
CREATE (item_1129:Item {id: 'e', content: 'SUT eki EK-3/C-2 ve EK-3/C-5 listelerinde yer alan tıbbi malzemelerin garanti süresi sonunda kullanılamaz durumda olduğunun fiziksel tıp ve rehabilitasyon ile ortopedi ve travmatoloji uzman hekimlerinin birlikte yer aldığı sağlık kurulu raporu ile belgelendirilmesi halinde, tıbbi malzemelerin yenilenme talepleri listelerde yer alan miat süreleri dikkate alınmadan Kurumca karşılanır.'});
CREATE (para_1123)-[:HAS_ITEM {order: 5}]->(item_1129);
CREATE (item_1128)-[:NEXT_ITEM]->(item_1129);
CREATE (item_1130:Item {id: 'f', content: 'SUT eki EK-3/C-2 ve EK-3/C-5 listelerinde yer alan tıbbi malzemeleri temin etmeleri halinde hakem olarak tayin edilen sağlık hizmeti sunucusu onay şartı aranmaz.'});
CREATE (para_1123)-[:HAS_ITEM {order: 6}]->(item_1130);
CREATE (item_1129)-[:NEXT_ITEM]->(item_1130);
CREATE (item_1131:Item {id: 'g', content: 'Tetrapleji veya parapleji tanılı hastalarda manuel tekerlekli sandalye ile akülü tekerlekli sandalyenin aynı anda reçete edildiği durumlarda, her iki malzeme bedeli de Kurumumuzca karşılanır.'});
CREATE (para_1123)-[:HAS_ITEM {order: 7}]->(item_1131);
CREATE (item_1130)-[:NEXT_ITEM]->(item_1131);
CREATE (para_1122)-[:NEXT_PARAGRAPH]->(para_1123);
CREATE (para_1132:Paragraph {id: '15', content: 'Genel sağlık sigortalısı veya bakmakla yükümlü olunan kişilerin 3713 sayılı Kanunun 21 inci maddesinde sayılan olaylara maruz kalınması nedeniyle yaralandıklarını gösterir ilgili mülki amirlik tarafından düzenlenen belgeye istinaden kişilerin tedavileri sonuçlanıncaya veya maluliyetleri kesinleşinceye kadar geçen süre içerisinde sağlık kurulu raporuyla ihtiyaç duydukları her türlü ortez/protez ve diğer iyileştirici araç ve gereçlerin bedellerinin ödenmesinde SUT’un 3.1.2 inci maddesinin on dördüncü fıkrası gibi yararlandırılır. Fatura eki belgelere ilgili mülki amirlik tarafından düzenlenen belgenin de eklenmesi gereklidir. Ancak, bu kişilerin maluliyetleri ile ilgili durum kesinleştikten sonra, 5510 sayılı Kanuna göre hangi kapsamda sağlık yardımlarından yararlandırıldığına bakılarak ortez/protez ve diğer iyileştirici araç ve gereçlerin bedelleri karşılanır.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 14}]->(para_1132);
CREATE (para_1123)-[:NEXT_PARAGRAPH]->(para_1132);
CREATE (para_1133:Paragraph {id: '16', content: 'Ayakta tedavide kullanılan tıbbi malzemelere ait fatura bedelleri malzemenin sözleşmeli satış merkezleri veya eczanelerden temin edilmesi halinde Kurumca karşılanır. Ancak, Kurumca iade alınan tıbbi malzeme bedelleri sözleşmeler tamamlanıncaya kadar şahıs ödemesi şeklinde yapılır.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 15}]->(para_1133);
CREATE (para_1132)-[:NEXT_PARAGRAPH]->(para_1133);
CREATE (para_1134:Paragraph {id: '17', content: 'Kurum mevzuatında yer alan istisnalar hariç Kurumca bedeli karşılanmayan tıbbi cihazlara ait tıbbi sarf malzeme ve bakım/onarım bedelleri karşılanmaz.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 16}]->(para_1134);
CREATE (para_1133)-[:NEXT_PARAGRAPH]->(para_1134);
CREATE (para_1135:Paragraph {id: '18', content: 'Reçetelerde hekimce yapılması gereken düzeltmeler reçeteyi yazan hekim, ilgili hekimin bulunmaması halinde reçeteyi düzenleyen sağlık hizmeti sunucusundaki aynı branştan hekim tarafından, uzman hekim raporlarında raporun düzenlendiği sağlık hizmeti sunucusundaki raporu düzenleyen hekim tarafından (bu hekimin bulunmaması halinde aynı branştan hekim), sağlık kurulu raporlarında ise raporda yer alan hekimlerden biri tarafından yapılır.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 17}]->(para_1135);
CREATE (para_1134)-[:NEXT_PARAGRAPH]->(para_1135);
CREATE (para_1136:Paragraph {id: '19', content: 'SUT eki EK-3/C-2, EK-3/C-3 ve EK-3/C-5 listelerinde yer alan tıbbi malzemelerin yatarak tedaviler sırasında hastalara reçete edilmek suretiyle dışardan temin ettirilmesi halinde, şahıs ödemesi olarak SUT hükümleri doğrultusunda bedelleri Kurumca karşılanır. Bu listelerde yer alan tıbbi malzemelerden sözleşmeler kapsamında temin edilmesi zorunlu malzemelerin bedelleri ise bu malzemelerin ancak sözleşmeli merkez/eczanelerden temin edilmesi halinde Kurumca sözleşme hükümleri doğrultusunda karşılanır. SUT eki EK-3/C-4 listesinde yer alan ancak, yatarak tedaviler sırasında Kurumla sözleşmeli sağlık hizmeti sunucularınca temin edilmesi gereken tıbbi malzeme listelerinde yer alan tıbbi malzemelerin geri ödeme işlemleri, malzemenin yatarak tedaviler sırasında hastalara reçete edilerek dışardan temin ettirilmesi halinde şahıs ödemesi kapsamında SUT’un 3.1.1 inci maddesinin beşinci ve altıncı fıkralarında yer alan hükümler doğrultusunda yapılır. Ancak, taburcu olan hastalara reçetelendirilecek malzemeler, ayakta tedavi kapsamında değerlendirilir.'});
CREATE (sec_1090)-[:HAS_PARAGRAPH {order: 18}]->(para_1136);
CREATE (para_1135)-[:NEXT_PARAGRAPH]->(para_1136);
CREATE (amend_1137:Amendment {content: '(Değişik: RG- 21/04/2024- 32524/ 9 md. Yürürlük: 30/04/2024)'});
CREATE (sec_1090)-[:HAS_AMENDMENT {order: 0}]->(amend_1137);
CREATE (amend_1138:Amendment {content: '(Değişik: RG- 25/09/2024- 32673/ 5 md. Yürürlük: 02/09/2024)'});
CREATE (sec_1090)-[:HAS_AMENDMENT {order: 1}]->(amend_1138);
CREATE (sec_1139:Subsection {id: '3.1.2.1', title: 'Şahıs ödemesi kapsamında bedeli karşılanan tıbbi malzemelere ilişkin sağlık raporu ve reçeteler'});
CREATE (sec_1090)-[:HAS_SUBSECTION {order: 0}]->(sec_1139);
CREATE (para_1140:Paragraph {id: '1', content: 'Malzemenin hazır olması halinde sağlık raporu tarihi ile fatura tarihi arasında süre en fazla 2 (iki) ay (Mülga: RG-16/03/2023-32134/16-a md. Yürürlük:24/03/2023) olmalıdır. (Mülga: RG- 16/03/2023-32134/16-a md. Yürürlük: 24/03/2023)'});
CREATE (sec_1139)-[:HAS_PARAGRAPH {order: 0}]->(para_1140);
CREATE (para_1141:Paragraph {id: '3', content: 'İade kapsamındaki cihazlara ait işlemlerin reçete ve sağlık raporu ile birlikte reçete tarihinden itibaren 10 (on) işgünü içinde Kurumumuz taşra teşkilatlarına başvurularak başlatılması zorunludur. Kurumca iade alınan cihazların başvuru yapılan sosyal güvenlik il müdürlüğü stoğunda bulunmadığı durumlarda, bu cihazlara ait fatura tarihi ile stok kontrol tarihi arasında en fazla 30 (otuz) işgünü bulunması halinde Kurumca bedelleri karşılanır.'});
CREATE (sec_1139)-[:HAS_PARAGRAPH {order: 1}]->(para_1141);
CREATE (para_1140)-[:NEXT_PARAGRAPH]->(para_1141);
CREATE (sec_1142:Subsection {id: '3.1.2.2', title: 'Sözleşmeler kapsamında bedeli karşılanan tıbbi malzemelere ilişkin sağlık raporu ve reçeteler'});
CREATE (sec_1090)-[:HAS_SUBSECTION {order: 1}]->(sec_1142);
CREATE (para_1143:Paragraph {id: '1', content: 'Bir defaya mahsus verilen tıbbi malzemeler için; malzemenin hazır veya ısmarlama olduğuna bakılmaksızın sağlık raporu tarihinden itibaren en geç 2 (iki) ay içerisinde reçetenin düzenlenmesi gerekmekte olup, sağlık raporu ile fatura tarihi arasındaki süre dikkate alınmaz.'});
CREATE (sec_1142)-[:HAS_PARAGRAPH {order: 0}]->(para_1143);
CREATE (para_1144:Paragraph {id: '2', content: 'Sürekli kullanılan tıbbi malzemelere ilişkin sağlık raporları SUT’ta belirtilen istisnalar hariç olmak üzere en fazla 2 (iki) yıl geçerlidir.'});
CREATE (sec_1142)-[:HAS_PARAGRAPH {order: 1}]->(para_1144);
CREATE (para_1143)-[:NEXT_PARAGRAPH]->(para_1144);
CREATE (para_1145:Paragraph {id: '3', content: 'Sürekli kullanılan tıbbi malzemelere ilişkin düzenlenen sağlık raporlarına istinaden temin edilen tıbbi malzeme reçeteleri, Kurum kayıtlarında yer alan malzeme bitim tarihinden 15 (on beş) gün öncesine kadar düzenlenebilir.'});
CREATE (sec_1142)-[:HAS_PARAGRAPH {order: 2}]->(para_1145);
CREATE (para_1144)-[:NEXT_PARAGRAPH]->(para_1145);

// Batch 31
CREATE (para_1146:Paragraph {id: '4', content: 'SUT’ta belirtilen istisnalar hariç olmak üzere sürekli kullanılan tıbbi malzemelere ilişkin reçeteler en fazla 2 (iki) aylık miktarlarda düzenlenir.'});
CREATE (sec_1142)-[:HAS_PARAGRAPH {order: 3}]->(para_1146);
CREATE (para_1145)-[:NEXT_PARAGRAPH]->(para_1146);
CREATE (para_1147:Paragraph {id: '5', content: 'SUT ve eki listelerde sağlık raporlarının hangi basamak sağlık hizmeti sunucularınca düzenleneceğine yönelik hüküm bulunmayan sürekli kullanılan tıbbi malzemelerin teminine ilişkin sağlık raporları ikinci veya üçüncü basamak sağlık hizmeti sunucularınca düzenlenir. (Ek: RG- 16/03/2023-32134/16-b md. Yürürlük: 24/03/2023)'});
CREATE (sec_1142)-[:HAS_PARAGRAPH {order: 4}]->(para_1147);
CREATE (para_1146)-[:NEXT_PARAGRAPH]->(para_1147);
CREATE (para_1148:Paragraph {id: '6', content: 'Temin edilen tıbbi malzemenin ısmarlama olması halinde sağlık raporunun düzenlenme tarihi ile merkeze müracaat tarihi arasındaki süre en fazla 4 (dört) ay olmalıdır. 51'});
CREATE (sec_1142)-[:HAS_PARAGRAPH {order: 5}]->(para_1148);
CREATE (para_1147)-[:NEXT_PARAGRAPH]->(para_1148);
CREATE (sec_1139)-[:NEXT_SUBSECTION]->(sec_1142);
CREATE (sec_1073)-[:NEXT_SUBSECTION]->(sec_1090);
CREATE (sec_1149:Subsection {id: '3.1.3', title: 'Yatarak tedavilerde kullanılan tıbbi malzemeler'});
CREATE (sec_1072)-[:HAS_SUBSECTION {order: 2}]->(sec_1149);
CREATE (para_1150:Paragraph {id: '1', content: 'Sağlık hizmeti sunucuları tarafından temin edilen ilgili branşlara/ürün gruplarına ait Kurumca bedeli karşılanacak tıbbi malzemelerin SUT kodları, tıbbi malzeme alan tanımları ve fiyatları aşağıdaki SUT eki listelerde tanımlanmıştır:'});
CREATE (sec_1149)-[:HAS_PARAGRAPH {order: 0}]->(para_1150);

CREATE (sec_3739:Subsection {id: '4.4.1', title: 'Uygulanacak indirim oranları'});
CREATE (sec_3735)-[:HAS_SUBSECTION {order: 0}]->(sec_3739);
CREATE (para_3740:Paragraph {id: '1', content: 'Depocuya satış fiyatı 39,04 (otuz dokuz virgül sıfır dört) TL ve altında olan ilaçlar için kamu kurum iskontosu uygulanmaz (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 0}]->(para_3740);
CREATE (para_3741:Paragraph {id: '2', content: 'Depocuya satış fiyatı 39,05 (otuz dokuz virgül sıfır beş) TL’nin (dahil) üzerinde olan ilaçlara kamu kurum iskontosu olarak %10 veya %11 baz iskonto uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 1}]->(para_3741);
CREATE (para_3740)-[:NEXT_PARAGRAPH]->(para_3741);
CREATE (para_3742:Paragraph {id: '3', content: 'Aşağıdaki fıkralarda konu edilen kamu kurum iskontoları ve ilave iskonto uygulamalarında ilaçların, referans, eşdeğer, fiyat korumalı gibi durumlarının belirlenmesinde Sağlık Bakanlığı tarafından yapılmış olan düzenlemeler esas alınır. İlaçlarda oluşabilecek durum değişikliklerine ilişkin iskonto uygulamaları Kurum tarafından değerlendirilir. Ancak, SUT eki EK-4/A listesinde bulunmaktayken Sağlık Bakanlığı Türkiye İlaç ve Tıbbi Cihaz Kurumu Detaylı İlaç Fiyat Listesinde yayımlanan; referans ürün, eşdeğer ürün, fiyat korumalı ürün statülerinde oluşan değişiklikler nedeniyle kamu fiyatında artışa yol açabilecek her türlü değişiklik için indirim oranlarına ilişkin güncelleme talepleri ilgili komisyon marifetiyle Kurum tarafından değerlendirilir.'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 2}]->(para_3742);
CREATE (para_3741)-[:NEXT_PARAGRAPH]->(para_3742);
CREATE (para_3743:Paragraph {id: '4', content: 'Fiyat korumalı ürünlerden;'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 3}]->(para_3743);
CREATE (item_3744:Item {id: 'a', content: 'Depocuya satış fiyatı 39,05 (otuz dokuz virgül sıfır beş) TL (dahil) ile 74,72 (yetmiş dört virgül yetmiş iki) TL (dahil) arasında olan ilaçlara; %0 iskonto uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3743)-[:HAS_ITEM {order: 0}]->(item_3744);
CREATE (item_3745:Item {id: 'b', content: 'Depocuya satış fiyatı 74,73 (yetmiş dört virgül yetmiş üç) TL (dahil) ile 112,58 (yüz on iki virgül elli sekiz) TL (dahil) arasında olan ilaçlara; %10 baz iskonto uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3743)-[:HAS_ITEM {order: 1}]->(item_3745);
CREATE (item_3744)-[:NEXT_ITEM]->(item_3745);
CREATE (item_3746:Item {id: 'c', content: 'Depocuya satış fiyatı 112,59 (yüz on iki virgül elli dokuz) TL ve üzerinde olan, referansı olan ve referansı olmayıp maliyet kartına göre fiyat alan ilaçlara; %28 iskonto (baz iskonto %11+%17 ilave iskonto) uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3743)-[:HAS_ITEM {order: 2}]->(item_3746);
CREATE (item_3745)-[:NEXT_ITEM]->(item_3746);
CREATE (item_3747:Item {id: 'ç', content: 'Depocuya satış fiyatı 112,59 (yüz on iki virgül elli dokuz) TL ve üzerinde olan, referansı olmayan ilaçlara; %40 iskonto (baz iskonto %11+%29 ilave iskonto) uygulanır (özel iskontolar saklı kalmak kaydıyla).'});
CREATE (para_3743)-[:HAS_ITEM {order: 3}]->(item_3747);
CREATE (item_3746)-[:NEXT_ITEM]->(item_3747);
CREATE (para_3742)-[:NEXT_PARAGRAPH]->(para_3743);
CREATE (para_3748:Paragraph {id: '5', content: 'Eşdeğeri olmayan referans ilaçlardan;'});
CREATE (sec_3739)-[:HAS_PARAGRAPH {order: 4}]->(para_3748);

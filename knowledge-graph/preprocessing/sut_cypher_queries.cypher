CREATE (sec_3476)-[:NEXT_SUBSECTION]->(sec_3506);
CREATE (sec_3518:Subsection {id: '4.2.48', title: 'Kolik asit kullanım ilkeleri;'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 47}]->(sec_3518);
CREATE (para_3519:Paragraph {id: '1', content: 'Kalıtsal safra asit metabolizması bozuklukları veya Zellweger spektrum bozukluğu tanılı hastalarda; üçüncü basamak resmi sağlık hizmet sunucularında çocuk endokrinoloji, çocuk endokrinolojisi ve metabolizma hastalıkları, çocuk metabolizma hastalıkları, erişkin endokrinoloji ve metabolizma hastalıkları, çocuk ve erişkin gastroenteroloji uzman hekimlerinden en az ikisinin yer aldığı 6 ay süreli sağlık kurulu raporuna dayanılarak bu uzman hekimlerce reçetelenir. Mevcut enzim eksikliğinin genetik olarak doğrulandığı test sonucunun raporda belirtilmesi gerekmektedir.'});
CREATE (sec_3518)-[:HAS_PARAGRAPH {order: 0}]->(para_3519);
CREATE (amend_3520:Amendment {content: '(Değişik: RG- 25/06/2023- 32232/ 1 md. Yürürlük: 06/07/2023)'});
CREATE (sec_3518)-[:HAS_AMENDMENT {order: 0}]->(amend_3520);
CREATE (sec_3506)-[:NEXT_SUBSECTION]->(sec_3518);
CREATE (sec_3521:Subsection {id: '4.2.49', title: 'Spinal Musküler Atrofi hastalığında nusinersen sodium kullanım ilkeleri;'});
CREATE (sec_1795)-[:HAS_SUBSECTION {order: 48}]->(sec_3521);
CREATE (sec_3522:Subsection {id: '4.2.49.A', title: 'Spinal Musküler Atrofi Tip-1 (SMA Tip-1) hastalığında;'});
CREATE (sec_3521)-[:HAS_SUBSECTION {order: 0}]->(sec_3522);
CREATE (para_3523:Paragraph {id: '1', content: 'SMA Tip-1 tedavisinde kullanılan ilaçlar çocuk nörolojisi uzman hekiminin yer aldığı ilk 4 uygulama için 3 ay süreli, sonraki uygulamalar için 4 ay süreli Kurumca belirlenen üçüncü basamak resmi sağlık kurumlarında düzenlenen sağlık kurulu raporuna istinaden Kurumca belirlenen üçüncü basamak resmi sağlık kurumlarında çocuk nörolojisi uzman hekimi tarafından her bir uygulama için ayrı ayrı reçete edilmesi halinde Kurumca bedeli karşılanır.'});
CREATE (sec_3522)-[:HAS_PARAGRAPH {order: 0}]->(para_3523);
CREATE (para_3524:Paragraph {id: '2', content: 'Nusinersen sodium etkin maddesini içeren ilacın; tescili yapılmış yenidoğan ve çocuk yoğun bakım servisi bulunan, bünyesinde çocuk nörolojisi uzmanının da yer aldığı, beslenme ve diyetetik ile fizik tedavi ve rehabilitasyon hizmetlerinin multidisipliner bir yaklaşımla sunulabileceği Kurumca belirlenen üçüncü basamak resmi sağlık kurumlarında kullanılması halinde Kurumca bedeli karşılanır.'});
CREATE (sec_3522)-[:HAS_PARAGRAPH {order: 1}]->(para_3524);
CREATE (para_3523)-[:NEXT_PARAGRAPH]->(para_3524);
CREATE (para_3525:Paragraph {id: '3', content: 'Hastalarda aşağıda yer alan kriterlerin tamamının sağlanması halinde Kurumca bedeli karşılanır.'});
CREATE (sec_3522)-[:HAS_PARAGRAPH {order: 2}]->(para_3525);
CREATE (item_3526:Item {id: 'a', content: 'Genetik (5qSMA; homozigot gen delesyonu veya homozigot gen mutasyonu veya bileşik heterozigot gen mutasyonu olan ve SMN2 kopya sayısının en az 1 olduğunun gösterilmesi kaydıyla) ve klinik olarak SMA Tip-1 tanısı konmuş ve en az birisi çocuk nörolojisi uzmanı olmak üzere 3 uzman hekimden oluşan sağlık kurulu raporu bulunmalıdır. 141'});
CREATE (para_3525)-[:HAS_ITEM {order: 0}]->(item_3526);
CREATE (item_3527:Item {id: 'b', content: 'Klinik belirti ve bulgular, SMA Tip-1 ile uyumlu olarak ≤ 6 ay (180 gün) iken başlamış olmalıdır.'});
CREATE (para_3525)-[:HAS_ITEM {order: 1}]->(item_3527);
CREATE (item_3526)-[:NEXT_ITEM]->(item_3527);
CREATE (item_3528:Item {id: 'c', content: 'Bu maddenin 3 üncü fıkrasının (a) ve (b) bentlerinde belirtilen kriterlere uyan hastalarda invaziv/non invaziv mekanik solunum desteği ihtiyacı olup olmadığına bakılmaksızın tedaviye başlanır. İlk 4 doz ilaç kullanımı başlangıç tedavisi olarak kabul edilir ve ilk 4 doz ilaç kullanımı sürecinde SMA’dan kaynaklı invaziv mekanik solunum desteği ihtiyacı ve süreleri değerlendirmelerde dikkate alınmaz. 5 inci ve takip eden dozlar idame tedavilerdir.'});
CREATE (para_3525)-[:HAS_ITEM {order: 2}]->(item_3528);
CREATE (item_3527)-[:NEXT_ITEM]->(item_3528);
CREATE (item_3529:Item {id: 'ç', content: 'Lomber ponksiyon prosedürleri, BOS sirkülasyonu veya güvenlilik değerlendirmelerini engelleyebilecek bir beyin veya spinal kord hastalığı veya öyküsü olmamalıdır.'});
CREATE (para_3525)-[:HAS_ITEM {order: 3}]->(item_3529);
CREATE (item_3528)-[:NEXT_ITEM]->(item_3529);
CREATE (item_3530:Item {id: 'd', content: 'BOS drenajı için implant edilmiş bir şant veya implante edilmiş bir BOS kateteri bulunmaması gerekmektedir.'});
CREATE (para_3525)-[:HAS_ITEM {order: 4}]->(item_3530);
CREATE (item_3529)-[:NEXT_ITEM]->(item_3530);
CREATE (item_3531:Item {id: 'e', content: 'Bakteriyel menenjit veya viral ensefalit hastalığı veya öyküsü olmamalıdır.'});
CREATE (para_3525)-[:HAS_ITEM {order: 5}]->(item_3531);
CREATE (item_3530)-[:NEXT_ITEM]->(item_3531);
CREATE (item_3532:Item {id: 'f', content: 'Hipoksik iskemik ensefalopati tanısı almamış olmalı ve hipoksik doğuma bağlı nörolojik sekelleri bulunmamalıdır.'});
CREATE (para_3525)-[:HAS_ITEM {order: 6}]->(item_3532);
CREATE (item_3531)-[:NEXT_ITEM]->(item_3532);
CREATE (para_3524)-[:NEXT_PARAGRAPH]->(para_3525);
CREATE (para_3533:Paragraph {id: '4', content: 'Yenidoğan SMA taraması kapsamında, tarama sonucu genetik analizi (5qSMA; homozigot gen delesyonu veya homozigot gen mutasyonu veya bileşik heterozigot gen mutasyonu olan ve SMN2 kopya sayısının en az 1 olduğunun gösterilmesi kaydıyla) pozitif olan hastalarda klinik tiplendirmeye bakılmaksızın, raporlama ve reçeteleme koşulları yukarıda belirtildiği şekliyle ilacın bedelleri Kurumca karşılanır.'});
CREATE (sec_3522)-[:HAS_PARAGRAPH {order: 3}]->(para_3533);
CREATE (para_3525)-[:NEXT_PARAGRAPH]->(para_3533);
CREATE (sec_3534:Subsection {id: '4.2.49.B', title: 'Spinal Musküler Atrofi Tip-2 (SMA Tip-2) ve Spinal Musküler Atrofi Tip-3 (SMA Tip-3)', content: 'hastalığında;'});
CREATE (sec_3521)-[:HAS_SUBSECTION {order: 1}]->(sec_3534);
CREATE (para_3535:Paragraph {id: '1', content: 'Hastalarda aşağıda yer alan kriterlerin tamamının sağlanması halinde Kurumca bedeli karşılanır.'});
CREATE (sec_3534)-[:HAS_PARAGRAPH {order: 0}]->(para_3535);
CREATE (item_3536:Item {id: 'a', content: 'Genetik (5qSMA; homozigot gen delesyonu veya homozigot gen mutasyonu veya bileşik heterozigot gen mutasyonu olan ve SMN2 kopya sayısının en az 2 olduğunun gösterilmesi kaydıyla) ve klinik olarak SMA Tip-2 veya SMA Tip-3 tanısı konmuş ve Kurumca belirlenen üçüncü basamak resmi sağlık kurumlarında en az birisi çocuk nörolojisi/nöroloji uzmanı ve ortopedi ve travmatoloji veya beyin ve sinir cerrahisi uzmanı olmak üzere 3 uzman hekim tarafından düzenlenen sağlık kurulu raporu bulunmalıdır.'});
CREATE (para_3535)-[:HAS_ITEM {order: 0}]->(item_3536);
CREATE (item_3537:Item {id: 'b', content: 'Klinik belirti ve bulgular, SMA Tip-2 veya SMA Tip-3 ile uyumlu olarak ≥ 6 ay (180 gün) iken başlamış olmalıdır.'});
CREATE (para_3535)-[:HAS_ITEM {order: 1}]->(item_3537);
CREATE (item_3536)-[:NEXT_ITEM]->(item_3537);

// Batch 95
CREATE (item_3538:Item {id: 'c', content: 'İnvaziv/non invaziv mekanik solunum desteği ihtiyacı olmayan ve normal yutma refleksine sahip ve oral beslenebilen hastalarda tedaviye başlanır.'});
CREATE (para_3535)-[:HAS_ITEM {order: 2}]->(item_3538);
CREATE (item_3537)-[:NEXT_ITEM]->(item_3538);
CREATE (item_3539:Item {id: 'ç', content: 'Lomber ponksiyon prosedürleri, BOS sirkülasyonu veya güvenlilik değerlendirmelerini engelleyebilecek bir beyin veya spinal kord hastalığı veya öyküsü olmamalıdır.'});
CREATE (para_3535)-[:HAS_ITEM {order: 3}]->(item_3539);
CREATE (item_3538)-[:NEXT_ITEM]->(item_3539);
CREATE (item_3540:Item {id: 'd', content: 'BOS drenajı için implante edilmiş bir şant veya implante edilmiş bir BOS kateteri bulunmaması gerekmektedir.'});
CREATE (para_3535)-[:HAS_ITEM {order: 4}]->(item_3540);
CREATE (item_3539)-[:NEXT_ITEM]->(item_3540);
CREATE (item_3541:Item {id: 'e', content: 'Bakteriyel menenjit veya viral ensefalit hastalığı veya öyküsü olmamalıdır.'});
CREATE (para_3535)-[:HAS_ITEM {order: 5}]->(item_3541);
CREATE (item_3540)-[:NEXT_ITEM]->(item_3541);
CREATE (item_3542:Item {id: 'f', content: 'Hipoksik iskemik ensefalopati tanısı almamış olmalı ve hipoksik doğuma bağlı nörolojik sekelleri bulunmamalıdır.'});
CREATE (para_3535)-[:HAS_ITEM {order: 6}]->(item_3542);
CREATE (item_3541)-[:NEXT_ITEM]->(item_3542);
CREATE (item_3543:Item {id: 'g', content: 'Lomber ponksiyon uygulanmasına engel bir durum olmadığının sağlık kurulu raporunda belirtilmiş olması gerekmektedir.'});
CREATE (para_3535)-[:HAS_ITEM {order: 7}]->(item_3543);
CREATE (item_3542)-[:NEXT_ITEM]->(item_3543);
CREATE (para_3544:Paragraph {id: '2', content: '“Nusinersen sodium” pozolojisi SMA Tip-2 veya SMA Tip-3 hastalarında 0, 14, 28 ve 63 üncü günler olmak üzere 4 doz yükleme dozu şeklindedir. İdame dozlar da 4 ayda bir uygulanır. İlk 4 uygulama için 3 ay süreli, sonraki uygulamalar için ise 4 ay süreli sağlık kurulu raporuna istinaden çocuk nörolojisi/nöroloji uzman hekimi tarafından her bir uygulama için ayrı ayrı reçete edilmesi halinde bedelleri Kurumca karşılanır.'});
CREATE (sec_3534)-[:HAS_PARAGRAPH {order: 1}]->(para_3544);
CREATE (para_3535)-[:NEXT_PARAGRAPH]->(para_3544);
CREATE (para_3545:Paragraph {id: '3', content: 'Yenidoğan SMA taraması kapsamında, tarama sonucu genetik analizi (5qSMA; homozigot gen delesyonu veya homozigot gen mutasyonu veya bileşik heterozigot gen mutasyonu olan ve SMN2 kopya sayısının en az 2 olduğunun gösterilmesi kaydıyla) pozitif olan hastalarda klinik tiplendirmeye bakılmaksızın, raporlama ve reçeteleme koşulları yukarıda belirtildiği şekliyle ilacın bedelleri Kurumca karşılanır. 4.2.50. Chenodeoxycholic Acid kullanım ilkeleri;'});
CREATE (sec_3534)-[:HAS_PARAGRAPH {order: 2}]->(para_3545);
CREATE (para_3544)-[:NEXT_PARAGRAPH]->(para_3545);
CREATE (para_3546:Paragraph {id: '1', content: 'Yalnızca, Cerebrotendinous Xanthomatosis hastalığının tedavisinde “CYP27A1 genindeki mutasyonun belgelendirilmesi ve  üçüncü basamak resmi sağlık hizmeti sunucusunda en az bir çocuk metabolizma veya çocuk endokrinoloji ve metabolizma hastalıkları uzman hekiminin yer aldığı  1 yıl süreli sağlık kurulu raporuna dayanılarak, çocuk metabolizma, çocuk endokrinoloji ve metabolizma veya çocuk/erişkin nöroloji uzman hekimleri tarafından reçete edilmesi halinde bedeli ödenir.'});
CREATE (sec_3534)-[:HAS_PARAGRAPH {order: 3}]->(para_3546);
CREATE (para_3545)-[:NEXT_PARAGRAPH]->(para_3546);
CREATE (amend_3547:Amendment {content: '(Ek: RG- 04/02/2018- 30322/ 18 md. Yürürlük: 15/02/2018)'});

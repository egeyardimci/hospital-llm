CREATE (sec_307:Subsection {id: '1.9.3', title: 'İlave ücret alınmayacak sağlık hizmetleri'});
CREATE (sec_275)-[:HAS_SUBSECTION {order: 2}]->(sec_307);
CREATE (para_308:Paragraph {id: '1', content: 'Aşağıda belirtilen sağlık hizmetleri için hiçbir ilave ücret alınamaz. Ancak; Yükseköğretim kurumlarına ait sağlık hizmeti sunucularında (vakıf üniversiteleri  hariç) öğretim üyesi tarafından verilen 18 yaşını doldurmamış çocuklar hariç olmak üzere; SUT eki EK-2/B ve EK-2/C Listesindeki işitsel implant işlemleri için ilave ücret alınabilir. Ayrıca Yükseköğretim kurumlarına ait sağlık hizmeti sunucularında (vakıf üniversiteleri hariç) öğretim üyesi tarafından verilen SUT’un 2.1.1 numaralı maddesi kapsamındaki sağlık hizmetleri ve kardiyovasküler cerrahi işlemler için de ilave ücret alınabilir.'});
CREATE (sec_307)-[:HAS_PARAGRAPH {order: 0}]->(para_308);
CREATE (item_309:Item {id: 'a', content: 'Acil servislerde verilen ve SUT eki EK-2/B Listesinde yer alan 520.021 kod numaralı “Yeşil alan muayenesi” adı altında Kuruma fatura edilebilen sağlık hizmetleri hariç olmak üzere, acil haller nedeniyle sunulan sağlık hizmetleri, 15'});
CREATE (para_308)-[:HAS_ITEM {order: 0}]->(item_309);
CREATE (item_310:Item {id: 'b', content: 'Yoğun bakım hizmetleri,'});
CREATE (para_308)-[:HAS_ITEM {order: 1}]->(item_310);
CREATE (item_309)-[:NEXT_ITEM]->(item_310);
CREATE (item_311:Item {id: 'c', content: 'Yanık tedavisi hizmetleri,'});

// Batch 9
CREATE (para_308)-[:HAS_ITEM {order: 2}]->(item_311);
CREATE (item_310)-[:NEXT_ITEM]->(item_311);
CREATE (item_312:Item {id: 'ç', content: 'Kanser tedavisi (radyoterapi, kemoterapi, radyo izotop tedavileri),'});
CREATE (para_308)-[:HAS_ITEM {order: 3}]->(item_312);
CREATE (item_311)-[:NEXT_ITEM]->(item_312);
CREATE (item_313:Item {id: 'd', content: 'Yenidoğana verilen sağlık hizmetleri,'});
CREATE (para_308)-[:HAS_ITEM {order: 4}]->(item_313);
CREATE (item_312)-[:NEXT_ITEM]->(item_313);
CREATE (item_314:Item {id: 'e', content: 'Organ, doku ve kök hücre nakillerine ilişkin sağlık hizmetleri,'});
CREATE (para_308)-[:HAS_ITEM {order: 5}]->(item_314);
CREATE (item_313)-[:NEXT_ITEM]->(item_314);
CREATE (item_315:Item {id: 'f', content: 'Doğumsal anomaliler için yapılan cerrahi işlemlere yönelik sağlık hizmetleri,'});
CREATE (para_308)-[:HAS_ITEM {order: 6}]->(item_315);
CREATE (item_314)-[:NEXT_ITEM]->(item_315);
CREATE (item_316:Item {id: 'g', content: 'Hemodiyaliz tedavileri,'});
CREATE (para_308)-[:HAS_ITEM {order: 7}]->(item_316);
CREATE (item_315)-[:NEXT_ITEM]->(item_316);
CREATE (item_317:Item {id: 'ğ', content: 'Kardiyovasküler (Mülga: RG- 14/07/2016- 29770/ 1-b md. Yürürlük: 25/07/2016) cerrahi işlemler. (İstisnai sağlık hizmetlerinde belirtilen işlemler hariç)'});
CREATE (para_308)-[:HAS_ITEM {order: 8}]->(item_317);
CREATE (item_316)-[:NEXT_ITEM]->(item_317);
CREATE (item_318:Item {id: 'h', content: 'SUT eki EK-2/B ve EK-2/C Listesindeki işitsel implant işlemlerinden (Mülga:RG- 05/07/2018-30469/ 1-a md. Yürürlük: 05/07/2018) (Mülga:RG- 05/07/2018-30469/ 1-a md. Yürürlük: 05/07/2018)'});
CREATE (para_308)-[:HAS_ITEM {order: 9}]->(item_318);
CREATE (item_317)-[:NEXT_ITEM]->(item_318);
CREATE (item_319:Item {id: 'j', content: 'SUT eki EK-2/G Listesinde yer alan işlemler, ile bu işlemlere ilişkin sunulan sağlık hizmetlerinden.'});
CREATE (para_308)-[:HAS_ITEM {order: 10}]->(item_319);
CREATE (item_318)-[:NEXT_ITEM]->(item_319);

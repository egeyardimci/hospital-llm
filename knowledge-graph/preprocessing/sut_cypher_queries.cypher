CREATE (subitem_2850:SubItem {id: '3', content: 'Erlotinib, gefitinib, dakomitinib ve afatinib etkin maddeli ilaçların ardışık ya da kombine kullanılması halinde'});
CREATE (item_2828)-[:HAS_SUBITEM {order: 21}]->(subitem_2850);
CREATE (subitem_2849)-[:NEXT_SUBITEM]->(subitem_2850);
CREATE (item_2827)-[:NEXT_ITEM]->(item_2828);
CREATE (para_2490)-[:NEXT_PARAGRAPH]->(para_2491);
CREATE (para_2851:Paragraph {id: '4', content: '(Değişik:RG-30/08/2014-29104/14-d md. Yürürlük:06/09/2014) SUT’un 4.2.14.C maddesinde yer alan ilaçlardan jinekolojik malignite tedavisinde endikasyonu bulunanlar, ilgili maddelerinde tanımlı uzman hekimlerin yanı sıra 117 yalnızca üçüncü basamak sağlık kurumlarında olmak üzere jinekolojik malignite tedavisinde ayrıca kadın hastalıkları ve doğum uzmanı hekiminin yer aldığı sağlık kurulu raporuna dayanılarak bu uzman hekimlerce de reçete edilebilir.'});
CREATE (sec_2488)-[:HAS_PARAGRAPH {order: 3}]->(para_2851);
CREATE (para_2491)-[:NEXT_PARAGRAPH]->(para_2851);
CREATE (amend_2852:Amendment {content: '(Ek: RG- 14/07/2016- 29770/ 10 md. Yürürlük: 22/07/2016)'});
CREATE (sec_2488)-[:HAS_AMENDMENT {order: 0}]->(amend_2852);

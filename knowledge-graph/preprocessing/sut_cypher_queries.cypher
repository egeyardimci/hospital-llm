CREATE (sec_296:Subsection {id: '1.9.2', title: 'İlave ücret alınmayacak kişiler'});
CREATE (sec_275)-[:HAS_SUBSECTION {order: 1}]->(sec_296);
CREATE (para_297:Paragraph {id: '1', content: 'Aşağıda belirtilen kişilerden hiçbir ilave ücret alınamaz.'});
CREATE (sec_296)-[:HAS_PARAGRAPH {order: 0}]->(para_297);
CREATE (item_298:Item {id: 'a', content: '1005 sayılı Kanun hükümlerine göre şeref aylığı alan kişiler ile bakmakla yükümlü olduğu kişilerden,'});
CREATE (para_297)-[:HAS_ITEM {order: 0}]->(item_298);
CREATE (item_299:Item {id: 'b', content: '2330 sayılı Kanun hükümlerine göre aylık alan kişiler ile bakmakla yükümlü olduğu kişilerden,'});
CREATE (para_297)-[:HAS_ITEM {order: 1}]->(item_299);
CREATE (item_298)-[:NEXT_ITEM]->(item_299);
CREATE (item_300:Item {id: 'c', content: 'Harp malûllüğü aylığı alanlar ile 3713 sayılı Kanun kapsamında aylık alanlar ile bakmakla yükümlü olduğu kişilerden,'});
CREATE (para_297)-[:HAS_ITEM {order: 2}]->(item_300);
CREATE (item_299)-[:NEXT_ITEM]->(item_300);
CREATE (item_301:Item {id: 'ç', content: 'Tedavileri sonuçlanıncaya veya maluliyetleri kesinleşinceye kadar; 3713 sayılı Kanunun 21 inci maddesinde sayılan olaylara maruz kalmaları nedeniyle yaralananlar,'});
CREATE (para_297)-[:HAS_ITEM {order: 3}]->(item_301);
CREATE (item_300)-[:NEXT_ITEM]->(item_301);
CREATE (item_302:Item {id: 'd', content: '5510 sayılı Kanunun 60 ıncı maddesinin onikinci fıkrasında belirtilen kişilerden,'});
CREATE (para_297)-[:HAS_ITEM {order: 4}]->(item_302);
CREATE (item_301)-[:NEXT_ITEM]->(item_302);
CREATE (item_303:Item {id: 'e', content: '5510 sayılı Kanunun 60 ıncı maddesinin onüçüncü ve ondördüncü fıkraları kapsamında genel sağlık sigortalısı sayılan kişiler ve bakmakla yükümlü olduğu kişilerden.'});
CREATE (para_297)-[:HAS_ITEM {order: 5}]->(item_303);
CREATE (item_302)-[:NEXT_ITEM]->(item_303);

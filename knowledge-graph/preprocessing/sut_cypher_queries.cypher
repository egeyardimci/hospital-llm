CREATE (sec_3954:Subsection {id: '5.3.2', title: 'Tıbbi cihaz/sarf malzeme şahıs ödemelerinde istenecek incelemeye esas belgeler'});
CREATE (sec_3881)-[:HAS_SUBSECTION {order: 1}]->(sec_3954);
CREATE (para_3955:Paragraph {id: '1', content: 'Ayaktan tedavilerde reçete karşılığı hasta tarafından temin edilen tıbbi cihazların/sarf malzemelerin geri ödeme işlemlerinde fatura aslına ek olarak;'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 0}]->(para_3955);
CREATE (item_3956:Item {id: 'a', content: 'Reçete aslının,'});
CREATE (para_3955)-[:HAS_ITEM {order: 0}]->(item_3956);
CREATE (item_3957:Item {id: 'b', content: 'Sağlık raporu aslının (sürekli kulanım arz eden malzemelerde raporu düzenleyen sağlık kurumu/reçeteyi düzenleyen hekim/Kurum yetkilileri tarafından “Aslı gibidir” onayı yapılmış sureti kabul edilir),'});
CREATE (para_3955)-[:HAS_ITEM {order: 1}]->(item_3957);
CREATE (item_3956)-[:NEXT_ITEM]->(item_3957);
CREATE (item_3958:Item {id: 'c', content: 'Barkodun ve varsa etiket aslının,'});
CREATE (para_3955)-[:HAS_ITEM {order: 2}]->(item_3958);
CREATE (item_3957)-[:NEXT_ITEM]->(item_3958);
CREATE (item_3959:Item {id: 'ç', content: 'SUT’ta tıbbi malzemeye özel olarak belirtilen diğer belgelerin,'});
CREATE (para_3955)-[:HAS_ITEM {order: 3}]->(item_3959);

// Batch 106
CREATE (item_3958)-[:NEXT_ITEM]->(item_3959);
CREATE (item_3960:Item {id: 'd', content: 'Kurumca iade alınan tıbbi cihazlar için taahhütnamenin (Kurum stoklarından temin edilmesi durumunda sadece bu fıkranın a, b, ç bentlerinde belirtilen belgeler)  ve yedek cihaz teminine ilişkin ilgili firma taahhütnamesinin,'});
CREATE (para_3955)-[:HAS_ITEM {order: 4}]->(item_3960);
CREATE (item_3959)-[:NEXT_ITEM]->(item_3960);
CREATE (item_3961:Item {id: 'e', content: 'Engelli sağlık kurulu raporu bulunması halinde aslının veya onaylı fotokopisinin ibrazı zorunludur.'});
CREATE (para_3955)-[:HAS_ITEM {order: 5}]->(item_3961);
CREATE (item_3960)-[:NEXT_ITEM]->(item_3961);
CREATE (para_3962:Paragraph {id: '2', content: 'Fatura arka yüzünde; tıbbi cihazı/sarf malzemeyi teslim alan kişinin adı ve soyadı, T.C. Kimlik Numarası, telefon numarası, ıslak imzası yer almalı ve faturadaki tıbbi malzeme/malzemeleri teslim aldığına dair “Teslim aldım” ibaresi ve teslim alınan tıbbi malzeme miktarı belirtilmelidir (Kurumca iade alınan tıbbi cihazlar hariç).'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 1}]->(para_3962);
CREATE (para_3955)-[:NEXT_PARAGRAPH]->(para_3962);
CREATE (para_3963:Paragraph {id: '3', content: 'YUPASS numarası ile hasta takip numarası/provizyon alınan kişiler de dahil olmak üzere yabancı ülkelerle yapılan sosyal güvenlik sözleşmesi kapsamında sağlık hizmeti bedelleri Kurumca karşılanan kişilere sağlanacak protez ve ortez, tıbbi araç ve gereç ile kişi kullanımına mahsus tıbbi cihazlarının temini için Kurumun ilgili biriminden onay alınır.'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 2}]->(para_3963);
CREATE (para_3962)-[:NEXT_PARAGRAPH]->(para_3963);
CREATE (para_3964:Paragraph {id: '4', content: 'Yatarak tedavilerde ve  3.3.11 numaralı madde kapsamındaki tedavilerde temini zorunlu tıbbi malzemelerin hastaya aldırılması durumunda;'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 3}]->(para_3964);
CREATE (item_3965:Item {id: 'a', content: 'Küresel Ürün Numarası (barkod) ve varsa SUT kodu bilgisini içeren fatura aslının,'});
CREATE (para_3964)-[:HAS_ITEM {order: 0}]->(item_3965);
CREATE (item_3966:Item {id: 'b', content: 'Reçete aslı veya ıslak imzalı epikriz notu veya tıbbi cihaz/sarf malzemenin kullanıldığına dair sağlık raporu aslının (bu belgelerin temin edilememesi durumunda MEDULA sisteminde malzemenin kullanıldığının tespiti),'});
CREATE (para_3964)-[:HAS_ITEM {order: 1}]->(item_3966);
CREATE (item_3965)-[:NEXT_ITEM]->(item_3966);
CREATE (item_3967:Item {id: 'c', content: 'Fatura arkasında hastanın kendisinin veya cihaz/malzemeyi teslim alan kişinin kendi el yazısı ile teslim aldığına dair “Teslim aldım” ibaresi, T.C. Kimlik Numarası, adı ve soyadı, telefon numarası ve imzası,'});
CREATE (para_3964)-[:HAS_ITEM {order: 2}]->(item_3967);
CREATE (item_3966)-[:NEXT_ITEM]->(item_3967);
CREATE (item_3968:Item {id: 'ç', content: 'Barkod ve varsa etiket aslının, ibrazı zorunludur.'});
CREATE (para_3964)-[:HAS_ITEM {order: 3}]->(item_3968);
CREATE (item_3967)-[:NEXT_ITEM]->(item_3968);
CREATE (para_3963)-[:NEXT_PARAGRAPH]->(para_3964);
CREATE (para_3969:Paragraph {id: '5', content: 'Kullanımı sağlık raporuna bağlı sürekli kullanılan tıbbi malzemelere ilişkin düzenlenecek reçetelere ait “Aslı gibidir” onayı yapılmış rapor, fatura ekinde Kuruma gönderilir. “Aslı gibidir” onayı, raporu düzenleyen sağlık kurumu/reçeteyi düzenleyen hekim/Kurum yetkilileri tarafından yapılır.'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 4}]->(para_3969);
CREATE (para_3964)-[:NEXT_PARAGRAPH]->(para_3969);
CREATE (para_3970:Paragraph {id: '6', content: 'Fatura arkasında reçetenin düzenlendiği branşın uzman hekimlerinden biri tarafından reçetede yazan malzemenin (ısmarlama eksternal protez ve ortezler için) hasta üzerinde uygulandığının görüldüğü ve uygunluğunun belirtilerek onaylanması gerekir. (tıbbi uygunluk gerektirmeyen tıbbi malzemeler ve işitme cihazları hariç)'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 5}]->(para_3970);
CREATE (para_3969)-[:NEXT_PARAGRAPH]->(para_3970);
CREATE (para_3971:Paragraph {id: '7', content: 'Sağlık hizmeti bedelleri Kurumca karşılanan kişilerin ayakta tedavileri sırasında kullanmaları sağlık raporu ile uygun görülen SUT eki listelerde yer alan malzemelerden Kurumca duyurulacak olanların ödemesi; SUT hükümleri ve ilgili mevzuat doğrultusunda düzenlenecek sağlık raporu ve bir defaya mahsus olmak üzere sağlık raporuna göre düzenlenen reçeteye istinaden reçete tarihi esas alınmak kaydıyla aylık nakdi ödeme şeklinde yapılabilir. Bu fıkra kapsamında yapılacak ödemelerde bu maddenin diğer fıkralarında yer alan hususlar aranmaz.'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 6}]->(para_3971);
CREATE (para_3970)-[:NEXT_PARAGRAPH]->(para_3971);
CREATE (para_3972:Paragraph {id: '8', content: 'Sağlık Bakanlığı ile yapılan protokol kapsamında Sağlık Bakanlığı tarafından iadeli tıbbi cihazlar ile verilen sağlık hizmetleri karşılığında hizmet ve/veya cihaz bedeli ödenir.'});
CREATE (sec_3954)-[:HAS_PARAGRAPH {order: 7}]->(para_3972);
CREATE (para_3971)-[:NEXT_PARAGRAPH]->(para_3972);
CREATE (amend_3973:Amendment {content: '(Ek:RG- 04/09/2019- 30878/ 46 md. Yürürlük: 04/09/2019)'});
CREATE (sec_3954)-[:HAS_AMENDMENT {order: 0}]->(amend_3973);
CREATE (amend_3974:Amendment {content: '(Değişik: RG-29/12/2023-32414/ 2 md. Yürürlük:09/01/2024)'});
CREATE (sec_3954)-[:HAS_AMENDMENT {order: 1}]->(amend_3974);
CREATE (sec_3885)-[:NEXT_SUBSECTION]->(sec_3954);
CREATE (sec_3822)-[:NEXT_SECTION]->(sec_3881);
CREATE (sec_3975:Section {id: '5.4', title: 'Fatura, incelemeye esas belgelerin teslimi ve ödeme işlemleri'});
CREATE (doc_1)-[:HAS_SECTION {order: 30}]->(sec_3975);
CREATE (para_3976:Paragraph {id: '1', content: 'Fatura, incelemeye esas belgelerin teslimi ve ödeme işlemleri, 8/3/2017 tarihli ve 30001 sayılı Resmî Gazete’de yayımlanan “Sağlık Hizmeti Sunucularının Faturalarının İncelenmesine ve Bedellerinin Ödenmesine İlişkin Usul ve Esaslar Hakkında Yönetmelik” hükümleri doğrultusunda yürütülür. ALTINCI BÖLÜM Son Hükümler'});
CREATE (sec_3975)-[:HAS_PARAGRAPH {order: 0}]->(para_3976);
CREATE (sec_3881)-[:NEXT_SECTION]->(sec_3975);
CREATE (sec_3977:Section {id: '6.1', title: 'Tedavi giderlerine ait katma değer vergisi'});
CREATE (doc_1)-[:HAS_SECTION {order: 31}]->(sec_3977);
CREATE (para_3978:Paragraph {id: '1', content: 'SUT ve eki listelerde yer alan birim puanlar/fiyatlar katma değer vergisi hariç olarak tespit edilmiştir. Katma değer vergisi, ilgili mevzuatı çerçevesinde ayrıca ödenecektir. 155'});
CREATE (sec_3977)-[:HAS_PARAGRAPH {order: 0}]->(para_3978);
CREATE (sec_3975)-[:NEXT_SECTION]->(sec_3977);
CREATE (sec_3979:Section {id: '6.2', title: 'Duyurular'});
CREATE (doc_1)-[:HAS_SECTION {order: 32}]->(sec_3979);
CREATE (para_3980:Paragraph {id: '1', content: 'Kurumun her türlü duyuruları Kurumun resmi internet sitesinde yayınlanır.'});
CREATE (sec_3979)-[:HAS_PARAGRAPH {order: 0}]->(para_3980);
CREATE (sec_3977)-[:NEXT_SECTION]->(sec_3979);
CREATE (sec_3981:Section {id: '6.3', title: 'Geçici hükümler'});
CREATE (doc_1)-[:HAS_SECTION {order: 33}]->(sec_3981);
CREATE (sec_3982:Subsection {id: '6.3.1', title: 'Tanı ve tedavi'});
CREATE (sec_3981)-[:HAS_SUBSECTION {order: 0}]->(sec_3982);
CREATE (para_3983:Paragraph {id: '1', content: '6111 sayılı Kanunun yürürlüğe girdiği 25.02.2011 tarihinden önce trafik kazaları nedeniyle sağlanan sağlık hizmeti bedelleri, SUT ve eklerinde yer alan kısıtlamalar dikkate alınmaksızın Kurumca bu sağlık hizmetleri için ödenen tutarlar üzerinden karşılanır.'});
CREATE (sec_3982)-[:HAS_PARAGRAPH {order: 0}]->(para_3983);
CREATE (para_3984:Paragraph {id: '2', content: '09.11.2012 tarihinden önce alınan sevke istinaden uygulanan ortodontik ve diğer tedaviler 2010/41 nolu Genelgeye göre sonuçlandırılır.'});
CREATE (sec_3982)-[:HAS_PARAGRAPH {order: 1}]->(para_3984);
CREATE (para_3983)-[:NEXT_PARAGRAPH]->(para_3984);
CREATE (para_3985:Paragraph {id: '3', content: '5510 sayılı Kanunun 60 ıncı maddesinin birinci fıkrasının (c) bendinin (1), (3) ve (9) numaralı alt bentleri gereği genel sağlık sigortası kapsamına alınan kişilerin 01.01.2012 tarihinden, SUT’un 1.5.1 maddesinin yürürlük tarihine kadarki sürede geçerli olan mevzuata uygun olarak müracaat ettikleri üniversite sağlık hizmeti sunucusunca, tedavinin sağlanamaması nedeniyle bir başka üniversite sağlık hizmeti sunucusuna sevk edilmiş olması halinde yapılmış olan sevkleri geçerli kabul edilecektir.'});
CREATE (sec_3982)-[:HAS_PARAGRAPH {order: 2}]->(para_3985);
CREATE (para_3984)-[:NEXT_PARAGRAPH]->(para_3985);
CREATE (amend_3986:Amendment {content: '(Değişik: RG- 01/08/2013- 28725/ 12 md. Yürürlük: 01/08/2013)'});
CREATE (sec_3982)-[:HAS_AMENDMENT {order: 0}]->(amend_3986);
CREATE (sec_3987:Subsection {id: '6.3.2', title: 'Tıbbi malzeme'});
CREATE (sec_3981)-[:HAS_SUBSECTION {order: 1}]->(sec_3987);
CREATE (para_3988:Paragraph {id: '1', content: 'Tıbbi malzeme listesi SUT ekinde yayınlanmamış olan branşlardaki (branş, grup veya alanlardan) her hangi bir tıbbi malzemenin, yayınlanmış olan tıbbi malzeme listelerinde tanımlanmış olması durumunda; Kuruma faturalandırılması ilgili listede belirlenmiş kurallara göre yapılır.'});
CREATE (sec_3987)-[:HAS_PARAGRAPH {order: 0}]->(para_3988);
CREATE (para_3989:Paragraph {id: '2', content: 'Bu tebliğin 3.1.2 numaralı maddesinin 17 inci fıkrası ile ilgili olarak;'});
CREATE (sec_3987)-[:HAS_PARAGRAPH {order: 1}]->(para_3989);
CREATE (item_3990:Item {id: 'a', content: '22.06.2012 tarihinden önce düzenlenen sağlık kurulu raporlarına istinaden temin edilen ve ısmarlama olarak üretilen tıbbi malzemelere ilişkin fatura bedellerinin ödenmesinde sağlık kurulu raporunun düzenlendiği tarihte yürürlükte bulunan mevzuat hükümleri doğrultusunda işlem yapılır.'});
CREATE (para_3989)-[:HAS_ITEM {order: 0}]->(item_3990);
CREATE (item_3991:Item {id: 'b', content: '28.07.2012 tarihinden sonra düzenlenen sağlık kurulu raporuna istinaden temin edilmek istenen tıbbi malzeme bedeli, aynı işlevi gören başka bir tıbbi malzemenin daha önceden temin edilmiş olması halinde, temin edilmiş olan malzemenin garanti süresi dolana kadar Kurumca karşılanmaz.'});
CREATE (para_3989)-[:HAS_ITEM {order: 1}]->(item_3991);
CREATE (item_3990)-[:NEXT_ITEM]->(item_3991);
CREATE (item_3992:Item {id: 'c', content: '29.09.2012 tarihinden önce düzenlenen sağlık kurulu raporlarına istinaden temin edilen ve SUT eki listelerde yer almayan tıbbi malzemelerin bedellerinin karşılanmasında, sağlık kurulu raporlarının üçüncü basamak sağlık kurumlarınca düzenlenmiş olma şartı aranmaz.'});
CREATE (para_3989)-[:HAS_ITEM {order: 2}]->(item_3992);
CREATE (item_3991)-[:NEXT_ITEM]->(item_3992);
CREATE (para_3988)-[:NEXT_PARAGRAPH]->(para_3989);
CREATE (para_3993:Paragraph {id: '3', content: 'Türk Silahlı Kuvvetleri bünyesinde vatani hizmetini icra ederken vazife malullüğü aylığı bağlanmış olanlardan, 21.01.2012 tarihinden önce sağlık kurulu raporu ile temin edilerek Kurumca ödemesi yapılmış olan ileri teknoloji ortez ve protezlerin (biyonik el, diz eklemi mikro işlemcili kontrollü karbon ayaklı protezler vb.) bedelleri, bu kişilerden talep edilmez.'});
CREATE (sec_3987)-[:HAS_PARAGRAPH {order: 2}]->(para_3993);
CREATE (para_3989)-[:NEXT_PARAGRAPH]->(para_3993);
CREATE (para_3994:Paragraph {id: '4', content: '10.01.2013 tarih ve 28524 sayılı Resmi Gazetede yayımlanan Sosyal Güvenlik Kurumu Sağlık Uygulama Tebliğinde Değişiklik Yapılmasına Dair Tebliğin 26 ila 34 üncü maddelerinde, yatan hasta tedavisinde kullanılan tıbbi malzemelerle ilgili olarak, SUT ekinde yer alan tıbbi malzeme listelerinde değişiklikler yapılmıştır. Bu Tebliğ hükümleri saklı kalmak kaydıyla;'});
CREATE (sec_3987)-[:HAS_PARAGRAPH {order: 3}]->(para_3994);
CREATE (item_3995:Item {id: 'a', content: 'Söz konusu değişiklik öncesi SUT eki listelerde bulunmakla birlikte bu değişiklik ile SUT eki listelerden çıkarılan tıbbi malzemelerin bedellerinin Kurumca karşılanmayacağına dair hükümler 01.05.2013 tarihinden itibaren geçerli olacaktır.'});
CREATE (para_3994)-[:HAS_ITEM {order: 0}]->(item_3995);
CREATE (item_3996:Item {id: 'b', content: 'Söz konusu değişiklik öncesi SUT eki listelerde fiyatı bulunmakla birlikte bu değişiklik ile tanımlarının farklılaştırılması sonucunda SUT eki listelerde fiyatsız olarak yayımlanan tıbbi malzemelerden; 01.01.2013 (dahil) tarihi ile 10.01.2013 (dahil) tarihleri arasında kullanılanların, belirli olmayan tıbbi malzemelerin ödenmesine ilişkin SUT hükümleri doğrultusunda bedelleri Kurumca karşılanacaktır.'});
CREATE (para_3994)-[:HAS_ITEM {order: 1}]->(item_3996);
CREATE (subitem_3997:SubItem {id: '1', content: 'Değişiklikten önceki SUT eki listelerde tanımlı fiyatlardan fatura edilmesi halinde bu fiyatlar üzerinden,'});
CREATE (item_3996)-[:HAS_SUBITEM {order: 0}]->(subitem_3997);

// Batch 107
CREATE (subitem_3998:SubItem {id: '2', content: 'Yeni düzenlemeye göre fiyatsız tıbbi malzemeler şeklinde fatura edilmesi halinde ise SUT eki listelerde fiyatı'});
CREATE (item_3996)-[:HAS_SUBITEM {order: 1}]->(subitem_3998);
CREATE (subitem_3997)-[:NEXT_SUBITEM]->(subitem_3998);
CREATE (item_3995)-[:NEXT_ITEM]->(item_3996);
CREATE (item_3999:Item {id: 'c', content: 'Söz konusu değişiklik ile getirilmiş olan SUT eki listelerde bulunan veya yeni eklenen tıbbi malzemelere ait konsey, sağlık kurulu raporu veya endikasyon tanımlaması gibi ilave kuralların uygulanmasına ilişkin hükümler, 01.05.2013 tarihinden itibaren geçerli olacaktır.'});
CREATE (para_3994)-[:HAS_ITEM {order: 2}]->(item_3999);
CREATE (item_3996)-[:NEXT_ITEM]->(item_3999);
CREATE (para_3993)-[:NEXT_PARAGRAPH]->(para_3994);
CREATE (sec_3982)-[:NEXT_SUBSECTION]->(sec_3987);
CREATE (sec_3979)-[:NEXT_SECTION]->(sec_3981);
CREATE (sec_4000:Section {id: '6.4', title: 'Yürürlükten kaldırılan mevzuat ve atıflar'});
CREATE (doc_1)-[:HAS_SECTION {order: 34}]->(sec_4000);
CREATE (para_4001:Paragraph {id: '1', content: '25/5/2007 tarihli ve 26532 sayılı Mükerrer Resmi Gazete’de yayımlanan Sosyal Güvenlik Kurumu Sağlık Uygulama Tebliği ile 25/3/2010 tarihli ve 27532 sayılı Mükerrer Resmi Gazete’de yayımlanan Sosyal Güvenlik Kurumu Sağlık Uygulama Tebliği yürürlükten kaldırılmıştır.'});
CREATE (sec_4000)-[:HAS_PARAGRAPH {order: 0}]->(para_4001);
CREATE (para_4002:Paragraph {id: '2', content: '25/3/2010 tarihli ve 27532 sayılı Mükerrer Resmi Gazetede yayımlanan Sosyal Güvenlik Kurumu Sağlık Uygulama Tebliğine yapılmış olan atıflar, bu Tebliğin ilgili maddesine yapılmış sayılır.'});
CREATE (sec_4000)-[:HAS_PARAGRAPH {order: 1}]->(para_4002);
CREATE (para_4001)-[:NEXT_PARAGRAPH]->(para_4002);
CREATE (sec_3981)-[:NEXT_SECTION]->(sec_4000);
CREATE (sec_4003:Section {id: '6.5', title: 'Yürürlük'});
CREATE (doc_1)-[:HAS_SECTION {order: 35}]->(sec_4003);
CREATE (para_4004:Paragraph {id: '1', content: 'SUT’un;'});
CREATE (sec_4003)-[:HAS_PARAGRAPH {order: 0}]->(para_4004);
CREATE (item_4005:Item {id: 'a', content: '4.2.2(3) fıkrası 18/1/2013 tarihinden geçerli olmak üzere yayımı tarihinde,'});
CREATE (para_4004)-[:HAS_ITEM {order: 0}]->(item_4005);
CREATE (item_4006:Item {id: 'b', content: '2.3(6) fıkrası 11/3/2013 tarihinden geçerli olmak üzere yayımı tarihinde,'});
CREATE (para_4004)-[:HAS_ITEM {order: 1}]->(item_4006);
CREATE (item_4005)-[:NEXT_ITEM]->(item_4006);
CREATE (item_4007:Item {id: 'c', content: '2.5 ve 2.6 maddeleri, 4.1.4(5) ve 4.3(3) fıkraları ve 6.3 maddesi yayımı tarihinde,'});
CREATE (para_4004)-[:HAS_ITEM {order: 2}]->(item_4007);
CREATE (item_4006)-[:NEXT_ITEM]->(item_4007);
CREATE (item_4008:Item {id: 'ç', content: '3.1.3(1) fıkrasının i bendinde belirtilen tıbbi malzemelere ait fiyatlar 1/7/2013 tarihinde,'});
CREATE (para_4004)-[:HAS_ITEM {order: 3}]->(item_4008);
CREATE (item_4007)-[:NEXT_ITEM]->(item_4008);
CREATE (item_4009:Item {id: 'd', content: '3.1.3(2) fıkrasının h ve ı bentleri 1/1/2014 tarihinde,'});
CREATE (para_4004)-[:HAS_ITEM {order: 4}]->(item_4009);
CREATE (item_4008)-[:NEXT_ITEM]->(item_4009);
CREATE (item_4010:Item {id: 'e', content: 'Diğer hükümleri 1/5/2013 tarihinde, yürürlüğe girer.'});
CREATE (para_4004)-[:HAS_ITEM {order: 5}]->(item_4010);

CREATE (sec_2135)-[:HAS_SUBSECTION {order: 2}]->(sec_2146);
CREATE (para_2147:Paragraph {id: '1', content: 'Tedavi;'});
CREATE (sec_2146)-[:HAS_PARAGRAPH {order: 0}]->(para_2147);
